```javascript
export const answer = (question) => {
  const match = question.match(/^What is (.*)\?$/);
  if (!match) {
    throw new Error('Unknown operation');
  }

  let expression = match[1];
  // Normalize multi-word operations
  expression = expression.replace(/multiplied by/g, 'multiplied_by')
                         .replace(/divided by/g, 'divided_by');
  
  const tokens = expression.split(' ');
  
  if (tokens.length === 0) {
    throw new Error('Syntax error');
  }

  // First token must be a number
  if (!/^-?\d+$/.test(tokens[0])) {
    throw new Error('Syntax error');
  }

  let result = parseInt(tokens[0], 10);
  
  for (let i = 1; i < tokens.length; i += 2) {
    const op = tokens[i];
    const numStr = tokens[i + 1];
    
    if (!numStr || !/^-?\d+$/.test(numStr)) {
      throw new Error('Syntax error');
    }
    
    const num = parseInt(numStr, 10);
    
    switch (op) {
      case 'plus':
        result += num;
        break;
      case 'minus':
        result -= num;
        break;
      case 'multiplied_by':
        result *= num;
        break;
      case 'divided_by':
        result /= num;
        break;
      default:
        throw new Error('Unknown operation');
    }
  }
  
  return result;
};
```

