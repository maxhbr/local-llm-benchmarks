namespace yacht {

int score(std::vector<int> dice, std::string category) {
    std::sort(dice.begin(), dice.end());
    int counts[7] = {0};
    for (int d : dice) counts[d]++;
    
    if (category == "ones") return counts[1] * 1;
    if (category == "twos") return counts[2] * 2;
    if (category == "threes") return counts[3] * 3;
    if (category == "fours") return counts[4] * 4;
    if (category == "fives") return counts[5] * 5;
    if (category == "sixes") return counts[6] * 6;
    if (category == "full house") {
        bool has3 = false, has2 = false;
        for (int i = 1; i <= 6; ++i) {
            if (counts[i] == 3) has3 = true;
            if (counts[i] == 2) has2 = true;
        }
        return (has3 && has2) ? std::accumulate(dice.begin(), dice.end(), 0) : 0;
    }
    if (category == "four of a kind") {
        for (int i = 1; i <= 6; ++i) {
            if (counts[i] >= 4) return i * 4;
        }
        return 0;
    }
    if (category == "little straight") {
        // dice sorted: 1 2 3 4 5
        bool is_little = true;
        for (int i = 0; i < 5; ++i) {
            if (dice[i] != i + 1) { is_little = false; break; }
        }
        return is_little ? 30 : 0;
    }
    if (category == "big straight") {
        // dice sorted: 2 3 4 5 6
        bool is_big = true;
        for (int i = 0; i < 5; ++i) {
            if (dice[i] != i + 2) { is_big = false; break; }
        }
        return is_big ? 30 : 0;
    }
    if (category == "choice") {
        return std::accumulate(dice.begin(), dice.end(), 0);
    }
    if (category == "yacht") {
        return (counts[dice[0]] == 5) ? 50 : 0;
    }
    return 0;
}

} // namespace yacht
```

