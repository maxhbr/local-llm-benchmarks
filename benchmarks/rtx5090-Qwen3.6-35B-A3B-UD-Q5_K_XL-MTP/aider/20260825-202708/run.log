            name[4] = '0' + rng() % 10;
        } while (used_names.count(name));
        used_names.insert(name);
        return name;
    }
}

robot::robot() = default;

std::string robot::name() const {
    if (name_.empty()) {
        name_ = generate_name();
    }
    return name_;
}

void robot::reset() {
    name_.clear();
}

}  // namespace robot_name
