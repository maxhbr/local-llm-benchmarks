//
// This is only a SKELETON file for the 'Two Bucket' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export class TwoBucket {
  constructor(bucketOne, bucketTwo, goal, startBucket) {
    this.bucketOne = bucketOne;
    this.bucketTwo = bucketTwo;
    this.goal = goal;
    this.startBucket = startBucket;
  }

  solve() {
    const queue = [];
    const visited = new Set();
    
    let startA, startB;
    if (this.startBucket === 'one') {
      startA = this.bucketOne;
      startB = 0;
    } else {
      startA = 0;
      startB = this.bucketTwo;
    }
    
    queue.push([startA, startB, 1]);
    visited.add(`${startA},${startB}`);
    
    const forbiddenA = this.startBucket === 'one' ? 0 : this.bucketOne;
    const forbiddenB = this.startBucket === 'one' ? this.bucketTwo : 0;
    
    let head = 0;
    while (head < queue.length) {
      const [a, b, moves] = queue[head++];
      
      if (a === this.goal) {
        return { moves, goalBucket: 'one', otherBucket: b };
      }
      if (b === this.goal) {
        return { moves, goalBucket: 'two', otherBucket: a };
      }
      
      const nextStates = [
        [this.bucketOne, b], // Fill 1
        [a, this.bucketTwo], // Fill 2
        [0, b],              // Empty 1
        [a, 0],              // Empty 2
        [a - Math.min(a, this.bucketTwo - b), b + Math.min(a, this.bucketTwo - b)], // Pour 1->2
        [a + Math.min(b, this.bucketOne - a), b - Math.min(b, this.bucketOne - a)]  // Pour 2->1
      ];
      
      for (const [na, nb] of nextStates) {
        if (na === forbiddenA && nb === forbiddenB) continue;
        const key = `${na},${nb}`;
        if (!visited.has(key)) {
          visited.add(key);
          queue.push([na, nb, moves + 1]);
        }
      }
    }
    
    throw new Error('impossible');
  }
}
