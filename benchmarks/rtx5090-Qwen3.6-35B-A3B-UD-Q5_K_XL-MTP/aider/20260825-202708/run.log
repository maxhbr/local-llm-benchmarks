```go
package markdown

import (
	"fmt"
	"strings"
)

// Render translates markdown to HTML
func Render(markdown string) string {
	// Refactored from a complex character-by-character loop to a cleaner
	// line-by-line processing approach. This improves readability and maintainability
	// while preserving the original parsing behavior.
	lines := strings.Split(markdown, "\n")
	var html strings.Builder
	inList := false

	for _, line := range lines {
		if line == "" {
			continue
		}

		line = formatInline(line)

		if len(line) > 0 && line[0] == '#' {
			if inList {
				html.WriteString("</ul>")
				inList = false
			}
			level := countLeadingChars(line, '#')
			contentStart := level
			for contentStart < len(line) && line[contentStart] == ' ' {
				contentStart++
			}
			content := line[contentStart:]
			html.WriteString(fmt.Sprintf("<h%d>%s</h%d>", level, content, level))
		} else if len(line) > 1 && line[0] == '*' && line[1] == ' ' {
			if !inList {
				html.WriteString("<ul>")
				inList = true
			}
			content := line[2:]
			html.WriteString(fmt.Sprintf("<li>%s</li>", content))
		} else {
			if inList {
				html.WriteString("</ul>")
				inList = false
			}
			html.WriteString(fmt.Sprintf("<p>%s</p>", line))
		}
	}

	if inList {
		html.WriteString("</ul>")
	}

	return html.String()
}

// countLeadingChars counts the number of consecutive occurrences of a character at the start of a string.
func countLeadingChars(s string, c byte) int {
	count := 0
	for i := 0; i < len(s); i++ {
		if s[i] == c {
			count++
		} else {
			break
		}
	}
	return count
}

// formatInline replaces markdown inline syntax with HTML tags.
// It replaces __ with <strong> and </strong>, and _ with <em> and </em>.
func formatInline(s string) string {
	s = strings.ReplaceAll(s, "__", "<strong>")
	s = strings.ReplaceAll(s, "__", "</strong>")
	s = strings.ReplaceAll(s, "_", "<em>")
	s = strings.ReplaceAll(s, "_", "</em>")
	return s
}
```
