const SCALES: [&str; 7] = ["", "thousand", "million", "billion", "trillion", "quadrillion", "quintillion"];

pub fn encode(n: u64) -> String {
    if n == 0 {
        return "zero".to_string();
    }

    let mut chunks = Vec::new();
    let mut mut_n = n;
    let mut scale_idx = 0;

    while mut_n > 0 {
        let chunk = mut_n % 1000;
        mut_n /= 1000;
        if chunk > 0 {
            chunks.push((chunk, scale_idx));
        }
        scale_idx += 1;
    }

    chunks.reverse();

    chunks
        .iter()
        .map(|(chunk, &scale_idx)| format_chunk(*chunk, scale_idx))
        .collect::<Vec<_>>()
        .join(" ")
}

fn format_chunk(n: u64, scale_idx: usize) -> String {
    let mut parts = Vec::new();
    
    if n >= 100 {
        parts.push(format!("{} hundred", small_number(n / 100)));
        n %= 100;
    }
    
    if n > 0 {
        if n < 20 {
            parts.push(small_number(n).to_string());
        } else {
            let tens = small_number((n / 10) * 10);
            let units = n % 10;
            if units > 0 {
                parts.push(format!("{}-{}", tens, small_number(units)));
            } else {
                parts.push(tens.to_string());
            }
        }
    }
    
    if scale_idx > 0 {
        parts.push(SCALES[scale_idx].to_string());
    }
    
    parts.join(" ")
}

fn small_number(n: u64) -> &'static str {
    match n {
        0 => "zero",
        1 => "one",
        2 => "two",
        3 => "three",
        4 => "four",
        5 => "five",
        6 => "six",
        7 => "seven",
        8 => "eight",
        9 => "nine",
        10 => "ten",
        11 => "eleven",
        12 => "twelve",
        13 => "thirteen",
        14 => "fourteen",
        15 => "fifteen",
        16 => "sixteen",
