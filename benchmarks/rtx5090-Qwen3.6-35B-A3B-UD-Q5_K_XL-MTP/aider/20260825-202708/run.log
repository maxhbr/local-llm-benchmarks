clock.cpp
```cpp
#include "clock.h"
#include <sstream>
#include <iomanip>
#include <string>

namespace date_independent {

clock clock::at(int hours, int minutes) {
    int total = hours * 60 + minutes;
    total = ((total % 1440) + 1440) % 1440;
    return clock(total);
}

clock clock::plus(int minutes) const {
    return clock(total_minutes_ + minutes);
}

bool clock::operator==(const clock& other) const {
    return total_minutes_ == other.total_minutes_;
}

bool clock::operator!=(const clock& other) const {
    return !(*this == other);
}

std::string clock::to_string() const {
    std::ostringstream oss;
    oss << std::setw(2) << std::setfill('0') << total_minutes_ / 60 << ":"
        << std::setw(2) << std::setfill('0') << total_minutes_ % 60;
    return oss.str();
}

clock::operator std::string() const {
    return to_string();
}

std::ostream& operator<<(std::ostream& os, const clock& c) {
    os << c.to_string();
    return os;
}

}  // namespace date_independent
```
