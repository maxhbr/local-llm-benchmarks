#[derive(Debug)]
pub struct Error;

pub struct Scale {
    notes: Vec<String>,
}

impl Scale {
    pub fn new(tonic: &str, intervals: &str) -> Result<Scale, Error> {
        let chromatic = get_chromatic(tonic);
        let tonic_idx = chromatic
            .iter()
            .position(|&n| n.eq_ignore_ascii_case(tonic))
            .ok_or(Error)?;

        let mut notes = Vec::new();
        let mut current_idx = tonic_idx;
        notes.push(chromatic[current_idx].to_string());

        for interval in intervals.chars() {
            let steps = match interval {
                'm' => 1,
                'M' => 2,
                'A' => 3,
                _ => return Err(Error),
            };
            current_idx = (current_idx + steps) % 12;
            notes.push(chromatic[current_idx].to_string());
        }

        Ok(Scale { notes })
    }

    pub fn chromatic(tonic: &str) -> Result<Scale, Error> {
        let chromatic = get_chromatic(tonic);
        let tonic_idx = chromatic
            .iter()
            .position(|&n| n.eq_ignore_ascii_case(tonic))
            .ok_or(Error)?;

        let notes: Vec<String> = (0..12)
            .map(|i| chromatic[(tonic_idx + i) % 12].to_string())
            .collect();

        Ok(Scale { notes })
    }

    pub fn enumerate(&self) -> Vec<String> {
        self.notes.clone()
    }
}

const SHARP_SCALE: &[&str] = &[
    "A", "A#", "B", "C", "C#", "D", "D#", "E", "F", "F#", "G", "G#",
];

const FLAT_SCALE: &[&str] = &[
    "A", "Bb", "B", "C", "Db", "D", "Eb", "E", "F", "Gb", "G", "Ab",
];

fn use_flats(tonic: &str) -> bool {
    let t = tonic.to_lowercase();
    matches!(
        t.as_str(),
        "f" | "bb" | "eb" | "ab" | "db" | "gb" | "d" | "g" | "c"
    )
}

fn get_chromatic(tonic: &str) -> &'static [&'static str] {
    if use_flats(tonic) {
        FLAT_SCALE
    } else {
        SHARP_SCALE
    }
}
```
