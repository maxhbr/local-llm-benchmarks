private int findSplitIndex(String word) {
    if (word.matches("^(xr|yt|[aeiou])")) {
        return 0;
    }
    for (int i = 0; i < word.length(); i++) {
        char c = word.charAt(i);
        if (c == 'q' && i + 1 < word.length() && word.charAt(i + 1) == 'u') {
            return i + 2;
