```cpp
// kindergarten_garden.cpp
#include "kindergarten_garden.h"

namespace kindergarten_garden {

    namespace {
        Plants char_to_plant(char c) {
            switch (c) {
                case 'G': return Plants::grass;
                case 'C': return Plants::clover;
                case 'R': return Plants::radishes;
                case 'V': return Plants::violets;
                default: return Plants::grass;
            }
        }
    }

    std::vector<Plants> plants(std::string diagram, std::string student) {
        const char* students[] = {
            "Alice", "Bob", "Charlie", "David", "Eve", "Fred",
            "Ginny", "Harriet", "Ileana", "Joseph", "Kincaid", "Larry"
        };
        
        int idx = 0;
        for (int i = 0; i < 12; ++i) {
            if (student == students[i]) {
                idx = i;
                break;
            }
        }
        
        std::vector<Plants> result;
        result.reserve(4);
        
        size_t pos = idx * 2;
        
        for (int i = 0; i < 2; ++i) {
            result.push_back(char_to_plant(diagram[pos + i]));
        }
        
        size_t newline_pos = diagram.find('\n');
        size_t second_row_start = newline_pos + 1;
        for (int i = 0; i < 2; ++i) {
            result.push_back(char_to_plant(diagram[second_row_start + pos + i]));
        }
        
        return result;
    }

}  // namespace kindergarten_garden
```
