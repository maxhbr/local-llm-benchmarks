package markdown

import (
        "fmt"
        "strings"
)

// Render translates markdown to HTML
func Render(markdown string) string {
        // Refactored to process line-by-line for better readability and maintainability.
        // The original character-by-character approach was complex and hard to follow.
        lines := strings.Split(markdown, "\n")
        var html strings.Builder
        inList := false

        for _, line := range lines {
                // Skip empty lines to avoid generating empty <p> tags
                if line == "" {
                        continue
                }

                // Apply inline formatting (bold and italic) first
                line = formatInline(line)

                if strings.HasPrefix(line, "# ") {
                        // Close any open list before starting a header
                        if inList {
                                html.WriteString("</ul>")
                                inList = false
                        }
                        level := countLeadingChars(line, '#')
                        content := strings.TrimPrefix(line, strings.Repeat("#", level)+" ")
                        html.WriteString(fmt.Sprintf("<h%d>%s</h%d>", level, content, level))
                } else if strings.HasPrefix(line, "* ") {
                        // Open list if not already open
                        if !inList {
                                html.WriteString("<ul>")
                                inList = true
                        }
                        content := strings.TrimPrefix(line, "* ")
                        html.WriteString(fmt.Sprintf("<li>%s</li>", content))
                } else {
                        // Close any open list before starting a paragraph
                        if inList {
                                html.WriteString("</ul>")
                                inList = false
                        }
                        html.WriteString(fmt.Sprintf("<p>%s</p>", line))
                }
        }

        // Close any remaining open list
        if inList {
                html.WriteString("</ul>")
        }

        return html.String()
}

// countLeadingChars counts the number of consecutive occurrences of a character at the start of a string.
func countLeadingChars(s string, c byte) int {
        count := 0
        for i := 0; i < len(s); i++ {
                if s[i] == c {
                        count++
                } else {
                        break
                }
        }
        return count
}

// formatInline replaces markdown inline syntax with HTML tags.
// Replaces __ with <strong> and </strong>, and _ with <em> and </em>.
func formatInline(s string) string {
        s = strings.ReplaceAll(s, "__", "<strong>")
        s = strings.ReplaceAll(s, "__", "</strong>")
        s = strings.ReplaceAll(s, "_", "<em>")
        s = strings.ReplaceAll(s, "_", "</em>")
        return s
}
```

