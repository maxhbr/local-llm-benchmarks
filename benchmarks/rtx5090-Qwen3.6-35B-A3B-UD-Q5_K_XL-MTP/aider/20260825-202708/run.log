        if (isVowel(c)) {
            return i;
        }
        if (c == 'y' && i > 0) {
            return i;
        }
    }
    return word.length(); // Should not happen for valid words
}

private boolean isVowel(char c) {
    return "aeiou".indexOf(c) != -1;
}
