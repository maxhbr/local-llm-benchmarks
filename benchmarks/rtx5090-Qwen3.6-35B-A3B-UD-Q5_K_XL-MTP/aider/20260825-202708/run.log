```cpp
#include "robot_name.h"
#include <random>
#include <set>
#include <algorithm>

namespace robot_name {

namespace {
    std::set<std::string> used_names;
    std::mt19937 rng(std::random_device{}());
    
    std::string generate_name() {
        std::string name;
        do {
            name.resize(5);
            name[0] = 'A' + rng() % 26;
            name[1] = 'A' + rng() % 26;
            name[2] = '0' + rng() % 10;
            name[3] = '0' + rng() % 10;
            name[4] = '0' + rng() % 10;
        } while (used_names.count(name));
        used_names.insert(name);
        return name;
    }
}

robot::robot() : name_() {}

std::string robot::name() const {
    if (name_.empty()) {
        name_ = generate_name();
    }
    return name_;
}

void robot::reset() {
    name_.clear();
}

}  // namespace robot_name
```

