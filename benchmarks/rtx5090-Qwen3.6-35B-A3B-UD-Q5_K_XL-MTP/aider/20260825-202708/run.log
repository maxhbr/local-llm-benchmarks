namespace kindergarten_garden {

    enum class Plant {
        grass,
        clover,
        radishes,
        violets
    };

    std::vector<Plant> plants(std::string diagram, std::string student) {
        std::vector<Plant> result;
        result.reserve(4);
        
        // Find student index
        const char* students[] = {"Alice", "Bob", "Charlie", "David", "Eve", "Fred", 
                                  "Ginny", "Harriet", "Ileana", "Joseph", "Kincaid", "Larry"};
        int idx = 0;
        for (int i = 0; i < 12; ++i) {
            if (student == students[i]) {
                idx = i;
                break;
            }
        }
        
        size_t pos = idx * 2;
        
        // First row
        for (int i = 0; i < 2; ++i) {
            char c = diagram[pos + i];
            if (c == 'G') result.push_back(Plant::grass);
            else if (c == 'C') result.push_back(Plant::clover);
            else if (c == 'R') result.push_back(Plant::radishes);
            else if (c == 'V') result.push_back(Plant::violets);
        }
        
        // Second row starts after the newline
        size_t second_row_start = diagram.find('\n') + 1;
        for (int i = 0; i < 2; ++i) {
