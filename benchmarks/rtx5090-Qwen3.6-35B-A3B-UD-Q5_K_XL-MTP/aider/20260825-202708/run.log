fn expand_codon(codon: &str) -> Vec<String> {
    let mut results = vec![String::new()];
    for c in codon.chars() {
        let bases = match c {
            'A' => vec!['A'],
            'C' => vec!['C'],
            'G' => vec!['G'],
            'T' => vec!['T'],
            'U' => vec!['U'],
            'R' => vec!['A', 'G'],
            'Y' => vec!['C', 'T'],
            'S' => vec!['G', 'C'],
            'W' => vec!['A', 'T'],
            'K' => vec!['G', 'T'],
            'M' => vec!['A', 'C'],
            'B' => vec!['C', 'G', 'T'],
            'D' => vec!['A', 'G', 'T'],
            'H' => vec!['A', 'C', 'T'],
            'V' => vec!['A', 'C', 'G'],
            'N' => vec!['A', 'C', 'G', 'T'],
            _ => return vec![], // invalid char
        };
        let mut new_results = Vec::new();
        for prefix in &results {
            for &b in &bases {
                new_results.push(format!("{}{}", prefix, b));
            }
        }
        results = new_results;
    }
    results
}
