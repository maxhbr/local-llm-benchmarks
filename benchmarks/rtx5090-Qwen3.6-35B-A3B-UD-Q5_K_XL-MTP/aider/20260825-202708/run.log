use std::collections::HashMap;

pub struct CodonsInfo<'a> {
    map: HashMap<&'a str, &'a str>,
}

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct Error;

impl<'a> CodonsInfo<'a> {
    pub fn name_for(&self, codon: &str) -> Result<&'a str, Error> {
        if codon.len() != 3 {
            return Err(Error);
        }
        let expanded = expand_codon(codon);
        for exp in &expanded {
            if let Some(&name) = self.map.get(exp.as_str()) {
                return Ok(name);
            }
        }
        Err(Error)
    }

    pub fn of_rna(&self, rna: &str) -> Result<Vec<&'a str>, Error> {
        let mut proteins = Vec::new();
        let mut chars = rna.chars();
        loop {
            let c1 = match chars.next() { None => break, Some(c) => c };
            let c2 = match chars.next() { None => return Err(Error), Some(c) => c };
            let c3 = match chars.next() { None => return Err(Error), Some(c) => c };
            let codon = format!("{}{}{}", c1, c2, c3);
            match self.name_for(&codon)? {
                "STOP" => break,
                p => proteins.push(p),
            }
        }
        Ok(proteins)
    }
}

pub fn parse<'a>(pairs: Vec<(&'a str, &'a str)>) -> CodonsInfo<'a> {
    let mut map = HashMap::new();
    for (k, v) in pairs {
        map.insert(k, v);
    }
    CodonsInfo { map }
}

fn expand_codon(codon: &str) -> Vec<String> {
    let mut results = vec![String::new()];
    for c in codon.chars() {
        let bases = match c {
            'A' => vec!['A'],
            'C' => vec!['C'],
            'G' => vec!['G'],
            'T' => vec!['T'],
            'U' => vec!['U'],
            'R' => vec!['A', 'G'],
            'Y' => vec!['C', 'T'],
            'S' => vec!['G', 'C'],
            'W' => vec!['A', 'T'],
            'K' => vec!['G', 'T'],
            'M' => vec!['A', 'C'],
            'B' => vec!['C', 'G', 'T'],
            'D' => vec!['A', 'G', 'T'],
            'H' => vec!['A', 'C', 'T'],
            'V' => vec!['A', 'C', 'G'],
            'N' => vec!['A', 'C', 'G', 'T'],
            _ => return vec![],
        };
        let mut new_results = Vec::new();
        for prefix in &results {
            for &b in &bases {
                new_results.push(format!("{}{}", prefix, b));
            }
        }
        results = new_results;
    }
    results
}
