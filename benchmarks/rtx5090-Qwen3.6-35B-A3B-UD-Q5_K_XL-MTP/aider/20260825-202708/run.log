```python
class Scale:
    def __init__(self, tonic):
        self.tonic = tonic.capitalize()
        self.flats = ['F', 'Bb', 'Eb', 'Ab', 'Db', 'Gb', 'd', 'g', 'c', 'f', 'bb', 'eb']
        if self.tonic in self.flats:
            self.scale = ['A', 'Bb', 'B', 'C', 'Db', 'D', 'Eb', 'E', 'F', 'Gb', 'G', 'Ab']
        else:
            self.scale = ['A', 'A#', 'B', 'C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#']

    def chromatic(self):
        idx = self.scale.index(self.tonic)
        return self.scale[idx:] + self.scale[:idx]

    def interval(self, intervals):
        chrom = self.chromatic()
        result = [chrom[0]]
        current_idx = 0
        for interval in intervals:
            if interval == 'm':
                current_idx += 1
            elif interval == 'M':
                current_idx += 2
            elif interval == 'A':
                current_idx += 3
            result.append(chrom[current_idx % 12])
        return result
```

