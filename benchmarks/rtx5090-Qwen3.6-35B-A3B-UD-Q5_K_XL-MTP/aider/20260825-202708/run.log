class WordProblemSolver {
    int solve(final String wordProblem) {
        String cleaned = wordProblem.replaceAll("^What is ", "").replaceAll("\\?$", "");
        String[] tokens = cleaned.split("\\s+");
        
        if (tokens.length == 0) {
            throw new IllegalArgumentException("Invalid question");
        }
        
        int result;
        try {
            result = Integer.parseInt(tokens[0]);
        } catch (NumberFormatException e) {
            throw new IllegalArgumentException("Invalid syntax");
        }
        
        int i = 1;
        while (i < tokens.length) {
            String op = tokens[i];
            i++;
            
            int multiplier = 1;
            if ("multiplied".equals(op)) {
                multiplier = 2;
            } else if ("divided".equals(op)) {
                multiplier = 2;
            } else if (!"plus".equals(op) && !"minus".equals(op)) {
                throw new IllegalArgumentException("Unsupported operation");
            }
            
            if (multiplier == 2) {
                if (i >= tokens.length || !"by".equals(tokens[i])) {
                    throw new IllegalArgumentException("Invalid syntax");
                }
                i++;
            }
            
            if (i >= tokens.length) {
                throw new IllegalArgumentException("Invalid syntax");
            }
            
            int num;
            try {
                num = Integer.parseInt(tokens[i]);
            } catch (NumberFormatException e) {
                throw new IllegalArgumentException("Invalid syntax");
            }
            i++;
            
            switch (op) {
                case "plus": result += num; break;
                case "minus": result -= num; break;
                case "multiplied": result *= num; break;
                case "divided": result /= num; break;
            }
        }
        
        return result;
    }
}
