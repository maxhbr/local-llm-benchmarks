export const answer = (question) => {
  const match = question.match(/^What is (.*)\?$/);
  if (!match) {
    throw new Error('Unknown operation');
  }

  let expression = match[1].trim();
  expression = expression.replace(/multiplied by/g, 'multiplied_by')
                         .replace(/divided by/g, 'divided_by');
  
  const tokens = expression.split(/\s+/).filter(Boolean);
  
  if (tokens.length === 0) {
    throw new Error('Syntax error');
  }

  if (!/^-?\d+$/.test(tokens[0])) {
    throw new Error('Syntax error');
  }

  let result = Number(tokens[0]);
  
  for (let i = 1; i < tokens.length; i += 2) {
    const op = tokens[i];
    const numStr = tokens[i + 1];
    
    if (!numStr || !/^-?\d+$/.test(numStr)) {
      throw new Error('Syntax error');
    }
    
    const num = Number(numStr);
    
    switch (op) {
      case 'plus':
        result += num;
        break;
      case 'minus':
        result -= num;
        break;
      case 'multiplied_by':
        result *= num;
        break;
      case 'divided_by':
        result /= num;
        break;
      default:
        throw new Error('Unknown operation');
    }
  }
  
  return result;
};
```

