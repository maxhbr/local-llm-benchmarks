    }
    if (whiteRow < 0 || whiteRow > 7 || whiteColumn < 0 || whiteColumn > 7) {
      throw new Error('Queen must be placed on the board');
    }
    if (blackRow === whiteRow && blackColumn === whiteColumn) {
      throw new Error('Queens cannot share the same space');
    }

    this.blackRow = blackRow;
    this.blackColumn = blackColumn;
    this.whiteRow = whiteRow;
    this.whiteColumn = whiteColumn;
  }

  toString() {
    const board = [];
    for (let r = 0; r < 8; r++) {
      const row = [];
      for (let c = 0; c < 8; c++) {
        if (r === this.whiteRow && c === this.whiteColumn) {
          row.push('W');
        } else if (r === this.blackRow && c === this.blackColumn) {
          row.push('B');
        } else {
          row.push('_');
        }
      }
      board.push(row.join(' '));
    }
    return board.join('\n');
  }

  get canAttack() {
    const rowDiff = Math.abs(this.whiteRow - this.blackRow);
    const colDiff = Math.abs(this.whiteColumn - this.blackColumn);
    return rowDiff === 0 || colDiff === 0 || rowDiff === colDiff;
  }
}
