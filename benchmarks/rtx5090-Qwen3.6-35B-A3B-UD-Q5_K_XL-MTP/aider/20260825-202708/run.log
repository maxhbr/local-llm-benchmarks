package palindrome

import "errors"

type Product struct {
        Palindrome int
        Factors    [][2]int
}

func isPalindrome(n int) bool {
        if n < 0 {
                return false
        }
        rev := 0
        for temp := n; temp > 0; temp /= 10 {
                rev = rev*10 + temp%10
        }
        return n == rev
}

func Products(fmin, fmax int) (Product, Product, error) {
        if fmin > fmax {
                return Product{}, Product{}, errors.New("fmin > fmax")
        }

        var minP, maxP Product
        minFound, maxFound := false, false

        for i := fmin; i <= fmax; i++ {
                if minFound && i*i > minP.Palindrome {
                        break
                }
                for j := i; j <= fmax; j++ {
                        prod := i * j
                        if minFound && prod > minP.Palindrome {
                                break
                        }
                        if isPalindrome(prod) {
                                if !minFound || prod < minP.Palindrome {
                                        minP = Product{Palindrome: prod, Factors: [][2]int{{i, j}}}
                                        minFound = true
                                } else if prod == minP.Palindrome {
                                        minP.Factors = append(minP.Factors, [2]int{i, j})
                                }
                        }
                }
        }

        for i := fmax; i >= fmin; i-- {
                if maxFound && i*i < maxP.Palindrome {
                        break
                }
                for j := i; j >= fmin; j-- {
                        prod := i * j
                        if maxFound && prod < maxP.Palindrome {
                                break
                        }
                        if isPalindrome(prod) {
                                if !maxFound || prod > maxP.Palindrome {
                                        maxP = Product{Palindrome: prod, Factors: [][2]int{{i, j}}}
                                        maxFound = true
                                } else if prod == maxP.Palindrome {
                                        maxP.Factors = append(maxP.Factors, [2]int{i, j})
                                }
                        }
                }
        }

        return minP, maxP, nil
}
