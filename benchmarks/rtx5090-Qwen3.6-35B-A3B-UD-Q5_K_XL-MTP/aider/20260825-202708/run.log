```cpp
#include <string>
#include <vector>
#include <cmath>
#include <cctype>
#include <algorithm>

namespace crypto_square {

class cipher {
public:
    cipher(const std::string& text) {
        for (char c : text) {
            if (std::isalnum(static_cast<unsigned char>(c))) {
                normalized_ += std::tolower(static_cast<unsigned char>(c));
            }
        }
    }

    std::string ciphertext() const {
        if (normalized_.empty()) {
            return "";
        }

        size_t len = normalized_.length();
        size_t c = std::ceil(std::sqrt(len));
        size_t r = (len + c - 1) / c;

        std::string result;
        for (size_t j = 0; j < c; ++j) {
            if (j > 0) {
                result += ' ';
            }
            for (size_t i = 0; i < r; ++i) {
                size_t idx = i * c + j;
                if (idx < len) {
                    result += normalized_[idx];
                } else {
                    result += ' ';
                }
            }
        }
        return result;
    }

private:
    std::string normalized_;
};

}  // namespace crypto_square
```

