```rust
use std::collections::VecDeque;
use std::collections::HashMap;

pub type Value = i32;
pub type Result = std::result::Result<(), Error>;

#[derive(Debug, Clone)]
enum Token {
    Num(Value),
    Word(String),
}

pub struct Forth {
    stack: Vec<Value>,
    dictionary: HashMap<String, Vec<Token>>,
}

#[derive(Debug, PartialEq, Eq)]
pub enum Error {
    DivisionByZero,
    StackUnderflow,
    UnknownWord,
    InvalidWord,
}

impl Forth {
    pub fn new() -> Forth {
        Forth {
            stack: Vec::new(),
            dictionary: HashMap::new(),
        }
    }

    pub fn stack(&self) -> &[Value] {
        &self.stack
    }

    pub fn eval(&mut self, input: &str) -> Result {
        let mut tokens: VecDeque<Token> = tokenize(input);
        
        while let Some(token) = tokens.pop_front() {
            match token {
                Token::Num(v) => {
                    self.stack.push(v);
                }
                Token::Word(w) => {
                    if w == ":" {
                        // Start definition
                        let name = tokens.pop_front()
                            .ok_or(Error::InvalidWord)?;
                        let name = match name {
                            Token::Word(n) => n,
                            _ => return Err(Error::InvalidWord),
                        };
                        
                        let mut def = Vec::new();
                        loop {
                            let t = tokens.pop_front()
                                .ok_or(Error::InvalidWord)?;
                            if t == Token::Word(";".to_string()) {
                                break;
                            }
                            def.push(t);
                        }
                        self.dictionary.insert(name, def);
                    } else if let Some(def) = self.dictionary.get(&w) {
                        // Expand word: push definition to front in reverse order
                        for token in def.iter().rev() {
                            tokens.push_front(token.clone());
                        }
                    } else {
                        match w.as_str() {
                            "+" => self.arith(|a, b| a.checked_add(b).ok_or(Error::StackUnderflow)?, 2)?,
                            "-" => self.arith(|a, b| a.checked_sub(b).ok_or(Error::StackUnderflow)?, 2)?,
                            "*" => self.arith(|a, b| a.checked_mul(b).ok_or(Error::StackUnderflow)?, 2)?,
                            "/" => {
                                if self.stack.len() < 2 { return Err(Error::StackUnderflow); }
                                let b = self.stack.pop().unwrap();
                                let a = self.stack.pop().unwrap();
                                if b == 0 { return Err(Error::DivisionByZero); }
                                self.stack.push(a / b);
                            }
                            "dup" => {
                                if self.stack.is_empty() { return Err(Error::StackUnderflow); }
                                let v = *self.stack.last().unwrap();
                                self.stack.push(v);
                            }
                            "drop" => {
                                if self.stack.is_empty() { return Err(Error::StackUnderflow); }
                                self.stack.pop();
                            }
                            "swap" => {
                                if self.stack.len() < 2 { return Err(Error::StackUnderflow); }
                                let len = self.stack.len();
                                self.stack.swap(len - 1, len - 2);
                            }
                            "over" => {
                                if self.stack.len() < 2 { return Err(Error::StackUnderflow); }
                                let v = self.stack[self.stack.len() - 2];
                                self.stack.push(v);
                            }
                            _ => return Err(Error::UnknownWord),
                        }
                    }
                }
            }
        }
        Ok(())
    }
}

fn tokenize(input: &str) -> VecDeque<Token> {
    input.split_whitespace().map(|s| {
        if let Ok(n) = s.parse::<i32>() {
            Token::Num(n)
        } else {
            Token::Word(s.to_lowercase())
        }
    }).collect()
}

impl Forth {
    fn arith<F>(&mut self, op: F, _args: usize) -> Result
    where
        F: FnOnce(Value, Value) -> Result<Value>,
    {
        if self.stack.len() < 2 {
            return Err(Error::StackUnderflow);
        }
        let b = self.stack.pop().unwrap();
        let a = self.stack.pop().unwrap();
        self.stack.push(op(a, b)?);
        Ok(())
    }
}
```

