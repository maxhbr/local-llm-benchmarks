package alphametics

import (
        "errors"
        "strings"
)

func Solve(puzzle string) (map[string]int, error) {
        parts := strings.Split(puzzle, "==")
        if len(parts) != 2 {
                return nil, errors.New("invalid puzzle")
        }

        leftStr := parts[0]
        rightStr := parts[1]

        leftWords := strings.Split(leftStr, "+")
        for i := range leftWords {
                leftWords[i] = strings.TrimSpace(leftWords[i])
        }
        rightWord := strings.TrimSpace(rightStr)

        words := append(leftWords, rightWord)

        weights := make(map[string]int64)
        leadingNonZero := make(map[string]bool)
        var letters []string
        seen := make(map[string]bool)

        for _, w := range words {
                if len(w) > 1 {
                        leadingNonZero[w[:1]] = true
                }
                for i, c := range w {
                        char := string(c)
                        if !seen[char] {
                                seen[char] = true
                                letters = append(letters, char)
                                weights[char] = 0
                        }
                        pos := len(w) - 1 - i
                        mult := int64(1)
                        for j := 0; j < pos; j++ {
                                mult *= 10
                        }
                        if w == rightWord {
                                weights[char] -= mult
                        } else {
                                weights[char] += mult
                        }
                }
        }

        if len(letters) > 10 {
                return nil, errors.New("too many unique letters")
        }

        // Precompute weights and leading flags for faster access in DFS
        type letterData struct {
                weight    int64
                isLeading bool
        }
        data := make([]letterData, len(letters))
        for i, l := range letters {
                data[i] = letterData{
                        weight:    weights[l],
                        isLeading: leadingNonZero[l],
                }
        }

        solution := make(map[string]int)

        var solve func(idx int, usedMask int, currentSum int64) bool
        solve = func(idx int, usedMask int, currentSum int64) bool {
                if idx == len(letters) {
                        return currentSum == 0
                }

                d := data[idx]
                for digit := 0; digit <= 9; digit++ {
                        if usedMask&(1<<digit) == 0 {
                                if digit == 0 && d.isLeading {
                                        continue
                                }
                                solution[letters[idx]] = digit
                                if solve(idx+1, usedMask|(1<<digit), currentSum+d.weight*int64(digit)) {
                                        return true
                                }
                        }
                }
                return false
        }

        if solve(0, 0, 0) {
                return solution, nil
        }
        return nil, errors.New("no solution")
}
