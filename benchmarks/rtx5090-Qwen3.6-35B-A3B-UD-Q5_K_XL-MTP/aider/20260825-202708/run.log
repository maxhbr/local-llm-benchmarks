    def __init__(self, properties=None, children=None):
        self.properties = properties or {}
        self.children = children or []

    def __eq__(self, other):
        if not isinstance(other, SgfTree):
            return False
        for key, value in self.properties.items():
            if key not in other.properties:
                return False
            if other.properties[key] != value:
                return False
        for key in other.properties.keys():
            if key not in self.properties:
                return False
        if len(self.children) != len(other.children):
            return False
        for child, other_child in zip(self.children, other.children):
            if child != other_child:
                return False
        return True

    def __ne__(self, other):
        return not self == other


def parse(input_string):
    if not input_string or input_string[0] != '(' or input_string[-1] != ')':
        raise ValueError("tree missing")
    if input_string == "()":
        raise ValueError("tree with no nodes")
        
    s = input_string
    
    def parse_properties(pos):
        properties = {}
        while pos < len(s) and s[pos] not in ';()':
            key = ""
            while pos < len(s) and s[pos].isalpha():
                if not s[pos].isupper():
                    raise ValueError("property must be in uppercase")
                key += s[pos]
                pos += 1
            if not key:
                raise ValueError("property must be in uppercase")
                
            values = []
            while pos < len(s) and s[pos] == '[':
                pos += 1
                val = ""
                while pos < len(s) and s[pos] != ']':
                    ch = s[pos]
                    if ch == '\\':
                        pos += 1
                        if pos < len(s):
                            nxt = s[pos]
                            if nxt == '\n':
                                pass
                            elif nxt.isspace():
                                val += ' '
                            else:
                                val += nxt
                    elif ch == '\n':
                        val += '\n'
                    else:
                        if ch.isspace():
                            val += ' '
                        else:
                            val += ch
                    pos += 1
                if pos >= len(s) or s[pos] != ']':
                    raise ValueError("properties without delimiter")
                pos += 1
                values.append(val)
                
            if not values:
                raise ValueError("properties without delimiter")
                
            if key in properties:
                properties[key].extend(values)
            else:
                properties[key] = values
        return properties, pos

    def parse_node(start_pos):
        if start_pos >= len(s) or s[start_pos] != ';':
            raise ValueError("tree missing")
        
        properties, pos = parse_properties(start_pos + 1)
        children = []
        
        while pos < len(s):
            if s[pos] == ';':
                pos += 1
                child_props, pos = parse_properties(pos)
                child_children = []
                while pos < len(s) and s[pos] == '(':
                    grandchild, pos = parse_node(pos + 1)
                    child_children.append(grandchild)
                    if pos >= len(s) or s[pos] != ')':
                        raise ValueError("tree missing")
                    pos += 1
                children.append(SgfTree(child_props, child_children))
            elif s[pos] == '(':
                child_node, pos = parse_node(pos + 1)
                children.append(child_node)
                if pos >= len(s) or s[pos] != ')':
                    raise ValueError("tree missing")
                pos += 1
            else:
                break
                
        return SgfTree(properties, children), pos

    node, end_pos = parse_node(1)
    if end_pos != len(s) - 1:
        raise ValueError("tree missing")
    return node
```

