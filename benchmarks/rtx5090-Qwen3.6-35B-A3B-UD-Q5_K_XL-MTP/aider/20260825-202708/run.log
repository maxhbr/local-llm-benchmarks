```go
import (
        "errors"
        "strings"
        "unicode"
)

func Solve(puzzle string) (map[string]int, error) {
        // split by ==
        parts := strings.Split(puzzle, "==")
        if len(parts) != 2 {
                return nil, errors.New("invalid puzzle format")
        }
        
        leftStr := parts[0]
        rightStr := parts[1]
        
        leftWords := strings.Split(leftStr, "+")
        for i := range leftWords {
                leftWords[i] = strings.TrimSpace(leftWords[i])
        }
        rightWord := strings.TrimSpace(rightStr)
        
        words := append(leftWords, rightWord)
        
        // collect unique letters and weights
        weights := make(map[string]int64)
        leadingNonZero := make(map[string]bool)
        var letters []string
        seen := make(map[string]bool)
        
        for _, w := range words {
                if len(w) > 1 {
                        leadingNonZero[w[:1]] = true
                }
                for i, c := range w {
                        char := string(c)
                        if !seen[char] {
                                seen[char] = true
                                letters = append(letters, char)
                                weights[char] = 0
                        }
                        // position from right: len(w) - 1 - i
                        pos := len(w) - 1 - i
                        mult := int64(1)
                        for j := 0; j < pos; j++ {
                                mult *= 10
                        }
                        // left words add, right word subtracts
                        isRight := (w == rightWord)
                        if isRight {
                                weights[char] -= mult
                        } else {
                                weights[char] += mult
                        }
                }
        }
        
        if len(letters) > 10 {
                return nil, errors.New("too many unique letters")
        }
        
        // DFS
        solution := make(map[string]int)
        var solve func(idx int, usedMask int, currentSum int64) bool
        
        solve = func(idx int, usedMask int, currentSum int64) bool {
                if idx == len(letters) {
                        return currentSum == 0
                }
                
                char := letters[idx]
                w := weights[char]
                
                for d := 0; d <= 9; d++ {
                        if usedMask&(1<<d) == 0 {
                                if d == 0 && leadingNonZero[char] {
                                        continue
                                }
                                solution[char] = d
                                if solve(idx+1, usedMask|(1<<d), currentSum+w*int64(d)) {
                                        return true
                                }
                        }
                }
                return false
        }
        
        if solve(0, 0, 0) {
                return solution, nil
        }
        return nil, errors.New("no solution")
}
```

