```python
class SgfTree:
    def __init__(self, properties=None, children=None):
        self.properties = properties or {}
        self.children = children or []

    def __eq__(self, other):
        if not isinstance(other, SgfTree):
            return False
        for key, value in self.properties.items():
            if key not in other.properties:
                return False
            if other.properties[key] != value:
                return False
        for key in other.properties.keys():
            if key not in self.properties:
                return False
        if len(self.children) != len(other.children):
            return False
        for child, other_child in zip(self.children, other.children):
            if child != other_child:
                return False
        return True

    def __ne__(self, other):
        return not self == other


def parse(input_string):
    if not input_string or input_string[0] != '(' or input_string[-1] != ')':
        raise ValueError("tree missing")
    if input_string == "()":
        raise ValueError("tree with no nodes")
        
    s = input_string
    pos = [1]
    
    def parse_node():
        if pos[0] >= len(s) or s[pos[0]] != ';':
            raise ValueError("tree missing")
        pos[0] += 1
        properties = {}
        
        while pos[0] < len(s) and s[pos[0]] not in ';()':
            key = ""
            while pos[0] < len(s) and s[pos[0]].isalpha():
                if not s[pos[0]].isupper():
                    raise ValueError("property must be in uppercase")
                key += s[pos[0]]
                pos[0] += 1
            if not key:
                raise ValueError("property must be in uppercase")
                
            values = []
            while pos[0] < len(s) and s[pos[0]] == '[':
                pos[0] += 1
                val = ""
                while pos[0] < len(s) and s[pos[0]] != ']':
                    ch = s[pos[0]]
                    if ch == '\\':
                        pos[0] += 1
                        if pos[0] < len(s):
                            nxt = s[pos[0]]
                            if nxt == '\n':
                                pass
                            elif nxt.isspace():
                                val += ' '
                            else:
                                val += nxt
                    elif ch == '\n':
                        val += '\n'
                    else:
                        if ch.isspace():
                            val += ' '
                        else:
                            val += ch
                    pos[0] += 1
                if pos[0] >= len(s) or s[pos[0]] != ']':
                    raise ValueError("properties without delimiter")
                pos[0] += 1
                values.append(val)
                
            if not values:
                raise ValueError("properties without delimiter")
                
            if key in properties:
                properties[key].extend(values)
            else:
                properties[key] = values
                
        children = []
        while pos[0] < len(s) and s[pos[0]] == '(':
            pos[0] += 1
            children.append(parse_node())
            if pos[0] >= len(s) or s[pos[0]] != ')':
                raise ValueError("tree missing")
            pos[0] += 1
            
        return SgfTree(properties, children)

    node = parse_node()
    if pos[0] != len(s) - 1:
        raise ValueError("tree missing")
    return node
```

