use std::collections::HashMap;
use std::thread;

pub fn frequency(input: &[&str], worker_count: usize) -> HashMap<char, usize> {
    if input.is_empty() || worker_count == 0 {
        return HashMap::new();
    }

    let chunk_size = (input.len() + worker_count - 1) / worker_count;
    let chunks: Vec<&[&str]> = input.chunks(chunk_size).collect();
    
    let mut handles = Vec::with_capacity(worker_count);
    
    for chunk in chunks {
        handles.push(thread::spawn(move || {
            let mut counts = HashMap::new();
            for s in chunk {
                for c in s.chars() {
                    if c.is_alphabetic() {
                        let lower = c.to_ascii_lowercase();
                        *counts.entry(lower).or_insert(0) += 1;
                    }
                }
            }
            counts
        }));
    }
    
    let mut total_counts = HashMap::new();
    for handle in handles {
        for (c, count) in handle.join().unwrap() {
            *total_counts.entry(c).or_insert(0) += count;
        }
    }
    
    total_counts
}
```
