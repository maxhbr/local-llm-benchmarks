import io.reactivex.Observable;
import java.util.*;

class Hangman {

    Observable<Output> play(Observable<String> words, Observable<String> letters) {
        return Observable.merge(
                words.map(w -> new Event(w, null)),
                letters.map(l -> new Event(null, l))
        ).scan(Output.empty(), (state, event) -> {
            if (event.word != null) {
                return new Output(
                        event.word,
                        createDiscovered(event.word, Collections.emptySet()),
                        Collections.emptySet(),
                        Collections.emptySet(),
                        Collections.emptyList(),
                        Status.PLAYING
                );
            } else if (state.secret != null) {
                Set<String> newGuess = new HashSet<>(state.guess);
                newGuess.add(event.letter);
                
                Set<String> newMisses = new HashSet<>(state.misses);
                List<Part> newParts = new ArrayList<>(state.parts);
                
                if (!state.secret.contains(event.letter)) {
                    newMisses.add(event.letter);
                    if (newMisses.size() <= Part.values().length) {
                        newParts.add(Part.values()[newMisses.size() - 1]);
                    }
                }
                
                String newDiscovered = createDiscovered(state.secret, newGuess);
                Status newStatus = determineStatus(newDiscovered, state.secret, newParts.size());
                
                return new Output(
                        state.secret,
                        newDiscovered,
                        newGuess,
                        newMisses,
                        newParts,
                        newStatus
                );
            }
            return state;
        }).filter(output -> output.secret != null);
    }

    private String createDiscovered(String secret, Set<String> guess) {
        StringBuilder sb = new StringBuilder();
        for (char c : secret.toCharArray()) {
            sb.append(guess.contains(String.valueOf(c)) ? c : '_');
        }
        return sb.toString();
    }

    private Status determineStatus(String discovered, String secret, int partsCount) {
        if (discovered.equals(secret)) {
            return Status.WON;
        }
        if (partsCount >= Part.values().length) {
            return Status.LOST;
        }
        return Status.PLAYING;
    }

    private static class Event {
        final String word;
        final String letter;
        Event(String word, String letter) {
            this.word = word;
            this.letter = letter;
        }
    }
}
```

