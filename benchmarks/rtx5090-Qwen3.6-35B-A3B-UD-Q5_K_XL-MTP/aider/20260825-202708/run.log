export class List {
  constructor(values = []) {
    this.values = values;
  }

  append(list) {
    for (let i = 0; i < list.values.length; i++) {
      this.values[this.values.length] = list.values[i];
    }
    return this;
  }

  concat(lists) {
    for (let i = 0; i < lists.values.length; i++) {
      const innerList = lists.values[i];
      for (let j = 0; j < innerList.values.length; j++) {
        this.values[this.values.length] = innerList.values[j];
      }
    }
    return this;
  }

  filter(predicate) {
    const newList = new List();
    for (let i = 0; i < this.values.length; i++) {
      if (predicate(this.values[i])) {
        newList.values[newList.values.length] = this.values[i];
      }
    }
    return newList;
  }

  map(fn) {
    const newList = new List();
    for (let i = 0; i < this.values.length; i++) {
      newList.values[newList.values.length] = fn(this.values[i]);
    }
    return newList;
  }

  length() {
    return this.values.length;
  }

  foldl(fn, acc) {
    for (let i = 0; i < this.values.length; i++) {
      acc = fn(acc, this.values[i]);
    }
    return acc;
  }

  foldr(fn, acc) {
    for (let i = this.values.length - 1; i >= 0; i--) {
      acc = fn(acc, this.values[i]);
    }
    return acc;
  }

  reverse() {
    const newList = new List();
    for (let i = this.values.length - 1; i >= 0; i--) {
      newList.values[newList.values.length] = this.values[i];
    }
    return newList;
  }
}
```
