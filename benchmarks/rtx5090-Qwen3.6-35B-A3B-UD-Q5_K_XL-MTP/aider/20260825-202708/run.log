from json import dumps


class Tree:
    def __init__(self, label, children=None):
        self.label = label
        self.children = children if children is not None else []

    def __dict__(self):
        return {self.label: [c.__dict__() for c in sorted(self.children)]}

    def __str__(self, indent=None):
        return dumps(self.__dict__(), indent=indent)

    def __lt__(self, other):
        return self.label < other.label

    def __eq__(self, other):
        return self.__dict__() == other.__dict__()

    def _find_path(self, current, target):
        if current.label == target:
            return [current]
        for child in current.children:
            path = self._find_path(child, target)
            if path:
                return [current] + path
        return None

    def _rebuild_from_path(self, path):
        current_new = None
        for i in range(len(path) - 1, -1, -1):
            node = path[i]
            children_to_add = []
            for child in node.children:
                if i < len(path) - 1 and child is path[i+1]:
                    continue
                children_to_add.append(child)
            if current_new is not None:
                children_to_add.append(current_new)
            current_new = Tree(node.label, children_to_add)
        return current_new

    def from_pov(self, from_node):
        path = self._find_path(self, from_node)
        if path is None:
            raise ValueError("Tree could not be reoriented")
        return self._rebuild_from_path(path)

    def path_to(self, from_node, to_node):
        try:
            new_tree = self.from_pov(from_node)
        except ValueError:
            raise ValueError("No path found")
        path = new_tree._find_path(new_tree, to_node)
        if path is None:
            raise ValueError("No path found")
        return [node.label for node in path]
```
