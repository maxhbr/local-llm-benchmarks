    if (blackColumn === undefined) blackColumn = 3;
    if (whiteRow === undefined) whiteRow = 7;
    if (whiteColumn === undefined) whiteColumn = 3;

    if (blackRow < 0 || blackRow > 7 || blackColumn < 0 || blackColumn > 7) {
