  const lines = readLines(file);
  let found = false;
  
  for (let i = 0; i < lines.length; i++) {
    const line = lines[i];
    const lineNumber = i + 1;
    
    let searchLine = line;
    let searchPattern = pattern;
    
    if (flags.includes('i')) {
      searchLine = searchLine.toLowerCase();
      searchPattern = searchPattern.toLowerCase();
    }
    
    let isMatch;
    if (flags.includes('x')) {
      isMatch = searchLine === searchPattern;
    } else {
      isMatch = searchLine.includes(searchPattern);
    }
    
    if (flags.includes('v')) {
      isMatch = !isMatch;
    }
    
    if (isMatch) {
      found = true;
      if (flags.includes('l')) {
        console.log(file);
        break;
      }
      
      let output = '';
      if (multipleFiles) {
        output += `${file}:`;
      }
      if (flags.includes('n')) {
        output += `${lineNumber}:`;
      }
      output += line;
      console.log(output);
    }
  }
}
```

