            else if (c == 'C') result.push_back(Plant::clover);
            else if (c == 'R') result.push_back(Plant::radishes);
            else if (c == 'V') result.push_back(Plant::violets);
        }
        
        return result;
    }

} // namespace kindergarten_garden
