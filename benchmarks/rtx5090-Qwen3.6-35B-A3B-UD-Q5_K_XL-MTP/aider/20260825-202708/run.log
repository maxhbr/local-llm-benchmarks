transpose.go
```go
package transpose

func Transpose(input []string) []string {
	if len(input) == 0 {
		return []string{}
	}

	runes := make([][]rune, len(input))
	maxLen := 0
	for i, s := range input {
		runes[i] = []rune(s)
		if len(runes[i]) > maxLen {
			maxLen = len(runes[i])
		}
	}

	result := make([]string, maxLen)
	for j := 0; j < maxLen; j++ {
		var col []rune
		// Find the last row that has a character at column j
		// This ensures we don't pad to the right
		lastRow := -1
		for i := len(input) - 1; i >= 0; i-- {
			if j < len(runes[i]) {
				lastRow = i
				break
			}
		}

		for i := 0; i <= lastRow; i++ {
			if j < len(runes[i]) {
				col = append(col, runes[i][j])
			} else {
				col = append(col, ' ')
			}
		}
		result[j] = string(col)
	}

	return result
}
```
