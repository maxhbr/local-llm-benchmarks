        if len(input) == 0 {
                return []Domino{}, true
        }

        // We'll use a slice to keep track of used dominoes to avoid modifying slices repeatedly, or just pass indices.
        // Actually, passing a boolean slice `used` is easier.
        used := make([]bool, len(input))
        chain := make([]Domino, 0, len(input))

        // Start with the first domino. We can fix its orientation to reduce search space.
        // But wait, what if the only valid chain requires the first domino to be rotated?
        // Actually, if a valid chain exists, we can rotate the entire chain so that the first domino matches our fixed orientation.
        // So fixing the first domino's orientation is safe.
