package variablelengthquantity

import "errors"

func EncodeVarint(input []uint32) []byte {
	var out []byte
	for _, n := range input {
		if n == 0 {
			out = append(out, 0)
			continue
		}
		var chunks []byte
		for n > 0 {
			chunks = append(chunks, byte(n&0x7F))
			n >>= 7
		}
		for i := len(chunks) - 1; i >= 0; i-- {
			b := chunks[i]
			if i > 0 {
				b |= 0x80
			}
			out = append(out, b)
		}
	}
	return out
}

func DecodeVarint(input []byte) ([]uint32, error) {
	var result []uint32
	var acc uint32
	var incomplete bool

	for _, b := range input {
		incomplete = true
		acc = (acc << 7) | uint32(b&0x7F)
		if b&0x80 == 0 {
			result = append(result, acc)
			acc = 0
			incomplete = false
		}
	}

	if incomplete {
		return nil, errors.New("incomplete sequence")
	}
	return result, nil
}
