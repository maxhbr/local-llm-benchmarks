```java
import java.time.LocalDate;
import java.time.format.DateTimeFormatter;
import java.util.Arrays;
import java.util.Comparator;
import java.util.List;

public class Ledger {
    public LedgerEntry createLedgerEntry(String d, String desc, int c) {
        LedgerEntry le = new LedgerEntry();
        le.setChange(c);
        le.setDescription(desc);
        le.setLocalDate(LocalDate.parse(d));
        return le;
    }

    public String format(String cur, String loc, LedgerEntry[] entries) {
        if (!cur.equals("USD") && !cur.equals("EUR")) {
            throw new IllegalArgumentException("Invalid currency");
        }
        if (!loc.equals("en-US") && !loc.equals("nl-NL")) {
            throw new IllegalArgumentException("Invalid locale");
        }

        String curSymb = cur.equals("USD") ? "$" : "€";
        String datPat = loc.equals("en-US") ? "MM/dd/yyyy" : "dd/MM/yyyy";
        String decSep = loc.equals("en-US") ? "." : ",";
        String thSep = loc.equals("en-US") ? "," : ".";
        String header = loc.equals("en-US") 
            ? "Date       | Description               | Change       " 
            : "Datum      | Omschrijving              | Verandering  ";

        StringBuilder sb = new StringBuilder();
        sb.append(header);

        Arrays.sort(entries, Comparator.comparing(LedgerEntry::getLocalDate));

        DateTimeFormatter dateFormatter = DateTimeFormatter.ofPattern(datPat);

        for (LedgerEntry entry : entries) {
            String date = entry.getLocalDate().format(dateFormatter);

            String desc = entry.getDescription();
            if (desc.length() > 25) {
                desc = desc.substring(0, 22) + "...";
            }

            double amountVal = Math.abs(entry.getChange()) / 100.0;
            String amountStr = String.format("%.02f", amountVal);
            
            // Format thousands separator
            int dotIndex = amountStr.indexOf('.');
            String intPart = amountStr.substring(0, dotIndex);
            String decPart = amountStr.substring(dotIndex + 1);
            
            StringBuilder formattedInt = new StringBuilder();
            for (int i = 0; i < intPart.length(); i++) {
                if (i > 0 && (intPart.length() - i) % 3 == 0) {
                    formattedInt.append(thSep);
                }
                formattedInt.append(intPart.charAt(i));
            }
            
            String formattedAmount = formattedInt.toString() + decSep + decPart;
            
            String changeStr;
            if (entry.getChange() < 0) {
                if (loc.equals("en-US")) {
                    changeStr = "(" + curSymb + formattedAmount + ")";
                } else {
                    changeStr = curSymb + " -" + formattedAmount + " ";
                }
            } else {
                if (loc.equals("nl-NL")) {
                    changeStr = " " + curSymb + " " + formattedAmount + " ";
                } else {
                    changeStr = curSymb + formattedAmount + " ";
                }
            }

            sb.append(String.format("\n%s | %-25s | %13s", date, desc, changeStr));
        }

        return sb.toString();
    }

    public static class LedgerEntry {
        LocalDate localDate;
        String description;
        double change;

        public LocalDate getLocalDate() { return localDate; }
        public void setLocalDate(LocalDate localDate) { this.localDate = localDate; }
        public String getDescription() { return description; }
        public void setDescription(String description) { this.description = description; }
        public double getChange() { return change; }
        public void setChange(double change) { this.change = change; }
    }
}
```

