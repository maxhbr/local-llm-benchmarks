```python
def can_chain(dominoes):
    if not dominoes:
        return []
        
    n = len(dominoes)
    used = [False] * n
    chain = [tuple(dominoes[0])]
    
    def solve():
        if len(chain) == n:
            return chain[0][0] == chain[-1][1]
            
        last_val = chain[-1][1]
        for i in range(n):
            if not used[i]:
                a, b = dominoes[i]
                if a == last_val:
                    used[i] = True
                    chain.append((a, b))
                    if solve():
                        return True
                    chain.pop()
                    used[i] = False
                if b == last_val:
                    used[i] = True
                    chain.append((b, a))
                    if solve():
                        return True
                    chain.pop()
                    used[i] = False
        return False

    used[0] = True
    if solve():
        return chain
    return None
