        if (j > 0) {
            result += ' ';
        }
        for (size_t i = 0; i < r; ++i) {
            size_t idx = i * c + j;
            if (idx < len) {
                result += normalized_[idx];
            } else {
                result += ' ';
            }
        }
    }
    return result;
}

}  // namespace crypto_square
