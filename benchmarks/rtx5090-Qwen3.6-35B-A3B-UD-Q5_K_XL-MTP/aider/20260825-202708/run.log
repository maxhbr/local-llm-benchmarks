```java
class PigLatinTranslator {
    public String translate(String text) {
        String[] words = text.split(" ");
        StringBuilder result = new StringBuilder();
        for (int i = 0; i < words.length; i++) {
            result.append(translateWord(words[i]));
            if (i < words.length - 1) {
                result.append(" ");
            }
        }
        return result.toString();
    }

    private String translateWord(String word) {
        if (word.startsWith("xr") || word.startsWith("yt") || isVowel(word.charAt(0))) {
            return word + "ay";
        }
        
        int splitIndex = 0;
        for (int i = 0; i < word.length(); i++) {
            char c = word.charAt(i);
            if (c == 'q' && i + 1 < word.length() && word.charAt(i + 1) == 'u') {
                splitIndex = i + 2;
                break;
            }
            if (isVowel(c)) {
                splitIndex = i;
                break;
            }
            if (c == 'y' && i > 0) {
                splitIndex = i;
                break;
            }
        }
        
        return word.substring(splitIndex) + word.substring(0, splitIndex) + "ay";
    }

    private boolean isVowel(char c) {
        return "aeiou".indexOf(c) != -1;
    }
}
