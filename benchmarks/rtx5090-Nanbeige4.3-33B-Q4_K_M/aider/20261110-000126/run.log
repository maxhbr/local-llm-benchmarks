► **THINKING**

The tests expect a `binary_tree<T>` class with `data()`, `left()`, `right()`, and a `tree_ptr<T>` alias, plus `make_tree` and `insert`/`search` functions. I'll implement those in the header and source files.

binary_search_tree.h
```
#if !defined(BINARY_SEARCH_TREE_H)
#define BINARY_SEARCH_TREE_H

#include <memory>
#include <vector>
#include <string>

namespace binary_search_tree {

template <typename T>
class binary_tree {
public:
    explicit binary_tree(T value) : data_(value) {}

    T data() const { return data_; }

    std::unique_ptr<binary_tree<T>> left() const { return left_; }
    std::unique_ptr<binary_tree<T>> right() const { return right_; }

    void insert(const T &value) {
        if (value <= data_) {
            if (!left_) {
                left_ = std::make_unique<binary_tree<T>>(value);
            } else {
                left_->insert(value);
            }
        } else {
            if (!right_) {
                right_ = std::make_unique<binary_tree<T>>(value);
            } else {
                right_->insert(value);
            }
        }
    }

    bool search(const T &value) const {
        if (data_ == value) return true;
        if (value <= data_) return left()->search(value);
        return right()->search(value);
    }

    std::vector<T> sorted() const {
        std::vector<T> result;
        inorder(result);
        return result;
    }

private:
    void inorder(std::vector<T> &result) const {
        if (left_) {
            left_->inorder(result);
        }
        result.push_back(data_);
        if (right_) {
            right_->inorder(result);
        }
    }

    T data_;
    std::unique_ptr<binary_tree<T>> left_;
    std::unique_ptr<binary_tree<T>> right_;
};

template <typename T>
using tree_ptr = std::unique_ptr<binary_tree<T>>;

template <typename T>
tree_ptr<T> make_tree(const std::vector<T> &data) {
    if (data.empty()) return nullptr;
    tree_ptr<T> root = std::make_unique<binary_tree<T>>(data[0]);
    for (size_t i = 1; i < data.size(); ++i) {
        root->insert(data[i]);
    }
    return root;
}

}  // namespace binary_search_tree

#endif // BINARY_SEARCH_TREE_H
