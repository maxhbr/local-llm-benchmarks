```python
import re


class StackUnderflowError(Exception):
    """Exception raised when the stack does not have enough items."""

    def __init__(self, message):
        self.message = message


class Word:
    def __init__(self, name, definition):
        self.name = name
        self.definition = definition


class ForthEvaluator:
    def __init__(self):
        self.stack = []
        self.dictionary = {}
        self.builtins = {
            '+': self._add,
            '-': self._sub,
            '*': self._mul,
            '/': self._div,
            'DUP': self._dup,
            'DROP': self._drop,
            'SWAP': self._swap,
            'OVER': self._over,
        }
        self.dictionary.update(self.builtins)

    def _check_stack(self, required):
        if len(self.stack) < required:
            raise StackUnderflowError(
                "Insufficient number of items in stack"
            )

    def _peek(self):
        self._check_stack(1)
        return self.stack[-1]

    def _pop(self):
        self._check_stack(1)
        return self.stack.pop()

    def _add(self):
        b = self._pop()
        a = self._pop()
        self.stack.append(a + b)

    def _sub(self):
        b = self._pop()
        a = self._pop()
        self.stack.append(a - b)

    def _mul(self):
        b = self._pop()
        a = self._pop()
        self.stack.append(a * b)

    def _div(self):
        b = self._pop()
        a = self._pop()
        if b == 0:
            raise ZeroDivisionError("divide by zero")
        self.stack.append(a // b)

    def _dup(self):
        self._check_stack(1)
        self.stack.append(self.stack[-1])

    def _drop(self):
        self._pop()

    def _swap(self):
        self._check_stack(2)
        b = self.stack.pop()
        a = self.stack.pop()
        self.stack.append(a)
        self.stack.append(b)

    def _over(self):
        self._check_stack(2)
        self.stack.append(self.stack[-2])

    def parse_input(self, input_data):
        tokens = []
        for item in input_data:
            tokens.extend(item.split())
        return tokens

    def tokenize(self, token):
        if re.fullmatch(r'[+-]?\d+', token):
            return int(token)
        return token.upper()

    def execute(self, token):
        if isinstance(token, int):
            self.stack.append(token)
            return
        word = self.dictionary.get(token)
        if word is None:
            raise ValueError(f"Undefined word: {token}")
        if callable(word):
            word()
        else:
            self.execute_definition(word)

    def execute_definition(self, definition):
        for token in definition:
            self.execute(self.tokenize(token))

    def evaluate(self, input_data):
        tokens = self.parse_input(input_data)
        for token in tokens:
            self.execute(self.tokenize(token))
        return self.stack


def evaluate(input_data):
    evaluator = ForthEvaluator()
    return evaluator.evaluate(input_data)
