I will implement the wrapper so it reports total bytes and total operations for reads and writes.

paasio.go
```
package paasio

import "io"

// readCounter and writeCounter track IO statistics.
type readCounter struct {
        reader io.Reader
        bytes  int64
        ops    int
}

type writeCounter struct {
        writer io.Writer
        bytes  int64
        ops    int
}

// ReadWriteCounter is the interface for a wrapper that reports IO statistics.
type ReadWriteCounter interface {
        io.ReadWriter
        ReadCount() (int64, int)
        WriteCount() (int64, int)
}

// NewWriteCounter returns a writeCounter wrapping writer.
func NewWriteCounter(writer io.Writer) WriteCounter {
        return &writeCounter{writer: writer}
}

// NewReadCounter returns a readCounter wrapping reader.
func NewReadCounter(reader io.Reader) ReadCounter {
        return &readCounter{reader: reader}
}

// NewReadWriteCounter returns a ReadWriteCounter wrapping readwriter.
func NewReadWriteCounter(readwriter io.ReadWriter) ReadWriteCounter {
        return &readCounter{reader: readwriter}
}

// Read reads from the underlying reader and records the bytes and operations.
func (rc *readCounter) Read(p []byte) (int, error) {
        n, err := rc.reader.Read(p)
        rc.bytes += int64(n)
        rc.ops++
        return n, err
}

// ReadCount returns the total bytes and operations for reads.
func (rc *readCounter) ReadCount() (int64, int) {
        return rc.bytes, rc.ops
}

// Write writes to the underlying writer and records the bytes and operations.
func (wc *writeCounter) Write(p []byte) (int, error) {
        n, err := wc.writer.Write(p)
        wc.bytes += int64(n)
        wc.ops++
        return n, err
}

// WriteCount returns the total bytes and operations for writes.
func (wc *writeCounter) WriteCount() (int64, int) {
        return wc.bytes, wc.ops
}
```

