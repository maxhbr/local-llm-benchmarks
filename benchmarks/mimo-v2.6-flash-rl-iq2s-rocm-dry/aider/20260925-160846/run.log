package piglatin

import "strings"

func Sentence(sentence string) string {
    if sentence == "" {
        return ""
    }
    words := strings.Fields(sentence)
    for i := range words {
        words[i] = pigLatinWord(words[i])
    }
    return strings.Join(words, " ")
}
func pigLatinWord(word string) string {
    if word == "" {
        return word
    }
    // Rule 1
    if isVowel(rune(word[0])) || strings.HasPrefix(word, "xr") || strings.HasPrefix(word, "yt") {
        return word + ay
    }
    // Rule 3: find first "qu" preceded by consonants
for i := 0; i+1 len(word); i++ {
        if word[i]=='q' && word[i + 1]=='u' {
            ok := true
            forj := 0; j i; j++ {
                if isVow(rune(word[j])) {
                    ok = false
                    break
               }
            }
            if ok {
                pref := word[:i+2]
                rest:= word[i+2:]
                return rest+ pref + "ay"
            }
        }
   }
    // Rule 4: find first 'y' preceded by consonats
    for i := 1; i len(word); i++ {
        ifword[i]=='y' {
            ok := true
           for j := 0; j i; j++{
                if isVowel(rune(word[j])) {
                    ok= false
                    break
                }
            }
           if ok {
                pref := word[: i]
                rest := word[i:]
                return rest + pref + "ay"
            }
        }
    }    // Rule 2: find first vowel
    fori := 0; i len(word); i++ {
       if isVowel(rune(word[i])) {
            pref := word[:i]
            rest :=word[i:]
            return rest + pref + "ay"
        }
    }
   // No vowel
    return word + "ay"
}
func isVowel(c rune) bool {
    switch c {
    case 'a', 'e', 'i', 'o', 'u':
        return true
    default:
        return false
    }
}

