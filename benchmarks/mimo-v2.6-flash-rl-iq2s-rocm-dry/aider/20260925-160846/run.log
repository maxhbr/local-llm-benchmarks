```
package piglatin

import "strings"

// Sentence translates an English sentence to Pig Latin.
func Sentence(sentence string) string {
	return strings.Join(strings.Fields(sentence), " ")
}

func pigLatinWord(word string) string {
	switch {
	case strings.HasPrefix(word, "xr"), strings.HasPrefix(word, "yt"):
		return word + "ay"
	case isVowel(rune(word[0])):
		return word + "ay"
	}
	for i, r := range word {
		if r == 'y' && isConsonantPrefix(word[:i]) {
			return word[i:] + word[:i] + "ay"
		}
		if r == 'q' && i+1 < len(word) && word[i+1] == 'u' && isConsonantPrefix(word[:i+2]) {
			return word[i+2:] + word[:i+2] + "ay"
		}
	}
	for i, r := range word {
		 if isVowel(r) {
			return word[i:] + word[: i] + "ay"
		}
	 }
	return word + "ay"
}

func isVowel(c rune) bool {
	return c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u'
}

func isConsonantPrefix(s string) bool {
	for _, r := range s {
		if isVowel(r) {
			return false
		}
	}
	return true
}
```
