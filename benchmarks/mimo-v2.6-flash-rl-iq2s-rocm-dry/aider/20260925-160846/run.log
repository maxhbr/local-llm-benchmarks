+               words[i] = pigLatinWord(words[i])
+       }
+       return strings.Join(words, " ")
 }
+
+// pigLatinWord translates a single word into Pig Latin.
+func pigLatinWord(word string) string {
+       if word == "" {
+               return word
+       }
+
+       // Rule 1: word starts with a vowel, "xr", or "yt"
+       if isVowel(rune(word[0])) ||
+               strings.HasPrefix(word, "xr") ||
+               strings.HasPrefix(word, "yt") {
+               return word + "ay"
+       }
+
+       // Rule 3: word starts with zero or more consonants followed by "qu"
+       for i := 0; i+1 < len(word); i++ {
+               if word[i] == 'q' && word[i+1] == 'u' {
+                       ok := true
+                       for j := 0; j < i; j++ {
+                               if isVowel(rune(word[j])) {
+                                       ok = false
+                                       break
+                               }
+                       }
+                       if ok {
+                               prefix := word[:i+2] // consonants + "qu"
+                               rest := word[i+2:]
+                               return rest + prefix + "ay"
+                       }
+               }
+       }
+
+       // Rule 4: word starts with one or more consonants followed by "y"
+       for i := 1; i < len(word); i++ {
+               if word[i]=='y' {
+                       ok := true
+                       forj := 0; j < i; j ++ {
+                               if isVowel(rune(word [j])) {
+                                       ok = false
+                                break
+                               }
+                       }
+                if ok {
+                               prefix := word[: i] // consonants before 'y'
+                               rest := word[i:] // 'y' and the rest
+                               return rest + prefix + "ay"
+                        }
+               }
+       }
+
+       // Rule2: word starts with one or more consonants, move them to the end
+       for i := 0; i < len(word); i++ {
+                if isVowel(rune(word[i])) {
+                       prefix := word[:i]
+                       rest := word[i:]
+                       return rest + prefix + "ay"
+               }
+       }
+
+       // No vowel found – treat the whole word as consonants
+       return word + "ay"
+}
+
+// isVowel reports whether the given rune is a vowel (a, e, i, o, u).
+func isVowel(c rune) bool {
+       switch c {
+       case 'a', 'e', 'i','o', 'u':
+               return true
+       default:
+               return false
+       }
+}
```


