                }
            }
            // also need to check word[0] is consonant
            if isVowel(word[0]) {
                ok = false
            }
            if ok {
                prefix := word[1:i] // consonants before y
                rest := word[i:] // y and rest
                return rest + prefix + "ay"
                // Wait: prefix should be consonants before y, but we need to include all consonants before y, which are from 
0 to i-1. But we excluded word[0] if it's consonant? Actually we need to include word[0] as well. So prefix = word[:i]
                // Let's correct.
            }
        }
    }
    // rule 2: find first vowel
    for i := 0; i < len(word); i++ {
        if isVowel(word[i]) {
            prefix := word[:i]
            rest := word[i:]
            return rest + prefix + "ay"
        }
    }
    // no vowel
    return word + "ay"
}

