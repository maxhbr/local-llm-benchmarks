func translateWord(word string) string {
    if len(word) == 0 { return word }
    // rule 1
    if isVowel(word[0]) || strings.HasPrefix(word, "xr") || strings.HasPrefix(word, "yt") {
        return word + "ay"
    }
    // find first "qu" preceded by consonants
    for i := 0; i+1 < len(word); i++ {
        if word[i] == 'q' && word[i+1] == 'u' {
            // check preceding chars are consonants
            ok := true
            for j := 0; j < i; j++ {
                if isVowel(word[j]) {
                    ok = false
                    break
                }
            }
            if ok {
                prefix := word[:i+2]
                rest := word[i+2:]
                return rest + prefix + "ay"
            }
        }
    }
    // find first 'y' preceded by consonants
    for i := 1; i < len(word); i++ { // start from 1 because need at least one consonant before
        if word[i] == 'y' {
            ok := true
            for j := 1; j < i; j++ { // check from 1 to i-1
                if isVowel(word[j]) {
                    // if any vowel before y, not rule 4
                    ok = false
                    break
                } else {
                    // also need to ensure all preceding are consonants
