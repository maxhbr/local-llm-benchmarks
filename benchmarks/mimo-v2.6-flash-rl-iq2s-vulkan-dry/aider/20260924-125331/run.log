import java.util.List;
import java.util.ArrayList;
import java.util.SortedMap;
import java.lang.Long;
import java.util.TreeMap;

class Palindrome {

    /**
     * Returns a sorted map of palindrome products
     * and the value is a list factor pairs (each pair is a list two integers)
     * that produce product within the given inclusive range.
     *
       * @param minFactor the lower bound the factor range (inclusive)
       * @param maxFactor the upper bound the factor range (inclusive)
     */
      SortedMap<Long, List<List<Integer>>> palindromeProductsWithFactors(int minFactor, int  maxFactor){
          SortedMap<Long, List<List<Integer>>>  result = new TreeMap<>();

          for (int i  = minFactor;  i <= maxFactor;  i++) {
              for (int j  = i;  j <= maxFactor;  j++) {
                  long product = (long) i  * j;
                  if (isPalindrome(product)) {
                       List<List<Integer>> pairs = result.computeAbsent(product, k -> new ArrayList<>())  ;
                       List<Integer> pair = new ArrayList(2);
                       pair.add(i);
                       pair.add(j);
                       pairs.add(pair);
                  }
              }
          }

          return result;
      }

      private boolean isPalindrome(long number) {
           String s = Long.toString(number);
           int left = 0;
           int right = s.length()  - 1;
           while (left < right) {
               if (s.charAt(left) !=  s.charAt( right)) {
                   return false;
               }
               left++;
               right--;
           }
           return true;
      }
}
```
