pub mod graph {
    
    #[derive(Clone, Debug, PartialEq, Eq)]
    pub struct Attr(pub String, pub String);
    
    impl Attr {
        pub fn new<K: Into<String>, V: Into<String>>(key: K, value: V) -> Self {
            Attr(key.into(), value.into())
        }
    }

    #[derive(Clone, Debug)]
    pub struct Node {
        pub(crate) name: String,
        pub(crate) attrs: Vec<Attr>,
    }

    fn default_attrs() -> Vec<Attr> {
        Vec::new()
    }

    impl Node {
        pub fn with_attrs(attrs: Vec<Attr>) -> NodeBuilder {
            NodeBuilder {
                attrs,
                ..Default::default()
            }
        }
    }

    impl Default for Node {
        fn default() -> Self {
            Node {
                name: String::new(),
                attrs: default_attrs(),
            }
        }
    }

    #[derive(Default)]
    pub struct NodeBuilder {
        name: String,
        attrs: Vec<Attr>,
    }

    pub struct EdgeBuilder {
        from: String,
        to: Option<String>,
        name: Option<String>,
        attrs: Vec<Attr>
    }

    impl EdgeBuilder {
        pub fn new(from: &str) -> Self {
            EdgeBuilder {
                from: from.to_string(),
                to: None,
                name: None,
                attrs: Vec::new(),
            }
        }

        pub fn to(mut self, to: &str) -> Self {
            self.to = Some(to.to_string());
            self
        }

        pub fn with_attrs(mut self, attrs: &[Attr]) -> Self {
            self.attrs.extend(attrs.iter().cloned());
            self
        }
    }

    pub struct Edge {
        pub(crate) from: String,
        pub(crate) to: String,
        pub(crate) name: Option<String>,
        pub(crate) attrs: Vec<Attr>
