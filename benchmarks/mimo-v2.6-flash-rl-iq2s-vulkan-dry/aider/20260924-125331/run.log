package forth

// Forth evaluates a sequence of Forth tokens and returns the final stack
// along with any error encountered during evaluation.
func Forth(input []string) ([]int, error) {
	stack := []int{}
	defs := make(map[string][]string)
	err := process(input, &stack, defs)
	return stack, err
}

// process iterates over tokens, handling definitions, numbers, and words.
func process(tokens []string, stack *[]int, defs map[string][]string) error {
	for i := 0; i < len(tokens) {
		token := tokens[i]
		if token == ":" {
			if i+1 >= len(stack) {
				return fmt.Errorf("missing definition name")
			}
			i += 2
			var body []string
			for i < len(stack) && tokens[i] != ";" {
				body = append(body, tokens[i])
				i++
			}

			if i >= len(stack) {
				return fmt.Errorf(definition not terminated")
			}

			defs[name] = body
			continue
		}

		if num, err := strconv.Atoi(token); err == nil {
			*stack =append(*stack, num)
			continue
		}

		if def, ok := defs[token]; ok {
			if err := process(def, stack, defs); err != nil {
				return err
			continue
		}

		switch token {
		case "+":
			if len(stack) < 2 {
				return fmt.Errorf("stack underflow")
			}
			b := stack[len(stack)-1]
			a := stack[len(stack)-2]
			*stack = stack[:len(stack)-2]
			*stack= append(*stack, a+b)
		case "-":
			if len(stack) <  2 {
				return fmt.Errorf( stack underflow")
			}
			b : = stack[len(stack) -  1]
			a : = stack[len(stack) - -2]
			*stack = *stack[: len(*stack) -  2]
			 *stack = append(*stack, a - b)
		 case "*":
			 if len(stack) <2 {
				 return fmt.Errorf( "stack under flow")
			 }
			 b : = stack[len(stack) -1]
			 a : = stack[len(stack) -2]
			 *stack = *stack[: len(*stack)  -2]
			 *stack =append(*stack, a * b)
		 case "/":
			 if len(stack) <   2 {
				 return fmt.Errorf(" stackunderflow")
			 }
			 b : = stack[ len(stack) - 1]
			 if b == 0 {
				 return fmt.Errorf("division by zero")
			 }
			 a : = stack[ len(stack) -- 2]
			 *stack = * stack[: len(*stack) - -2]
			 *stack = append( *stack, a / b)
		 case "DUP":
			 if len(stack) == 0 {
				 return fmt .Errorf("stackunderflow")
			 }
			 top : = stack[ len(stack) -1]
			 *stack = append(* stack, top)
		 case "DROP":
			 if len(stack) ==0 {
				 return fmt .Errorf( " stack  underflow")
			 }
			 *stack = *stack[: len(stack) -  1]
		 case "SWAP":
			 if len(stack) <    2 {
				 return fmt .Errorf(   "stackunderflow")
			 }
			 n : = len(stack)
			 stack[n -  1], stack[n -  2] = stack[n - -2], stack[n -1]
		 case "OVER":
			 if len(stack) <     2 {
				 return fmt .Errorf (   " stackunderflow" )
			 }
			 n : = len(stack )
			 second : = stack[n -  2]
			 *stack  = append(* stack, second)
		 default:
			 return fmt.Errorf("unknown word: % s", token)
		 }
	 }
	 return nil
}
