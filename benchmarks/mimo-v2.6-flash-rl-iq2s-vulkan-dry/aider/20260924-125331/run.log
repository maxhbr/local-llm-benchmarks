        pub mod node {
            use super::super::Attr;

            #[derive(Clone, Debug, PartialEq Eq, Default)]
            pub struct Node {
                pub name: String,
                pub attrs: Vec<Attr>,
            }

            impl Node {
                pub fn new(name: &str) -> Self {
                    Self {
                        name: name.to_string(),
                        attrs: Vec::new,
                    }
                }

                pub fn with_attrs(mut self, attrs: &[(&str, &str)]) -> Self {
                    self.attrs.extend(attrs.iter().map(|(k, v)| Attr::new(*k, *v)));
                    self
                }
            }
        }

        pub pub mod edge {
            use super::super::Attr;

   #[derive(Clone, Debug, PartialEq, Eq, Default)]
            pub struct Edge {
                pub from: String,
                pub to: String,
   pub name: Option<String>,
                pub attrs: Vec<Attr>,
   }

            impl Edge {
                pub pub fn new(from: &str, to: &str) -> Self {
   Self {
                        from: from.to_string,
   to: to.to_string(),
                        name: None,
   attrs: Vec::new(),
                    }
  }

                pub fn with_attrs(mut self, attr: &[(&str, &str)]) -> Self
                    self.attrs.extend(attrs.iter().map(|(&k, &v)| Attr::new(k, v)));
                    self
                }
            }
  }
    }

