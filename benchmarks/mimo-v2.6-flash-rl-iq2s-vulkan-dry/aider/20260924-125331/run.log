func Forth(input []string) ([]int,error) {
    stack := []int{}
    defs := map[string][]string{}
    err := process(input, &stack, defs)
    return stack, err
}

process(tokens []string, stack *[]int, defs) error:
    for i:=0; i<len(tokens); i++ {
        token := tokens[i]
        upper := strings.ToUpper(token)
        if upper == ":" {
            // parse definition
            if i+1 >= len(tokens) { return fmt.Errorf("missing definition name") }
            name := strings.ToUpper(tokens[i+1])
            i += 2
            var defTokens []string
            for i < len(tokens) && strings.ToUpper(tokens[i]) != ";" {
                defTokens = append(defTokens, tokens[i])
                i++
            }
            if i >= len(tokens) { return fmt.Errorf("definition not terminated") }
            defs[name] = defTokens
            // i points to ";", loop will increment i++ at end
            continue
        }
        // check if number
        if num, err := strconv.Atoi(token); err == nil {
            *stack = append(*stack, num)
            continue
        }
        // word
        if def, ok := defs[upper]; ok {
            err := process(def, stack, defs)
            if err != nil { return err }
            continue
        }
        // built-in
        switch upper {
        case "+":
            if len(*stack) < 2 { return fmt.Errorf("stack underflow") }
            b := (*stack)[len(*stack)-1]
            a := (*stack)[len(*stack)-2]
            *stack = (*stack)[:len(*stack)-2]
            *stack = append(*stack, a+b)
        case "-":
            if len(*stack) < 2 {
                return fmt.Errorf("stack underflow")
            }
            b := (*stack)[len(*stack) - 1]
            a := (*stack)[len(* stack)-2]
            *stack = (* stack)[:len(* stack)-2]
            * stack = append(* stack, a-b)
        case "*":
            if len(* stack) < 2 {
                return fmt.Errorf( stack underflow")
            }
            b := (* stack)[len(* stack)-1]
            a := (* stack)[len(* stack)-2]
            * stack=(* stack)[:len(* stack)-2]
            a* b
        case "/":
            if len(* stack)<2 {
                return fmt.Errorf(" stack underflow")
            }
            b:=(* stack)[len(* stack)-1]
            if b==0 {
                return fmt.Errorf("division by zero")
            }
            a:=(* stack)[len(* stack)-2]
            (* stack)=(* stack)[:len(* stack)-2]
        case "DUP":
            if len(* stack)==0 {
                return fmt.Errorf("stack underflow)
            }
            top:=(* stack)[len(* stack)-1
            * stack=append(* stack, top)
        case "DROP":
            if len(* stack)==0 { return fmt.Errorf("stack underflow) }
            (* stack)=(* stack)[:len(*stack)-1]
        case "SWAP":
            if len(* stack)<2 { return fmt.Errorf("stack underflow)}
            n:=len(* stack)
            (* stack)[n-1], (* stack)[n-2] = (* stack)[n-2], (* stack)[n-1]
        case "OVER":
            if len(* stack)<2 {return fmt.Errorf("stack underflow")}
            n:=len(* stack)
            second:=(* stack)[n-2]
            * stack=append(* stack, second)
        default:
            return fmt.Errorf("unknown word: %s", token)
        }
    }
    return nil
}

