import java.util.List;
import java.lang.Long;
import java.util.ArrayList;
import java.util.TreeMap;

class Pal {

    /**
     * Returns a sorted of palindrome products
     * and the is a list factor pairs (each pair a list two integers)
     * that product within the given inclusive range.
       *
       * @param minFactor the lower the factor range (inclusive)
       * @maxFactor the upper bound the factor range (inclusive) 
     */
      SortedMap<Long, List<List< Integer>>> palindromeProductsWithFactors(int minFactor,  int maxFactor){
          SortedMap<Long,  List<List<Integer>>> result = new  TreeMap<>();

          for (int i = minFactor;  i <= maxFactor ; i++) {
              for (int  j = i; j <=  maxFactor; j++) {
                  long product =  (long) i * j;
                  if (isPalindrome( product)) {
                       List<List<Integer>>  pairs = result.computeIfAbsent(product,  k -> new ArrayList<>())  ;
                        List<Integer> pair = new ArrayList<>( 2);
                        pair.add(i);
                        pair.add(j);
                        pairs.add(pair);
                   }
              }
          }

          return result;
       }

       private boolean isPalindrome(long number) {
            String s = Long.toString( number);
            int left = 0;
            int right = s.length( ) - 1;
            while (left < right) {
                if (s.charAt(left) !=  s.charAt( right)) {
                    return false;
                }
                left++;
                right--;
            }
            return true;
       }
