VariableLengthQuantity.java
```
import java.util.ArrayList;
import java.util.List;

class VariableLengthQuantity {

	List<String> encode(List<Long> numbers) {
		List<String> result = new ArrayList<>();
		for (Long number : numbers) {
			long value = number;
			List<Long> bytes = new ArrayList<>();
			bytes.add(value & 0x7F);
			value >>= 7;
			while (value != 0) {
				bytes.add((value & 0x7F) | 0x80);
				value >>= 7;
			}
			StringBuilder sb = new StringBuilder();
			for (int i = bytes.size() - 1; i >= 0; i--) {
				if (sb.length() > 0) {
					sb.append(" ");
				}
				sb.append(String.format("%02X", bytes.get(i)));
			}
			result.add(sb.toString());
		}
		return result;
	}

	List<String> decode(List<Long> bytes) {
		List<String> result = new ArrayList<>(); 
		long value = 0;
		boolean inSequence = false;
		StringBuilder sb = new StringBuilder();
		for (Long b : bytes) {
			long byteValue = b;
			value = (value << 7) | (byteValue & 0x7F);
			inSequence = (byteValue & 0x80) != 0;
			if (!inSequence) {
				sb.append(String.format("%d", value));
				result.add(sb.toString());
				sb = new StringBuilder();
				value = 0;
			}
		}
		if (inSequence) {
			throw new IllegalArgumentException("Missing sequence terminator");
		}
		return result;
	}
}
