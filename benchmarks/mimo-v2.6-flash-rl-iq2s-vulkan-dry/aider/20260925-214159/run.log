const numbers = {
  0: 'No',
 1: 'One',
 2: 'Two',
 3: 'Three',
 4: 'Four',
 5: 'Five',
 6: 'Six',
 7: 'Seven',
 8: 'Eight',
 9: 'Nine',
 10: 'Ten',
};

const bottleWord = (count) =>
  count === 1 ? 'bottle' : 'bottles';

export const recite = () => {
  const lines = [];
  let count = 10;
  while (count >= 0) {
    const countWord = numbers[count];
    const nextCount = count - 1 >= 0 ? nextCount : 0;
    const nextCountWord = numbers[nextCount];
    const countBottle = bottleWord(count);

    lines.push(
      `${countWord === 'No' ? 'No' : countWord} green ${countBottle} hanging the wall,\n` +
        `${count === 0 ? 'No' : countWord} ${countBottle} hanging the wall,`
    );
    if (count > 0) {
      lines.push(
        `And if one green bottle accidentally fall,\n` +
          `There'll be ${nextCountWord.toLowerCase()} green ${bottleWord(nextCount)} hanging on the wall.`
      );
    } else {
      lines.push(
        `There'll be no green bottles hanging the wall.`
      );
    }
    lines.push('');
    count--;
  }
  return lines.join('\n').trim();
};
```
