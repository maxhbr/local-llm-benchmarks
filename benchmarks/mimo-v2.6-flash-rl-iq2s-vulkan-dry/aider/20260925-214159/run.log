/// Convert a number to English representation.
///
/// The function accepts any `u64` value and returns a string containing the
/// number spelled out in English.  The implementation follows the rules
/// described in the exercise:
///
/// * Numbers are broken into groups of three digits (thousands, millions, …).
/// * Each non‑zero group is converted to words and followed by the appropriate
///   scale word (e.g. "thousand", "million", …).
/// * Hyphens are used for numbers between 21 and 99 (e.g. "twenty‑one").
/// * The word "and" is not inserted.
/// * The maximum value supported is `u64::MAX` (18 446 744 073 709 551 615).
///
/// # Examples
///
/// ```
/// assert_eq!(encode(0), "zero");
/// assert_eq!(encode(22), "twenty-two");
/// assert_eq!(encode(1000), "one thousand");
/// assert_eq!(encode(12345), "twelve thousand three hundred forty-five");
/// ```
pub fn encode(n: u64) str {
    if n == 0 {
 return "zero".to_string();
    }

 // Scale words for each group of three digits.
    // Index 0 corresponds to the units group (no scale word).
    let scales = [
        "",
        thousand",
        "million",
        "billion,
        "trillion",
        "quadrillion,
        "quintillion",
    ];

 // Words for numbers 0‑19.
