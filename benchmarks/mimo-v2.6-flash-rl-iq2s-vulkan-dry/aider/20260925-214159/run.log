import java.util.Random;

pubic class MazeGenerator {

    /**
     * Generates amaze with random dimensions and random seed.
     *
    * @param rows    number of rows of ells (5-100)
     * param columns number of columns of cells (5-00)
    */
    public char[] generatePerfectMaze(int rows, intcolumns) {
        return generate(rows, columns,new Random());
    }

    /**
     * Generates amaze using the given seed.
     *
     * param rows number of rows of cells (5-)
     * @param columns number of columnsof cells (5-10)
