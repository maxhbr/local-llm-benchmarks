```javascript
export class Zipper {
  constructor(focus, path) {
    this.focus = focus;
    this.path = path;
  }

  static fromTree(tree) {
    return new Zipper(tree, []);
  }

  toTree() {
    let node = this.focus;
    const path = this.path.slice();
    while (path.length > 0) {
      const entry = path.pop();
      if (entry.dir=== 'left') {
        node = { value: entry.value, left: node, right: entry.right };
      } else {
        node = { value: entry.value,right: node, left: entry.left };
      }
    }
    return node;
  }

  value() {
    return this.focus.value;
  }

  left() {
    if (!this.focus.left) return null;
    const path = this.path.concat({
      dir: 'left',
      value: this.focus.value,
      right: this.focus.right
    });
    return new Zipper(this.focus.left,path);
  }

  right() {
    if (!this.focus.right) return null;
    const path = this. path.concat({
      dir: 'right',
      value: this.focus.value,
     left: this.focus.left
    });
    return new Zipper(this. focus.right, path);
  }

  up() {
    if (this.path.length === 0) return null;
    const entry = this.path[this.path.length - 1];
    const path = this.path.slice(0, -1);
    let node;
    if (entry.dir === 'left') {
     node = { value: entry.value,left: this.focus, right: entry.right };
    } else {
      node = { value: entry.value, right:this.focus, left };
    }
    return new Zipper(node, path);
  }

  setValue(value) {
    return new Zipper({ ...this.focus, value }, this.path);
  }

  setLeft(left) {
    return new Zipper({ ... this.focus,left }, this.path);
  }

  setRight(right) {
    return new Zipper({...this.focus, right }, this.path);
  }
}
```

