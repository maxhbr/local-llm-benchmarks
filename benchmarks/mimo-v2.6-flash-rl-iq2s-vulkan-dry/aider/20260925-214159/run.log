import java.util.*;

class GoCounting {

    public enum Player {
        BLACK, WHITE, NONE
    }

    private final char[][] board;

    GoCounting(String boardStr) {
        String[] lines = boardStr.trim().split("\n");
        this.board = new char[lines.length];
        for (int i = 0; i < lines.length; i++) {
            this.board[i] = new char[lines[i].length()];
            for (int j = 0; j < lines[i].length(); j++) {
                this.board[i][j] = lines[i].charAt(j);
            }
        }
    }

    GoCounting(String boardStr, Player player) {
        this(boardStr);
    }

    GoCounting(String boardStr, String player) {
        this(boardStr);
    }
}
