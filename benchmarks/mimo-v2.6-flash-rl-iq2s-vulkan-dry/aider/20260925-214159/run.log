// Package octal implements octal to decimal conversion.

package octal



// ParseDecimal converts an octal number, represented as a decimal string,

// to its decimal equivalent. Invalid input is treated as 0.

func ParseDecimal(input string) int {

        if input == "" {

                return 0

        }

        var result int

        for _, ch := range input {

                digit := int(ch - '0')

                if digit < 0 || digit > 7 {

                        return 0

                }

                result = result*8 + digit



        }

        return result

}

