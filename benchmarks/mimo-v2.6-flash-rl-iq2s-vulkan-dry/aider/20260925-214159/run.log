package wordsearchimport (
	"fmt"
)

// Solve searches for the first occurrence of eachword in the puzzle
// and returns the startand end coordinates of that word. Thecoordinates
// are represented as[row, col] pairs.
func Solve(words[]string, puzzle []string) (map[string][2] [2]int, error) {
	// Convert puzzle to a grid of runes for easier indexing
	grid := make([][]rune, len(puzzle))
	for i, row := range puzzle {
		grid[i] = []rune(row)
	}

	result := make(map[string][2][2]int)

	// Directions: (dx, dy) where dx is column delta,dy is row delta
	dirs := [][2]int{
		{0, 1},   // right
		{0, -1},  // left
		{1, 0},   // down
		{-1, 0},  // up
		{1, 1},   // down-right
		{1, -1},  // down-left
		{-1, 1},  // up-right
		{-1, -1}, // up-left
	}

	for _, word := range words {
		runes := []rune(word)
		found := false
		for r := 0; r < len(grid) && !found; r++ {
			for c := 0; c < len(grid[r]) && !found; c++ {
				for _, d := range dirs {
					dx, dy := d[0], d[1]
					// Check if word fits within bounds
					endR := r + (len(runes)-1)*dy
					endC := c + (len(runes)-1)*dx
					if endR < 0 || endR >= len(grid) || endC < 0 || endC >= len(grid[r]) {
						continue
					}
					// Check match
					match := true
					for k := 0; k < len(runes); k++ {
						rr := r + k*dy
						cc := c + k*dx
						if grid[rr][cc] != runes[k] {
							match = false
							break
						}
					}
					if match {
						result[word] = [2][2]int{{r, c}, {endR, endC}}
						found = true
						break
					}
				}
			}
		}
		if !found {
			return nil, fmt.Errorf("word %q not found in puzzle", word)
		}
	}

	return result, nil
}
```
