grade_school.cpp

```diff
@@ -1,5 +1,37 @@
+#include <algorithm>
+#include <stdexcept>
+
 #include "grade_school.h"
 
 namespace grade_school {
 
+void grade_school::add(const std::string &name, int g) {
+    // Check if the student already exists in any grade.
+    for (const auto &pair : grades_) {
+        if (pair.second.find(name) != pair.second.end()) {
+            // Duplicate – ignore.
+            return;
+        }
+    }
+    grades_[g].insert(name);
+}
+
+std::map<int, std::vector<std::string>>
+grade_school::roster() const {
+    std::map<int, std::vector<std>> result;
+    for (const auto &pair : grades) {
+        std::vector<std::string> names(pair.second.begin(), pair.second.end());
+        result[pair.first] = std::move(names);
+    }
+    return result;
+}
+
+std::vector<std::string> grade_school::grade(int g) const {
+    auto it = grades_.find(g);
+    if (it == grades_.end()) {
+        return {};
+    }
+    return std::vector<std::string>(it->second.begin(), it->second.end());
+}
+
 }  // namespace grade_school
