def encode(numbers: list[int]) -> list[int]:
    """Encode a list of integers into variable length quantities."""
    result = []
    for number in numbers:
        if number < 0:
            raise ValueError("cannot encode negative numbers")
        bytes_ = [number & 0x7F]
        number >>= 7
        while number:
            bytes_.append((number & 0x7F) | 0x80)
            number >>= 7
        result.extend(reversed(bytes_))
    return result


def decode(bytes_: list[int]) -> list[int]:
    """Decode a list of variable length quantities into integers."""
    result = []
    value = 0
    for byte in bytes_:
        value = (value << 7) | (byte & 0x7F)
        if not byte & 0x80:
            result.append(value)
            value = 0
    if value:
        raise ValueError("incomplete sequence")
    return result
```
