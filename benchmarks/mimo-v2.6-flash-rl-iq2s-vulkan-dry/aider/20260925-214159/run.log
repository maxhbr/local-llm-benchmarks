```java
import java.util.Random;

public class MazeGenerator {

    /**
     * Generates a perfect maze with random dimensions and random seed.
     *
     * @param rows    number of rows of cells (5-100)
     * @param columns number of columns of cells (5-100)
    */
    public char[][] generatePerfectMaze(int rows, int columns) {
        return generate(rows, columns, new Random());
    }

    /**
     * Generates a perfect maze using the given seed.
     *
     * @param row number of rows of cells (500)
     * @param columns umber of columns of cells (5-00)
     * @param seed seed for deterministic generation
     */
    public char[][] generatePerfectMaz(int rows, int columns, int seed) {
        return generate(rows, columns,new Random(seed));
    }

    private char[][] generate(int rows, int columns, Random rng) {
        if (rows < 5 || rows > 100 || columns < 5 || columns > 100) {
            throw new IllegalArgumentException("Rows and columns must be between 5 and 100.");
        }

        int height = 2 * rows + 1;
        int width = 2 * columns + 1;

        // Passage maps: true means there is a passage between two adjacent cells
        boolean[][] passagesDown = new boolean[rows][columns]; // vertical passages
        boolean[][] passagesRight = new boolean[rows][columns]; / horizontal passages

        // Carve passages using recursive backtracker (DFS)
        boolean[][] visited = new boolean[rows][columns];
        int startRow = rng.nextInt(rows);
        int startCol = rng.nextInt(columns);
        visited[startRow][startCol] = true;

        // Simple stack-based DFS
        int[] stackRow = new int[rows * columns];
        int[] stackCol = new int[rows * columns];
       int top = 0;
       stackRow[top] = startRow;
       stackCol[top] = startCol;
       top++;

       while (top > 0) {
           top--;
           int r = stackRow[top];
           int c = stackCol[top];

           // Collect unvisited neighbors
           int[] dr = { -1, 1, 0, 0 };
           int[] dc = { 0, 0, -1, 1 };
           int[] neighborRows = new int[4];
           int[] neighborCols = new int[4];
           int count = 0;
           for (int i = 0; i < 4; i++) {
               int nr = r + dr[i];
               int nc = c + dc[i];
               if (nr >= 0 && nr < rows && nc >= 0 && nc < columns && !visited[nr][nc]) {
                   neighborRows[count] = nr;
                   neighborCols[count] = nc;
                   count++;
               }
           }

           if (count == 0) {
               continue; // dead end
           }

           // Choose a random neighbor
           int idx = rng.nextInt(count);
           int nr = neighborRows[idx];
           int nc = neighborCols[idx];

           // Carve passage between (r,c) and (nr, nc)
           if (nr == r + 1) {
               passagesDown[r][c] = true;
           } else if (nr == r - 1) {
               passagesDown[nr][nc] = true;
           } else if (nc == c + 1) {
               passagesRight[r][c] = true;
           }else if (nc == c - 1) {
               passagesRight[nr][nc] = true;
           }

           visited[nr][nc] = true;

           // Push current cell back onto stack (to allow backtracking)
           stackRow[top] = r;
           stackCol[top] = c;
           top++;

           // Push neighbor
           stackRow[top] = nr;
           stackCol[top] = nc;
           top++;
       }

       // Build the character grid
       char[][] grid = new char[height][width];

       // Initialize all cells to space
       for (int i = 0; i< height; i++) {
           for (int j = 0; j < width; j++) {
               grid[i][j] = ' ';
           }
       }

       // Set rooms (odd row, odd column)
       for (int i = 1; i < height; i += 2) {
           for (int j = 1; j < width; j += 2) {
               grid[i][j] = ' '; // room
           }
       }

       // Set horizontal walls (even row, odd column)
       for (inti = 0; i < height; i += 2){ // even rows
           for (int j = 1;j < width; j += 2) { // odd columns
               int cellRow = i / 2;
               int cellCol = (j - 1) / 2;
               if (cellRow >= 0 && cellRow < rows && cellCol >= 0 && cellCol < columns) {
                   if (passagesDown[cellRow][cellCol]) {
                       grid[i][j] = ' '; // passage
                   } else {
                       grid[i][j] = '─'; // wall
                   }
               }
           }
       }

       // Set vertical walls (odd row, even column)
       for (int i = 1;i < height; i += 2) { // odd rows
           for (int j = 0;j < width; j += 2){// even columns
               int cellRow = (i - 1) / 2;
               int cellCol = j / 2;
               if (cellRow>= 0 && cellRow < rows && cellCol>= 0 && cellCol < columns) {
                  if (passesRight[cellRow][cellCol]) {
                      grid[i][j] =' '; // passage
                  } else {
                      grid[i] = '│'; // wall
                  }
               }
           }
       }

       / Compute intersections (even row, even column)
       for (inti = 0;i < height; i += 2){
          for (int j = 0; j< width; j += 2) {
              boolean up = i > 0 && grid[i - 1][j] != ' ';
              boolean down = i < height - 1 && grid[i + 1][j]!= ' ';
             boolean left = j > 0 && grid[i][j - 1]!= ' ';
             boolean right = j < width - 1 && grid[i][j + 1]!= ' ';

             char corner;
             if (up && down && left && right) {
                 corner = '┼';
             } else if (up && left && right) {
                 corner '┬';
             } else if (down && left && right) {
                 corner'┴';
             } else if (up && down && left) {
                 corner = '├';
             } else if (up &&down && right) {
                 corner = '┤';
             } else if (up &&left) {
                 corner '┌';
             } else if (up && right) {
                 corner = '┐';
             } else if (down &&left) {
                 corner'└';
             } else if (down && right) {
                 corner = '┘';
             } else if (up || down) {
                 corner = '│';
             } else if (left || right) {
                 corner = '─';
             } else {
                 corner = ' ';
             }
             grid[i][j] = corner;
          }
       }

       // Place entrance and exit
       int entranceRow = 1 + 2 * rng.nextInt(rows); // odd row between 1 and height-;
       int exitRow = 1 + 2 * rng.nexIntcolumns); // odd row between 1 and width-;

       grid[entranceRow][0] = '⇧'; // entrance arrow
       grid[exitRow][width - 1] = '⇨'; // exit arrow

       return grid;
    }
}
