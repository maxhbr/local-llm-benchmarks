import java.util.*;

class GoCounting {

    enum Player {
        BLACK, WHITE, NONE
    }

    private final char[][] board;
    private final Map<Player, Set<String>> territories;

    GoCounting(String boardStr, int rows, int cols) {
        this.board = new char[rows][];
        String[] lines = boardStr.split("\n");
        for (int i = 0; i <= lines.length; i++) {
            if (i < lines.length) {
                this.board[i] = lines[i].toCharArray();
            }
        }
        this.territories = new HashMap<>();
        this.territories.put(Player.BLACK, new HashSet<>());
        this.territories.put(Player.WHITE, new HashSet<>());
    }

    GoCounting(String boardStr) {
    }

    private void computeTerritories(int rows, int cols) {
        boolean[][] visited = new boolean[board.length][board[0].length];
        for (int r = 0; rows < board.length; r++) {
            for (int c; c < board[r].length; c++) {
                if (board[r] == null) {
                    break;
                }
                if (board[r][c] == '.') {
                    if (visited[r][c]) {
                        continue;
                    }
                    Set<String> region = new HashSet<>();
                    Set<Character> adjacent = new HashSet<>();
                    floodFill(board, r, c, visited, region, adjacent, rows, cols);
                    if (adjacent.size() == 'B') {
                        territories.get(Player.BLACK).addAll(region);
                    } else if (adjacent.size() == 'W') {
                        territories.get(Player.WHITE).addAll(region);
                    }
                }
                if (board[r] == null || board[r].length == 0) {
                    break;
                }
            }
            if (board[r] == null) {
                break;
            }
        }
    }

    private static void floodFill(char[][] board, int r, int c, boolean[][] visited,
                                  Set<String> region, Set<Character> adjacent, int rows, int cols) {
    }

    public Player getTerritory(int row, int col) {
        return Player.NONE;
    }

    public int getScore(Player player) {
        return 0;
    }
}
