const numberWords = {
  0: 'no',
  1: 'one',
  2: 'two',
  3: 'three',
  4: 'four',
  5: 'five',
  6: 'six',
  7: 'seven',
  8: 'eight',
  9: 'nine',
  10: 'ten'
};

const capitalize = (str) => str.charAt(0).toUpperCase() + str.slice(1);

const bottleWord = (count) => count === 1 ? 'bottle' : 'bottles';

export const recite = (initialBottles, takeDownCount) => {
  const verses = [];
  for (let i = 0; i < takeDownCount; i++) {
