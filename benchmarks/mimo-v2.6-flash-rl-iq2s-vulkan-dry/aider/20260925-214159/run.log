Let me now write the complete rendering code:

```java
// Build the character grid
char[][] grid = new char[height][width];

// Initialize all cells to space
for (int i = 0; i < height; i++) {
    for (int j = 0; j < width; j++) {
        grid[i][j] = ' ';
    }
}

// Set boundary walls
// Top boundary (row 0)
for (int j = 1; j < width; j += 2) {
    grid[0][j] = '─';
}
// Bottom boundary (row height-1)
for (int j = 1;j < width; j += 2) {
   grid[height - 1][j] = '─';
}
 // Left boundary (column 0)
for (int i = 1; i < height; i += 2) {
    grid[i][0] = '│';
}
// Right boundary (column width-1)
for (int i = 1;i < height; i += 2) {
   grid[i][width - 1] = '│';
}

// Set interior horizontal walls
// Wall at row 2*(r+1) between cell rows r and r+1
for (int r = 0; r < rows - 1; r++) {
   int i = 2 * (r + 1);
   for (int c = 0; c < columns; c++) {
       int j = 2 * c + 1;
       if (passagesDown[r][c]) {
           grid[i][j] = ' ';
       } else {
           grid[i][j] = '─';
       }
   }
}

// Set interior vertical walls
// Wall at column 2*(c+1) between cell columns c and c+1
for (int c = 0; c< columns - 1; c++) {
   int j = 2 * (c + 1);
   for (int r = 0; r< rows; r++) {
       int i = 2 * r + 1;
       if (passagesRight[r][c]) {
           grid[i] [j] = ' ';
       } else {
          grid[i][j] = '│';
       }
   }
}

// Compute intersections (even row, even column)
for (int i = 0;i < height; i += 2) { for (int j = 0; j< width; j += 2) {
       boolean up = i > 0 && grid[i - 1][j] != ' ';
       boolean down = i < height - 1 && grid[i + 1][j] != ' ';
      boolean left = j > 0 && grid[i][j - 1] != ' ';
      boolean right = j < width - 1 && grid[i][j + 1] != ' ';

      char corner;
      if (up && down && left && right) {
          corner = '┼';
      } else if (down && left && right) {
          corner = '┬';
      } else if (up && left && right) {
          corner = '┴';
      } else if (up && down && right) {
          corner = '├';
      } else if (up && down&& left) {
          corner = '┤';
      } else if (down&& right) {
          corner = '┌';
      } else if (down &&left) {
          corner = '┐';
      } else if (up&& right) {
          corner = '└';
      } else if (up &&left) {
          corner = '┘';
      } else if (up || down) {
          corner = '│';
      } else if (left || right) {
          corner = '─';
      } else {
          corner = ' ';
      }
      grid[i][j] = corner;
   }
}

// Place entrance and exit
int entranceRow = 1 + 2 * rng.nextInt(rows);
int exitRow = 1 + 2 * rng.nextInt(rows);

grid[entranceRow][0] = '⇨';
grid[exitRow][width - 1] = '⇨';
```

