```
package counter

import "strings"

// Counter tracks the number of lines, letters, and characters
// across all strings added to it.
type Counter struct {
	lines      int
	letters    int
	characters int
}

// NewCounter returns a new, empty Counter.
func NewCounter() *Counter {
	return &Counter{}
}

// AddString processes the given string, updating the line,
// letter, and character counts.
func (c *Counter) AddString(s string) {
	if len(s) == 0 {
		return
	}

	c.characters += len(s)

	// Count letters (alphabetic characters) using unicode-aware check.
	for _, r := range s {
		if isLetter(r) {
			c.letters++
		}
	}

	// Count lines: number of newline characters plus one if the
	// string does not end with a newline (or is non-empty).
	c.lines += strings.Count(s, "\n")
	if !strings.HasSuffix(s, "\n") {
		c.lines++
	}
}

// Lines returns the total number of lines seen so far.
func (c *Counter) Lines() int {
	return c.lines
}

// Letters returns the total number of letters seen so far.
func (c *Counter) Letters() int {
	return c.letters
}

// Characters returns the total number of characters seen so far.
func (c *Counter) Characters() int {
	return c.characters
}

// isLetter reports whether the rune is a Unicode letter.
func isLetter(r rune) bool {
	return (r >= 'a' && r <= 'z') ||
		(r >= 'A' && r <= 'Z') ||
		(r >= 0xC0 && // rough approximation for non-ASCII letters
			((r >= 0xC0 && r <= 0x24F) || // Latin extended
				(r >= 0x370 && r <= 0x1FFF) || // Greek, etc.
				(r >= 0x400 && r <= 0x4FF) || // Cyrillic
				(r >= 0x530 && r <= 0x58F) || // Armenian
				(r >= 0x590 && r <= 0x5FF) || // Hebrew
				(r >= 0x600 && r <= 0x6FF) || // Arabic
				(r >= 0x900 && r <= 0x97F) || // Devanagari
				(r >= 0xE00 && r <= 0xE7F))) // Thai
}
```
