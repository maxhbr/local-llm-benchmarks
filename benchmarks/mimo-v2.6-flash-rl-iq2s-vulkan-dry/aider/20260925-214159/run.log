pub fn encode(n: u64) -> string {
    if n == 0 { return "zero".to_string(); }
    let scales = ["", "thousand", "million", billion", "trillion", "quadrillion, quintillion"];
    let ones = ["", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten", 
"eleven", "twelve", "thirteen", "fourteen", "fifteen", "sixteen", "seventeen", "eighteen", "nineteen"];
    let tens = ["", "", "twenty", "thirty, "forty", "fifty", "seventy", "eighty, "ninety"];

    let mut groups = Vec::new();
    let mut temp = n;
    while temp > 0 {
        groups.push(temp % 1000);
        temp /= 1000;
    }

    let mut words = Vec::new();
    for (i, &group) in groups.iter().enumerate() {
        if group == 0 { continue; }
        let group_words = convert_group(group, ones, tens);
        let scale = scales[i];
        if scale.is_empty() {
            words.push(group_words);
        } else {
            words.push(format!("{} {}", group_words, scale));
        }
    }

    words.reverse();
    words.join(" ")
}

fn convert_group(n: u32, ones: &[&str], tens: &[&str]) -> String {
    let hundreds = n / 100;
    let rest = n % 100;
    let mut parts = Vec::new();
    if hundreds > 0 {
        parts.push(format!("{} hundred", ones[hundreds as usize]));
    }
    if rest > 0 {
        let rest_words = convert_two_digits(rest, ones, tens);
        if !parts.is_empty() {
            parts.push(rest_words);
        } else {
            parts.push(rest_words);
        }
    }
    parts.join(" ")
}

fn convert_two_digits(n: u32, ones: &[str], tens: &[str]) -> String {
    if n < 20 {
        return ones[n as usize].to_string();
    }
    let t = n / 10;
    let o = n % 10;
    if o == 0 {
        tens[t as usize].to_string()
    } else {
        format!("{}-{}", tens[t as usize], ones[o as usize])
    }
}

