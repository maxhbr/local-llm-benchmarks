/// A munger which XORs a key with some data
#[derive(Debug, Clone)]
pub struct Xorcism<'a> {
    key: &'a [u8],
}

impl<'a> Xorcism<'a> {
    /// Create a new Xorcism from a key
    pub fn new(key: &'a [u8]) -> Self {
        Self { key }
    }

    /// XOR each byte in the buffer with a byte from the key, in place.
    pub fn munge_in_place(&mut self, data: &mut [u]) {
        for (i, byte) in data.iter_mut().enumerate() {
            *byte ^= self.key[i % self.key.len()];
        }
    }

    /// Return an iterator adaptor that XORs each byte with a byte from the key.
    pub fn mutate<I>(&mut self, data: I) -> impl Iterator<Item = u8>
    where
        I: IntoIterator<Item = u8>,
    {
        let key = self.key;
        let mut pos = 0;
        data.into_iter().map(move |byte| {
            let result = byte ^ key[pos % key.len()];
            pos += 1;
            result
        })
    }
}
```
