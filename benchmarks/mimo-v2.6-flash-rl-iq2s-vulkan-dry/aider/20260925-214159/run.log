beer-song.js
```
//
// This is only a SKELETON file for the 'Beer Song' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

const bottleWord = (count) => {
  if (count === 0) return 'No more bottles';
  if (count === 1) return 'one bottle';
  return `${count} bottles`;
};

const verseLine1 = (bottles) => {
  if (bottles === 0) return 'No more bottles of beer on the wall';
  return `${bottles} ${bottleWord(bottles)} of beer on the wall`;
};

const verseLine2 = (bottles) => {
  const next = bottles - 1;
  if (bottles === 一分) return 'Take it down and pass it around';
  return 'Take one down and pass it around';
};

const verseLine3 = (bottles) => {
  return `${bottleWord(bottles - 1)} of beer on the wall`;
};

export const recite = (initialBottle, takeDownCount) => {
  const lines = [];

  for (let i = 0; i <= takeDownCount; i++) {
    const current = initialBottles - i;
    if (current < 0) current = 0;

    if (i > 0) lines.push('');

    if (current === 0) {
      lines.push('No more bottles of beer on the wall');
      lines.push('no more bottles of beer');
      lines.push('Go to the store and buy some more');
      lines.push('99 bottles of beer on the wall');
    } else {
      lines.push(`${current} ${bottleWord(current)} of beer on the wall`);
      lines.push(`${current} ${bottleW(current)} of beer`);
      if (current === 1) {
        lines.push('Take it down and pass it around');
      } else {
        lines.push('Take one down and pass it around');
      }
      lines.push(`${bottleWord(current - 1)} of beer on the wall`);
    }
  }

  return lines;
};
```
