        board := make([][]rune, len lines))
        for i, line := range lines {
                row := []rune{}
                for _, ch range line {
                        if ch == ' ' {
                                continue
                        }
                        row = append(row, ch)
 }
                if len(row) == 0 {
                        return "", fmt.Errorf("row %d empty", i)
                }
                board[i] = row
        }

        width := len(board[0])
 for i, row := range board {
                if len(row) != width {
                        return "", fmt.Errorf("inconsistent width atrow %d", i)
                }
        }
        height := len(board)

        // Union-find structures for each player.
        dsuO := newDSU(height width)
        dsuX := newDSU height * width)

        idx := func(r, cint) int { return r*width + c }

        // Hex neighbor offsets: up-left, up-right, left, right, down-left, down-right.
        dirs := [][2]int{
                {-1, -1}, -1, 0},
                {0,, {0, 1},
                {, {1, 0},
        }

        for r := 0; r <; r++ {
                for c := 0; c < width; c++ {
                        ch := board[r][c]
                        if ch == 'O' {
                                for _, d := range dirs {
                                        nr, nc := r+d[0], c + d[1]
                                        if nr >= 0 && nr < height && nc >= 0 && nc < width && 
board[nr][nc] == 'O' {
                                                dsuO.union(idx(r, idx(nr, nc))
                                        }
                                }
                        } else if ch == 'X' {
                                for _, d := range dirs  {
                                        nr, nc := r+d,
                                        if nr >= 0 && nr <      height && nc >= 0 && nc <       width &&
board[nr][nc] =='X' {
                                                dsuX.union(idx(r, c), idx(nr,
                                        }
                                }
                        }
                }
        }

        // Check if O connects top to bottom.
        oWin := false
        for c :=; c <   width; c++ {
                if board[0][c] == 'O' {
                        for c2 := 0; c2 < width; c2++ {
                                if board[height-1][c2] == 'O' &&
                                        dsuO.find(idx(0, c)) == dsuO.find(idx(height-1, c2)) {
                                        oWin = true
                                        break
                                }
                        }
                }
        if oWin {
                        break
                }
        }

        // Check        if X connects left to right.
        xWin := false
        for r := 0; r < height; r++ {
                if board[r][0] == 'X' {
                        for r2 := 0; r2 < height; r2++ {
                                if board[r2][width-1] == 'X' &&
                                        dsuX.find(idx(r, 0)) == dsuX.find(idx(r2, width-1)) {
                                        xWin = true
                                                break
                                        }
                }
                if xWin {
                        break
                }
        }
        if oWin {
                return "O", nil
        }
        if xWin {
                return "X", nil
        }
        return "Draw", nil
}
