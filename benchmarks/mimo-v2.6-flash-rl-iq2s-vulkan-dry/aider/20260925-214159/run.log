   ];
};

export const recite = (initialBottle, takeDownCount) => {
   lines = [];
   for (let i   0; i < takeDown; i++) {
     const current   initialBottlesCount - i;
      (i > 0) lines.push('');
      lines.push(...verse(current));
   }
   return lines;
};
