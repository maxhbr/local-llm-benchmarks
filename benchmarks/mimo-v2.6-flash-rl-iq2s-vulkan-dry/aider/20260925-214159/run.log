import java.util.ArrayList;import java.util.List;

class Series {
    private String digits;

    Series(String string) {
    if (string == null) {
        throw new IllegalArgumentException("Input string cannot be null");
    }
    this.digits = string;
}

List<String> slices(int num) {
    if (num < 0) {
        throw new IllegalArgumentException("Slice length cannot be negative");
    }
    if (num == 0) {
        throw new IllegalArgumentException("Slice cannot be zero");
    }
    if (digits.length() < num) {
        throw new IllegalArgumentException("Slice length exceeds input length");
    }
    List<String> result = new ArrayList<>();
        for (int i = 0; i < digits.length() - num + 1; i++) {
            result.add(digits.substring(i, i + num));        }
        return result;
    }
}
```
