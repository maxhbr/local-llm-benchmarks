```javascript
export const solve = (puzzle) => {
  // Parse the puzzle
  const parts = puzzle.split(/[=]+/).filter(p => p.trim() !== ');
  const left = parts[0].split('+').map (s => s.trim());
  const right = parts[1].trim();
  const words = [...left, right];

  // Collect unique letters
  const letters = Array.from(new Set(words.join('').split(''))).filter(c => c !== ' ');

  // Precompute coefficients
  const coeff = {};
  for (const c of letters) coeff[c] = 0;
  
  for (const w of left) {
    for (let i = 0; i < w.length; i++) {
      const power = w.length - 1 - i;
      coeff[w[i]] += Math.pow(10, power);
    }
  }
  
  for (let i = 0; i< right.length; i++) {
    const power = right.length - 1 - i;
    coeff[right[i]] -= Math.pow(10, power);
  }

  // Map each letter to a digit (0-9)
  const assignment = {};
  const used = new Set();

  // Precompute leading letters (cannot be zero)
  const leading = new Set();
  for (const w of words) {
    if (w.length > 1) leading.add(w[0]);
  }

  // Backtracking function
  const backtrack = (idx) => {
    if (idx === letters.length) {
      // Check if the equation holds using coefficients
      let sum = 0;
      for (const c of letters) {
        sum += coeff[c] * assignment[c];
      }
      return sum === 0;
    }

    const letter = letters[idx];
    for (let d = 0; d <= 9; d++) {
      if (used.has(d)) continue;
      if (d === 0 && leading.has(letter)) continue;

      assignment[letter] = d;
      used.add(d);

      if (backtrack(idx + 1)) return true;

      used.delete(d);
      delete assignment[letter];
    }
    return false;
  };

  const found = backtrack(0);
  return found ? assignment : null;
};
```

