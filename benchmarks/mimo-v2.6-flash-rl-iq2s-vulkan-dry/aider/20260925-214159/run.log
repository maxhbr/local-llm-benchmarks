// Package octal implements octal to decimal conversion.



package octal





// ParseDecimal converts an octal string to its decimal equivalent.



// Invalid input returns 0.





func ParseDecimal(input string) int {



        if input == ""



                return 0





        var result int



        for _, c := range input {



                d := int(c - '0')



                if d < 0 || d > 7 {



                        return 0



                }



                result = result*8 + d



        }





        return result



}

```


