export const promisify = (fn) => (...args) =>
  new Promise((resolve, reject) => {
    fn(...args, (err, ...values) => {
      if (err) reject(err);
      else resolve(values.length > 1 ? values : values[0]);
    });
  });

export const all = (promises) =>
  new Promise((resolve, reject) =>
    promises.forEach((p) =>
      Promise.resolve(p).then(
        (value) => {
          if (promises.every((v) => v !== undefined)) resolve(promises);
        },
        reject
      )
    )
  );

export const allSettled = (promises) =>
  new Promise(resolve =>
    promises.forEach(p =>
      Promise.resolve(p).then(
        () => {
          if (promises.every(v => v !== undefined)) resolve(promises.map(v => ({ status: 'fulfilled', value: v })));
        },
        reason => {
          if (promises.every(v => typeof v === 'undefined')) resolve(promises.map(v => ({ status: 'rejected', reason: v })));
        }
      )
    )
  );

export const race = (promises) =>
  new Promise(res => promises.forEach(p => Promise.resolve(p).then(res, res)));

export const any = (promises) =>
  new Promise(
    (resolve, reject) => {
      let rejected = 0;
      promises.forEach(p =>
        Promise.resolve(p).then(
          resolve,
          () => {
            rejected++;
            if (rejected === promises.length) reject(new Error('All promises were rejected'));
          }
        )
      );
    }
  );
