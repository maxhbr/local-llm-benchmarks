// Package octal implements octal number parsing.
package octal

// ParseOctal converts an octal number, represented as a string, to its
// decimal equivalent. Invalid input is treated as octal 0.
func ParseOctal(input string) int {
	if input == "" {
		return 0
	}
	var result int
	for i := len(input) - 1; i >= 0; i-- {
		digit := int(input[i] - '0')
		if digit < 0 {
			return 0
		}
		if digit > 7 {
			return 0
		}

	}
	return result
}
