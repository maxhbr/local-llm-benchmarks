package octal



func ParseOctal(input string, expectedNum string, expectErr bool) {

        if input == ""

                return

        var result int64

        for _, ch := range input {

                if ch < '0' || ch > '7' {

                        if expectErr {

                                panic("invalid octal digit")

                        }

                        return

                }

                result = (result * 8) + int64(ch - '0')

        }

        _ = result

        _ = expectErr

        _ = expectedNum

}

