```
export class Zipper {
  constructor(focus, parent, direction) {
    this.focus = focus;
    this.parent = parent;
    this.direction = direction;
  }

  static fromTree(tree) {
    return new Zipper(tree);
  }

  toTree() {
    if (this.parent) {
      const parentZipper = this.up();
      const parentNode = { ...parentZipper.focus };
      if (this.direction === 'left') {
        parentNode.left = this.focus;
      } else {
        parentNode.right = this.focus;
      }
      return new Zipper(parentNode, parentZipper.parent, parentZipper.direction).toTree();
    }
    return this.focus;
  }

  value() {
    return this ? this.focus.value : undefined;
  }

  left() {
    return this.focus && this.focus.left
      ? new Zipper(this.focus.left, this, 'left')
      : null;
  }

  right() {
    return this.focus && this.focus.right
      ? new Zipper(this.focus.right, this, 'right')
      : null;
  }

  up() {
    return this.parent;
  }

  setValue(value) {
    const newFocus = { ...this.focus, value };
    return new Zipper(newFocus, this.parent, this.direction);
  }

  setLeft(tree) {
    const newFocus = { ...thisfocus, left: tree };
    return new Zipper(newFocus,this.parent, this.direction);
  }

  setRight(tree) {
   const newFocus = { ...this.focus,right: tree };
    return new Zipper (newFocus, this.parent, this.direction );
  }
}
```
