// Package octalesta provides octal-to-decimal conversion.

package octalesta



// ParseOctal converts an octal number, represented as a string, to its

// decimal equivalent. Invalid input is treated as octal 0.

func ParseOctal(input string) int64 {

        if input == "" {

                return 0

        }

        var result int64

        for _, ch := range input {

                if ch < '0' || ch > '7' {

                        return 0

                }

                result = result*8 + int64(ch-'0')

        }

        return result

}

