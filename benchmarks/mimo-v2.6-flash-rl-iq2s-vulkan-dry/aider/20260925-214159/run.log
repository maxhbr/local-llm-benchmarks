WordProblemSolver.java
```
import java.util.regex.Matcher;
import java.util.regex.Pattern;

class WordProblemSolver {

    private static final Pattern PROBLEM_PATTERN = Pattern.compile(
        "^What is (-?\\d+)(?: ((?:plus|minus|multiplied by|divided by) -?\\d+)+)\\?$");

    int solve(final String wordProblem) {
        if (wordProblem == null) {
            throw new IllegalArgumentException("Invalid problem");
        }
        Matcher matcher = PROBLEM_PATTERN.matcher(wordProblem.trim());
        if (!matcher.matches()) {
            throw new IllegalArgumentException("Invalid problem: " + wordProblem);
        }

        int result = Integer.parseInt(matcher.group(1));
        String operations = matcher.group(2);
        if (operations != null) {
            Pattern opPattern = Pattern.compile(" (plus|minus|multiplied by|divinated by|divided by) (-?\\d+)");
            Matcher opMatcher = Pattern.compile(" (plus|minus|multiduced by|multiplied by|divided by) (-?\\d+)").matcher(operations);
            while (opMatcher.find()) {
                String op = opMatcher.group(1);
                int value = Integer.parseInt(opMatcher.group(2));
                switch (op) {
                    case "plus":
                        result += value;
                        break;
                    case "minus":
                        result -= value;
                        break;
                    case "multiplied by":
                        result *= value;
                        break;
                    case "divided by":
                        if (value == 0) {
                            throw new IllegalArgumentException("Division by zero");
                        }
                        result /= value;
                        break;
                    default:
                        throw new IllegalArgumentException("Unsupported operation: " + op);
                }
            }
        }
        return result;
    }
}
