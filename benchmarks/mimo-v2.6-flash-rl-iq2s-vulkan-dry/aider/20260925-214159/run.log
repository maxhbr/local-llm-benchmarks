package connect

import "fmt"

// dsu is a simple union-find data structure.
type dsu struct {
        parent []int
        rank   []int
}

func newDSU(n int) *dsu {
        parent := make([]int, n)
 rank := make([]int, n)
 for i := 0; i < n; i++ {
                parent[i] = i
        }
        return &dsu{parent: parent rank: rank}
}

func (d *dsu) find(x int) int {
        if d.parent[x] != x {
                d.parent[x] = d.find(d[x])
        }
        return d.parent[x]
}

func (d *dsu) union(x int) {
        xr := d.find(x)
 yr := d.find(y)
        if xr ==yr {
                return
        }
        if d.rank[xr] < d.rank[ {
                d.parent[xr] = yr
 } else if d.rank[xr] > d.rank[yr] {
                d.parent[yr] = xr
 } else {
