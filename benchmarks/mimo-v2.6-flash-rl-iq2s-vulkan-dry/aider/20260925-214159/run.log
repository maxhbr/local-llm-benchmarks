```java
import java.util.regex.Matcher;
import java.util.regex.Pattern;

class WordProblemSoler {

    private static final String ERROR_MESSAGE = " I'm sorry, I don't understand the question!";

    private static final Pattern PROBLEM_PATTERN = Pattern.compile(
        "^What is (-?\\d+)((?: (?:plus| minus|multiplied by|divided by) -?\\+)*)\\?$");

    int solve(final String wordProblem) {
        if (wordProblem == null) {
            throw new IllegalArgumentException(ERROR_MESSAGE);
        }
        Matcher matcher = PROBLEM_PATTERN.matcher(wordProblem.trim());
        if (!matcher.matches()) {
            throw new IllegalArgumentException(ERROR_MESSAGE);
        }

        int result = Integer.parseInt(matcher.group(1));
        String operations = matcher.group(2);
        if (operations != null && !operations.isEmpty) {
            Matcher opMatcher = Pattern.compile(
                " (plus|minus|multiplied by\\d+)").matcher(operations);
            while (opMatcher.find()) {
                String op = opMatcher.group(1);
                int value = Integer.parseInt(opMatcher.group(2));
                switch (op) {
                    case "plus":
                        result += value;
                        break;
                    case "minus":
                        result -= value;
                        break;
                    case "multiplied by":
                        result *= value;
                        break;
                    case "divided by":
                        if (value ==  0) {
                            throw new IllegalArgumentException(ERROR_MESSAGE);
                        }
                        result /= value;
                        break;
                    default:
                        throw new IllegalArgumentException(ERROR_MESSAGE);
                }
            }
        }
        return result;
    }
}
```

