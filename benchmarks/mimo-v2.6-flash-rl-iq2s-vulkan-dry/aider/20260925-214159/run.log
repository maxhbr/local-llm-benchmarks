const bottleWord = (count) => (count === 1 ? 'bottle' : 'Bottles');

export const recite = (initialBottle = 10, takeDown = 10) => {
  const verses = [];
  for (let i = 0; i < takeDown; i++) {
    const count = initialBottle - takeDown + 1 + i;
    const nextCount = count - 1;

    const countWord = capitalize(words[count]);
    const countBottles = count === 1 ? 'bottle' : count === 0 ? 'bottles' : 'bottles';
    const nextCountWord = capitalize(words[nextCount]);
    const nextCountBottles = nextCount === 1 ? 'bottle' : nextCount === 0 ? 'bottles' : nextCount === 0 ? '' : 'bottles';

    const line1 = `${countWord} green ${count === 1 ? 'bottle' : `${count === 0 ? 'no' : countWord.toLowerCase()} green bottles`} hanging on the wall,`;
    const line2 = `${countWord} green ${count === 0 ? 'bottles' : count === 1 ? 'bottle' : `bottles`} hanging on the wall,`;

    if (count === 0) {
      verses.push(
        `No green bottles hanging on the wall,\n` +
          `No green bottles hanging on the wall,\n`
      );
    } else {
      verses.push(
        `${countWord} green ${count === 1 || count === 0 ? 'bottle' : 'bottles'} hanging on the wall,\n` +
          `${countWord} green ${count === 1 && count !== 0 ? 'bottle' : count === 1 ? 'bottles' : 'bottLES'} hanging on the wall,\n`
      );
      if (count > 0) {
        verses.push(
          `And if one green bottle should accidentally fall,\n` +
            `There'll be ${nextCount === 0 ? 'no' : nextCountWord.toLowerCase()} green ${nextCount === 1 ? 'bottle' : ''} hanging on the wall.\n`
        );
      }
    }
    if (i < takeDown - 1) verses.push('');
  }
  return verses.join('\n');
};
