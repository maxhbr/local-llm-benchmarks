BuildTree.java
```
import java.util.*;

class BuildTree {

    TreeNode buildTree(ArrayList<TreeNode> records) throws InvalidRecordsException {
        if (records == null || records.isEmpty()) {
            throw new InvalidRecordsException("Records list is empty");
        }

        Map<Integer, TreeNode> nodeMap = new HashMap<>();
        TreeNode root = null;

        for (TreeNode node : records) {
            if (node == null) {
                throw new InvalidRecordsException("Null record found");
            }
            nodeMap.put(node.id, node);
        }

        for (TreeNode node : records) {
            int parentId = node.parentId;

            if (node.id == parentId) {
                if (root != null) {
                    throw new InvalidRecordsException("Multiple root nodes found");
                }
                root = node;
            } else {
                TreeNode parent = nodeMap.get(parentId);
                if (parent == null) {
                    throw new InvalidRecordsException(
                        "Parent with ID " + parentId + " not found for node " + node.id
                    );
                }
                if (parentId >= node.id) {
                    throw new InvalidRecordsException(
                        node.id + " has parent ID " + parentId + " which is not lower than its own ID"
                    );
                }
                parent.children.add(node);
            }
        }

        if (root == null) {
            throw new InvalidRecordsException("No root node found");
        }

        return root;
    }
}
```
