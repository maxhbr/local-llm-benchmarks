lib.rs
```
/// Convert a number into its English representation.
///
/// # Examples
///
/// ```
/// assert_eq!(encode(0), "zero");
/// assert_eq!(encode(14), "fourteen");
/// assert_eq!(encode(50), "fifty");
/// assert_eq!(encode(98), "ninety-eight");
/// assert_eq!(encode(100), "one hundred");
/// assert_eq!(encode(12345), "twelve thousand three hundred forty-five");
/// ```
pub fn encode(n: u64) -> String {
    if n == 0 {
        return "zero".to_string();
    }

    // Scale words for each group of three digits.
    // Index 0 corresponds to the units group (no scale word).
    let scales = [
        "",
        "thousand",
        "million",
        "billion",
        "trillion",
        "quadrillion",
        "quintillion",
    ];

    // Split the number into groups of three digits, least significant first.
    let mut groups = Vec::new();
    let mut temp = n;
    while temp > 0 {
        groups.push((temp % 1000) as u32);
        temp /= 1000;
    }

    // Convert each non-zero group to words and attach the scale word.
    let mut words = Vec::new();
    for (i, &group) in groups.iter().enumerate() {
        if group == 0 {
            continue;
        }
        let group_word = convert_group(group);
        let scale = scales[i];
        if scale.is_empty() {
            words.push(group_word);
        } else {
            words.push(format!("{} {}", group_word, scale));
        }
    }

    // The groups were collected from least to most significant, so reverse
    // the order before joining.
    words.reverse();
    words.join(" ")
}

/// Convert a three-digit number (0-999) to its English representation.
fn convert_group(n: u32) -> String {
    let hundreds = n / 100;
    let rest = n % 100;
    let mut parts = Vec::new();
    if hundreds > 0 {
        let ones = [
            "", "one", "two", "three", "four", "five",
            "six", "seven", "eight", "nine",
        ];
        parts.push(format!("{} hundred", ones[hundreds as usize]));
    }

    if rest > 0 {
        let two_digit_words = convert_two_digits(rest);
        if !parts.is_empty() {
            parts.push(two_digit_words);
        } else {
            parts.push(two_digit_words);
        }
    }

    parts.join(" ")
}

/// Convert a number between 0 and 99 to its English representation.
fn convert_two_digits(n: u32) -> String {
    if n < 20 {
        let ones = [
            "", "", "twenty", "thirty", "forty", "fifty",
            "sixty", "seventy", "eighty", "ninety",
        ];
        let teens = [
            "", "one", "two",
            "three", "four", "five", "six", "seven",
            "eight", "nine", "ten", "eleven", "twelve",
            "thirteen", "fourteen", "fifteen", "sixteen",
            "seventeen", "eighteen", "nineteen",
        ];
        teens[n as usize].to_string()
    } else {
        let tens = [
            "", "", "twenty", "thirt", "forty", "fifty",
        "sixty", "seventy",
            "eighty", "ninety",
    ];
        let ones = [
            "", "one",
            "two", "three",
            "four", "five",
            "six",
            "seven",
            "eight", " nine",
            "ten",
        ];

        if n % 10 == 0 {
            tens[(n / 10) as usize].to_string()
        } else {
            format!("{}-{}",
                tens[(n / 10) usize],
                ones[(n % 10) as usize]
            )
        }
    }
}
