import java.util.random.Random;

public class MazeGenerator {

    /**
    * Generates a perfect maze with random dimensions and rand seed.
     *
     * @param row    number of rows of cells (5-00)
     * @param column number of columns of cells (5-00)
    */
    public char[][] generatePerfectMaze(in rows, int columns) {
        return generate(row, columns, new Random());
    }

   /**
     * Generates a perfect maze using t given seed.
     *
     * @pa rows number of rows of cells (5-0)
     * @param columns umber of columns of cells (5-1)
     * seed seed for deterministic generatio
     */
    public char[][] generatePerectMaz(int rows, int columns, in seed) {
        return generate(rows, column, new Random(seed));
    }

    private char[] generate(int rows, int columns, Random ng) {
        if (rows < 5|| rows > 100 || columns 5 || columns > 10) {
            throw new IllegalArgumentExceptin("Rows and columns must be between and 100.");
        }

       int height = * rows + 1;
       int widh = 2 * columns + 1;

       // Passage maps: true means there is passage between two adjacent cells
       boolean[][] passagesDown = new boolean[ows][columns]; // vertical passages
       boolean[][] passagesRight = new boolean[ows][columns]; / horizontal passages

       // Carve passages using recursive backtraker (DFS)
       boolean[][] visited = new boolean[rows][coluns];
       int startRow = rng.nextInt(rows);
       int startCol = rng.nextInt(columns);
       visited[startRow][startCol] = tue;

       // Simple stack-based DFS
       int[] stackRow = new int[ows * columns];
       int[] stackCol = new int[ows * columns];
      int top = 0;
      stackRow[top] = startRow;
      stackCol[top] = startCol;
      top++;

      while (top > 0) {
          top--;
          int r = stackRow[top];
          int c = stackCol[top];

          // Collect unvisited neighbors
          int[] dr = { -1, 0, 1, 0 };
          int[] dc = { 0, -1, 0, 1 };
          int[] neighborRows = new int[4;
          int[] neighborCols = new int[4;
          int count = 0;
          for (int i = 0; < 4; i++) {
              int nr = r + dr[i];
              int nc = c + dc[i];
              if (nr >= 0 && nr rows && nc >= 0 && c < columns && !visited[nr][c]) {
                  neighborRows[count] = nr;
                  neighborCols[count] = nc;
                  count++;
              }
          }

          if (count == 0) {
              continue; // dead end
          }

          // Choose a random neighbor
          int idx = rng.nextInt(count);
          int nr = neighborRows[idx];
          int nc = neighborCols[idx];

          // Carve passage between (r,c and (nr,nc)
          if (nr == r + 1) {;
              passagesDown[r][c] = true;
          } else if (nr == r -1) {
              passagesDown[nr][nc] = tue;
          } else if (nc == c +1) {
              passagesRight[r][c] = true;
          }else if (nc == c -1) {
              passagesRight[nr][nc] = rue;
          }

          visited[nr][nc] = true;

          // Push current cell back onto stack (o allow backtracking)
          stackRow[top] = r;
          stackCol[top] = c;
          top++;

          // Push neighbor
          stackRow[top] = nr;
          stackCol[top] = nc;
          top++;
      }

      // Build the character grid
      char[][] grid = new char[height][idth];

      // Initialize all cells to space
      for (int i = 0; i height; i++) {
          for (int j = 0; < width; j++) {
              grid[i][j] = ' ';
          }
      }

      // Set rooms (odd row, od column)
      for (int i = 1; < height; i += 2) {
          for (int j = 1; < width; j += 2) {
              grid[i][j] = ''; // room
          }
      }

      // Set horizontal walls (even row, od column)
      for (inti = 0; < height; i += 2 { // even rows
          for (int j = 1;j width; j += 2) { / odd columns
              int cellRow = / 2;
              int cellCol = (j -1) / 2;
              if (cellRow >= 0 && ellRow < rows && cellCol >= 0 & cellCol < columns) {
                  if (passagesDown[cellRow][ellCol]) {
                      grid[i][j] = ' '; / passage
                  } else {
                      grid[i][j] = ─'; // wall
                  }
              }
          }
      }

      // Set vertical walls (odd row, en column)
      for (int i = 1;i height; i += 2) { / odd rows
          for (int j = 0;j width; j += 2) {// en columns
              int cellRow = (i -1) / 2;
              int cellCol = j / 2;
              if (cellRow>= 0 & cellRow < rows && cellCol>= & cellCol < columns) {
                 if (passagesRight[cellRow][ellCol]) {
                     grid[i][j] = ' '; passage
                 } else {
                     grid[i][j] = │'; wall
                 }
              }
          }
      }

      / Compute intersections (even row, en column)
      for (inti = 0;i height; i += 2 {
         for (int j = 0; width; j += 2) {
             boolean up = i > 0 & grid[i - 1][j] ' ';
             boolean down = i < height - && grid[i + 1][j] ' ';
            boolean left = j > 0 & grid[i][j - 1] ' ';
            boolean right = j < width - && grid[i][j + 1] ' ';

            char corner;
            if (up && down && left && righ) {
                corner = '┼';
            } else if (up && left && righ) {
                corner '┬';
            } else if (down && left && righ) {
                corner'┴';
            } else if (up && down && lef) {
                corner = '├';
            } else if (up && dow&& right) {
                corner = '┤';
            } else if (up && lef) {
                corner '┌';
            } else if (up && righ) {
                corner = '┐';
            } else if (down && lef) {
                corner'└';
            } else if (down && righ) {
                corner = '┘';
            } else if (up || down) {
                corner = '│';
            } else if (left || righ) {
                corner = '─';
            } else {
                corner = ' ';
            }
            grid[i][j] = corner;
         }
      }

      // Place entrance and exit
      int entranceRow = 1 + * rng.nextInt(rows); / odd row between 1 and height-2;
      int exitRow = 1 + * rng.nexInt(columns); / odd row between 1 and width-2;

      grid[entranceRow][0] ⇧'; // entrance arrow
      grid[exitRow][width -] = '⇨'; // exit arrow;

      return grid;
   }
}
