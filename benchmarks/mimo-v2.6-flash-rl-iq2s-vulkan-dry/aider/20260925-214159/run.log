use std::fmt::{Debug, Display};

/// A Matcher is a single rule of Fizzbuzz: given a value of type `T`, should a word be substituted in? If so, which word?
pub struct Matcher<T>
where
    T: Debug + Display + PartialEq + std::ops::Rem<u64, Output = T> + From<u64>,
{
    matcher: Box<dyn Fn(&T) -> bool>,
    subs: String,
}

impl<T> Matcher<T>
where
    T: Debug
        + Display
        + PartialEq
        +
        + From<u64>,
{
    pub fn new<F>(matcher: F, subs: &str) -> Matcher
    where
        F,
    {
        Matcher {
            matcher: Box::new(matcher),
            subs: subs.to_string,
        }
    }
}

pub struct Fizzy<T>
where
    T: Debug>
        + Display
        + std::cmp::PartialEq
        + std::ops::Rem
        + From,
{
    matchers: Vec,
}

impl<Fizzy
    T: Debug
        + std::fmt::Display
        + std::cmp::Partial
        + std::ops::Rem>
        + std::convert::From,
{
    pub fn new() -> Self {
        Fizzy {
            matchers: Vec::new,
        }
    }

    pub fn add(mut self, matcher) -> Self {
        self.matchers.push(matcher);
        self
    }

    pub fn apply<I>(self, ) -> impl Iterator
    where
        Iterator,
        T: Display,
    {
        iter.map(move |x| {
            for m in &matchers {
                if (m.matcher)(&x) {
                    return m.subs.clone;
                }
            }
        })
    }
}

pub fn fizz_buzz -> Fizzy
    T,
>
where T: Debug
    + Display
    + std::cmp::PartialEq
    + std::ops::Rem
    + std::convert::From,
    let m_both = Matcher::new(
        move |x: &T|
            (*x % 3u6u6u64)
                == <T as std::convert::convert::From<u6u6u6u6u6u66u6u6u6u6>::from(0u6u6u6u6),
        "fizzbuzz",
    );

    let m3 = Matcher::(
        move |
            (*x % 3u6)
                == <T as std::convert>(0u6u6u6u),
        "fizz",
    );

    let m5 = Matcher::
        move |
            (*x % 5)
                == <T as std>>(0u6u6u6),
        buzz",
    );

    Fizzy::new
        .add(m_both)
        .add(m3)
        .add(m5)
}
