// dsu is a simple union-find datastructure.
type dsu struct {
        parent []int
        rank   []int
}

func newDSU(n int) *ds {
        parent := make([]int, n)
 rank := make([]int, n)
 for i := 0; i < n; i++
                parent[i] = i
        }
        return &dsu{parent: parent rank: rank}
}

func (d *dsu) find(xint) int {
