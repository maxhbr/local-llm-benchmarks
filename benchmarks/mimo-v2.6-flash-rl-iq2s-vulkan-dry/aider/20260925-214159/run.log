forth.js
```
//
// Forth evaluator implementation
//

export class Forth {
    constructor () {
        this.stack = [];
        this.words  = {};
    }

    evaluate (input) {
        if (typeof input !== 'string') throw new Error('Input must be a string');

        const tokens = input.trim().split (/\s+/);
        let   i      = 0;
        let   inDef  = false;
        let   defTok = [];
        let   wName  = '';

        while (i < tokens.length ) {
            const token = tokens[i];

            // start of a definition
            if (!inDef && token === ':') {
                i += 1;
                if (i >= tokens.length ) throw new Error('Missing word name after ":"' );
                wName  = tokens[i].toLowerCase ();
                i += 1;
                defTok = [];
                inDef  = true;
                continue;
            }

            // end of a definition
            if (inDef && token === ';') {
                if (defTok.length === 0) throw new Error('Empty definition for word : ' + wName);
                this.words[wName] = defTok;
                inDef = false;
                i += 1;
                continue;
            }

            // inside a definition – collect tokens
            if (inDef) {
                defTok.push (token.toLowerCase ());
                i += 1;
                continue;
             }

            // normal execution
            this._executeToken (token);
            i += 1;
        }

        if (inDef) throw new Error('Missing ";" at end of definition');
    }

    _executeToken (token) {
        const lower = token.toLowerCase ();

        // number?
        if (/^\d+$/.test (token)) {
            this.stack.push (parseInt (token, 10));
            return;
        }

        switch (lower ) {
            case '+'   : this._add  (); break;
            case '-'   : this._sub  (); break;
            case '*'   : this._mul  (); break;
            case '/'   : this._div  (); break;
            case 'dup' : this._dup  (); break;
            case 'drop': this._drop (); break;
            case 'swap': this._swap (); break;
            case 'over': this._over (); break;
            default:
                if (Object.prototype.hasOwnProperty.call (this.words, lower)) {
                    for (const t of this.words[lower]) this._executeToken (t);
                } else {
                    throw new Error('Unknown word : ' + token);
                }
        }
    }

    _add () {
        if (this.stack.length  < 2) throw new Error('stack underflow');
        const b = this.stack.pop ();
        const a = this.stack.pop ();
        this.stack.push (a + b);
    }

    _sub () {
        if (this.stack.length   < 2) throw new Error('stack  underflow');
        const b = this .stack.pop ();
        const a = this .stack.pop ();
        this .stack.push (a - b);
    }

    _mul () {
        if (this .stack.length  < 2) throw new  Error('stack  underflow');
        const  b = this .stack.pop ();
        const  a = this .stack.pop ();
        this  .stack.push (a * b);
    }

    _div () {
        if (this .stack .length  < 2) throw  new Error('stack  underflow');
        const   b = this .stack .pop ();
        const   a = this .stack .pop ();
        if (b === 0) throw new Error('division by zero');
        this   .stack .push (Math.trunc (a / b));
    }

    _dup () {
        if (this .stack . length === 0) throw  new Error('stack underflow');
        const top = this .stack [this .stack .length - 1];
        this .stack .push (top);
    }

    _drop () {
        if (this .stack .  length === 0) throw   new Error('stack underflow');
        this .stack .pop ();
    }

    _swap () {
        if (this .stack .   length < 2) throw    new Error('stack underflow');
        const a = this .stack .pop ();
        const b = this .stack .pop ();
        this .stack .push (a);
        this .stack .push (b);
    }

    _over () {
        if (this .stack .    length < 2) throw     new Error('stack underflow');
        const second = this .stack [this .stack . length - 2];
        this .stack .push (second);
    }

    get stack () {
        return this .stack;
    }
}
