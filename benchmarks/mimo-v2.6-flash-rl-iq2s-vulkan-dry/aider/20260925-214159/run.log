                    case "minus":
                        result -= value;
                        break;
                    case "multiplied by":
                        result *= value;
                        break;
                    case "divided by":
                        if (value == 0) {
                            throw new IllegalArgumentException(ERROR_MESSAGE);
                        }
                        result /= value;
                        break;
                    default:
                        throw new IllegalArgumentException(ERROR_MESSAGE);
                }
            }
        }
        return result;
    }
}
