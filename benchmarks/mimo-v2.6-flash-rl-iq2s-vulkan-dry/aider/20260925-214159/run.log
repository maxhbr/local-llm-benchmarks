package connect

import "fmt"


type struct {
        parent []int
        rank   []int
}

func newDSU(n int) *{
        parent := make([]int, n)
        rank := make([]int, n)
        for i := 0; i < n; i++ {
                parent[i] = i
        }
        return &{parent: parent, rank: rank}
}

func (d *) find(x int) int {
        if d.parent[x] != x {
                d.parent[x] = d.find(d.parent[x])
        }
        return d.parent[x]
}

