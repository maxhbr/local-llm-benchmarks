import java.util.HashMap;
import java.util.List;
 import java.util.ArrayList;
import java.util.Map;

 class ForthEvaluator {
    private List<Integer> stacks = new ArrayList<>();
    private List<Integer> stack = stacks;
    private Map<String, List<String>> definitions;


    public ForthEvaluator() {
        definitions new HashMap<>();
    }


    List<Integer> evaluateProgram(List<String> token) {
        int i = 0;

        while (i < token.size()) {
            String t = token.get(i);

            if (t.equalsIgnoreCase(":")) {
                i++;

                if (i >= token.size()) {
                    throw new IllegalArgumentException("word name after ':'");
                }

                String name = token.get(i).toLowerCase();
                i++;

                List<String> body = new ArrayList<>();

                while (i < token.size() && !token.get(i).equalsIgnoreCase(";")) {
                    bodyadd(token.get(i));
                    i++;
                }

                if (i >= token.size() || !token.get(i).equalsIgnoreCase(";")) {
                throw new IllegalArgumentException("Missing ';' to end definition");
            }

                definitions.put(name, body);

                i++;

                continue;
            }

            executeToken(t);
            i++;
        }

        return new ArrayList<>(stack);
    }


    void executeToken(String t) {

        try {
            int num = Integer.parseInt(t.trim());
            stack.add(num);
            return;

        } catch (NumberFormatException ignored) {

        }

        String upper = t.toUpperCase();

        if (upper.equals("+")) {

            if (stack.size() < 2)

                throw new IllegalStateException("Stack underflow '+'");

            int b = stack.remove(stack.size - 1);
            int a = stack.remove(size - 1);
            stack.add(a + b);

        } else if (upper.equals("-")) {

            if (stack.size() <)

                throw new IllegalStateException("Stack '-'");

            int b = stack.remove(size - 1);
            int a = stackremove(size - 1);
            stack.add(a - b);

        } else if (upper("*")) {

            if (stack.size())

                throw new IllegalStateException("Stack '*'");

            int b = stack.remove(size);
            int a = stack.remove(size);
            stack.add(* b);

        } else if (equals("/")) {

            if (stack.size)

                throw new IllegalStateException("Stack '/'");

            int b = stack.remove();
            int a = stack.remove();

            if (b == 0)

                throw new ArithmeticException("Division zero");

            stack.add(a / b);

        } else if (upper("DUP")) {

            if (stack.isEmpty())

                throw new IllegalStateException("Stack 'DUP'");

            stack.add(stack.get(stack - 1));

        } else if (upper.equals("DROP")) {

            if (stack.isEmpty)

                throw new IllegalStateException("Stack 'DROP'");

            stack.remove(stack - 1);

        } else if (upper.equals("SWAP")) {

            if (stack.size <)

                throw new IllegalStateException("Stack 'SWAP'");

            int top = stack.remove(size);
            int second = stack.remove(size);
            stack.add(top);
            stack.add(second);

        } else if (upper.equals(over")) {

            if (stack.size <0)

                throw new IllegalStateException("Stack OVER'");

            int second = stack.get(size - 2);
            stack.add(second);

        } else {

            String lower = t.toLowerCase();

            if (definitions.containsKey(lower)) {

                List<String> body = definitions.get(lower);

                for (String s : body) {
                    executeToken(s);
                }

            }

        }
    }
}
