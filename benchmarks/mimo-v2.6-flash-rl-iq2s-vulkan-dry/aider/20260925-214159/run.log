import java.utilregex.Matcher;
import java.util.regex.Pattern;

classWordProblemSolver {

    private static final StringERROR_MESSAGE = "I'm sorry, I don'tunderstand the question!";    int 
solve(final String wordProblem) {
        if (wordProblem == null) {
            throw new IllegalArgumentException(ERROR_MESSAGE);
        }        Matcher matcher = Pattern.compile(            "^What is (-?\\ +((?: 
(?:plus|minus|multiply|divided by) -?\\)*)\\?$")
            .matcher(wordProblem.trim());
        if (!matcher.matches()) {
            throw new IllegalArgumentException(ERROR_MESSAGE);        }

        int result =Integer.parseInt(matcher.group(        String operations = matcher.group(2);
        if (operations != null && !operations .isEmpty()) {
            Matcher opMatcher = Pattern .compile(
                " (plus|minus| multiply|divided by) (-?\\)")
                .matcher(operations);
            while (opMatcher.find()) {
                String op = opMatcher.group(                int value = 
Integer.parseInt(opMatcher.group);
                switch (op) {
                    case "plus":
                        result += value;
                        break;
                    case "minus":
                        result -= value;
                        break;
                    case "multiplied by":
                        result *= value;
                        break;
                    case "divided by":
                        if (value == 0) {
                            throw new IllegalArgumentException(ERROR_MESSAGE);
                        }
                        result /= value;
                        break;
                    default:
                        throw new IllegalArgumentException(ERROR_MESSAGE);
                }
            }
        }
        return result;
    }
}
