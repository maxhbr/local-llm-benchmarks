alphametics.js
```
export const solve = (puzzle) => {
  // Parse the puzzle into words and the result
  const parts = puzzle.split('=');
  const left = parts[0].split('+').map(s => s.trim());
  const right = parts[1].trim();
  const words = [...left, right];

  // Collect unique letters
  const letters = Array.from(new Set(words.join('').split(''))).filter(c => c !== ' ');

  // Map each letter to a digit (0-9)
  const assignment = {};
  const used = new Set();

  // Precompute leading letters (cannot be zero)
  const leading = new Set();
  for (const w of words) {
    if (w.length > 1) leading.add(w[0]);
  }

  // Helper to convert a word to a number using current assignment
  const wordToNum = (w) => {
    let num = 0;
    for (const c of w) {
      num = num * 10 + assignment[c];
    }
    return num;
  };

  // Backtracking function
  const backtrack = (idx) => {
    if (idx === letters.length) {
      // Check if the equation holds
      const sum = left.reduce((acc, w) => acc + wordToNum(w), 0);
      const res = wordToNum(right);
      return sum === res;
    }

    const letter = letters[idx];
    for (let d = 0; d <= 9; d++) {
      if (used.has(d)) continue;
      if (d === 0 && leading.has(letter)) continue;

      assignment[letter] = d;
      used.add(d);

      // Pruning: if we can already determine that the equation cannot hold
      // (optional, but we can do a quick check when all letters are assigned)
      if (backtrack(idx + 1)) return true;

      used.delete(d);
      delete assignment[letter];
    }
    return false;
  };

  // Start backtracking
  const found = backtrack(0);
  return found ? assignment : null;
};
```
