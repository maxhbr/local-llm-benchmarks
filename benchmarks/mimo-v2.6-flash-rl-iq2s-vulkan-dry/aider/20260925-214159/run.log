class BottleSong {
    String recite(int startBottles, int takeDown) {
        if (startBottles <= 0) {
            return "";
        }
        StringBuilder sb = new StringBuilder();
        for (int i = startBottles + 1; i > startBottles - takeDown; i--) {
            sb.append(bottlePhrase(i, true)).append(" hanging on the wall,\n");
            sb.append(bottlePhrase(i, false)).append(" hanging on the wall,\n");
        }
        return sb.toString();
    }

    private String bottlePhrase(int n, boolean capitalized) {
        String phrase;
        if (n <= 0) {
            phrase = "no green bottles";
        } else if (n == 1 && capitalized) {
            phrase = "One green bottle";
        } else {
            phrase = numberToWord(n) + " green bottles";
        }
        return phrase;
    }

    private String numberToWord(int n) {
        switch (n) {
            case 1: return "one";
            case 2: return "two";
            case 3: return "three";
            case 4: return "four";
            case 5: return "five";
            case 6: return "six";
            case 7: return "seven";
            case 8: return "eight";
            case 9: return "nine";
            case 10: return "ten";
            default: return String.valueOf(n);
        }
    }
}
```
