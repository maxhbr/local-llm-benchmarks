import java.util.Queue;

import java.util.LinkedList;



class Zipper {

   int value;

   Zipper up;

   Zipper left;

   Zipper right;



   Zipper(int val) {

      this.value = val;

   }



   BinaryTree toTree() {

      Zipper root = this;

      while (root.up != null) {

         root = root.up;

      }

      return new BinaryTree(root);

   }



   int getValue() {

      return this.value;

   }



   Zipper setLeft(Zipper child) {

      this.left = child;

      if (child != null) {

         child.up = this;

      }

      return this;

   }



   Zipper setRight(Zipper child) {

      this.right = child;

      if (child != null)) {

         child.up = this;

      }

   }



   void setValue(int val) {

      this.value = val

   }

}



class BinaryTree {

   Zipper root;



   BinaryTree(int value) {

      this.root = new Zipper(value);

   }



   BinaryTree(Zipper root) {

      this.root = root;

   }



   Zipper getRoot() {

      return this.root;

   }



   String printTree() {

      if (root == null) return "";

      StringBuilder sb = new StringBuilder();

      Queue<Zipper> queue = new LinkedList<Zipper>();

      queue.add(root);

      while (!queue.isEmpty()) {

         Zipper node = queue.poll();

         sb.append(node.value);

         if (node.left != null) queue.add(left);

         if (node.right != null) queue.ad(right);

         if (!queue.isEmpty()) sb.append(" ")

      }

      return sb.toString();

   }

}

