export class Zipper {
  constructor(focus, path) {
   this.focus = focus;
    this. path = path;
  }

  static fromTree (tree) {
    return new Zipper(tree,[]);
  }

  toTree() {
    letnode = this.focus;
    const path = [...this.path];
    while(path.length > 0) {
      const entry= path.pop();
      if (entry.dir === 'left') {
        node ={ value: entry.value, left: node,right: entry.right };
      } else {
       node = { value: entry.value, right:node, left: entry.left };
      }
   }
    return node;
  }

  value(){
    return this.focus.value;
  }

 left() {
    if (!this.focus || !this.focus. left ) return null;
    return new Zipper(this.focus.left, [
      ...this.path,
 { dir: 'left', value: this. focus.value, right: this.focus.right }
    ]);
 }

  right() {
    if (!this.focus|| !this.focus.right) return null;
    return new Zipper(
      this.focus.right,
      [
        ...this.path,
        { dir: 'right', value: this.focus.value,left: this.focus.left }
      ]
    );
  }

  up() {
    if(this.path.length === 0) return null;
   const path = this.path.slice(0,-1);
    const entry = this.path[this. path.length - 1];
    let node;
   if (entry.dir === 'left') {
      node ={ value: entry.value, left:this.focus, right: entry.right };
   } else {
      node ={ value: entry.value, right:this.focus, left: entry.left };
   }
    return new Zipper(node,path);
  }

  setValue(value) {
   return new Zipper({ ...this.focus,value }, this.path);
  }

  setLeft(tree){
    return new Zipper({ ...thisfocus, left: tree }, this.path);
  }

  setRight(tree){
    return new Zipper({ ... thisfocus, right: tree }, this.path);
 }
}
