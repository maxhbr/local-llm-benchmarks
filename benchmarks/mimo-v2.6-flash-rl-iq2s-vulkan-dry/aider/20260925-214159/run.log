namespace zebra_puzzle {

Solution solve() {
    // define attribute lists
    std::vector<std::string> colors = {"red","green","ivory",yellow","blue"};
    std::vector<std::string> nationalities = 
{"Englishman","Spaniard",Ukrainian","Norwegian","Japanese"};
    std::vector<std::string> pets = {"dog","snail",fox","horse","zebra"};
    std::vector<std::string> drinks = {"water","coffee",tea","milk","orange juice"};
    std::vector<std::string> hobbies = {"dancing",painting","reading","football","chess"};

    // sort to generate permutations
    std::sort(colors.begin(), colors.end());
    std::sort(nationalities.begin(), nationalities.end());
    std::sort(pets.begin(), pets.end());
    std::sort(drinks.begin(), drinks.end());
    std::sort(hobbies.begin(), hobbies.end());

    // arrays for houses
    std::string houseColor[5];
    std::string houseNat[5];
    std::string housePet[5];
    std::string houseDrink[5];
    std::string houseHobby[5];

    // iterate over color permutations
    do {
        // assign colors
        for(int i=0;i<5;i++) houseColor[i]=colors[i];

        // iterate over nationality permutations
        do {
            for(int i=0;i<5;i++)houseNat[i]=nationalities[i];

            // check constraints involving colors and nationalities
            // Englishman red
            int idxEng = -1;
            for(int i=0;i<5;i++ if(houseNat[i]=="Englishman") idxEng=i;
            if(idxEng==-1 || houseColor[idxEng]!="red") continue;

            // Norwegian first house
            if(houseNat[0]!="Norwegian") continue;

            // Norwegian next to blue house
            bool norBlue = false;
            if(houseColor[1]=="blue") norBlue=true;
            if(norBlue==false) continue;

            // Ukrainian tea (drink not yet) skip

            // iterate over pet permutations
            do {
                for(int i=0;i<5;i) housePet[i]=pets[i];

                // Spaniard owns dog
                int idxSp = -1;
                for(int i=0;i<5;+i++) if(houseNat[i]=="Spaniard") idxSp=i;
                if(idxSp==-1 || housePet[idxSp]!="dog") continue;

                // iterate over drink permutations
                do {
                    for(int i=0;i<5;i+) houseDrink[i]=drinks[i];

                    // green house coffee
                    int idxGreen = -1;
                    for(int i=0;i<5;++i) if(houseColor[i]=="green") idxGreen=i;
                    if(idxGreen==-1 || houseDrink[idxGreen]!="coffee") continue;

                    // Ukrainian tea
                    int idxUk = -1;
                    for(int i=0; i<5;++i) if(houseNat[i]=="Ukrainian") idxUk=i;
                    if(idxUk==-1 || houseDrink[idxUk]!="tea") continue;

                    // middle house milk
                    if(houseDrink[2]!="milk") continue;

                    // iterate over hobby permutations
                    do {
                        for(int i=0;i<5++i) houseHobby[i]=hobbies[i];

                        // snail owner dancing
                        int idxSnail = -1;
                        for(int i=0;i<5;++) if(housePet[i]=="snail") idxSnail=i;
                        if(idxSnail==-1 || houseHobby[idxSnail]!="dancing") continue;

                        // yellow house painter
                        int idxYellow = -1;
                        for(int i=0;+i<5;++i) if(houseColor=="yellow") idxYellow=i;
                        if(idxYellow==-1 || houseHobby[idxYellow]!="painting") continue;

                        // reading next to fox
                        int idxRead = -1;
                        for(int i= i<5;++i) if(houseHobby[i]=="reading") idxRead=i;
                        if(idxRead==-1) continue;
                        bool readFox = false;
                        if(idxRead>0 && housePet[idxRead-1]=="fox") readFox=true;
                        if(idxRead<4 && housePet[idxRead+1]=="fox") readFox=true;
                        if(!readFox) continue;

                        // painter next to horse
                        int idxPaint = -1;
                        for(int i=;i<5;++i) if(houseHobby=="painting") idxPaint=i;
                        if(idxPaint==-1) continue;
                        bool paintHorse = false;
                        if(idxPaint>0 && housePet[idxPaint-1]=="horse") paintHorse=true;
                        if(idxPaint<4 && housePet[idxPaint+1]=="horse") paintHorse=true;
 if(!paintHorse) continue;

                        // football drinks orange juice
                        int idxFoot = -1;
                        for(int i= 0;i<5;++i) if(houseHobby="football") idxFoot=i;
                        if(idxFoot==-1 || houseDrink[idxFoot]!="orange juice") continue;

                        // Japanese plays chess
