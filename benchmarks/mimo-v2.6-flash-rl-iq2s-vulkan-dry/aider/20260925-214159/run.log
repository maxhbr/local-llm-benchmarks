@@ -1,5 +1,30 @@
 #include "sublist.h"
 
 namespace sublist {
 
+static bool contains(const std::vector<int>& big,
+                     const std::vector<int>& small) {
+    if (small.empty()) return true;
+    if (big.size() < small.size()) return false;
+    for (size_t i = 0; i + small.size() <= big.size(); ++i) {
+        bool match = true;
+        for (size_t j = 0; j < small.size(); ++j) {
+            if (big[i + j] != small[j]) {
+                match = false;
+                break;
+            }
+        }
+        if (match) return true;
+    }
+    return false;
+}
+
+List_comparison sublist(const std::vector<int>& a,  // list A
+                        const std::vector<int>& b) { // list B
+    if (a == b) return List_comparison::equal;
+    if (contains(a, b)) return List_comparison::superlist;
+    if (contains(b, a)) return List_comparison::sublist;
+    return List_comparison::unequal;
+}
+
 }  // namespace sublist
```


