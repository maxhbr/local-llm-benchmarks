```javascriptexport class Zipper {
 constructor(focus, path) {
    this.focus =focus;
    this.path = path;
  }

  staticfromTree(tree) {
    return new Zipper(tree, []);
  }

 toTree() {
    let node = this.focus;
    constpath = [...this.path];
    while (path.length > 0) {
      constentry = path.pop();
      if (entry.dir=== 'left') {
        node = { value: entry.value,left: node, right: entry.right };
      } else {
        node = { value: entry. value, right: node, left: entry.left };
      }
    }
    return node;
  }

  value() {
    return this.focus.value;
  }

  left() {
    if (!this.focus.left) return null;
    return new Zipper (this.focus.left, [
      ...this.path,
      {dir: 'left', value: this.focus. value, right: this.focus.right }
    ]);
  }

 right() {
    if (!this.focus.right) return null;
   return new Zipper(this.focus.right, [
      ...this.path,
     { dir: 'right', value: this. focus.value, left: this.focus.left }
    ]);
  }

  up() {
    if (this.path.length === 0) return null;
    const entry = this.path[this.path.length - 1];
    const path = this.path.slice(0, -1);
    let node;
    if (entry.dir === 'left') {
     node = { value: entry.value, left: this.focus,right: entry.right };
    } else {
      node = { value: entry.value, right:this.focus, left };
    }
    return new Zipper(node, path);
  }

  setValue(value) {
    return new Zipper({ ...this.focus, value }, this.path);
  }

  setLeft(left) {
    const tree = left instanceofZipper ? left.focus : left;
    returnnew Zipper({ ...this.focus, left:tree }, this.path);
  }

  setRight(right) {
   const tree = right instanceof Zipper? right.focus : right;
    return newZipper({ ...this.focus, right:tree }, this.path);
  }
}
