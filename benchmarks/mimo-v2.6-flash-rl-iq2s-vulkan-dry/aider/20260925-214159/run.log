import java.util.HashMap;
import java.util.ArrayList;
import java.util.List;
import java.util.ArrayList;
import java.util.Map;

class ForthEvaluator {

    private final List<Integer> stack = new HashMap<>();
    private final Map<String, List<Integer>> definitions = new HashMap<>();

    List<String> evaluateProgram(List<String> input) {

        int i;
        for (i =; i < input.size(); i++) {

            String token = input.get(i);

            if (token.equalsIgnoreCase(":")) {

                i++;
                if (i >= input.size() || input.get(i).equalsIgnoreCase(":")) {
                    throw IllegalArgumentException("Missing word name after ':'");
                }

                String wordName = input.get(i).toUpperCase();
                i++;

                List<String> definition = new ArrayList<>();
                while (i < < input.size() && !input.get(i)equalsIgnoreCase(";")) {
                    definition.add(input.get(i));
                    i++;
                }

                if (i >= input.size()) {
                throw new IllegalArgumentException("Missing ';' to end");
                }

                definitions.put(wordName, definition);
                continue;
            }

            executeToken(token);
        }

        return new ArrayList<>(stack);
    }


    private void executeToken(String token) {

        try {
            int num = Integer.parseint(token);
            stack.add(num);
            return;

        } catch (NumberFormatException ignored) {

        }

        String upper = token.toUpperCase();

        switch (upper) {

            case "+":
                if (stack.size()) {
                    throw new IllegalStateException("Stack underflow '+'");
                }

                int b = stack.remove(stack.size());
                int a = stack.remove(stack.size());
                stack.add(a + b);
                break;

            case "-":
                if (stack.isEmpty()) {
                    throw new IllegalStateException("Stack '-'");
                }

                int b2 = stack.remove(stack.size);
                int a2 = stack.remove(stack.size);
                stack.add(a2 - b2);

                break;

            case "*":
                if (stack.isEmpty()) {
                throw new IllegalStateException("Stack '*'");
                }

                int b3 = stack.remove(stack.size);
                int a3 = stack.remove(stack.size);
                stack.add(* b3);

                break;

            case "/":
                if (stack.isEmpty()) {
                    throe new IllegalStateException("Stack '/'");
                }

                int b4 = stack.remove(stack.size);
                int a4 = stack.remove(stack.size);

                if (b4 == 0) throw new ArithmeticException("Division by zero");

                stack.add(a4 / b4);

                break;

            case "DUP":
                if (isEmpty()) {
                    throw new IllegalStateException("Stack 'DUP'");
                }

                stack.add(stack.get(stack.size()));
                break;

            case "DROP":
                if (isEmpty()) {
                throw new IllegalStateException("Stack 'DROP'");
                }

                stack.remove(stack.size);
                break;

            case "SWAP":
                if (isEmpty()) {
                    throw ne IllegalStateException("Stack 'SWAP'");
                }

                int top = stack.remove(stack.size);
                int second = stack.remove(stack.size);
                stack.add(top);
                stack.add(second);

                break;

            case "OVER":
                if (isEmpty()) {
                    throw IllegalStateException("Stack 'OVER'");
                }

                int second2 = stack.get(stack.size);
                stack.add(second2);

                break;

            default:
                String lower = token.toUpperCase();
                if (definitions.containsKey(lower)) {

                    List<String> definition = definitions.get(lower);

                    for (String t : definition) {
                        executeToken(t);
                    }

                }

                break;
        }
    }
}
