-#include "crypto_square.h"
+#include "crypto_square.hpp"
+
+#include <cctype>
+#include <cmath>
+#include <string>
+#include <vector>
 
 namespace crypto_square {
 
+std::string encode(const::std::string &input) {
+    // Normalize: keep only letters, convert to lower case
+    std::string normalized;
+    normalized.reserve(input.size());
+    for (char ch : input) {
+        if (std::isalpha(static_cast<unsigned char>(ch))) {
+            normalized.push_back(std::tolower(static_cast<unsigned char>(ch)));
+        }
+    }
+
+    const size_t n = normalized.size();
+    if (n == 0) {
+        return "";
+    }
+
+    // Determine rectangle dimensions
+    size_t c = static_cast<size_t>(std::ceil(std::sqrt(static_cast<double>(n))));
+    size_t r = (n + c - 1) / c;  // ceil division
+
+    // Build chunks (columns) of length r, initialized with spaces
+    std::vector<std::string> chunks(c, std::string(r, ' '));
+
+    // Fill grid
+    for (size_t i = 0; i < r; ++i) {
+        for (size_t j = 0; j < c; ++j) {
+            size_t idx = i * c + j;
+            if (idx < n) {
+                chunks[j][i] = normalized[idx];
+            }
+        }
+    }
+
+    // Join chunks with spaces
+    std::string result;
+    for (size_t j = 0; j<c; ++j) {
+        if (j > 0) {
+            result.push_back(' ');
+        }
+        result += chunks[j];
+    }
+
+    return result;
+}
+
 }  // namespace crypto_square
