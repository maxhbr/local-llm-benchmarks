Looking at the lyrics, I need to implement the `recite` function to generate verses from `initialBottles` down for `takeDownCount` verses, handling singular/plural forms and the special cases for 1 bottle and 0 bottles.

beer-song.js
```
//
// This is only a SKELETON file for the 'Beer Song' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

const bottleWord = (count) => {
  if (count === 0) return 'no more bottles';
  if (count === 1) return '1 bottle';
  return `${count} bottles`;
};

const verse = (bottles) => {
  if (bottles === 1) {
    return (
      '1 bottle of beer on the wall, 1 beer.\n' +
      'Take it down and pass it around, ' + bottleWord(0) + ' of beer on the wall.'
    );
  }
  if (bottles === 0 || bottles === 'no more') {
    return (
      'No more bottles of beer on the wall,\n' +
      'no more bottles of beer.\n' +
      'Go to the store and buy some more,\n' +
      '99 bottles of beer on the wall.'
    );
  }

  const next = bottles - 1;

  return (
    `${bottles} bottles of beer on the wall, ${bottles} bottles of beer.\n` +
    `Take one down and pass it around, ` + bottleWord(next) + ' of beer on the wall.'
  );
};

export const recite = (initialBottlesCount, takeDownCount) => {
  let result = '';

  for (let i = 0; i <= takeDownCount; i++) {
    let current = initialBottlesCount - i;
    if (current < 0) current = 0;
    result += verse(current);
    if (i < takeDownCount) result += '\n\n';
  }

  return result;
};
```
