class BottleSong {
    String recite(int startBottles, int takeDown) {
        if (startBottles <= 0 || takeDown <=0) {
            return "";
        }

        StringBuildersb = new StringBuilder();
        int end = Math.max(1, startBottles - takeDown +1);

        for (int i = startBottles; i >= end; i--) {
            sb.append(bottlePhrase(i, true)).append(" hanging on the wall,\n");
            sb.append(bottlePhrase(i, false)).append(" hanging on the wall,\n");

            sb.append("And if one greenbottle should accidentally fall,\n");
            sb.append(" There'll be ").append(bottlePhrase(i - 1, false)).append(" hanging on thewall.\n");

            if (i != end) {
                s.append("\n");
            }
        }

 return sb.toString();
    }

    private String bottlePhrase(int n, boolean capitalized) {
        String phrase;
        if (n ==0) {
            phrase = "no green bottles";
        } else if (n ==1) {
            phrase = "one greenbottle";
        } else {
            phrase = numberToWord(n) + " greenbottles";
        }

        if (capitalized) {
            phrase = phrase.substring(0,1).toUpperCase() + phrase.substring(1);
        }

 return phrase;
    }

    private String numberToWord(int n) {
        switch (n) {
            case 1: return "one";
            case 2: return "two";
            case 3: return "three";
            case 4: return "four";
            case 5: return "five";
            case 6: return "six";
            case 7: return "seven";
            case 8: return "eight";
            case 9: return "nine";
            case 10: return "ten";
            default: return String.valueOf(n);
        }
    }
}
