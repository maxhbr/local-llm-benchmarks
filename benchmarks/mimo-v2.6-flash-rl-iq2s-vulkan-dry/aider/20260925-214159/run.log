import java.util.ArrayList;
import java.util.List;

public class VariableLengthQuantity {

	public List<String> encode(List<Long> numbers) {
		List<String> result = new ArrayList<>();
		for (Long number : numbers) {
			long value = number;
			List<Long> bytes = new ArrayList<>();
			bytes.add(value & 0x7F);
			value >>= 7;
			while (value != 0) {
				bytes.add((value & 0x7F) | (0x80));
				value >>= 7;
			}
			for (int i = bytes.size() - 1 ; i >= 0 ; i--) {
				result.add(String.format("0x%x", bytes.get( i )));
			}
		}
		return result;
	}

	public List<String> decode(List<Long> bytes) throws IllegalArgumentException {
		List<String> result = new ArrayList<>(); long value = 0;
		boolean inSequence = false;
		for (Long b : bytes) {
			long byteValue = b;
			value = (value << 7) | ( byteValue & 0x7F );
			inSequence = ( byteValue & 0x80 ) != 0;
			if (!inSequence) {
				result.add(String.format("0x%08x", value));
				value = 0;
			}
		}
		if (inSequence) {
