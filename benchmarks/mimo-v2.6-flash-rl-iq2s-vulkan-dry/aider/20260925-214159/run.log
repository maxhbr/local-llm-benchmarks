package octalest

// ParseOctal converts an octal string to its decimal equivalent.
// Invalid input is treated as octal 0.
func ParseOctal(input string) int {
	if input == "" {
		return 0
	}
	var result int
	for _, ch := range input {
		digit := int(ch - '0')
		if digit < 0 || digit > 9 {
			return 0
		}
		result = result*8 + digit
	}
	return result
}
