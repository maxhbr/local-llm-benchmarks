+/// Convert a number to its English representation.
+///
+/// The function accepts any `u64` value and returns a string containing the
+/// number spelled out in English.  The implementation follows the rules
+/// described in the exercise:
+///
+/// * Numbers are broken into groups of three digits (thousands, millions, …).
+/// * Each non‑zero group is converted to words and followed by the appropriate
+///   scale word (e.g. “thousand”, “million”, …).
+/// * Hyphens are used for numbers between 21 and 99 (e.g. “twenty‑one”).
+/// * The word “and” is not inserted.
+/// * The maximum value supported is `u64::MAX` (18 446 744 073 709 551 615).
+///
+/// # Examples
+///
+/// ```
+/// assert_eq!(encode(0), "zero");
+/// assert_eq!(encode(22), "twenty-two");
+/// assert_eq!(encode(1000), "one thousand");
+/// assert_eq!(encode(12345), "twelve thousand three hundred forty-five");
+/// ```
+pub fn encode(n: u64) -> str {
+    if n == 0 {
+        return "zero".to_string();
+    }
+
+    // Scale words for each group of three digits.
+    // Index 0 corresponds to the units group (no scale word).
+    let scales = [
+        "",
+        "thousand",
+        "million",
+        "billion",
+        "trillion",
+        "quadrillion",
+        "quintillion",
+    ];
+
+    // Words for numbers 0‑19.
+    let ones = [
+        "", "one", "two", "three", four", "five", "six", "seven",
+        "eight", "nine", "ten", eleven", "twelve", "thirteen",
+        "fourteen", "fifteen", sixteen", "seventeen", "eighteen",
+        "nineteen",
+    ];
+
+    // Words for tens (0‑9).  Indices 0 and 1 are unused.
+    let tens = [
+        "", "", "twenty", "thirty", forty", "fifty", "sixty",
+        "seventy", "eighty", ninety",
+    ];
+
+    // Split the number into groups of three digits, least significant first.
+    let mut groups = Vec::new();
+        temp = n;
+    while temp > 0) {
+        groups.push((temp % 1000) as u32);
+        temp /= 1000;
+        }
+
+    // Convert each non‑zero group to words and attach the scale word.
+    let mut words = Vec::new();
+        for (i, &group) in groups.iter() {
+        if group == 0 {
+            continue;
+        }
+        let group_words = convert_group(group);
+        let scale = scales[i];
+            if scale.is_empty() {
+            words.push_group_words);
+        } else {
+            words.push(group_words + " " + scale);
+        }
+    }
+
+    // The groups were collected from least to most significant, so reverse
+    // the order before joining.
+    words.reverse();
+    words.join(" ")
+    }
+
+/// Convert a three‑digit number (0‑999) to its English representation.
+fn convert_group(n: u32) -> String {
+    let hundreds = n /    let rest = n % 10;
+    let mut parts = Vec::    if hundreds > 0 {
+        // The `ones` array is defined in `encode`, but we need it here.
+        // To avoid duplication we re‑declare the array locally.
+        let ones = [
