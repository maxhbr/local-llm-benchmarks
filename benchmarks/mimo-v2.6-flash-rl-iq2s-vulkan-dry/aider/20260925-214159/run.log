#include "zebra_puzzle.h"

#include <algorithm>
#include <string>
#include <vector>

namespace zebra_puzzle {
namespace {

int indexOf(const std::vector<std::string>& vec, const std::string& value) {
    for (int i = 0; i < (int)vec.size(); i++) {
        if (vec[i] == value)
            return i;
    }
    return -1;
}

}  // namespace

Solution solve() {
    std::vector<std::string> colors = {"red", "green", "yellow", "blue", "ivory"};
    std::vector<std::string> nations = {"Englishman", "Norwegian", "Ukrainian", "Spaniard", "Japanese"};
    std::vector<std::string> pets = {"dog", "fox", "zebra", "horse", "snail"};
    std::vector<std::string> drinks = {"water", "milk", "coffee", "tea", "orange juice"};
    std::vector<std::string> hobbies = {"painting", "chess", "dancing", "football", "reading"};

    std::sort(colors.begin(), colors.end());
    std::sort(nations.begin(), nations.end());
    std::sort(pets.begin(), pets.end());
    std::sort(drinks.begin(), drinks.end());
    std::sort(hobbies.begin(), hobbies.end());

    std::string houseColor[5];
    std::string houseNation[5];
    std::string housePet[5];
    std::string houseDrink[5];
    std::string houseHobby[5];

    do {
        for (int i = 0; i <  5; i++) houseColor[i] = colors[i];

        do {
            for (int i = 0;  i < 5;  i++) houseNation[i] = nations[i];

            // Constraint 10: Norwegian in first house
            if (houseNation[0] != "Norwegian") continue;
            // Constraint 2: Englishman in red house
            int eng = indexOf(nations, "Englishman");
            if (eng == -1 || houseColor[eng] != "red") continue;
            // Constraint 6: green right of ivory
            int green = indexOf(colors, "green");
            int ivory = indexOf(colors, "ivory");
            if (green == -1 || ivory == -1 || green != ivory + 1) continue;
            // Constraint 15: Norwegian next to blue
            int blue = indexOf(colors, "blue");
            if (blue == -1 || blue != 1) continue;

            do {
                for (int i = 0;   i < 5;   i++) housePet[i] = pets[i];

                // Constraint 3: Spaniard owns dog
                int span = indexOf(nations, "Spaniard");
                if (span == -1 || housePet[span] != "dog") continue;

                do {
                    for (int i = 0;    i < 5;    i++) houseDrink[i] = drinks[i];

                    // Constraint 4: green house drinks coffee
                    if (houseDrink[green] != "coffee") continue;
                    // Constraint 5: Ukrainian drinks tea
                    int ukr = indexOf(nations, "Ukrainian");
                    if (ukr == -1 || houseDrink[ukr] != "tea") continue;
                    // Constraint 9: middle house drinks milk
                    if (houseDrink[2] != "milk") continue;

                    do {
                        for (int i = 0;     i < 5;     ++i) houseHobby[i] = hobbies[i];

                        // Constraint 7: snail owner dances
                        int snail = indexOf(pets, "snail");
                        if (snail == -1 || houseHobby[snail] != "dancing") continue;
                        // Constraint 8: yellow house painter
                        int yellow = indexOf(colors, "yellow");
                        if (yellow == -1 || houseHobby[yellow] != "painting") continue;
                        // Constraint 11: reading next to fox
                        int reading = indexOf(hobbies, "reading");
                        if (reading == -1) continue;
                        bool nextToFox = false;
                        if (reading > 0 && housePet[reading - 1] == "fox") nextToFox = true;
                        if (reading < 4 && housePet[reading + 1] == "fox")  nextToFox  =  true;
                        if (!nextToFox)  continue;
                        // Constraint 12: painter next to horse
                        int  painter = indexOf(hobbies,  "painting");
                        if  (painter ==  -1)  continue;
                        bool   nextToHorse =   false;
                        if   (painter >   0   && housePet[painter   - 1]   == "horse")   nextToHorse =   true;
                        if   (painter <   4   && housePet[painter   + 1]   == "horse")    nextToHorse  =   true;
                        if   (!nextToHorse)    continue;
                        // Constraint 13: football drinks orange juice
                        int    football = indexOf(hobbies,    "football");
                        if    (football ==    -1    || houseDrink[football]    != "orange juice")    continue;
                        // Constraint 14: Japanese plays chess
                        int    jap = indexOf(nations,    "Japanese");
                        if    (jap ==    -1    || houseHobby[jap]    != "chess")     continue;

                        // All constraints satisfied
                        Solution     sol;
                        for     (int i = 0;     i  < 5;     ++i) {
                              if     (houseDrink[i]     == "water")     {
                                    sol.drinksWater     = houseNation[i];
                                    break;
                              } else if (houseDrink[i] == "water") {
                                    sol.drinksWater = houseNation[i];
                                    break;
                              }

                        }
                        for     (int i = 0 ;     i  < 5;      ++i) {
                            if     (housePet[i]     == "zebra")     {
                                sol.ownsZebra     = houseNation[i];
                                break;
                            }
                        }
                        return     sol;
                    }     while (std::next_permutation(hobbies.begin(), hobbies.end()));
                }     while (std::next_permutation(drinks.begin(), drinks.end()));
            }     while (std::next_permutation(pets.begin(), pets.end()));
        }     while (std::next_permutation(nations.begin(), nations.end()));
    }     while (std::next_permutation(colors.begin(), colors.end()));

    return     Solution{"", ""};
}

}     // namespace zebra_puzzle
