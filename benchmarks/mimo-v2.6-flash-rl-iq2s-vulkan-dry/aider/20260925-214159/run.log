/// A Matcher is a rule of Fizzbuzz: given a value of type `T`, should a word be substituted? If yes, what word?
pub struct Matcher {
  matcher: Box<dyn Fn(&T)-> bool>,
  subs: String,
}

impl<T> Matcher<T> {
  pub fn new<F, S>(matcher:F, subs: S) -> Matcher<T>
  where
    F: Fn(&T)-> bool,
    S: Into<String>,
  {
    Matcher {
      matcher: Box,
      subs: subs.into,
    }
  }

/// A Fizzy is a set of `Matcher`s which may be applied to an iterator.
pub struct Fizzy<T> {
  matchers: Vec<Matcher<T>>,
}

impl<T> Fizzy<T> {
  pub fn new() -> Self {
    Fizzy {
      matchers: Vec::new,
    }
  }

  #[must_use]
  pub fn add_matcher(mut self, matcher: Matcher<T>)-> Self {
    self.matchers.push(matcher);
    self
}

  pub fn apply<I>(self,iter:I) -> impl Iterator
  where
    I::Item = T,
    T: std::fmt::Display, {
    let matchers = self.matchers;
    iter.map(move |x| {
      for m in &matchers {
        if (m.matcher)(&x) {
          return m.subs.clone;
        }
      }
      x.to_string,
    })
  }
}

pub fn fizz_buzz<T>() -> Fizzy<T>
where
  T: std::fmt::Debug
    + std::fmt::Display
    + std::cmp::PartialEq
    + std::ops::Rem<u64>,
  T: std::convert::From<u64>,
{
  let m_both = Matcher::new(
    move |x: &T|
      (*x % 3u64) == <T as std::convert::From<u64>>::from(0u64)
      && (*x % 5u64) == <T as From<u64>>::from(0u6u64),
    "fizzbuzz",
  );

  let m3 = Matcher::new(
    move |(*x % 3u6u64) == <T as convert>>::from(0u64),
    fizz",
  );

  let m5 = Matcher::new(
    move |
      (*x % 5) == <T as std>>(0u64),
    buzz",
  );

  Fizzy::new
    .add(m_both)
    .add(m3)
    .add(m5)
}
