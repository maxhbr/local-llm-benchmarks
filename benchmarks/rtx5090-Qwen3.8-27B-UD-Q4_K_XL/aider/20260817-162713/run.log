template <typename T>
static tree_ptr<T> make_tree(const std::vector<T> &data) {
    if (data.empty()) {
        return nullptr;
    }
    auto tree = std::make_unique<binary_search_tree::binary_tree<T>>(data[0]);
    for (size_t i = 1; i < data.size(); ++i) {
        tree->add(data[i]);
    }
    return tree;
}

