                search = line.lower() if case_insensitive else line
                pat = pattern.lower() if case_insensitive else pattern
                if whole_line:
                    matched = (search == pat)
                else:
                    matched = pat in search
                if matched != invert: # if invert, select non-matches
                    if files_only:
                        if not file_has_match:
                            results.append(filename)
                            file_has_match = True
                    else:
                        if multi:
                            prefix = filename + ':'
                        else:
                            prefix = ''
                        if line_numbers:
                            results.append(f"{prefix}{line_number}:{line}")
                        else:
