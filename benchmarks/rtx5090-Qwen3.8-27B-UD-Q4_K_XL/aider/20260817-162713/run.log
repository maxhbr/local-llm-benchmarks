use std::collections::HashSet;
use std::sync::{Mutex, MutexGuard, atomic::{AtomicU64, Ordering}};
use std::time::{SystemTime, UNIX_EPOCH};

pub struct Robot {
    name: String,
}

static USED_NAMES: Mutex<HashSet<String>> = Mutex::new(HashSet::new());
static COUNTER: AtomicU64 = AtomicU64::new(0);

impl Robot {
    pub fn new() -> Self {
        let mut used = lock_used_names();
        let name = generate_unique_name(&mut used);
        Self { name }
    }

    pub fn name(&self) -> &str {
        &self.name
    }

    pub fn reset_name(&mut self) {
        let mut used = lock_used_names();
        used.remove(&self.name);
        let name = generate_unique_name(&mut used);
        self.name = name;
    }
}

impl Drop for Robot {
    fn drop(&mut self) {
        let mut used = lock_used_names();
        used.remove(&self.name);
    }
}

fn lock_used_names() -> MutexGuard<'static, HashSet<String>> {
    USED_NAMES.lock().unwrap_or_else(|poisoned| poisoned.into_inner())
}

fn mix64(mut x: u64) -> u64 { ... }

fn random_u64() -> u64 { ... }

fn random_name() -> String { ... }

fn generate_unique_name(used: &mut HashSet<String>) -> String { ... }

