def grep(pattern, flags, files):
    known_flags = {'-n', '-l', '-i', '-v', '-x'}

    if flags is None:
        flag_parts = []
    elif isinstance(flags, str):
        flag_parts = flags.split()
    else:
        flag_parts = list(flags)

    normalized_flags = []
    for part in flag_parts:
        if not isinstance(part, str):
            continue
        if part in known_flags:
            normalized_flags.append(part)
        elif part.startswith('-') and len(part) > 2 and part[1] != '-':
            for ch in part[1:]:
                flag = f'-{ch}'
                if flag in known_flags:
                    normalized_flags.append(flag)
        else:
            for ch in part:
                flag = f'-{ch}'
                if flag in known_flags:
                    normalized_flags.append(flag)

    if files is None:
        file_list = []
    elif isinstance(files, str):
        file_list = [files]
    else:
        file_list = list(files)

    case_insensitive = '-i' in normalized_flags
    invert = '-v' in normalized_flags
    line_numbers = '-n' in normalized_flags
    files_only = '-l' in normalized_flags
    whole_line = '-x' in normalized_flags

    search_pattern = pattern.lower() if case_insensitive else pattern
    multiple_files = len(file_list) > 1
    results = []

    for filename in file_list:
        filename = str(filename)
        file_has_match = False

        with open(filename, 'r') as f:
            for line_number, line in enumerate(f, 1):
                line = line.rstrip('\n')
                current_line = line.lower() if case_insensitive else line

                if whole_line:
                    matched = current_line == search_pattern
                else:
                    matched = search_pattern in current_line

                if matched == invert:
                    continue

                if files_only:
                    if not file_has_match:
                        results.append(filename)
                        file_has_match = True
                    continue

                if multiple_files:
                    prefix = f'{filename}:'
                else:
                    prefix = ''

                if line_numbers:
                    results.append(f'{prefix}{line_number}:{line}')
                else:
                    results.append(prefix + line)

    return results
```
