grep.js
```
#!/usr/bin/env node

// The above line is a shebang. On Unix-like operating systems, or environments,
// this will allow the script to be run by node, and thus turn this JavaScript
// file into an executable. In other words, to execute this file, you may run
// the following from your terminal:
//
// ./grep.js args
//
// If you don't have a Unix-like operating system or environment, for example
// Windows without WSL, you can use the following inside a window terminal,
// such as cmd.exe:
//
// node grep.js args
//
// Read more about shebangs here: https://en.wikipedia.org/wiki/Shebang_(Unix)

const fs = require('fs');
const path = require('path');

/**
 * Reads the given file and returns lines.
 *
 * This function works regardless of POSIX (LF) or windows (CRLF) encoding.
 *
 * @param {string} file path to file
 * @returns {string[]} the lines
 */
function readLines(file) {
  let data;

  try {
    data = fs.readFileSync(path.resolve(file), { encoding: 'utf-8' });
  } catch (err) {
    return [];
  }

  if (data === '') {
    return [];
  }

  const lines = data.split(/\r?\n/);

  if (data.endsWith('\n')) {
    lines.pop();
  }

  return lines;
}

const VALID_OPTIONS = [
  'n', // add line numbers
  'l', // print file names where pattern is found
  'i', // ignore case
  'v', // reverse files results
  'x', // match entire line
];

function isFlag(arg) {
  if (!arg.startsWith('-') || arg.length <= 1) {
    return false;
  }

  const flagChars = arg.slice(1);
  return flagChars.length > 0 && flagChars.every((char) => VALID_OPTIONS.includes(char));
}

function lineMatches(line, pattern, flags) {
  const searchLine = flags.has('i') ? line.toLowerCase() : line;
  const searchPattern = flags.has('i') ? pattern.toLowerCase() : pattern;

  if (flags.has('x')) {
    return searchLine === searchPattern;
  }

  return searchLine.includes(searchPattern);
}

function main() {
  const args = process.argv.slice(2);

  if (args.length === 0) {
    return;
  }

  const pattern = args[0];
  const rest = args.slice(1);

  const flags = new Set();
  const files = [];

  let index = 0;
  while (index < rest.length) {
    const arg = rest[index];

    if (arg === '--') {
      files.push(...rest.slice(index + 1));
      break;
    }

    if (isFlag(arg)) {
      for (const char of arg.slice(1)) {
        flags.add(char);
      }
      index += 1;
      continue;
    }

    files.push(...rest.slice(index));
    break;
  }

  const output = [];
  const multipleFiles = files.length > 1;

  for (const file of files) {
    const lines = readLines(file);
    let fileHasSelectedLine = false;

    for (let lineNumber = 0; lineNumber < lines.length; lineNumber += 1) {
      const line = lines[lineNumber];
      const matches = lineMatches(line, pattern, flags);
      const selected = flags.has('v') ? !matches : matches;

      if (!selected) {
        continue;
      }

      fileHasSelectedLine = true;

      if (flags.has('l')) {
        continue;
      }

      const prefixParts = [];
      if (multipleFiles) {
        prefixParts.push(file);
      }
      if (flags.has('n')) {
        prefixParts.push(String(lineNumber + 1));
      }

      const prefix = prefixParts.length > 0 ? `${prefixParts.join(':')}:` : '';
      output.push(prefix + line);
    }

    if (flags.has('l') && fileHasSelectedLine) {
      output.push(file);
    }
  }

  if (output.length > 0) {
    console.log(output.join('\n'));
  }
}

main();
