unsafe fn box_static_fn_mut<T: 'static, F: FnMut(T)>(callback: F) -> Box<dyn FnMut(T)> {
    let callback: Box<dyn FnMut(T) + '_> = Box::new(callback);
    std::mem::transmute(callback)
}

