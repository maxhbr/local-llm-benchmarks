use std::fmt; // not needed
#[derive(Debug, PartialEq, Eq)]
pub enum Error { ... }

pub fn convert(input: &str) -> Result<String, Error> {
    let lines: Vec<&str> = input.lines().collect();
    let row_count = lines.len();
    if row_count % 4 != 0 {
        return Err(Error::InvalidRowCount(row_count));
    }
    if row_count == 0 {
        return Ok(String::new());
    }
    let col_count = lines[0].chars().count();
    if col_count % 3 != 0 {
        return Err(Error::InvalidColumnCount(col_count));
    }
    for line in &lines {
        let c = line.chars().count();
        if c != col_count {
            return Err(Error::InvalidColumnCount(c));
        }
    }

    let mut groups = Vec::with_capacity(row_count / 4);
    for group in lines.chunks(4) {
        let mut s = String::new();
        let digit_count = col_count / 3;
        for i in 0..digit_count {
            let mut pattern = [String::new(); 4];
            for (row_idx, line) in group.iter().enumerate() {
                let chars: Vec<char> = line.chars().collect();
                let start = i * 3;
                pattern[row_idx] = chars[start..start+3].iter().collect::<String>();
            }
            // trim_end each pattern row
            let trimmed = [
                pattern[0].trim_end(),
                pattern[1].trim_end(),
                pattern[2].trim_end(),
                pattern[3].trim_end(),
            ];
            s.push(recognize(trimmed));
        }
        groups.push(s);
    }
    Ok(groups.join(","))
}

fn recognize(pattern: [&str; 4]) -> char {
    match pattern {
        [" _", "| |", "|_|", ""] => '0',
        ["", "  |", "  |", ""] => '1',
        [" _", " _|", "|_", ""] => '2',
        [" _", " _|", " _|", ""] => '3',
        ["", "|_|", "  |", ""] => '4',
        [" _", "|_", " _|", ""] => '5',
        [" _", "|_", "|_|", ""] => '6',
        [" _", "  |", "  |", ""] => '7',
        [" _", "|_|", "|_|", ""] => '8',
        [" _", "|_|", " _|", ""] => '9',
        _ => '?',
    }
}
```
