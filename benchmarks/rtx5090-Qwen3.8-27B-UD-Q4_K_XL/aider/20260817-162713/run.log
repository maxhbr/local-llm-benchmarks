import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;

class Poker {
    private final List<String> hands;

    Poker(List<String> hand) {
        this.hands = hand;
    }

    List<String> getBestHands() {
        List<String> bestHands = new ArrayList<>();
        if (hands == null || hands.isEmpty()) {
            return bestHands;
        }

        int[] bestScore = null;
        for (String hand : hands) {
            int[] score = scoreHand(hand);
            if (bestScore == null || compareScores(score, bestScore) > 0) {
                bestScore = score;
                bestHands.clear();
                bestHands.add(hand);
            } else if (compareScores(score, bestScore) == 0) {
                bestHands.add(hand);
            }
        }
        return bestHands;
    }

    private static int[] scoreHand(String hand) {
        String[] cards = hand.trim().split("\\s+");
        int[] ranks = new int[5];
        char[] suits = new char[5];

        for (int i = 0; i < 5; i++) {
            String card = cards[i];
            char suit = card.charAt(card.length() - 1);
            String rankPart = card.substring(0, card.length() - 1);
            ranks[i] = rankValue(rankPart);
            suits[i] = suit;
        }

        int[] counts = new int[15];
        for (int rank : ranks) {
            counts[rank]++;
        }

        boolean flush = true;
        for (int i = 1; i < 5; i++) {
            if (suits[i] != suits[0]) {
                flush = false;
                break;
            }
        }

        int straightHigh = straightHighCard(ranks);
        int maxCount = 0;
        int secondMaxCount = 0;
        for (int count : counts) {
            if (count > maxCount) {
                secondMaxCount = maxCount;
                maxCount = count;
            } else if (count > secondMaxCount) {
                secondMaxCount = count;
            }
        }

        int[] score = new int[6];
        if (flush && straightHigh != 0) {
            score[0] = 9;
            score[1] = straightHigh;
            score[2] = straightHigh - 1;
            score[3] = straightHigh - 2;
            score[4] = straightHigh - 3;
            score[5] = straightHigh - 4;
        } else if (maxCount == 4) {
            score[0] = 8;
            score[1] = rankWithCount(counts, 4);
            score[2] = firstKicker(counts, 1);
        } else if (maxCount == 3 && secondMaxCount == 2) {
            score[0] = 7;
            score[1] = rankWithCount(counts, 3);
            score[2] = rankWithCount(counts, 2);
        } else if (flush) {
            score[0] = 6;
            int[] sorted = sortedDescending(ranks);
            for (int i = 0; i < 5; i++) score[i + 1] = sorted[i];
        } else if (straightHigh != 0) {
            score[0] = 5;
            score[1] = straightHigh;
            score[2] = straightHigh - 1;
            score[3] = straightHigh - 2;
            score[4] = straightHigh - 3;
            score[5] = straightHigh - 4;
        } else if (maxCount == 3) {
            score[0] = 4;
            score[1] = rankWithCount(counts, 3);
            int[] kickers = kickers(counts, 1);
            score[2] = kickers[0];
            score[3] = kickers[1];
        } else if (maxCount == 2 && secondMaxCount == 2) {
            score[0] = 3;
            int[] pairs = pairRanks(counts);
            score[1] = pairs[0];
            score[2] = pairs[1];
            score[3] = firstKicker(counts, 1);
        } else if (maxCount == 2) {
            score[0] = 2;
            score[1] = rankWithCount(counts, 2);
            int[] kickers = kickers(counts, 1);
            score[2] = kickers[0];
            score[3] = kickers[1];
            score[4] = kickers[2];
        } else {
            score[0] = 1;
            int[] sorted = sortedDescending(ranks);
            for (int i = 0; i < 5; i++) score[i + 1] = sorted[i];
        }
        return score;
    }

    private static int straightHighCard(int[] ranks) {
        int[] sorted = ranks.clone();
        Arrays.sort(sorted);
        for (int i = 1; i < 5; i++) {
            if (sorted[i] == sorted[i - 1]) {
                return 0;
            }
        }
        if (sorted[4] - sorted[0] == 4) {
            return sorted[4];
        }
        if (sorted[0] == 2 && sorted[1] == 3 && sorted[2] == 4 && sorted[3] == 5 && sorted[4] == 14) {
            return 5;
        }
        return 0;
    }

    private static int[] sortedDescending(int[] ranks) {
        int[] sorted = ranks.clone();
        Arrays.sort(sorted);
        int[] desc = new int[5];
        for (int i = 0; i < 5; i++) {
            desc[i] = sorted[4 - i];
        }
        return desc;
    }

    private static int rankWithCount(int[] counts, int count) {
        for (int rank = 14; rank >= 2; rank--) {
            if (counts[rank] == count) {
                return rank;
            }
        }
        return 0;
    }

    private static int firstKicker(int[] counts, int count) {
        for (int rank = 14; rank >= 2; rank--) {
            if (counts[rank] == count) {
                return rank;
            }
        }
        return 0;
    }

    private static int[] kickers(int[] counts, int count) {
        int[] result = new int[5];
        int idx = 0;
        for (int rank = 14; rank >= 2; rank--) {
            if (counts[rank] == count) {
                result[idx++] = rank;
            }
        }
        return result;
    }

    private static int[] pairRanks(int[] counts) {
        int[] result = new int[2];
        int idx = 0;
        for (int rank = 14; rank >= 2; rank--) {
            if (counts[rank] == 2) {
                result[idx++] = rank;
            }
        }
        return result;
    }

    private static int compareScores(int[] a, int[] b) {
        for (int i = 0; i < a.length; i++) {
            if (a[i] != b[i]) {
                return Integer.compare(a[i], b[i]);
            }
        }
        return 0;
    }

    private static int rankValue(String rank) {
        switch (rank) {
            case "2": return 2;
            case "3": return 3;
            case "4": return 4;
            case "5": return 5;
            case "6": return 6;
            case "7": return 7;
            case "8": return 8;
            case "9": return 9;
            case "10": return 10;
            case "J": return 11;
            case "Q": return 12;
            case "K": return 13;
            case "A": return 14;
            default:
                throw new IllegalArgumentException("Invalid rank: " + rank);
        }
    }
}

