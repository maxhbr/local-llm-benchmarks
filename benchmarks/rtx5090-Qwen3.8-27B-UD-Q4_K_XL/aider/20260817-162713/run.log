use std::collections::HashSet;
use std::sync::{Mutex, MutexGuard, atomic::{AtomicU64, Ordering}};
use std::time::{SystemTime, UNIX_EPOCH};

pub struct Robot {
    name: String,
}

static USED_NAMES: Mutex<HashSet<String>> = Mutex::new(HashSet::new());
static COUNTER: AtomicU64 = AtomicU64::new(0);

impl Robot {
    pub fn new() -> Self {
        let name = generate_unique_name();
        Self { name }
    }

    pub fn name(&self) -> &str {
        &self.name
    }

    pub fn reset_name(&mut self) {
        self.name = generate_unique_name();
    }
}

fn generate_unique_name() -> String {
    let mut used = USED_NAMES.lock().unwrap_or_else(|poisoned| poisoned.into_inner());
    let mut attempts = 0;
    loop {
        let name = random_name();
        attempts += 1;
        if used.insert(name.clone()) {
            return name;
        }
        if attempts >= 1024 {
            for index in 0..(26 * 26 * 1000) {
                let first = index / (26 * 1000);
                let second = (index / 1000) % 26;
                let number = index % 1000;
                let name = format!(
                    "{}{}{:03}",
                    (b'A' + first as u8) as char,
                    (b'A' + second as u8) as char,
                    number
                );
                if used.insert(name.clone()) {
                    return name;
                }
            }
            panic!("No unique robot name available");
        }
    }
}

fn random_name() -> String {
    let value = random_u64();
    let letters = (value % 676) as usize;
    let number = ((value >> 32) % 1000) as u32;
    let first = b'A' + (letters / 26) as u8;
    let second = b'A' + (letters % 26) as u8;
    format!("{}{}{:03}", first as char, second as char, number)
}

fn random_u64() -> u64 {
    let counter = COUNTER.fetch_add(1, Ordering::Relaxed);
    let time = SystemTime::now()
        .duration_since(UNIX_EPOCH)
        .map(|duration| duration.as_nanos() as u64)
        .unwrap_or(0);
    let process_id = std::process::id() as u64;
    let local = 0u64;
    let stack_address = &local as *const u64 as u64;

    let mut value = time;
    value ^= counter.wrapping_mul(0x9e37_79b9_7f4a_7c15);
    value ^= process_id.wrapping_mul(0xc2b2_ae3d_27d4_eb4f);
    value ^= stack_address.wrapping_mul(0x27d4_eb2f_1656_67c5);
    mix64(value)
}

fn mix64(mut x: u64) -> u64 {
    x = (x ^ (x >> 30)).wrapping_mul(0xbf58_476d_1ce4_e5b9);
    x = (x ^ (x >> 27)).wrapping_mul(0x94d0_49bb_1331_11eb);
    x ^ (x >> 31)
}

