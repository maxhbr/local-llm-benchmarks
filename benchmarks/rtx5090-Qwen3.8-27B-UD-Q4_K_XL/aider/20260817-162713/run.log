```
import java.util.ArrayDeque;
import java.util.HashSet;

class TwoBucket {
    private final int totalMoves;
    private final String finalBucket;
    private final int otherBucket;

    TwoBucket(int bucketOneCap, int bucketTwoCap, int desiredLiters, String startBucket) {
        if (bucketOneCap <= 0 || bucketTwoCap <= 0) {
            throw new IllegalArgumentException("Bucket capacities must be positive.");
        }
        if (desiredLiters < 0) {
            throw new IllegalArgumentException("Desired liters cannot be negative.");
        }
        if (!"one".equals(startBucket) && !"two".equals(startBucket)) {
            throw new IllegalArgumentException("Start bucket must be 'one' or 'two'.");
        }

        if (desiredLiters == 0) {
            this.totalMoves = 0;
            this.finalBucket = startBucket;
            this.otherBucket = 0;
            return;
        }

        if (desiredLiters > Math.max(bucketOneCap, bucketTwoCap)) {
            throw new IllegalArgumentException("No solution possible.");
        }
        if (desiredLiters % gcd(bucketOneCap, bucketTwoCap) != 0) {
            throw new IllegalArgumentException("No solution possible.");
        }

        ArrayDeque<int[]> queue = new ArrayDeque<>();
        HashSet<Long> visited = new HashSet<>();
        queue.add(new int[] {0, 0, 0});
        visited.add(encode(0, 0));

        while (!queue.isEmpty()) {
            int[] current = queue.poll();
            int a = current[0];
            int b = current[1];
            int moves = current[2];

            if (a == desiredLiters || b == desiredLiters) {
                if (a == desiredLiters && b == desiredLiters) {
                    this.totalMoves = moves;
                    this.finalBucket = startBucket;
                    this.otherBucket = desiredLiters;
                } else if (a == desiredLiters) {
                    this.totalMoves = moves;
                    this.finalBucket = "one";
                    this.otherBucket = b;
                } else {
                    this.totalMoves = moves;
                    this.finalBucket = "two";
                    this.otherBucket = a;
                }
                return;
            }

            int pourOneToTwo = Math.min(a, bucketTwoCap - b);
            int pourTwoToOne = Math.min(b, bucketOneCap - a);

            int[][] nextStates = new int[][] {
                {bucketOneCap, b},
                {a, bucketTwoCap},
                {0, b},
                {a, 0},
                {a - pourOneToTwo, b + pourOneToTwo},
                {a + pourTwoToOne, b - pourTwoToOne}
            };

            for (int[] next : nextStates) {
                int na = next[0];
                int nb = next[1];
                if (isForbidden(na, nb, bucketOneCap, bucketTwoCap, startBucket)) {
                    continue;
                }
                long key = encode(na, nb);
                if (visited.add(key)) {
                    queue.add(new int[] {na, nb, moves + 1});
                }
            }
        }

        throw new IllegalArgumentException("No solution possible.");
    }

    int getTotalMoves() {
        return totalMoves;
    }

    String getFinalBucket() {
        return finalBucket;
    }

    int getOtherBucket() {
        return otherBucket;
    }

    private static int gcd(int a, int b) {
        a = Math.abs(a);
        b = Math.abs(b);
        while (b != 0) {
            int t = a % b;
            a = b;
            b = t;
        }
        return a;
    }

    private static long encode(int a, int b) {
        return (((long) a) << 32) | (b & 0xffffffffL);
    }

    private static boolean isForbidden(int a, int b, int bucketOneCap, int bucketTwoCap, String startBucket) {
        if ("one".equals(startBucket)) {
            return a == 0 && b == bucketTwoCap;
        }
        return a == bucketOneCap && b == 0;
    }
}
```

