/// `InputCellId` is a unique identifier for an input cell.
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub struct InputCellId(pub usize);
/// `ComputeCellId` ...
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub struct ComputeCellId(pub usize);
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub struct CallbackId(pub usize, pub usize);

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum CellId {
    Input(InputCellId),
    Compute(ComputeCellId),
}

#[derive(Debug, PartialEq, Eq)]
pub enum RemoveCallbackError {
    NonexistentCell,
    NonexistentCallback,
}

struct ComputeCell<T: 'static> {
    dependencies: Vec<CellId>,
    compute: Box<dyn Fn(&[T]) -> T>,
    value: T,
    callbacks: Vec<Option<Box<dyn FnMut(T)>>>,
}

pub struct Reactor<T: 'static> {
    inputs: Vec<T>,
    computes: Vec<ComputeCell<T>>,
}

unsafe fn box_static_fn_mut<'a, T: 'static, F: FnMut(T) + 'a>(callback: F) -> Box<dyn FnMut(T)> {
    let callback: Box<dyn FnMut(T) + 'a> = Box::new(callback);
    unsafe { std::mem::transmute(callback) }
}

// You are guaranteed that Reactor will only be tested against types that are Copy + PartialEq.
impl<T: Copy + PartialEq + 'static> Reactor<T> {
    pub fn new() -> Self {
        Reactor {
            inputs: Vec::new(),
            computes: Vec::new(),
        }
    }

    pub fn create_input(&mut self, initial: T) -> InputCellId {
        let id = InputCellId(self.inputs.len());
        self.inputs.push(initial);
        id
    }

    pub fn create_compute<F: Fn(&[T]) -> T + 'static>(
        &mut self,
        dependencies: &[CellId],
        compute_func: F,
    ) -> Result<ComputeCellId, CellId> {
        for dependency in dependencies {
            if !self.cell_exists(*dependency) {
                return Err(*dependency);
            }
        }

        let values: Vec<T> = dependencies
            .iter()
            .map(|dependency| self.value(*dependency).unwrap())
            .collect();
        let value = compute_func(&values);

        let id = ComputeCellId(self.computes.len());
        self.computes.push(ComputeCell {
            dependencies: dependencies.to_vec(),
            compute: Box::new(compute_func),
            value,
            callbacks: Vec::new(),
        });
        Ok(id)
    }

    fn cell_exists(&self, id: CellId) -> bool {
        match id {
            CellId::Input(id) => self.inputs.len() > id.0,
            CellId::Compute(id) => self.computes.len() > id.0,
        }
    }

    pub fn value(&self, id: CellId) -> Option<T> {
        match id {
            CellId::Input(id) => self.inputs.get(id.0).copied(),
            CellId::Compute(id) => self.computes.get(id.0).map(|cell| cell.value),
        }
    }

    pub fn set_value(&mut self, id: InputCellId, new_value: T) -> bool {
        let changed = match self.inputs.get_mut(id.0) {
            Some(value) => {
                let changed = *value != new_value;
                if changed {
                    *value = new_value;
                }
                changed
            }
            None => return false,
        };

        if changed {
            self.propagate();
        }

        true
    }

    fn propagate(&mut self) {
        let mut changed = vec![false; self.computes.len()];

        for i in 0..self.computes.len() {
            let old_value = self.computes[i].value;
            let new_value = {
                let values: Vec<T> = self.computes[i]
                    .dependencies
                    .iter()
                    .map(|dependency| self.value(*dependency).unwrap())
                    .collect();
                (self.computes[i].compute)(&values)
            };

            if new_value != old_value {
                self.computes[i].value = new_value;
                changed[i] = true;
            }
        }

        for i in 0..self.computes.len() {
            if changed[i] {
                let value = self.computes[i].value;
                for callback in self.computes[i].callbacks.iter_mut() {
                    if let Some(callback) = callback.as_mut() {
                        callback(value);
                    }
                }
            }
        }
    }

    pub fn add_callback<F: FnMut(T)>(&mut self, id: ComputeCellId, callback: F) -> Option<CallbackId> {
        let cell_index = id.0;
        let cell = self.computes.get_mut(cell_index)?;
        let callback_index = cell.callbacks.len();
        let callback = unsafe { box_static_fn_mut(callback) };
        cell.callbacks.push(Some(callback));
        Some(CallbackId(cell_index, callback_index))
    }

    pub fn remove_callback(
        &mut self,
        cell: ComputeCellId,
        callback: CallbackId,
    ) -> Result<(), RemoveCallbackError> {
        let cell_index = cell.0;
        let callback_cell_index = callback.0;
        let callback_index = callback.1;

        match self.computes.get_mut(cell_index) {
            None => Err(RemoveCallbackError::NonexistentCell),
            Some(cell) => {
                if callback_cell_index != cell_index {
                    return Err(RemoveCallbackError::NonexistentCallback);
                }

                match cell.callbacks.get_mut(callback_index) {
                    Some(slot) => match slot {
                        Some(_) => {
                            *slot = None;
                            Ok(())
                        }
                        None => Err(RemoveCallbackError::NonexistentCallback),
                    },
                    None => Err(RemoveCallbackError::NonexistentCallback),
                }
            }
        }
    }
}
```

