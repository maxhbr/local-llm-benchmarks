Cpp final:
```
#include "complex_numbers.h"

#include <cmath>

namespace complex_numbers {

complex::complex(double real, double imaginary) : real_(real), imag_(imaginary) {}

double complex::real() const {
    return real_;
}

double complex::imag() const {
    return imag_;
}

double complex::imaginary() const {
    return imag_;
}

complex complex::operator+(const complex& rhs) const {
    return complex(real_ + rhs.real_, imag_ + rhs.imag_);
}

complex complex::operator-(const complex& rhs) const {
    return complex(real_ - rhs.real_, imag_ - rhs.imag_);
}

complex complex::operator*(const complex& rhs) const {
    return complex(real_ * rhs.real_ - imag_ * rhs.imag_,
                   real_ * rhs.imag_ + imag_ * rhs.real_);
}

complex complex::operator/(const complex& rhs) const {
    double denom = rhs.real_ * rhs.real_ + rhs.imag_ * rhs.imag_;
    return complex((real_ * rhs.real_ + imag_ * rhs.imag_) / denom,
                   (imag_ * rhs.real_ - real_ * rhs.imag_) / denom);
}

complex complex::conjugate() const {
    return complex(real_, -imag_);
}

double complex::abs() const {
    return std::sqrt(real_ * real_ + imag_ * imag_);
}

double complex::absolute() const {
    return abs();
}

complex complex::exp(const complex& c) {
    double e = std::exp(c.real_);
    return complex(e * std::cos(c.imag_), e * std::sin(c.imag_));
}

bool complex::operator==(const complex& rhs) const {
    const double eps = 1e-12;
    return std::abs(real_ - rhs.real_) <= eps &&
           std::abs(imag_ - rhs.imag_) <= eps;
}

bool complex::operator!=(const complex& rhs) const {
    return !(*this == rhs);
}

complex add(const complex& lhs, const complex& rhs) {
    return lhs + rhs;
}

complex subtract(const complex& lhs, const complex& rhs) {
    return lhs - rhs;
}

complex multiply(const complex& lhs, const complex& rhs) {
    return lhs * rhs;
}

complex divide(const complex& lhs, const complex& rhs) {
    return lhs / rhs;
}

complex conjugate(const complex& c) {
    return c.conjugate();
}

double abs(const complex& c) {
    return c.abs();
}

complex exp(const complex& c) {
    return complex::exp(c);
}

double real(const complex& c) {
    return c.real();
}

double imag(const complex& c) {
    return c.imag();
}

double imaginary(const complex& c) {
    return c.imaginary();
}

}  // namespace complex_numbers
```

