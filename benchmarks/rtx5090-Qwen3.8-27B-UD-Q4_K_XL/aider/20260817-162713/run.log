class TwoBucket {
 private final int moves; private final String finalBucket; private final int other;
 TwoBucket(int bucketOneCap, int bucketTwoCap, int desiredLiters, String startBucket) {
   if (desiredLiters < 0 || bucketOneCap <=0 || bucketTwoCap <=0) throw ...?
   if (desiredLiters > Math.max(bucketOneCap, bucketTwoCap)) throw ...
   if (desiredLiters % gcd(bucketOneCap,bucketTwoCap) != 0) throw ...
   // BFS
   int forbiddenA, forbiddenB;
   if (startBucket.equals("one")) { forbiddenA=0; forbiddenB=bucketTwoCap; }
   else if (startBucket.equals("two")) { forbiddenA=bucketOneCap; forbiddenB=0; }
   else throw new IllegalArgumentException("Invalid start bucket");
   if (desiredLiters == 0) { moves=0; finalBucket=startBucket; other=0; return; }
   ArrayDeque<int[]> q = new ArrayDeque<>();
   HashSet<Integer> visited = new HashSet<>();
   q.add(new int[]{0,0,0}); visited.add(encode(0,0));
   while (!q.isEmpty()) {
     int[] cur = q.poll(); int a=cur[0], b=cur[1], m=cur[2];
     if (a == desiredLiters) { moves=m; finalBucket="one"; other=b; return; }
     if (b == desiredLiters) { moves=m; finalBucket="two"; other=a; return; }
     // generate actions:
     // fill one: (cap1,b)
     // fill two: (a,cap2)
     // empty one: (0,b)
     // empty two: (a,0)
     // pour one to two: amount = min(a, cap2-b); (a-amount, b+amount)
     // pour two to one: amount = min(b, cap1-a); (a+amount, b-amount)
     for each next if not forbidden and not visited add with m+1.
   }
   throw new IllegalArgumentException("No solution possible");
 }
