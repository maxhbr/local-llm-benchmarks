Refactored `BuildTree` to validate records efficiently, raise the expected `ValueError` messages, and build the tree in child-id order.

tree_building.py
```
class Record:
    def __init__(self, record_id, parent_id):
        self.record_id = record_id
        self.parent_id = parent_id


class Node:
    def __init__(self, node_id):
        self.node_id = node_id
        self.children = []


def BuildTree(records):
    if not records:
        return None

    for record in records:
        if record.record_id < 0 or record.parent_id < 0:
            raise ValueError("Error: negative id")

    for record in records:
        if record.record_id != 0 and record.record_id == record.parent_id:
            raise ValueError("Error: root id must be 0")
        if record.record_id != 0 and record.parent_id > record.record_id:
            raise ValueError("Error: parent id greater than node id")

    record_ids = [record.record_id for record in records]
    if (
        len(set(record_ids)) != len(record_ids)
        or min(record_ids) != 0
        or max(record_ids) != len(record_ids) - 1
    ):
        raise ValueError("Error: non-continuous ids")

    for record in records:
        if record.record_id == 0 and record.parent_id != 0:
            raise ValueError("Error: root id must be 0")

    nodes = [None] * len(records)
    records_by_id = [None] * len(records)

    for record in records:
        nodes[record.record_id] = Node(record.record_id)
        records_by_id[record.record_id] = record

    for record_id in range(1, len(records)):
        record = records_by_id[record_id]
        nodes[record.parent_id].children.append(nodes[record_id])

    return nodes[0]
```
