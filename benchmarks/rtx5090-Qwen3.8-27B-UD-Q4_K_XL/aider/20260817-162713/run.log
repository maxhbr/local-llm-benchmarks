struct CallbackRecorder<T> {
    called: RefCell<Vec<T>>,
}

impl<T: Copy> CallbackRecorder<T> {
    fn new() -> Self {
        CallbackRecorder { called: RefCell::new(Vec::new()) }
    }

    fn callback_called(&self, value: T) {
        self.called.borrow_mut().push(value);
    }

    fn called(&self) -> Vec<T> {
        self.called.borrow().clone()
    }
}
```
