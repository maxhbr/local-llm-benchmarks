std::string clean_number(const std::string& input) {
    for (char c : input) {
        if (is_invalid_character(c)) {
            return invalid_number;
        }
    }

    std::string digits = extract_digits(input);

    if (digits.size() == 11) {
        if (digits[0] != '1') {
