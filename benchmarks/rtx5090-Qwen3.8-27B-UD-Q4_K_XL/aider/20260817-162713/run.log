killer-sudoku-helper.js
```
export const combinations = (...args) => {
  const cage = args.length === 1 && Array.isArray(args[0]) ? args[0] : args;
  const [target, size, ...excluded] = cage;

  if (!Number.isInteger(target) || !Number.isInteger(size) || target < 0 || size < 0) {
    return [];
  }

  const excludedSet = new Set(excluded.filter((digit) => Number.isInteger(digit)));
  const available = [];

  for (let digit = 1; digit <= 9; digit += 1) {
    if (!excludedSet.has(digit)) {
      available.push(digit);
    }
  }

  if (size > available.length) {
    return [];
  }

  const result = [];

  const findCombinations = (start, current, remaining, currentSum) => {
    if (remaining === 0) {
      if (currentSum === target) {
        result.push([...current]);
      }
      return;
    }

    for (let i = start; i <= available.length - remaining; i += 1) {
      const digit = available[i];
      const nextSum = currentSum + digit;

      if (nextSum > target) {
        break;
      }

      current.push(digit);
      findCombinations(i + 1, current, remaining - 1, nextSum);
      current.pop();
    }
  };

  findCombinations(0, [], size, 0);

  return result;
};
```
