/**
 * Refactoring log:
 * - Extracted locale-specific header, date, and change formatting into a
 *   `LOCALE_CONFIG` object.
 * - Extracted description truncation/padding into `formatDescription`.
 * - Replaced the duplicated `en-US` and `nl-NL` branches with shared
 *   `buildHeader` and `buildRow` helpers.
 * - Kept the exported API, entry sorting, and formatted output unchanged.
 */

class LedgerEntry {
  constructor() {
    this.date = undefined;
    this.description = undefined;
    this.change = undefined;
  }
}

const LOCALE_CONFIG = {
  'en-US': {
    headers: {
      date: 'Date',
      description: 'Description',
      change: 'Change',
    },
    formatDate(date) {
      const month = String(date.getMonth() + 1).padStart(2, '0');
      const day = String(date.getDate()).padStart(2, '0');
      return `${month}/${day}/${date.getFullYear()}`;
    },
    formatChange(change, currency) {
      if (currency !== 'USD' && currency !== 'EUR') {
        return '';
      }

      const amount = change / 100;
      const options = {
        style: 'currency',
        currency,
        minimumFractionDigits: 2,
        maximumFractionDigits: 2,
      };

      if (amount < 0) {
        return `(${Math.abs(amount).toLocaleString('en-US', options)})`;
      }

      return `${amount.toLocaleString('en-US', options)} `;
    },
  },
  'nl-NL': {
    headers: {
      date: 'Datum',
      description: 'Omschrijving',
      change: 'Verandering',
    },
    formatDate(date) {
      const day = String(date.getDate()).padStart(2, '0');
      const month = String(date.getMonth() + 1).padStart(2, '0');
      return `${day}-${month}-${date.getFullYear()}`;
    },
    formatChange(change, currency) {
      if (currency !== 'USD' && currency !== 'EUR') {
        return '';
      }

      const amount = change / 100;
      const options = {
        style: 'currency',
        currency,
        currencyDisplay: 'narrowSymbol',
        minimumFractionDigits: 2,
        maximumFractionDigits: 2,
      };

      return `${amount.toLocaleString('nl-NL', options)} `;
    },
  },
};

function formatDescription(description) {
  if (description.length > 25) {
    return `${description.substring(0, 22)}...`;
  }
  return description.padEnd(25, ' ');
}

function buildHeader(locale) {
  const { headers } = LOCALE_CONFIG[locale];
  return [
    headers.date.padEnd(10, ' '),
    headers.description.padEnd(25, ' '),
    headers.change.padEnd(13, ' '),
  ].join(' | ');
}

function buildRow(entry, currency, locale) {
  const config = LOCALE_CONFIG[locale];
  return [
    config.formatDate(entry.date),
    formatDescription(entry.description),
    config.formatChange(entry.change, currency).padStart(13, ' '),
  ].join(' | ');
}

export function createEntry(date, description, change) {
  const entry = new LedgerEntry();
  entry.date = new Date(date);
  entry.description = description;
  entry.change = change;
  return entry;
}

export function formatEntries(currency, locale, entries) {
  if (!LOCALE_CONFIG[locale]) {
    return '';
  }

  entries.sort(
    (a, b) =>
      a.date - b.date ||
      a.change - b.change ||
      a.description.localeCompare(b.description),
  );

  const lines = [buildHeader(locale)];
  entries.forEach((entry) => {
    lines.push(buildRow(entry, currency, locale));
  });

  return lines.join('\n');
}

