Implementation:
```
class Record:
    def __init__(self, record_id, parent_id):
        self.record_id = record_id
        self.parent_id = parent_id

class Node:
    def __init__(self, node_id):
        self.node_id = node_id
        self.children = []

def BuildTree(records):
    if not records:
        return None

    # Validate negative ids first
    for record in records:
        if record.record_id < 0 or record.parent_id < 0:
            raise ValueError("Error: negative id")

    # Validate self-referencing non-root? and parent greater?
    for record in records:
        if record.record_id != 0 and record.record_id == record.parent_id:
            raise ValueError("Error: root id must be 0")
        if record.record_id != 0 and record.parent_id > record.record_id:
            raise ValueError("Error: parent id greater than node id")

    # Validate root exists and ids continuous
    sorted_records = sorted(records, key=lambda r: r.record_id)
    if sorted_records[0].record_id != 0:
        raise ValueError("Error: non-continuous ids")
    for index, record in enumerate(sorted_records):
        if record.record_id != index:
            raise ValueError("Error: non-continuous ids")

    # Validate root parent
    root_record = sorted_records[0]
    if root_record.parent_id != 0:
        raise ValueError("Error: root id must be 0")

    nodes = [Node(record.record_id) for record in sorted_records]
    for record in sorted_records:
        if record.record_id == 0:
            continue
        nodes[record.parent_id].children.append(nodes[record.record_id])
    return nodes[0]
```

