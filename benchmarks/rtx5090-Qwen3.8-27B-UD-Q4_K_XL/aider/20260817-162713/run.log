class Poker {
 private final List<String> hands;
 Poker(List<String> hand) { this.hands = hand; }
 List<String> getBestHands() {
   if (hands == null || hands.isEmpty()) return new ArrayList<>();
   int[] bestScore = null;
   List<String> best = new ArrayList<>();
   for (String h : hands) {
      int[] score = score(h);
      if (bestScore == null || compare(score, bestScore) > 0) { bestScore = score; best.clear(); best.add(h); }
      else if (compare(score, bestScore) == 0) best.add(h);
   }
   return best;
 }
}

