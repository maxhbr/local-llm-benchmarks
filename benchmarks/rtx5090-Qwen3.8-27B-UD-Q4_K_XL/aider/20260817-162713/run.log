#[derive(Debug, PartialEq, Eq)]
pub enum Error {
    InvalidRowCount(usize),
    InvalidColumnCount(usize),
}

pub fn convert(input: &str) -> Result<String, Error> {
    let lines: Vec<&str> = input.lines().collect();
    let row_count = lines.len();

    if row_count % 4 != 0 {
        return Err(Error::InvalidRowCount(row_count));
    }

    if row_count == 0 {
        return Ok(String::new());
    }

    let col_count = lines
        .iter()
        .map(|line| line.chars().count())
        .max()
        .unwrap_or(0);

    if col_count % 3 != 0 {
        return Err(Error::InvalidColumnCount(col_count));
    }

    if col_count == 0 {
        return Ok(String::new());
    }

    let mut grid = Vec::with_capacity(row_count);
    for line in &lines {
        let line_cols = line.chars().count();

        if line_cols == col_count {
            grid.push(line.chars().collect());
        } else if line_cols == 0 {
            grid.push(vec![' '; col_count]);
        } else {
            return Err(Error::InvalidColumnCount(line_cols));
        }
    }

    let mut converted_lines = Vec::with_capacity(row_count / 4);
    let digit_count = col_count / 3;

    for group in grid.chunks(4) {
        let mut converted = String::new();

        for digit_index in 0..digit_count {
            let mut pattern = [String::new(); 4];

            for row_index in 0..4 {
                let start = digit_index * 3;
                pattern[row_index] = group[row_index][start..start + 3]
                    .iter()
                    .copied()
                    .collect();
            }

            let trimmed_pattern = [
                pattern[0].trim_end(),
                pattern[1].trim_end(),
                pattern[2].trim_end(),
                pattern[3].trim_end(),
            ];

            converted.push(recognize(trimmed_pattern));
        }

        converted_lines.push(converted);
    }

    Ok(converted_lines.join(","))
}

fn recognize(pattern: [&str; 4]) -> char {
    match pattern {
        [" _", "| |", "|_|", ""] => '0',
        ["", "  |", "  |", ""] => '1',
        [" _", " _|", "|_", ""] => '2',
        [" _", " _|", " _|", ""] => '3',
        ["", "|_|", "  |", ""] => '4',
        [" _", "|_", " _|", ""] => '5',
        [" _", "|_", "|_|", ""] => '6',
        [" _", "  |", "  |", ""] => '7',
        [" _", "|_|", "|_|", ""] => '8',
        [" _", "|_|", " _|", ""] => '9',
        _ => '?',
    }
}
