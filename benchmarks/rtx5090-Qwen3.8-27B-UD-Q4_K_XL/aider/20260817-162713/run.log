Let's write final code fully:

```
use anyhow::Error;
use std::io::BufRead;

#[derive(Debug)]
pub struct Flags {
    line_number: bool,
    files_with_matches: bool,
    ignore_case: bool,
    invert: bool,
    match_whole_line: bool,
}

impl Flags {
    pub fn new(flags: &[&str]) -> Self {
        let mut result = Self {
            line_number: false,
            files_with_matches: false,
            ignore_case: false,
            invert: false,
            match_whole_line: false,
        };

        for flag in flags.iter().copied() {
            for flag in flag.split_whitespace() {
                if let Some(long) = flag.strip_prefix("--") {
                    match long {
                        "line-number" => result.line_number = true,
                        "files-with-matches" => result.files_with_matches = true,
                        "ignore-case" => result.ignore_case = true,
                        "invert-match" => result.invert = true,
                        "line-regexp" => result.match_whole_line = true,
                        _ => {}
                    }
                } else if let Some(short) = flag.strip_prefix('-') {
                    for c in short.chars() {
                        match c {
                            'n' => result.line_number = true,
                            'l' => result.files_with_matches = true,
                            'i' => result.ignore_case = true,
                            'v' => result.invert = true,
                            'x' => result.match_whole_line = true,
                            _ => {}
                        }
                    }
                }
            }
        }

        result
    }
}

pub fn grep(pattern: &str, flags: &Flags, files: &[&str]) -> Result<Vec<String>, Error> {
    let mut results = Vec::new();
    let multiple_files = files.len() > 1;
    let pattern_lower = if flags.ignore_case {
        pattern.to_lowercase()
    } else {
        String::new()
    };

    for file in files.iter().copied() {
        let filename = file;
        let file = std::fs::File::open(filename).map_err(Error::from)?;
        let mut reader = std::io::BufReader::new(file);
        let mut line_bytes = Vec::new();
        let mut has_match = false;
        let mut line_number = 0;

        loop {
            line_bytes.clear();
            let bytes_read = reader
                .read_until(b'\n', &mut line_bytes)
                .map_err(Error::from)?;
            if bytes_read == 0 {
                break;
            }

            line_number += 1;

            let mut end = line_bytes.len();
            let mut stripped_newline = false;
            if end > 0 && line_bytes[end - 1] == b'\n' {
                end -= 1;
                stripped_newline = true;
            }
            if stripped_newline && end > 0 && line_bytes[end - 1] == b'\r' {
                end -= 1;
            }

            let line = String::from_utf8_lossy(&line_bytes[..end]);
            let line: &str = &line;

            let matched = if flags.match_whole_line {
                if flags.ignore_case {
                    line.to_lowercase() == pattern_lower
                } else {
                    line == pattern
                }
            } else {
                if flags.ignore_case {
                    line.to_lowercase().contains(pattern_lower.as_str())
                } else {
                    line.contains(pattern)
                }
            };

            let should_include = if flags.invert { !matched } else { matched };

            if should_include {
                has_match = true;

                if !flags.files_with_matches {
                    let mut output = String::new();
                    if multiple_files {
                        output.push_str(filename);
                        output.push(':');
                    }
                    if flags.line_number {
                        output.push_str(&line_number.to_string());
                        output.push(':');
                    }
                    output.push_str(line);
                    results.push(output);
                }
            }
        }

        if flags.files_with_matches && has_match {
            results.push(filename.to_string());
        }
    }

    Ok(results)
}
