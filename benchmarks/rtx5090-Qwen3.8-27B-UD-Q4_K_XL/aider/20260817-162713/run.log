#include "phone_number.h"

#include <cctype>
#include <string>

namespace phone_number {

namespace {

constexpr const char* invalid_number = "???";

bool is_invalid_character(char c) {
    // Letters are not allowed; other non-digit characters are treated as punctuation.
    return std::isalpha(static_cast<unsigned char>(c)) != 0;
}

std::string extract_digits(const std::string& input) {
    std::string digits;
    for (char c : input) {
        if (std::isdigit(static_cast<unsigned char>(c)) != 0) {
            digits.push_back(c);
        }
    }
    return digits;
}

}  // namespace

std::string number(const std::string& phone_number) {
    for (char c : phone_number) {
        if (is_invalid_character(c)) {
            return invalid_number;
        }
    }

    std::string digits = extract_digits(phone_number);

    if (digits.size() == 11) {
        if (digits[0] != '1') {
            return invalid_number;
        }
        digits.erase(0, 1);
    }

    if (digits.size() != 10) {
        return invalid_number;
    }

    if (digits[0] < '2' || digits[3] < '2') {
        return invalid_number;
    }

    return digits;
}

std::string area_code(const std::string& phone_number) {
    std::string cleaned = number(phone_number);
    if (cleaned == invalid_number) {
        return invalid_number;
    }
    return cleaned.substr(0, 3);
}

std::string pretty_print(const std::string& phone_number) {
    std::string cleaned = number(phone_number);
    if (cleaned == invalid_number) {
        return invalid_number;
    }
    return "(" + cleaned.substr(0, 3) + ") " + cleaned.substr(3, 3) + "-" + cleaned.substr(6);
}

}  // namespace phone_number

