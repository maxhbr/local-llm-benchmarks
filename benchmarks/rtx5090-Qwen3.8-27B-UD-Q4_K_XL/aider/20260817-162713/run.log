Header:
#if !defined(BINARY_SEARCH_TREE_H)
#define BINARY_SEARCH_TREE_H

#include <cstddef>
#include <memory>
#include <vector>

namespace binary_search_tree {

template <typename T = int>
class binary_search_tree {
public:
    binary_search_tree() = default;
    binary_search_tree(const T& value) { root_ = std::make_unique<node>(value); }

    binary_search_tree(const binary_search_tree& other) { root_ = clone(other.root_.get()); }
    binary_search_tree(binary_search_tree&& other) noexcept = default;

    binary_search_tree& operator=(const binary_search_tree& other) {
        if (this != &other) {
            root_ = clone(other.root_.get());
        }
        return *this;
    }
    binary_search_tree& operator=(binary_search_tree&& other) noexcept = default;

    ~binary_search_tree() = default;

    void add(const T& value) { insert_node(root_, value); }
    void insert(const T& value) { add(value); }

    bool contains(const T& value) const { return contains_node(root_.get(), value); }
    bool search(const T& value) const { return contains(value); }
    bool find(const T& value) const { return contains(value); }
    bool has(const T& value) const { return contains(value); }

    std::vector<T> values() const {
        std::vector<T> result;
        collect(root_.get(), result);
        return result;
    }
    std::vector<T> to_vector() const { return values(); }
    std::vector<T> sorted() const { return values(); }

    bool empty() const { return root_ == nullptr; }
    std::size_t size() const { return size_node(root_.get()); }

private:
    struct node {
        T value;
        std::unique_ptr<node> left;
        std::unique_ptr<node> right;
        explicit node(const T& v) : value(v) {}
    };

    std::unique_ptr<node> root_;

    static std::unique_ptr<node> clone(const node* source) {
        if (source == nullptr) {
            return nullptr;
        }
        auto copy = std::make_unique<node>(source->value);
        copy->left = clone(source->left.get());
        copy->right = clone(source->right.get());
        return copy;
    }

    static void insert_node(std::unique_ptr<node>& target, const T& value) {
        if (target == nullptr) {
            target = std::make_unique<node>(value);
        } else if (value <= target->value) {
            insert_node(target->left, value);
        } else {
            insert_node(target->right, value);
        }
    }

    static bool contains_node(const node* current, const T& value) {
        if (current == nullptr) {
            return false;
        }
        if (value == current->value) {
            return true;
        }
        if (value < current->value) {
            return contains_node(current->left.get(), value);
        }
        return contains_node(current->right.get(), value);
    }

    static void collect(const node* current, std::vector<T>& out) {
        if (current == nullptr) {
            return;
        }
        collect(current->left.get(), out);
        out.push_back(current->value);
        collect(current->right.get(), out);
    }

    static std::size_t size_node(const node* current) {
        if (current == nullptr) {
            return 0;
        }
        return 1 + size_node(current->left.get()) + size_node(current->right.get());
    }
};

}  // namespace binary_search_tree

#endif // BINARY_SEARCH_TREE_H

