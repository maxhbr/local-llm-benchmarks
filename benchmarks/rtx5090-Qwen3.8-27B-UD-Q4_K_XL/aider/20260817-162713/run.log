class binary_search_tree {
public:
    binary_search_tree() = default;
    explicit binary_search_tree(int value) { root_ = make_unique<node>(value); }
    void add(int value) { insert(root_, value); }
    void insert(int value) { add(value); } // But if method named insert and private insert? Need avoid overload confusion. Could public `insert` calls private `insert_node`.
