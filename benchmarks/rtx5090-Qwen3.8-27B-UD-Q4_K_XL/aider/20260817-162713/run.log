import java.util.ArrayList;
import java.util.Arrays;
import java.util.Collections;
import java.util.List;

class ChangeCalculator {

    private final List<Integer> coins;

    ChangeCalculator(List<Integer> currencyCoins) {
        List<Integer> normalized = new ArrayList<>();

        if (currencyCoins != null) {
            for (Integer coin : currencyCoins) {
                if (coin != null && coin > 0) {
                    normalized.add(coin);
                }
            }
        }

        Collections.sort(normalized);

        List<Integer> unique = new ArrayList<>();
        for (int coin : normalized) {
            if (unique.isEmpty() || !unique.get(unique.size() - 1).equals(coin)) {
                unique.add(coin);
            }
        }

        this.coins = unique;
    }

    List<Integer> computeMostEfficientChange(int grandTotal) {
        if (grandTotal < 0) {
            throw new IllegalArgumentException("Negative totals are not allowed.");
        }

        if (grandTotal == 0) {
            return new ArrayList<>();
        }

        if (coins.isEmpty()) {
            throw new IllegalArgumentException("The total " + grandTotal + " cannot be represented in the given currency.");
        }

        int[] minCoins = new int[grandTotal + 1];
        int[] lastCoin = new int[grandTotal + 1];

        int inf = Integer.MAX_VALUE / 2;
        Arrays.fill(minCoins, inf);
        minCoins[0] = 0;

        for (int amount = 1; amount <= grandTotal; amount++) {
            int best = inf;
            int bestCoin = 0;

            for (int coin : coins) {
                if (coin > amount) {
                    break;
                }

                int previous = minCoins[amount - coin];
                if (previous != inf && previous + 1 < best) {
                    best = previous + 1;
                    bestCoin = coin;
                }
            }

            if (bestCoin != 0) {
                minCoins[amount] = best;
                lastCoin[amount] = bestCoin;
            }
        }

        if (minCoins[grandTotal] == inf) {
            throw new IllegalArgumentException("The total " + grandTotal + " cannot be represented in the given currency.");
        }

        List<Integer> result = new ArrayList<>(minCoins[grandTotal]);
        int amount = grandTotal;

        while (amount > 0) {
            int coin = lastCoin[amount];
            result.add(coin);
            amount -= coin;
        }

        Collections.sort(result);
        return result;
    }
}

