pub fn grep(pattern: &str, flags: &Flags, files: &[&str]) -> Result<Vec<String>, Error> {
    let mut results = Vec::new();
    let multiple_files = files.len() > 1;
    let pattern_lower = pattern.to_lowercase();
    for file in files {
        let file = std::fs::File::open(file).map_err(anyhow::Error::from)?;
        let reader = std::io::BufReader::new(file);
        let mut has_match = false;
        for (idx, line_result) in reader.lines().enumerate() {
            let line = line_result.map_err(anyhow::Error::from)?;
            let matched = if flags.match_whole_line {
                if flags.ignore_case { line.to_lowercase() == pattern_lower } else { line == pattern }
            } else {
                if flags.ignore_case { line.to_lowercase().contains(&pattern_lower) } else { line.contains(pattern) }
            };
            let include = if flags.invert { !matched } else { matched };
            if include {
                has_match = true;
                if flags.files_with_matches {
                    // push file name once? Need avoid multiple. Could if !has_match before push? But has_match set true. Use if !has_match { results.push(file.to_string()); } but has_match already true. Need track before.
                } else {
                    let mut out = String::new();
                    if multiple_files { out.push_str(file); out.push(':'); }
                    if flags.line_number { out.push_str(&idx.to_string()); out.push(':'); }
                    out.push_str(&line);
                    results.push(out);
                }
            }
        }
        if flags.files_with_matches && has_match { results.push(file.to_string()); }
    }
    Ok(results)
}
```
