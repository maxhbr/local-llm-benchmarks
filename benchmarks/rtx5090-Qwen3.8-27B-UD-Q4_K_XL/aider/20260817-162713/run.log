#[derive(Debug)]
pub struct Flags {
    line_number: bool,
    files_with_matches: bool,
    ignore_case: bool,
    invert: bool,
    match_whole_line: bool,
}

impl Flags {
    pub fn new(flags: &[&str]) -> Self {
        let mut f = Self { false... };
        for flag in flags {
            let flag = flag.trim_start_matches('-');
            for c in flag.chars() {
                match c {
                    'n' => f.line_number = true,
                    'l' => f.files_with_matches = true,
                    'i' => f.ignore_case = true,
                    'v' => f.invert = true,
                    'x' => f.match_whole_line = true,
                    _ => {}
                }
            }
        }
        f
    }
}
```
