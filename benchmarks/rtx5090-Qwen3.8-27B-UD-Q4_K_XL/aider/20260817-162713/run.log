import java.math.BigInteger;
import java.util.ArrayList;
import java.util.Collections;

class BaseConverter {
    private final BigInteger value;

    BaseConverter(int originalBase, int[] originalDigits) {
        if (originalBase < 2) throw new IllegalArgumentException("Base must be >= 2");
        BigInteger val = BigInteger.ZERO;
        if (originalDigits != null) {
            BigInteger base = BigInteger.valueOf(originalBase);
            for (int digit : originalDigits) {
                if (digit < 0 || digit >= originalBase) throw new IllegalArgumentException("Invalid digit");
                val = val.multiply(base).add(BigInteger.valueOf(digit));
            }
        }
        this.value = val;
    }

    int[] convertToBase(int newBase) {
        if (newBase < 2) throw new IllegalArgumentException("Base must be >= 2");
        if (value.signum() == 0) return new int[]{0};
        BigInteger base = BigInteger.valueOf(newBase);
        ArrayList<Integer> digits = new ArrayList<>();
        BigInteger current = value;
        while (current.signum() > 0) {
            BigInteger[] qr = current.divideAndRemainder(base);
            digits.add(qr[1].intValue());
            current = qr[0];
        }
        Collections.reverse(digits);
        int[] result = new int[digits.size()];
        for (int i=0; i<result.length; i++) result[i]=digits.get(i);
        return result;
    }
}

