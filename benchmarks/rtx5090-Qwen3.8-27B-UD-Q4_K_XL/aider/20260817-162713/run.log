fn propagate(&mut self) {
    let mut changed = vec![false; self.computes.len()];
    for i in 0..self.computes.len() {
        let old_value = self.computes[i].value;
        let new_value = {
            let values: Vec<T> = self.computes[i]
                .dependencies
                .iter()
                .map(|dependency| self.value(*dependency).unwrap())
                .collect();
            (self.computes[i].compute)(&values)
        };
        if new_value != old_value {
            self.computes[i].value = new_value;
            changed[i] = true;
        }
    }
    for i in 0..self.computes.len() {
        if changed[i] {
            let value = self.computes[i].value;
            for callback in self.computes[i].callbacks.iter_mut() {
                if let Some(callback) = callback.as_mut() {
                    callback(value);
                }
            }
        }
    }
}
```
