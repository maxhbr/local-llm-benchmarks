def proverb(*items, qualifier=None):
    if not items:
        return []

    lines = [
        f"For want of a {current} the {next_item} was lost."
        for current, next_item in zip(items, items[1:])
    ]

    if qualifier:
        lines.append(f"And all for the want of a {qualifier} {items[0]}.")
    else:
        lines.append(f"And all for the want of a {items[0]}.")

    return lines
```
