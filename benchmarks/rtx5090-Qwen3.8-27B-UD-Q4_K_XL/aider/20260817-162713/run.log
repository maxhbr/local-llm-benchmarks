generate_unique_name:
fn generate_unique_name(used: &mut HashSet<String>) -> String {
    let mut attempts = 0;
    loop {
        let name = random_name();
        attempts += 1;
        if !used.contains(&name) {
            used.insert(name.clone());
            return name;
        }
        if attempts >= 1024 {
            // fallback exhaustive
            for index in 0..(26 * 26 * 1000) {
                let first = index / (26 * 1000);
                let second = (index / 1000) % 26;
                let number = index % 1000;
                let name = format!(
                    "{}{}{:03}",
                    (b'A' + first as u8) as char,
                    (b'A' + second as u8) as char,
                    number
                );
                if !used.contains(&name) {
                    used.insert(name.clone());
                    return name;
                }
            }
            panic!("No unique robot name available");
        }
    }
}

