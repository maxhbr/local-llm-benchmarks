export const combinations = (cage) => {
  const [target, size, ...excluded] = cage;
  const excludedSet = new Set(excluded);
  const digits = [];
  for (let d = 1; d <= 9; d += 1) {
    if (!excludedSet.has(d)) digits.push(d);
  }

  const results = [];

  const backtrack = (start, current, remaining, sum) => {
    if (remaining === 0) {
      if (sum === target) results.push([...current]);
      return;
    }

    // Need choose enough digits from start to digits.length
    for (let i = start; i <= digits.length - remaining; i += 1) {
      const digit = digits[i];
      // pruning: if sum + digit > target? Since digits positive, but if target maybe small. Could prune if sum + digit > target, but later digits larger, break.
      if (sum + digit > target) break;
      // Also minimum possible sum of remaining-1 smallest available after i? Could prune but not necessary.
      current.push(digit);
      backtrack(i + 1, current, remaining - 1, sum + digit);
      current.pop();
    }
  };

  if (size >= 0 && size <= digits.length) {
    backtrack(0, [], size, 0);
  }

  return results;
};
```
