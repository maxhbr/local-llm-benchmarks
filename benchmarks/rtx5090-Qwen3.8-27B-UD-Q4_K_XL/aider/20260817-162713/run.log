```
use anyhow::Error;

#[derive(Debug)]
pub struct Flags {
    line_number: bool,
    files_with_matches: bool,
    ignore_case: bool,
    invert: bool,
    match_whole_line: bool,
}

impl Flags {
    pub fn new(flags: &[&str]) -> Self {
        let mut flags = Self {
            line_number: false,
            files_with_matches: false,
            ignore_case: false,
            invert: false,
            match_whole_line: false,
        };

        for flag in flags {
            if let Some(rest) = flag.strip_prefix('-') {
                for c in rest.chars() {
                    match c {
                        'n' => flags.line_number = true,
                        'l' => flags.files_with_matches = true,
                        'i' => flags.ignore_case = true,
                        'v' => flags.invert = true,
                        'x' => flags.match_whole_line = true,
                        _ => {}
                    }
                }
            }
        }

        flags
    }
}

pub fn grep(pattern: &str, flags: &Flags, files: &[&str]) -> Result<Vec<String>, Error> {
    let mut results = Vec::new();
    let multiple_files = files.len() > 1;
    let pattern_lower = pattern.to_lowercase();

    for file in files {
        let file = std::fs::File::open(file).map_err(Error::from)?;
        let reader = std::io::BufReader::new(file);
        let mut has_match = false;

        for (line_number, line) in reader.lines().enumerate() {
            let line = line.map_err(Error::from)?;
            let matched = if flags.match_whole_line {
                if flags.ignore_case {
                    line.to_lowercase() == pattern_lower
                } else {
                    line == pattern
                }
            } else {
                if flags.ignore_case {
                    line.to_lowercase().contains(&pattern_lower)
                } else {
                    line.contains(pattern)
                }
            };

            let should_include = if flags.invert { !matched } else { matched };

            if should_include {
                has_match = true;

                if flags.files_with_matches {
                    // handled after file to avoid duplicates
                } else {
                    let mut output = String::new();
                    if multiple_files {
                        output.push_str(file);
                        output.push(':');
                    }
                    if flags.line_number {
                        output.push_str(&line_number.to_string());
                        output.push(':');
                    }
                    output.push_str(&line);
                    results.push(output);
                }
            }
        }

        if flags.files_with_matches && has_match {
            results.push(file.to_string());
        }
    }

    Ok(results)
}
```
