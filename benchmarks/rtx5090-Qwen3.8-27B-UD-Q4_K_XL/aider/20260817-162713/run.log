    std::vector<int> values() const { std::vector<int> result; collect(root_.get(), result); return result; }
private:
    struct node { int value; std::unique_ptr<node> left; std::unique_ptr<node> right; explicit node(int v): value(v) {} };
    std::unique_ptr<node> root_;
    static void insert_node(std::unique_ptr<node>& node, int value) { if (!node) node = std::make_unique<node>(value); else if (value <= node->value) insert_node(node->left, value); else insert_node(node->right, value); }
    static bool contains_node(const node* node, int value) { if (!node) return false; if (value == node->value) return true; if (value < node->value) return contains_node(node->left.get(), value); else return contains_node(node->right.get(), value); }
    static void collect(const node* node, std::vector<int>& out) { if (!node) return; collect(node->left.get(), out); out.push_back(node->value); collect(node->right.get(), out); }
};

