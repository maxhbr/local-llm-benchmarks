```
package markdown

import (
    "fmt"
    "strings"
)

// Render translates markdown to HTML.
//
// Refactoring notes:
// - The emphasis substitutions are isolated in applyEmphasis.
// - The original single-pass state machine is kept, but each transition is
//   isolated in a method on renderer.
// - Constant properties of the input (newline/star positions) are computed
//   once instead of repeatedly inside the loop.
func Render(markdown string) string {
    markdown = applyEmphasis(markdown)
    r := newRenderer(markdown)

    for r.pos < len(r.input) {
        if r.handleHeader() {
            continue
        }

        // The original code sets he here for every non-# character, including
        // list markers and newlines.
        r.nonHeaderSeen = true

        if r.handleList() {
            continue
        }
        if r.handleNewline() {
            continue
        }

        r.html.WriteByte(r.input[r.pos])
        r.pos++
    }

    return r.finish()
}

type renderer struct {
    input string
    pos   int

    header int
    list   int
    listOpened bool

    // nonHeaderSeen corresponds to the original he flag.
    nonHeaderSeen bool

    hasNewline  bool
    lastNewline int
    lastStar    int

    html strings.Builder
}

func newRenderer(markdown string) *renderer {
    return &renderer{
        input:       markdown,
        hasNewline:  strings.Contains(markdown, "\n"),
        lastNewline: strings.LastIndex(markdown, "\n"),
        lastStar:    strings.LastIndex(markdown, "*"),
    }
}

func (r *renderer) handleHeader() bool {
    if r.input[r.pos] != '#' {
        return false
    }

    for r.pos < len(r.input) && r.input[r.pos] == '#' {
        r.header++
        r.pos++
    }

    switch {
    case r.header == 7:
        r.html.WriteString("<p>" + strings.Repeat("#", r.header) + " ")
    case r.nonHeaderSeen:
        r.html.WriteString("# ")
        r.header--
    default:
        fmt.Fprintf(&r.html, "<h%d>", r.header)
    }

    // The original code skips the character after the hash run (normally a
    // space). The bounds check only prevents panics on malformed input.
    if r.pos < len(r.input) {
        r.pos++
    }

    return true
}

func (r *renderer) handleList() bool {
    if r.input[r.pos] != '*' || r.header != 0 || !r.hasNewline {
        return false
    }

    if r.list == 0 {
        r.html.WriteString("<ul>")
    }
    r.list++

    if !r.listOpened {
        r.html.WriteString("<li>")
        r.listOpened = true
    } else {
        r.html.WriteString("* ")
    }

    // The original code skips the marker and the following character.
    r.pos += 2
    if r.pos > len(r.input) {
        r.pos = len(r.input)
    }

    return true
}

func (r *renderer) handleNewline() bool {
    if r.input[r.pos] != '\n' {
        return false
    }

    if r.listOpened && r.pos == r.lastNewline && r.lastNewline > r.lastStar {
        r.html.WriteString("</li></ul><p>")
        r.listOpened = false
        r.list = 0
    }

    if r.list > 0 && r.listOpened {
        r.html.WriteString("</li>")
        r.listOpened = false
    }

    if r.header > 0 {
        fmt.Fprintf(&r.html, "</h%d>", r.header)
        r.header = 0
    }

    r.pos++
    return true
}

func (r *renderer) finish() string {
    html := r.html.String()

    switch {
    case r.header == 7:
        return html + "</p>"
    case r.header > 0:
        return html + fmt.Sprintf("</h%d>", r.header)
    }

    if r.list > 0 {
        return html + "</li></ul>"
    }

    if strings.Contains(html, "<p>") {
        return html + "</p>"
    }

    return "<p>" + html + "</p>"
}

func applyEmphasis(markdown string) string {
    markdown = strings.Replace(markdown, "__", "<strong>", 1)
    markdown = strings.Replace(markdown, "__", "</strong>", 1)
    markdown = strings.Replace(markdown, "_", "<em>", 1)
    markdown = strings.Replace(markdown, "_", "</em>", 1)
    return markdown
}
```

