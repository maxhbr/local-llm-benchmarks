```
#if !defined(ALLERGIES_H)
#define ALLERGIES_H

#include <string>
#include <unordered_set>

namespace allergies {

class AllergyTest {
public:
    AllergyTest(int score);

    bool allergic_to(const std::string& allergen) const;
    std::unordered_set<std::string> allergies() const;

private:
    unsigned int score_;
};

class allergy_test : public AllergyTest {
public:
    allergy_test(int score) : AllergyTest(score) {}

    bool is_allergic_to(const std::string& allergen) const {
        return allergic_to(allergen);
    }

    std::unordered_set<std::string> get_allergies() const {
        return allergies();
    }
};

}  // namespace allergies

#endif // ALLERGIES_H
```

allergies.cpp
```
#include "allergies.h"

#include <array>
#include <string>
#include <unordered_set>
#include <utility>

namespace allergies {

namespace {

const std::array<std::pair<std::string, unsigned int>, 8> kAllergens = {{
    {"eggs", 1u},
    {"peanuts", 2u},
    {"shellfish", 4u},
    {"strawberries", 8u},
    {"tomatoes", 16u},
    {"chocolate", 32u},
    {"pollen", 64u},
    {"cats", 128u},
}};

}  // namespace

AllergyTest::AllergyTest(int score)
    : score_(static_cast<unsigned int>(score) & 0xFFu) {}

bool AllergyTest::allergic_to(const std::string& allergen) const {
    for (const auto& item : kAllergens) {
        if (item.first == allergen) {
            return (score_ & item.second) != 0u;
        }
    }

    return false;
}

std::unordered_set<std::string> AllergyTest::allergies() const {
    std::unordered_set<std::string> result;

    for (const auto& item : kAllergens) {
        if ((score_ & item.second) != 0u) {
            result.emplace(item.first);
        }
    }

    return result;
}

}  // namespace allergies
```
