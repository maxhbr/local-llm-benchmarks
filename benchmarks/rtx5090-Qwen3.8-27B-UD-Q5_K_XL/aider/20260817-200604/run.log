def grep(pattern, flags, files):
    if flags is None:
        flags = ''
    if isinstance(flags, str):
        flag_set = set()
        for token in flags.split():
            if token.startswith('-'):
                # support -abc
                if len(token) > 2:
                    flag_set.update(token[1:])
                else:
                    flag_set.add(token[1:])
            else:
                # maybe flags as list? no
                pass
    else:
        flag_set = set(flags)
        # if elements like '-n', strip
        normalized = set()
        for f in flag_set:
            if isinstance(f, str) and f.startswith('-'):
                if len(f) > 2: normalized.update(f[1:])
                else: normalized.add(f[1:])
            else: normalized.add(f)
        flag_set = normalized
    n = 'n' in flag_set
    l = 'l' in flag_set
    i = 'i' in flag_set
    v = 'v' in flag_set
    x = 'x' in flag_set
