```
const ALPHABET_SIZE = 26;

const gcd = (x, y) => {
  x = Math.abs(x);
  y = Math.abs(y);

  while (y !== 0) {
    const remainder = x % y;
    x = y;
    y = remainder;
  }

  return x;
};

const mod = (value, modulus) => {
  return ((value % modulus) + modulus) % modulus;
};

const normalizeKey = (key, b) => {
  if (key !== null && typeof key === 'object') {
    if (Array.isArray(key)) {
      return [key[0], key[1] !== undefined ? key[1] : b];
    }

    return [key.a, key.b !== undefined ? key.b : b];
  }

  return [key, b];
};

const validateKey = (a, b) => {
  if (!Number.isInteger(a) || !Number.isInteger(b) || gcd(a, ALPHABET_SIZE) !== 1) {
    throw new Error('a and m must be coprime.');
  }
};

const modularInverse = (a) => {
  const aMod = mod(a, ALPHABET_SIZE);

  for (let x = 1; x < ALPHABET_SIZE; x += 1) {
    if ((aMod * x) % ALPHABET_SIZE === 1) {
      return x;
    }
  }

  return null;
};

const groupInFives = (text) => {
  const groups = [];

  for (let i = 0; i < text.length; i += 5) {
    groups.push(text.slice(i, i + 5));
  }

  return groups.join(' ');
};

const toLowerString = (value) => {
  return value == null ? '' : String(value).toLowerCase();
};

export const encode = (phrase, key, b) => {
  const [a, bValue] = normalizeKey(key, b);
  validateKey(a, bValue);

  const aMod = mod(a, ALPHABET_SIZE);
  const bMod = mod(bValue, ALPHABET_SIZE);
  let result = '';

  for (const char of toLowerString(phrase)) {
    const code = char.charCodeAt(0);

    if (code >= 48 && code <= 57) {
      result += char;
    } else if (code >= 97 && code <= 122) {
      const index = code - 97;
      const encrypted = mod(aMod * index + bMod, ALPHABET_SIZE);
      result += String.fromCharCode(97 + encrypted);
    }
  }

  return groupInFives(result);
};

export const decode = (phrase, key, b) => {
  const [a, bValue] = normalizeKey(key, b);
  validateKey(a, bValue);

  const inverseA = modularInverse(a);
  const bMod = mod(bValue, ALPHABET_SIZE);
  let result = '';

  for (const char of toLowerString(phrase)) {
    const code = char.charCodeAt(0);

    if (code >= 48 && code <= 57) {
      result += char;
    } else if (code >= 97 && code <= 122) {
      const index = code - 97;
      const decrypted = mod(inverseA * mod(index - bMod, ALPHABET_SIZE), ALPHABET_SIZE);
      result += String.fromCharCode(97 + decrypted);
    }
  }

  return result;
};
