export class GradeSchool {
  constructor() {
    this.students = {};
  }

  roster() {
    return Object.keys(this.students)
      .sort((a, b) => a - b)
      .reduce((acc, grade) => {
        acc[grade] = this.students[grade].slice().sort();
        return acc;
      }, {});
  }

  add(name, grade) {
    if (Object.values(this.students).some(students => students.includes(name))) {
      return false;
    }
    if (!this.students[grade]) this.students[grade] = [];
    this.students[grade].push(name);
    return true;
  }

  grade(n) {
    return (this.students[n] || []).slice().sort();
  }
}

