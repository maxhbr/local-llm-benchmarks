```
use std::collections::HashMap;

pub fn solve(input: &str) -> Option<HashMap<char, u8>> {
    let (addends, result) = parse(input)?;
    let mut letters: Vec<char> = Vec::new();
    let mut index: HashMap<char, usize> = HashMap::new();
    for word in addends.iter().chain(result.iter()) {
        for &c in word {
            if !index.contains_key(&c) {
                index.insert(c, letters.len());
                letters.push(c);
            }
        }
    }
    if letters.len() > 10 {
        return None;
    }
    let mut leading = vec![false; letters.len()];
    for word in addends.iter().chain(result.iter()) {
        if word.len() > 1 {
            let idx = index[&word[0]];
            leading[idx] = true;
        }
    }
    let add_idx: Vec<Vec<usize>> = addends
        .iter()
        .map(|w| w.iter().map(|&c| index[&c]).collect())
        .collect();
    let res_idx: Vec<usize> = result.iter().map(|&c| index[&c]).collect();
    let max_len = add_idx.iter().map(|w| w.len()).max().unwrap_or(0).max(res_idx.len());
    let mut assignment: Vec<Option<u8>> = vec![None; letters.len()];
    let mut used = [false; 10];
    backtrack(
        0,
        0,
        &add_idx,
        &res_idx,
        &mut assignment,
        &mut used,
        &leading,
        &letters,
        max_len,
    )
}

fn parse(input: &str) -> Option<(Vec<Vec<char>>, Vec<char>)> {
    let (left, right) = if let Some(pos) = input.find("==") {
        (&input[..pos], &input[pos + 2..])
    } else if let Some(pos) = input.find('=') {
        (&input[..pos], &input[pos + 1..])
    } else {
        return None;
    };
    let result: Vec<char> = right.trim().chars().collect();
    if result.is_empty() {
        return None;
    }
    let mut addends = Vec::new();
    for term in left.split('+') {
        let word: Vec<char> = term.trim().chars().collect();
        if word.is_empty() {
            return None;
        }
        addends.push(word);
    }
    if addends.is_empty() {
        return None;
    }
    Some((addends, result))
}

fn backtrack(
    col: usize,
    carry: i64,
    addends: &[Vec<usize>],
    result: &[usize],
    assignment: &mut Vec<Option<u8>>,
    used: &mut [bool; 10],
    leading: &[bool],
    letters: &[char],
    max_len: usize,
) -> Option<HashMap<char, u8>> {
    if col == max_len {
        if carry != 0 {
            return None;
        }
        let mut map = HashMap::new();
        for (i, &c) in letters.iter().enumerate() {
            let d = assignment[i]?;
            map.insert(c, d);
        }
        return Some(map);
    }

    let mut add_chars: Vec<usize> = Vec::new();
    for word in addends.iter() {
        if col < word.len() {
            add_chars.push(word[word.len() - 1 - col]);
        }
    }
    let res = if col < result.len() {
        Some(result[result.len() - 1 - col])
    } else {
        None
    };

    let mut unassigned: Vec<usize> = Vec::new();
    let mut seen = [false; 10]; // letters.len() <= 10
    for &idx in &add_chars {
        if assignment[idx].is_none() && !seen[idx] {
            seen[idx] = true;
            unassigned.push(idx);
        }
    }

    assign_unassigned(
        0,
        &unassigned,
        carry,
        &add_chars,
        res,
        col,
        addends,
        result,
        assignment,
        used,
        leading,
        letters,
        max_len,
    )
}

fn assign_unassigned(
    pos: usize,
    unassigned: &[usize],
    carry: i64,
    add_chars: &[usize],
    res: Option<usize>,
    col: usize,
    addends: &[Vec<usize>],
    result: &[usize],
    assignment: &mut Vec<Option<u8>>,
    used: &mut [bool; 10],
    leading: &[bool],
    letters: &[char],
    max_len: usize,
) -> Option<HashMap<char, u8>> {
    if pos == unassigned.len() {
        let mut sum = carry;
        for &idx in add_chars {
            sum += assignment[idx].unwrap() as i64;
        }
        let unit = (sum % 10) as u8;
        let next_carry = sum / 10;

        if let Some(r) = res {
            match assignment[r] {
                Some(d) => {
                    if d != unit {
                        return None;
                    }
                }
                None => {
                    if used[unit] {
                        return None;
                    }
                    if leading[r] && unit == 0 {
                        return None;
                    }
                    assignment[r] = Some(unit);
                    used[unit] = true;
                    if let Some(solution) = backtrack(
                        col + 1,
                        next_carry,
                        addends,
                        result,
                        assignment,
                        used,
                        leading,
                        letters,
                        max_len,
                    ) {
                        return Some(solution);
                    }
                    assignment[r] = None;
                    used[unit] = false;
                    return None;
                }
            }
        } else {
            if unit != 0 {
                return None;
            }
        }

        backtrack(
            col + 1,
            next_carry,
            addends,
            result,
            assignment,
            used,
            leading,
            letters,
            max_len,
        )
    } else {
        let idx = unassigned[pos];
        for digit in 0..10u8 {
            if !used[digit] && !(leading[idx] && digit == 0) {
                assignment[idx] = Some(digit);
                used[digit] = true;
                if let Some(solution) = assign_unassigned(
                    pos + 1,
                    unassigned,
                    carry,
                    add_chars,
                    res,
                    col,
                    addends,
                    result,
                    assignment,
                    used,
                    leading,
                    letters,
                    max_len,
                ) {
                    return Some(solution);
                }
                assignment[idx] = None;
                used[digit] = false;
            }
        }
        None
    }
}
