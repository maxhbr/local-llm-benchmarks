Let's search memory of solutions. Many simple solutions:
```
export const gamestate = (board) => {
  const x = board.join('').split('X').length - 1;
  const o = board.join('').split('O').length - 1;
  if (o > x || x > o + 1) throw new Error('X started game');
  const xWin = checkWin(board, 'X');
  const oWin = checkWin(board, 'O');
  if (xWin && oWin) throw new Error('Player X cannot win after O has won');
  if (xWin || oWin) return 'win';
  if (x + o === 9) return 'draw';
  return 'ongoing';
};
```
