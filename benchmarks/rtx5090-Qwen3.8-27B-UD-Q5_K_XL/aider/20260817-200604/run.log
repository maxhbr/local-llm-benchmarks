One common algorithm:
```
const prices = [0, 800, 1520, 2160, 2560, 3000];
export const cost = (books) => {
  const counts = [0,0,0,0,0];
  books.forEach(b => counts[b-1]++);
  counts.sort((a,b)=>b-a);
  let total = 0;
  while (counts[0] > 0) {
    const group = counts.filter(c => c > 0).length;
    total += prices[group];
    for (let i=0; i<group; i++) counts[i]--;
  }
  return total;
}
```
