import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;

class KindergartenGarden {

    private static final List<String> STUDENTS = Arrays.asList(
        "Alice", "Bob", "Charlie", "David", "Eve", "Fred",
        "Ginny", "Harriet", "Ileana", "Joseph", "Kincaid", "Larry"
    );

    private final String[] rows;

    KindergartenGarden(String garden) {
        String[] parts = garden.trim().split("\\R");

        if (parts.length < 2) {
            String line = parts.length == 1 ? parts[0] : "";
            int half = line.length() / 2;
            rows = new String[] {
                line.substring(0, half),
                line.substring(half)
            };
        } else {
            rows = new String[] {
                parts[0],
                parts[1]
            };
        }
    }

    List<Plant> getPlantsOfStudent(String student) {
        int studentIndex = STUDENTS.indexOf(student);

        if (studentIndex == -1) {
            throw new IllegalArgumentException("No student called " + student);
        }

        int left = studentIndex * 2;
        int right = left + 1;

        List<Plant> plants = new ArrayList<>(4);
        plants.add(plantFromChar(rows[0].charAt(left)));
        plants.add(plantFromChar(rows[0].charAt(right)));
        plants.add(plantFromChar(rows[1].charAt(left)));
        plants.add(plantFromChar(rows[1].charAt(right)));

        return plants;
    }

    private Plant plantFromChar(char c) {
        c = Character.toUpperCase(c);

        for (Plant plant : Plant.values()) {
            String name = plant.name().toUpperCase();

            if (matches(c, name)) {
                return plant;
            }
        }

        throw new IllegalArgumentException("Not a valid plant: " + c);
    }

    private boolean matches(char c, String name) {
        switch (c) {
            case 'G':
                return name.contains("GRASS") || name.equals("G");
            case 'C':
                return name.contains("CLOVER") || name.equals("C");
            case 'R':
                return name.contains("RADISH") || name.equals("R");
            case 'V':
                return name.contains("VIOLET") || name.equals("V");
            default:
                return false;
        }
    }
}
