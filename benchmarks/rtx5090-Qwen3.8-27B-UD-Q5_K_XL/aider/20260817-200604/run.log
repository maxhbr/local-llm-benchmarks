import static java.util.Collections.unmodifiableList;

import java.math.BigDecimal;
import java.math.RoundingMode;
import java.util.ArrayList;
import java.util.List;

public class User {
    private final String name;
    private final List<Iou> owes;
    private final List<Iou> owedBy;

    private User(String name, List<Iou> owes, List<Iou> owedBy) {
        this.name = name;
        this.owes = new ArrayList<>(owes);
        this.owedBy = new ArrayList<>(owedBy);
    }

    public String name() { return name; }

    public List<Iou> owes() { return unmodifiableList(owes); }
    public List<Iou> owedBy() { return unmodifiableList(owedBy); }

    public void owes(String name, double amount) { addOrUpdate(owes, name, amount); }
    public void owedBy(String name, double amount) { addOrUpdate(owedBy, name, amount); }

    public double getOwes(String name) { return getIou(owes, name); }
    public double getOwedBy(String name) { return getIou(owedBy, name); }
    public void setOwes(String name, double amount) { setIou(owes, name, amount); }
    public void setOwedBy(String name, double amount) { setIou(owedBy, name, amount); }

    public double balance() {
        double totalOwedBy = 0.0;
        for (Iou iou : owedBy) totalOwedBy += iou.amount();
        double totalOwes = 0.0;
        for (Iou iou : owes) totalOwes += iou.amount();
        return normalize(totalOwedBy - totalOwes);
    }

    private static double getIou(List<Iou> list, String name) {
        for (Iou iou : list) {
            if (iou.name().equals(name)) {
                return normalize(iou.amount());
            }
        }
        return 0.0;
    }

    private static void setIou(List<Iou> list, String name, double amount) {
        amount = normalize(amount);
        if (amount <= 0.0) {
            removeIou(list, name);
            return;
        }
        for (int i = 0; i < list.size(); i++) {
            Iou iou = list.get(i);
            if (iou.name().equals(name)) {
                list.set(i, new Iou(name, amount));
                return;
            }
        }
        list.add(new Iou(name, amount));
    }

    private static void removeIou(List<Iou> list, String name) {
        for (int i = 0; i < list.size(); i++) {
            if (list.get(i).name().equals(name)) {
                list.remove(i);
                return;
            }
        }
    }

    private static void addOrUpdate(List<Iou> list, String name, double amount) {
        amount = normalize(amount);
        if (amount == 0.0) {
            return;
        }

        for (int i = 0; i < list.size(); i++) {
            Iou iou = list.get(i);
            if (iou.name().equals(name)) {
                double updated = normalize(iou.amount() + amount);
                if (updated <= 0.0) {
                    list.remove(i);
                } else {
                    list.set(i, new Iou(name, updated));
                }
                return;
            }
        }

        if (amount > 0.0) {
            list.add(new Iou(name, amount));
        }
    }

    private static double normalize(double value) {
        if (value == 0.0 || Double.isNaN(value) || Double.isInfinite(value)) {
            return 0.0;
        }
        BigDecimal bd = BigDecimal.valueOf(value).setScale(15, RoundingMode.HALF_UP);
        double result = bd.doubleValue();
        return result == 0.0 ? 0.0 : result;
    }

    public static Builder builder() { return new Builder(); }

    public static class Builder {
        private String name;
        private final List<Iou> owes = new ArrayList<>();
        private final List<Iou> owedBy = new ArrayList<>();

        public Builder setName(String name) { this.name = name; return this; }

        public Builder owes(String name, double amount) {
            addOrUpdate(owes, name, amount);
            return this;
        }

        public Builder owedBy(String name, double amount) {
            addOrUpdate(owedBy, name, amount);
            return this;
        }

        public User build() { return new User(name, owes, owedBy); }
    }
}
