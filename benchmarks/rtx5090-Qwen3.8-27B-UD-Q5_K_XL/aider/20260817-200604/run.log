export class QueenAttack {
  constructor({ black, white } = {}) {
    const blackPosition = black == null ? [0, 3] : black;
    const whitePosition = white == null ? [7, 3] : white;

    const [blackRow, blackColumn] = blackPosition;
    const [whiteRow, whiteColumn] = whitePosition;

    const isValidPosition = (row, column) =>
      Number.isInteger(row) &&
      Number.isInteger(column) &&
      row >= 0 &&
      row < 8 &&
      column >= 0 &&
      column < 8;

    if (!isValidPosition(blackRow, blackColumn) || !isValidPosition(whiteRow, whiteColumn)) {
      throw new Error('Invalid queen position');
    }

    if (blackRow === whiteRow && blackColumn === whiteColumn) {
      throw new Error('Queens share the same location');
    }

    this.black = [blackRow, blackColumn];
    this.white = [whiteRow, whiteColumn];
  }

  toString() {
    const rows = [];

    for (let row = 0; row < 8; row += 1) {
      const columns = [];
      for (let column = 0; column < 8; column += 1) {
        if (row === this.black[0] && column === this.black[1]) {
          columns.push('B');
        } else if (row === this.white[0] && column === this.white[1]) {
          columns.push('W');
        } else {
          columns.push('_');
        }
      }
      rows.push(columns.join(' '));
    }

    return rows.join('\n');
  }

  get canAttack() {
    const [blackRow, blackColumn] = this.black;
    const [whiteRow, whiteColumn] = this.white;

    return (
      blackRow === whiteRow ||
      blackColumn === whiteColumn ||
      Math.abs(blackRow - whiteRow) === Math.abs(blackColumn - whiteColumn)
    );
  }
}
```

