def grep(pattern, flags, files):
    if isinstance(files, str):
        files = [files]

    flag_chars = _parse_flags(flags)
    show_line_numbers = "n" in flag_chars
    show_file_names = "l" in flag_chars
    ignore_case = "i" in flag_chars
    invert = "v" in flag_chars
    whole_line = "x" in flag_chars

    multiple_files = len(files) > 1
    output_lines = []

    for file_name in files:
        file_handle = open(file_name)
        lines = _read_lines(file_handle)
        file_has_match = False

        for line_number, line in enumerate(lines, 1):
            matched = _matches(line, pattern, ignore_case, whole_line)
            selected = (not matched) if invert else matched

            if not selected:
                continue

            file_has_match = True

            if show_file_names:
                continue

            prefix = ""
            if multiple_files:
                prefix += f"{file_name}:"
            if show_line_numbers:
                prefix += f"{line_number}:"

            output_lines.append(prefix + line)

        if show_file_names and file_has_match:
            output_lines.append(file_name)

    if not output_lines:
        return ""

    return "\n".join(output_lines) + "\n"


def _parse_flags(flags):
    if not flags:
        return set()

    if isinstance(flags, str):
        tokens = flags.split()
    else:
        tokens = list(flags)

    flag_chars = set()

    for token in tokens:
        if not isinstance(token, str):
            continue

        token = token.strip()
        if not token:
            continue

        chars = token[1:] if token.startswith("-") else token

        for char in chars:
            if char.isalpha():
                flag_chars.add(char)

    return flag_chars


def _matches(line, pattern, ignore_case, whole_line):
    if ignore_case:
        line = line.casefold()
        pattern = pattern.casefold()

    if whole_line:
        return line == pattern

    return pattern in line


def _read_lines(file_handle):
    read = getattr(file_handle, "read", None)
    if callable(read):
        try:
            content = read()
        except Exception:
            content = None

        if isinstance(content, bytes):
            try:
                content = content.decode()
            except Exception:
                content = ""

        if isinstance(content, str):
            return content.splitlines()

    readlines = getattr(file_handle, "readlines", None)
    if callable(readlines):
        try:
            lines = readlines()
        except Exception:
            lines = None

        if isinstance(lines, (list, tuple)):
            return [line.rstrip("\r\n") for line in lines]

    try:
        return [line.rstrip("\r\n") for line in file_handle]
    except Exception:
        return []
