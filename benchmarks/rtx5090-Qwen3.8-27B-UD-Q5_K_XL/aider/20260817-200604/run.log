    public char[][] generatePerfectMaze(int rows, int columns) {
        return generatePerfectMaze(rows, columns, new Random().nextInt());
    }

    public char[][] generatePerfectMaze(int rows, int columns, int seed) {
        if (rows < 5 || rows > 100 || columns < 5 || columns > 100) throw new IllegalArgumentException("rows and columns must be between 5 and 100");
        Random random = new Random(seed);
        boolean[][] h = new boolean[rows + 1][columns]; // horizontal segments: rows+1 lines, columns segments
        boolean[][] v = new boolean[rows][columns + 1]; // vertical segments: rows segments, columns+1 lines
        for (int r=0; r<=rows; r++) Arrays.fill(h[r], true);
        for (int c=0; c<=columns; c++) Arrays.fill(v[c]? Wait v dimensions rows x columns+1. Need fill each row: for (int r=0; r<rows; r++) Arrays.fill(v[r], true);

        boolean[][] visited = new boolean[rows][columns];
        int[] stackR = new int[rows*columns]; int[] stackC = new int[rows*columns]; int top=0;
        int startR = random.nextInt(rows); int startC = random.nextInt(columns);
        visited[startR][startC]=true; stackR[top]=startR; stackC[top]=startC; top++;
        while (top > 0) {
            int r = stackR[top-1]; int c = stackC[top-1];
            int[] dr = {-1,1,0,0}; int[] dc = {0,0,-1,1};
            // shuffle neighbors
            int count=0;
            int[] neighbors = new int[4]; // maybe store encoded
            for (int i=0;i<4;i++) { int nr=r+dr[i], nc=c+dc[i]; if in bounds && !visited) neighbors[count++]=i; }
            if (count == 0) { top--; continue; }
            int idx = neighbors[random.nextInt(count)];
            int nr = r + dr[idx]; int nc = c + dc[idx];
            // remove wall
            if (idx == 0) { // up: remove h[r][c]
                h[r][c] = false;
            } else if (idx == 1) { // down: h[r+1][c]
                h[r+1][c] = false;
            } else if (idx == 2) { // left: v[r][c]
                v[r][c] = false;
            } else { // right: v[r][c+1]
                v[r][c+1] = false;
            }
            visited[nr][nc]=true;
            stackR[top]=nr; stackC[top]=nc; top++;
        }

        // choose entrance and exit rows. Need random odd char rows: cell row 0..rows-1.
        int entranceCellRow = random.nextInt(rows);
        int exitCellRow = random.nextInt(rows);
        // maybe ensure distinct? If rows > 1 and same, reroll? Could do while (exitCellRow == entranceCellRow) exitCellRow = random.nextInt(rows); But if rows=1 
impossible; but min 5. Distinct maybe good.
        while (exitCellRow == entranceCellRow) { exitCellRow = random.nextInt(rows); }

        char[][] maze = new char[2*rows+1][2*columns+1];
        for (int i=0; i<maze.length; i++) {
          for (int j=0; j<maze[0].length; j++) {
            if ((i & 1) == 1 && (j & 1) == 1) maze[i][j] = ' ';
            else if ((i & 1) == 0 && (j & 1) == 1) {
               int hr = i/2; int hc = j/2; // h[hr][hc]
               maze[i][j] = h[hr][hc] ? HORIZONTAL : ' ';
            } else if ((i & 1) == 1 && (j & 1) == 0) {
               int vr = i/2; int vc = j/2; // v[vr][vc]
               maze[i][j] = v[vr][vc] ? VERTICAL : ' ';
            } else { // even even
               boolean up = i > 0 && v[i/2 - 1][j/2]; // if i/2-1 >=0
               boolean down = i < 2*rows && v[i/2][j/2]; // if i/2 < rows
               boolean left = j > 0 && h[i/2][j/2 - 1];
               boolean right = j < 2*columns && h[i/2][j/2];
               maze[i][j] = junction(up, down, left, right);
            }
          }
        }
        // openings: left border at i=2*entranceCellRow+1, j=0. right border at i=2*exitCellRow+1, j=2*columns.
        maze[2*entranceCellRow+1][0] = ARROW;
        maze[2*exitCellRow+1][2*columns] = ARROW;
        return maze;
    }

    private char junction(boolean up, boolean down, boolean left, boolean right) { ... }
}

