     key := card
     if seen[key] { return hand{}, errors.New("duplicate card") }
     seen[key] = true
     h.ranks[i] = rank
     h.suits[i] = suit
   }
 } else if len(parts) == 10 {
   for i := 0; i < 5; i++ {
