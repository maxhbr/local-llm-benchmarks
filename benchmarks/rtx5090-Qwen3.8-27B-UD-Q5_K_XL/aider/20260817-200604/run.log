export class ComputeCell {
  constructor(inputCells, fn) {
    this.inputCells = inputCells;
    this.fn = fn;
    this.value = this.compute();
    this.callbacks = [];
    this.dependents = [];
    inputCells.forEach((cell) => cell.dependents.push(this));
  }
  compute() {
    return this.fn(...this.inputCells.map((cell) => cell.value));
  }
  update() {
    const oldValue = this.value;
    this.value = this.compute();
    if (oldValue !== this.value) {
      this.callbacks.forEach((cb) => cb(this.value));
      this.dependents.forEach((dependent) => dependent.update());
    }
  }
  addCallback(cb) {
    this.callbacks.push(cb);
  }
  removeCallback(cb) {
    this.callbacks = this.callbacks.filter((callback) => callback !== cb);
  }
}

