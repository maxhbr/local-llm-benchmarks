word-search.js
```
class WordSearch {
  constructor(puzzle) {
    let lines;

    if (puzzle == null) {
      lines = [];
    } else if (Array.isArray(puzzle)) {
      lines = puzzle;
    } else {
      const text = String(puzzle).trim();
      lines = text === '' ? [] : text.split(/\r?\n/);
    }

    this.grid = lines
      .map((line) => {
        if (line == null) return '';
        if (Array.isArray(line)) return line.join('');
        return String(line).trim();
      })
      .map((line) => line.toLowerCase());
  }

  find(words) {
    const wordList = words == null ? [] : Array.isArray(words) ? words : [words];
    const result = {};

    for (const word of wordList) {
      result[word] = this.findWord(word);
    }

    return result;
  }

  findWord(word) {
    const target = word == null ? '' : String(word).toLowerCase();

    if (target.length === 0) {
      return null;
    }

    const rows = this.grid.length;
    const directions = [
      [0, 1],
      [1, 0],
      [1, 1],
      [0, -1],
      [-1, 0],
      [-1, -1],
      [1, -1],
      [-1, 1],
    ];

    for (let row = 0; row < rows; row += 1) {
      const cols = this.grid[row].length;

      for (let col = 0; col < cols; col += 1) {
        for (const [dr, dc] of directions) {
          const finishRow = row + dr * (target.length - 1);
          const finishCol = col + dc * (target.length - 1);

          if (
            finishRow < 0 ||
            finishRow >= rows ||
            finishCol < 0 ||
            finishCol >= this.grid[finishRow].length
          ) {
            continue;
          }

          if (this.matches(row, col, dr, dc, target)) {
            return {
              start: { row: row + 1, column: col + 1 },
              finish: { row: finishRow + 1, column: finishCol + 1 },
            };
          }
        }
      }
    }

    return null;
  }

  matches(row, col, dr, dc, word) {
    for (let i = 0; i < word.length; i += 1) {
      const r = row + dr * i;
      const c = col + dc * i;

      if (
        r < 0 ||
        c < 0 ||
        r >= this.grid.length ||
        c >= this.grid[r].length
      ) {
        return false;
      }

      if (this.grid[r][c] !== word[i]) {
        return false;
      }
    }

    return true;
  }
}

export default WordSearch;
```
