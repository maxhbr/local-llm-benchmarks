class WordSearch {
  constructor(puzzle = []) {
    this.puzzle = Array.isArray(puzzle)
      ? puzzle.map(line => String(line))
      : String(puzzle).split('\n');
  }

  find(words) {
    const wordList = Array.isArray(words) ? words : [words];
    const result = {};
    for (const word of wordList) {
      result[word] = this.findWord(word);
    }
    return result;
  }

  findWord(word) {
    const target = String(word).toLowerCase();
    const rows = this.puzzle.length;
    if (target.length === 0) return null; // maybe? But if empty word? Could return null.
    const directions = [
      [0, 1],
      [1, 0],
      [1, 1],
      [0, -1],
      [-1, 0],
      [-1, -1],
      [1, -1],
      [-1, 1],
    ];

    for (let row = 0; row < rows; row++) {
      const cols = this.puzzle[row].length;
      for (let col = 0; col < cols; col++) {
        for (const [dr, dc] of directions) {
          const finishRow = row + dr * (target.length - 1);
          const finishCol = col + dc * (target.length - 1);
          if (
            finishRow < 0 || finishRow >= rows ||
            finishCol < 0 || finishCol >= this.puzzle[finishRow].length
          ) continue;
          if (this.matches(row, col, dr, dc, target)) {
            return {
              start: { row: row + 1, column: col + 1 },
              finish: { row: finishRow + 1, column: finishCol + 1 },
            };
          }
        }
      }
    }
    return null;
  }

  matches(row, col, dr, dc, word) {
    for (let i = 0; i < word.length; i++) {
      const r = row + dr * i;
      const c = col + dc * i;
      if (r < 0 || c < 0 || r >= this.puzzle.length || c >= this.puzzle[r].length) return false;
      if (this.puzzle[r][c].toLowerCase() !== word[i]) return false;
    }
    return true;
  }
}

export default WordSearch;
