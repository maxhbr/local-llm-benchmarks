pub fn of_rna(&self, rna: &str) -> Result<Vec<&'a str>, Error> {
    let mut proteins = Vec::new();
    for codon in rna.as_bytes().chunks(3) {
        let codon = std::str::from_utf8(codon).map_err(|_| Error)?;
        let name = self.name_for(codon)?;
        if name == "Stop" { break; }
        proteins.push(name);
    }
    if rna.len() % 3 != 0 { return Err(Error); }
    Ok(proteins)
}
```
