package poker

import (
 "errors"
 "sort"
 "strings"
)

type hand struct {
 original string
 ranks [5]int
 suits [5]string
 category int
 tie [5]int
}

func BestHand(hands []string) ([]string, error) {
 if len(hands) == 0 {
   return []string{}, nil // or nil? Which is better? If expected nil, slices.Equal? In Go test maybe reflect.DeepEqual? If expected []string{} and actual nil may 
fail if using reflect.DeepEqual. If they use len and elements maybe okay. To be safe return []string{} not nil. But if expected nil? Usually expected []string{} in 
test. Return []string{}.
 }
 var best hand
 var bestHands []string
 first := true
 for _, h := range hands {
   parsed, err := newHand(h)
   if err != nil { return nil, err }
   if first { best = parsed; bestHands = append(bestHands, h); first=false; continue }
   switch compare(parsed, best) {
   case 1: best = parsed; bestHands = []string{h}
   case 0: bestHands = append(bestHands, h)
   }
 }
 return bestHands, nil
}

