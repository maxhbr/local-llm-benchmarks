//
// This is only a SKELETON file for the 'Promises' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

const settle = (value, onFulfilled, onRejected) => {
  Promise.resolve(value).then(onFulfilled, onRejected);
};

const toPromiseArray = (promises) => {
  if (promises === undefined || promises === null) {
    return [];
  }

  return Array.from(promises);
};

export const promisify = (fn) => {
  return function (...args) {
    return new Promise((resolve, reject) => {
      const callback = (error, ...values) => {
        if (error) {
          reject(error);
        } else if (values.length <= 1) {
          resolve(values[0]);
        } else {
          resolve(values);
        }
      };

      args.push(callback);
      fn.apply(this, args);
    });
  };
};

export const all = (promises) => {
  const items = toPromiseArray(promises);

  return new Promise((resolve, reject) => {
    if (items.length === 0) {
      resolve([]);
      return;
    }

    const results = new Array(items.length);
    let remaining = items.length;
    let settled = false;

    items.forEach((item, index) => {
      settle(
        item,
        (value) => {
          if (settled) {
            return;
          }

          results[index] = value;
          remaining -= 1;

          if (remaining === 0) {
            settled = true;
            resolve(results);
          }
        },
        (reason) => {
          if (settled) {
            return;
          }

          settled = true;
          reject(reason);
        }
      );
    });
  });
};

export const allSettled = (promises) => {
  const items = toPromiseArray(promises);

  return new Promise((resolve) => {
    if (items.length === 0) {
      resolve([]);
      return;
    }

    const results = new Array(items.length);
    const settled = new Array(items.length).fill(false);
    let remaining = items.length;

    items.forEach((item, index) => {
      settle(
        item,
        (value) => {
          if (settled[index]) {
            return;
          }

          settled[index] = true;
          results[index] = value;
          remaining -= 1;

          if (remaining === 0) {
            resolve(results);
          }
        },
        (reason) => {
          if (settled[index]) {
            return;
          }

          settled[index] = true;
          results[index] = reason;
          remaining -= 1;

          if (remaining === 0) {
            resolve(results);
          }
        }
      );
    });
  });
};

export const race = (promises) => {
  const items = toPromiseArray(promises);

  return new Promise((resolve, reject) => {
    if (items.length === 0) {
      resolve([]);
      return;
    }

    let settled = false;

    items.forEach((item) => {
      settle(
        item,
        (value) => {
          if (settled) {
            return;
          }

          settled = true;
          resolve(value);
        },
        (reason) => {
          if (settled) {
            return;
          }

          settled = true;
          reject(reason);
        }
      );
    });
  });
};

export const any = (promises) => {
  const items = toPromiseArray(promises);

  return new Promise((resolve, reject) => {
    if (items.length === 0) {
