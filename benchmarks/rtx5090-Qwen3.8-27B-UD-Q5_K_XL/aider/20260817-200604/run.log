def post(self, url, payload=None):
    url = self._normalize_url(url)
    payload = self._parse_payload(payload)
    if url == '/add':
        if isinstance(payload, dict):
            name = payload.get('user')
        elif isinstance(payload, str):
            name = payload
        else:
            name = None
        if name is None:
            return self._json({})
        name = str(name)
        self._ensure_user(name)
        return self._json(self._user_object(name))
    if url == '/iou':
        if isinstance(payload, dict):
            lender = payload.get('lender')
            borrower = payload.get('borrower')
            amount = payload.get('amount', 0)
        else:
            lender = borrower = None; amount = 0
        if lender is None or borrower is None:
            return self._json({'users': []})
        lender = str(lender); borrower = str(borrower)
        self._add_iou(lender, borrower, amount)
        users = sorted([lender, borrower], key=str)
        # if same, unique?
        if lender == borrower:
            users = [lender]
        return self._json({'users': [self._user_object(n) for n in users]})
    return self._json({})
```
