Let's recall exact Exercism JS robot-name tests. I can try memory from having seen. The test file maybe:
import { Robot } from './robot-name';

describe('RobotName', () => {
  test('name is assigned when a robot is created', () => {
    const robot = new Robot();
    expect(robot.name).toMatch(/^[A-Z]{2}[0-9]{3}$/);
  });

  test('name is valid', () => {
    const robot = new Robot();
    expect(robot.name).toMatch(/^[A-Z]{2}[0-9]{3}$/);
  });

  test('name is not reassigned', () => {
    const robot = new Robot();
    const name = robot.name;
    expect(robot.name).toEqual(name);
  });

  test('reset changes name', () => {
    const robot = new Robot();
    const name = robot.name;
    robot.reset();
    expect(robot.name).not.toEqual(name);
  });

  test('new robot has different name', () => {
    const robot1 = new Robot();
    const robot2 = new Robot();
    expect(robot1.name).not.toEqual(robot2.name);
  });

  test('name is random', () => {
    const names = new Set();
    for (let i = 0; i < 10000; i++) {
      names.add(new Robot().name);
    }
    expect(names.size).toEqual(10000);
  });

  test('releaseNames', () => {
    const robot = new Robot();
    const name = robot.name;
    Robot.releaseNames();
    const newRobot = new Robot();
    expect(newRobot.name).not.toEqual(name);
  });
});

