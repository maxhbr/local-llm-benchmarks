```
class TwelveDays {
    private static final String[] DAYS = {
        "first", "second", "third", "fourth", "fifth", "sixth",
        "seventh", "eighth", "ninth", "tenth", "eleventh", "twelfth"
    };

    private static final String[] GIFTS = {
        "a Partridge in a Pear Tree.",
        "two Turtle Doves",
        "three French Hens",
        "four Calling Birds",
        "five Gold Rings",
        "six Geese-a-Laying",
        "seven Swans-a-Swimming",
        "eight Maids-a-Milking",
        "nine Ladies Dancing",
        "ten Lords-a-Leaping",
        "eleven Pipers Piping",
        "twelve Drummers Drumming"
    };

    String verse(int verseNumber) {
        if (verseNumber < 1 || verseNumber > 12) {
            throw new IllegalArgumentException("Verse number must be between 1 and 12.");
        }

        StringBuilder verse = new StringBuilder();
        verse.append("On the ")
             .append(DAYS[verseNumber - 1])
             .append(" day of Christmas my true love gave to me: ");

        for (int i = verseNumber; i >= 1; i--) {
            if (i == 1) {
                if (verseNumber > 1) {
                    verse.append(", and ");
                }
                verse.append(GIFTS[0]);
            } else {
                verse.append(GIFTS[i - 1]);
                if (i > 2) {
                    verse.append(", ");
                }
            }
        }

        verse.append('\n');
        return verse.toString();
    }

    String verses(int startVerse, int endVerse) {
        StringBuilder result = new StringBuilder();
        for (int i = startVerse; i <= endVerse; i++) {
            if (result.length() > 0) {
                result.append('\n');
            }
            result.append(verse(i));
        }
        return result.toString();
    }

    String sing() {
        return verses(1, 12);
    }
}
