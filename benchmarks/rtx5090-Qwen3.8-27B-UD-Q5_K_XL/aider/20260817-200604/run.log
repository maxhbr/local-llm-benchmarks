export class GradeSchool {
  constructor() {
    this.students = {};
    this.enrolled = new Set();
  }

  roster() {
    return Object.keys(this.students)
      .sort((a, b) => Number(a) - Number(b))
      .reduce((roster, grade) => {
        roster[grade] = this.students[grade].slice().sort();
        return roster;
      }, {});
  }

  add(name, grade) {
    if (this.enrolled.has(name)) {
      return false;
    }

    const gradeKey = String(grade);

    if (!Array.isArray(this.students[gradeKey])) {
      this.students[gradeKey] = [];
    }

    this.students[gradeKey].push(name);
    this.enrolled.add(name);
    return true;
  }

  grade(grade) {
    const students = this.students[String(grade)];
    return students ? students.slice().sort() : [];
  }
}
```

