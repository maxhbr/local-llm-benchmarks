def foldl(function, list, initial):
    """Fold a list from the left.

    :param function: function to apply to accumulator and item
    :param list: list to fold
    :param initial: initial accumulator
    :return: final accumulator
    """
    for item in list:
        initial = function(initial, item)
    return initial

def foldr(function, list, initial):
    """Fold a list from the right.

    :param function: function to apply to item and accumulator
    :param list: list to fold
    :param initial: initial accumulator
    :return: final accumulator
    """
    for item in reversed(list):
        initial = function(item, initial)
    return initial
