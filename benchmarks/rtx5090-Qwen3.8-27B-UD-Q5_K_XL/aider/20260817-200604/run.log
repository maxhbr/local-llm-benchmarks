#include "grade_school.h"

namespace grade_school {

bool School::add(const std::string& student, int grade) {
    if (all_students_.find(student) != all_students_.end()) {
        return false;
    }
    all_students_.insert(student);
    students_by_grade_[grade].insert(student);
    return true;
}

std::vector<int> School::grades() const {
    std::vector<int> result;
    result.reserve(students_by_grade_.size());
    for (const auto& entry : students_by_grade_) {
        result.push_back(entry.first);
    }
    return result;
}

std::vector<std::string> School::grade(int grade) const {
    auto it = students_by_grade_.find(grade);
    if (it == students_by_grade_.end()) {
        return {};
    }
    return {it->second.begin(), it->second.end()};
}

std::vector<std::string> School::roster() const {
    std::vector<std::string> result;
    for (const auto& entry : students_by_grade_) {
        for (const auto& student : entry.second) {
            result.push_back(student);
        }
    }
    return result;
}

}  // namespace grade_school
