fn try_assign(pos: usize, unassigned: &[usize], ...) -> Option<HashMap> {
  if pos == unassigned.len() {
     // compute sum
     let mut sum = carry;
     for &idx in &add_chars { sum += assignment[idx].unwrap() as i64; }
     let next_carry = sum / 10;
     let unit = sum % 10;
     match res {
       None => { if unit != 0 { return None; } }
       Some(r) => {
          match assignment[r] {
             Some(d) => { if d as i64 != unit { return None; } }
             None => {
                // r must not be in unassigned? If it was, assignment[r] would be Some now. So here r not in unassigned.
                let d = unit as u8;
                if used[d] { return None; } // should be false because unit from sum of used? Could be used by other letter? Yes if another letter has same digit? But
used ensures distinct, unit could equal a used digit not r. Need check.
                if leading[r] && d == 0 { return None; }
                assignment[r] = Some(d);
                used[d] = true;
                if let Some(sol) = solve_column(col+1, next_carry, ...) { return Some(sol); }
                assignment[r] = None;
                used[d] = false;
                return None;
             }
          }
       }
     }
     if let Some(sol) = solve_column(col+1, next_carry, ...) { return Some(sol); }
     None
  } else {
     let idx = unassigned[pos];
     for d in 0..10u8 {
        if !used[d] && !(leading[idx] && d == 0) {
           assignment[idx] = Some(d);
           used[d] = true;
           if let Some(sol) = try_assign(pos+1, ...) { return Some(sol); }
           assignment[idx] = None;
           used[d] = false;
        }
     }
     None
  }
}
```
