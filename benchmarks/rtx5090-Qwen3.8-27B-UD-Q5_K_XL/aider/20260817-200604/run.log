function toArrayLike(value) {
  if (value instanceof List) {
    return value.items;
  }
  if (value && typeof value.length === 'number') {
    return value;
  }
  return null;
}

function copyItems(source) {
  const items = [];
  const sourceItems = toArrayLike(source);
  const length = sourceItems ? sourceItems.length : 0;
  for (let i = 0; i < length; i += 1) {
    items[i] = sourceItems[i];
  }
  return items;
}

export class List {
  constructor(items = []) {
    this.items = copyItems(items);
  }

  append(list) {
    const other = toArrayLike(list) || [];
    const result = [];
    let index = 0;

    for (let i = 0; i < this.items.length; i += 1) {
      result[index] = this.items[i];
      index += 1;
