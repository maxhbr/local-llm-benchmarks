fn parse(input: &str) -> Option<(Vec<Vec<char>>, Vec<char>)> {
    let (left, right) = input.split_once("==")?;
    let result = right.trim().chars().collect();
    if result.is_empty() { return None; }
    let mut addends = Vec::new();
    for term in left.split('+') {
        let word: Vec<char> = term.trim().chars().collect();
        if word.is_empty() { return None; }
        addends.push(word);
    }
    if addends.is_empty() { return None; }
    Some((addends, result))
}
