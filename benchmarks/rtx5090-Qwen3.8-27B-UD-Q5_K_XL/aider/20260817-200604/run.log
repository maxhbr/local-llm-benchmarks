// skeleton comments
function invokeCallback(callback, cell) {
  if (typeof callback === 'function') {
    callback(cell);
  } else if (callback && typeof callback.update === 'function') {
    callback.update(cell);
  } else if (callback && typeof callback.fn === 'function') {
    callback.value = callback.fn(cell);
  }
}

function getTopologicalOrder(startCell) { ... same ... }

export class InputCell {
  constructor(value) { this.value = value; this.dependents = []; }
  setValue(value) {
    if (this.value === value) return;
    this.value = value;
    const order = getTopologicalOrder(this);
    const changedCells = [];
    for (const cell of order) {
      if (cell.recompute()) changedCells.push(cell);
    }
    for (const cell of changedCells) {
      cell.notify();
    }
  }
}

export class ComputeCell {
  constructor(inputCells, fn) {
    this.inputCells = Array.isArray(inputCells) ? inputCells : [inputCells];
    this.fn = fn;
    this.value = this.compute();
    this.callbacks = [];
    this.dependents = [];
    for (const inputCell of this.inputCells) {
      if (inputCell && Array.isArray(inputCell.dependents)) {
        inputCell.dependents.push(this);
      }
    }
  }
  compute() {
    return this.fn(this.inputCells);
  }
  recompute() {
    const oldValue = this.value;
    this.value = this.compute();
    return oldValue !== this.value;
  }
  notify() {
    const callbacks = this.callbacks.slice();
    for (const callback of callbacks) {
      invokeCallback(callback, this);
    }
  }
  addCallback(callback) { this.callbacks.push(callback); }
  removeCallback(callback) { this.callbacks = this.callbacks.filter((cb) => cb !== callback); }
}

export class CallbackCell {
  constructor(fn) { this.fn = fn; this.value = undefined; }
  update(cell) { this.value = this.fn(cell); }
}

