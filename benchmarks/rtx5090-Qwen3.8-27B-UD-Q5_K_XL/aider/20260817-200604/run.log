```
package poker

import (
	"errors"
	"sort"
	"strings"
)

type hand struct {
	original string
	ranks    [5]int
	suits    [5]string
	category int
	tie      [5]int
}

func BestHand(hands []string) ([]string, error) {
	if len(hands) == 0 {
		return nil, errors.New("no hands")
	}

	var best hand
	var bestHands []string
	first := true

	for _, h := range hands {
		parsed, err := newHand(h)
		if err != nil {
			return nil, err
		}

		if first {
			best = parsed
			bestHands = append(bestHands, h)
			first = false
			continue
		}

		switch compare(parsed, best) {
		case 1:
			best = parsed
			bestHands = []string{h}
		case 0:
			bestHands = append(bestHands, h)
		}
	}

	return bestHands, nil
}

func newHand(s string) (hand, error) {
	parts := strings.Fields(s)

	var h hand
	h.original = s
	seen := make(map[string]bool, 5)

	if len(parts) == 5 {
		for i, card := range parts {
			rank, suit, err := parseCard(card)
			if err != nil {
				return hand{}, err
			}

			key := card
			if seen[key] {
				return hand{}, errors.New("duplicate card")
			}
			seen[key] = true

			h.ranks[i] = rank
			h.suits[i] = suit
		}
	} else if len(parts) == 10 {
		for i := 0; i < 5; i++ {
			rank, err := parseRank(parts[2*i])
			if err != nil {
				return hand{}, err
			}

			suit := parts[2*i+1]
			if suit == "" {
				return hand{}, errors.New("invalid suit")
			}

			key := parts[2*i] + " " + suit
			if seen[key] {
				return hand{}, errors.New("duplicate card")
			}
			seen[key] = true

			h.ranks[i] = rank
			h.suits[i] = suit
		}
	} else {
		return hand{}, errors.New("invalid hand")
	}

	h.category, h.tie = evaluate(h.ranks, h.suits)
	return h, nil
}

func parseCard(card string) (int, string, error) {
	if strings.HasPrefix(card, "10") {
		if len(card) <= 2 {
			return 0, "", errors.New("invalid card")
		}
		return 10, card[2:], nil
	}

	if len(card) < 2 {
		return 0, "", errors.New("invalid card")
	}

	switch card[0] {
	case '2':
		return 2, card[1:], nil
	case '3':
		return 3, card[1:], nil
	case '4':
		return 4, card[1:], nil
	case '5':
		return 5, card[1:], nil
	case '6':
		return 6, card[1:], nil
	case '7':
		return 7, card[1:], nil
	case '8':
		return 8, card[1:], nil
	case '9':
		return 9, card[1:], nil
	case 'J':
		return 11, card[1:], nil
	case 'Q':
		return 12, card[1:], nil
	case 'K':
		return 13, card[1:], nil
	case 'A':
		return 14, card[1:], nil
	default:
		return 0, "", errors.New("invalid rank")
	}
}

func parseRank(s string) (int, error) {
	switch s {
	case "2":
		return 2, nil
	case "3":
		return 3, nil
	case "4":
		return 4, nil
	case "5":
		return 5, nil
	case "6":
		return 6, nil
	case "7":
		return 7, nil
	case "8":
		return 8, nil
	case "9":
		return 9, nil
	case "10":
		return 10, nil
	case "J":
		return 11, nil
	case "Q":
		return 12, nil
	case "K":
		return 13, nil
	case "A":
		return 14, nil
	default:
		return 0, errors.New("invalid rank")
	}
}

func evaluate(ranks [5]int, suits [5]string) (int, [5]int) {
	counts := make(map[int]int, 5)
	for _, r := range ranks {
		counts[r]++
	}

	var unique []int
	for r := range counts {
		unique = append(unique, r)
	}
	sort.Ints(unique)

	uniqueDesc := make([]int, len(unique))
	for i, r := range unique {
		uniqueDesc[len(unique)-1-i] = r
	}

	allDesc := make([]int, 5)
	copy(allDesc, ranks[:])
	sort.Ints(allDesc)
	for i, j := 0, len(allDesc)-1; i < j; i, j = i+1, j-1 {
		allDesc[i], allDesc[j] = allDesc[j], allDesc[i]
	}

	flush := true
	for i := 1; i < 5; i++ {
		if suits[i] != suits[0] {
			flush = false
			break
		}
	}

	straightHigh := 0
	if len(unique) == 5 {
		if unique[0] == 2 && unique[1] == 3 && unique[2] == 4 && unique[3] == 5 && unique[4] == 14 {
			straightHigh = 5
		} else if unique[4]-unique[0] == 4 {
			straightHigh = unique[4]
		}
	}

	var quadRank, tripsRank int
	var pairRanks []int
	var kickers []int

	for _, r := range uniqueDesc {
		switch {
		case counts[r] >= 4:
			quadRank = r
		case counts[r] == 3:
			tripsRank = r
		case counts[r] == 2:
			pairRanks = append(pairRanks, r)
		default:
			kickers = append(kickers, r)
		}
	}

	if flush && straightHigh != 0 {
		return 9, [5]int{straightHigh, 0, 0, 0, 0}
	}

	if quadRank != 0 {
		return 8, [5]int{quadRank, at(kickers, 0), 0, 0, 0}
	}

	if tripsRank != 0 && len(pairRanks) == 1 {
		return 7, [5]int{tripsRank, pairRanks[0], 0, 0, 0}
	}

	if flush {
		return 6, [5]int{allDesc[0], allDesc[1], allDesc[2], allDesc[3], allDesc[4]}
	}

	if straightHigh != 0 {
		return 5, [5]int{straightHigh, 0, 0, 0, 0}
	}

	if tripsRank != 0 {
		return 4, [5]int{tripsRank, at(kickers, 0), at(kickers, 1), 0, 0}
	}

	if len(pairRanks) == 2 {
		return 3, [5]int{pairRanks[0], pairRanks[1], at(kickers, 0), 0, 0}
	}

	if len(pairRanks) == 1 {
		return 2, [5]int{pairRanks[0], at(kickers, 0), at(kickers, 1), at(kickers, 2), 0}
	}

	return 1, [5]int{allDesc[0], allDesc[1], allDesc[2], allDesc[3], allDesc[4]}
}

func at(values []int, i int) int {
	if i < len(values) {
		return values[i]
	}
	return 0
}

func compare(a, b hand) int {
	if a.category != b.category {
		if a.category > b.category {
			return 1
		}
		return -1
	}

	for i := 0; i < 5; i++ {
		if a.tie[i] != b.tie[i] {
			if a.tie[i] > b.tie[i] {
				return 1
			}
			return -1
		}
	}

	return 0
}
