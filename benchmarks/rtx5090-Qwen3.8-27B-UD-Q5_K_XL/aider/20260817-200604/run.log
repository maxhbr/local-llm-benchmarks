#include <memory>
#include <stdexcept>
#include <utility>

namespace binary_search_tree {

template <typename T>
class binary_search_tree {
public:
    binary_search_tree() = default;

    binary_search_tree(const T& data) : data_(new T(data)) {}

    binary_search_tree(const binary_search_tree& other) {
        if (other.data_) {
            data_.reset(new T(*other.data_));
        }
        if (other.left_) {
            left_.reset(new binary_search_tree<T>(*other.left_));
        }
        if (other.right_) {
            right_.reset(new binary_search_tree<T>(*other.right_));
        }
    }

    binary_search_tree(binary_search_tree&& other) noexcept = default;

    binary_search_tree& operator=(const binary_search_tree& other) {
        if (this != &other) {
            binary_search_tree temporary(other);
            swap(temporary);
        }
        return *this;
    }

    binary_search_tree& operator=(binary_search_tree&& other) noexcept = default;

    void add(const T& data) {
        if (!data_) {
            data_.reset(new T(data));
            return;
        }

        if (data <= *data_) {
            if (!left_) {
                left_.reset(new binary_search_tree<T>(data));
            } else {
                left_->add(data);
            }
        } else {
            if (!right_) {
                right_.reset(new binary_search_tree<T>(data));
            } else {
                right_->add(data);
            }
        }
    }

    bool contains(const T& data) const {
        if (!data_) {
            return false;
        }

        if (data == *data_) {
            return true;
        }

        if (data < *data_) {
            return left_ ? left_->contains(data) : false;
        }

        return right_ ? right_->contains(data) : false;
    }

    T& data() {
        if (!data_) {
            throw std::logic_error("binary_search_tree::data() called on an empty tree");
        }
        return *data_;
    }

    const T& data() const {
        if (!data_) {
            throw std::logic_error("binary_search_tree::data() called on an empty tree");
        }
        return *data_;
    }

    bool empty() const {
        return !data_;
    }

    const binary_search_tree& left() const {
        static const binary_search_tree<T> empty;
        return left_ ? *left_ : empty;
    }

    const binary_search_tree& right() const {
        static const binary_search_tree<T> empty;
        return right_ ? *right_ : empty;
    }

private:
    void swap(binary_search_tree& other) noexcept {
        data_.swap(other.data_);
        left_.swap(other.left_);
        right_.swap(other.right_);
    }

    std::unique_ptr<T> data_;
    std::unique_ptr<binary_search_tree<T>> left_;
    std::unique_ptr<binary_search_tree<T>> right_;
};

}  // namespace binary_search_tree

