```
def _propagate(source):
    affected = []
    visited = set()
    stack = [source]
    while stack:
        cell = stack.pop()
        for dependent in getattr(cell, "_dependents", []):
            dependent_id = id(dependent)
            if dependent_id not in visited:
                visited.add(dependent_id)
                affected.append(dependent)
                stack.append(dependent)
    if not affected:
        return
    affected_ids = {id(cell) for cell in affected}
    in_degree = {id(cell): 0 for cell in affected}
    adjacency = {id(cell): [] for cell in affected}
    for cell in affected:
        for input_cell in getattr(cell, "_inputs", []):
            input_id = id(input_cell)
            if input_id in affected_ids:
                in_degree[id(cell)] += 1
                adjacency[input_id].append(cell)
    queue = [cell for cell in affected if in_degree[id(cell)] == 0]
    order = []
    head = 0
    while head < len(queue):
        cell = queue[head]
        head += 1
        order.append(cell)
        for dependent in adjacency[id(cell)]:
            in_degree[id(dependent)] -= 1
            if in_degree[id(dependent)] == 0:
                queue.append(dependent)
    if len(order) != len(affected):
        ordered_ids = {id(cell) for cell in order}
        order.extend(cell for cell in affected if id(cell) not in ordered_ids)
    changed_ids = {id(source)}
    changed_cells = []
    for cell in order:
        if any(id(input_cell) in changed_ids for input_cell in getattr(cell, "_inputs", [])):
            old_value = cell._value
            cell._value = cell._compute()
            if cell._value != old_value:
                changed_ids.add(id(cell))
                changed_cells.append(cell)
    for cell in changed_cells:
        for callback in list(cell._callbacks):
            _invoke_callback(callback, cell._value)
```
