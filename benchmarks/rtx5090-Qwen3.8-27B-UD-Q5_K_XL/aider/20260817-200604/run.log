Implement generateForSum:
```
private void generateForSum(int sum, int maxFactor, List<PythagoreanTriplet> result) {
    long s = sum;
    for (long m = 2; 2L * m * (m + 1) <= s; m++) {
        for (long n = 1; n < m; n++) {
            if (((m - n) & 1L) == 0) continue;
            if (gcd(m, n) != 1) continue;
            long baseSum = 2L * m * (m + n);
            if (s % baseSum != 0) continue;
            long k = s / baseSum;
            long x = m*m - n*n;
            long y = 2L*m*n;
            long a = k * Math.min(x, y);
            long b = k * Math.max(x, y);
            long c = k * (m*m + n*n);
            if (a < b && b < c && a + b + c == s) {
                if (maxFactor <= 0 || c <= maxFactor) {
                    if (a <= Integer.MAX_VALUE && b <= Integer.MAX_VALUE && c <= Integer.MAX_VALUE) {
                        result.add(new PythagoreanTriplet((int)a, (int)b, (int)c));
                    }
                }
            }
        }
    }
}
```
