import random
import string

class Robot:
    _used_names = set()
    _random = random.SystemRandom()

    def __init__(self):
        self._name = None

    @property
    def name(self):
        if self._name is None:
            self._name = self._generate_name()
        return self._name

    @name.setter
    def name(self, value):
        self._name = value

    @name.deleter
    def name(self):
        self._name = None

    def reset(self):
        self._name = None

    @classmethod
    def _generate_name(cls):
        total_possible = 26 * 26 * 1000
        if len(cls._used_names) >= total_possible:
            raise RuntimeError("No unique robot names available")
        while True:
            name = (
                cls._random.choice(string.ascii_uppercase)
                + cls._random.choice(string.ascii_uppercase)
                + cls._random.choice(string.digits)
                + cls._random.choice(string.digits)
                + cls._random.choice(string.digits)
            )
            if name not in cls._used_names:
                cls._used_names.add(name)
                return name
```

