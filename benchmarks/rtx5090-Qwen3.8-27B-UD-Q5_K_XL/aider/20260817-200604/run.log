private Set<Point> getEmptyRegion(int x, int y) {
  Set<Point> region = new HashSet<>();
  if (!isEmpty(x,y)) return region;
  boolean[][] seen = new boolean[rows][cols];
  ArrayDeque<Point> q = new ArrayDeque<>();
  q.add(new Point(x,y)); seen[y][x]=true;
  while(!q.isEmpty()) { Point p=q.poll(); region.add(p); ... if (!seen[ny][nx] && isEmpty(nx,ny)) { seen[ny][nx]=true; q.add(new Point(nx,ny)); } }
  return region;
}
```
