const verseStarts = [...];
const verseContinuations = [...];

export class House {
  static verse(verseNumber) {
    if (verseNumber < 1 || verseNumber > verseStarts.length) {
      return [];
    }

    const lines = [verseStarts[verseNumber - 1]];

    for (let i = verseNumber - 2; i >= 0; i -= 1) {
      lines.push(verseContinuations[i]);
    }

    return lines;
  }

  static verses(startVerse, endVerse) {
    const lines = [];

    for (let i = startVerse; i <= endVerse; i += 1) {
      if (lines.length > 0) {
        lines.push('');
      }
      lines.push(...House.verse(i));
    }

    return lines;
  }
}

