Implementation details:
```
package twobucket

import "errors"

type state struct {
    a, b, steps int
}

func Solve(...) (...) {
    if sizeBucketOne <= 0 || sizeBucketTwo <= 0 || goalAmount <= 0 {
        return "", 0, 0, errors.New("invalid parameters")
    }
    if startBucket != "one" && startBucket != "two" {
        return "", 0, 0, errors.New("invalid start bucket")
    }
    if goalAmount > sizeBucketOne && goalAmount > sizeBucketTwo {
        return "", 0, 0, errors.New("goal too large")
    }
    if goalAmount%gcd(sizeBucketOne, sizeBucketTwo) != 0 {
        return "", 0, 0, errors.New("no solution")
    }

    isStartOne := startBucket == "one"
    forbidden := func(a, b int) bool {
        if isStartOne {
            return a == 0 && b == sizeBucketTwo
        }
        return a == sizeBucketOne && b == 0
    }

    var start state
    if isStartOne {
        start = state{sizeBucketOne, 0, 1}
    } else {
        start = state{0, sizeBucketTwo, 1}
    }

    if start.a == goalAmount {
        return "one", start.steps, start.b, nil
    }
    if start.b == goalAmount {
        return "two", start.steps, start.a, nil
    }

    visited := make(map[state]struct{})
    // start should not be forbidden, but check
    if !forbidden(start.a, start.b) {
        visited[state{start.a, start.b}] = struct{}{}
    }
    queue := []state{start}

    for len(queue) > 0 {
        cur := queue[0]
        queue = queue[1:]

        nexts := [6]state{}
        n := 0
        // fill one
        if cur.a != sizeBucketOne {
            nexts[n] = state{sizeBucketOne, cur.b, cur.steps + 1}; n++
        }
        // fill two
        if cur.b != sizeBucketTwo {
            nexts[n] = state{cur.a, sizeBucketTwo, cur.steps + 1}; n++
        }
        // empty one
        if cur.a != 0 {
            nexts[n] = state{0, cur.b, cur.steps + 1}; n++
        }
        // empty two
        if cur.b != 0 {
            nexts[n] = state{cur.a, 0, cur.steps + 1}; n++
        }
        // pour one to two
        if cur.a > 0 && cur.b < sizeBucketTwo {
            pour := cur.a
            space := sizeBucketTwo - cur.b
            if pour > space { pour = space }
            nexts[n] = state{cur.a - pour, cur.b + pour, cur.steps + 1}; n++
        }
        // pour two to one
        if cur.b > 0 && cur.a < sizeBucketOne {
            pour := cur.b
            space := sizeBucketOne - cur.a
            if pour > space { pour = space }
            nexts[n] = state{cur.a + pour, cur.b - pour, cur.steps + 1}; n++
        }

        for i := 0; i < n; i++ {
            ns := nexts[i]
            if forbidden(ns.a, ns.b) { continue }
            key := state{ns.a, ns.b}
            if _, ok := visited[key]; ok { continue }
            visited[key] = struct{}{}
            if ns.a == goalAmount {
                return "one", ns.steps, ns.b, nil
            }
            if ns.b == goalAmount {
                return "two", ns.steps, ns.a, nil
            }
            queue = append(queue, ns)
        }
    }
    return "", 0, 0, errors.New("no solution")
}

func gcd(a,b int) int { for b !=0 { a,b=b,a%b }; return a }
```

