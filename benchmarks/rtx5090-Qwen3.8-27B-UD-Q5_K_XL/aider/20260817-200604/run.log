```
export function count(input) {
  if (input == null) {
    return 0;
  }

  const text = Array.isArray(input) ? input.join('\n') : String(input);
  const lines = text.replace(/\r/g, '').split('\n');

  let first = 0;
  while (first < lines.length && lines[first].length === 0) {
    first += 1;
  }

  let last = lines.length;
  while (last > first && lines[last - 1].length === 0) {
    last -= 1;
  }

  const rows = lines.slice(first, last);
  if (rows.length < 2) {
    return 0;
  }

  let cols = 0;
  for (const row of rows) {
    if (row.length > cols) {
      cols = row.length;
    }
  }

  if (cols < 2) {
    return 0;
  }

  const grid = rows.map((row) => row.padEnd(cols, ' ').split(''));
  const rowCount = grid.length;

  const isHorizontal = (ch) => ch === '-' || ch === '+';
  const isVertical = (ch) => ch === '|' || ch === '+';

  const maxRight = Array.from({ length: rowCount }, () => new Array(cols).fill(-1));
  for (let r = 0; r < rowCount; r += 1) {
    let end = -1;
    for (let c = cols - 1; c >= 0; c -= 1) {
      if (isHorizontal(grid[r][c])) {
        if (end === -1) {
          end = c;
        }
        maxRight[r][c] = end;
      } else {
        end = -1;
      }
    }
  }

  const maxDown = Array.from({ length: rowCount }, () => new Array(cols).fill(-1));
  for (let c = 0; c < cols; c += 1) {
    let end = -1;
    for (let r = rowCount - 1; r >= 0; r -= 1) {
      if (isVertical(grid[r][c])) {
        if (end === -1) {
          end = r;
        }
        maxDown[r][c] = end;
      } else {
        end = -1;
      }
    }
  }

  let total = 0;

  for (let top = 0; top < rowCount - 1; top += 1) {
    for (let bottom = top + 1; bottom < rowCount; bottom += 1) {
      const valid = new Array(cols).fill(false);
      const prefix = new Array(cols + 1).fill(0);

      for (let c = 0; c < cols; c += 1) {
        valid[c] =
          grid[top][c] === '+' &&
          grid[bottom][c] === '+' &&
          maxDown[top][c] >= bottom;
        prefix[c + 1] = prefix[c] + (valid[c] ? 1 : 0);
      }

      for (let left = 0; left < cols - 1; left += 1) {
        if (!valid[left]) {
          continue;
        }

        const maxCol = Math.min(maxRight[top][left], maxRight[bottom][left]);
        if (maxCol <= left) {
          continue;
        }

        const limit = Math.min(maxCol, cols - 1);
        total += prefix[limit + 1] - prefix[left + 1];
      }
    }
  }

  return total;
}
```
