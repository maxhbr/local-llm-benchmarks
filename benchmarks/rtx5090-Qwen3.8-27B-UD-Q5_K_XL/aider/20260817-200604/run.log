```
export const gamestate = (board) => {
  const cells = board.map((row) => (typeof row === 'string' ? row : row.join(''))).join('');
  const xCount = cells.split('X').length - 1;
  const oCount = cells.split('O').length - 1;

  if (oCount > xCount || xCount > oCount + 1) {
    throw new Error('X started game');
  }

  const lines = [
    [0, 1, 2], [3, 4, 5], [6, 7, 8],
    [0, 3, 6], [1, 4, 7], [2, 5, 8],
    [0, 4, 8], [2, 4, 6],
  ];
  const hasWon = (player) => lines.some(([a, b, c]) => cells[a] === player && cells[b] === player && cells[c] === player);
  const xWon = hasWon('X');
  const oWon = hasWon('O');

  if (xWon && oWon) {
    if (xCount === oCount) {
      throw new Error('Player O cannot win after X has won');
    }
    throw new Error('Player X cannot win after O has won');
  }

  if (xWon) {
    if (xCount !== oCount + 1) {
      throw new Error('game was played after it already ended');
    }
    return 'win';
  }

  if (oWon) {
    if (xCount !== oCount) {
      throw new Error('game was played after it already ended');
    }
    return 'win';
  }

  if (xCount + oCount === 9) return 'draw';
  return 'ongoing';
};
```

