package sublist

// Relation type is defined in relations.go file.

func Sublist(l1, l2 []int) Relation {
    if equal(l1, l2) {
        return "equal"
    }
    if contains(l1, l2) {
        return "superlist"
    }
    if contains(l2, l1) {
        return "sublist"
    }
    return "unequal"
}

func equal(a, b []int) bool {
    if len(a) != len(b) {
        return false
    }
    for i := range a {
        if a[i] != b[i] {
            return false
        }
    }
    return true
}

func contains(list, sub []int) bool {
    if len(sub) == 0 {
        return true
    }
    if len(sub) > len(list) {
        return false
    }
    for i := 0; i <= len(list)-len(sub); i++ {
        if matchesAt(list, sub, i) {
            return true
        }
    }
    return false
}

func matchesAt(list, sub []int, start int) bool {
    for i, v := range sub {
        if list[start+i] != v {
            return false
        }
    }
    return true
}
```

