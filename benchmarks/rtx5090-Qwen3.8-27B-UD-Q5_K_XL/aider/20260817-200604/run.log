export class Element {
  constructor(value, next = null) {
    this._value = value;
    this._next = next;
  }
  get value() { return this._value; }
  get next() { return this._next; }
}

export class List {
  constructor(array = []) {
    this._list = null;
    this._length = 0;
    for (let i = array.length - 1; i >= 0; i--) {
      this.add(array[i]);
    }
  }

  add(value) {
    this._list = new Element(value, this._list);
    this._length += 1;
  }

  get length() { return this._length; }
  get head() { return this._list; }

  toArray() {
    const array = [];
    let node = this._list;
    while (node) {
      array.push(node.value);
      node = node.next;
    }
    return array;
  }

  reverse() {
    let prev = null;
    let curr = this._list;
    while (curr) {
      const next = curr.next;
      curr.next = prev;
      prev = curr;
      curr = next;
    }
    this._list = prev;
    return this;
  }
}

