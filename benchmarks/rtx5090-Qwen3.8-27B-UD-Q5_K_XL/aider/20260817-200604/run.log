private Plant plantFromChar(char c) {
    String[] candidates;
    switch (c) {
        case 'G': candidates = new String[] {"GRASS", "GRASSES"}; break;
        case 'C': candidates = new String[] {"CLOVER", "CLOVERS"}; break;
        case 'R': candidates = new String[] {"RADISH", "RADISHES"}; break;
        case 'V': candidates = new String[] {"VIOLET", "VIOLETS"}; break;
        default: throw new IllegalArgumentException("Not a valid plant: " + c);
    }
    for (String name : candidates) {
        try {
            java.lang.reflect.Field field = Plant.class.getDeclaredField(name);
            field.setAccessible(true);
            Object value = field.get(null);
            if (value instanceof Plant) {
                return (Plant) value;
            }
        } catch (Exception ignored) {
        }
    }
    throw new IllegalArgumentException("Not a valid plant: " + c);
}

