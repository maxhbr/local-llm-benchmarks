GoCounting.java
```
import java.awt.Point;
import java.util.ArrayDeque;
import java.util.HashMap;
import java.util.HashSet;
import java.util.Map;
import java.util.Set;

class GoCounting {

    private static final int[] DX = {1, -1, 0, 0};
    private static final int[] DY = {0, 0, 1, -1};

    private final char[][] board;
    private final int rows;
    private final int cols;

    GoCounting(String board) {
        if (board == null || board.isEmpty()) {
            this.rows = 0;
            this.cols = 0;
            this.board = new char[0][0];
            return;
        }

        String[] lines = board.split("\\R");
        this.rows = lines.length;
        this.cols = 0;

        for (String line : lines) {
            if (line.length() > this.cols) {
                this.cols = line.length();
            }
        }

        this.board = new char[this.rows][this.cols];

        for (int y = 0; y < this.rows; y++) {
            String line = lines[y];
            for (int x = 0; x < this.cols; x++) {
                this.board[y][x] = x < line.length() ? line.charAt(x) : ' ';
            }
        }
    }

    Player getTerritoryOwner(int x, int y) {
        boolean[][] visited = new boolean[rows][cols];
        Set<Point> region = floodFill(x, y, visited);
        return ownerOfRegion(region);
    }

    Set<Point> getTerritory(int x, int y) {
        boolean[][] visited = new boolean[rows][cols];
        Set<Point> region = floodFill(x, y, visited);
        Player owner = ownerOfRegion(region);

        if (owner == null) {
            return new HashSet<>();
        }

        return region;
    }

    Map<Player, Set<Point>> getTerritories() {
        Map<Player, Set<Point>> territories = new HashMap<>();
        territories.put(Player.BLACK, new HashSet<>());
        territories.put(Player.WHITE, new HashSet<>());

        boolean[][] visited = new boolean[rows][cols];

        for (int y = 0; y < rows; y++) {
            for (int x = 0; x < cols; x++) {
                if (!visited[y][x] && isEmpty(x, y)) {
                    Set<Point> region = floodFill(x, y, visited);
                    Player owner = ownerOfRegion(region);

                    if (owner != null) {
                        territories.get(owner).addAll(region);
                    }
                }
            }
        }

        return territories;
    }

    private boolean inBounds(int x, int y) {
        return x >= 0 && x < cols && y >= 0 && y < rows;
    }

    private boolean isEmpty(int x, int y) {
        return inBounds(x, y) && board[y][x] != 'B' && board[y][x] != 'W';
    }

    private Set<Point> floodFill(int startX, int startY, boolean[][] visited) {
        Set<Point> region = new HashSet<>();

        if (!inBounds(startX, startY) || !isEmpty(startX, startY) || visited[startY][startX]) {
            return region;
        }

        ArrayDeque<Point> queue = new ArrayDeque<>();
        queue.add(new Point(startX, startY));
        visited[startY][startX] = true;

        while (!queue.isEmpty()) {
            Point point = queue.poll();
            region.add(point);

            for (int i = 0; i < DX.length; i++) {
                int nx = point.x + DX[i];
                int ny = point.y + DY[i];

                if (inBounds(nx, ny) && !visited[ny][nx] && isEmpty(nx, ny)) {
                    visited[ny][nx] = true;
                    queue.add(new Point(nx, ny));
                }
            }
        }

        return region;
    }

    private Player ownerOfRegion(Set<Point> region) {
        if (region.isEmpty()) {
            return null;
        }

        boolean black = false;
        boolean white = false;

        for (Point point : region) {
            for (int i = 0; i < DX.length; i++) {
                int nx = point.x + DX[i];
                int ny = point.y + DY[i];

                if (!inBounds(nx, ny)) {
                    continue;
                }

                char stone = board[ny][nx];

                if (stone == 'B') {
                    black = true;
                } else if (stone == 'W') {
                    white = true;
                }
            }
        }

        if (black && !white) {
            return Player.BLACK;
        }

        if (white && !black) {
            return Player.WHITE;
        }

        return null;
    }
}
