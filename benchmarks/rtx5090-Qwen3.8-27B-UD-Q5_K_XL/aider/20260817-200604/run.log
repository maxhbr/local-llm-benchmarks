private String createIou(JSONObject payload) {
   if (payload == null) return "{}";
   String lenderName = payload.optString("lender", null);
   String borrowerName = payload.optString("borrower", null);
   if (lenderName == null || borrowerName == null || !payload.has("amount")) return "{}";
   double amount = payload.getDouble("amount");
   User lender = users.get(lenderName);
   if (lender == null) { lender = User.builder().setName(lenderName).build(); users.put(lenderName, lender); }
