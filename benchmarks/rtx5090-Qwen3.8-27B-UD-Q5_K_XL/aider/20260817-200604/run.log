#include "phone_number.h"
#include <stdexcept>
#include <string>

namespace phone_number {

namespace {
bool is_allowed_punctuation(char c) {
    return c == ' ' || c == '-' || c == '.' || c == '(' || c == ')' || c == '+';
}
}

phone_number::phone_number(const std::string& input) {
    std::string digits;
    bool plus_seen = false;
    for (size_t i = 0; i < input.size(); ++i) {
        char c = input[i];
        if (c >= '0' && c <= '9') {
            digits.push_back(c);
        } else if (c == '+') {
            // plus only allowed as first character? If leading spaces? Could allow if no digits and no plus and maybe only whitespace before? Simpler: if (i != 0) 
throw; plus_seen = true;
            if (i != 0 || plus_seen) throw std::invalid_argument("invalid phone number");
            plus_seen = true;
        } else if (is_allowed_punctuation(c)) {
            // ignore
        } else {
            throw std::invalid_argument("invalid phone number");
        }
    }

    if (digits.size() == 11) {
        if (digits[0] != '1') throw std::invalid_argument("invalid phone number");
        number_ = digits.substr(1);
    } else if (digits.size() == 10) {
        number_ = digits;
    } else {
        throw std::invalid_argument("invalid phone number");
    }

    if (number_[0] < '2' || number_[0] > '9') throw ...
    if (number_[3] < '2' || number_[3] > '9') throw ...
}

std::string phone_number::number() const { return number_; }
std::string phone_number::area_code() const { return number_.substr(0,3); }
std::string phone_number::local_number() const { return number_.substr(3); }
std::string phone_number::pretty() const { return "(" + area_code() + ") " + number_.substr(3,3) + "-" + number_.substr(6); }

