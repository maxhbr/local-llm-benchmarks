Code:
use std::convert::TryFrom;

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
enum Operation {
    Add,
    Sub,
    Mul,
    Div,
    Pow,
}

pub fn answer(command: &str) -> Option<i32> {
    let command = command.trim();
    let expression = command.strip_prefix("What is ")?;
    let expression = expression.strip_suffix('?')?;
    let tokens: Vec<&str> = expression.split_whitespace().collect();

    let mut index = 0;
    let mut value = parse_number(tokens.get(0)?)?;
    index = 1;

    while index < tokens.len() {
        let operation = parse_operation(&tokens, &mut index)?;
        let operand = parse_number(tokens.get(index)?)?;
        index += 1;
        value = apply(value, operation, operand)?;
    }

    i32::try_from(value).ok()
}

fn parse_number(token: &str) -> Option<i64> {
    token.parse::<i64>().ok()
}

fn parse_operation(tokens: &[&str], index: &mut usize) -> Option<Operation> {
    let token = tokens.get(*index)?;

    if *token == "plus" {
        *index += 1;
        Some(Operation::Add)
    } else if *token == "minus" {
        *index += 1;
        Some(Operation::Sub)
    } else if *token == "multiplied" && tokens.get(*index + 1) == Some(&"by") {
        *index += 2;
        Some(Operation::Mul)
    } else if *token == "divided" && tokens.get(*index + 1) == Some(&"by") {
        *index += 2;
        Some(Operation::Div)
    } else {
        #[cfg(feature = "exponentials")]
        {
            if *token == "raised"
                && tokens.get(*index + 1) == Some(&"to")
                && tokens.get(*index + 2) == Some(&"the")
                && tokens.get(*index + 3) == Some(&"power")
                && tokens.get(*index + 4) == Some(&"of")
            {
                *index += 5;
                Some(Operation::Pow)
            } else {
                None
            }
        }
        #[cfg(not(feature = "exponentials"))]
        {
            None
        }
    }
}

fn apply(value: i64, operation: Operation, operand: i64) -> Option<i64> {
    match operation {
        Operation::Add => value.checked_add(operand),
        Operation::Sub => value.checked_sub(operand),
        Operation::Mul => value.checked_mul(operand),
        Operation::Div => {
            if operand == 0 {
                None
            } else {
                value.checked_div(operand)
            }
        }
        Operation::Pow => {
            if operand < 0 {
                None
            } else {
                let exponent = u32::try_from(operand).ok()?;
                value.checked_pow(exponent)
            }
        }
    }
}

