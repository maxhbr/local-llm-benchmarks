//
// This is only a SKELETON file for the 'Killer Sudoku Helper' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export const combinations = (cage) => {
  const [size, target, ...excluded] = cage;
  const excludedSet = new Set(excluded);
  const allowed = [];

  for (let digit = 1; digit <= 9; digit += 1) {
    if (!excludedSet.has(digit)) {
      allowed.push(digit);
    }
  }

  const result = [];

  const backtrack = (startIndex, current, currentSum) => {
    if (current.length === size) {
      if (currentSum === target) {
        result.push([...current]);
      }
      return;
    }

    for (let i = startIndex; i < allowed.length; i += 1) {
      const digit = allowed[i];
      const nextSum = currentSum + digit;

      if (nextSum > target) {
        break;
      }

      current.push(digit);
      backtrack(i + 1, current, nextSum);
      current.pop();
    }
  };

  backtrack(0, [], 0);

  result.sort((a, b) => {
    for (let i = 0; i < a.length; i += 1) {
      if (a[i] !== b[i]) {
        return a[i] - b[i];
      }
    }
    return a.length - b.length;
  });

  return result;
};
