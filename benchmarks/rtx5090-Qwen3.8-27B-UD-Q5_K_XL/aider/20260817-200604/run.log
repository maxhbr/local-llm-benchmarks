import org.json.JSONArray;
import org.json.JSONObject;

import java.math.BigDecimal;
import java.math.RoundingMode;
import java.util.ArrayList;
import java.util.Comparator;
import java.util.HashSet;
import java.util.List;
import java.util.Map;
import java.util.Set;
import java.util.TreeMap;

class RestApi {
    private final Map<String, User> users;

    RestApi(User... users) {
        this.users = new TreeMap<>();
        for (User user : users) {
            if (user != null && user.name() != null) {
                this.users.put(user.name(), user);
            }
        }
    }

    String get(String url) { return get(url, null); }

    String get(String url, JSONObject payload) {
        if ("/users".equals(url)) {
            return usersJson(getUsers(payload));
        }
        return "{}";
    }

    String post(String url, JSONObject payload) {
        if ("/add".equals(url)) {
            return addUser(payload);
        }
        if ("/iou".equals(url)) {
            return createIou(payload);
        }
        return "{}";
    }

    private List<User> getUsers(JSONObject payload) {
        List<User> result = new ArrayList<>();

        if (payload != null && payload.has("users") && !payload.isNull("users")) {
            try {
                JSONArray names = payload.getJSONArray("users");
                Set<String> seen = new HashSet<>();
                for (int i = 0; i < names.length(); i++) {
                    String name = names.getString(i);
                    if (name == null || !seen.add(name)) {
                        continue;
                    }
                    User user = users.get(name);
                    if (user != null) {
                        result.add(user);
                    }
                }
            } catch (Exception ignored) {
            }
        } else {
            result.addAll(users.values());
        }

        result.sort(Comparator.comparing(User::name, Comparator.nullsFirst(String::compareTo)));
        return result;
    }

    private String addUser(JSONObject payload) {
        if (payload == null || !payload.has("user") || payload.isNull("user")) {
            return "{}";
        }

        String name;
        try {
            name = payload.getString("user");
        } catch (Exception e) {
            return "{}";
        }

        if (name == null || name.isEmpty()) {
            return "{}";
        }

        User user = users.get(name);
        if (user == null) {
            user = User.builder().setName(name).build();
            users.put(name, user);
        }

        return userJson(user);
    }

    private String createIou(JSONObject payload) {
        if (payload == null || !payload.has("lender") || !payload.has("borrower") || !payload.has("amount")
                || payload.isNull("lender") || payload.isNull("borrower") || payload.isNull("amount")) {
            return "{}";
        }

        String lenderName;
        String borrowerName;
        double amount;
        try {
            lenderName = payload.getString("lender");
            borrowerName = payload.getString("borrower");
            amount = payload.getDouble("amount");
        } catch (Exception e) {
            return "{}";
        }

        if (lenderName == null || borrowerName == null || lenderName.isEmpty() || borrowerName.isEmpty()) {
            return "{}";
        }

        amount = normalize(amount);
        if (amount < 0.0) {
            String temp = lenderName;
            lenderName = borrowerName;
            borrowerName = temp;
            amount = -amount;
        }

        if (lenderName.equals(borrowerName)) {
            User user = users.get(lenderName);
            if (user == null) {
                user = User.builder().setName(lenderName).build();
                users.put(lenderName, user);
            }
            List<User> same = new ArrayList<>();
            same.add(user);
            return usersJson(same);
        }

        User lender = users.get(lenderName);
        if (lender == null) {
            lender = User.builder().setName(lenderName).build();
            users.put(lenderName, lender);
        }

        User borrower = users.get(borrowerName);
        if (borrower == null) {
            borrower = User.builder().setName(borrowerName).build();
            users.put(borrowerName, borrower);
        }

        if (amount > 0.0) {
            double lenderOwesBorrower = lender.getOwes(borrowerName);
            double borrowerOwesLender = borrower.getOwes(lenderName);
            double net = normalize(borrowerOwesLender + amount - lenderOwesBorrower);

            if (net > 0.0) {
                borrower.setOwes(lenderName, net);
                lender.setOwedBy(borrowerName, net);
                lender.setOwes(borrowerName, 0.0);
                borrower.setOwedBy(lenderName, 0.0);
            } else if (net < 0.0) {
                double debt = -net;
                lender.setOwes(borrowerName, debt);
                borrower.setOwedBy(lenderName, debt);
                borrower.setOwes(lenderName, 0.0);
                lender.setOwedBy(borrowerName, 0.0);
            } else {
                lender.setOwes(borrowerName, 0.0);
                borrower.setOwedBy(lenderName, 0.0);
                borrower.setOwes(lenderName, 0.0);
                lender.setOwedBy(borrowerName, 0.0);
            }
        }

        List<User> updated = new ArrayList<>();
        updated.add(lender);
        if (borrower != lender) {
            updated.add(borrower);
        }
        updated.sort(Comparator.comparing(User::name, Comparator.nullsFirst(String::compareTo)));

        return usersJson(updated);
    }

    private String usersJson(List<User> userList) {
        StringBuilder sb = new StringBuilder();
        sb.append("{\"users\":[");

        for (int i = 0; i < userList.size(); i++) {
            if (i > 0) {
                sb.append(',');
            }
            sb.append(userJson(userList.get(i)));
        }

        sb.append("]}");
        return sb.toString();
    }

    private String userJson(User user) {
        StringBuilder sb = new StringBuilder();
        sb.append('{');
