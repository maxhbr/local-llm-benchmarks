#include "sublist.h"

#include <algorithm>

namespace sublist {

namespace {

bool contains(const std::list<int>& larger, const std::list<int>& smaller) {
    if (smaller.empty()) {
        return true;
    }
    if (larger.size() < smaller.size()) {
        return false;
    }
    return std::search(larger.begin(), larger.end(), smaller.begin(), smaller.end()) !=
           larger.end();
}

}  // namespace

Comparison compare(const std::list<int>& a, const std::list<int>& b) {
    if (a == b) {
        return Comparison::EQUAL;
    }
    if (contains(a, b)) {
        return Comparison::SUPERLIST;
    }
    if (contains(b, a)) {
        return Comparison::SUBLIST;
    }
    return Comparison::UNEQUAL;
}

}  // namespace sublist
```

