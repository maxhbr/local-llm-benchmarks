class KindergartenGarden {
    private final String garden;
    KindergartenGarden(String garden) { this.garden = garden; }
    List<Plant> getPlantsOfStudent(String student) {
        int index = students.indexOf(student) * 2;
        return Arrays.asList(
            plantAt(index),
            plantAt(index + 1),
            plantAt(index + garden.length() / 2),
            plantAt(index + garden.length() / 2 + 1)
        );
    }
    private Plant plantAt(int index) {
        char c = garden.charAt(index);
        switch (c) {
            case 'G': return Plant.GRASS;
            case 'C': return Plant.CLOVER;
            case 'R': return Plant.RADISHES;
            case 'V': return Plant.VIOLETS;
            default: throw new IllegalArgumentException("Not a valid plant");
        }
    }
}
