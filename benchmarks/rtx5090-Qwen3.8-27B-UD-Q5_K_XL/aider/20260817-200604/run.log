package linkedlist

import "errors"

type Element struct {
    data int
    next *Element
}

type List struct {
    head *Element
    size int
}

func New(elements []int) *List {
    l := &List{}
    for i := len(elements) - 1; i >= 0; i-- {
        l.Push(elements[i])
    }
    return l
}

func (l *List) Size() int { return l.size }

func (l *List) Push(element int) {
    l.head = &Element{data: element, next: l.head}
    l.size++
}

func (l *List) Pop() (int, error) {
    if l.head == nil { return 0, errors.New("list is empty") }
    data := l.head.data
    l.head = l.head.next
    l.size--
    return data, nil
}

func (l *List) Array() []int {
    arr := make([]int, 0, l.size)
    for e := l.head; e != nil; e = e.next { arr = append(arr, e.data) }
    return arr
}

func (l *List) Reverse() *List {
    var prev *Element
    cur := l.head
    for cur != nil {
        next := cur.next
        cur.next = prev
        prev = cur
        cur = next
    }
    l.head = prev
    return l
}

