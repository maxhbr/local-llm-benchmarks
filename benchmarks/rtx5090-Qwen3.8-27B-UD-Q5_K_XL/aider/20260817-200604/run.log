Let's write final code:
```
export class Zipper {
  constructor(root, path = [], leftProp = 'l', rightProp = 'r') {
    this.root = root;
    this.path = path;
    this.leftProp = leftProp;
    this.rightProp = rightProp;
  }

  static fromTree(tree) {
    let leftProp = 'l';
    let rightProp = 'r';
    if (tree) {
      const has = (key) => Object.prototype.hasOwnProperty.call(tree, key);
      if (has('l') || has('r')) {
        leftProp = 'l';
        rightProp = 'r';
      } else if (has('left') || has('right')) {
        leftProp = 'left';
        rightProp = 'right';
      }
    }
    return new Zipper(tree, [], leftProp, rightProp);
  }

  toTree() {
    return this.root;
  }

  value() {
    const node = this.node();
    return node ? node.value : null;
  }

  left() {
    const node = this.node();
    if (!node) return null;
    const key = this.keyFor(node, 'left');
    if (node[key] == null) return null;
    return new Zipper(this.root, [...this.path, 'left'], this.leftProp, this.rightProp);
  }

  right() {
    const node = this.node();
    if (!node) return null;
    const key = this.keyFor(node, 'right');
    if (node[key] == null) return null;
    return new Zipper(this.root, [...this.path, 'right'], this.leftProp, this.rightProp);
  }

  up() {
    if (this.path.length === 0) return null;
    return new Zipper(this.root, this.path.slice(0, -1), this.leftProp, this.rightProp);
  }

  setValue(value) {
    const root = this.update(this.root, this.path, 'value', value);
    return new Zipper(root, this.path, this.leftProp, this.rightProp);
  }

  setLeft(tree) {
    const root = this.update(this.root, this.path, 'left', tree);
    return new Zipper(root, this.path, this.leftProp, this.rightProp);
  }

  setRight(tree) {
    const root = this.update(this.root, this.path, 'right', tree);
    return new Zipper(root, this.path, this.leftProp, this.rightProp);
  }

  node() {
    let node = this.root;
    for (const dir of this.path) {
      if (!node) return null;
      node = node[this.keyFor(node, dir)];
    }
    return node;
  }

  keyFor(node, dir) {
    const preferred = dir === 'left' ? this.leftProp : this.rightProp;
    const fallback = dir === 'left'
      ? (this.leftProp === 'l' ? 'left' : 'l')
      : (this.rightProp === 'r' ? 'right' : 'r');

    if (node && node[preferred] !== undefined) return preferred;
    if (node && node[fallback] !== undefined) return fallback;
    return preferred;
  }

  update(node, path, setDir, value) {
    if (node == null) return node;

    if (path.length === 0) {
      if (setDir === 'value') {
        return { ...node, value };
      }
      const key = this.keyFor(node, setDir);
      return { ...node, [key]: value };
    }

    const [dir, ...rest] = path;
    const key = this.keyFor(node, dir);
    const updatedChild = this.update(node[key], rest, setDir, value);
    return { ...node, [key]: updatedChild };
  }
}
```

