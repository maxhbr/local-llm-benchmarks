Pseudo:
class Scale:
    SHARP_CHROMATIC = ('A', 'A#', 'B', 'C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#')
    FLAT_CHROMATIC = ('A', 'Bb', 'B', 'C', 'Db', 'D', 'Eb', 'E', 'F', 'Gb', 'G', 'Ab')
    FLAT_TONICS = {'F', 'f', 'Bb', 'bb', 'Eb', 'eb', 'Ab', 'ab', 'Db', 'db', 'Gb', 'gb', 'd', 'g', 'c'}
    # Maybe include 'C'? No. 'a'? No.

    def __init__(self, tonic):
        self._original = tonic.strip()
        self.tonic = self._normalize(self._original)
        self._use_flats = self._key(self._original) in self.FLAT_TONICS

    @staticmethod
    def _normalize(note):
        note = note.strip()
        if not note:
            return note
        last = note[-1]
        if last in ('#', '♯'):
            return note[0].upper() + '#'
        if last in ('b', '♭'):
            # But if note is 'B' natural? last 'B' not in. If note is 'b' natural? last 'b' in, length 1. Need not treat as flat.
            if len(note) > 1:
                return note[0].upper() + 'b'
        return note[0].upper()

    @staticmethod
    def _key(note):
        note = note.strip()
        if not note: return note
        last = note[-1]
        if last in ('#', '♯'):
            return note[0] + '#'
        if last in ('b', '♭') and len(note) > 1:
            return note[0] + 'b'
        return note[0]

