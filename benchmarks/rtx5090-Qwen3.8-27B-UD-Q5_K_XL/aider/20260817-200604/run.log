```
def can_chain(dominoes):
    """
    Return True if the given dominoes can be arranged into a closed chain.

    This is equivalent to checking whether the multigraph formed by the
    dominoes has an Eulerian circuit:
    - every vertex with nonzero degree has even degree
    - all vertices with nonzero degree are in one connected component
    """
    if dominoes is None:
        return True

    degree = {}
    adjacency = {}

    for left, right in dominoes:
        degree[left] = degree.get(left, 0) + 1
        degree[right] = degree.get(right, 0) + 1

        adjacency.setdefault(left, []).append(right)
        adjacency.setdefault(right, []).append(left)

    if not degree:
        return True

    if any(count % 2 != 0 for count in degree.values()):
        return False

    start = next(iter(degree))
    visited = {start}
    stack = [start]

    while stack:
        current = stack.pop()
        for neighbor in adjacency.get(current, []):
            if neighbor not in visited:
                visited.add(neighbor)
                stack.append(neighbor)

    return len(visited) == len(degree)
```
