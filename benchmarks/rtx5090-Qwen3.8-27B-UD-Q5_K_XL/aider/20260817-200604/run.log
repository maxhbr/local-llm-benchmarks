Let's draft final lib.rs:
```
pub struct Luhn {
    digits: Vec<u32>,
    valid: bool,
}

impl Luhn {
    pub fn is_valid(&self) -> bool {
        if !self.valid || self.digits.len() < 2 {
            return false;
        }

        let sum: u64 = self
            .digits
            .iter()
            .rev()
            .enumerate()
            .map(|(position, &digit)| {
                let digit = u64::from(digit);
                if position % 2 == 1 {
                    let doubled = digit * 2;
                    if doubled > 9 {
                        doubled - 9
                    } else {
                        doubled
                    }
                } else {
                    digit
                }
            })
            .sum();

        sum % 10 == 0
    }

    fn from_str(s: &str) -> Self {
        let mut digits = Vec::new();
        let mut valid = true;

        for c in s.chars() {
            if c.is_ascii_digit() {
                digits.push(c.to_digit(10).unwrap());
            } else if c == ' ' {
                // Spaces are ignored.
            } else {
                valid = false;
            }
        }

        Luhn { digits, valid }
    }

    fn from_uint<T: std::fmt::Display>(value: T) -> Self {
        let s = value.to_string();
        let digits = s.bytes().map(|b| u32::from(b - b'0')).collect();
        Luhn { digits, valid: true }
    }
}

impl From<&str> for Luhn {
    fn from(input: &str) -> Self {
        Luhn::from_str(input)
    }
}

impl From<String> for Luhn {
    fn from(input: String) -> Self {
        Luhn::from_str(&input)
    }
}

macro_rules! impl_from_uint {
    ($($ty:ty),+ $(,)?) => {
        $(
            impl From<$ty> for Luhn {
                fn from(value: $ty) -> Self {
                    Luhn::from_uint(value)
                }
            }
        )+
    };
}

impl_from_uint!(u8, u16, u32, u64, u128, usize);
