Implement with_attrs:
```
pub fn with_attrs<I, A>(mut self, attrs: I) -> Self
where I: IntoIterator<Item = A>, A: IntoAttr
{
    for item in attrs {
        let (k, v) = item.into_attr();
        self.attrs.insert(k, v);
    }
    self
}
```
