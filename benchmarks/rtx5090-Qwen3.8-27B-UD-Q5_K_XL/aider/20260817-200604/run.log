Let's consider alternative implementation using `Map` and `Set` to be cleaner:
```
export class GradeSchool {
  constructor() {
    this.students = new Map();
    this.names = new Set();
  }
  roster() {
    const result = {};
    [...this.students.keys()].sort((a,b)=>a-b).forEach(grade => {
      result[grade] = [...this.students.get(grade)].sort();
    });
    return result;
  }
  add(name, grade) {
    if (this.names.has(name)) return false;
    if (!this.students.has(grade)) this.students.set(grade, new Set());
    this.students.get(grade).add(name);
    this.names.add(name);
    return true;
  }
  grade(grade) {
    const set = this.students.get(grade);
    return set ? [...set].sort() : [];
  }
}
```
