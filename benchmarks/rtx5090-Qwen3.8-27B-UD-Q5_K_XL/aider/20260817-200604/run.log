use std::collections::HashMap;

pub fn solve(input: &str) -> Option<HashMap<char, u8>> {
    let (addends, result) = parse(input)?;
    // collect letters
    let mut letters: Vec<char> = Vec::new();
    let mut index: HashMap<char, usize> = HashMap::new();
    let mut get_idx = |c: char| -> usize { ... } // can't closure mutable easily; do manually.
    for word in addends.iter().chain(result.iter()) { for &c in word { if !index.contains_key(&c) { index.insert(c, letters.len()); letters.push(c); } } }
    if letters.len() > 10 { return None; }
    let mut leading = vec![false; letters.len()];
    for word in addends.iter().chain(result.iter()) {
       if word.len() > 1 {
          let c = word[0];
          leading[index[&c]] = true;
       }
    }
    // maybe validate all chars alphabetic? not necessary.
    // Convert words to indices
    let add_idx: Vec<Vec<usize>> = addends.iter().map(|w| w.iter().map(|&c| index[&c]).collect()).collect();
    let res_idx: Vec<usize> = result.iter().map(|&c| index[&c]).collect();
    let max_len = add_idx.iter().map(|w| w.len()).max().unwrap_or(0).max(res_idx.len());
    let mut assignment: Vec<Option<usize>>? Actually digit per letter: Vec<Option<u8>> length n.
    let mut used = [false; 10];
    backtrack(0, 0, &add_idx, &res_idx, &mut assignment, &mut used, &leading, &letters)
}
```
