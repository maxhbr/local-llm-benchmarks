Let's design code:
```
const DIGITS = {
  ' _ \n| |\n|_|\n   ': '0',
  '   \n  |\n  |\n   ': '1',
  ' _ \n _|\n|_ \n   ': '2',
  ' _ \n _|\n _|\n   ': '3',
  '   \n|_|\n  |\n   ': '4',
  ' _ \n|_ \n _|\n   ': '5',
  ' _ \n|_ \n|_|\n   ': '6',
  ' _ \n  |\n  |\n   ': '7',
  ' _ \n|_|\n|_|\n   ': '8',
  ' _ \n|_|\n _|\n   ': '9',
};

const normalizeBlock = (lines) => {
  const maxLen = Math.max(...lines.map(l => l.length));
  if (maxLen % 3 !== 0) throw new Error('Input must have 4 lines and line-length must be a multiple of 3');
  return lines.map(line => {
    if (line.length === 0) return ' '.repeat(maxLen);
    if (line.length !== maxLen) throw new Error('Input must have 4 lines and line-length must be a multiple of 3');
    return line;
  });
};

const convertBlock = (lines) => {
  const normalized = normalizeBlock(lines);
  const width = normalized[0].length;
  const digits = [];
  for (let x=0; x<width; x+=3) {
    const pattern = normalized.map(line => line.slice(x, x+3)).join('\n');
    digits.push(DIGITS[pattern] || '?');
  }
  return digits.join('');
};

export const convert = (input = '') => {
  let lines = String(input).split(/\r?\n/);
  if (lines.length % 4 === 1 && lines[lines.length-1] === '') lines.pop();
  if (lines.length === 0 || lines.length % 4 !== 0) throw new Error(...);
  const results = [];
  for (let i=0; i<lines.length; i+=4) {
    results.push(convertBlock(lines.slice(i, i+4)));
  }
  return results.join(',');
};
```

