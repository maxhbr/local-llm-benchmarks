class BuildTree {
    TreeNode buildTree(ArrayList<Record> records) throws InvalidRecordsException {
        if (records == null) { return null; } // optional
        int n = records.size();
        if (n == 0) return null;

        ArrayList<Record> sortedRecords = new ArrayList<>(records);
        sortedRecords.sort(Comparator.comparing(Record::getRecordId));

        TreeNode[] nodes = new TreeNode[n];

        for (Record record : sortedRecords) {
            int id = record.getRecordId();
            int parentId = record.getParentId();

            if (id < 0 || id >= n) throw new InvalidRecordsException("Invalid Records");
            if (nodes[id] != null) throw new InvalidRecordsException("Invalid Records");

            if (id == 0) {
                if (parentId != 0) throw ...;
            } else {
                if (parentId < 0 || parentId >= id) throw ...;
            }

            nodes[id] = new TreeNode(id);
        }

        if (nodes[0] == null) throw ...;

        for (Record record : sortedRecords) {
            int id = record.getRecordId();
            if (id == 0) continue;
            int parentId = record.getParentId();
            TreeNode parent = nodes[parentId];
            if (parent == null) throw ...;
            parent.getChildren().add(nodes[id]);
        }

        return nodes[0];
    }
}

