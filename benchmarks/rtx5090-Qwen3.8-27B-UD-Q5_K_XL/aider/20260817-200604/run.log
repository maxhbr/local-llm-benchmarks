export class Zipper {
  constructor(root, path = [], leftProp = 'l', rightProp = 'r') { ... }
  static fromTree(tree) { ... }
  toTree() { return this.root; }
  value() { const n = this.node(); return n ? n.value : null; }
  node() { let n = this.root; for (const dir of this.path) { if (!n) return null; n = n[this.keyFor(n, dir)]; } return n; }
  left() { const n = this.node(); if (!n) return null; const key = this.keyFor(n, 'left'); if (n[key] == null) return null; return new Zipper(this.root, 
[...this.path, 'left'], this.leftProp, this.rightProp); }
  right() ...
  up() { if (!this.path.length) return null; return new Zipper(this.root, this.path.slice(0,-1), this.leftProp, this.rightProp); }
  setValue(value) { return new Zipper(this.update(this.root, this.path, 'value', value), this.path, this.leftProp, this.rightProp); }
  setLeft(tree) { return new Zipper(this.update(this.root, this.path, 'left', tree), this.path, this.leftProp, this.rightProp); }
  setRight(tree) { ... }
  keyFor(node, dir) { ... }
  update(node, path, setDir, value) {
    if (!node) return node;
    if (path.length === 0) {
      if (setDir === 'value') return { ...node, value };
      const key = this.keyFor(node, setDir);
      return { ...node, [key]: value };
    }
    const [dir, ...rest] = path;
    const key = this.keyFor(node, dir);
    const updatedChild = this.update(node[key], rest, setDir, value);
    return { ...node, [key]: updatedChild };
  }
}
```
