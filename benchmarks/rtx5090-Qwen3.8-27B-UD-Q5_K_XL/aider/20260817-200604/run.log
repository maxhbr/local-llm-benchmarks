import re

class StackUnderflowError(Exception):
    """Exception raised when the stack does not contain enough items."""

    def __init__(self, message="Insufficient number of items in stack"):
        super().__init__(message)
        self.message = message


_NUMBER_RE = re.compile(r"^[+-]?\d+$")


def _is_number(token):
    return bool(_NUMBER_RE.match(token))


def _require_items(stack, count):
    if len(stack) < count:
        raise StackUnderflowError("Insufficient number of items in stack")


def _truncated_divide(a, b):
    quotient = abs(a) // abs(b)
    if (a < 0) != (b < 0):
        quotient = -quotient
    return quotient


def _add(stack):
    _require_items(stack, 2)
    b = stack.pop()
    a = stack.pop()
    stack.append(a + b)


def _subtract(stack):
    _require_items(stack, 2)
    b = stack.pop()
    a = stack.pop()
    stack.append(a - b)


def _multiply(stack):
    _require_items(stack, 2)
    b = stack.pop()
    a = stack.pop()
    stack.append(a * b)


def _divide(stack):
    _require_items(stack, 2)
    b = stack.pop()
    a = stack.pop()
    if b == 0:
        raise ZeroDivisionError("divide by zero")
    stack.append(_truncated_divide(a, b))


def _dup(stack):
    _require_items(stack, 1)
    stack.append(stack[-1])


def _drop(stack):
    _require_items(stack, 1)
    stack.pop()


def _swap(stack):
    _require_items(stack, 2)
    stack[-1], stack[-2] = stack[-2], stack[-1]


def _over(stack):
    _require_items(stack, 2)
    stack.append(stack[-2])


_BUILTINS = {
    "+": _add,
    "-": _subtract,
    "*": _multiply,
    "/": _divide,
    "dup": _dup,
    "drop": _drop,
    "swap": _swap,
    "over": _over,
}


def _execute(token, stack, definitions):
    if _is_number(token):
        stack.append(int(token))
        return

    key = token.lower()

    if key in definitions:
        for definition_token in definitions[key]:
            _execute(definition_token, stack, definitions)
    elif key in _BUILTINS:
        _BUILTINS[key](stack)
    else:
        raise ValueError("undefined operation")


def evaluate(input_data):
    if isinstance(input_data, (list, tuple)):
        tokens = [str(token) for token in input_data]
    else:
        tokens = input_data.split()

    stack = []
    definitions = {}
    index = 0

    while index < len(tokens):
        token = tokens[index]

        if token == ":":
            index += 1
            if index >= len(tokens):
                raise ValueError("illegal operation")

            name = tokens[index]
            index += 1

            if _is_number(name):
                raise ValueError("illegal operation")

            definition = []
            closed = False

            while index < len(tokens):
                if tokens[index] == ";":
                    closed = True
                    index += 1
                    break

                definition_token = tokens[index]
                definition.append(
                    definition_token.lower() if not _is_number(definition_token) else definition_token
                )
                index += 1

            if not closed:
                raise ValueError("illegal operation")

            definitions[name.lower()] = definition
        else:
            _execute(token, stack, definitions)
            index += 1

    return stack
```

