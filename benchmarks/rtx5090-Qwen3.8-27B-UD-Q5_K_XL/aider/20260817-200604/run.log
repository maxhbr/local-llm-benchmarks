response:
Needed changes: implement random name generation in the required `AA000` format, make the name lazily generated when first requested, add a `reset` method that wipes the current name, and track used names so existing robots do not collide.

robot_name.py
```
import random
import string


class Robot:
    _used_names = set()
    _total_names = 26 * 26 * 1000

    def __init__(self):
        self._name = None

    @property
    def name(self):
        if self._name is None:
            self._name = self._generate_name()
        return self._name

    @name.setter
    def name(self, value):
        if value is not None:
            Robot._used_names.add(value)
        self._name = value

    @name.deleter
    def name(self):
        self._name = None

    def reset(self):
        self._name = None

    @classmethod
    def _generate_name(cls):
        if len(cls._used_names) >= cls._total_names:
            raise RuntimeError("No unique robot names available")

        while True:
            name = (
                random.choice(string.ascii_uppercase)
                + random.choice(string.ascii_uppercase)
                + random.choice(string.digits)
                + random.choice(string.digits)
                + random.choice(string.digits)
            )

            if name not in cls._used_names:
                cls._used_names.add(name)
                return name
```
