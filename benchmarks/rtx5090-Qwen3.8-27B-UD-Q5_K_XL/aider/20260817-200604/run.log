Robot::~Robot() {
    std::lock_guard<std::mutex> lock(mutex());
    if (!name_.empty()) used_names().erase(name_);
}

std::string Robot::name() {
    std::lock_guard<std::mutex> lock(mutex());
    if (name_.empty()) {
       name_ = generate_unique_name();
       used_names().insert(name_);
    }
    return name_;
}

void Robot::reset() {
    std::lock_guard<std::mutex> lock(mutex());
    std::string old_name = std::move(name_);
    if (!old_name.empty()) used_names().erase(old_name);
    name_ = generate_unique_name(old_name);
    used_names().insert(name_);
}

}

