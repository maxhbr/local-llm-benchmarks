```
const SHARP_NOTES = ['C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#', 'A', 'A#', 'B'];
const FLAT_NOTES = ['C', 'Db', 'D', 'Eb', 'E', 'F', 'Gb', 'G', 'Ab', 'A', 'Bb', 'B'];
const BASE_INDEX = { C: 0, D: 2, E: 4, F: 5, G: 7, A: 9, B: 11 };
const INTERVAL_STEPS = { m: 1, M: 2, A: 3 };

function normalizeTonic(tonic) {
  const t = tonic.trim();
  const letter = t[0].toUpperCase();
  const accidental = t.slice(1);
  if (accidental === 'b' || accidental === 'B') {
    return letter + 'b';
  }
  if (accidental === '#') {
    return letter + '#';
  }
  return letter;
}

function isFlatTonic(tonic) {
  const t = tonic.trim();
  const letter = t[0].toUpperCase();
  const accidental = t.slice(1);

  if (accidental === 'b' || accidental === 'B') {
    return true;
  }
  if (accidental === '#') {
    return false;
  }

  switch (letter) {
    case 'F':
      return true;
    case 'C':
      return t[0] === 'c';
    case 'D':
      return t[0] === 'd';
    case 'G':
      return t[0] === 'g';
    default:
      return false;
  }
}

function noteIndex(tonic) {
  const t = tonic.trim();
  const letter = t[0].toUpperCase();
  const accidental = t.slice(1);
  const base = BASE_INDEX[letter];

  if (accidental === '#') {
    return (base + 1) % 12;
  }
  if (accidental === 'b' || accidental === 'B') {
    return (base + 11) % 12;
  }
  return base;
}

export class Scale {
  constructor(tonic) {
    this.flat = isFlatTonic(tonic);
    this.notes = this.flat ? FLAT_NOTES : SHARP_NOTES;
    this.tonicIndex = noteIndex(tonic);
    this.tonicName = this.notes[this.tonicIndex];
  }

  chromatic() {
    return Array.from({ length: 12 }, (_, i) => this.notes[(this.tonicIndex + i) % 12]);
  }

  interval(intervals) {
    const result = [this.tonicName];
    let index = this.tonicIndex;

    for (const interval of intervals) {
      const step = INTERVAL_STEPS[interval] || 0;
      index = (index + step) % 12;
      result.push(this.notes[index]);
    }

    return result;
  }
}
```

