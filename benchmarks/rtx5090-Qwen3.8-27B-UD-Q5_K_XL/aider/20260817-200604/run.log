```
import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Locale;
import java.util.Map;

class ForthEvaluator {
    private final Map<String, List<String>> definitions = new HashMap<>();
    private final List<Integer> stack = new ArrayList<>();

    List<Integer> evaluateProgram(List<String> input) {
        definitions.clear();
        stack.clear();

        int i = 0;
        while (i < input.size()) {
            String token = normalize(input.get(i));
            if (token.equals(":")) {
                i = parseDefinition(input, i);
            } else {
                execute(token);
                i++;
            }
        }

        return new ArrayList<>(stack);
    }

    private int parseDefinition(List<String> input, int start) {
        if (start + 2 >= input.size()) {
            throw new IllegalArgumentException("Invalid definition");
        }

        String name = normalize(input.get(start + 1));
        if (name.isEmpty() || isNumber(name) || name.equals(":") || name.equals(";")) {
            throw new IllegalArgumentException("Invalid definition");
        }

        List<String> body = new ArrayList<>();
        int i = start + 2;
        while (i < input.size()) {
            String token = normalize(input.get(i));
            if (token.equals(";")) {
                definitions.put(name, body);
                return i + 1;
            }
            if (token.equals(":")) {
                throw new IllegalArgumentException("Invalid definition");
            }
            body.add(token);
            i++;
        }

        throw new IllegalArgumentException("Invalid definition");
    }

    private void execute(String token) {
        if (isNumber(token)) {
            push(Integer.parseInt(token));
            return;
        }

        List<String> definition = definitions.get(token);
        if (definition != null) {
            for (String bodyToken : definition) {
                execute(bodyToken);
            }
            return;
        }

        switch (token) {
            case "+": {
                requireTwo();
                int b = pop();
                int a = pop();
                push(a + b);
                break;
            }
            case "-": {
                requireTwo();
                int b = pop();
                int a = pop();
                push(a - b);
                break;
            }
            case "*": {
                requireTwo();
                int b = pop();
                int a = pop();
                push(a * b);
                break;
            }
            case "/": {
                requireTwo();
                int b = pop();
                if (b == 0) {
                    throw new IllegalArgumentException("Division by zero");
                }
                int a = pop();
                push(a / b);
                break;
            }
            case "dup": {
                if (stack.isEmpty()) {
                    throw new IllegalArgumentException("Insufficient stack");
                }
                push(stack.get(stack.size() - 1));
                break;
            }
            case "drop": {
                pop();
                break;
            }
            case "swap": {
                requireTwo();
                int size = stack.size();
                int first = stack.get(size - 2);
                int second = stack.get(size - 1);
                stack.set(size - 2, second);
                stack.set(size - 1, first);
                break;
            }
            case "over": {
                requireTwo();
                push(stack.get(stack.size() - 2));
                break;
            }
            default:
                throw new IllegalArgumentException("Unknown word");
        }
    }

    private void requireTwo() {
        if (stack.size() < 2) {
            throw new IllegalArgumentException("Insufficient stack");
        }
    }

    private int pop() {
        if (stack.isEmpty()) {
            throw new IllegalArgumentException("Insufficient stack");
        }
        return stack.remove(stack.size() - 1);
    }

    private void push(int value) {
        stack.add(value);
    }

    private boolean isNumber(String token) {
        if (token.isEmpty()) {
            return false;
        }
        for (int i = 0; i < token.length(); i++) {
            char c = token.charAt(i);
            if (c < '0' || c > '9') {
                return false;
            }
        }
        return true;
    }

    private String normalize(String token) {
        return token.toLowerCase(Locale.ROOT);
    }
}
