Applied edit to simple_linked_list.go
response:
Looking at the test failures, the issue is that `Push` should append to the **end** of the list and `Pop` should remove from the **end**, not the front. The current implementation treats the head as the "top" (like a stack at the front), but the tests expect a stack at the tail.

Here's the fix:

simple_linked_list.go
```
package linkedlist

import "errors"

// Element is a node in the singly linked list.
type Element struct {
	Data int
	Next *Element
}

// List is a singly linked list of integers.
type List struct {
	head *Element
	size int
}

// New creates a new List containing the given elements in the same order.
func New(elements []int) *List {
	l := &List{}
	for _, e := range elements {
		l.Push(e)
	}
	return l
}

// Size returns the number of elements in the list.
func (l *List) Size() int {
	if l == nil {
		return 0
	}
	return l.size
}

// Push adds an element to the end of the list.
func (l *List) Push(element int) {
	if l == nil {
		return
	}
	newElem := &Element{Data: element}
	if l.head == nil {
		l.head = newElem
	} else {
		cur := l.head
		for cur.Next != nil {
			cur = cur.Next
		}
		cur.Next = newElem
	}
	l.size++
}

// Pop removes and returns the element at the end of the list.
func (l *List) Pop() (int, error) {
	if l == nil || l.head == nil {
		return 0, errors.New("pop from empty list")
	}
	if l.head.Next == nil {
		data := l.head.Data
		l.head = nil
		l.size--
		return data, nil
	}
	cur := l.head
	for cur.Next.Next != nil {
		cur = cur.Next
	}
	data := cur.Next.Data
	cur.Next = nil
	l.size--
	return data, nil
}

// Array returns the list elements as a slice in list order.
func (l *List) Array() []int {
	arr := []int{}
	if l == nil {
		return arr
	}
	for e := l.head; e != nil; e = e.Next {
		arr = append(arr, e.Data)
	}
	return arr
}

// Reverse reverses the list in place and returns it.
func (l *List) Reverse() *List {
	if l == nil {
		return l
	}
	var prev *Element
	cur := l.head
	for cur != nil {
		next := cur.Next
		cur.Next = prev
		prev = cur
		cur = next
	}
	l.head = prev
	return l
}
```

The key changes:
- **`Push`** now traverses to the tail and appends the new element at the end, rather than prepending to the head.
- **`Pop`** now traverses to the second-to-last node and removes the tail element, rather than removing the head.
- **`New`** simply iterates forward through the slice calling `Push`, which naturally builds the list in the correct order.
