            case "violet": return 7;
            case "grey":
            case "gray": return 8;
            case "white": return 9;
            default: throw new IllegalArgumentException("Unknown color: " + color);
        }
    }

    private long pow10(int exponent) {
        long result = 1;
        for (int i = 0; i < exponent; i++) result *= 10;
        return result;
    }
}
