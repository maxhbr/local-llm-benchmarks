class Scale:
    def __init__(self, tonic):
        self.tonic = tonic
        self.flat = tonic in ['F', 'Bb', 'Eb', 'Ab', 'Db', 'Gb', 'd', 'g', 'c', 'f', 'Bb', 'Eb']
    def chromatic(self):
        if self.flat:
            scale = ['A', 'Bb', 'B', 'C', 'Db', 'D', 'Eb', 'E', 'F', 'Gb', 'G', 'Ab']
        else:
            scale = ['A', 'A#', 'B', 'C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#']
        i = scale.index(self.tonic)
        return scale[i:] + scale[:i]
    def interval(self, intervals):
        scale = self.chromatic()
        notes = [self.tonic]
        for interval in intervals:
            if interval == 'm':
                notes.append(scale[(scale.index(notes[-1]) + 1) % 12])
            elif interval == 'M':
                notes.append(scale[(scale.index(notes[-1]) + 2) % 12])
            elif interval == 'A':
                notes.append(scale[(scale.index(notes[-1]) + 3) % 12])
        return notes
