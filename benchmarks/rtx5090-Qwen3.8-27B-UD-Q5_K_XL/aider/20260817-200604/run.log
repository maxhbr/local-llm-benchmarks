use std::collections::HashSet;
use std::sync::Mutex;
use std::time::{SystemTime, UNIX_EPOCH};

pub struct Robot {
    name: String,
}

struct NameGenerator {
    used: HashSet<String>,
    state: u64,
}

static GENERATOR: Mutex<Option<NameGenerator>> = Mutex::new(None);

impl NameGenerator {
    fn new() -> Self {
        let time = SystemTime::now()
            .duration_since(UNIX_EPOCH)
            .map(|duration| duration.as_nanos() as u64)
            .unwrap_or(0);

        let process = std::process::id() as u64;
        let address = &GENERATOR as *const _ as usize as u64;

        let mut state = time
            .wrapping_mul(0x9e3779b97f4a7c15)
            ^ process.wrapping_mul(0xbf58476d1ce4e5b9)
            ^ address.wrapping_mul(0x94d049bb133111eb);

        if state == 0 {
            state = 0x9e3779b97f4a7c15;
        }

        NameGenerator {
            used: HashSet::new(),
            state,
        }
    }

    fn next_u64(&mut self) -> u64 {
        self.state = self.state.wrapping_add(0x9e3779b97f4a7c15);
        let mut z = self.state;
        z = (z ^ (z >> 30)).wrapping_mul(0xbf58476d1ce4e5b9);
        z = (z ^ (z >> 27)).wrapping_mul(0x94d049bb133111eb);
        z ^ (z >> 31)
    }

    fn generate_name(&mut self) -> String {
        const TOTAL_NAMES: u64 = 26 * 26 * 1000;

        loop {
            let index = (self.next_u64() % TOTAL_NAMES) as u32;
            let letters = index / 1000;
            let digits = index % 1000;

            let first = b'A' + (letters / 26) as u8;
            let second = b'A' + (letters % 26) as u8;

            let name = format!(
                "{}{}{:03}",
                char::from(first),
                char::from(second),
                digits
            );

            if !self.used.contains(&name) {
                self.used.insert(name.clone());
                return name;
            }
        }
    }
}

fn with_generator<F, R>(f: F) -> R
where
    F: FnOnce(&mut NameGenerator) -> R,
{
    let mut guard = GENERATOR
        .lock()
        .unwrap_or_else(|poisoned| poisoned.into_inner());

    if guard.is_none() {
        *guard = Some(NameGenerator::new());
    }

    f(guard.as_mut().expect("generator initialized"))
}

impl Robot {
    pub fn new() -> Self {
        let name = with_generator(|generator| generator.generate_name());
        Robot { name }
    }

    pub fn name(&self) -> &str {
        &self.name
    }

    pub fn reset_name(&mut self) {
        let name = with_generator(|generator| generator.generate_name());
        self.name = name;
    }
}
```

