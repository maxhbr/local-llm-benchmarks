Could implement `_call_compute_function` with try/except and inspect to minimize masking. Let's write robust:
```
def _call_compute_function(func, values):
    try:
        sig = inspect.signature(func)
    except (TypeError, ValueError):
        try:
            return func(*values)
        except TypeError:
            return func(values)
    params = list(sig.parameters.values())
    positional = [p for p in params if p.kind in (inspect.Parameter.POSITIONAL_ONLY, inspect.Parameter.POSITIONAL_OR_KEYWORD)]
    has_var_positional = any(p.kind == inspect.Parameter.VAR_POSITIONAL for p in params)
    if has_var_positional:
        return func(*values)
    if len(positional) == len(values):
        return func(*values)
    if len(positional) == 1 and len(values) != 1:
        return func(values)
    # If there are enough defaults to accept *values, try that first.
    try:
        return func(*values)
    except TypeError:
        return func(values)
```
