import java.util.HashMap;
import java.util.HashSet;
import java.util.List;
import java.util.Map;
import java.util.Set;

public class Satellite {
    public Tree treeFromTraversals(List<Character> preorderInput, List<Character> inorderInput) {
        if (preorderInput == null || inorderInput == null) {
            if (preorderInput == null && inorderInput == null) {
                return null;
            }
            throw new IllegalArgumentException("Preorder and inorder traversals must both be provided.");
        }

        int size = preorderInput.size();
        if (size != inorderInput.size()) {
            throw new IllegalArgumentException("Preorder and inorder traversals must have the same size.");
        }

        if (size == 0) {
            return null;
        }

        Map<Character, Integer> inorderIndex = new HashMap<>();
        for (int i = 0; i < size; i++) {
            Character value = inorderInput.get(i);
            if (inorderIndex.put(value, i) != null) {
                throw new IllegalArgumentException("Inorder traversal contains duplicate values.");
            }
        }

        Set<Character> seen = new HashSet<>();
        for (Character value : preorderInput) {
            if (!seen.add(value)) {
                throw new IllegalArgumentException("Preorder traversal contains duplicate values.");
            }
        }

        return build(preorderInput, inorderIndex, 0, size, 0, size);
    }

    private Tree build(List<Character> preorder,
                       Map<Character, Integer> inorderIndex,
                       int preorderStart,
                       int preorderEnd,
                       int inorderStart,
                       int inorderEnd) {
        if (preorderStart >= preorderEnd) {
            return null;
        }

        Character rootValue = preorder.get(preorderStart);
        Integer rootIndex = inorderIndex.get(rootValue);

        if (rootIndex == null || rootIndex < inorderStart || rootIndex >= inorderEnd) {
            throw new IllegalArgumentException("Preorder and inorder traversals do not match.");
        }

        int leftSize = rootIndex - inorderStart;
        int rightSize = inorderEnd - rootIndex - 1;

        if (leftSize + 1 + rightSize != preorderEnd - preorderStart) {
            throw new IllegalArgumentException("Preorder and inorder traversals do not match.");
        }

        Tree left = build(
            preorder,
            inorderIndex,
            preorderStart + 1,
            preorderStart + 1 + leftSize,
            inorderStart,
            rootIndex
        );

        Tree right = build(
            preorder,
            inorderIndex,
            preorderStart + 1 + leftSize,
            preorderEnd,
            rootIndex + 1,
            inorderEnd
        );

        return new Tree(new Node(rootValue, left, right));
    }
}
```
