Pseudo:
class ForthEvaluator {
  private final Map<String, List<Runnable>> definitions = new HashMap<>();
  private final List<Integer> stack = new ArrayList<>();

  List<Integer> evaluateProgram(List<String> input) {
    definitions.clear();
    stack.clear();
    List<String> tokens = new ArrayList<>();
    if (input != null) {
      for (String s : input) {
        if (s == null) continue;
        for (String part : s.trim().split("\\s+")) {
          if (!part.isEmpty()) tokens.add(normalize(part));
        }
      }
    }
    int i=0;
    while (i < tokens.size()) {
      String token = tokens.get(i);
      if (token.equals(":")) {
        i = parseDefinition(tokens, i);
      } else {
        executeToken(token);
        i++;
      }
    }
    return new ArrayList<>(stack);
  }

  private int parseDefinition(List<String> tokens, int start) {
    if (start + 2 >= tokens.size()) throw new IllegalArgumentException("Invalid definition"); // maybe not tested
    String name = tokens.get(start+1);
    if (name.isEmpty() || isNumber(name)) throw new IllegalArgumentException("Cannot redefine numbers"); // if empty? maybe "Invalid definition"
    List<Runnable> body = new ArrayList<>();
    int i = start+2;
    while (i < tokens.size()) {
      String token = tokens.get(i);
      if (token.equals(";")) {
        definitions.put(name, body);
        return i+1;
      }
      if (token.equals(":")) {
        throw new IllegalArgumentException("Invalid definition"); // maybe not tested
      }
      body.add(compileToken(token));
      i++;
    }
    throw new IllegalArgumentException("Invalid definition");
  }

  private void executeToken(String token) {
    compileToken(token).run();
  }

  private Runnable compileToken(String token) {
    if (isNumber(token)) {
      int value = Integer.parseInt(token);
      return () -> push(value);
    }
    List<Runnable> def = definitions.get(token);
    if (def != null) {
      final List<Runnable> captured = def;
      return () -> executeActions(captured);
    }
    switch (token) {
      case "+": return () -> { requireTwo("Addition requires that the stack contain at least 2 values"); int b=pop(); int a=pop(); push(a+b); };
...
    }
    return () -> { throw new IllegalArgumentException("No definition available for operator \"" + token + "\""); };
  }

  private void executeActions(List<Runnable> actions) { for (Runnable action : actions) action.run(); }

  private void requireTwo(String message) { if (stack.size() < 2) throw new IllegalArgumentException(message); }
  private void requireOne(String message) { if (stack.isEmpty()) throw new IllegalArgumentException(message); }
  private int pop() { if (stack.isEmpty()) throw new IllegalArgumentException("Dropping requires that the stack contain at least 1 value")? But pop used by operations
after require, and drop. For drop, need message Dropping. For operations, require already checked. But if pop called from require? We can have popNoCheck? Simpler: 
pop() throws "Dropping..."? But if arithmetic require fails, it throws specific before pop. If some bug, not. For drop, call requireOne("Dropping...") then popRaw. 
Use popRaw no check or check generic. Let's implement:
  private int pop() { if (stack.isEmpty()) throw new IllegalArgumentException("Dropping requires that the stack contain at least 1 value"); return 
stack.remove(stack.size()-1); }
But for arithmetic, requireTwo specific, then pop safe. For division, requireTwo specific, then pop b, pop a. Good. For drop, requireOne specific then pop safe. Could
just pop with generic but not used after require. Fine.
  private void push(int value) { stack.add(value); }

  private boolean isNumber(String token) {
    if (token.isEmpty()) return false;
    int start = 0;
    if (token.charAt(0) == '-') {
      if (token.length() == 1) return false;
      start = 1;
    }
    for (int i=start; i<token.length(); i++) if (!Character.isDigit(token.charAt(i))) return false; // ASCII digits? Use c>='0'&&c<='9'
    return true;
  }
}

