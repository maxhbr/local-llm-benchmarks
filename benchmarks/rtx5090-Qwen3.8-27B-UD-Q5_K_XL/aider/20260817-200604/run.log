Code:
```
package forth

import (
    "errors"
    "strconv"
    "strings"
)

var builtinWords = map[string]struct{}{
    "+": {}, "-": {}, "*": {}, "/": {},
    "dup": {}, "drop": {}, "swap": {}, "over": {},
}

func Forth(input []string) ([]int, error) {
    stack := []int{}
    words := map[string][]string{}
    if err := evaluate(input, &stack, words); err != nil {
        return nil, err
    }
    return stack, nil
}

func evaluate(tokens []string, stack *[]int, words map[string][]string) error {
    for i := 0; i < len(tokens); i++ {
        token := strings.ToLower(tokens[i])
        if token == ":" {
            if i+1 >= len(tokens) {
                return errors.New("missing word name")
            }
            name := strings.ToLower(tokens[i+1])
            if name == "" {
                return errors.New("missing word name")
            }
            if _, err := strconv.Atoi(name); err == nil {
                return errors.New("word name cannot be a number")
            }
            if _, ok := builtinWords[name]; ok {
                return errors.New("cannot redefine built-in word")
            }
            end := i + 2
            for end < len(tokens) && strings.ToLower(tokens[end]) != ";" {
                end++
            }
            if end >= len(tokens) {
                return errors.New("missing ;")
            }
            body := make([]string, 0, end-i-2)
            for j := i + 2; j < end; j++ {
                body = append(body, strings.ToLower(tokens[j]))
            }
            words[name] = body
            i = end
            continue
        }

        if n, err := strconv.Atoi(token); err == nil {
            *stack = append(*stack, n)
            continue
        }

        if body, ok := words[token]; ok {
            if err := evaluate(body, stack, words); err != nil {
                return err
            }
            continue
        }

        switch token {
        case "+":
            a, b, err := popTwo(stack)
            if err != nil {
                return err
            }
            *stack = append(*stack, a+b)
        case "-":
            a, b, err := popTwo(stack)
            if err != nil {
                return err
            }
            *stack = append(*stack, a-b)
        case "*":
            a, b, err := popTwo(stack)
            if err != nil {
                return err
            }
            *stack = append(*stack, a*b)
        case "/":
            a, b, err := popTwo(stack)
            if err != nil {
                return err
            }
            if b == 0 {
                return errors.New("division by zero")
            }
            *stack = append(*stack, a/b)
        case "dup":
            if len(*stack) == 0 {
                return errors.New("stack underflow")
            }
            top := (*stack)[len(*stack)-1]
            *stack = append(*stack, top)
        case "drop":
            if len(*stack) == 0 {
                return errors.New("stack underflow")
            }
            *stack = (*stack)[:len(*stack)-1]
        case "swap":
            if len(*stack) < 2 {
                return errors.New("stack underflow")
            }
            n := len(*stack)
            (*stack)[n-1], (*stack)[n-2] = (*stack)[n-2], (*stack)[n-1]
        case "over":
            if len(*stack) < 2 {
                return errors.New("stack underflow")
            }
            *stack = append(*stack, (*stack)[len(*stack)-2])
        default:
            return errors.New("unknown word")
        }
    }
    return nil
}

func popTwo(stack *[]int) (int, int, error) {
    if len(*stack) < 2 {
        return 0, 0, errors.New("stack underflow")
    }
    n := len(*stack)
    a := (*stack)[n-2]
    b := (*stack)[n-1]
    *stack = (*stack)[:n-2]
    return a, b, nil
}
```

