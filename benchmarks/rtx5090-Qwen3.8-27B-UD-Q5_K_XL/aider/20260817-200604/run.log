```
import java.util.ArrayDeque;
import java.util.Queue;

public class Connect {

    public enum Winner {
        O, X, NONE
    }

    private static final int[][] NEIGHBORS = {
        {-1, 0},
        {-1, 1},
        {0, -1},
        {0, 1},
        {1, -1},
        {1, 0}
    };

    private final char[][] board;
    private final int rows;
    private final int[] cols;

    public Connect(String[] board) {
        this.rows = board == null ? 0 : board.length;
        this.cols = new int[this.rows];
        this.board = new char[this.rows][];

        for (int r = 0; r < this.rows; r++) {
            String row = board[r] == null ? "" : board[r];
            StringBuilder cleaned = new StringBuilder();
            for (int i = 0; i < row.length(); i++) {
                char ch = row.charAt(i);
                if (!Character.isWhitespace(ch)) {
                    cleaned.append(Character.toUpperCase(ch));
                }
            }
            String s = cleaned.toString();
            this.cols[r] = s.length();
            this.board[r] = s.toCharArray();
        }
    }

    public Winner computeWinner() {
        if (rows == 0) {
            return Winner.NONE;
        }
        if (connects('O', true)) {
            return Winner.O;
        }
        if (connects('X', false)) {
            return Winner.X;
        }
        return Winner.NONE;
    }

    private boolean connects(char player, boolean vertical) {
        if (rows == 0) {
            return false;
        }

        boolean[][] visited = new boolean[rows][];
        for (int r = 0; r < rows; r++) {
            visited[r] = new boolean[cols[r]];
        }

        Queue<int[]> queue = new ArrayDeque<>();

        if (vertical) {
            for (int c = 0; c < cols[0]; c++) {
                if (board[0][c] == player) {
                    visited[0][c] = true;
                    queue.add(new int[]{0, c});
                }
            }
        } else {
            for (int r = 0; r < rows; r++) {
                if (cols[r] > 0 && board[r][0] == player) {
                    visited[r][0] = true;
                    queue.add(new int[]{r, 0});
                }
            }
        }

        while (!queue.isEmpty()) {
            int[] current = queue.poll();
            int r = current[0];
            int c = current[1];

            if (vertical ? r == rows - 1 : c == cols[r] - 1) {
                return true;
            }

            for (int[] delta : NEIGHBORS) {
                int nr = r + delta[0];
                int nc = c + delta[1];

                if (nr < 0 || nr >= rows || nc < 0 || nc >= cols[nr]) {
                    continue;
                }
                if (visited[nr][nc] || board[nr][nc] != player) {
                    continue;
                }

                visited[nr][nc] = true;
                queue.add(new int[]{nr, nc});
            }
        }

        return false;
    }
}
```

