Pseudo:
#if !defined(ALL_YOUR_BASE_H)
#define ALL_YOUR_BASE_H

#include <vector>
#include <stdexcept>
#include <algorithm>
#include <cstdint>
#include <type_traits>

namespace all_your_base {

template <typename T>
std::vector<unsigned int> convert(unsigned int input_base,
                                  const std::vector<T>& digits,
                                  unsigned int output_base) {
    if (input_base < 2 || output_base < 2) {
        throw std::invalid_argument("base must be >= 2");
    }

    for (const T& digit : digits) {
        if (std::is_signed<T>::value && digit < 0) {
            throw std::invalid_argument("digit must be non-negative");
        }
        if (static_cast<unsigned long long>(digit) >= static_cast<unsigned long long>(input_base)) {
            throw std::invalid_argument("digit out of range");
        }
    }

    std::vector<std::uint32_t> value;
    for (const T& digit : digits) {
        std::uint64_t carry = static_cast<std::uint64_t>(digit);
        for (std::size_t i = 0; i < value.size(); ++i) {
            std::uint64_t cur = static_cast<std::uint64_t>(value[i]) * input_base + carry;
            value[i] = static_cast<std::uint32_t>(cur);
            carry = cur >> 32;
        }
        while (carry != 0) {
            value.push_back(static_cast<std::uint32_t>(carry));
            carry >>= 32;
        }
    }

    while (!value.empty() && value.back() == 0) {
        value.pop_back();
    }

    if (value.empty()) {
        return {0};
    }

    std::vector<unsigned int> result;
    while (true) {
        std::uint64_t remainder = 0;
        std::vector<std::uint32_t> quotient(value.size(), 0);
        for (std::size_t i = value.size(); i-- > 0;) {
            std::uint64_t current = (remainder << 32) | static_cast<std::uint64_t>(value[i]);
            quotient[i] = static_cast<std::uint32_t>(current / output_base);
            remainder = current % output_base;
        }
        result.push_back(static_cast<unsigned int>(remainder));
        while (!quotient.empty() && quotient.back() == 0) {
            quotient.pop_back();
        }
        if (quotient.empty()) {
            break;
        }
        value.swap(quotient);
    }

    std::reverse(result.begin(), result.end());
    return result;
}

}  // namespace all_your_base

#endif

