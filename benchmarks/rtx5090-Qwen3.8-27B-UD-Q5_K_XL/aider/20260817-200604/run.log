Pseudo:
```
function getTopologicalOrder(startCell) {
  const reachable = new Set();
  const discovery = [];

  const collect = (cell) => {
    if (cell instanceof InputCell) {
      for (const dep of cell.dependents) collect(dep);
    } else if (cell instanceof ComputeCell) {
      if (reachable.has(cell)) return;
      reachable.add(cell);
      discovery.push(cell);
      for (const dep of cell.dependents) collect(dep);
    }
  };
  collect(startCell);

  const inDegree = new Map();
  const edges = new Map();
  for (const cell of discovery) {
    inDegree.set(cell, 0);
    edges.set(cell, []);
  }
  for (const cell of discovery) {
    for (const input of cell.inputCells) {
      if (input instanceof ComputeCell && reachable.has(input)) {
        inDegree.set(cell, inDegree.get(cell) + 1);
        edges.get(input).push(cell);
      }
    }
  }

  const queue = discovery.filter(cell => inDegree.get(cell) === 0);
  const sorted = [];
  while (queue.length > 0) {
    const cell = queue.shift();
    sorted.push(cell);
    for (const dependent of edges.get(cell)) {
      const degree = inDegree.get(dependent) - 1;
      inDegree.set(dependent, degree);
      if (degree === 0) queue.push(dependent);
    }
  }

  if (sorted.length !== discovery.length) {
    // fallback to discovery order? Or DFS reverse.
    return discovery;
  }
  return sorted;
}
```

