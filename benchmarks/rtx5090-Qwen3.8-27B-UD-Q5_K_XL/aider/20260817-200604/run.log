Let's design final Zipper.java:
```
import java.util.Objects;

class Zipper {
    Zipper up;
    Zipper left;
    Zipper right;
    int value;

    Zipper(int val) { this.value = val; }

    BinaryTree toTree() {
        Zipper current = this;
        while (current.up != null) {
            current = current.up;
        }
        return new BinaryTree(current);
    }

    int getValue() { return value; }

    Zipper setLeft(Zipper leftChild) {
        this.left = leftChild;
        if (leftChild != null) leftChild.up = this;
        return this;
    }

    Zipper setRight(Zipper rightChild) {
        this.right = rightChild;
        if (rightChild != null) rightChild.up = this;
        return this;
    }

    void setValue(int val) { this.value = val; }

    @Override
    public boolean equals(Object o) { ... maybe structural ignoring up? }
    @Override
    public int hashCode() { ... }
}

class BinaryTree {
    private final Zipper root;

    BinaryTree(int value) { this.root = new Zipper(value); }
    BinaryTree(Zipper root) { this.root = root; }

    Zipper getRoot() { return root; }

    String printTree() { return format(root); }

    @Override
    public String toString() { return printTree(); }

    @Override
    public boolean equals(Object o) {
       if (this == o) return true;
       if (!(o instanceof BinaryTree)) return false;
       BinaryTree other = (BinaryTree) o;
       return zipperEquals(this.root, other.root);
    }

    @Override
    public int hashCode() { return zipperHashCode(root); }

    private static String format(Zipper z) {
       if (z == null) return "null";
       return "value: " + z.value + ", left: " + format(z.left) + ", right: " + format(z.right);
    }

    private static boolean zipperEquals(Zipper a, Zipper b) {
       if (a == b) return true;
       if (a == null || b == null) return false;
       return a.value == b.value && zipperEquals(a.left, b.left) && zipperEquals(a.right, b.right);
    }

    private static int zipperHashCode(Zipper z) {
       if (z == null) return 0;
       return Objects.hash(z.value, zipperHashCode(z.left), zipperHashCode(z.right));
    }
}
```
