Let's write final code with helper:
private Plant plantFromChar(char c) {
    for (Plant plant : Plant.values()) {
        String name = plant.name().toUpperCase();
        if (matches(c, name)) return plant;
    }
    throw new IllegalArgumentException("Not a valid plant: " + c);
}

private boolean matches(char c, String name) {
    switch (c) {
        case 'G': return name.contains("GRASS") || name.equals("G");
        case 'C': return name.contains("CLOVER") || name.equals("C");
        case 'R': return name.contains("RADISH") || name.equals("R");
        case 'V': return name.contains("VIOLET") || name.equals("V");
        default: return false;
    }
}

