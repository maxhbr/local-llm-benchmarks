class Node:
    def __init__(self, value):
        self._value = value
        self._next = None
    def value(self): return self._value
    def next(self): return self._next

class LinkedList:
    def __init__(self, values=None):
        self._head = None
        self._length = 0
        if values:
            for value in values:
                self.push(value)
    def __iter__(self):
        node = self._head
        while node:
            yield node.value()
            node = node.next()
    def __len__(self): return self._length
    def head(self): return self._head
    def push(self, value):
        self._head = Node(value)
        self._head._next = self._head? Wait need set next to old head.
        self._length += 1
    def pop(self):
        if not self._head: raise EmptyListException
        value = self._head.value()
        self._head = self._head.next()
        self._length -= 1
        return value
    def reversed(self):
        reversed_list = LinkedList()
        for value in self:
            reversed_list.push(value)
        return reversed_list

