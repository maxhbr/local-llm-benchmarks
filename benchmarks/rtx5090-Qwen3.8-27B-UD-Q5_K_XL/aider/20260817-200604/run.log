```
package piglatin

import (
	"strings"
	"unicode"
)

func Sentence(sentence string) string {
	words := strings.Split(sentence, " ")
	for i, word := range words {
		words[i] = translate(word)
	}
	return strings.Join(words, " ")
}

func translate(word string) string {
	runes := []rune(word)
	if len(runes) == 0 {
		return ""
	}

	lower := strings.ToLower(word)
	if isVowel(unicode.ToLower(runes[0])) || strings.HasPrefix(lower, "xr") || strings.HasPrefix(lower, "yt") {
		return word + "ay"
	}

	i := 0
	for i < len(runes) {
		c := unicode.ToLower(runes[i])

		if isVowel(c) {
			break
		}

		if c == 'q' && i+1 < len(runes) && unicode.ToLower(runes[i+1]) == 'u' {
			i += 2
			break
		}

		if c == 'y' && i > 0 {
			break
		}

		i++
	}

	return string(runes[i:]) + string(runes[:i]) + "ay"
}

func isVowel(r rune) bool {
	switch r {
	case 'a', 'e', 'i', 'o', 'u':
		return true
	}
	return false
}
```
