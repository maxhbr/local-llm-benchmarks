Search memory: A common Python solution:
```
def total(basket):
    prices = [800, 1520, 2160, 2560, 3000]
    counts = [basket.count(i) for i in range(1, 6)]
    counts.sort(reverse=True)
    total = 0
    while counts[0]:
        if counts[4] > 0:
            if counts[2] == counts[4] + 1:
                # buy two groups of 4
                total += 2 * 2560
                counts[0] -= 1
                counts[1] -= 1
                counts[2] -= 1
                counts[3] -= 1
                counts[0] -= 1
                counts[1] -= 1
                counts[2] -= 1
                counts[4] -= 1
                # sort?
            else:
                total += 3000
                for i in range(5): counts[i] -= 1
        elif counts[3] > 0:
            total += 2560
            for i in range(4): counts[i] -= 1
        elif counts[2] > 0:
            total += 2160
            for i in range(3): counts[i] -= 1
        elif counts[1] > 0:
            total += 1520
            counts[0] -= 1; counts[1] -= 1
        else:
            total += 800
            counts[0] -= 1
        counts.sort(reverse=True)
    return total
```
