        Node* node = new Node(std::move(value), tail_, nullptr);
        if (tail_ != nullptr) {
            tail_->next = node;
        } else {
            head_ = node;
        }
        tail_ = node;
        ++size_;
    }

    void unshift(T value) {
        Node* node = new Node(std::move(value), nullptr, head_);
        if (head_ != nullptr) {
            head_->prev = node;
        } else {
            tail_ = node;
        }
        head_ = node;
        ++size_;
    }

    T pop() {
        if (head_ == nullptr) {
            throw std::out_of_range("Cannot pop from an empty list");
        }

        T value = std::move(tail_->data);
        Node* old_tail = tail_;
        tail_ = old_tail->prev;

        if (tail_ != nullptr) {
            tail_->next = nullptr;
        } else {
            head_ = nullptr;
        }

        delete old_tail;
        --size_;
        return value;
    }

    T shift() {
        if (head_ == nullptr) {
            throw std::out_of_range("Cannot shift from an empty list");
        }

        T value = std::move(head_->data);
        Node* old_head = head_;
        head_ = old_head->next;

        if (head_ != nullptr) {
            head_->prev = nullptr;
        } else {
            tail_ = nullptr;
        }

        delete old_head;
        --size_;
        return value;
    }

    std::size_t count() const {
        return size_;
    }

    bool erase(const T& value) {
        for (Node* current = head_; current != nullptr; current = current->next) {
            if (current->data == value) {
                if (current->prev != nullptr) {
                    current->prev->next = current->next;
                } else {
                    head_ = current->next;
                }

                if (current->next != nullptr) {
                    current->next->prev = current->prev;
                } else {
                    tail_ = current->prev;
                }

                delete current;
                --size_;
                return true;
            }
        }
        return false;
    }
};
