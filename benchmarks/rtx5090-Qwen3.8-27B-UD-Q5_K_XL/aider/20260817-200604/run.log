class TwoBucket {
  private final int cap1, cap2, desired;
  private final String start;
  private int totalMoves;
  private String finalBucket;
  private int otherBucket;

  TwoBucket(int bucketOneCap, int bucketTwoCap, int desiredLiters, String startBucket) {
    this.cap1 = bucketOneCap; ...
    if (startBucket == null || (!startBucket.equals("one") && !startBucket.equals("two"))) throw new IllegalArgumentException("Invalid start bucket");
    if (desiredLiters < 0 || cap1 < 0 || cap2 < 0) throw ...?
    if (desiredLiters == 0) { totalMoves=0; finalBucket=startBucket; otherBucket=0; return; }
    if (desiredLiters > Math.max(cap1, cap2)) throw new IllegalArgumentException("No solution");
    int g = gcd(cap1, cap2); if (desired % g != 0) throw ...;
    solve();
  }

  private void solve() {
    int startA = start.equals("one") ? cap1 : 0;
    int startB = start.equals("one") ? 0 : cap2;
    if (isForbidden(startA,startB)) { // shouldn't unless cap zero? If cap1=0 start one state (0,0) not forbidden? if cap2=0? maybe.
    }
    ArrayDeque<int[]> queue = new ArrayDeque<>();
    HashSet<Long> visited = new HashSet<>();
    queue.add(new int[]{startA,startB,1});
    visited.add(key(startA,startB));
    while (!queue.isEmpty()) {
      int[] cur = queue.poll();
      int a=cur[0], b=cur[1], moves=cur[2];
      if (a == desired) { set final one, other b; return; }
      if (b == desired) { set final two, other a; return; }
      // generate
      add(cap1,b,moves+1,...)
      add(a,cap2,...)
      add(0,b,...)
      add(a,0,...)
      int pour = Math.min(a, cap2-b); add(a-pour,b+pour)
      pour = Math.min(b, cap1-a); add(a+pour,b-pour)
    }
    throw new IllegalArgumentException("No solution");
  }

  private void add(int a,int b,int moves, ArrayDeque<int[]> q, HashSet<Long> visited) {
    if (a<0||a>cap1||b<0||b>cap2) return;
    if (a==cur? Need current to skip no-op. Could pass curA,curB or check if same as current. But add doesn't know. Could skip no-op by if (a == curA && b == curB) 
return. Pass.
    if (isForbidden(a,b)) return;
    long k=key(a,b); if (!visited.add(k)) return;
    q.add(new int[]{a,b,moves});
  }

