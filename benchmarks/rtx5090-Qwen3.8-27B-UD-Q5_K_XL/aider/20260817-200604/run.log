class PhoneNumber {
    private final String number;

    PhoneNumber(String numberString) {
        if (numberString == null) {
            throw new IllegalArgumentException("Phone number cannot be null");
        }

        if (!numberString.matches("^\\+?[0-9()\\s.-]*$")) {
            throw new IllegalArgumentException("Phone number contains invalid characters");
        }

        String digits = numberString.replaceAll("[^0-9]", "");

        if (digits.length() == 11) {
            if (digits.charAt(0) != '1') {
                throw new IllegalArgumentException("Invalid country code");
            }
            digits = digits.substring(1);
        }

        if (digits.length() != 10) {
            throw new IllegalArgumentException("Invalid phone number length");
        }

        if (digits.charAt(0) < '2') {
            throw new IllegalArgumentException("Invalid area code");
        }

        if (digits.charAt(3) < '2') {
            throw new IllegalArgumentException("Invalid exchange code");
        }

        this.number = digits;
    }

    String getNumber() {
        return number;
    }
}
