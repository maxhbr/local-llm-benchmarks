def _parse_tree(s, i):
    if s[i] != '(': raise tree missing
    i += 1
    root = SgfTree(properties={}, children=[])
    current = root
    has_node = False
    while i < len(s) and s[i] != ')':
        if s[i] == ';':
            node, i = _parse_node(s, i)
            if not has_node:
                root = node
                current = node
                has_node = True
            else:
                current.children.append(node)
                current = node
        elif s[i] == '(':
            child, i = _parse_tree(s, i)
            current.children.append(child)
        else: raise tree missing
    if i >= len(s) or s[i] != ')': raise tree missing
    if not has_node:
        raise ValueError("tree with no nodes")
    return root, i+1
```
