Expected likely `func(*values)`. But support `func(values)` if function expects single iterable. Use inspect.

```
def _call_compute_function(func, values):
    try:
        sig = inspect.signature(func)
    except (TypeError, ValueError):
        try:
            return func(*values)
        except TypeError:
            return func(values)
    params = list(sig.parameters.values())
    # Determine if func can be called with *values.
    # Count positional parameters (POSITIONAL_ONLY, POSITIONAL_OR_KEYWORD) and VAR_POSITIONAL.
    positional = [p for p in params if p.kind in (inspect.Parameter.POSITIONAL_ONLY, inspect.Parameter.POSITIONAL_OR_KEYWORD)]
    has_var_positional = any(p.kind == inspect.Parameter.VAR_POSITIONAL for p in params)
    # If has *args, call with *values (unless values length 0? okay)
    if has_var_positional:
        return func(*values)
    # If number of positional params == len(values): call *values
    if len(positional) == len(values):
        return func(*values)
    # If exactly one positional param and len(values) != 1: call with list
    if len(positional) == 1 and len(values) != 1:
        return func(values)
    # If len(values) == 1 and len(positional) == 1: call with value (not list)
    if len(values) == 1 and len(positional) == 1:
        return func(values[0])
    # If len(positional) == 1: maybe call with list? e.g. lambda vals: sum(vals) with multiple values handled above; with one value ambiguous choose value.
    # If len(positional) > len(values) but extra have defaults? Could call *values.
    try:
        return func(*values)
    except TypeError:
        return func(values)
```
