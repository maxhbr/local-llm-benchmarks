struct XorShift64(u64);
impl XorShift64 {
    fn new(seed: u64) -> Self { if seed == 0 { Self(0x9e3779b97f4a7c15) } else { Self(seed) } }
    fn next_u64(&mut self) -> u64 {
        let mut x = self.0;
        x ^= x << 13;
        x ^= x >> 7;
        x ^= x << 17;
        self.0 = x;
        x
    }
}
