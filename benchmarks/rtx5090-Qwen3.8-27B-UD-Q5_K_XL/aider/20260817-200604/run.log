    "T": 10,
    "10": 10,
    "J": 11,
    "Q": 12,
    "K": 13,
    "A": 14,
}


def _score_hand(hand):
    cards = hand.split()

    ranks = []
    suits = []
    for card in cards:
        rank = card[:-1].upper()
        suit = card[-1].upper()
        ranks.append(RANK_VALUES[rank])
        suits.append(suit)

    sorted_ranks = sorted(ranks, reverse=True)
    counts = Counter(ranks)
    ordered_ranks = sorted(counts, key=lambda r: (counts[r], r), reverse=True)
    count_sizes = sorted(counts.values(), reverse=True)

    is_flush = len(set(suits)) == 1

    is_straight = False
    straight_high = 0
    if len(set(ranks)) == 5:
        if max(ranks) - min(ranks) == 4:
            is_straight = True
            straight_high = max(ranks)
