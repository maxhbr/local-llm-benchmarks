func Solve(...) {
 if sizeBucketOne <=0 || sizeBucketTwo <=0 || goalAmount <=0 { return "",0,0,errors.New("invalid parameters") }
 if goalAmount > max(sizeBucketOne, sizeBucketTwo) { error }
 if startBucket != "one" && startBucket != "two" { error }
 if goalAmount % gcd(sizeBucketOne, sizeBucketTwo) !=0 { error } // bonus
 // maybe if sizeBucketOne == sizeBucketTwo && goalAmount != sizeBucketOne? gcd=size, if goal not size error. If goal size, possible.
 type state struct{a,b,steps int}
 var queue []state
 visited := make(map[int]struct{})
 forbidden := func(a,b int) bool { if startBucket=="one" { return a==0 && b==sizeBucketTwo } else { return a==sizeBucketOne && b==0 } }
 var a,b int
 if startBucket=="one" { a=sizeBucketOne; b=0 } else { a=0; b=sizeBucketTwo }
 steps := 1
 if a == goalAmount { return "one", steps, b, nil }
 if b == goalAmount { return "two", steps, a, nil }
 if !forbidden(a,b) { encode; queue append } else? first fill not forbidden.
 for len(queue)>0 {
  s := queue[0]; queue=queue[1:]
  // generate next states
  for _, ns := range nextStates(s.a,s.b) {
    if forbidden(ns.a,ns.b) continue
    key := ns.a*(sizeBucketTwo+1)+ns.b
    if _, ok := visited[key]; ok continue
    visited[key]=struct{}{}
    nsSteps := s.steps+1
    if ns.a == goalAmount { return "one", nsSteps, ns.b, nil }
    if ns.b == goalAmount { return "two", nsSteps, ns.a, nil }
    queue = append(queue, state{ns.a,ns.b,nsSteps})
  }
 }
 return "",0,0,errors.New("no solution")
}

