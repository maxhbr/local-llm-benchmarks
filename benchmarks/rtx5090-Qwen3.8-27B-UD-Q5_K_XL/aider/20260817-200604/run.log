class PigLatinTranslator {
    public String translate(String word) {
        if (word == null) return null;
        if (word.isEmpty()) return "";
        if (word.indexOf(' ') == -1) return translateWord(word);
        StringBuilder sb = new StringBuilder();
        int i = 0;
        while (i < word.length()) {
            char c = word.charAt(i);
            if (c == ' ') {
                sb.append(c);
                i++;
            } else {
                int start = i;
                while (i < word.length() && word.charAt(i) != ' ') i++;
                sb.append(translateWord(word.substring(start, i)));
            }
        }
        return sb.toString();
    }

    private String translateWord(String word) {
        if (word.isEmpty()) return "";
        String lower = word.toLowerCase();
        int len = lower.length();
        int split = 0;
        if (isVowel(lower.charAt(0)) || startsWith(lower, "xr") || startsWith(lower, "yt")) {
            split = 0;
        } else {
            split = 0;
            while (split < len) {
                char c = lower.charAt(split);
                if (isVowel(c)) break;
                if (c == 'y' && split > 0) break;
                if (c == 'q' && split + 1 < len && lower.charAt(split + 1) == 'u') {
                    split += 2;
                    break;
                }
                split++;
            }
        }
        return word.substring(split) + word.substring(0, split) + "ay";
    }

    private boolean isVowel(char c) { return "aeiou".indexOf(c) >= 0; }
    private boolean startsWith(String s, String prefix) { return s.startsWith(prefix); }
}

