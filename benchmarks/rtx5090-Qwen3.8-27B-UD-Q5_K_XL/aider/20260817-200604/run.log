package wordy

import (
    "strconv"
    "strings"
)

func Answer(question string) (int, bool) {
    q := strings.TrimSpace(question)
    const prefix = "What is "
    if !strings.HasPrefix(q, prefix) {
        return 0, false
    }
    expr := q[len(prefix):]
    expr = strings.TrimSpace(expr)
    if strings.HasSuffix(expr, "?") {
        expr = expr[:len(expr)-1]
    }
    expr = strings.TrimSpace(expr)
    tokens := strings.Fields(expr)
    if len(tokens) == 0 {
        return 0, false
    }

    i := 0
    value, ok := parseNumber(tokens[i])
    if !ok {
        return 0, false
    }
    i++

    for i < len(tokens) {
        switch tokens[i] {
        case "plus":
            i++
            if i >= len(tokens) {
                return 0, false
            }
            rhs, ok := parseNumber(tokens[i])
            if !ok {
                return 0, false
            }
            value += rhs
            i++
        case "minus":
            i++
            if i >= len(tokens) {
                return 0, false
            }
            rhs, ok := parseNumber(tokens[i])
            if !ok {
                return 0, false
            }
            value -= rhs
            i++
        case "multiplied":
            i++
            if i >= len(tokens) || tokens[i] != "by" {
                return 0, false
            }
            i++
            if i >= len(tokens) {
                return 0, false
            }
            rhs, ok := parseNumber(tokens[i])
            if !ok {
                return 0, false
            }
            value *= rhs
            i++
        case "divided":
            i++
            if i >= len(tokens) || tokens[i] != "by" {
                return 0, false
            }
            i++
            if i >= len(tokens) {
                return 0, false
            }
            rhs, ok := parseNumber(tokens[i])
            if !ok {
                return 0, false
            }
            if rhs == 0 {
                return 0, false
            }
            value /= rhs
            i++
        default:
            return 0, false
        }
    }

    return value, true
}

func parseNumber(s string) (int, bool) {
    n, err := strconv.Atoi(s)
    if err != nil {
        return 0, false
    }
    return n, true
}

