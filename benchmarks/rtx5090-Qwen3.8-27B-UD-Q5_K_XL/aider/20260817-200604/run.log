class BowlingGame {
    private final int[] rolls = new int[21];
    private int rollCount = 0;
    private int frame = 0;
    private int rollInFrame = 0;

    void roll(int pins) {
        if (pins < 0 || pins > 10) {
            throw new IllegalStateException("Pins must be between 0 and 10.");
        }

        if (frame == 10) {
            throw new IllegalStateException("Game is already over.");
        }

        if (frame < 9) {
            if (rollInFrame == 0) {
                rolls[rollCount++] = pins;

                if (pins == 10) {
                    frame++;
                    rollInFrame = 0;
                } else {
                    rollInFrame = 1;
                }
            } else {
                int firstRoll = rolls[rollCount - 1];

                if (pins > 10 - firstRoll) {
                    throw new IllegalStateException("Frame cannot exceed 10 pins.");
                }

                rolls[rollCount++] = pins;
                frame++;
                rollInFrame = 0;
            }
        } else {
            if (rollInFrame == 0) {
                rolls[rollCount++] = pins;
                rollInFrame = 1;
            } else if (rollInFrame == 1) {
                int firstRoll = rolls[rollCount - 1];

                if (firstRoll != 10) {
                    if (pins > 10 - firstRoll) {
                        throw new IllegalStateException("Frame cannot exceed 10 pins.");
                    }

                    rolls[rollCount++] = pins;

                    if (firstRoll + pins == 10) {
                        rollInFrame = 2;
                    } else {
                        frame = 10;
                    }
                } else {
                    rolls[rollCount++] = pins;
                    rollInFrame = 2;
                }
            } else {
                int firstRoll = rolls[rollCount - 2];
                int secondRoll = rolls[rollCount - 1];

                if (firstRoll == 10 && secondRoll != 10 && pins > 10 - secondRoll) {
                    throw new IllegalStateException("Frame cannot exceed 10 pins.");
                }

                rolls[rollCount++] = pins;
                frame = 10;
            }
        }
    }

    int score() {
        if (frame != 10) {
            throw new IllegalStateException("Game is not complete.");
        }

        int total = 0;
        int i = 0;

        for (int f = 0; f < 10; f++) {
