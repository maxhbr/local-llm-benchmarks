package cryptosquare

import (
    "math"
    "strings"
    "unicode"
)

func Encode(pt string) string {
    lower := strings.ToLower(pt)
    var norm []rune
    for _, r := range lower {
        if unicode.IsLetter(r) || unicode.IsDigit(r) {
            norm = append(norm, r)
        }
    }

    n := len(norm)
    if n == 0 {
        return ""
    }

    c := int(math.Ceil(math.Sqrt(float64(n))))
    r := (n + c - 1) / c

    chunks := make([]string, 0, c)
    for col := 0; col < c; col++ {
        chunk := make([]rune, 0, r)
        for row := 0; row < r; row++ {
            idx := row*c + col
            if idx < n {
                chunk = append(chunk, norm[idx])
            } else {
                chunk = append(chunk, ' ')
            }
        }
        chunks = append(chunks, string(chunk))
    }

    return strings.Join(chunks, " ")
}

