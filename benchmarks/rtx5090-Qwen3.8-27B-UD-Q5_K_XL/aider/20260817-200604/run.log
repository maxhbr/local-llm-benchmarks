Need implement permutations. Could generate all permutations of slice of strings. Need avoid mutation issues. Use recursive:
func permutations(items []string) [][]string {
    var result [][]string
    var current []string
    var used []bool
    var permute func()
    permute = func() {
       if len(current) == len(items) {
          p := make([]string, len(current))
          copy(p, current)
          result = append(result, p)
          return
       }
       for i, v := range items {
          if !used[i] {
             used[i] = true
             current = append(current, v)
             permute()
             current = current[:len(current)-1]
             used[i] = false
          }
       }
    }
    used = make([]bool, len(items))
    permute()
    return result
}

