export const gamestate = (board) => {
  const rows = typeof board === 'string' ? [board] : board;
  const cells = rows.map(row => typeof row === 'string' ? row : row.join('')).join('');
  const xCount = cells.split('X').length - 1;
  const oCount = cells.split('O').length - 1;

  if (oCount > xCount) throw new Error('Wrong turn order: O started');
  if (xCount > oCount + 1) throw new Error('Wrong turn order: X went twice');

  const lines = ...
  const hasWon = ...
  const xWon = hasWon('X');
  const oWon = hasWon('O');

  if (xWon && oWon) throw new Error('Impossible board: game should have ended after the game was won');

  if (xWon) {
    if (xCount !== oCount + 1) throw new Error('Impossible board: game should have ended after the game was won');
    return 'win';
  }
  if (oWon) {
    if (xCount !== oCount) throw new Error('Impossible board: game should have ended after the game was won');
    return 'win';
  }
  if (xCount + oCount === 9) return 'draw';
  return 'ongoing';
};

