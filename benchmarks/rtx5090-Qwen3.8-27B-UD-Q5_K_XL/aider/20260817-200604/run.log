    {"peanuts", 2u},
    {"shellfish", 4u},
    {"strawberries", 8u},
    {"tomatoes", 16u},
    {"chocolate", 32u},
    {"pollen", 64u},
    {"cats", 128u},
}};
}

AllergyTest::AllergyTest(int score) : score_(static_cast<unsigned int>(score) & 0xFFu) {}

bool AllergyTest::allergic_to(const std::string& allergen) const {
    for (const auto& [name, bit] : allergens) {
        if (name == allergen) {
            return (score_ & bit) != 0u;
        }
    }
    return false;
}

std::unordered_set<std::string> AllergyTest::allergies() const {
    std::unordered_set<std::string> result;
    for (const auto& [name, bit] : allergens) {
        if ((score_ & bit) != 0u) {
            result.emplace(name);
        }
    }
    return result;
}
}

