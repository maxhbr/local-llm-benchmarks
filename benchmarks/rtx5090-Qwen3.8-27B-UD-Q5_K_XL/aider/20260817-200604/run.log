  [[' _ ', '|_ ', '|_|', '   '].join('\n')]: '6',
  [[' _ ', '  |', '  |', '   '].join('\n')]: '7',
  [[' _ ', '|_|', '|_|', '   '].join('\n')]: '8',
  [[' _ ', '|_|', ' _|', '   '].join('\n')]: '9',
};

const normalizeBlock = (block) => {
  const width = Math.max(...block.map((line) => line.length));

  if (width % 3 !== 0) {
    throw new Error(ERROR_MESSAGE);
  }

  return block.map((line) => line.padEnd(width, ' '));
};

const convertBlock = (block) => {
  const lines = normalizeBlock(block);
  const width = lines[0].length;
  const result = [];

  for (let i = 0; i < width; i += 3) {
    const pattern = lines.map((line) => line.slice(i, i + 3)).join('\n');
    result.push(DIGITS[pattern] || '?');
  }

  return result.join('');
};

export const convert = (input) => {
  let lines = String(input).split(/\r?\n/);

  if (lines.length % 4 === 1 && lines[lines.length - 1] === '') {
    lines.pop();
  }

  if (lines.length === 0 || lines.length % 4 !== 0) {
    throw new Error(ERROR_MESSAGE);
  }

  const converted = [];

  for (let i = 0; i < lines.length; i += 4) {
    converted.push(convertBlock(lines.slice(i, i + 4)));
  }

  return converted.join(',');
};
