private Plant plantFromChar(char c) {
    Plant[] enumConstants = Plant.class.getEnumConstants();
    if (enumConstants != null) {
        for (Plant plant : enumConstants) {
            String name = plant.name().toUpperCase();
            if (matches(c, name)) return plant;
        }
    }
    // fallback to public static fields
