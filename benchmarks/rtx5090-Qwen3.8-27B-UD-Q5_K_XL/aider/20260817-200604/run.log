Transpose.java
```
public class Transpose {
    public String transpose(String toTranspose) {
        if (toTranspose == null) {
            return "";
        }

        String normalized = toTranspose.replace("\r\n", "\n").replace("\r", "\n");
        String[] rows = normalized.split("\n", -1);

        int maxLength = 0;
        for (String row : rows) {
            if (row.length() > maxLength) {
                maxLength = row.length();
            }
        }

        if (maxLength == 0) {
            return "";
        }

        StringBuilder result = new StringBuilder();

        for (int col = 0; col < maxLength; col++) {
            int lastNonMissingRow = -1;
            for (int row = 0; row < rows.length; row++) {
                if (rows[row].length() > col) {
                    lastNonMissingRow = row;
                }
            }

            for (int row = 0; row <= lastNonMissingRow; row++) {
                if (rows[row].length() > col) {
                    result.append(rows[row].charAt(col));
                } else {
                    result.append(' ');
                }
            }

            if (col < maxLength - 1) {
                result.append('\n');
            }
        }

        return result.toString();
    }
}
