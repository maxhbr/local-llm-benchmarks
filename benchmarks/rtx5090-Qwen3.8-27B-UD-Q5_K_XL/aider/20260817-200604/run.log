pub mod graph {
    use std::fmt;

    #[derive(Debug, Clone, PartialEq, Eq, Default)]
    pub struct Graph {
        pub nodes: Vec<Node>,
        pub edges: Vec<Edge>,
        pub attrs: Vec<(String, String)>,
    }

    #[derive(Debug, Clone, PartialEq, Eq)]
    pub struct Node {
        pub name: String,
        pub attrs: Vec<(String, String)>,
    }

    #[derive(Debug, Clone, PartialEq, Eq)]
    pub struct Edge {
        pub from: String,
        pub to: String,
        pub attrs: Vec<(String, String)>,
    }

    impl Graph {
        pub fn new() -> Self {
            Self::default()
        }

        pub fn with_node<T: Into<Node>>(mut self, node: T) -> Self {
            self.nodes.push(node.into());
            self
        }

        pub fn with_edge<T: Into<Edge>>(mut self, edge: T) -> Self {
            self.edges.push(edge.into());
            self
        }

        pub fn with_attr<K: Into<String>, V: Into<String>>(mut self, key: K, value: V) -> Self {
            self.attrs.push((key.into(), value.into()));
            self
        }

        pub fn with_nodes<I, T>(mut self, nodes: I) -> Self
        where
            I: IntoIterator<Item = T>,
            T: Into<Node>,
        {
            for node in nodes {
                self.nodes.push(node.into());
            }
            self
        }

        pub fn with_edges<I, T>(mut self, edges: I) -> Self
        where
            I: IntoIterator<Item = T>,
            T: Into<Edge>,
        {
            for edge in edges {
                self.edges.push(edge.into());
            }
            self
        }

        pub fn with_attrs<I, K, V>(mut self, attrs: I) -> Self
        where
            I: IntoIterator<Item = (K, V)>,
            K: Into<String>,
            V: Into<String>,
        {
            for (key, value) in attrs {
                self.attrs.push((key.into(), value.into()));
            }
            self
        }

        pub fn add_node<T: Into<Node>>(self, node: T) -> Self {
            self.with_node(node)
        }

        pub fn add_edge<T: Into<Edge>>(self, edge: T) -> Self {
            self.with_edge(edge)
        }

        pub fn add_attr<K: Into<String>, V: Into<String>>(self, key: K, value: V) -> Self {
            self.with_attr(key, value)
        }

        pub fn with_attribute<K: Into<String>, V: Into<String>>(self, key: K, value: V) -> Self {
            self.with_attr(key, value)
        }

        pub fn node(&self, name: &str) -> Option<&Node> {
            self.nodes.iter().find(|n| n.name == name)
        }

        pub fn edge(&self, from: &str, to: &str) -> Option<&Edge> {
            self.edges.iter().find(|e| e.from == from && e.to == to)
        }

        pub fn attr(&self, key: &str) -> Option<&str> {
            self.attrs
                .iter()
                .rev()
                .find(|(k, _)| k == key)
                .map(|(_, v)| v.as_str())
        }

        pub fn attribute(&self, key: &str) -> Option<&str> {
            self.attr(key)
        }
    }

    impl Node {
        pub fn new<N: Into<String>>(name: N) -> Self {
            Self {
                name: name.into(),
                attrs: Vec::new(),
            }
        }

        pub fn with_attr<K: Into<String>, V: Into<String>>(mut self, key: K, value: V) -> Self {
            self.attrs.push((key.into(), value.into()));
            self
        }

        pub fn with_attrs<I, K, V>(mut self, attrs: I) -> Self
        where
            I: IntoIterator<Item = (K, V)>,
            K: Into<String>,
            V: Into<String>,
        {
            for (key, value) in attrs {
                self.attrs.push((key.into(), value.into()));
            }
            self
        }

        pub fn add_attr<K: Into<String>, V: Into<String>>(self, key: K, value: V) -> Self {
            self.with_attr(key, value)
        }

        pub fn with_attribute<K: Into<String>, V: Into<String>>(self, key: K, value: V) -> Self {
            self.with_attr(key, value)
        }

        pub fn attr(&self, key: &str) -> Option<&str> {
            self.attrs
                .iter()
                .rev()
                .find(|(k, _)| k == key)
                .map(|(_, v)| v.as_str())
        }

        pub fn attribute(&self, key: &str) -> Option<&str> {
            self.attr(key)
        }
    }

    impl Edge {
        pub fn new<F: Into<String>, T: Into<String>>(from: F, to: T) -> Self {
            Self {
                from: from.into(),
                to: to.into(),
                attrs: Vec::new(),
            }
        }

        pub fn with_attr<K: Into<String>, V: Into<String>>(mut self, key: K, value: V) -> Self {
            self.attrs.push((key.into(), value.into()));
            self
        }

        pub fn with_attrs<I, K, V>(mut self, attrs: I) -> Self
        where
            I: IntoIterator<Item = (K, V)>,
            K: Into<String>,
            V: Into<String>,
        {
            for (key, value) in attrs {
                self.attrs.push((key.into(), value.into()));
            }
            self
        }

        pub fn add_attr<K: Into<String>, V: Into<String>>(self, key: K, value: V) -> Self {
            self.with_attr(key, value)
        }

        pub fn with_attribute<K: Into<String>, V: Into<String>>(self, key: K, value: V) -> Self {
            self.with_attr(key, value)
        }

        pub fn attr(&self, key: &str) -> Option<&str> {
            self.attrs
                .iter()
                .rev()
                .find(|(k, _)| k == key)
                .map(|(_, v)| v.as_str())
        }

        pub fn attribute(&self, key: &str) -> Option<&str> {
            self.attr(key)
        }
    }

    impl From<&str> for Node {
        fn from(name: &str) -> Self {
            Self::new(name)
        }
    }

    impl From<String> for Node {
        fn from(name: String) -> Self {
            Self::new(name)
        }
    }

    impl From<&Node> for Node {
        fn from(node: &Node) -> Self {
            node.clone()
        }
    }

    impl From<(&str, &str)> for Edge {
        fn from((from, to): (&str, &str)) -> Self {
            Self::new(from, to)
        }
    }

    impl From<(String, String)> for Edge {
        fn from((from, to): (String, String)) -> Self {
            Self::new(from, to)
        }
    }

    impl From<(String, &str)> for Edge {
        fn from((from, to): (String, &str)) -> Self {
            Self::new(from, to)
        }
    }

    impl From<(&str, String)> for Edge {
        fn from((from, to): (&str, String)) -> Self {
            Self::new(from, to)
        }
    }

    impl From<&Edge> for Edge {
        fn from(edge: &Edge) -> Self {
            edge.clone()
        }
    }

    fn format_attrs(attrs: &[(String, String)]) -> String {
        attrs
            .iter()
            .map(|(key, value)| format!("{}=\"{}\"", key, value))
            .collect::<Vec<_>>()
            .join(", ")
    }

    impl fmt::Display for Node {
        fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
            if self.attrs.is_empty() {
                write!(f, "{}", self.name)
            } else {
                write!(f, "{} [{}]", self.name, format_attrs(&self.attrs))
            }
        }
    }

    impl fmt::Display for Edge {
        fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
            if self.attrs.is_empty() {
                write!(f, "{} -- {}", self.from, self.to)
            } else {
                write!(f, "{} -- {} [{}]", self.from, self.to, format_attrs(&self.attrs))
            }
        }
    }

    impl fmt::Display for Graph {
        fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
            let mut lines = Vec::new();

            if !self.attrs.is_empty() {
                lines.push(format!("graph [{}]", format_attrs(&self.attrs)));
            }

            for node in &self.nodes {
                lines.push(node.to_string());
            }

            for edge in &self.edges {
                lines.push(edge.to_string());
            }

            write!(f, "graph {{")?;
            if lines.is_empty() {
                writeln!(f)?;
            } else {
                for line in lines {
                    writeln!(f, "    {}", line)?;
                }
            }
            write!(f, "}}")
        }
    }
}

pub use graph::{Edge, Graph, Node};
