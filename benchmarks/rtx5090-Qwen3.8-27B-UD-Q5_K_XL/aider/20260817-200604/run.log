import json
from decimal import Decimal, ROUND_HALF_UP

class RestAPI:
    def __init__(self, database=None):
        self.database = {}
        if database is not None:
            self._load_database(database)

    @staticmethod
    def _round_amount(value):
        try:
            amount = Decimal(str(value)).quantize(Decimal('0.01'), rounding=ROUND_HALF_UP)
        except Exception:
            return 0.0
        result = float(amount)
        return 0.0 if result == 0 else result

    @staticmethod
    def _is_user_mapping(data):
        if not isinstance(data, dict) or not data:
            return False
        if any(key in data for key in ('name', 'owes', 'owed_by', 'balance')):
            return False
        return all(isinstance(value, dict) for value in data.values())

    @staticmethod
    def _is_single_user(data):
        if not isinstance(data, dict):
            return False
        if 'name' not in data:
            return False
        return any(key in data for key in ('owes', 'owed_by', 'balance'))

    def _load_database(self, database):
        if isinstance(database, (bytes, bytearray)):
            database = database.decode()
        if isinstance(database, str):
            try:
                database = json.loads(database)
            except Exception:
                return

        if isinstance(database, dict):
            if self._is_single_user(database):
                self.database = {}
                self._load_user(str(database.get('name', '')), database)
                self._reconcile_database()
                return

            if 'users' in database:
                users_value = database['users']
                if isinstance(users_value, list) or self._is_user_mapping(users_value):
                    self.database = {}
                    users_data = users_value
                else:
                    self.database = database
                    users_data = database
            else:
                self.database = database
                users_data = database
        elif isinstance(database, list):
            self.database = {}
            users_data = database
        else:
            return

        if isinstance(users_data, dict):
            for name, user in users_data.items():
                self._load_user(str(name), user)
        elif isinstance(users_data, list):
            for user in users_data:
                if isinstance(user, dict) and 'name' in user:
                    self._load_user(str(user['name']), user)
                elif isinstance(user, str):
                    self._load_user(user, {})

        self._reconcile_database()

    def _load_user(self, name, user=None):
        name = str(name)
        owes = {}
        owed_by = {}
        if isinstance(user, dict):
            raw_owes = user.get('owes', {})
            if isinstance(raw_owes, dict):
                for other, amount in raw_owes.items():
                    amount = self._round_amount(amount)
                    if amount > 0:
                        owes[str(other)] = amount
            raw_owed_by = user.get('owed_by', {})
            if isinstance(raw_owed_by, dict):
                for other, amount in raw_owed_by.items():
                    amount = self._round_amount(amount)
                    if amount > 0:
                        owed_by[str(other)] = amount
        self.database[name] = {
            'name': name,
            'owes': owes,
            'owed_by': owed_by,
            'balance': self._round_amount(sum(owed_by.values()) - sum(owes.values())),
        }

    def _reconcile_database(self):
        for name in list(self.database.keys()):
            user = self.database[name]
            for other in list(user.get('owes', {}).keys()):
                self._ensure_user(str(other))
            for other in list(user.get('owed_by', {}).keys()):
                self._ensure_user(str(other))

        for name, user in list(self.database.items()):
            for other, amount in list(user.get('owes', {}).items()):
                other = str(other)
                amount = self._round_amount(amount)
                if amount > 0:
                    self.database[other]['owed_by'][name] = amount
                else:
                    self.database[other]['owed_by'].pop(name, None)

            for other, amount in list(user.get('owed_by', {}).items()):
                other = str(other)
                amount = self._round_amount(amount)
                if amount > 0:
                    self.database[other]['owes'][name] = amount
                else:
                    self.database[other]['owes'].pop(name, None)

        for name in list(self.database.keys()):
            self._recalc_balance(name)

    def _ensure_user(self, name):
        name = str(name)
        if name not in self.database:
            self.database[name] = {
                'name': name,
                'owes': {},
                'owed_by': {},
                'balance': 0.0,
            }
        return name

    def _recalc_balance(self, name):
        name = str(name)
        user = self.database.get(name)
        if not user:
            return
        user['balance'] = self._round_amount(
            sum(user.get('owed_by', {}).values()) - sum(user.get('owes', {}).values())
        )

    def _increase_debt(self, from_user, to_user, amount):
        amount = self._round_amount(amount)
        if amount <= 0:
            return
        from_user = str(from_user)
        to_user = str(to_user)
        self._ensure_user(from_user)
        self._ensure_user(to_user)

        self.database[from_user]['owes'][to_user] = self._round_amount(
            self.database[from_user]['owes'].get(to_user, 0.0) + amount
        )
        self.database[to_user]['owed_by'][from_user] = self._round_amount(
            self.database[to_user]['owed_by'].get(from_user, 0.0) + amount
        )
        self._recalc_balance(from_user)
        self._recalc_balance(to_user)

    def _decrease_debt(self, from_user, to_user, amount):
        amount = self._round_amount(amount)
        if amount <= 0:
            return
        from_user = str(from_user)
        to_user = str(to_user)
        self._ensure_user(from_user)
        self._ensure_user(to_user)

        current = self._round_amount(
            self.database[from_user]['owes'].get(to_user, 0.0)
        )
        remaining = self._round_amount(current - amount)

        if remaining <= 0:
            self.database[from_user]['owes'].pop(to_user, None)
            self.database[to_user]['owed_by'].pop(from_user, None)
        else:
            self.database[from_user]['owes'][to_user] = remaining
            self.database[to_user]['owed_by'][from_user] = remaining

        self._recalc_balance(from_user)
        self._recalc_balance(to_user)

    def _add_iou(self, lender, borrower, amount):
        lender = str(lender)
        borrower = str(borrower)
        try:
            amount = self._round_amount(abs(float(amount)))
        except Exception:
            amount = 0.0

        self._ensure_user(lender)
        self._ensure_user(borrower)

        if amount <= 0 or lender == borrower:
            return

        opposite = self._round_amount(
            self.database[lender]['owes'].get(borrower, 0.0)
        )
        if opposite > 0:
            cancel = min(opposite, amount)
            self._decrease_debt(lender, borrower, cancel)
            amount = self._round_amount(amount - cancel)

        if amount > 0:
            self._increase_debt(borrower, lender, amount)

    def _user_object(self, name):
        name = str(name)
        user = self.database.get(name)
        if user is None:
            return {'name': name, 'owes': {}, 'owed_by': {}, 'balance': 0.0}

        owes = {}
        for other in sorted(user.get('owes', {})):
            amount = self._round_amount(user['owes'][other])
            if amount > 0:
                owes[str(other)] = amount

        owed_by = {}
        for other in sorted(user.get('owed_by', {})):
            amount = self._round_amount(user['owed_by'][other])
            if amount > 0:
                owed_by[str(other)] = amount

        balance = self._round_amount(sum(owed_by.values()) - sum(owes.values()))
        return {
            'name': name,
            'owes': owes,
            'owed_by': owed_by,
            'balance': balance,
        }

    @staticmethod
    def _normalize_url(url):
        if url is None:
            return ''
        url = str(url).strip()
        if url.endswith('/') and url != '/':
            url = url.rstrip('/')
        return url

    @staticmethod
    def _parse_payload(payload):
        if payload is None:
            return None
        if isinstance(payload, (bytes, bytearray)):
            payload = payload.decode()
        if isinstance(payload, str):
            try:
                return json.loads(payload)
            except Exception:
                return payload
        return payload

    def _json(self, value):
        return json.dumps(value)

    def get(self, url, payload=None):
        url = self._normalize_url(url)
        if url == '/users':
            parsed = self._parse_payload(payload)
            if parsed is None:
                names = list(self.database.keys())
            elif isinstance(parsed, list):
                names = parsed
            elif isinstance(parsed, dict):
                if 'users' in parsed:
                    names = parsed['users']
                else:
                    names = list(self.database.keys())
            else:
                names = list(self.database.keys())

            if isinstance(names, str):
                names = [names]
            if not isinstance(names, list):
                names = []

            names = [str(name) for name in names if str(name) in self.database]
            names.sort()
            return self._json({'users': [self._user_object(name) for name in names]})

        return self._json({})

    def post(self, url, payload=None):
        url = self._normalize_url(url)
        parsed = self._parse_payload(payload)

        if url == '/add':
            if isinstance(parsed, dict):
                name = parsed.get('user')
            elif isinstance(parsed, str):
                name = parsed
            else:
                name = None

            if name is None or str(name) == '':
                return self._json({})

            name = str(name)
            self._ensure_user(name)
            return self._json(self._user_object(name))

        if url == '/iou':
            if isinstance(parsed, dict):
                lender = parsed.get('lender')
                borrower = parsed.get('borrower')
                amount = parsed.get('amount', 0)
            else:
                lender = None
                borrower = None
                amount = 0

            if lender is None or borrower is None:
                return self._json({'users': []})

            lender = str(lender)
            borrower = str(borrower)
            self._add_iou(lender, borrower, amount)

            names = sorted({lender, borrower})
            return self._json({'users': [self._user_object(name) for name in names]})

        return self._json({})
```

