function isFlatTonic(tonic) {
  const t = tonic.trim();
  const letter = t[0].toUpperCase();
  const rest = t.slice(1);
  if (rest === 'b' || rest === 'B') return true;
  if (rest === '#') return false;
  switch (letter) {
    case 'F': return true;
    case 'C': return t[0] === 'c';
    case 'D': return t[0] === 'd';
    case 'G': return t[0] === 'g';
