//
// This is only a SKELETON file for the 'Alphametics' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export const solve = (puzzle) => {
  const [left, right] = puzzle.split(/\s*(?:==|=)\s*/);
  if (!left || right === undefined) {
    return null;
  }

  const addends = left
    .split('+')
    .map((word) => word.trim())
    .filter((word) => word.length > 0);
  const result = right.trim();

  if (addends.length === 0 || result.length === 0) {
    return null;
  }

  const allWords = [...addends, result];
  const letters = [...new Set(allWords.join(''))];

  if (letters.length > 10) {
    return null;
  }

  const leading = new Set();
  for (const word of allWords) {
    if (word.length > 1) {
      leading.add(word[0]);
    }
  }

  const coeff = new Map();
  const addWord = (word, sign) => {
    for (let i = 0; i < word.length; i += 1) {
      const ch = word[i];
      const place = 10n ** BigInt(word.length - 1 - i);
      coeff.set(ch, (coeff.get(ch) || 0n) + sign * place);
    }
  };

  for (const word of addends) {
    addWord(word, 1n);
  }
  addWord(result, -1n);

  const abs = (x) => (x < 0n ? -x : x);
  const originalIndex = new Map(letters.map((ch, i) => [ch, i]));

  const ordered = [...letters].sort((a, b) => {
    const aa = abs(coeff.get(a) || 0n);
    const bb = abs(coeff.get(b) || 0n);
    if (aa !== bb) {
      return aa > bb ? -1 : 1;
    }

    const la = leading.has(a) ? 1 : 0;
    const lb = leading.has(b) ? 1 : 0;
    if (la !== lb) {
      return lb - la;
    }

    return originalIndex.get(a) - originalIndex.get(b);
  });

  const n = ordered.length;
  const suffixCoeffs = [];
  const suffixLeadingCount = [];

  for (let i = 0; i <= n; i += 1) {
    const remaining = ordered.slice(i);
    const coeffs = remaining.map((ch) => coeff.get(ch) || 0n);
    coeffs.sort((x, y) => (x < y ? -1 : x > y ? 1 : 0));
    suffixCoeffs.push(coeffs);
    suffixLeadingCount.push(remaining.filter((ch) => leading.has(ch)).length);
  }

  const minMaxCache = new Map();

  const getMinMax = (index, mask) => {
    const key = (index << 10) | mask;
    if (minMaxCache.has(key)) {
      return minMaxCache.get(key);
    }

    const k = n - index;
    if (k === 0) {
      minMaxCache.set(key, [0n, 0n]);
      return [0n, 0n];
    }

    const digits = [];
    let hasZero = false;
    for (let d = 0; d < 10; d += 1) {
      if ((mask & (1 << d)) === 0) {
        digits.push(d);
        if (d === 0) {
          hasZero = true;
        }
      }
    }

    if (digits.length < k) {
      minMaxCache.set(key, null);
      return null;
    }

    if (hasZero && suffixLeadingCount[index] > digits.length - 1) {
      minMaxCache.set(key, null);
      return null;
    }

    const coeffs = suffixCoeffs[index];
    const minDp = new Array(k + 1).fill(null);
    const maxDp = new Array(k + 1).fill(null);
    minDp[0] = 0n;
    maxDp[0] = 0n;

    for (const d of digits) {
      const bd = BigInt(d);
      for (let t = k - 1; t >= 0; t -= 1) {
        if (minDp[t] !== null) {
          const val = minDp[t] + coeffs[k - 1 - t] * bd;
          if (minDp[t + 1] === null || val < minDp[t + 1]) {
            minDp[t + 1] = val;
          }
        }

        if (maxDp[t] !== null) {
          const val = maxDp[t] + coeffs[t] * bd;
          if (maxDp[t + 1] === null || val > maxDp[t + 1]) {
            maxDp[t + 1] = val;
          }
        }
      }
    }

    const result =
      minDp[k] === null || maxDp[k] === null ? null : [minDp[k], maxDp[k]];
    minMaxCache.set(key, result);
    return result;
  };

  const value = {};

  const backtrack = (index, sum, mask) => {
    if (index === n) {
      return sum === 0n;
    }

    const minMax = getMinMax(index, mask);
    if (minMax === null) {
      return false;
    }

    const target = -sum;
    if (target < minMax[0] || target > minMax[1]) {
      return false;
    }

    const ch = ordered[index];
    const c = coeff.get(ch) || 0n;

    for (let d = 0; d < 10; d += 1) {
      if ((mask & (1 << d)) !== 0) {
        continue;
      }
      if (leading.has(ch) && d === 0) {
        continue;
      }

      mask |= 1 << d;
      value[ch] = d;

      if (backtrack(index + 1, sum + c * BigInt(d), mask)) {
        return true;
      }

      mask &= ~(1 << d);
      delete value[ch];
    }

    return false;
  };

  return backtrack(0, 0n, 0) ? { ...value } : null;
};
```

