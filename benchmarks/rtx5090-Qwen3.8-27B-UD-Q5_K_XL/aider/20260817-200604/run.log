def transpose(text):
    rows = text.split('\n')
    max_len = max(len(row) for row in rows)

    transposed = []
    for col in range(max_len):
        last_row = -1
        for row_idx, row in enumerate(rows):
            if col < len(row):
                last_row = row_idx

        if last_row == -1:
            continue

        transposed.append(
            ''.join(
                row[col] if col < len(row) else ' '
                for row in rows[:last_row + 1]
            )
        )

    return '\n'.join(transposed)
