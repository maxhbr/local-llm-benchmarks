```
def answer(question):
    q = question.strip().lower()
    if not q.startswith("what is "):
        raise ValueError("syntax error")

    expr = q[len("what is "):].rstrip("?").strip()
    expr = " ".join(expr.split())
    if not expr:
        raise ValueError("syntax error")

    expr = expr.replace("multiplied by", "multiplied_by").replace("divided by", "divided_by")
    tokens = expr.split()

    operations = {
        "plus": "+",
        "minus": "-",
        "multiplied_by": "*",
        "divided_by": "/",
    }

    def parse_int(token):
        try:
            return int(token)
        except ValueError:
            return None

    value = parse_int(tokens[0])
    if value is None:
        if tokens[0] in operations:
            raise ValueError("syntax error")
        raise ValueError("syntax error")

    i = 1
    while i < len(tokens):
        op_token = tokens[i]
        if op_token not in operations:
            if parse_int(op_token) is not None:
                raise ValueError("syntax error")
            raise ValueError("unknown operation")

        i += 1
        if i >= len(tokens):
            raise ValueError("syntax error")

        number_token = tokens[i]
        number = parse_int(number_token)
        if number is None:
            if number_token in operations:
                raise ValueError("syntax error")
            raise ValueError("unknown operation")

        if operations[op_token] == "+":
            value += number
        elif operations[op_token] == "-":
            value -= number
        elif operations[op_token] == "*":
            value *= number
        else:
            if number == 0:
                raise ValueError("syntax error")
            quotient = abs(value) // abs(number)
            if (value < 0) != (number < 0):
                quotient = -quotient
            value = quotient

        i += 1

    return value
```

