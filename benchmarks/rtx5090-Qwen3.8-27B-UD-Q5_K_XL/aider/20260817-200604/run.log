class PigLatinTranslator {
    public String translate(String word) {
        if (word == null) {
            return null;
        }

        if (word.isEmpty()) {
            return "";
        }

        StringBuilder translated = new StringBuilder();
        int index = 0;

        while (index < word.length()) {
            char current = word.charAt(index);

            if (Character.isWhitespace(current)) {
                translated.append(current);
                index++;
            } else {
                int start = index;
                while (index < word.length() && !Character.isWhitespace(word.charAt(index))) {
                    index++;
                }
                translated.append(translateWord(word.substring(start, index)));
            }
        }

        return translated.toString();
    }

    private String translateWord(String word) {
        if (word.isEmpty()) {
            return "";
        }

        String lower = word.toLowerCase();
        int length = lower.length();
        int split = 0;

        if (isVowel(lower.charAt(0)) || lower.startsWith("xr") || lower.startsWith("yt")) {
            split = 0;
        } else {
            while (split < length) {
                char current = lower.charAt(split);

                if (isVowel(current)) {
                    break;
                }

                if (current == 'y' && split > 0) {
                    break;
                }

                if (current == 'q' && split + 1 < length && lower.charAt(split + 1) == 'u') {
                    split += 2;
                    break;
                }

                split++;
            }
        }

        return word.substring(split) + word.substring(0, split) + "ay";
    }

    private boolean isVowel(char c) {
        return c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u';
    }
}

