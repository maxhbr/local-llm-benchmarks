```
fn hand_score(hand: &str) -> HandScore {
    let cards: Vec<(u8, char)> = hand.split_whitespace().filter_map(|card| parse_card(card)).collect();
    if cards.len() != 5 { return HandScore { category: 0, tiebreakers: vec![] }; }
    let ranks: Vec<u8> = cards.iter().map(|c| c.0).collect();
    let flush = cards.iter().all(|c| c.1 == cards[0].1);
    let mut descending = ranks.clone();
    descending.sort_unstable_by(|a,b| b.cmp(a));
    let straight_high = straight_high(&ranks);
    let mut counts: Vec<(u8, u8)> = rank_counts(&ranks); // (count, rank)
    counts.sort_unstable_by(|a,b| b.0.cmp(&a.0).then(b.1.cmp(&a.1)));

    let (category, tiebreakers) = if flush && straight_high != 0 {
       (9, vec![straight_high])
    } else if counts[0].0 == 4 {
       (8, vec![counts[0].1, counts[1].1])
    } else if counts[0].0 == 3 && counts[1].0 == 2 {
       (7, vec![counts[0].1, counts[1].1])
    } else if flush {
       (6, descending)
    } else if straight_high != 0 {
       (5, vec![straight_high])
    } else if counts[0].0 == 3 {
       (4, vec![counts[0].1, counts[1].1, counts[2].1])
    } else if counts[0].0 == 2 && counts[1].0 == 2 {
       (3, vec![counts[0].1, counts[1].1, counts[2].1])
    } else if counts[0].0 == 2 {
       (2, vec![counts[0].1, counts[1].1, counts[2].1])
    } else {
       (1, descending)
    };
    HandScore { category, tiebreakers }
}
```
