Let's design algorithm with pruning and inference.

Pseudo:
```
export const combinations = (sum, size, ...excludedArgs) => {
  if (Array.isArray(sum)) {
    [sum, size, ...excludedArgs] = sum;
  }

  const excluded = new Set(
    excludedArgs
      .flat(Infinity)
      .filter((d) => Number.isInteger(d) && d >= 1 && d <= 9)
  );

  if (size === undefined || size === null) {
    // infer size? 
    size = inferSize(sum, excluded);
  }

  size = Number(size);
  sum = Number(sum);
  if (!Number.isInteger(size) || !Number.isInteger(sum)) return [];
  if (size < 0 || size > 9) return [];
  if (excluded.size + size > 9) return [];

  const digits = [];
  for (let d=1; d<=9; d++) if (!excluded.has(d)) digits.push(d);
  if (digits.length < size) return [];

  // optional min/max sum pruning
  const minSum = digits.slice(0, size).reduce((a,b)=>a+b,0); // since ascending
  const maxSum = digits.slice(-size).reduce((a,b)=>a+b,0);
  if (sum < minSum || sum > maxSum) return [];

  const result = [];
  const current = [];
  const backtrack = (start, currentSum) => {
    if (current.length === size) {
      if (currentSum === sum) result.push([...current]);
      return;
    }
    const remaining = size - current.length;
    for (let i = start; i <= digits.length - remaining; i++) {
      const d = digits[i];
      const nextSum = currentSum + d;
      // prune if nextSum > sum (digits ascending)
      if (nextSum > sum) break;
      // optional prune min/max for remaining after choosing d
      // min possible next digits: digits[i+1] ... i+remaining-1
      // max possible: digits[digits.length-remaining+1] ...? Could skip.
      current.push(d);
      backtrack(i + 1, nextSum);
      current.pop();
    }
  };
  backtrack(0, 0);
  return result;
};
```
