class Scale:
    _SHARP_CHROMATIC = (
        "A", "A#", "B", "C", "C#", "D", "D#",
        "E", "F", "F#", "G", "G#",
    )
    _FLAT_CHROMATIC = (
        "A", "Bb", "B", "C", "Db", "D", "Eb",
        "E", "F", "Gb", "G", "Ab",
    )

    _MAJOR_FLAT_TONICS = frozenset({"F", "Bb", "Eb", "Ab", "Db", "Gb"})
    _MINOR_FLAT_TONICS = frozenset({"D", "G", "C", "F", "Bb", "Eb", "Ab", "Db", "Gb"})

    _INTERVAL_STEPS = {
        "m": 1,
        "M": 2,
        "A": 3,
        "a": 3,
    }

    def __init__(self, tonic):
        self._original = tonic.strip()
        self.tonic = self._normalize(self._original)

        is_minor = self._original[:1].islower()
        flat_tonics = self._MINOR_FLAT_TONICS if is_minor else self._MAJOR_FLAT_TONICS
        self._use_flats = self.tonic in flat_tonics

        self._chromatic = self._FLAT_CHROMATIC if self._use_flats else self._SHARP_CHROMATIC

    def chromatic(self):
        start = self._chromatic.index(self.tonic)
        return self._chromatic[start:] + self._chromatic[:start]

    def interval(self, intervals):
        notes = [self.tonic]
        index = self._chromatic.index(self.tonic)

        for interval in intervals:
            step = self._INTERVAL_STEPS.get(interval)
            if step is None:
                raise ValueError(f"Unknown interval: {interval!r}")

            index = (index + step) % len(self._chromatic)
            notes.append(self._chromatic[index])

        return notes

    @staticmethod
    def _normalize(note):
        note = note.strip()
        if not note:
            return note

        if note[-1] in ("#", "♯"):
            return note[0].upper() + "#"

        if note[-1] in ("b", "♭") and len(note) > 1:
            return note[0].upper() + "b"

        return note[0].upper()
```
