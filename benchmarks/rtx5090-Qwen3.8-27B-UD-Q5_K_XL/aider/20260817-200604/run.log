Full file:
```
import java.util.*;

public class React {

    public static class Cell<T> {
        protected T value;
        protected final List<ComputeCell<?>> dependents = new ArrayList<>();

        public Cell() {
            this.value = null;
        }

        protected Cell(T value) {
            this.value = value;
        }

        public T getValue() {
            return value;
        }
    }

    public static class InputCell<T> extends Cell<T> {
        public InputCell(T value) {
            super(value);
        }

        public void setValue(T newValue) {
            if (!Objects.equals(value, newValue)) {
                value = newValue;
                propagate(this);
            }
        }
    }

    public static class ComputeCell<T> extends Cell<T> {
        private final Function<List<T>, T> function;
        private final List<Cell<T>> dependencies;
        private final List<Consumer<T>> callbacks = new ArrayList<>();

        ComputeCell(Function<List<T>, T> function, List<Cell<T>> dependencies) {
            super(null);
            this.function = function;
            this.dependencies = new ArrayList<>(dependencies);
        }

        public void addCallback(Consumer<T> callback) {
            callbacks.add(callback);
        }

        public void removeCallback(Consumer<T> callback) {
            callbacks.remove(callback);
        }

        private boolean recompute() {
            List<T> values = new ArrayList<>(dependencies.size());
            for (Cell<T> dependency : dependencies) {
                values.add(dependency.getValue());
            }
            T newValue = function.apply(values);
            if (!Objects.equals(value, newValue)) {
                value = newValue;
                return true;
            }
            return false;
        }

        private void notifyCallbacks() {
            List<Consumer<T>> snapshot = new ArrayList<>(callbacks);
            for (Consumer<T> callback : snapshot) {
                callback.accept(value);
            }
        }
    }

    public static <T> InputCell<T> inputCell(T initialValue) {
        return new InputCell<>(initialValue);
    }

    public static <T> ComputeCell<T> computeCell(Function<List<T>, T> function, List<Cell<T>> cells) {
        ComputeCell<T> cell = new ComputeCell<>(function, cells);
        List<T> values = new ArrayList<>(cells.size());
        for (Cell<T> cell : cells) {
            values.add(cell.getValue());
        }
        cell.value = function.apply(values);
        for (Cell<T> dependency : cells) {
            dependency.dependents.add(cell);
        }
        return cell;
    }

    private static void propagate(Cell<?> changed) {
        Set<ComputeCell<?>> reachable = new LinkedHashSet<>();
        Deque<Cell<?>> queue = new ArrayDeque<>();
        Set<Cell<?>> visited = new HashSet<>();
        queue.add(changed);

        while (!queue.isEmpty()) {
            Cell<?> current = queue.poll();
            if (!visited.add(current)) {
                continue;
            }
            for (ComputeCell<?> dependent : current.dependents) {
                if (reachable.add(dependent)) {
                    queue.add(dependent);
                }
            }
        }

        if (reachable.isEmpty()) {
            return;
        }

        Map<ComputeCell<?>, Integer> indegree = new LinkedHashMap<>();
        for (ComputeCell<?> cell : reachable) {
            indegree.put(cell, 0);
        }

        for (ComputeCell<?> cell : reachable) {
            for (Cell<?> dependency : cell.dependencies) {
                if (dependency instanceof ComputeCell && reachable.contains(dependency)) {
                    indegree.merge(cell, 1, Integer::sum);
                }
            }
        }

        Deque<ComputeCell<?>> ready = new ArrayDeque<>();
        for (ComputeCell<?> cell : reachable) {
            if (indegree.get(cell) == 0) {
                ready.add(cell);
            }
        }

        List<ComputeCell<?>> changedCells = new ArrayList<>();

        while (!ready.isEmpty()) {
            ComputeCell<?> cell = ready.poll();
            if (cell.recompute()) {
                changedCells.add(cell);
            }
            for (ComputeCell<?> dependent : cell.dependents) {
                if (reachable.contains(dependent)) {
                    int degree = indegree.merge(dependent, -1, Integer::sum);
                    if (degree == 0) {
                        ready.add(dependent);
                    }
                }
            }
        }

        for (ComputeCell<?> cell : changedCells) {
            cell.notifyCallbacks();
        }
    }
}
```

