        node = Node(1)
        self.assertEqual(node.value(), 1)

    def test_node_next(self):
        node = Node(1)
        self.assertIsNone(node.next())

    def test_linked_list_initialization(self):
        linked_list = LinkedList()
        self.assertIsNone(linked_list.head())

    def test_linked_list_with_values(self):
        linked_list = LinkedList([1, 2, 3])
        self.assertEqual(list(linked_list), [3, 2, 1])

    def test_linked_list_push(self):
        linked_list = LinkedList()
        linked_list.push(1)
        self.assertEqual(linked_list.head().value(), 1)

    def test_linked_list_pop(self):
        linked_list = LinkedList([1, 2, 3])
        self.assertEqual(linked_list.pop(), 3)

    def test_linked_list_pop_empty(self):
        linked_list = LinkedList()
        with self.assertRaises(EmptyListException):
            linked_list.pop()

    def test_linked_list_reversed(self):
        linked_list = LinkedList([1, 2, 3])
        reversed_list = linked_list.reversed()
        self.assertEqual(list(reversed_list), [1, 2, 3])

    def test_linked_list_reversed_empty(self):
        linked_list = LinkedList()
        reversed_list = linked_list.reversed()
        self.assertEqual(list(reversed_list), [])

if __name__ == '__main__':
    unittest.main()
```

