     key := parts[2*i] + " " + suit
     if seen[key] { return hand{}, errors.New("duplicate card") }
     seen[key] = true
     h.ranks[i] = rank
     h.suits[i] = suit
   }
 } else { return hand{}, errors.New("invalid hand") }
 h.category, h.tie = evaluate(h.ranks, h.suits)
 return h, nil
}

