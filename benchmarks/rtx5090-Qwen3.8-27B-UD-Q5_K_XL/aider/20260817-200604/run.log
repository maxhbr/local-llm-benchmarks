def _propagate(source):
    affected = reachable compute cells from source
    if not affected: return
    order = topological_sort(affected)
    changed_ids = {id(source)}
    changed_compute_cells = []
    for cell in order:
        if any(id(input_cell) in changed_ids for input_cell in cell._inputs):
            old_value = cell._value
            cell._value = cell._compute()
            if cell._value != old_value:
                changed_ids.add(id(cell))
                changed_compute_cells.append(cell)
    for cell in changed_compute_cells:
        for callback in list(cell._callbacks): _invoke_callback(callback, cell._value)
```
