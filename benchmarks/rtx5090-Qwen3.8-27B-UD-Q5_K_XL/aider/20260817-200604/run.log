def can_chain(dominoes):
    if not dominoes:
        return []

    degree = {}
    adjacency = {}
    for edge_id, (left, right) in enumerate(dominoes):
        degree[left] = degree.get(left, 0) + 1
        degree[right] = degree.get(right, 0) + 1
        adjacency.setdefault(left, []).append((right, edge_id))
        if left != right:
            adjacency.setdefault(right, []).append((left, edge_id))

    if any(count % 2 for count in degree.values()):
        return None

    start = next(iter(degree))
    visited = {start}
    stack = [start]
    while stack:
        vertex = stack.pop()
        for neighbor, _ in adjacency.get(vertex, []):
            if neighbor not in visited:
                visited.add(neighbor)
                stack.append(neighbor)
    if len(visited) != len(degree):
        return None

    used = [False] * len(dominoes)
    vertex_stack = [start]
    edge_stack = []? Let's use stack entries.
    stack = [(start, -1)]
    circuit_vertices = []
    circuit_edges = []
    while stack:
        vertex, incoming_edge = stack[-1]
        neighbors = adjacency.get(vertex, [])
        while neighbors and used[neighbors[-1][1]]:
            neighbors.pop()
        if neighbors:
            neighbor, edge_id = neighbors.pop()
            used[edge_id] = True
            stack.append((neighbor, edge_id))
        else:
            stack.pop()
            circuit_vertices.append(vertex)
            if incoming_edge != -1:
                circuit_edges.append(incoming_edge)

    # Safety: if not all used or lengths wrong return None?
    if len(circuit_vertices) != len(dominoes) + 1 or len(circuit_edges) != len(dominoes):
        return None
    # optional verify all used
    if not all(used): return None
    circuit_vertices.reverse()
    # circuit_edges.reverse() not needed
    return [(circuit_vertices[i], circuit_vertices[i + 1]) for i in range(len(dominoes))]

