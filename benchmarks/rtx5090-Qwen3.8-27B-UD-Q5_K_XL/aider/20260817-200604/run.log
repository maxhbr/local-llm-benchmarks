import java.util.TreeMap;

class RestApi {
    private final Map<String, User> users;

    RestApi(User... users) {
        this.users = new TreeMap<>();
        for (User user : users) {
            if (user != null && user.name() != null) {
                this.users.put(user.name(), user);
            }
        }
    }

    String get(String url) {
        return get(url, null);
    }

    String get(String url, JSONObject payload) {
        if ("/users".equals(url)) {
            return usersJson(getUsers(payload));
        }
        return "{}";
    }

    String post(String url, JSONObject payload) {
        if ("/add".equals(url)) {
            return addUser(payload);
        }
        if ("/iou".equals(url)) {
            return createIou(payload);
        }
        return "{}";
    }

    private List<User> getUsers(JSONObject payload) {
        List<User> result = new ArrayList<>();
        if (payload != null && payload.has("users")) {
            try {
                var array = payload.getJSONArray("users");
                for (int i=0; i<array.length(); i++) {
                    String name = array.getString(i);
                    User user = users.get(name);
                    if (user != null) result.add(user);
                }
            } catch (Exception e) {
                // ignore malformed?
            }
        } else {
            result.addAll(users.values());
        }
        result.sort(Comparator.comparing(User::name));
        return result;
    }
...
}
