```
import java.util.ArrayDeque;
import java.util.Queue;

public class Connect {
    private static final int[][] NEIGHBORS = {
        {-1, 0},
        {-1, 1},
        {0, -1},
        {0, 1},
        {1, -1},
        {1, 0}
    };

    private final char[][] board;
    private final int rows;
    private final int cols;

    public Connect(String[] board) {
        this.rows = board == null ? 0 : board.length;
        String[] cleanedRows = new String[this.rows];
        int maxCols = 0;
        for (int r = 0; r < this.rows; r++) {
            String row = board[r] == null ? "" : board[r];
            StringBuilder cleaned = new StringBuilder();
            for (int i = 0; i < row.length(); i++) {
                char ch = row.charAt(i);
                if (!Character.isWhitespace(ch)) {
                    cleaned.append(Character.toUpperCase(ch));
                }
            }
            cleanedRows[r] = cleaned.toString();
            maxCols = Math.max(maxCols, cleanedRows[r].length());
        }
        this.cols = maxCols;
        this.board = new char[this.rows][this.cols];
        for (int r = 0; r < this.rows; r++) {
            for (int c = 0; c < this.cols; c++) {
                this.board[r][c] = c < cleanedRows[r].length() ? cleanedRows[r].charAt(c) : '.';
            }
        }
    }

    public Winner computeWinner() {
        if (rows == 0 || cols == 0) {
            return Winner.NONE;
        }
        if (connects('O', true)) {
            return Winner.PLAYER_O;
        }
        if (connects('X', false)) {
            return Winner.PLAYER_X;
        }
        return Winner.NONE;
    }

    private boolean connects(char player, boolean vertical) {
        boolean[][] visited = new boolean[rows][cols];
        Queue<int[]> queue = new ArrayDeque<>();
        if (vertical) {
            for (int c = 0; c < cols; c++) {
                if (board[0][c] == player) {
                    visited[0][c] = true;
                    queue.add(new int[]{0, c});
                }
            }
        } else {
            for (int r = 0; r < rows; r++) {
                if (board[r][0] == player) {
                    visited[r][0] = true;
                    queue.add(new int[]{r, 0});
                }
            }
        }
        while (!queue.isEmpty()) {
            int[] current = queue.poll();
            int r = current[0];
            int c = current[1];
            if (vertical ? r == rows - 1 : c == cols - 1) {
                return true;
            }
            for (int[] delta : NEIGHBORS) {
                int nr = r + delta[0];
                int nc = c + delta[1];
                if (nr < 0 || nr >= rows || nc < 0 || nc >= cols) {
                    continue;
                }
                if (visited[nr][nc] || board[nr][nc] != player) {
                    continue;
                }
                visited[nr][nc] = true;
                queue.add(new int[]{nr, nc});
            }
        }
        return false;
    }
}
```

