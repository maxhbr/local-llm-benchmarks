def _add_iou(self, lender, borrower, amount):
    amount = _round(amount)
    if amount <= 0: return
    # ensure users exist
    self._ensure_user(lender); self._ensure_user(borrower)
    # borrower owes lender amount
    opposite = self.users[lender]['owes'].get(borrower, 0.0)
    if opposite:
        cancel = min(opposite, amount)
        self._decrease_debt(lender, borrower, cancel) # lender owes borrower
        amount -= cancel
    if amount:
        self._increase_debt(borrower, lender, amount) # borrower owes lender
```
