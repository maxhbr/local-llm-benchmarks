```
import java.util.ArrayList;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;

public class SgfParsing {
    public SgfNode parse(String input) throws SgfParsingException {
        if (input == null || input.isEmpty()) {
            throw new SgfParsingException("Empty string");
        }

        int[] pos = {0};
        ParsedNode parsed = parseTree(input, pos);

        if (pos[0] != input.length()) {
            throw new SgfParsingException("Unbalanced");
        }

        return toSgfNode(parsed);
    }

    private ParsedNode parseTree(String input, int[] pos) throws SgfParsingException {
        if (pos[0] >= input.length() || input.charAt(pos[0]) != '(') {
            throw new SgfParsingException("Missing root tree");
        }

        pos[0]++;

        ParsedNode root = null;
        ParsedNode current = null;
        boolean closed = false;

        while (pos[0] < input.length()) {
            char c = input.charAt(pos[0]);

            if (c == ')') {
                pos[0]++;
                closed = true;
                break;
            } else if (c == ';') {
                ParsedNode node = parseNode(input, pos);

                if (root == null) {
                    root = node;
                    current = node;
                } else {
                    current.children.add(node);
                    current = node;
                }
            } else if (c == '(') {
                ParsedNode child = parseTree(input, pos);

                if (current == null) {
                    throw new SgfParsingException("Missing root tree");
                }

                current.children.add(child);
            } else {
                throw new SgfParsingException("Invalid property");
            }
        }

        if (!closed) {
            throw new SgfParsingException("Unbalanced");
        }

        if (root == null) {
            throw new SgfParsingException("Missing root tree");
        }

        return root;
    }

    private ParsedNode parseNode(String input, int[] pos) throws SgfParsingException {
        pos[0]++;

        ParsedNode node = new ParsedNode();

        while (pos[0] < input.length()) {
            char c = input.charAt(pos[0]);

            if (c == ';' || c == '(' || c == ')') {
                break;
            }

            parseProperty(input, pos, node.properties);
        }

        return node;
    }

    private void parseProperty(String input, int[] pos, Map<String, List<String>> properties)
            throws SgfParsingException {
        int start = pos[0];

        while (pos[0] < input.length()
                && input.charAt(pos[0]) >= 'A'
                && input.charAt(pos[0]) <= 'Z') {
            pos[0]++;
        }

        String key = input.substring(start, pos[0]);

        if (key.isEmpty()) {
            throw new SgfParsingException("Invalid property key");
        }

        if (pos[0] >= input.length()) {
            throw new SgfParsingException("Unbalanced");
        }

        char next = input.charAt(pos[0]);

        if (next != '[') {
            if (Character.isLetterOrDigit(next)) {
                throw new SgfParsingException("Invalid property key");
            }
            throw new SgfParsingException("Invalid property");
        }

        if (properties.containsKey(key)) {
            throw new SgfParsingException("Property already exists");
        }

        List<String> values = new ArrayList<>();

        while (pos[0] < input.length() && input.charAt(pos[0]) == '[') {
            values.add(parseValue(input, pos));
        }

        if (values.isEmpty()) {
            throw new SgfParsingException("Invalid property");
        }

        properties.put(key, values);
    }

    private String parseValue(String input, int[] pos) throws SgfParsingException {
        pos[0]++;

        StringBuilder value = new StringBuilder();

        while (pos[0] < input.length()) {
            char c = input.charAt(pos[0]);

            if (c == '\\') {
                pos[0]++;

                if (pos[0] >= input.length()) {
                    throw new SgfParsingException("Unbalanced");
                }

                char escaped = input.charAt(pos[0]);

                if (escaped == '\n') {
                    // Newline immediately after a backslash is removed.
                } else if (isNonNewlineWhitespace(escaped)) {
                    value.append(' ');
                } else {
                    value.append(escaped);
                }

                pos[0]++;
            } else if (c == ']') {
                pos[0]++;
                return value.toString();
            } else {
                if (c == '\n') {
                    value.append('\n');
                } else if (isNonNewlineWhitespace(c)) {
                    value.append(' ');
                } else {
                    value.append(c);
                }

                pos[0]++;
            }
        }

        throw new SgfParsingException("Unbalanced");
    }

    private boolean isNonNewlineWhitespace(char c) {
        return c != '\n' && c != '\t' && Character.isWhitespace(c);
    }

    private SgfNode toSgfNode(ParsedNode node) {
        List<SgfNode> children = new ArrayList<>();

        for (ParsedNode child : node.children) {
            children.add(toSgfNode(child));
        }

        Map<String, List<String>> properties = new LinkedHashMap<>();

        for (Map.Entry<String, List<String>> entry : node.properties.entrySet()) {
            properties.put(entry.getKey(), new ArrayList<>(entry.getValue()));
        }

        return new SgfNode(properties, children);
    }

    private static class ParsedNode {
        final Map<String, List<String>> properties = new LinkedHashMap<>();
        final List<ParsedNode> children = new ArrayList<>();
    }
}
