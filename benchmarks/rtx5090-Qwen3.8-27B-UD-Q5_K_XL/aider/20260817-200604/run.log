class WordProblemSolver {
 int solve(final String wordProblem) {
   if (wordProblem == null) throw new IllegalArgumentException("Invalid question");
   String q = wordProblem.trim();
   if (!q.startsWith("What is ")) throw new IllegalArgumentException("Invalid question");
   if (!q.endsWith("?")) throw new IllegalArgumentException("Invalid question");
   String expr = q.substring("What is ".length(), q.length()-1).trim();
   if (expr.isEmpty()) throw ...
   String[] tokens = expr.split("\\s+");
   int idx=0;
   int result = parseNumber(tokens, idx); idx++;
   while (idx < tokens.length) {
     String op = tokens[idx];
     if (op.equals("plus")) { idx++; result += parseNumber(tokens, idx); idx++; }
     else if (op.equals("minus")) { idx++; result -= parseNumber(tokens, idx); idx++; }
     else if (op.equals("multiplied")) {
       if (idx+1 >= tokens.length || !tokens[idx+1].equals("by")) throw ...;
       idx += 2; result *= parseNumber(tokens, idx); idx++;
     } else if (op.equals("divided")) {
       if (idx+1 >= tokens.length || !tokens[idx+1].equals("by")) throw ...;
       idx += 2; result /= parseNumber(tokens, idx); idx++;
     } else throw ...;
   }
   if (idx != tokens.length) throw ...;
   return result;
 }
 private int parseNumber(String[] tokens, int idx) {
   if (idx >= tokens.length) throw ...;
   String token = tokens[idx];
   try { return Integer.parseInt(token); } catch (NumberFormatException e) { throw new IllegalArgumentException("Invalid number", e); }
 }
}

