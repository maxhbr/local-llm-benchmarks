Proposed final:
```
#if !defined(ALL_YOUR_BASE_H)
#define ALL_YOUR_BASE_H

#include <algorithm>
#include <cstddef>
#include <cstdint>
#include <stdexcept>
#include <type_traits>
#include <vector>

namespace all_your_base {
namespace detail {

template <typename T>
typename std::enable_if<std::is_signed<T>::value>::type
check_negative(T digit) {
    if (digit < 0) {
        throw std::invalid_argument("digits must be non-negative");
    }
}

template <typename T>
typename std::enable_if<!std::is_signed<T>::value>::type
check_negative(T) {}

}  // namespace detail

template <typename T>
std::vector<unsigned int> convert(unsigned int input_base,
                                  const std::vector<T>& digits,
                                  unsigned int output_base) {
    if (input_base < 2 || output_base < 2) {
        throw std::invalid_argument("input and output bases must be at least 2");
    }

    const std::uint64_t in_base = static_cast<std::uint64_t>(input_base);
    const std::uint64_t out_base = static_cast<std::uint64_t>(output_base);

    for (const T& digit : digits) {
        detail::check_negative(digit);

        if (static_cast<std::uint64_t>(digit) >= in_base) {
            throw std::invalid_argument("digit out of range for input base");
        }
    }

    std::vector<std::uint32_t> value;

    for (const T& digit : digits) {
        std::uint64_t carry = static_cast<std::uint64_t>(digit);

        for (std::size_t i = 0; i < value.size(); ++i) {
            std::uint64_t current =
                static_cast<std::uint64_t>(value[i]) * in_base + carry;

            value[i] = static_cast<std::uint32_t>(current);
            carry = current >> 32;
        }

        while (carry != 0) {
            value.push_back(static_cast<std::uint32_t>(carry));
            carry >>= 32;
        }
    }

    while (!value.empty() && value.back() == 0) {
        value.pop_back();
    }

    if (value.empty()) {
        return {0};
    }

    std::vector<unsigned int> result;

    while (true) {
        std::uint64_t remainder = 0;
        std::vector<std::uint32_t> quotient(value.size(), 0);

        for (std::size_t i = value.size(); i-- > 0;) {
            std::uint64_t current =
                (remainder << 32) | static_cast<std::uint64_t>(value[i]);

            quotient[i] = static_cast<std::uint32_t>(current / out_base);
            remainder = current % out_base;
        }

        result.push_back(static_cast<unsigned int>(remainder));

        while (!quotient.empty() && quotient.back() == 0) {
            quotient.pop_back();
        }

        if (quotient.empty()) {
            break;
        }

        value.swap(quotient);
    }

    std::reverse(result.begin(), result.end());
    return result;
}

}  // namespace all_your_base

#endif  // ALL_YOUR_BASE_H
```

