package connect

import (
        "fmt"
        "strings"
)

func ResultOf(lines []string) (string, error) {
        board, cols, err := parseBoard(lines)
        if err != nil {
                return "", err
        }
        rows := len(board)
        if rows == 0 || cols == 0 {
                return "draw", nil
        }
        if connects(board, 'O', true) {
                return "O", nil
        }
        if connects(board, 'X', false) {
                return "X", nil
        }
        return "draw", nil
}

func parseBoard(lines []string) ([][]byte, int, error) {
        var board [][]byte
        cols := -1
        for i, line := range lines {
                row, err := parseRow(line)
                if err != nil {
                        return nil, 0, fmt.Errorf("line %d: %w", i+1, err)
                }
                if cols == -1 {
                        cols = len(row)
                } else if len(row) != cols {
                        return nil, 0, fmt.Errorf("line %d: inconsistent board width", i+1)
                }
                board = append(board, row)
        }
        if cols == -1 {
                cols = 0
        }
        return board, cols, nil
}

func parseRow(line string) ([]byte, error) {
        fields := strings.Fields(line)
        var row []byte
        if len(fields) == 1 && len(fields[0]) > 1 {
                // Support boards written without spaces between cells.
                for _, r := range fields[0] {
                        if err := validateCell(r); err != nil {
                                return nil, err
                        }
                        row = append(row, byte(r))
                }
                return row, nil
        }
        for _, field := range fields {
                if len(field) == 1 {
                        r := rune(field[0])
                        if err := validateCell(r); err != nil {
                                return nil, err
                        }
                        row = append(row, byte(r))
                } else {
                        // If a field contains multiple characters, treat each character as a cell.
                        for _, r := range field {
                                if err := validateCell(r); err != nil {
                                        return nil, err
                                }
                                row = append(row, byte(r))
                        }
                }
        }
        return row, nil
}

func validateCell(r rune) error {
        switch r {
        case '.', 'O', 'X':
                return nil
        default:
                return fmt.Errorf("invalid cell %q", r)
        }
}

func connects(board [][]byte, player byte, vertical bool) bool {
        rows := len(board)
        cols := len(board[0])
        visited := make([][]bool, rows)
        for i := range visited {
                visited[i] = make([]bool, cols)
        }
        type point struct{ r, c int }
        var queue []point

        if vertical {
                for c := 0; c < cols; c++ {
                        if board[0][c] == player {
                                queue = append(queue, point{0, c})
                                visited[0][c] = true
                        }
                }
        } else {
                for r := 0; r < rows; r++ {
                        if board[r][0] == player {
                                queue = append(queue, point{r, 0})
                                visited[r][0] = true
                        }
                }
        }

        for len(queue) > 0 {
                p := queue[0]
                queue = queue[1:]
                if vertical && p.r == rows-1 {
                        return true
                }
                if !vertical && p.c == cols-1 {
                        return true
                }
                for _, n := range neighbors(p.r, p.c, rows, cols) {
                        if !visited[n.r][n.c] && board[n.r][n.c] == player {
                                visited[n.r][n.c] = true
                                queue = append(queue, n)
                        }
                }
        }
        return false
}

func neighbors(r, c, rows, cols int) [][2]int {
        var ns [][2]int
        // same row
        if c > 0 {
                ns = append(ns, [2]int{r, c - 1})
        }
        if c+1 < cols {
                ns = append(ns, [2]int{r, c + 1})
        }
        // row below
        if r+1 < rows {
                if c > 0 {
                        ns = append(ns, [2]int{r + 1, c - 1})
                }
                if c < cols {
                        ns = append(ns, [2]int{r + 1, c})
                }
        }
        // row above
        if r-1 >= 0 {
                if c < cols {
                        ns = append(ns, [2]int{r - 1, c})
                }
                if c+1 < cols {
                        ns = append(ns, [2]int{r - 1, c + 1})
                }
        }
        return ns
}

