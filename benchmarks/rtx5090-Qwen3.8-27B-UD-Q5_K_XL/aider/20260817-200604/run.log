package say

import "strings"

var ones = []string{...}
var tens = []string{"", "", "twenty", ...}

func Say(n int64) (string, bool) {
    const max = 999_999_999_999
    if n < 0 || n > max {
        return "", false
    }
    if n == 0 {
        return "zero", true
    }

    var chunks []int64
    for n > 0 {
        chunks = append(chunks, n%1000)
        n /= 1000
    }

    scales := []string{"", "thousand", "million", "billion"}
    var parts []string
    for i := len(chunks) - 1; i >= 0; i-- {
        chunk := chunks[i]
        if chunk == 0 {
            continue
        }
        part := belowThousand(chunk)
        if i > 0 {
            part += " " + scales[i]
        }
        parts = append(parts, part)
    }
    return strings.Join(parts, " "), true
}

func belowThousand(n int64) string {
    if n == 0 {
        return "zero"
    }
    var parts []string
    if n >= 100 {
        parts = append(parts, ones[n/100]+" hundred")
        n %= 100
    }
    if n >= 20 {
        part := tens[n/10]
        if n%10 != 0 {
            part += "-" + ones[n%10]
        }
        parts = append(parts, part)
    } else if n > 0 {
        parts = append(parts, ones[n])
    }
    return strings.Join(parts, " ")
}

