```
//
// This is only a SKELETON file for the 'Beer Song' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

const bottleText = (count) => {
  if (count === 0) return 'no more bottles';
  if (count === 1) return '1 bottle';
  return `${count} bottles`;
};

const verse = (count) => {
  if (count === 0) {
    return [
      'No more bottles of beer on the wall, no more bottles of beer.',
      'Go to the store and buy some more, 99 bottles of beer on the wall.',
    ];
  }

  if (count === 1) {
    return [
      '1 bottle of beer on the wall, 1 bottle of beer.',
      'Take it down and pass it around, no more bottles of beer on the wall.',
    ];
  }

  return [
    `${count} bottles of beer on the wall, ${count} bottles of beer.`,
    `Take one down and pass it around, ${bottleText(count - 1)} of beer on the wall.`,
  ];
};

export const recite = (initialBottlesCount, takeDownCount) => {
  const lines = [];
  const end = Math.max(0, initialBottlesCount - takeDownCount + 1);

  for (let count = initialBottlesCount; count >= end; count -= 1) {
    if (lines.length > 0) {
      lines.push('');
    }
    lines.push(...verse(count));
  }

  return lines;
};
```
