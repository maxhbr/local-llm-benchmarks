func findAnswers(nat, drinks, pets []string) Solution {
   var water, zebra string
   for i := range nat {
      if drinks[i] == "Water" { water = nat[i] }
      if pets[i] == "Zebra" { zebra = nat[i] }
   }
   return Solution{DrinksWater: water, OwnsZebra: zebra}
}

