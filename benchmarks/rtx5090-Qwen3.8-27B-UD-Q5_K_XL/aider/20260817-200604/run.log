class Connect {
    public enum Winner { O, X, NONE }
    private final char[][] board;
    private final int rows;
    private final int[] cols;

    public Connect(String[] board) {
        this.rows = board == null ? 0 : board.length;
        this.cols = new int[rows];
        this.board = new char[rows][];
        for (int r=0; r<rows; r++) {
            String row = board[r] == null ? "" : board[r];
            StringBuilder sb = new StringBuilder();
            for (int i=0; i<row.length(); i++) {
                char ch = row.charAt(i);
                if (!Character.isWhitespace(ch)) {
                    sb.append(Character.toUpperCase(ch));
                }
            }
            String cleaned = sb.toString();
            cols[r] = cleaned.length();
            board[r] = cleaned.toCharArray();
        }
    }

    public Winner computeWinner() {
        if (rows == 0) return Winner.NONE;
        if (connects('O', 0, rows - 1)) return Winner.O;
        if (connects('X', 0, cols? left-right)) ...
    }
}
```
