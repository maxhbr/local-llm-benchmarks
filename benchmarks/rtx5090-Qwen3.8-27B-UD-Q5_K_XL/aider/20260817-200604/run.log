```
//
// This is only a SKELETON file for the 'Parallel Letter Frequency' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

const LETTER_PATTERN = /^\p{L}$/u;
const CHUNK_SIZE = 10_000;

const yieldToEventLoop = () =>
  new Promise((resolve) => {
    if (typeof setImmediate === 'function') {
      setImmediate(resolve);
    } else {
      setTimeout(resolve, 0);
    }
  });

const isLetter = (char) => {
  if (char.length === 1) {
    const code = char.charCodeAt(0);
    if (code >= 97 && code <= 122) {
      return true;
    }
  }

  return LETTER_PATTERN.test(char);
};

const countText = async (text) => {
  const counts = {};
  const lower = text.toLowerCase();
  let processed = 0;

  await yieldToEventLoop();

  for (const char of lower) {
    if (isLetter(char)) {
      counts[char] = (counts[char] || 0) + 1;
    }

    if (++processed % CHUNK_SIZE === 0) {
      await yieldToEventLoop();
    }
  }

  await yieldToEventLoop();

  return counts;
};

export const parallelLetterFrequency = async (texts) => {
  const frequencies = {};

  await Promise.all(
    texts.map(async (text) => {
      const counts = await countText(text);

      for (const [letter, count] of Object.entries(counts)) {
        frequencies[letter] = (frequencies[letter] || 0) + count;
      }
    })
  );

  return frequencies;
};
```

