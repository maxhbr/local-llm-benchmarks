package bowling

import "errors"

// Game represents a bowling game.
type Game struct {
	rolls       []int
	frame       int
	rollInFrame int
}

func NewGame() *Game {
	return &Game{}
}

func (g *Game) Roll(pins int) error {
	if pins < 0 {
		return errors.New("pins cannot be negative")
	}
	if pins > 10 {
		return errors.New("pins cannot exceed 10")
	}
	if g.frame == 10 {
		return errors.New("too many rolls")
	}

	if g.frame < 9 {
		if g.rollInFrame == 0 {
			g.rolls = append(g.rolls, pins)
			if pins == 10 {
				g.frame++
				g.rollInFrame = 0
			} else {
				g.rollInFrame = 1
			}
			return nil
		}

		if g.rolls[len(g.rolls)-1]+pins > 10 {
			return errors.New("frame pins cannot exceed 10")
		}
		g.rolls = append(g.rolls, pins)
		g.frame++
		g.rollInFrame = 0
		return nil
	}

	switch g.rollInFrame {
	case 0:
		g.rolls = append(g.rolls, pins)
		g.rollInFrame = 1
	case 1:
		first := g.rolls[len(g.rolls)-1]
		if first < 10 {
			if first+pins > 10 {
				return errors.New("frame pins cannot exceed 10")
			}
			g.rolls = append(g.rolls, pins)
			if first+pins == 10 {
				g.rollInFrame = 2
			} else {
				g.frame = 10
				g.rollInFrame = 0
			}
		} else {
			g.rolls = append(g.rolls, pins)
			g.rollInFrame = 2
		}
	case 2:
		first := g.rolls[len(g.rolls)-2]
		second := g.rolls[len(g.rolls)-1]
		if first == 10 && second < 10 {
			if second+pins > 10 {
				return errors.New("frame pins cannot exceed 10")
			}
		}
		g.rolls = append(g.rolls, pins)
		g.frame = 10
		g.rollInFrame = 0
	default:
		return errors.New("too many rolls")
	}

	return nil
}

func (g *Game) Score() (int, error) {
	if g.frame != 10 {
		return 0, errors.New("game is not complete")
	}

	score := 0
	i := 0
	for frame := 0; frame < 10; frame++ {
		if i >= len(g.rolls) {
			return 0, errors.New("invalid game state")
		}

		if g.rolls[i] == 10 {
			if i+2 >= len(g.rolls) {
				return 0, errors.New("invalid game state")
			}
			score += 10 + g.rolls[i+1] + g.rolls[i+2]
			i++
		} else {
			if i+1 >= len(g.rolls) {
				return 0, errors.New("invalid game state")
			}
			if g.rolls[i]+g.rolls[i+1] == 10 {
				if i+2 >= len(g.rolls) {
					return 0, errors.New("invalid game state")
				}
				score += 10 + g.rolls[i+2]
			} else {
				score += g.rolls[i] + g.rolls[i+1]
			}
			i += 2
		}
	}

	return score, nil
}
