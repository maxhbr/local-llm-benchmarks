public class Satellite {
    private Constructor<?> treeConstructor;
    private Constructor<?> nodeConstructor;
    private Method rootMethod;
    private Field rootField;

    public Tree treeFromTraversals(...) {
       ...
       initReflection();
       return build(...);
    }

    private void initReflection() {
       for (Constructor<?> c : Tree.class.getConstructors()) { if (c.getParameterCount()==1) { treeConstructor=c; break; } }
       if (treeConstructor == null) throw ...
       Class<?> nodeType = treeConstructor.getParameterTypes()[0];
       for (Constructor<?> c : nodeType.getConstructors()) { if (c.getParameterCount()==3) { nodeConstructor=c; break; } }
       if (nodeConstructor == null) throw ...
       try { rootMethod = Tree.class.getMethod("root"); } catch (NoSuchMethodException e) { rootMethod = null; }
       if (rootMethod == null) { try { rootField = Tree.class.getDeclaredField("root"); rootField.setAccessible(true); } catch ... }
    }

    private Object rootNode(Tree tree) { if (tree == null) return null; if (rootMethod != null) return rootMethod.invoke(tree); else return rootField.get(tree); }

    private Tree build(...) {
       ...
       Tree left = build(...);
       Tree right = build(...);
       Class<?>[] nodeParams = nodeConstructor.getParameterTypes();
       Object[] args = new Object[3];
       args[0] = rootValue;
       if (nodeParams[1] == Tree.class) args[1] = left; else args[1] = rootNode(left);
       if (nodeParams[2] == Tree.class) args[2] = right; else args[2] = rootNode(right);
       Object node = nodeConstructor.newInstance(args);
       return (Tree) treeConstructor.newInstance(node);
    }
}
```
