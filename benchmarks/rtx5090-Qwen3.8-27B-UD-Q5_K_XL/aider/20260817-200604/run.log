func normalizeTonic(tonic string) string {
    if tonic == "" { return "" }
    // replace unicode accidental
    tonic = strings.ReplaceAll(tonic, "\u266f", "#")
    tonic = strings.ReplaceAll(tonic, "\u266d", "b")
    r := []rune(tonic)
    r[0] = unicode.ToUpper(r[0])
    return string(r)
}
```
