//
// This is only a SKELETON file for the 'State of Tic Tac Toe' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export const gamestate = (board) => {
  const rows = typeof board === 'string' ? [board] : board;
  const cells = rows
    .map((row) => (typeof row === 'string' ? row : row.join('')))
    .join('');

  const xCount = cells.split('X').length - 1;
  const oCount = cells.split('O').length - 1;

  if (oCount > xCount) {
    throw new Error('Wrong turn order: O started');
  }

  if (xCount > oCount + 1) {
    throw new Error('Wrong turn order: X went twice');
  }

  const winningLines = [
    [0, 1, 2],
    [3, 4, 5],
    [6, 7, 8],
    [0, 3, 6],
    [1, 4, 7],
    [2, 5, 8],
    [0, 4, 8],
    [2, 4, 6],
  ];

  const getWinningLines = (player) =>
    winningLines.filter(
      ([a, b, c]) =>
        cells[a] === player && cells[b] === player && cells[c] === player
    );

  const xLines = getWinningLines('X');
  const oLines = getWinningLines('O');

  if (xLines.length > 0 && oLines.length > 0) {
    throw new Error('Impossible board: game should have ended after the game was won');
  }

  const couldBeLastMove = (player, lines) => {
    const playerIndices = [];
    for (let i = 0; i < cells.length; i += 1) {
      if (cells[i] === player) {
        playerIndices.push(i);
      }
    }

    return playerIndices.some((index) =>
      lines.every((line) => line.includes(index))
    );
  };

  if (xLines.length > 0) {
    if (xCount !== oCount + 1 || !couldBeLastMove('X', xLines)) {
      throw new Error('Impossible board: game should have ended after the game was won');
    }
    return 'win';
  }

  if (oLines.length > 0) {
    if (xCount !== oCount || !couldBeLastMove('O', oLines)) {
      throw new Error('Impossible board: game should have ended after the game was won');
    }
    return 'win';
  }

  if (xCount + oCount === 9) {
    return 'draw';
  }

  return 'ongoing';
};
```

