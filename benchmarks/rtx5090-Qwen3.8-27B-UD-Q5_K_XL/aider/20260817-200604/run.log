//
// This is only a SKELETON file for the 'Phone Number' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export const clean = (phoneNumber) => {
  const digits = String(phoneNumber).replace(/\D/g, '');

  if (digits.length === 11) {
    if (digits[0] !== '1') {
      throw new Error('11 digits must start with 1');
    }

    return validate(digits.slice(1));
  }

  if (digits.length !== 10) {
    throw new Error('Must be 10 or 11 digits');
  }

  return validate(digits);
};

const validate = (number) => {
  if (!/[2-9]/.test(number[0])) {
    throw new Error('Area code must start with 2-9');
  }

  if (!/[2-9]/.test(number[3])) {
    throw new Error('Exchange code must start with 2-9');
  }

  return number;
};
```
