zipper.js
```
function hasOwn(obj, key) {
  return Object.prototype.hasOwnProperty.call(obj, key);
}

function detectProps(tree) {
  let leftProp = 'l';
  let rightProp = 'r';

  if (tree && typeof tree === 'object') {
    if (hasOwn(tree, 'l') || hasOwn(tree, 'r')) {
      leftProp = 'l';
      rightProp = 'r';
    } else if (hasOwn(tree, 'left') || hasOwn(tree, 'right')) {
      leftProp = 'left';
      rightProp = 'right';
    }
  }

  return [leftProp, rightProp];
}

function keyFor(node, dir, leftProp, rightProp) {
  const preferred = dir === 'left' ? leftProp : rightProp;
  const fallback =
    dir === 'left'
      ? leftProp === 'l'
        ? 'left'
        : 'l'
      : rightProp === 'r'
        ? 'right'
        : 'r';

  if (node && node[preferred] !== undefined) {
    return preferred;
  }

  if (node && node[fallback] !== undefined) {
    return fallback;
  }

  return preferred;
}

function getNode(root, path, leftProp, rightProp) {
  let node = root;

  for (const dir of path) {
    if (!node) {
      return null;
    }
    node = node[keyFor(node, dir, leftProp, rightProp)];
  }

  return node;
}

function update(root, path, setDir, value, leftProp, rightProp) {
  if (root == null) {
    return root;
  }

  if (path.length === 0) {
    if (setDir === 'value') {
      return { ...root, value };
    }

    const key = keyFor(root, setDir, leftProp, rightProp);
    return { ...root, [key]: value };
  }

  const [dir, ...rest] = path;
  const key = keyFor(root, dir, leftProp, rightProp);
  const updatedChild = update(root[key], rest, setDir, value, leftProp, rightProp);

  return { ...root, [key]: updatedChild };
}

export class Zipper {
  constructor(root, path = [], leftProp = 'l', rightProp = 'r') {
    this.root = root;
    this.path = path;
    this.leftProp = leftProp;
    this.rightProp = rightProp;
  }

  static fromTree(tree) {
    const [leftProp, rightProp] = detectProps(tree);
    return new Zipper(tree, [], leftProp, rightProp);
  }

  toTree() {
    return this.root;
  }

  value() {
    const node = getNode(this.root, this.path, this.leftProp, this.rightProp);
    return node ? node.value : null;
  }

  left() {
    const node = getNode(this.root, this.path, this.leftProp, this.rightProp);
    if (!node) {
      return null;
    }

    const key = keyFor(node, 'left', this.leftProp, this.rightProp);
    if (node[key] == null) {
      return null;
    }

    return new Zipper(this.root, [...this.path, 'left'], this.leftProp, this.rightProp);
  }

  right() {
    const node = getNode(this.root, this.path, this.leftProp, this.rightProp);
    if (!node) {
      return null;
    }

    const key = keyFor(node, 'right', this.leftProp, this.rightProp);
    if (node[key] == null) {
      return null;
    }

    return new Zipper(this.root, [...this.path, 'right'], this.leftProp, this.rightProp);
  }

  up() {
    if (this.path.length === 0) {
      return null;
    }

    return new Zipper(this.root, this.path.slice(0, -1), this.leftProp, this.rightProp);
  }

  setValue(value) {
    const root = update(this.root, this.path, 'value', value, this.leftProp, this.rightProp);
    return new Zipper(root, this.path, this.leftProp, this.rightProp);
  }

  setLeft(tree) {
    const root = update(this.root, this.path, 'left', tree, this.leftProp, this.rightProp);
    return new Zipper(root, this.path, this.leftProp, this.rightProp);
  }

  setRight(tree) {
    const root = update(this.root, this.path, 'right', tree, this.leftProp, this.rightProp);
    return new Zipper(root, this.path, this.leftProp, this.rightProp);
  }
}
