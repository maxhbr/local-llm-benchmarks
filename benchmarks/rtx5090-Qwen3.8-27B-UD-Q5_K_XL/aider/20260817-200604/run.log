def _adjacency(self):
    adj = {}
    def dfs(node, parent):
        adj[node.label] = []
        if parent is not None:
            adj[node.label].append(parent.label)
        for child in node.children:
            adj[node.label].append(child.label)
            dfs(child, node)
    dfs(self, None)
    return adj
```
