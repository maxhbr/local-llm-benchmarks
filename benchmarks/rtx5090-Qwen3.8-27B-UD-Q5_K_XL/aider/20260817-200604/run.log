def _user_object(self, name):
    name = str(name)
    data = self.users.get(name, {'owes': {}, 'owed_by': {}})
    owes = {str(k): self._round(v) for k,v in sorted(data['owes'].items(), key=lambda item: str(item[0]))}
    owed_by = {str(k): self._round(v) for k,v in sorted(data['owed_by'].items(), key=lambda item: str(item[0]))}
    # remove zeros
    owes = {k:v for k,v in owes.items() if v > 0}
    owed_by = {k:v for k,v in owed_by.items() if v > 0}
    balance = self._round(sum(owed_by.values()) - sum(owes.values()))
    return {'name': name, 'owes': owes, 'owed_by': owed_by, 'balance': balance}
```
