```
use std::collections::hash_map::DefaultHasher;
use std::hash::{Hash, Hasher};
use std::sync::atomic::{AtomicU64, Ordering};
use std::time::{SystemTime, UNIX_EPOCH};

const MIN_RANDOM_KEY_LEN: usize = 100;

static RANDOM_CALL_COUNTER: AtomicU64 = AtomicU64::new(0);

struct SplitMix64(u64);

impl SplitMix64 {
    fn new(seed: u64) -> Self {
        Self(seed)
    }

    fn next_u64(&mut self) -> u64 {
        self.0 = self.0.wrapping_add(0x9e3779b97f4a7c15);
        let mut z = self.0;
        z = (z ^ (z >> 30)).wrapping_mul(0xbf58476d1ce4e5b9);
        z = (z ^ (z >> 27)).wrapping_mul(0x94d049bb133111eb);
        z ^ (z >> 31)
    }
}

fn is_valid_key(key: &str) -> bool {
    !key.is_empty() && key.chars().all(|c| c.is_ascii_lowercase())
}

fn shift_char(c: char, shift: i32) -> char {
    match c {
        'a'..='z' => {
            let base = b'a' as i32;
            let value = c as i32 - base;
            let shifted = (value + shift).rem_euclid(26);
            (base + shifted) as u8 as char
        }
        'A'..='Z' => {
            let base = b'A' as i32;
            let value = c as i32 - base;
            let shifted = (value + shift).rem_euclid(26);
            (base + shifted) as u8 as char
        }
        _ => c,
    }
}

fn encode_with_key(key: &str, s: &str) -> Option<String> {
    if !is_valid_key(key) {
        return None;
    }

    let key_chars: Vec<char> = key.chars().collect();
    let mut key_index = 0;
    let mut encoded = String::with_capacity(s.len());

    for c in s.chars() {
        if c.is_ascii_alphabetic() {
            let shift = key_chars[key_index % key_chars.len()] as u8 - b'a';
            encoded.push(shift_char(c, shift as i32));
            key_index += 1;
        } else {
            encoded.push(c);
        }
    }

    Some(encoded)
}

fn decode_with_key(key: &str, s: &str) -> Option<String> {
    if !is_valid_key(key) {
        return None;
    }

    let key_chars: Vec<char> = key.chars().collect();
    let mut key_index = 0;
    let mut decoded = String::with_capacity(s.len());

    for c in s.chars() {
        if c.is_ascii_alphabetic() {
            let shift = key_chars[key_index % key_chars.len()] as u8 - b'a';
            decoded.push(shift_char(c, -(shift as i32)));
            key_index += 1;
