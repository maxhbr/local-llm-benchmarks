            if any(id(inp) in changed for inp in cell._inputs):
                old = cell._value
                cell._value = cell._compute()
                if cell._value != old:
                    changed.add(id(cell))
                    changed_cells.append(cell)
        for cell in changed_cells:
            for cb in list(cell._callbacks):
