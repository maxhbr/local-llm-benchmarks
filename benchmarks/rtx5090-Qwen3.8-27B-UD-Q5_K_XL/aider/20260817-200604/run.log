```
package forth

import (
        "fmt"
        "strconv"
        "strings"
)

func Forth(input []string) ([]int, error) {
        stack := []int{}
        defs := make(map[string][]string)
        if err := evaluate(input, &stack, defs); err != nil {
                return nil, err
        }
        return stack, nil
}

func evaluate(tokens []string, stack *[]int, defs map[string][]string) error {
        for i := 0; i < len(tokens); {
                token := tokens[i]
                if strings.ToLower(token) == ":" {
                        i++
                        if i >= len(tokens) {
                                return fmt.Errorf("incomplete word definition")
                        }
                        name := tokens[i]
                        if isNumber(name) {
                                return fmt.Errorf("word name cannot be a number")
                        }
                        i++
                        var body []string
                        closed := false
                        for i < len(tokens) {
                                if strings.ToLower(tokens[i]) == ";" {
                                        closed = true
                                        i++
                                        break
                                }
                                body = append(body, tokens[i])
                                i++
                        }
                        if !closed {
                                return fmt.Errorf("incomplete word definition")
                        }
                        defs[strings.ToLower(name)] = body
                        continue
                }
                if err := execute(token, stack, defs); err != nil {
                        return err
                }
                i++
        }
        return nil
}

func execute(token string, stack *[]int, defs map[string][]string) error {
        if isNumber(token) {
                n, err := strconv.Atoi(token)
                if err != nil {
                        return err
                }
                *stack = append(*stack, n)
                return nil
        }

        key := strings.ToLower(token)
        if body, ok := defs[key]; ok {
                return evaluate(body, stack, defs)
        }

        switch key {
        case "+":
                return binaryOp(stack, func(a, b int) (int, error) { return a + b, nil })
        case "-":
                return binaryOp(stack, func(a, b int) (int, error) { return a - b, nil })
        case "*":
                return binaryOp(stack, func(a, b int) (int, error) { return a * b, nil })
        case "/":
                return binaryOp(stack, func(a, b int) (int, error) {
                        if b == 0 {
                                return 0, fmt.Errorf("division by zero")
                        }
                        return a / b, nil
                })
        case "dup":
                if len(*stack) < 1 {
                        return fmt.Errorf("stack underflow")
                }
                top := (*stack)[len(*stack)-1]
                *stack = append(*stack, top)
                return nil
        case "drop":
                if len(*stack) < 1 {
                        return fmt.Errorf("stack underflow")
                }
                *stack = (*stack)[:len(*stack)-1]
                return nil
        case "swap":
                if len(*stack) < 2 {
                        return fmt.Errorf("stack underflow")
                }
                last := len(*stack) - 1
                (*stack)[last-1], (*stack)[last] = (*stack)[last], (*stack)[last-1]
                return nil
        case "over":
                if len(*stack) < 2 {
                        return fmt.Errorf("stack underflow")
                }
                second := (*stack)[len(*stack)-2]
                *stack = append(*stack, second)
                return nil
        }

        return fmt.Errorf("unknown word: %s", token)
}

func binaryOp(stack *[]int, op func(int, int) (int, error)) error {
        if len(*stack) < 2 {
                return fmt.Errorf("stack underflow")
        }
        b := (*stack)[len(*stack)-1]
        a := (*stack)[len(*stack)-2]
        *stack = (*stack)[:len(*stack)-2]
        result, err := op(a, b)
        if err != nil {
                return err
        }
        *stack = append(*stack, result)
        return nil
}

func isNumber(token string) bool {
        if len(token) == 0 {
                return false
        }
        for _, r := range token {
                if r < '0' || r > '9' {
                        return false
                }
        }
        return true
}
```

