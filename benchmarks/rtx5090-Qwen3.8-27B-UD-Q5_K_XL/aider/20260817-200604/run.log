export const gamestate = (board) => {
  const xCount = board.join('').split('X').length - 1;
  const oCount = board.join('').split('O').length - 1;
  // turn order: X starts, so xCount === oCount or xCount === oCount + 1
  if (oCount > xCount || xCount > oCount + 1) throw new Error('X started game'); // or 'wrong turn order'
  const xWins = hasWon(board, 'X');
  const oWins = hasWon(board, 'O');
  if (xWins && oWins) {
    if (xCount === oCount) throw new Error('Player O cannot win after X has won');
    else throw new Error('Player X cannot win after O has won');
  }
  if (xWins || oWins) return 'win';
  if (xCount + oCount === 9) return 'draw';
  return 'ongoing';
};
```
