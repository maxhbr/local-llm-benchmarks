Formula:
```
export const cost = (books) => {
  const counts = [0,0,0,0,0];
  for (const book of books) {
    if (book >= 1 && book <= 5) counts[book - 1]++;
  }
  counts.sort((a,b)=>b-a);
  const [a,b,c,d,e] = counts;
  const prices = [0,800,1520,2160,2560,3000];
  let total = 0;
  const top3 = c;
  const bottom = d + e;
  let groups5 = 0, groups4 = 0, groups3 = 0;
  if (bottom <= top3) {
    groups4 = bottom;
    groups3 = top3 - bottom;
  } else {
    groups5 = bottom - top3;
    groups4 = 2 * top3 - bottom;
  }
  // remaining top1/top2 pairs and singles
  const pairs = b - c; // since a>=b>=c, after using c of each top3
  const singles = a - b;
  total += groups5 * prices[5] + groups4 * prices[4] + groups3 * prices[3] + pairs * prices[2] + singles * prices[1];
  return total;
};
```
