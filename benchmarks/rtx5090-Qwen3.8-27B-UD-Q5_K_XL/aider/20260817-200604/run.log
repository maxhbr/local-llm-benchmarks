CircularBuffer.java
```
class CircularBuffer<T> {

    private final Object[] buffer;
    private final int capacity;
    private int readIndex;
    private int writeIndex;
    private int count;

    CircularBuffer(final int size) {
        if (size < 0) {
            throw new IllegalArgumentException("Buffer size must be non-negative");
        }

        this.capacity = size;
        this.buffer = new Object[capacity];
    }

    T read() throws BufferIOException {
        if (count == 0) {
            throw new BufferIOException("Buffer is empty");
        }

        T value = (T) buffer[readIndex];
        buffer[readIndex] = null;
        readIndex = (readIndex + 1) % capacity;
        count--;

        return value;
    }

    void write(T data) throws BufferIOException {
        if (count == capacity) {
            throw new BufferIOException("Buffer is full");
        }

        buffer[writeIndex] = data;
        writeIndex = (writeIndex + 1) % capacity;
        count++;
    }

    void overwrite(T data) {
        if (capacity == 0) {
            return;
        }

        if (count == capacity) {
            buffer[readIndex] = data;
            readIndex = (readIndex + 1) % capacity;
            writeIndex = readIndex;
        } else {
            buffer[writeIndex] = data;
            writeIndex = (writeIndex + 1) % capacity;
            count++;
        }
    }

    void clear() {
        for (int i = 0; i < capacity; i++) {
            buffer[i] = null;
        }

        readIndex = 0;
        writeIndex = 0;
        count = 0;
    }

}
