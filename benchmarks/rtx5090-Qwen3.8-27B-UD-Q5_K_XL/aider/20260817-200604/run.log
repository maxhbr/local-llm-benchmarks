    if (number <= 0) {
        throw std::domain_error("Classification is only defined for positive integers.");
    }

    long long aliquot_sum = 0;

    if (number > 1) {
        aliquot_sum = 1;
        for (long long divisor = 2; divisor * divisor <= number; ++divisor) {
            if (number % divisor == 0) {
                aliquot_sum += divisor;
                long long other = number / divisor;
                if (other != divisor) {
                    aliquot_sum += other;
                }
            }
        }
