knapsack.cpp
```
#include "knapsack.h"

#include <algorithm>
#include <vector>

namespace knapsack
{

int max_value(int maximum_weight, const std::vector<Item>& items)
{
    if (maximum_weight < 0)
    {
        return 0;
    }

    std::vector<int> best(maximum_weight + 1, 0);

    for (const Item& item : items)
    {
        int weight = item.weight;
        if (weight < 0)
        {
            weight = 0;
        }

        if (weight > maximum_weight)
        {
            continue;
        }

        for (int capacity = maximum_weight; capacity >= weight; --capacity)
        {
            best[capacity] = std::max(best[capacity], best[capacity - weight] + item.value);
        }
    }

    return best[maximum_weight];
}

} // namespace knapsack
```

