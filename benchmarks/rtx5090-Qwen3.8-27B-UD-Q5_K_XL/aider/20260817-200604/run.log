Need handle junction combinations including single segments and none. Let's define a general method:
private char junction(boolean up, boolean down, boolean left, boolean right) {
    if (up && down && left && right) return CROSS;
    if (up && left && right) return T_UP;
    if (down && left && right) return T_DOWN;
    if (up && down && right) return T_RIGHT;
    if (up && down && left) return T_LEFT;
    if (up && down) return VERTICAL;
    if (left && right) return HORIZONTAL;
    if (up && right) return BOTTOM_LEFT;
    if (up && left) return BOTTOM_RIGHT;
    if (down && right) return TOP_LEFT;
    if (down && left) return TOP_RIGHT;
    if (up) return VERTICAL; // maybe
    if (down) return VERTICAL;
    if (left) return HORIZONTAL;
    if (right) return HORIZONTAL;
    return ' ';
}
