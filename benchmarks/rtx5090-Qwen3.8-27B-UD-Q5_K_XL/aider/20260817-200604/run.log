export const recite = (startVerse = 1, endVerse = 12) => {
  const days = [
    'first', 'second', 'third', 'fourth', 'fifth', 'sixth', 'seventh',
    'eighth', 'ninth', 'tenth', 'eleventh', 'twelfth'
  ];
  const gifts = [
    'a Partridge in a Pear Tree',
    'two Turtle Doves',
    'three French Hens',
    'four Calling Birds',
    'five Gold Rings',
    'six Geese-a-Laying',
    'seven Swans-a-Swimming',
    'eight Maids-a-Milking',
    'nine Ladies Dancing',
    'ten Lords-a-Leaping',
    'eleven Pipers Piping',
    'twelve Drummers Drumming'
  ];
  const verses = [];
  for (let verse = startVerse; verse <= endVerse; verse++) {
    const parts = [];
    for (let gift = verse - 1; gift >= 0; gift--) {
      if (gift === 0 && verse > 1) parts.push(`and ${gifts[0]}`);
      else parts.push(gifts[gift]);
    }
    verses.push(`On the ${days[verse - 1]} day of Christmas my true love gave to me: ${parts.join(', ')}.`);
  }
  return verses;
};
