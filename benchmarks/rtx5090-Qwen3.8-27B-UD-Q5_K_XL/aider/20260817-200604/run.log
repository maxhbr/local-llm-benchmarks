function simulate(c1,c2,goal,start) {
  let a=0,b=0,moves=0;
  if start one:
    a=c1; moves=1;
  else:
    b=c2; moves=1;
  if check return
  while true:
    if start one:
      // pour a into b
      let pour = Math.min(a, c2-b);
      a -= pour; b += pour; moves++;
      if forbidden (a===0 && b===c2) return null; // unless goal? but forbidden invalid, so null
      if check return
      if a === 0:
        a = c1; moves++;
        if check return
      else if b === c2:
        b = 0; moves++;
        if check return
    else symmetric
}
```
