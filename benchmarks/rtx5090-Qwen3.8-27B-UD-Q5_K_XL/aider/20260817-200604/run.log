```cpp
#include "crypto_square.h"

#include <cctype>
#include <cmath>
#include <string>

namespace crypto_square {

namespace {

std::string normalize(const std::string& text) {
    std::string result;
    result.reserve(text.size());

    for (char ch : text) {
        const unsigned char uch = static_cast<unsigned char>(ch);
        if (std::isalnum(uch) != 0) {
            result.push_back(static_cast<char>(std::tolower(uch)));
        }
    }

    return result;
}

}  // namespace

crypto_square::crypto_square(const std::string& text) : plain_(normalize(text)) {}

std::string crypto_square::cipher() const {
    if (plain_.empty()) {
        return {};
    }

    const std::size_t length = plain_.size();

    std::size_t columns =
        static_cast<std::size_t>(std::ceil(std::sqrt(static_cast<double>(length))));

    while (columns * columns < length) {
        ++columns;
    }

    while (columns > 1 && (columns - 1) * (columns - 1) >= length) {
        --columns;
    }

    const std::size_t rows = (length + columns - 1) / columns;

    std::string result;
    result.reserve(rows * columns + columns - 1);

    for (std::size_t col = 0; col < columns; ++col) {
        if (col > 0) {
            result.push_back(' ');
        }

        for (std::size_t row = 0; row < rows; ++row) {
            const std::size_t index = row * columns + col;

            if (index < length) {
                result.push_back(plain_[index]);
            } else {
                result.push_back(' ');
            }
        }
    }

    return result;
}

}  // namespace crypto_square
```

