import java.util.Objects;

class Zipper {
    Zipper up;
    Zipper left;
    Zipper right;
    int value;

    Zipper(int val) {
        this.value = val;
    }

    static Zipper fromTree(BinaryTree tree) {
        return tree == null ? null : tree.getRoot();
    }

    BinaryTree toTree() {
        Zipper current = this;
        while (current != null && current.up != null) {
            current = current.up;
        }
        return new BinaryTree(current);
    }

    int getValue() {
        return value;
    }

    Zipper setLeft(Zipper leftChild) {
        this.left = leftChild;
        if (leftChild != null) {
            leftChild.up = this;
        }
        return this;
    }

    Zipper setRight(Zipper rightChild) {
        this.right = rightChild;
        if (rightChild != null) {
            rightChild.up = this;
        }
        return this;
    }

    void setValue(int val) {
        this.value = val;
    }
}

class BinaryTree {
    private final Zipper root;

    BinaryTree(int value) {
        this.root = new Zipper(value);
    }

    BinaryTree(Zipper root) {
        this.root = root;
    }

    Zipper getRoot() {
        return root;
    }

    String printTree() {
        return formatRoot(root);
    }

    @Override
    public String toString() {
        return printTree();
    }

    @Override
    public boolean equals(Object obj) {
        if (this == obj) {
            return true;
        }
        if (!(obj instanceof BinaryTree)) {
            return false;
        }
        BinaryTree other = (BinaryTree) obj;
        return zipperEquals(this.root, other.root);
    }

    @Override
    public int hashCode() {
        return zipperHashCode(root);
    }

    private static String formatRoot(Zipper zipper) {
        if (zipper == null) {
            return "null";
        }
        return "value: " + zipper.value
                + ", left: " + formatChild(zipper.left)
                + ", right: " + formatChild(zipper.right);
    }

    private static String formatChild(Zipper zipper) {
        if (zipper == null) {
            return "null";
        }
        return "{ value: " + zipper.value
                + ", left: " + formatChild(zipper.left)
                + ", right: " + formatChild(zipper.right)
                + " }";
    }

    private static boolean zipperEquals(Zipper a, Zipper b) {
        if (a == b) {
            return true;
        }
        if (a == null || b == null) {
            return false;
        }
        return a.value == b.value
                && zipperEquals(a.left, b.left)
                && zipperEquals(a.right, b.right);
    }

    private static int zipperHashCode(Zipper zipper) {
        if (zipper == null) {
            return 0;
        }
        return Objects.hash(zipper.value, zipperHashCode(zipper.left), zipperHashCode(zipper.right));
    }
}
