package transpose

func Transpose(input []string) []string {
        if len(input) == 0 {
                return []string{}
        }

        rows := make([][]rune, len(input))
        maxCols := 0
        for i, line := range input {
                runes := []rune(line)
                rows[i] = runes
                if len(runes) > maxCols {
                        maxCols = len(runes)
                }
        }

        if maxCols == 0 {
                return []string{}
        }

        result := make([]string, maxCols)
        for col := 0; col < maxCols; col++ {
                lastRow := -1
                for row := len(rows) - 1; row >= 0; row-- {
                        if len(rows[row]) > col {
                                lastRow = row
                                break
                        }
                }

                if lastRow == -1 {
                        continue
                }

                out := make([]rune, 0, lastRow+1)
                for row := 0; row <= lastRow; row++ {
                        if len(rows[row]) > col {
                                out = append(out, rows[row][col])
                        } else {
                                out = append(out, ' ')
                        }
                }
                result[col] = string(out)
        }

        return result
}

