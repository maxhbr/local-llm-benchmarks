func (g *Game) Roll(pins int) error {
    if pins < 0 {
        return errors.New("negative pins")
    }
    if pins > 10 {
        return errors.New("too many pins")
    }
    if g.frame == 10 {
        return errors.New("too many rolls")
    }

    if g.frame < 9 {
        if g.rollInFrame == 0 {
            g.rolls = append(g.rolls, pins)
            if pins == 10 {
                g.frame++
                g.rollInFrame = 0
            } else {
                g.rollInFrame = 1
            }
            return nil
        }
        // second roll
        if g.rolls[len(g.rolls)-1]+pins > 10 {
            return errors.New("frame pins exceed 10")
        }
        g.rolls = append(g.rolls, pins)
        g.frame++
        g.rollInFrame = 0
        return nil
    }

    // tenth frame
    switch g.rollInFrame {
    case 0:
        g.rolls = append(g.rolls, pins)
        g.rollInFrame = 1
    case 1:
        first := g.rolls[len(g.rolls)-1]
        if first < 10 {
            if first+pins > 10 {
                return errors.New("frame pins exceed 10")
            }
            g.rolls = append(g.rolls, pins)
            if first+pins == 10 {
                g.rollInFrame = 2
            } else {
                g.frame = 10
                g.rollInFrame = 0
            }
        } else {
            g.rolls = append(g.rolls, pins)
            g.rollInFrame = 2
        }
    case 2:
        first := g.rolls[len(g.rolls)-2]
        second := g.rolls[len(g.rolls)-1]
        if first == 10 && second < 10 {
            if second+pins > 10 {
                return errors.New("frame pins exceed 10")
            }
        }
        g.rolls = append(g.rolls, pins)
        g.frame = 10
        g.rollInFrame = 0
    default:
        return errors.New("too many rolls")
    }
    return nil
}

