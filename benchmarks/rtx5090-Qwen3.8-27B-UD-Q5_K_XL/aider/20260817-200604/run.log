export class Robot {
  static _currentNames = new Set();
  static _usedNames = new Set(); // all names ever assigned, includes current and retired
  static _robots = new Set(); // maybe not needed if currentNames tracks current.

  constructor() {
    Robot._robots.add(this);
    this._name = Robot._generateName();
  }

  get name() { return this._name; }

  reset() {
    // old name remains in _usedNames, removed from _currentNames
    Robot._currentNames.delete(this._name);
    this._name = Robot._generateName();
  }

  static _generateName() {
    let name;
    do {
      name = Robot._randomName();
    } while (Robot._currentNames.has(name) || Robot._usedNames.has(name)); // if avoid all used, no repeats until release
    Robot._currentNames.add(name);
    Robot._usedNames.add(name);
    return name;
  }

  static releaseNames() {
    // Release retired names, but keep names currently assigned to robots.
    Robot._usedNames = new Set(Robot._currentNames);
  }
}

