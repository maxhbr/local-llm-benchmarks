Traversal code:
```
function detectProps(tree) {
  let hasLR = false;
  let hasLeftRight = false;

  const visit = (node) => {
    if (!node || typeof node !== 'object') return;
    if (hasOwn(node, 'l') || hasOwn(node, 'r')) hasLR = true;
    if (hasOwn(node, 'left') || hasOwn(node, 'right')) hasLeftRight = true;

    if (hasOwn(node, 'l')) visit(node.l);
    if (hasOwn(node, 'left')) visit(node.left);
    if (hasOwn(node, 'r')) visit(node.r);
    if (hasOwn(node, 'right')) visit(node.right);
  };

  visit(tree);

  if (hasLeftRight && !hasLR) return ['left', 'right'];
  return ['l', 'r'];
}
```
