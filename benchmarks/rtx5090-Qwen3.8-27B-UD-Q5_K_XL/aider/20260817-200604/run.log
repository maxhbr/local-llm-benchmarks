transpose.js
```
export const transpose = (text = '') => {
  if (text == null) {
    return [];
  }

  const rows = Array.isArray(text) ? text : String(text).split(/\r?\n/);
  const longestRow = rows.reduce((longest, row) => Math.max(longest, row.length), 0);
  const transposed = [];

  for (let col = 0; col < longestRow; col += 1) {
    let lastIncludedRow = -1;

    for (let row = rows.length - 1; row >= 0; row -= 1) {
      if (rows[row].length > col) {
        lastIncludedRow = row;
        break;
      }
    }

    let line = '';
    for (let row = 0; row <= lastIncludedRow; row += 1) {
      line += rows[row].length > col ? rows[row][col] : ' ';
    }

    transposed.push(line);
  }

  return transposed;
};
```
