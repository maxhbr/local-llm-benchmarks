const letterPattern = /^\p{L}$/u;
const CHUNK_SIZE = 10_000;

const yieldToEventLoop = () =>
  new Promise((resolve) => {
    if (typeof setImmediate === 'function') {
      setImmediate(resolve);
    } else {
      setTimeout(resolve, 0);
    }
  });

const countText = async (text) => {
  const counts = {};
  const lower = text.toLowerCase();
  let processed = 0;

  // Yield before starting so that multiple texts can begin concurrently.
  await yieldToEventLoop();

  for (const char of lower) {
    if (letterPattern.test(char)) {
      counts[char] = (counts[char] || 0) + 1;
    }

    if (++processed % CHUNK_SIZE === 0) {
      await yieldToEventLoop();
    }
  }

  return counts;
};

export const parallelLetterFrequency = async (texts) => {
  const results = await Promise.all(texts.map((text) => countText(text)));
  const frequencies = {};

  for (const counts of results) {
    for (const [letter, count] of Object.entries(counts)) {
      frequencies[letter] = (frequencies[letter] || 0) + count;
    }
  }

  return frequencies;
};
```

