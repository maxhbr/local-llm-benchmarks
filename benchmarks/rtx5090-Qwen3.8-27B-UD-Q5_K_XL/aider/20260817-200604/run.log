        return (6, ordered_ranks[0], ordered_ranks[1])

    if is_flush:
        return (5, *sorted_ranks)

    if is_straight:
        return (4, straight_high)

    if count_sizes[0] == 3:
        return (3, ordered_ranks[0], ordered_ranks[1], ordered_ranks[2])

    if count_sizes[0] == 2 and count_sizes[1] == 2:
        return (2, ordered_ranks[0], ordered_ranks[1], ordered_ranks[2])

    if count_sizes[0] == 2:
        return (1, ordered_ranks[0], ordered_ranks[1], ordered_ranks[2], ordered_ranks[3])

    return (0, *sorted_ranks)


def best_hands(hands):
    if not hands:
        return []

    scored_hands = [(hand, _score_hand(hand)) for hand in hands]
    best_score = max(score for _, score in scored_hands)

    return [hand for hand, score in scored_hands if score == best_score]
```
