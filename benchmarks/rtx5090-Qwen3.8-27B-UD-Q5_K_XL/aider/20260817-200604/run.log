export const all = (promises) => new Promise((resolve, reject) => {
  const results = [];
  let remaining = promises.length;
  if (remaining === 0) return resolve([]);
  promises.forEach((p, i) => {
    Promise.resolve(p).then(value => {
      results[i] = value;
      remaining--;
      if (remaining === 0) resolve(results);
    }, reject);
  });
});

