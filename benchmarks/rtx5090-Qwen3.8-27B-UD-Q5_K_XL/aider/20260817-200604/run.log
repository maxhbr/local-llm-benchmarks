class FoodChain {

    private static final String[] ANIMALS = {
        "fly",
        "spider",
        "bird",
        "cat",
        "dog",
        "goat",
        "cow",
        "horse"
    };

    private static final String[] COMMENTS = {
        "",
        "It wriggled and jiggled and tickled inside her.",
        "How absurd to swallow a bird!",
        "Imagine that, to swallow a cat!",
        "What a hog, to swallow a dog!",
        "Just opened her throat and swallowed a goat!",
        "I don't know how she swallowed a cow!",
        "She's dead, of course!"
    };

    private static final String SPIDER = "spider that wriggled and jiggled and tickled inside her";

    String verse(int verse) {
        if (verse < 1 || verse > 8) {
            return "";
        }

        StringBuilder sb = new StringBuilder();
        sb.append("I know an old lady who swallowed a ")
          .append(ANIMALS[verse - 1])
          .append('.');

        if (verse == 8) {
            sb.append('\n').append(COMMENTS[7]);
            return sb.toString();
        }

        if (verse > 1) {
            sb.append('\n').append(COMMENTS[verse - 1]);
        }

        for (int current = verse - 1; current >= 1; current--) {
            String caught = (current - 1 == 1) ? SPIDER : ANIMALS[current - 1];

            sb.append("\nShe swallowed the ")
              .append(ANIMALS[current])
              .append(" to catch the ")
              .append(caught)
              .append('.');
        }

        sb.append("\nI don't know why she swallowed the fly. Perhaps she'll die.");
        return sb.toString();
    }

    String verses(int startVerse, int endVerse) {
        if (startVerse > endVerse) {
            return "";
        }

        StringBuilder sb = new StringBuilder();

        for (int i = startVerse; i <= endVerse; i++) {
            if (i > startVerse) {
                sb.append("\n\n");
            }
            sb.append(verse(i));
        }

        return sb.toString();
    }

}
