```
from json import dumps


class Tree:
    def __init__(self, label, children=None):
        self.label = label
        self.children = children if children is not None else []

    def __dict__(self):
        return {self.label: [c.__dict__() for c in sorted(self.children)]}

    def __str__(self, indent=None):
        return dumps(self.__dict__(), indent=indent)

    def __lt__(self, other):
        return self.label < other.label

    def __eq__(self, other):
        return self.__dict__() == other.__dict__()

    def _adjacency(self):
        adjacency = {}

        def visit(node, parent_label):
            neighbors = []
            if parent_label is not None:
                neighbors.append(parent_label)
            for child in node.children:
                neighbors.append(child.label)
                visit(child, node.label)
            adjacency[node.label] = neighbors

        visit(self, None)
        return adjacency

    def from_pov(self, from_node):
        adjacency = self._adjacency()
        if from_node not in adjacency:
            raise ValueError(f'Tree does not contain "{from_node}"')

        def build(label, parent_label):
            children = [
                build(neighbor, label)
                for neighbor in adjacency[label]
                if neighbor != parent_label
            ]
            return Tree(label, children)

        return build(from_node, None)

    def path_to(self, from_node, to_node):
        adjacency = self._adjacency()
        if from_node not in adjacency or to_node not in adjacency:
            raise ValueError("Path not found")

        stack = [(from_node, [from_node])]
        visited = {from_node}

        while stack:
            label, path = stack.pop()
            if label == to_node:
                return path
            for neighbor in adjacency[label]:
                if neighbor not in visited:
                    visited.add(neighbor)
                    stack.append((neighbor, path + [neighbor]))

        raise ValueError("Path not found")
```

