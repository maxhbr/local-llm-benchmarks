class StateOfTicTacToe {
    public GameState determineState(String[] board) {
        validateBoard(board);
        int xCount = 0;
        int oCount = 0;
        for (String row : board) {
            for (int i = 0; i < row.length(); i++) {
                char c = row.charAt(i);
                if (c == 'X') xCount++;
                else if (c == 'O') oCount++;
            }
        }

        if (oCount > xCount || xCount > oCount + 1) {
            throw new IllegalArgumentException("Invalid board: wrong turn order.");
        }

        boolean xWin = hasWon(board, 'X');
        boolean oWin = hasWon(board, 'O');

        if (xWin && oWin) {
            throw new IllegalArgumentException("Invalid board: both players cannot win.");
        }

        if (xWin) {
            if (xCount != oCount + 1) {
                throw new IllegalArgumentException("Invalid board: game continued after win.");
            }
            if (!couldHaveWonOnLastMove(board, 'X')) {
                throw new IllegalArgumentException("Invalid board: game continued after win.");
            }
            return GameState.WIN;
        }

        if (oWin) {
            if (xCount != oCount) {
                throw new IllegalArgumentException("Invalid board: game continued after win.");
            }
            if (!couldHaveWonOnLastMove(board, 'O')) {
                throw new IllegalArgumentException("Invalid board: game continued after win.");
            }
            return GameState.WIN;
        }

        if (xCount + oCount == 9) {
            return GameState.DRAW;
        }
        return GameState.ONGOING;
    }

    private void validateBoard(String[] board) {
        if (board == null || board.length != 3) {
            throw new IllegalArgumentException("Invalid board: must be 3 rows.");
        }
        for (String row : board) {
            if (row == null || row.length() != 3) {
                throw new IllegalArgumentException("Invalid board: each row must have 3 characters.");
            }
            for (int i = 0; i < row.length(); i++) {
                char c = row.charAt(i);
                if (c != 'X' && c != 'O' && c != ' ') {
                    throw new IllegalArgumentException("Invalid board: only X, O, or space are allowed.");
                }
            }
        }
    }

    private boolean hasWon(String[] board, char player) {
        for (int i = 0; i < 3; i++) {
            if (board[i].charAt(0) == player
                    && board[i].charAt(1) == player
                    && board[i].charAt(2) == player) {
                return true;
            }
        }
        for (int j = 0; j < 3; j++) {
            if (board[0].charAt(j) == player
                    && board[1].charAt(j) == player
                    && board[2].charAt(j) == player) {
                return true;
            }
        }
        if (board[0].charAt(0) == player
                && board[1].charAt(1) == player
                && board[2].charAt(2) == player) {
            return true;
        }
        if (board[0].charAt(2) == player
                && board[1].charAt(1) == player
                && board[2].charAt(0) == player) {
            return true;
        }
        return false;
    }

    private boolean couldHaveWonOnLastMove(String[] board, char player) {
        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 3; j++) {
                if (board[i].charAt(j) != player) {
                    continue;
                }
                String original = board[i];
                board[i] = original.substring(0, j) + " " + original.substring(j + 1);
                boolean stillWon = hasWon(board, player);
                board[i] = original;
                if (!stillWon) {
                    return true;
                }
            }
        }
        return false;
    }
}

