def _parse_text(s, i):
    i += 1
    chars = []
    while i < len(s):
        c = s[i]
        if c == '\\' and i + 1 < len(s):
            nxt = s[i + 1]
            if nxt == '\n':
                i += 2
                continue
            if nxt.isspace():
                chars.append(' ')
                i += 2
                continue
            chars.append(nxt)
            i += 2
            continue
        if c == ']':
            return ''.join(chars), i + 1
        if c == '\n':
            chars.append('\n')
            i += 1
            continue
        if c.isspace():
            chars.append(' ')
            i += 1
            continue
        chars.append(c)
        i += 1
    raise ValueError("properties without delimiter")
```
