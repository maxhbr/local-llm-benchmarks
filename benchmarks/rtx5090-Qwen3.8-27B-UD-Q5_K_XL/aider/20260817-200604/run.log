def encode(numbers):
    encoded = []

    for number in numbers:
        if number < 0:
            raise ValueError("number must be non-negative")

        if number == 0:
            encoded.append(0)
            continue

        chunks = []
        value = number

        while value:
            chunks.append(value & 0x7F)
            value >>= 7

        chunks.reverse()

        for i in range(len(chunks) - 1):
            chunks[i] |= 0x80

        encoded.extend(chunks)

    return encoded


def decode(bytes_):
    decoded = []
    value = 0
    last_byte = 0

    for byte in bytes_:
        last_byte = byte
        value = (value << 7) | (byte & 0x7F)

        if not (byte & 0x80):
            decoded.append(value)
            value = 0

    if last_byte & 0x80:
        raise ValueError("incomplete sequence")

