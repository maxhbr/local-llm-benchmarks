```
fn parse_tonic(tonic: &str) -> Option<Tonic> {
    let mut chars = tonic.chars();
    let letter = chars.next()?;
    if !letter.is_ascii_alphabetic() { return None; }
    let lower = letter.is_ascii_lowercase();
    let letter = letter.to_ascii_uppercase();
    let base = match letter { 'C'=>0, 'D'=>2, 'E'=>4, 'F'=>5, 'G'=>7, 'A'=>9, 'B'=>11, _=>return None };
    let mut pc = base;
    let mut note = String::new();
    note.push(letter);
    if let Some(acc) = chars.next() {
       match acc {
          '#' => { pc = (pc + 1) % 12; note.push('#'); }
          'b' => { pc = (pc + 11) % 12; note.push('b'); }
          _ => return None,
       }
    }
    if chars.next().is_some() { return None; }
    Some(Tonic { pc, note, lower })
}
```
This accepts "bb" as Bb (letter B, acc b). It accepts "b" as B natural. It accepts "f#" lowercase. It rejects "Bb" extra? okay.

