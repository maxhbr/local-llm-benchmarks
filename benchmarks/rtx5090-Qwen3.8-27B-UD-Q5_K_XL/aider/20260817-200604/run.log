bowling.py
```
class BowlingGame:
    def __init__(self):
        self.frames = []
        self.current_frame = []

    def _finish_frame(self):
        self.frames.append(self.current_frame)
        self.current_frame = []

    def roll(self, pins):
        if pins < 0:
            raise ValueError("Negative pin count is illegal")
        if pins > 10:
            raise ValueError("Pin count exceeds pins available in a frame")
        if len(self.frames) == 10:
            raise ValueError("Cannot roll after game is over")

        if len(self.frames) < 9:
            if not self.current_frame:
                self.current_frame.append(pins)
                if pins == 10:
                    self._finish_frame()
            else:
                if self.current_frame[0] + pins > 10:
                    raise ValueError("Pin count exceeds pins available in a frame")
                self.current_frame.append(pins)
                self._finish_frame()
        else:
            if not self.current_frame:
                self.current_frame.append(pins)
            elif len(self.current_frame) == 1:
                first = self.current_frame[0]
                if first != 10 and first + pins > 10:
                    raise ValueError("Pin count exceeds pins available in a frame")
                self.current_frame.append(pins)
                if first != 10 and first + pins < 10:
                    self._finish_frame()
            elif len(self.current_frame) == 2:
                first, second = self.current_frame
                if first == 10 and second != 10 and second + pins > 10:
                    raise ValueError("Pin count exceeds pins available in a frame")
                self.current_frame.append(pins)
                self._finish_frame()
            else:
                raise ValueError("Cannot roll after game is over")

    def score(self):
        if len(self.frames) != 10:
            raise ValueError("Cannot score before game is over")

        rolls = [pin for frame in self.frames for pin in frame]
        total = 0
        i = 0

        for _ in range(9):
            if rolls[i] == 10:
                total += 10 + rolls[i + 1] + rolls[i + 2]
                i += 1
            elif rolls[i] + rolls[i + 1] == 10:
                total += 10 + rolls[i + 2]
                i += 2
            else:
                total += rolls[i] + rolls[i + 1]
                i += 2

        total += sum(rolls[i:])
        return total
```
