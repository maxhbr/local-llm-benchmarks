AffineCipher.java
```
public class AffineCipher {

    private static final int ALPHABET_SIZE = 26;
    private static final int GROUP_SIZE = 5;

    public String encode(String text, int coefficient1, int coefficient2) {
        int a = mod(coefficient1, ALPHABET_SIZE);
        if (gcd(a, ALPHABET_SIZE) != 1) {
            throw new IllegalArgumentException("coefficient1 and 26 must be coprime");
        }
        int b = mod(coefficient2, ALPHABET_SIZE);

        StringBuilder result = new StringBuilder();
        if (text != null) {
            for (int i = 0; i < text.length(); i++) {
                char c = text.charAt(i);
                if (c >= 'A' && c <= 'Z') {
                    c = (char) (c - 'A' + 'a');
                }

                if (c >= 'a' && c <= 'z') {
                    int x = c - 'a';
                    int encrypted = (a * x + b) % ALPHABET_SIZE;
                    result.append((char) ('a' + encrypted));
                } else if (c >= '0' && c <= '9') {
                    result.append(c);
                }
            }
        }

        return group(result.toString());
    }

    public String decode(String text, int coefficient1, int coefficient2) {
        int a = mod(coefficient1, ALPHABET_SIZE);
        if (gcd(a, ALPHABET_SIZE) != 1) {
            throw new IllegalArgumentException("coefficient1 and 26 must be coprime");
        }
        int b = mod(coefficient2, ALPHABET_SIZE);
        int inverse = modularInverse(a, ALPHABET_SIZE);

        StringBuilder result = new StringBuilder();
        if (text != null) {
            for (int i = 0; i < text.length(); i++) {
                char c = text.charAt(i);
                if (c >= 'A' && c <= 'Z') {
                    c = (char) (c - 'A' + 'a');
                }

                if (c >= 'a' && c <= 'z') {
                    int y = c - 'a';
                    int decrypted = (inverse * mod(y - b, ALPHABET_SIZE)) % ALPHABET_SIZE;
                    result.append((char) ('a' + decrypted));
                } else if (c >= '0' && c <= '9') {
                    result.append(c);
                }
            }
        }

        return result.toString();
    }

    private String group(String value) {
        StringBuilder grouped = new StringBuilder();
        for (int i = 0; i < value.length(); i += GROUP_SIZE) {
            if (i > 0) {
                grouped.append(' ');
            }
            grouped.append(value, i, Math.min(i + GROUP_SIZE, value.length()));
        }
        return grouped.toString();
    }

    private int mod(int value, int modulus) {
        int remainder = value % modulus;
        return remainder < 0 ? remainder + modulus : remainder;
    }

    private int gcd(int a, int b) {
        while (b != 0) {
            int remainder = a % b;
            a = b;
            b = remainder;
        }
        return a;
    }

    private int modularInverse(int a, int modulus) {
        for (int x = 1; x < modulus; x++) {
            if ((a * x) % modulus == 1) {
                return x;
            }
        }
        throw new IllegalArgumentException("Modular inverse does not exist");
    }
}
