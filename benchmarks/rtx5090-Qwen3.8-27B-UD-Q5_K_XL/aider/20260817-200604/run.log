def can_chain(dominoes):
    if not dominoes:
        return True
    degree = {}
    graph = {}
    for a,b in dominoes:
        degree[a] = degree.get(a,0)+1
        degree[b] = degree.get(b,0)+1
        graph.setdefault(a, []).append(b)
        graph.setdefault(b, []).append(a)
    if any(d % 2 != 0 for d in degree.values()):
        return False
    start = next(iter(degree))
    seen = {start}
    stack = [start]
    while stack:
        v = stack.pop()
        for nei in graph.get(v, []):
            if nei not in seen:
                seen.add(nei)
                stack.append(nei)
    return all(v in seen for v in degree)

