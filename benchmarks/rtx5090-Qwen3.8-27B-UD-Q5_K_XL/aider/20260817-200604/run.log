    let mut numbers = Vec::new();
    let mut value = 0u32;
    let mut incomplete = false;

    for &byte in bytes {
        let part = (byte & 0x7F) as u32;
        value = value
            .checked_shl(7)
            .ok_or(Error::IncompleteNumber)?
            | part;
        incomplete = true;

        if byte & 0x80 == 0 {
            numbers.push(value);
            value = 0;
            incomplete = false;
        }
    }

    if incomplete {
        Err(Error::IncompleteNumber)
    } else {
        Ok(numbers)
    }
}

