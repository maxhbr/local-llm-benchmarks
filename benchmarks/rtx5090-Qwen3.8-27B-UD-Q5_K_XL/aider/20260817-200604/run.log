        sb.append("\"owedBy\":").append(iouMapJson(user.owedBy()));
        sb.append('}');
        return sb.toString();
    }

    private String iouMapJson(List<Iou> ious) {
        List<Iou> sorted = new ArrayList<>(ious);
        sorted.sort(Comparator.comparing(Iou::name, Comparator.nullsFirst(String::compareTo)));

        StringBuilder sb = new StringBuilder();
        sb.append('{');

        for (int i = 0; i < sorted.size(); i++) {
            if (i > 0) {
                sb.append(',');
            }

            Iou iou = sorted.get(i);
            sb.append(quote(iou.name())).append(':').append(formatDouble(iou.amount()));
        }

        sb.append('}');
        return sb.toString();
    }

