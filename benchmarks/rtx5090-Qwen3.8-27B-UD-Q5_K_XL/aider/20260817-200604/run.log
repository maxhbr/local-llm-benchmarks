Let's search memory: For Exercism "book-store" in JS, a common concise solution:
```
export const cost = (books) => {
  const prices = [0, 800, 1520, 2160, 2560, 3000];
  const counts = books.reduce((a, b) => (a[b] = (a[b] || 0) + 1, a), {});
  const sorted = Object.values(counts).sort((a, b) => b - a);
  let total = 0;
  while (sorted[0]) {
    const group = sorted.filter(x => x > 0).length;
    total += prices[group];
    sorted.splice(0, group, ...sorted.slice(0, group).map(x => x - 1));
    sorted.sort((a, b) => b - a);
  }
  return total;
};
```
