        if (d.signum() < 0) {
            n = n.negate();
            d = d.negate();
        }

        BigInteger gcd = n.gcd(d);
        n = n.divide(gcd);
        d = d.divide(gcd);

        if (n.compareTo(BigInteger.valueOf(Integer.MAX_VALUE)) > 0
                || n.compareTo(BigInteger.valueOf(Integer.MIN_VALUE)) < 0
                || d.compareTo(BigInteger.valueOf(Integer.MAX_VALUE)) > 0
                || d.compareTo(BigInteger.valueOf(Integer.MIN_VALUE)) < 0) {
            throw new ArithmeticException("Rational number is out of int range");
        }

        this.numerator = n.intValue();
        this.denominator = d.intValue();
    }

    int getNumerator() {
        return numerator;
    }

    int getDenominator() {
        return denominator;
    }

    Rational add(Rational other) {
        BigInteger n = BigInteger.valueOf(this.numerator)
                .multiply(BigInteger.valueOf(other.denominator))
                .add(BigInteger.valueOf(other.numerator)
                        .multiply(BigInteger.valueOf(this.denominator)));
        BigInteger d = BigInteger.valueOf(this.denominator)
                .multiply(BigInteger.valueOf(other.denominator));
        return new Rational(n, d);
    }

    Rational subtract(Rational other) {
        BigInteger n = BigInteger.valueOf(this.numerator)
                .multiply(BigInteger.valueOf(other.denominator))
                .subtract(BigInteger.valueOf(other.numerator)
                        .multiply(BigInteger.valueOf(this.denominator)));
        BigInteger d = BigInteger.valueOf(this.denominator)
                .multiply(BigInteger.valueOf(other.denominator));
        return new Rational(n, d);
    }

    Rational multiply(Rational other) {
        BigInteger n = BigInteger.valueOf(this.numerator)
                .multiply(BigInteger.valueOf(other.numerator));
        BigInteger d = BigInteger.valueOf(this.denominator)
                .multiply(BigInteger.valueOf(other.denominator));
        return new Rational(n, d);
    }

    Rational divide(Rational other) {
        if (other.numerator == 0) {
            throw new ArithmeticException("Division by zero");
        }

        BigInteger n = BigInteger.valueOf(this.numerator)
                .multiply(BigInteger.valueOf(other.denominator));
        BigInteger d = BigInteger.valueOf(this.denominator)
                .multiply(BigInteger.valueOf(other.numerator));
        return new Rational(n, d);
    }

    Rational abs() {
        BigInteger n = BigInteger.valueOf(numerator).abs();
        BigInteger d = BigInteger.valueOf(denominator);
        return new Rational(n, d);
    }

    Rational pow(int power) {
        if (power == 0) {
            return new Rational(1, 1);
        }

        BigInteger n = BigInteger.valueOf(numerator);
        BigInteger d = BigInteger.valueOf(denominator);

        if (power > 0) {
            return new Rational(n.pow(power), d.pow(power));
        }

        if (numerator == 0) {
            throw new ArithmeticException("Zero cannot be raised to a negative power");
        }

        long magnitude = -(long) power;
        if (magnitude > Integer.MAX_VALUE) {
            throw new ArithmeticException("Power is too large");
        }

        int m = (int) magnitude;
        return new Rational(d.pow(m), n.pow(m));
    }

    double exp(double exponent) {
        return Math.pow((double) numerator, exponent) / Math.pow((double) denominator, exponent);
    }

    static double exp(double base, Rational exponent) {
        int a = exponent.getNumerator();
        int b = exponent.getDenominator();

        if (base >= 0.0) {
            return Math.pow(base, (double) a / b);
        }

        if (b % 2 == 1) {
            double magnitude = Math.pow(-base, (double) a / b);
            return (a % 2 == 0) ? magnitude : -magnitude;
        }

        return Double.NaN;
    }

    @Override
    public String toString() {
        return String.format("%d/%d", this.getNumerator(), this.getDenominator());
    }

    @Override
    public boolean equals(Object obj) {
        if (obj instanceof Rational other) {
            return this.getNumerator() == other.getNumerator()
                    && this.getDenominator() == other.getDenominator();
        }

        return false;
    }

    @Override
    public int hashCode() {
        return Objects.hash(this.getNumerator(), this.getDenominator());
    }
}
