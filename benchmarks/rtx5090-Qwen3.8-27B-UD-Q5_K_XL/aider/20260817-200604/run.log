```
use std::collections::HashMap;

pub struct CodonsInfo<'a> {
    map: HashMap<String, &'a str>,
}

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct Error;

impl<'a> CodonsInfo<'a> {
    pub fn name_for(&self, codon: &str) -> Result<&'a str, Error> {
        let pattern = codon.to_ascii_uppercase();
        if pattern.len() != 3 {
            return Err(Error);
        }

        let mut expansions: Vec<String> = vec![String::new()];
        for ch in pattern.chars() {
            let bases = match ch {
                'A' => vec!['A'],
                'C' => vec!['C'],
                'G' => vec!['G'],
                'T' | 'U' => vec!['U'],
                'R' => vec!['A', 'G'],
                'Y' => vec!['C', 'U'],
                'S' => vec!['G', 'C'],
                'W' => vec!['A', 'U'],
                'K' => vec!['G', 'U'],
                'M' => vec!['A', 'C'],
                'B' => vec!['C', 'G', 'U'],
                'D' => vec!['A', 'G', 'U'],
                'H' => vec!['A', 'C', 'U'],
                'V' => vec!['A', 'C', 'G'],
                'N' => vec!['A', 'C', 'G', 'U'],
                _ => return Err(Error),
            };

            let mut next = Vec::with_capacity(expansions.len() * bases.len());
            for existing in &expansions {
                for base in &bases {
                    let mut s = existing.clone();
                    s.push(*base);
                    next.push(s);
                }
            }
            expansions = next;
        }

        let mut name: Option<&'a str> = None;
        for expanded in &expansions {
            if let Some(&candidate) = self.map.get(expanded) {
                match name {
                    None => name = Some(candidate),
                    Some(previous) if previous != candidate => return Err(Error),
                    Some(_) => {}
                }
            }
        }

        name.ok_or(Error)
    }

    pub fn of_rna(&self, rna: &str) -> Result<Vec<&'a str>, Error> {
        if rna.len() % 3 != 0 {
            return Err(Error);
        }

        let mut proteins = Vec::new();
        for chunk in rna.as_bytes().chunks(3) {
            let codon = std::str::from_utf8(chunk).map_err(|_| Error)?;
            let protein = self.name_for(codon)?;
            if protein.eq_ignore_ascii_case("stop") {
                break;
            }
            proteins.push(protein);
        }
        Ok(proteins)
    }
}

pub fn parse<'a>(pairs: Vec<(&'a str, &'a str)>) -> CodonsInfo<'a> {
    let mut map = HashMap::new();
    for (codon, name) in pairs {
        if codon.len() != 3 {
            continue;
        }
        let normalized: String = codon
            .chars()
            .map(|c| match c.to_ascii_uppercase() {
                'T' => 'U',
                other => other,
            })
            .collect();
        map.entry(normalized).or_insert(name);
    }
    CodonsInfo { map }
}
```

