BowlingGame.java
```
class BowlingGame {
    private final int[] rolls = new int[21];
    private int rollCount = 0;
    private int frame = 0;
    private int rollInFrame = 0;

    void roll(int pins) {
        if (pins < 0 || pins > 10) {
            throw new IllegalArgumentException("Pins must be between 0 and 10.");
        }
        if (frame == 10) {
            throw new IllegalArgumentException("Game is already over.");
        }

        if (frame < 9) {
            if (rollInFrame == 0) {
                rolls[rollCount++] = pins;
                if (pins == 10) {
                    frame++;
                    rollInFrame = 0;
                } else {
                    rollInFrame = 1;
                }
            } else {
                int firstRoll = rolls[rollCount - 1];
                if (pins > 10 - firstRoll) {
                    throw new IllegalArgumentException("Frame cannot exceed 10 pins.");
                }
                rolls[rollCount++] = pins;
                frame++;
                rollInFrame = 0;
            }
        } else {
            if (rollInFrame == 0) {
                rolls[rollCount++] = pins;
                rollInFrame = 1;
            } else if (rollInFrame == 1) {
                int firstRoll = rolls[rollCount - 1];
                if (firstRoll != 10) {
                    if (pins > 10 - firstRoll) {
                        throw new IllegalArgumentException("Frame cannot exceed 10 pins.");
                    }
                    rolls[rollCount++] = pins;
                    if (firstRoll + pins == 10) {
                        rollInFrame = 2;
                    } else {
                        frame = 10;
                    }
                } else {
                    rolls[rollCount++] = pins;
                    rollInFrame = 2;
                }
            } else {
                int firstRoll = rolls[rollCount - 2];
                int secondRoll = rolls[rollCount - 1];
                if (firstRoll == 10 && secondRoll != 10 && pins > 10 - secondRoll) {
                    throw new IllegalArgumentException("Frame cannot exceed 10 pins.");
                }
                rolls[rollCount++] = pins;
                frame = 10;
            }
        }
    }

    int score() {
        int total = 0;
        int i = 0;

        for (int f = 0; f < 10 && i < rollCount; f++) {
            if (rolls[i] == 10) {
                total += 10;
                if (i + 1 < rollCount) {
                    total += rolls[i + 1];
                }
                if (i + 2 < rollCount) {
                    total += rolls[i + 2];
                }
                i++;
            } else {
                if (i + 1 >= rollCount) {
                    break;
                }
                if (rolls[i] + rolls[i + 1] == 10) {
                    total += 10;
                    if (i + 2 < rollCount) {
                        total += rolls[i + 2];
                    }
                } else {
                    total += rolls[i] + rolls[i + 1];
                }
                i += 2;
            }
        }

        return total;
    }
}
