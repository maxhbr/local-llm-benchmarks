```
package wordy

import (
        "strconv"
        "strings"
)

func Answer(question string) (int, bool) {
        q := strings.TrimSpace(question)
        const prefix = "What is"
        if !strings.HasPrefix(q, prefix) {
                return 0, false
        }

        rest := q[len(prefix):]
        if rest == "" || strings.TrimSpace(rest) == rest {
                return 0, false
        }

        expr := strings.TrimSpace(rest)
        if strings.HasSuffix(expr, "?") {
                expr = strings.TrimSpace(expr[:len(expr)-1])
        }

        tokens := strings.Fields(expr)
        if len(tokens) == 0 {
                return 0, false
        }

        value, ok := parseNumber(tokens[0])
        if !ok {
                return 0, false
        }

        i := 1
        for i < len(tokens) {
                switch tokens[i] {
                case "plus":
                        i++
                        if i >= len(tokens) {
                                return 0, false
                        }
                        rhs, ok := parseNumber(tokens[i])
                        if !ok {
                                return 0, false
                        }
                        value += rhs
                        i++
                case "minus":
                        i++
                        if i >= len(tokens) {
                                return 0, false
                        }
                        rhs, ok := parseNumber(tokens[i])
                        if !ok {
                                return 0, false
                        }
                        value -= rhs
                        i++
                case "multiplied":
                        i++
                        if i >= len(tokens) || tokens[i] != "by" {
                                return 0, false
                        }
                        i++
                        if i >= len(tokens) {
                                return 0, false
                        }
                        rhs, ok := parseNumber(tokens[i])
                        if !ok {
                                return 0, false
                        }
                        value *= rhs
                        i++
                case "divided":
                        i++
                        if i >= len(tokens) || tokens[i] != "by" {
                                return 0, false
                        }
                        i++
                        if i >= len(tokens) {
                                return 0, false
                        }
                        rhs, ok := parseNumber(tokens[i])
                        if !ok {
                                return 0, false
                        }
                        if rhs == 0 {
                                return 0, false
                        }
                        value /= rhs
                        i++
                default:
                        return 0, false
                }
        }

        return value, true
}

func parseNumber(s string) (int, bool) {
        n, err := strconv.Atoi(s)
        if err != nil {
                return 0, false
        }
        return n, true
}
