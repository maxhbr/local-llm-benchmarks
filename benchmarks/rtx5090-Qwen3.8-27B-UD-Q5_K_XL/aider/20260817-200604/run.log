    for _ in 0..len {
        let index = rng.next_u64() % 26;
        key.push((b'a' + index as u8) as char);
    }

    key
}

pub fn encode(key: &str, s: &str) -> Option<String> {
    encode_with_key(key, s)
}

pub fn decode(key: &str, s: &str) -> Option<String> {
    decode_with_key(key, s)
}

pub fn encode_random(s: &str) -> (String, String) {
    let key = random_key(MIN_RANDOM_KEY_LEN);
    let encoded = encode_with_key(&key, s).unwrap_or_default();
    (key, encoded)
}
