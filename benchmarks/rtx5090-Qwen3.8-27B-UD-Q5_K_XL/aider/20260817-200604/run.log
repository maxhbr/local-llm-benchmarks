Cpp:
```
#include "perfect_numbers.h"

#include <stdexcept>

namespace perfect_numbers {

classification classify(int number) {
    if (number <= 0) {
        throw std::domain_error("Classification is only defined for positive integers.");
    }

    const long long n = number;
    long long aliquot_sum = 0;

    if (n > 1) {
        aliquot_sum = 1;

        for (long long divisor = 2; divisor <= n / divisor; ++divisor) {
            if (n % divisor == 0) {
                aliquot_sum += divisor;

                const long long other_divisor = n / divisor;
                if (other_divisor != divisor) {
                    aliquot_sum += other_divisor;
                }
            }
        }
    }

    if (aliquot_sum < n) {
        return classification::deficient;
    }

    if (aliquot_sum > n) {
        return classification::abundant;
    }

    return classification::perfect;
}

}  // namespace perfect_numbers
```
