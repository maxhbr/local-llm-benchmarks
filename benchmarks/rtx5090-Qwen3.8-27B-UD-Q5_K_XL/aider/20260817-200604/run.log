cpp:
```
#include "crypto_square.h"

#include <cctype>
#include <cmath>
#include <string>

namespace crypto_square {

namespace {

std::string normalize(const std::string& text) {
    std::string result;
    result.reserve(text.size());
    for (char ch : text) {
        unsigned char uch = static_cast<unsigned char>(ch);
        if (std::isalnum(uch) != 0) {
            result.push_back(static_cast<char>(std::tolower(uch)));
        }
    }
    return result;
}

}  // namespace

std::string encode(const std::string& text) {
    std::string plain = normalize(text);
    if (plain.empty()) {
        return {};
    }

    const std::size_t length = plain.size();
    std::size_t columns = static_cast<std::size_t>(std::ceil(std::sqrt(static_cast<double>(length))));
    while (columns * columns < length) {
        ++columns;
    }
    while (columns > 1 && (columns - 1) * (columns - 1) >= length) {
        --columns;
    }

    const std::size_t rows = (length + columns - 1) / columns;
    std::string cipher;
    cipher.reserve(rows * columns + columns - 1); // but rows*columns may overflow? no.
    for (std::size_t col = 0; col < columns; ++col) {
        if (col > 0) {
            cipher.push_back(' ');
        }
        for (std::size_t row = 0; row < rows; ++row) {
            const std::size_t index = row * columns + col;
            if (index < length) {
                cipher.push_back(plain[index]);
            } else {
                cipher.push_back(' ');
            }
        }
    }
    return cipher;
}

}  // namespace crypto_square
```

