# Game status categories
# Change the values as you see fit
STATUS_WIN = 'win'
STATUS_LOSE = 'lose'
STATUS_ONGOING = 'ongoing'


class Hangman:
    def __init__(self, word):
        self.word = word
        self.remaining_guesses = 9
        self.status = STATUS_ONGOING
        self.guessed = set()
        if not word:
            self.status = STATUS_WIN

    def guess(self, char):
        if self.status != STATUS_ONGOING:
            raise ValueError("The game has already ended.")

        # Normalize to a single lowercase character for consistent matching.
        if len(char) != 1:
            raise ValueError("Guess must be a single character.")
        char = char.lower()

        if char in self.guessed:
            return

        self.guessed.add(char)

        if char not in self.word.lower():
            self.remaining_guesses -= 1

        self._update_status()

    def get_masked_word(self):
        word = self.word.lower()
        return ''.join(
            ch if ch in self.guessed else '_'
            for ch in word
        )

    def get_status(self):
        return self.status

    def _update_status(self):
        word = self.word.lower()
        if all(ch in self.guessed for ch in word):
            self.status = STATUS_WIN
        elif self.remaining_guesses <= 0:
            self.status = STATUS_LOSE

