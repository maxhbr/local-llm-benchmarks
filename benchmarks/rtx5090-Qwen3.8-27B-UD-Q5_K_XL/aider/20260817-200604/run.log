```
package forth

import (
    "fmt"
    "strconv"
    "strings"
)

func Forth(input []string) ([]int, error) {
    stack := []int{}
    defs := map[string][]string{}
    if err := eval(input, stack, defs); err != nil {
        return nil, err
    }
    return stack, nil
}

func eval(tokens []string, stack *[]int, defs map[string][]string) error {
    i := 0
    for i < len(tokens) {
        tok := tokens[i]
        lower := strings.ToLower(tok)
        if lower == ":" {
            // define
            i++
            if i >= len(tokens) {
                return fmt.Errorf("incomplete definition")
            }
            nameTok := tokens[i]
            if isNumber(nameTok) {
                return fmt.Errorf("word name cannot be a number")
            }
            name := strings.ToLower(nameTok)
            i++
            var body []string
            closed := false
            for i < len(tokens) {
                if strings.ToLower(tokens[i]) == ";" {
                    closed = true
                    i++
                    break
                }
                body = append(body, tokens[i])
                i++
            }
            if !closed {
                return fmt.Errorf("incomplete definition")
            }
            defs[name] = body
            continue
        }
        if err := execToken(tok, stack, defs); err != nil {
            return err
        }
        i++
    }
    return nil
}

func execToken(tok string, stack *[]int, defs map[string][]string) error {
    if isNumber(tok) {
        n, err := strconv.Atoi(tok)
        if err != nil { return err }
        *stack = append(*stack, n)
        return nil
    }
    switch strings.ToLower(tok) {
    case "+": return binaryOp(stack, func(a,b int)(int,error){return a+b,nil})
    case "-": return binaryOp(stack, func(a,b int)(int,error){return a-b,nil})
    case "*": return binaryOp(stack, func(a,b int)(int,error){return a*b,nil})
    case "/": return binaryOp(stack, func(a,b int)(int,error){ if b==0 {return 0, fmt.Errorf("division by zero")}; return a/b,nil})
    case "dup": if len(*stack)<1 {return fmt.Errorf("stack underflow")}; v:=(*stack)[len(*stack)-1]; *stack=append(*stack,v); return nil
    case "drop": if len(*stack)<1 {return fmt.Errorf("stack underflow")}; *stack=(*stack)[:len(*stack)-1]; return nil
    case "swap": if len(*stack)<2 {return fmt.Errorf("stack underflow")}; l:=len(*stack)-1; (*stack)[l-1],(*stack)[l]=(*stack)[l],(*stack)[l-1]; return nil
    case "over": if len(*stack)<2 {return fmt.Errorf("stack underflow")}; v:=(*stack)[len(*stack)-2]; *stack=append(*stack,v); return nil
    }
    if body, ok := defs[strings.ToLower(tok)]; ok {
        return eval(body, stack, defs)
    }
    return fmt.Errorf("unknown word: %s", tok)
}
```

