DP implementation with cache:
```
const getMinMax = (index, mask) => {
  const key = (index << 10) | mask;
  const cached = minMaxCache.get(key);
  if (cached !== undefined) return cached; // but cached can be null. Use has.
  const k = n - index;
  if (k === 0) { minMaxCache.set(key, [0n, 0n]); return [0n, 0n]; }
  const digits = [];
  let hasZero = false;
  for (let d = 0; d < 10; d++) {
    if ((mask & (1 << d)) === 0) {
      digits.push(d);
      if (d === 0) hasZero = true;
    }
  }
  if (digits.length < k) { minMaxCache.set(key, null); return null; }
  if (hasZero && suffixLeadingCount[index] > digits.length - 1) { minMaxCache.set(key, null); return null; }
  const coeffs = suffixCoeffs[index];
  const minDp = new Array(k + 1).fill(null);
  const maxDp = new Array(k + 1).fill(null);
  minDp[0] = 0n; maxDp[0] = 0n;
  for (const d of digits) {
    const bd = BigInt(d);
    for (let t = k - 1; t >= 0; t--) {
      if (minDp[t] !== null) {
        const val = minDp[t] + coeffs[k - 1 - t] * bd;
        if (minDp[t + 1] === null || val < minDp[t + 1]) minDp[t + 1] = val;
      }
      if (maxDp[t] !== null) {
        const val = maxDp[t] + coeffs[t] * bd;
        if (maxDp[t + 1] === null || val > maxDp[t + 1]) maxDp[t + 1] = val;
      }
    }
  }
  const result = minDp[k] === null || maxDp[k] === null ? null : [minDp[k], maxDp[k]];
  minMaxCache.set(key, result);
  return result;
};
```
