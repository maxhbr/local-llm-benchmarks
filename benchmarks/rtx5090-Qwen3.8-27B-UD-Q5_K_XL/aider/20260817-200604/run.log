Let's design code:
```
export class Scale {
  constructor(tonic) {
    this.tonic = tonic;
    this.flat = this.#isFlatTonic(tonic);
    this.notes = this.flat ? FLAT : SHARP;
    this.tonicName = this.#normalizeTonic(tonic, this.flat);
    this.tonicIndex = this.notes.indexOf(this.tonicName);
  }

  #isFlatTonic(tonic) {
    const t = tonic.trim();
    const letter = t[0].toUpperCase();
    const accidental = t.slice(1);
    if (accidental === 'b' || accidental === 'B') return true;
    if (accidental === '#') return false;
    // natural
    switch (letter) {
      case 'F': return true;
      case 'C': return t[0] === 'c'; // c minor flat, C major sharp
      case 'D': return t[0] === 'd';
      case 'G': return t[0] === 'g';
      case 'A': return false;
      case 'B': return false;
      case 'E': return false;
      default: return false;
    }
  }

  #normalizeTonic(tonic, flat) {
    const t = tonic.trim();
    const letter = t[0].toUpperCase();
    const accidental = t.slice(1);
    if (accidental === 'b' || accidental === 'B') return letter + 'b';
    if (accidental === '#') return letter + '#';
    return letter;
  }

  chromatic() {
    return Array.from({length: 12}, (_, i) => this.notes[(this.tonicIndex + i) % 12]);
  }

  interval(intervals) {
    const result = [this.tonicName];
    let index = this.tonicIndex;
    for (const ch of intervals) {
      const step = ch === 'm' ? 1 : ch === 'M' ? 2 : ch === 'A' ? 3 : 0; // maybe throw?
      index = (index + step) % 12;
      result.push(this.notes[index]);
    }
    return result;
  }
}
```
