  constructor(...colors) {
    this.colors = Array.isArray(colors[0]) ? colors[0] : colors;
  }

  get label() {
    const values = this.colors.map((color) => {
      if (!(color in COLOR_VALUES)) {
        throw new Error('invalid color');
      }
      return COLOR_VALUES[color];
    });

    const [first, second, third] = values;
    const ohms = (first * 10 + second) * 10 ** third;

    let value;
    let unit;
    if (ohms >= 1_000_000_000) {
      value = ohms / 1_000_000_000;
      unit = 'gigaohms';
    } else if (ohms >= 1_000_000) {
      value = ohms / 1_000_000;
      unit = 'megaohms';
    } else if (ohms >= 1_000) {
      value = ohms / 1_000;
      unit = 'kiloohms';
    } else {
      value = ohms;
      unit = 'ohms';
    }

    return `Resistor value: ${value} ${unit}`;
  }
}

