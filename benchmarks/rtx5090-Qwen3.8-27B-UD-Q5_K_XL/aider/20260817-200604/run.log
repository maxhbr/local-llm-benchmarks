package poker

import (
    "errors"
    "sort"
    "strings"
)

type hand struct {
    original string
    ranks    [5]int
    suits    [5]string
    category int
    tie      [5]int
}

func BestHand(hands []string) ([]string, error) {
    if len(hands) == 0 {
        return nil, errors.New("no hands")
    }
    var best []hand
    var result []string
    for _, h := range hands {
        parsed, err := newHand(h)
        if err != nil {
            return nil, err
        }
        if len(result) == 0 {
            best = append(best, parsed)
            result = append(result, h)
            continue
        }
        cmp := compare(parsed, best[0])
        switch {
        case cmp > 0:
            best = []hand{parsed}
            result = []string{h}
        case cmp == 0:
            result = append(result, h)
        }
    }
    return result, nil
}

func newHand(s string) (hand, error) {
    parts := strings.Fields(s)
    if len(parts) != 10 {
        return hand{}, errors.New("invalid hand")
    }
    var h hand
    h.original = s
    for i := 0; i < 5; i++ {
        rank, err := parseRank(parts[2*i])
        if err != nil {
            return hand{}, err
        }
        h.ranks[i] = rank
        h.suits[i] = parts[2*i+1]
    }
    h.category, h.tie = evaluate(h.ranks, h.suits)
    return h, nil
}

func parseRank(s string) (int, error) {
    switch s {
    case "2": return 2, nil
...
    case "A": return 14, nil
    default: return 0, errors.New("invalid rank")
    }
}

