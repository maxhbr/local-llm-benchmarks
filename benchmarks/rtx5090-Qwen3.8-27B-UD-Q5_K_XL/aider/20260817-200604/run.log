Pseudo:
```
private boolean connects(char player, boolean vertical) {
    if (vertical && rows == 0) return false;
    if (!vertical) {
       for r if cols[r]==0 return? no start.
    }
    boolean[][] visited = new boolean[rows][];
    for r visited[r] = new boolean[cols[r]];
    ArrayDeque<int[]> q = new ArrayDeque<>();
    if (vertical) {
       if (rows == 0) return false;
       for (int c=0; c<cols[0]; c++) if (board[0][c]==player) { visited[0][c]=true; q.add(new int[]{0,c}); }
    } else {
       for (int r=0; r<rows; r++) if (cols[r] > 0 && board[r][0]==player) { visited[r][0]=true; q.add(new int[]{r,0}); }
    }
    while (!q.isEmpty()) {
       int[] cur = q.poll();
       int r=cur[0], c=cur[1];
       if (vertical ? r == rows-1 : c == cols[r]-1) return true;
       for (int[] d : DIRS) {
          int nr=r+d[0], nc=c+d[1];
          if (nr>=0 && nr<rows && nc>=0 && nc<cols[nr] && !visited[nr][nc] && board[nr][nc]==player) {
             visited[nr][nc]=true; q.add(new int[]{nr,nc});
          }
       }
    }
    return false;
}
```
