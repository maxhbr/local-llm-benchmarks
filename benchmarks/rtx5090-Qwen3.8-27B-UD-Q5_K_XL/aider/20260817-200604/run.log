Let's draft code:
```
class SgfTree:
    def __init__(self, properties=None, children=None):
        self.properties = properties or {}
        self.children = children or []

    def __eq__(self, other):
        if not isinstance(other, SgfTree):
            return False
        for key, value in self.properties.items():
            if key not in other.properties:
                return False
            if other.properties[key] != value:
                return False
        for key in other.properties.keys():
            if key not in self.properties:
                return False
        if len(self.children) != len(other.children):
            return False
        for child, other_child in zip(self.children, other.children):
            if child != other_child:
                return False
        return True

    def __ne__(self, other):
        return not self == other


def parse(input_string):
    if not input_string or input_string[0] != '(':
        raise ValueError("tree missing")
    tree, _ = _parse_tree(input_string, 0)
    return tree


def _parse_tree(s, i):
    if i >= len(s) or s[i] != '(':
        raise ValueError("tree missing")
    i += 1
    if i >= len(s) or s[i] == ')':
        raise ValueError("tree with no nodes")
    if s[i] != ';':
        # If the tree starts with another tree or invalid char, it has no nodes.
        if s[i] == '(':
            raise ValueError("tree with no nodes")
        raise ValueError("tree missing")
    root, i = _parse_node(s, i)
    current = root
    while i < len(s) and s[i] != ')':
        if s[i] == ';':
            child, i = _parse_node(s, i)
            current.children.append(child)
            current = child
        elif s[i] == '(':
            child, i = _parse_tree(s, i)
            current.children.append(child)
            # Do not change current; parenthesized trees are variations of current.
        else:
            raise ValueError("tree missing")
    if i >= len(s) or s[i] != ')':
        raise ValueError("tree missing")
    return root, i + 1


def _parse_node(s, i):
    if i >= len(s) or s[i] != ';':
        raise ValueError("tree missing")
    i += 1
    properties = {}
    while i < len(s) and s[i] not in ';()':
        key, i = _parse_key(s, i)
        value, i = _parse_value_list(s, i)
        properties[key] = value
    return SgfTree(properties=properties, children=[]), i


def _parse_key(s, i):
    start = i
    while i < len(s) and s[i] != '[':
        i += 1
    if i >= len(s) or s[i] != '[':
        raise ValueError("properties without delimiter")
    key = s[start:i]
    if not key or not key.isalpha() or not key.isupper():
        raise ValueError("property must be in uppercase")
    return key, i


def _parse_value_list(s, i):
    if i >= len(s) or s[i] != '[':
        raise ValueError("properties without delimiter")
    value, i = _parse_text(s, i)
    while i < len(s) and s[i] == '[':
        next_value, i = _parse_text(s, i)
        value += next_value
    return value, i


def _parse_text(s, i):
    # s[i] == '['
    i += 1
    chars = []
    while i < len(s):
        c = s[i]
        if c == '\\' and i + 1 < len(s):
            nxt = s[i + 1]
            if nxt == '\n':
                i += 2
                continue
            if nxt.isspace():
                chars.append(' ')
                i += 2
                continue
            chars.append(nxt)
            i += 2
            continue
        if c == ']':
            return ''.join(chars), i + 1
        if c == '\n':
            chars.append('\n')
            i += 1
            continue
        if c.isspace():
            chars.append(' ')
            i += 1
            continue
        chars.append(c)
        i += 1
    raise ValueError("properties without delimiter")
```

