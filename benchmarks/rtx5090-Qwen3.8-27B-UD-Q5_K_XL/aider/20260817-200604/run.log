pub mod graph {
    use std::fmt;

    #[derive(Debug, Clone, PartialEq, Eq, Default)]
    pub struct Graph {
        pub nodes: Vec<Node>,
        pub edges: Vec<Edge>,
        pub attrs: Vec<(String, String)>,
    }

    #[derive(Debug, Clone, PartialEq, Eq)]
    pub struct Node {
        pub name: String,
        pub attrs: Vec<(String, String)>,
    }

    #[derive(Debug, Clone, PartialEq, Eq)]
    pub struct Edge {
        pub from: String,
        pub to: String,
        pub attrs: Vec<(String, String)>,
    }

    impl Graph {
        pub fn new() -> Self { Self::default() }
        pub fn with_node(mut self, node: Node) -> Self { self.nodes.push(node); self }
        pub fn with_edge(mut self, edge: Edge) -> Self { self.edges.push(edge); self }
        pub fn with_attr(mut self, key: &str, value: &str) -> Self { self.attrs.push((key.to_string(), value.to_string())); self }
        pub fn attr(&self, key: &str) -> Option<&str> { self.attrs.iter().rev().find(|(k, _)| k == key).map(|(_, v)| v.as_str()) }
    }

    impl Node {
        pub fn new(name: &str) -> Self { Self { name: name.to_string(), attrs: Vec::new() } }
        pub fn with_attr(mut self, key: &str, value: &str) -> Self { self.attrs.push((key.to_string(), value.to_string())); self }
        pub fn attr(&self, key: &str) -> Option<&str> { ... }
    }

    impl Edge {
        pub fn new(from: &str, to: &str) -> Self { ... }
        pub fn with_attr(...)
        pub fn attr(...)
    }
}
```
