Code:
```
package markdown

import (
    "fmt"
    "strings"
)

// Render translates markdown to HTML.
//
// Refactoring notes:
// - Emphasis replacement is isolated in applyEmphasis.
// - The parser is line-oriented: headers, list items, and paragraphs are
//   recognized per line.
// - Consecutive list items are grouped into a single <ul> block.
func Render(markdown string) string {
    markdown = applyEmphasis(markdown)

    var out strings.Builder
    var listItems []string

    flushList := func() {
        if len(listItems) == 0 {
            return
        }
        out.WriteString("<ul>")
        for _, item := range listItems {
            out.WriteString("<li>")
            out.WriteString(item)
            out.WriteString("</li>")
        }
        out.WriteString("</ul>")
        listItems = nil
    }

    for _, line := range strings.Split(markdown, "\n") {
        if line == "" {
            flushList()
            continue
        }

        if level, text, ok := parseHeader(line); ok {
            flushList()
            if level == 7 {
                out.WriteString("<p>")
                out.WriteString(line)
                out.WriteString("</p>")
            } else {
                fmt.Fprintf(&out, "<h%d>%s</h%d>", level, text, level)
            }
            continue
        }

        if item, ok := parseListItem(line); ok {
            listItems = append(listItems, item)
            continue
        }

        flushList()
        out.WriteString("<p>")
        out.WriteString(line)
        out.WriteString("</p>")
    }

    flushList()
    return out.String()
}
```
