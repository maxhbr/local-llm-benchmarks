package erratum

import "fmt"

func Use(opener ResourceOpener, input string) (err error) {
    resource, err := opener()
    for err != nil {
        if !isTransientError(err) {
            return err
        }
        resource, err = opener()
    }

    defer resource.Close()

    defer func() {
        if r := recover(); r != nil {
            switch e := r.(type) {
            case FrobError:
                resource.Defrob(e.defrobTag)
                err = e
            case *FrobError:
                resource.Defrob(e.defrobTag)
                err = e
            case error:
                err = e
            default:
                err = fmt.Errorf("panic: %v", r)
            }
        }
    }()

    resource.Frob(input)
    return nil
}

func isTransientError(err error) bool {
    for err != nil {
        switch err.(type) {
        case TransientError, *TransientError:
            return true
        }
        if u, ok := err.(interface{ Unwrap() error }); ok {
            err = u.Unwrap()
            continue
        }
        return false
    }
    return false
}

