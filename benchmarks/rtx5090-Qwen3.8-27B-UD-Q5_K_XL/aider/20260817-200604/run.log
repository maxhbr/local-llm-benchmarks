func Forth(input []string) ([]int, error) {
    stack := []int{}
    words := map[string][]string{}
    if err := eval(input, stack, words); err != nil {
        return nil, err
    }
    return stack, nil
}

func eval(tokens []string, stack *[]int, words map[string][]string) error {
    for i := 0; i < len(tokens); i++ {
        tok := strings.ToLower(tokens[i])
        if tok == ":" {
            // find name
            if i+1 >= len(tokens) { return errors.New("missing word name") }
            name := strings.ToLower(tokens[i+1])
            if isNumber(name) { return errors.New("word name cannot be a number") }
            // find ;
            j := i + 2
            for j < len(tokens) && tokens[j] != ";" { j++ } // but need lower? ; no case
            if j >= len(tokens) { return errors.New("missing ;") }
            body := make([]string, 0, j-i-2)
            for k := i+2; k < j; k++ { body = append(body, strings.ToLower(tokens[k])) }
            words[name] = body
            i = j
            continue
        }
        if n, err := strconv.Atoi(tok); err == nil {
            *stack = append(*stack, n)
            continue
        }
        if body, ok := words[tok]; ok {
            if err := eval(body, stack, words); err != nil { return err }
            continue
        }
        switch tok {
        case "+": ...
        ...
        default: return errors.New("unknown word")
        }
    }
    return nil
}
