kindergarten_garden.go
```
package kindergarten

import (
	"errors"
	"sort"
	"strings"
)

// Garden represents a kindergarten garden.
type Garden struct {
	rows     []string
	children []string
	index    map[string]int
}

func NewGarden(diagram string, children []string) (*Garden, error) {
	var rows []string
	for _, line := range strings.Split(diagram, "\n") {
		line = strings.TrimRight(line, "\r")
		if line == "" {
			continue
		}
		rows = append(rows, line)
	}

	if len(rows) < 2 {
		return nil, errors.New("diagram must contain two rows")
	}
	if len(rows[0]) != len(rows[1]) {
		return nil, errors.New("diagram rows must have the same length")
	}

	kids := make([]string, len(children))
	copy(kids, children)
	sort.Strings(kids)

	index := make(map[string]int, len(kids))
	for i, child := range kids {
		index[child] = i
	}

	return &Garden{
		rows:     rows,
		children: kids,
		index:    index,
	}, nil
}

func (g *Garden) Plants(child string) ([]string, bool) {
	pos, ok := g.index[child]
	if !ok {
		return nil, false
	}

	start := pos * 2
	if start+1 >= len(g.rows[0]) || start+1 >= len(g.rows[1]) {
		return nil, false
	}

	plantNames := map[byte]string{
		'G': "grass",
		'C': "clover",
		'R': "radishes",
		'V': "violets",
	}

	plants := make([]string, 0, 4)
	for _, row := range g.rows[:2] {
		for _, offset := range [2]int{0, 1} {
			name, ok := plantNames[row[start+offset]]
			if !ok {
				return nil, false
			}
			plants = append(plants, name)
		}
	}

	return plants, true
}
```
