func (r *renderer) handleNewline() bool {
    if r.input[r.pos] != '\n' { return false }
    lastNewline := strings.LastIndex(r.input, "\n")
    lastStar := strings.LastIndex(r.input, "*")
    if r.listOpened && lastNewline == r.pos && lastNewline > lastStar {
        r.html.WriteString("</li></ul><p>")
        r.listOpened = false
        r.list = 0
    }
    if r.list > 0 && r.listOpened {
        r.html.WriteString("</li>")
        r.listOpened = false
    }
    if r.header > 0 {
        fmt.Fprintf(&r.html, "</h%d>", r.header)
        r.header = 0
    }
    r.pos++
    return true
}
