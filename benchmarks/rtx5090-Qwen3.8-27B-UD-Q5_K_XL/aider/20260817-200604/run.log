```
fn parse_card<'a>(card: &'a str) -> Option<(u8, &'a str)> {
    // Two-character rank first.
    if let Some(suit) = card.strip_prefix("10") {
        return non_empty_suit(suit).map(|s| (10, s));
    }
    if let Some(suit) = card.strip_prefix("T") {
        return non_empty_suit(suit).map(|s| (10, s));
    }
    if let Some(suit) = card.strip_prefix("t") {
        return non_empty_suit(suit).map(|s| (10, s));
    }

    let single = [
        ("2", 2), ("3", 3), ..., ("9", 9),
        ("J", 11), ("j", 11), ("Q", 12), ("q", 12), ("K", 13), ("k", 13), ("A", 14), ("a", 14),
    ];
    for (prefix, value) in single {
        if let Some(suit) = card.strip_prefix(prefix) {
            return non_empty_suit(suit).map(|s| (value, s));
        }
    }
    None
}

fn non_empty_suit<'a>(suit: &'a str) -> Option<&'a str> {
    if suit.is_empty() { None } else { Some(suit) }
}
