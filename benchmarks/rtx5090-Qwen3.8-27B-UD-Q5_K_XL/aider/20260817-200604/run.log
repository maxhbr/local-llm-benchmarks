func (r *renderer) handleHeader() bool {
    if r.input[r.pos] != '#' { return false }
    for r.pos < len(r.input) && r.input[r.pos] == '#' {
        r.header++
        r.pos++
    }
    switch {
    case r.header == 7:
        r.html.WriteString("<p>" + strings.Repeat("#", r.header) + " ")
    case r.nonHeaderSeen:
        r.html.WriteString("# ")
        r.header--
    default:
        fmt.Fprintf(&r.html, "<h%d>", r.header)
    }
    if r.pos < len(r.input) { r.pos++ } // original always pos++ (could panic)
    return true
}
