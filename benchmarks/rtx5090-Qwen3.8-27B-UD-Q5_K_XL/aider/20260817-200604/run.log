const PRICES = [0, 800, 1520, 2160, 2560, 3000];

export const cost = (books) => {
  const counts = [0, 0, 0, 0, 0];

  for (const book of books) {
    counts[book - 1] += 1;
  }

  counts.sort((a, b) => b - a);

  const [a, b, c, d, e] = counts;
  const bottomTwo = d + e;

  let fiveGroups = 0;
  let fourGroups = 0;
  let threeGroups = 0;

  if (bottomTwo <= c) {
    fourGroups = bottomTwo;
    threeGroups = c - bottomTwo;
  } else {
    fiveGroups = bottomTwo - c;
    fourGroups = 2 * c - bottomTwo;
  }

  const twoGroups = b - c;
  const oneGroups = a - b;

  return (
    fiveGroups * PRICES[5] +
    fourGroups * PRICES[4] +
    threeGroups * PRICES[3] +
    twoGroups * PRICES[2] +
    oneGroups * PRICES[1]
  );
};
```
