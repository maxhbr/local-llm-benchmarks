public String decode(String text, int a, int b) {
    if (gcd(a,26)!=1) throw ...;
    int aInv = modInverse(a,26);
    StringBuilder sb = new StringBuilder();
    for (char c : text.toLowerCase().toCharArray()) {
       if (Character.isLetter(c)) { int y=c-'a'; int x = (aInv * ((y - b) % 26 + 26)) % 26; sb.append((char)('a'+x)); }
       else if (Character.isDigit(c)) sb.append(c);
    }
    return sb.toString();
}
```
