class CircularBuffer<T> {
    private final T[] buffer;
    private final int capacity;
    private int readIndex; // oldest
    private int writeIndex; // next write
    private int count;

    @SuppressWarnings("unchecked")
    CircularBuffer(final int size) {
        if (size < 0) throw new IllegalArgumentException("size must be non-negative");
        this.capacity = size;
        this.buffer = (T[]) new Object[size];
    }

    T read() throws BufferIOException {
        if (count == 0) throw new BufferIOException("Buffer is empty");
        T item = buffer[readIndex];
        buffer[readIndex] = null;
        readIndex = (readIndex + 1) % capacity; // if capacity 0? modulo by zero. Need handle capacity 0. If count==0 and capacity 0, throw before modulo. But if 
capacity 0 count always 0. So safe if check count==0 first. But if capacity 0 and count? no.
        count--;
        return item;
    }

    void write(T data) throws BufferIOException {
        if (count == capacity) throw new BufferIOException("Buffer is full");
        buffer[writeIndex] = data;
        writeIndex = (writeIndex + 1) % capacity; // capacity 0? if count==capacity (0==0) throw before modulo. So safe.
        count++;
    }

    void overwrite(T data) {
        if (capacity == 0) return; // or maybe no-op.
        if (count == capacity) {
            // replace oldest at readIndex
            buffer[readIndex] = data;
            readIndex = (readIndex + 1) % capacity;
            // writeIndex? In full state, writeIndex == readIndex before overwrite? Let's verify.
        } else {
            buffer[writeIndex] = data;
            writeIndex = (writeIndex + 1) % capacity;
            count++;
        }
    }

