func MakeChain(input []Domino) ([]Domino, bool) {
    n := len(input)
    if n == 0 { return []Domino{}, true }
    adj := make(map[int][]int)
    degree := make(map[int]int)
    vertices := []int{}
    addVertex := func(v int) {
       if _, ok := degree[v]; !ok {
          degree[v]=0
          vertices=append(vertices,v)
       }
    }
    for i,d := range input {
       u,v := d[0], d[1]
       addVertex(u); addVertex(v)
       degree[u]++; degree[v]++ // for loop adds 2 if u==v? Wait if u==v, addVertex once, degree[u]++ twice => 2. Good.
       adj[u]=append(adj[u], i)
       adj[v]=append(adj[v], i) // if loop appends twice
    }
    for _, v := range vertices { if degree[v]%2 !=0 { return nil,false } }
    // connectivity
    visited := make(map[int]bool)
    components := 0
    for _, v := range vertices {
       if degree[v]==0 { continue } // none
       if visited[v] { continue }
       components++
       if components > 1 { return nil,false }
       stack := []int{v}
       visited[v]=true
       for len(stack)>0 {
          cur := stack[len(stack)-1]; stack=stack[:len(stack)-1]
          for _, e := range adj[cur] {
             a,b := input[e][0], input[e][1]
             next := a
             if next == cur { next = b } // if loop a==b==cur, next=cur? Actually if a==cur, next=b (same). If edge cur-b, a=cur,b=next. If edge b-cur, a=b? Let's 
compute: if input[e][0] == cur then next=input[e][1] else next=input[e][0]. For loop both cur, next cur.
             if !visited[next] { visited[next]=true; stack=append(stack,next) }
          }
       }
    }
    // start
    start := 0
    found := false
    for _, v := range vertices { if degree[v] > 0 { start=v; found=true; break } }
    if !found { return []Domino{}, true } // n=0 handled
    used := make([]bool, n)
    stackV := []int{start}
    stackE := []int{}
    path := []int{}
    // optional nextIdx to avoid O(E^2)
    nextIdx := make(map[int]int)
    for len(stackV) > 0 {
       v := stackV[len(stackV)-1]
       // find unused
       foundEdge := -1
       for nextIdx[v] < len(adj[v]) {
          e := adj[v][nextIdx[v]]
          nextIdx[v]++
          if !used[e] { foundEdge = e; break }
       }
       if foundEdge == -1 {
          stackV = stackV[:len(stackV)-1]
          if len(stackE) > 0 {
             e := stackE[len(stackE)-1]
             stackE = stackE[:len(stackE)-1]
             path = append(path, e)
          }
       } else {
          e := foundEdge
          used[e] = true
          u,w := input[e][0], input[e][1]
          next := w
          if next == v { next = u } // if v == w, next u; if loop u==w==v, next v.
          // More robust: if input[e][0] == v { next = input[e][1] } else { next = input[e][0] }
          stackV = append(stackV, next)
          stackE = append(stackE, e)
       }
    }
    if len(path) != n { return nil,false }
    // reverse path
    for i,j := 0, len(path)-1; i<j; i,j = i+1,j-1 { path[i],path[j]=path[j],path[i] }
    chain := make([]Domino, 0, n)
    cur := start
    for _, e := range path {
       d := input[e]
       if d[0] == cur {
          chain = append(chain, d)
          cur = d[1]
       } else if d[1] == cur {
          chain = append(chain, Domino{d[1], d[0]})
          cur = d[0]
       } else {
          return nil,false
       }
    }
    if cur != start { return nil,false }
    return chain, true
}

