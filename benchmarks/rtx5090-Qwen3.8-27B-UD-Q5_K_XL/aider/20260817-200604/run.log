func contains(list, sub []int) bool {
	if len(sub) == 0 {
		return true
	}
	if len(sub) > len(list) {
		return false
	}
	for i := 0; i <= len(list)-len(sub); i++ {
		if matchesAt(list, sub, i) {
			return true
		}
	}
	return false
}

func matchesAt(list, sub []int, start int) bool {
	for i, v := range sub {
		if list[start+i] != v {
			return false
		}
	}
	return true
}
