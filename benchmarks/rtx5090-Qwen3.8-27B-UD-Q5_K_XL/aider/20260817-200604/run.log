pub fn encode(n: u64) -> String {
    if n == 0 {
        return "zero".to_string();
    }

    const SCALES: [&str; 7] = [
        "",
        "thousand",
        "million",
        "billion",
        "trillion",
        "quadrillion",
        "quintillion",
    ];

    let mut parts: Vec<String> = Vec::new();
    let mut value = n;
    let mut scale = 0;

    while value > 0 {
        let chunk = (value % 1000) as u32;
        if chunk != 0 {
            let mut part = encode_chunk(chunk);
            if scale > 0 {
                part.push(' ');
                part.push_str(SCALES[scale]);
            }
            parts.push(part);
        }
        value /= 1000;
        scale += 1;
    }

    parts.reverse();
    parts.join(" ")
}

fn encode_chunk(n: u32) -> String {
    let mut result = String::new();

    if n >= 100 {
        result.push_str(ONES[(n / 100) as usize]);
        result.push_str(" hundred");
        n %= 100;
    }

    if n > 0 {
        if !result.is_empty() {
            result.push(' ');
        }
        result.push_str(&encode_below_hundred(n));
    }

    result
}

fn encode_below_hundred(n: u32) -> String {
    if n < 20 {
        return ONES[n as usize].to_string();
    }

    let tens = TENS[(n / 10) as usize];
    let ones = n % 10;

    if ones == 0 {
        tens.to_string()
    } else {
        format!("{}-{}", tens, ONES[ones as usize])
    }
}

const ONES: [&str; 20] = [
