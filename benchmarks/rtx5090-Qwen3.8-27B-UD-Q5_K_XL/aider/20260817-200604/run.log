Pseudo:
```
use std::hash::{Hash, Hasher};
use std::time::{SystemTime, UNIX_EPOCH};

fn valid_key(key: &str) -> bool {
    !key.is_empty() && key.chars().all(|c| c.is_ascii_lowercase())
}

fn shift_char(c: char, shift: i32) -> char {
    match c {
        'a'..='z' => {
            let base = b'a' as i32;
            let val = c as i32 - base;
            let shifted = (val + shift).rem_euclid(26);
            (base + shifted) as u8 as char
        }
        'A'..='Z' => {
            let base = b'A' as i32;
            let val = c as i32 - base;
            let shifted = (val + shift).rem_euclid(26);
            (base + shifted) as u8 as char
        }
        _ => c,
    }
}

fn encode_with_key(key: &str, s: &str) -> Option<String> {
    if !valid_key(key) { return None; }
    let key_chars: Vec<char> = key.chars().collect();
    let mut key_idx = 0usize;
    let mut out = String::with_capacity(s.len());
    for c in s.chars() {
        if c.is_ascii_alphabetic() {
            let shift = key_chars[key_idx % key_chars.len()] as u8 - b'a';
            out.push(shift_char(c, shift as i32));
            key_idx += 1;
        } else {
            out.push(c);
        }
    }
    Some(out)
}

fn decode_with_key(key: &str, s: &str) -> Option<String> {
    if !valid_key(key) { return None; }
    let key_chars: Vec<char> = key.chars().collect();
    let mut key_idx = 0usize;
    let mut out = String::with_capacity(s.len());
    for c in s.chars() {
        if c.is_ascii_alphabetic() {
            let shift = key_chars[key_idx % key_chars.len()] as u8 - b'a';
            out.push(shift_char(c, -(shift as i32)));
            key_idx += 1;
        } else {
            out.push(c);
        }
    }
    Some(out)
}
```
