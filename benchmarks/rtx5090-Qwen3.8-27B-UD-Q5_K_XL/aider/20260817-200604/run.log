use std::collections::BTreeSet;

#[derive(PartialEq, Eq, PartialOrd, Ord, Clone, Debug)]
struct HandScore {
    category: u8,
    tiebreakers: Vec<u8>,
}

pub fn winning_hands<'a>(hands: &[&'a str]) -> Vec<&'a str> {
    let mut winners = Vec::new();
    let mut best: Option<HandScore> = None;

    for &hand in hands {
        let score = hand_score(hand);
        let is_better = match &best {
            None => true,
            Some(current) => score > *current,
        };
        if is_better {
            best = Some(score);
            winners.clear();
            winners.push(hand);
        } else {
            let is_equal = match &best {
                None => false,
                Some(current) => score == *current,
            };
            if is_equal {
                winners.push(hand);
            }
        }
    }

    winners
}
```
