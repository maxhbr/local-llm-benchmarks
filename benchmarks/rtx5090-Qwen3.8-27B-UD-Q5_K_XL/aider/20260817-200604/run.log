import re


class StackUnderflowError(Exception):
    """Exception raised when the stack does not contain enough items."""

    def __init__(self, message="Insufficient number of items in stack"):
        super().__init__(message)
        self.message = message


_NUMBER_RE = re.compile(r"^[+-]?[0-9]+$")


def _is_number(token):
    return bool(_NUMBER_RE.match(token))


def _require_items(stack, count):
    if len(stack) < count:
        raise StackUnderflowError("Insufficient number of items in stack")


def _truncated_divide(a, b):
    quotient = abs(a) // abs(b)
    if (a < 0) != (b < 0):
        quotient = -quotient
    return quotient


def _add(stack): ...
...

_BUILTINS = {...}


def _expand_definition(raw_tokens, definitions):
    expanded = []
    for token in raw_tokens:
        if _is_number(token):
            expanded.append(token)
            continue
        key = token.lower()
        if key in definitions:
            expanded.extend(definitions[key])
        elif key in _BUILTINS:
            expanded.append(key)
        else:
            raise ValueError("undefined operation")
    return expanded


def _execute(token, stack, definitions):
    if _is_number(token):
        stack.append(int(token))
        return
    key = token.lower()
    if key in definitions:
        for definition_token in definitions[key]:
            _execute(definition_token, stack, definitions)
    elif key in _BUILTINS:
        _BUILTINS[key](stack)
    else:
        raise ValueError("undefined operation")


def evaluate(input_data):
    if isinstance(input_data, (list, tuple)):
        tokens = []
        for item in input_data:
            tokens.extend(str(item).split())
    else:
        tokens = input_data.split()

    stack = []
    definitions = {}
    index = 0

    while index < len(tokens):
        token = tokens[index]

        if token == ":":
            index += 1
            if index >= len(tokens):
                raise ValueError("illegal operation")

            name = tokens[index]
            index += 1

            if _is_number(name):
                raise ValueError("illegal operation")

            raw_definition = []
            closed = False

            while index < len(tokens):
                if tokens[index] == ";":
                    closed = True
                    index += 1
                    break
                raw_definition.append(tokens[index])
                index += 1

            if not closed:
                raise ValueError("illegal operation")

            definitions[name.lower()] = _expand_definition(raw_definition, definitions)
        else:
            _execute(token, stack, definitions)
            index += 1

    return stack

