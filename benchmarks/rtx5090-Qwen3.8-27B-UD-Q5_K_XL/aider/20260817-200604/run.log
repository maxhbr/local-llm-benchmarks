```
import inspect


def _call_compute_function(func, values):
    try:
        sig = inspect.signature(func)
    except (TypeError, ValueError):
        try:
            return func(values)
        except TypeError:
            return func(*values)

    params = list(sig.parameters.values())
    positional = [
        p
        for p in params
        if p.kind
        in (
            inspect.Parameter.POSITIONAL_ONLY,
            inspect.Parameter.POSITIONAL_OR_KEYWORD,
        )
    ]
    has_var_positional = any(
        p.kind == inspect.Parameter.VAR_POSITIONAL for p in params
    )

    if len(positional) == 1:
        return func(values)

    if has_var_positional:
        return func(*values)

    if len(positional) == len(values):
        return func(*values)

    try:
        return func(values)
    except TypeError:
        return func(*values)


def _invoke_callback(callback, value):
    try:
        sig = inspect.signature(callback)
    except (TypeError, ValueError):
        try:
            callback()
        except TypeError:
            callback(value)
        return

    params = list(sig.parameters.values())
    required_positional = [
        p
        for p in params
        if p.kind
        in (
            inspect.Parameter.POSITIONAL_ONLY,
            inspect.Parameter.POSITIONAL_OR_KEYWORD,
        )
        and p.default is inspect.Parameter.empty
    ]

    if len(required_positional) == 1:
        callback(value)
    else:
        callback()


def _propagate(source):
    affected = []
    visited = set()
    stack = [source]

    while stack:
        cell = stack.pop()
        for dependent in getattr(cell, "_dependents", []):
            dependent_id = id(dependent)
            if dependent_id not in visited:
                visited.add(dependent_id)
                affected.append(dependent)
                stack.append(dependent)

    if not affected:
        return

    affected_ids = {id(cell) for cell in affected}
    in_degree = {id(cell): 0 for cell in affected}
    adjacency = {id(cell): [] for cell in affected}

    for cell in affected:
        for input_cell in getattr(cell, "_inputs", []):
            input_id = id(input_cell)
            if input_id in affected_ids:
                in_degree[id(cell)] += 1
                adjacency[input_id].append(cell)

    queue = [cell for cell in affected if in_degree[id(cell)] == 0]
    order = []
    head = 0

    while head < len(queue):
        cell = queue[head]
        head += 1
        order.append(cell)

        for dependent in adjacency[id(cell)]:
            in_degree[id(dependent)] -= 1
            if in_degree[id(dependent)] == 0:
                queue.append(dependent)

    if len(order) != len(affected):
        ordered_ids = {id(cell) for cell in order}
        order.extend(cell for cell in affected if id(cell) not in ordered_ids)

    changed_ids = {id(source)}
    changed_cells = []

    for cell in order:
        if any(
            id(input_cell) in changed_ids
            for input_cell in getattr(cell, "_inputs", [])
        ):
            old_value = cell._value
            cell._value = cell._compute()

            if cell._value != old_value:
                changed_ids.add(id(cell))
                changed_cells.append(cell)

    for cell in changed_cells:
        for callback in list(cell._callbacks):
            _invoke_callback(callback, cell._value)


class InputCell:
    def __init__(self, initial_value):
        self._value = initial_value
        self._dependents = []

    @property
    def value(self):
        return self._value

    @value.setter
    def value(self, new_value):
        if new_value == self._value:
            return

        self._value = new_value
        _propagate(self)


class ComputeCell:
    def __init__(self, inputs, compute_function):
        self._inputs = list(inputs)
        self._compute_function = compute_function
        self._callbacks = []
        self._dependents = []

        self._value = self._compute()

        for cell in self._inputs:
            if not hasattr(cell, "_dependents"):
                cell._dependents = []
            cell._dependents.append(self)

    def _compute(self):
        values = [cell.value for cell in self._inputs]
        return _call_compute_function(self._compute_function, values)

    @property
    def value(self):
        return self._value

    def add_callback(self, callback):
        self._callbacks.append(callback)

    def remove_callback(self, callback):
        try:
            self._callbacks.remove(callback)
        except ValueError:
            pass
```

