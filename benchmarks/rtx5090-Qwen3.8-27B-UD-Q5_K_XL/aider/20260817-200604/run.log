private static void propagate(Cell<?> changed) {
    // collect reachable compute cells
    Set<ComputeCell<?>> reachable = new HashSet<>();
    Deque<Cell<?>> queue = new ArrayDeque<>();
    queue.add(changed);
    Set<Cell<?>> visitedCells = new HashSet<>();
    while (!queue.isEmpty()) {
       Cell<?> c = queue.poll();
       if (!visitedCells.add(c)) continue;
       for (ComputeCell<?> dep : c.dependents) {
           reachable.add(dep);
           queue.add(dep);
       }
    }
    if (reachable.isEmpty()) return;
    // in-degree: for each compute cell, count dependencies that are in reachable
    Map<ComputeCell<?>, Integer> indegree = new HashMap<>();
    for (ComputeCell<?> cell : reachable) indegree.put(cell, 0);
    for (ComputeCell<?> cell : reachable) {
       for (Cell<?> dep : cell.dependencies) {
          if (dep instanceof ComputeCell && reachable.contains(dep)) {
             indegree.merge(cell, 1, Integer::sum);
          }
       }
    }
    Deque<ComputeCell<?>> ready = new ArrayDeque<>();
    for (ComputeCell<?> cell : reachable) if (indegree.get(cell) == 0) ready.add(cell);
    while (!ready.isEmpty()) {
       ComputeCell<?> cell = ready.poll();
       cell.recompute();
       for (ComputeCell<?> dependent : cell.dependents) {
          if (reachable.contains(dependent)) {
             int deg = indegree.merge(dependent, -1, Integer::sum);
             if (deg == 0) ready.add(dependent);
          }
       }
    }
}

