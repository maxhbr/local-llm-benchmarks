def recite(start, take=1):
    numbers = {
        0: "no",
        1: "one",
        2: "two",
        3: "three",
        4: "four",
        5: "five",
        6: "six",
        7: "seven",
        8: "eight",
        9: "nine",
        10: "ten",
    }

    def bottle_word(count):
        return "bottle" if count == 1 else "bottles"

    def number_word(count, capitalize=False):
        word = numbers.get(count, str(count))
        return word.capitalize() if capitalize else word

    lines = []
    verses = list(range(start, max(start - take, 0), -1))

    for index, current in enumerate(verses):
        if index > 0:
            lines.append("")

        current_word = number_word(current, capitalize=True)
        next_count = current - 1 if current > 0 else 0
        next_word = number_word(next_count)

        lines.append(f"{current_word} green {bottle_word(current)} hanging on the wall,")
        lines.append(f"{current_word} green {bottle_word(current)} hanging on the wall,")
        lines.append("And if one green bottle should accidentally fall,")
        lines.append(f"There'll be {next_word} green {bottle_word(next_count)} hanging on the wall.")

    return lines
```
