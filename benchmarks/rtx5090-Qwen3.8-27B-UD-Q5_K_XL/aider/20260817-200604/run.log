lib.rs
```
pub struct Luhn {
    digits: Vec<u32>,
    valid: bool,
}

impl Luhn {
    pub fn is_valid(&self) -> bool {
        if !self.valid || self.digits.len() < 2 {
            return false;
        }

        if self.digits.iter().all(|&digit| digit == 0) {
            return false;
        }

        let sum: u32 = self
            .digits
            .iter()
            .enumerate()
            .map(|(index, &digit)| {
                let position_from_right = self.digits.len() - index;
                if position_from_right % 2 == 0 {
                    let doubled = digit * 2;
                    if doubled > 9 {
                        doubled - 9
                    } else {
                        doubled
                    }
                } else {
                    digit
                }
            })
            .sum();

        sum % 10 == 0
    }
}

/// Implement `From` for any type that can be converted to a string.
/// This covers `&str`, `String`, `str`, and unsigned integer types.
impl<T> From<T> for Luhn
where
    T: ToString,
{
    fn from(input: T) -> Self {
        let mut digits = Vec::new();
        let mut valid = true;

        for c in input.to_string().chars() {
            if c == ' ' {
                continue;
            }

            if c.is_ascii_digit() {
                digits.push(c.to_digit(10).unwrap() as u32);
            } else {
                valid = false;
                break;
            }
        }

        Luhn { digits, valid }
    }
}
```

