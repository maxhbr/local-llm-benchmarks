package wordy
import (
 "strconv"
 "strings"
)
func Answer(question string) (int, bool) {
 q := strings.TrimSpace(question)
 q = strings.TrimSuffix(q, "?")
 if !strings.HasPrefix(q, "What is ") { return 0, false }
 tokens := strings.Fields(strings.TrimPrefix(q, "What is "))
 if len(tokens) == 0 { return 0, false }
 val, err := strconv.Atoi(tokens[0])
 if err != nil { return 0, false }
 i := 1
 for i < len(tokens) {
   switch tokens[i] {
   case "plus":
      i++
      if i >= len(tokens) { return 0, false }
      n, err := strconv.Atoi(tokens[i]); if err != nil { return 0, false }
      val += n
   case "minus":
      i++
      if i >= len(tokens) { return 0, false }
      n, err := strconv.Atoi(tokens[i]); if err != nil { return 0, false }
      val -= n
   case "multiplied":
      i++
      if i >= len(tokens) || tokens[i] != "by" { return 0, false }
      i++
      if i >= len(tokens) { return 0, false }
      n, err := strconv.Atoi(tokens[i]); if err != nil { return 0, false }
      val *= n
   case "divided":
      i++
      if i >= len(tokens) || tokens[i] != "by" { return 0, false }
      i++
      if i >= len(tokens) { return 0, false }
      n, err := strconv.Atoi(tokens[i]); if err != nil { return 0, false }
      if n == 0 { return 0, false } // maybe
      val /= n
   default:
      return 0, false
   }
   i++
 }
 return val, true
}

