Let's draft code:
```
pub mod graph {
    #[derive(Debug, Clone, PartialEq, Eq, Default)]
    pub struct Graph {
        pub nodes: Vec<Node>,
        pub edges: Vec<Edge>,
        pub attrs: Vec<(String, String)>,
    }

    #[derive(Debug, Clone, PartialEq, Eq)]
    pub struct Node {
        pub name: String,
        pub attrs: Vec<(String, String)>,
    }

    #[derive(Debug, Clone, PartialEq, Eq)]
    pub struct Edge {
        pub from: String,
        pub to: String,
        pub attrs: Vec<(String, String)>,
    }

    impl Graph {
        pub fn new() -> Self { Self::default() }

        pub fn with_node<T: Into<Node>>(mut self, node: T) -> Self {
            self.nodes.push(node.into());
            self
        }

        pub fn with_edge<T: Into<Edge>>(mut self, edge: T) -> Self {
            self.edges.push(edge.into());
            self
        }

        pub fn with_attr<K: Into<String>, V: Into<String>>(mut self, key: K, value: V) -> Self {
            self.attrs.push((key.into(), value.into()));
            self
        }

        pub fn with_nodes<I, T>(mut self, nodes: I) -> Self
        where
            I: IntoIterator<Item = T>,
            T: Into<Node>,
        {
            for node in nodes {
                self.nodes.push(node.into());
            }
            self
        }

        pub fn with_edges<I, T>(mut self, edges: I) -> Self
        where
            I: IntoIterator<Item = T>,
            T: Into<Edge>,
        {
            for edge in edges {
                self.edges.push(edge.into());
            }
            self
        }

        pub fn with_attrs<I, K, V>(mut self, attrs: I) -> Self
        where
            I: IntoIterator<Item = (K, V)>,
            K: Into<String>,
            V: Into<String>,
        {
            for (k, v) in attrs {
                self.attrs.push((k.into(), v.into()));
            }
            self
        }

        pub fn node(&self, name: &str) -> Option<&Node> {
            self.nodes.iter().find(|n| n.name == name)
        }

        pub fn edge(&self, from: &str, to: &str) -> Option<&Edge> {
            self.edges.iter().find(|e| e.from == from && e.to == to)
        }

        pub fn attr(&self, key: &str) -> Option<&str> {
            self.attrs.iter().rev().find(|(k, _)| k == key).map(|(_, v)| v.as_str())
        }

        pub fn nodes(&self) -> &[Node] { &self.nodes }
        pub fn edges(&self) -> &[Edge] { &self.edges }
        pub fn attrs(&self) -> &[(String, String)] { &self.attrs }

        pub fn len(&self) -> usize { self.nodes.len() + self.edges.len() }
        pub fn is_empty(&self) -> bool { self.nodes.is_empty() && self.edges.is_empty() }
    }

    impl Node {
        pub fn new<N: Into<String>>(name: N) -> Self {
            Self { name: name.into(), attrs: Vec::new() }
        }

        pub fn with_attr<K: Into<String>, V: Into<String>>(mut self, key: K, value: V) -> Self {
            self.attrs.push((key.into(), value.into()));
            self
        }

        pub fn with_attrs<I, K, V>(mut self, attrs: I) -> Self
        where
            I: IntoIterator<Item = (K, V)>,
            K: Into<String>,
            V: Into<String>,
        {
            for (k, v) in attrs {
                self.attrs.push((k.into(), v.into()));
            }
            self
        }

        pub fn attr(&self, key: &str) -> Option<&str> {
            self.attrs.iter().rev().find(|(k, _)| k == key).map(|(_, v)| v.as_str())
        }
    }

    impl Edge {
        pub fn new<F: Into<String>, T: Into<String>>(from: F, to: T) -> Self {
            Self { from: from.into(), to: to.into(), attrs: Vec::new() }
        }

        pub fn with_attr<K: Into<String>, V: Into<String>>(mut self, key: K, value: V) -> Self {
            self.attrs.push((key.into(), value.into()));
            self
        }

        pub fn with_attrs<I, K, V>(mut self, attrs: I) -> Self
        where
            I: IntoIterator<Item = (K, V)>,
            K: Into<String>,
            V: Into<String>,
        {
            for (k, v) in attrs {
                self.attrs.push((k.into(), v.into()));
            }
            self
        }

        pub fn attr(&self, key: &str) -> Option<&str> {
            self.attrs.iter().rev().find(|(k, _)| k == key).map(|(_, v)| v.as_str())
        }
    }

    impl From<&str> for Node {
        fn from(name: &str) -> Self { Self::new(name) }
    }

    impl From<String> for Node {
        fn from(name: String) -> Self { Self::new(name) }
    }

    impl From<&Node> for Node {
        fn from(node: &Node) -> Self { node.clone() }
    }

    impl From<(&str, &str)> for Edge {
        fn from((from, to): (&str, &str)) -> Self { Self::new(from, to) }
    }

    impl From<(String, String)> for Edge {
        fn from((from, to): (String, String)) -> Self { Self::new(from, to) }
    }

    impl From<(String, &str)> for Edge {
        fn from((from, to): (String, &str)) -> Self { Self::new(from, to) }
    }

    impl From<(&str, String)> for Edge {
        fn from((from, to): (&str, String)) -> Self { Self::new(from, to) }
    }

    impl From<&Edge> for Edge {
        fn from(edge: &Edge) -> Self { edge.clone() }
    }
}

