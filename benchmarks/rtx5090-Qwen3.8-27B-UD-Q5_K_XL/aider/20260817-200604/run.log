namespace robot_name {

namespace {

std::mutex& mutex() {
    static std::mutex mutex;
    return mutex;
}

std::set<std::string>& used_names() {
    static std::set<std::string> used_names;
    return used_names;
}

std::mt19937& generator() {
    static std::mt19937 generator{[] {
        std::random_device random_device;
        auto time_seed = static_cast<std::mt19937::result_type>(
            std::chrono::steady_clock::now().time_since_epoch().count());
        auto device_seed = static_cast<std::mt19937::result_type>(random_device());
        return time_seed ^ device_seed;
    }()};
    return generator;
}

std::string random_name() {
    auto& generator = generator();
    std::uniform_int_distribution<int> letter(0, 25);
    std::uniform_int_distribution<int> number(0, 999);

    int n = number(generator);
    return std::string{
        static_cast<char>('A' + letter(generator)),
        static_cast<char>('A' + letter(generator)),
        static_cast<char>('0' + n / 100),
        static_cast<char>('0' + (n / 10) % 10),
        static_cast<char>('0' + n % 10)
    };
}

std::string generate_unique_name() {
    auto& used_names = used_names();
    if (used_names.size() >= 26 * 26 * 1000) {
        throw std::runtime_error("No more unique robot names available");
    }

    while (true) {
        std::string candidate = random_name();
        if (used_names.insert(candidate).second) {
            return candidate;
        }
    }
}

}  // namespace

std::string Robot::name() const {
    std::lock_guard<std::mutex> lock(mutex());
    if (name_.empty()) {
        name_ = generate_unique_name();
    }
    return name_;
}

void Robot::reset() {
    std::lock_guard<std::mutex> lock(mutex());
    name_.clear();
}

}  // namespace robot_name

