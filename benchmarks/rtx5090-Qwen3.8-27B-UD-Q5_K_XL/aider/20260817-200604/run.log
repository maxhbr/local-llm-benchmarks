def append(list1, list2):
    len1 = length(list1)
    len2 = length(list2)
    result = [None] * (len1 + len2)
    index = 0
    for item in list1:
        result[index] = item
        index += 1
    for item in list2:
        result[index] = item
        index += 1
    return result


def concat(lists):
    total = 0
    for sublist in lists:
        total += length(sublist)

    result = [None] * total
    index = 0
    for sublist in lists:
        for item in sublist:
            result[index] = item
            index += 1
    return result


def filter(function, list):
    total = length(list)
    temp = [None] * total
    index = 0
    for item in list:
        if function(item):
            temp[index] = item
            index += 1

    result = [None] * index
    i = 0
    while i < index:
        result[i] = temp[i]
        i += 1
    return result


def length(list):
    count = 0
    for _ in list:
        count += 1
    return count


def map(function, list):
    total = length(list)
    result = [None] * total
    index = 0
    for item in list:
        result[index] = function(item)
        index += 1
    return result


def foldl(function, list, initial):
    for item in list:
        initial = function(initial, item)
    return initial


def foldr(function, list, initial):
    index = length(list) - 1
    while index >= 0:
        initial = function(list[index], initial)
        index -= 1
    return initial


def reverse(list):
    total = length(list)
    result = [None] * total
    index = 0
    source_index = total - 1
    while source_index >= 0:
        result[index] = list[source_index]
        index += 1
        source_index -= 1
    return result
