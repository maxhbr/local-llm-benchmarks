use std::ops::... no need.

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
enum Operation {
    Add,
    Sub,
    Mul,
    Div,
    Pow,
}

pub fn answer(command: &str) -> Option<i32> {
    let command = command.trim();
    let expression = command.strip_prefix("What is ")?;
    let expression = expression.strip_suffix('?')?;
    let tokens: Vec<&str> = expression.split_whitespace().collect();
    if tokens.is_empty() { return None; }

    let mut i = 0;
    let mut value = parse_number(tokens.get(0)?)?;
    i = 1;

    while i < tokens.len() {
        let op = parse_operation(&tokens, &mut i)?;
        let num = parse_number(tokens.get(i)?)?;
        i += 1;
        value = apply(value, op, num)?;
    }

    i32::try_from(value).ok()
}

fn parse_number(token: &str) -> Option<i64> {
    token.parse::<i64>().ok()
}

fn parse_operation(tokens: &[&str], i: &mut usize) -> Option<Operation> {
    let len = tokens.len();
    let token = tokens.get(*i)?;
    if *token == "plus" {
        *i += 1;
        Some(Operation::Add)
    } else if *token == "minus" {
        *i += 1;
        Some(Operation::Sub)
    } else if *token == "multiplied" && tokens.get(*i + 1) == Some(&"by") {
        *i += 2;
        Some(Operation::Mul)
    } else if *token == "divided" && tokens.get(*i + 1) == Some(&"by") {
        *i += 2;
        Some(Operation::Div)
    } else {
        #[cfg(feature = "exponentials")]
        {
            if *token == "raised"
                && tokens.get(*i + 1) == Some(&"to")
                && tokens.get(*i + 2) == Some(&"the")
                && tokens.get(*i + 3) == Some(&"power")
                && tokens.get(*i + 4) == Some(&"of")
            {
                *i += 5;
                Some(Operation::Pow)
            } else {
                None
            }
        }
        #[cfg(not(feature = "exponentials"))]
        {
            None
        }
    }
}

fn apply(value: i64, op: Operation, rhs: i64) -> Option<i64> {
    match op {
        Operation::Add => value.checked_add(rhs),
        Operation::Sub => value.checked_sub(rhs),
        Operation::Mul => value.checked_mul(rhs),
        Operation::Div => {
            if rhs == 0 {
                None
            } else {
                value.checked_div(rhs)
            }
        }
        Operation::Pow => {
            if rhs < 0 {
                None
            } else {
                let exp = u32::try_from(rhs).ok()?;
                value.checked_pow(exp)
            }
        }
    }
}

