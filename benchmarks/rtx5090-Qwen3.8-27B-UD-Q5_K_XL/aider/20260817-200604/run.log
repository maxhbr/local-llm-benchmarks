    }

    private Optional<WordLocation> findWord(char[][] grid, String word) {
        for (int r = 0; r < grid.length; r++) {
            for (int c = 0; c < grid[r].length; c++) {
                for (int dr = -1; dr <= 1; dr++) {
                    for (int dc = -1; dc <= 1; dc++) {
                        if (dr == 0 && dc == 0) continue;
                        WordLocation location = check(grid, word, r, c, dr, dc);
                        if (location != null) return Optional.of(location);
                    }
                }
            }
        }
        return Optional.empty();
    }

    private WordLocation check(char[][] grid, String word, int r, int c, int dr, int dc) {
        if (grid[r][c] != word.charAt(0)) return null;
        int endR = r + dr * (word.length() - 1);
        int endC = c + dc * (word.length() - 1);
        if (endR < 0 || endR >= grid.length || endC < 0 || endC >= grid[0].length) return null;
        for (int i = 0; i < word.length(); i++) {
            if (grid[r + dr*i][c + dc*i] != word.charAt(i)) return null;
        }
        return new WordLocation(r + 1, c + 1, endR + 1, endC + 1);
    }
}
