Implementation details:
```
package bookstore

import "sort"

func Cost(books []int) int {
    counts := make([]int, 5)
    for _, b := range books {
        if b >= 1 && b <= 5 { counts[b-1]++ }
    }
    sort.Sort(sort.Reverse(sort.IntSlice(counts))) // descending
    total := 0
    prices := [6]int{0, 800, 1520, 2160, 2560, 3000}
    for counts[0] > 0 {
        size := 0
        if counts[4] == 0 {
            for i := 0; i < 5 && counts[i] > 0; i++ {
                counts[i]--
                size++
            }
        } else if counts[2] > counts[3] {
            for i := 0; i < 4; i++ {
                counts[i]--
            }
            size = 4
        } else {
            for i := 0; i < 5; i++ {
                counts[i]--
            }
            size = 5
        }
        total += prices[size]
        sort.Sort(sort.Reverse(sort.IntSlice(counts)))
    }
    return total
}
```
