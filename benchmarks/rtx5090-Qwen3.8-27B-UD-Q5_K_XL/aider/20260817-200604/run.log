//
// This is only a SKELETON file for the 'Zebra Puzzle' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

const COLORS = ['Red', 'Green', 'Ivory', 'Yellow', 'Blue'];
const NATIONALITIES = ['Englishman', 'Spaniard', 'Ukrainian', 'Norwegian', 'Japanese'];
const PETS = ['Dog', 'Fox', 'Horse', 'Snail', 'Zebra'];
const DRINKS = ['Coffee', 'Tea', 'Milk', 'OrangeJuice', 'Water'];
const HOBBIES = ['Dancing', 'Reading', 'Chess', 'Football', 'Painting'];

function permutations(values) {
  if (values.length <= 1) {
    return [values.slice()];
  }

  const result = [];
  for (let i = 0; i < values.length; i += 1) {
    const rest = values.slice(0, i).concat(values.slice(i + 1));
    for (const perm of permutations(rest)) {
      result.push([values[i], ...perm]);
    }
  }
  return result;
}

const COLOR_PERMS = permutations(COLORS);
const NATIONALITY_PERMS = permutations(NATIONALITIES);
const PET_PERMS = permutations(PETS);
const DRINK_PERMS = permutations(DRINKS);
const HOBBY_PERMS = permutations(HOBBIES);

function hasNeighbor(values, index, target) {
  return (
    (index > 0 && values[index - 1] === target) ||
    (index < values.length - 1 && values[index + 1] === target)
  );
}

function isValidColors(colors) {
  for (let i = 0; i < colors.length; i += 1) {
    if (colors[i] === 'Green' && (i === 0 || colors[i - 1] !== 'Ivory')) {
      return false;
    }
  }
  return true;
}

function isValidNationalities(colors, nationalities) {
  if (nationalities[0] !== 'Norwegian') {
    return false;
  }

  for (let i = 0; i < nationalities.length; i += 1) {
    if (nationalities[i] === 'Englishman' && colors[i] !== 'Red') {
      return false;
    }
    if (colors[i] === 'Red' && nationalities[i] !== 'Englishman') {
      return false;
    }
    if (nationalities[i] === 'Norwegian' && !hasNeighbor(colors, i, 'Blue')) {
      return false;
    }
    if (colors[i] === 'Blue' && !hasNeighbor(nationalities, i, 'Norwegian')) {
      return false;
    }
  }

  return true;
}

function isValidDrinks(colors, nationalities, drinks) {
  if (drinks[2] !== 'Milk') {
    return false;
  }

  for (let i = 0; i < drinks.length; i += 1) {
    if (colors[i] === 'Green' && drinks[i] !== 'Coffee') {
      return false;
    }
    if (drinks[i] === 'Coffee' && colors[i] !== 'Green') {
      return false;
    }
    if (nationalities[i] === 'Ukrainian' && drinks[i] !== 'Tea') {
      return false;
    }
    if (drinks[i] === 'Tea' && nationalities[i] !== 'Ukrainian') {
      return false;
    }
  }

  return true;
}

function isValidPets(nationalities, pets) {
  for (let i = 0; i < pets.length; i += 1) {
    if (nationalities[i] === 'Spaniard' && pets[i] !== 'Dog') {
      return false;
    }
    if (pets[i] === 'Dog' && nationalities[i] !== 'Spaniard') {
      return false;
    }
  }

  return true;
}

function isValidHobbies(colors, nationalities, drinks, pets, hobbies) {
  for (let i = 0; i < hobbies.length; i += 1) {
    if (pets[i] === 'Snail' && hobbies[i] !== 'Dancing') {
      return false;
    }
    if (hobbies[i] === 'Dancing' && pets[i] !== 'Snail') {
      return false;
    }

    if (colors[i] === 'Yellow' && hobbies[i] !== 'Painting') {
      return false;
    }
    if (hobbies[i] === 'Painting' && colors[i] !== 'Yellow') {
      return false;
    }

    if (hobbies[i] === 'Football' && drinks[i] !== 'OrangeJuice') {
      return false;
    }
    if (drinks[i] === 'OrangeJuice' && hobbies[i] !== 'Football') {
      return false;
    }

    if (nationalities[i] === 'Japanese' && hobbies[i] !== 'Chess') {
      return false;
    }
    if (hobbies[i] === 'Chess' && nationalities[i] !== 'Japanese') {
      return false;
    }

    if (hobbies[i] === 'Reading' && !hasNeighbor(pets, i, 'Fox')) {
      return false;
    }
    if (pets[i] === 'Fox' && !hasNeighbor(hobbies, i, 'Reading')) {
      return false;
    }

    if (hobbies[i] === 'Painting' && !hasNeighbor(pets, i, 'Horse')) {
      return false;
    }
    if (pets[i] === 'Horse' && !hasNeighbor(hobbies, i, 'Painting')) {
      return false;
    }
  }

  return true;
}

let cachedSolution = null;

function solveZebraPuzzle() {
  if (cachedSolution) {
    return cachedSolution;
  }

  for (const colors of COLOR_PERMS) {
    if (!isValidColors(colors)) continue;

    for (const nationalities of NATIONALITY_PERMS) {
      if (!isValidNationalities(colors, nationalities)) continue;

      for (const drinks of DRINK_PERMS) {
        if (!isValidDrinks(colors, nationalities, drinks)) continue;

        for (const pets of PET_PERMS) {
          if (!isValidPets(nationalities, pets)) continue;

          for (const hobbies of HOBBY_PERMS) {
            if (!isValidHobbies(colors, nationalities, drinks, pets, hobbies)) continue;

            cachedSolution = {
              waterDrinker: nationalities[drinks.indexOf('Water')],
              zebraOwner: nationalities[pets.indexOf('Zebra')],
            };
            return cachedSolution;
          }
        }
      }
    }
  }

  throw new Error('Zebra puzzle has no solution.');
}

export class ZebraPuzzle {
  constructor() {
    const solution = solveZebraPuzzle();
    this._waterDrinker = solution.waterDrinker;
    this._zebraOwner = solution.zebraOwner;
  }

  waterDrinker() {
    return this._waterDrinker;
  }

  zebraOwner() {
    return this._zebraOwner;
  }
}

