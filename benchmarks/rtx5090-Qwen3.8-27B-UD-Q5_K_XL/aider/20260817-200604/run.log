                end := i + idx2
                b.WriteString(s[i:end])
                b.WriteString(close)
                i = end + len(delim)
            } else {
                b.WriteString(s[i:])
                i = len(s)
            }
        } else {
            b.WriteString(s[i:])
            i = len(s)
        }
    }
    return b.String()
}
```
