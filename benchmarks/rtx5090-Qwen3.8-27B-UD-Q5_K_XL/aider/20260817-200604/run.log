response:
I implemented `ParseHex` to manually convert hexadecimal digits to a decimal `int64`, reject invalid characters, empty input, and overflow, and panic with the provided `errCase` when the result does not match `out` or the input is invalid.

hexadecimal.go
```
package hexadecimal

func ParseHex(in string, out int64, errCase string) {
	if in == "" {
		panic(errCase)
	}

	const maxInt64 = 9223372036854775807
	var value int64

	for i := 0; i < len(in); i++ {
		c := in[i]
		var digit int64

		switch {
		case c >= '0' && c <= '9':
			digit = int64(c - '0')
		case c >= 'a' && c <= 'f':
			digit = int64(c-'a' + 10)
		case c >= 'A' && c <= 'F':
			digit = int64(c-'A' + 10)
		default:
			panic(errCase)
		}

		if value > (maxInt64-digit)/16 {
			panic(errCase)
		}

		value = value*16 + digit
	}

	if value != out {
		panic(errCase)
	}
}
