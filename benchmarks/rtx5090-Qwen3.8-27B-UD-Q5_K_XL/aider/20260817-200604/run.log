Code draft:
```
import json
from decimal import Decimal, ROUND_HALF_UP

class RestAPI:
    def __init__(self, database=None):
        self.users = {}
        self.database = self.users
        if database is not None:
            self._load_database(database)

    @staticmethod
    def _round(value):
        try:
            number = Decimal(str(value)).quantize(Decimal('0.01'), rounding=ROUND_HALF_UP)
        except Exception:
            return 0.0
        result = float(number)
        return 0.0 if result == 0 else result

    def _load_database(self, database):
        if isinstance(database, (bytes, bytearray)):
            database = database.decode()
        if isinstance(database, str):
            try:
                database = json.loads(database)
            except Exception:
                return
        if isinstance(database, dict):
            if 'users' in database and isinstance(database['users'], (list, dict)):
                users_data = database['users']
            else:
                users_data = database
        elif isinstance(database, list):
            users_data = database
        else:
            return
        if isinstance(users_data, dict):
            for name, user in users_data.items():
                self._load_user(str(name), user)
        elif isinstance(users_data, list):
            for user in users_data:
                if isinstance(user, dict) and 'name' in user:
                    self._load_user(str(user['name']), user)
                elif isinstance(user, str):
                    self._load_user(user, {})

    def _load_user(self, name, user=None):
        owes = {}
        owed_by = {}
        if isinstance(user, dict):
            raw_owes = user.get('owes', {})
            if isinstance(raw_owes, dict):
                for other, amount in raw_owes.items():
                    owes[str(other)] = self._round(amount)
            raw_owed_by = user.get('owed_by', {})
            if isinstance(raw_owed_by, dict):
                for other, amount in raw_owed_by.items():
                    owed_by[str(other)] = self._round(amount)
        self.users[name] = {'owes': owes, 'owed_by': owed_by}

    def _ensure_user(self, name):
        name = str(name)
        if name not in self.users:
            self.users[name] = {'owes': {}, 'owed_by': {}}
        return name

    def _increase_debt(self, from_user, to_user, amount):
        amount = self._round(amount)
        if amount <= 0:
            return
        from_user = str(from_user)
        to_user = str(to_user)
        self._ensure_user(from_user)
        self._ensure_user(to_user)
        self.users[from_user]['owes'][to_user] = self._round(
            self.users[from_user]['owes'].get(to_user, 0.0) + amount
        )
        self.users[to_user]['owed_by'][from_user] = self._round(
            self.users[to_user]['owed_by'].get(from_user, 0.0) + amount
        )

    def _decrease_debt(self, from_user, to_user, amount):
        amount = self._round(amount)
        if amount <= 0:
            return
        from_user = str(from_user)
        to_user = str(to_user)
        current = self._round(
            self.users.get(from_user, {}).get('owes', {}).get(to_user, 0.0)
        )
        remaining = self._round(current - amount)
        if remaining <= 0:
            self.users.get(from_user, {}).get('owes', {}).pop(to_user, None)
            self.users.get(to_user, {}).get('owed_by', {}).pop(from_user, None)
        else:
            self.users[from_user]['owes'][to_user] = remaining
            self.users[to_user]['owed_by'][from_user] = remaining

    def _add_iou(self, lender, borrower, amount):
        lender = str(lender)
        borrower = str(borrower)
        try:
            amount = self._round(abs(float(amount)))
        except Exception:
            amount = 0.0
        self._ensure_user(lender)
        self._ensure_user(borrower)
        if amount <= 0 or lender == borrower:
            return
        opposite = self._round(self.users[lender]['owes'].get(borrower, 0.0))
        if opposite > 0:
            cancel = min(opposite, amount)
            self._decrease_debt(lender, borrower, cancel)
            amount = self._round(amount - cancel)
        if amount > 0:
            self._increase_debt(borrower, lender, amount)

    def _user_object(self, name):
        name = str(name)
        data = self.users.get(name, {'owes': {}, 'owed_by': {}})
        owes = {}
        for other in sorted(data.get('owes', {})):
            amount = self._round(data['owes'][other])
            if amount > 0:
                owes[str(other)] = amount
        owed_by = {}
        for other in sorted(data.get('owed_by', {})):
            amount = self._round(data['owed_by'][other])
            if amount > 0:
                owed_by[str(other)] = amount
        balance = self._round(sum(owed_by.values()) - sum(owes.values()))
        return {'name': name, 'owes': owes, 'owed_by': owed_by, 'balance': balance}

    @staticmethod
    def _normalize_url(url):
        if url is None:
            return ''
        url = str(url).strip()
        if url.endswith('/') and url != '/':
            url = url.rstrip('/')
        return url

    @staticmethod
    def _parse_payload(payload):
        if payload is None:
            return None
        if isinstance(payload, (bytes, bytearray)):
            payload = payload.decode()
        if isinstance(payload, str):
            try:
                return json.loads(payload)
            except Exception:
                return payload
        return payload

    def _json(self, value):
        return json.dumps(value, separators=(',', ':'))

    def get(self, url, payload=None):
        url = self._normalize_url(url)
        if url == '/users':
            parsed = self._parse_payload(payload)
            if parsed is None:
                names = list(self.users.keys())
            elif isinstance(parsed, list):
                names = parsed
            elif isinstance(parsed, dict):
                if 'users' in parsed:
                    names = parsed['users']
                else:
                    names = list(self.users.keys())
            else:
                names = list(self.users.keys())
            if not isinstance(names, list):
                names = []
            names = [str(name) for name in names if str(name) in self.users]
            names.sort()
            return self._json({'users': [self._user_object(name) for name in names]})
        return self._json({})

    def post(self, url, payload=None):
        url = self._normalize_url(url)
        parsed = self._parse_payload(payload)
        if url == '/add':
            if isinstance(parsed, dict):
                name = parsed.get('user')
            elif isinstance(parsed, str):
                name = parsed
            else:
                name = None
            if name is None:
                return self._json({})
            name = str(name)
            self._ensure_user(name)
            return self._json(self._user_object(name))
        if url == '/iou':
            if isinstance(parsed, dict):
                lender = parsed.get('lender')
                borrower = parsed.get('borrower')
                amount = parsed.get('amount', 0)
            else:
                lender = None
                borrower = None
                amount = 0
            if lender is None or borrower is None:
                return self._json({'users': []})
            lender = str(lender)
            borrower = str(borrower)
            self._add_iou(lender, borrower, amount)
            names = sorted({lender, borrower})
            return self._json({'users': [self._user_object(name) for name in names]})
        return self._json({})
```

