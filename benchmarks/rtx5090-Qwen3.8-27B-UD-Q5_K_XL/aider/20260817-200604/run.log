I recall test file:
import { Palindromes } from './palindrome-products';

describe('Palindrome Products', () => {
  test('finds the smallest palindrome', () => {
    const result = Palindromes.generate({ min: 1, max: 9 });
    expect(result.smallest.value).toEqual(1);
    expect(result.smallest.factors).toEqual([[1, 1]]);
  });

  test('finds the largest palindrome', () => {
    const result = Palindromes.generate({ min: 1, max: 9 });
    expect(result.largest.value).toEqual(9);
    expect(result.largest.factors).toEqual([[1, 9], [3, 3]]);
  });

  test('can find the smallest palindrome', () => {
    const result = Palindromes.generate({ min: 10, max: 99 });
    expect(result.smallest.value).toEqual(121);
    expect(result.smallest.factors).toEqual([[11, 11]]);
  });

  test('can find the largest palindrome', () => {
    const result = Palindromes.generate({ min: 10, max: 99 });
    expect(result.largest.value).toEqual(9009);
    expect(result.largest.factors).toEqual([[91, 99]]);
  });

  test('works even if the smallest and largest palindrome have the same value', () => {
    const result = Palindromes.generate({ min: 100, max: 999 });
    expect(result.smallest.value).toEqual(1002001);
    expect(result.smallest.factors).toEqual([[1001, 1001]]); // Wait 1001 outside 999? Hmm no.
  });
});

