Pseudo:
```
export class TwoBucket {
  constructor(bucketOne, bucketTwo, goal, startBucket) {
    this.bucketOne = bucketOne;
    this.bucketTwo = bucketTwo;
    this.goal = goal;
    this.startBucket = startBucket;
  }

  solve() {
    const c1 = Number(this.bucketOne);
    const c2 = Number(this.bucketTwo);
    const goal = Number(this.goal);
    const start = String(this.startBucket).toLowerCase();

    if (!Number.isInteger(c1) || !Number.isInteger(c2) || !Number.isInteger(goal)) {
      throw new Error('No solution possible');
    }
    if (c1 < 0 || c2 < 0 || goal < 0) throw ...
    const normalizedStart = start === 'one' || start === 'bucket one' ? 'one' : start === 'two' || start === 'bucket two' ? 'two' : null;
    if (!normalizedStart) throw ...
    if (goal === 0) return { moves: 0, goalBucket: normalizedStart, otherBucket: 0 };
    if (goal > Math.max(c1, c2)) throw ...
    if (c1 === 0 || c2 === 0) throw ...
    const gcd = (a,b) => b === 0 ? a : gcd(b, a % b);
    if (goal % gcd(c1,c2) !== 0) throw ...

    const forbidden = (a,b) => normalizedStart === 'one' ? a === 0 && b === c2 : a === c1 && b === 0;
    const [sa, sb] = normalizedStart === 'one' ? [c1, 0] : [0, c2];
    if (forbidden(sa, sb)) throw ...
    const isGoal = (a,b) => a === goal || b === goal;
    if (isGoal(sa, sb)) {
      return { moves: 1, goalBucket: sa === goal ? 'one' : 'two', otherBucket: sa === goal ? sb : sa };
    }
    const visited = new Set([`${sa},${sb}`]);
    const queue = [[sa, sb, 1]];
    let head = 0;
    while (head < queue.length) {
      const [a,b,moves] = queue[head++];
      const next = [];
      // fill one
      next.push([c1,b]);
      next.push([a,c2]);
      next.push([0,b]);
      next.push([a,0]);
      const pour1 = Math.min(a, c2 - b);
      next.push([a - pour1, b + pour1]);
      const pour2 = Math.min(b, c1 - a);
      next.push([a + pour2, b - pour2]);
      for (const [na,nb] of next) {
        if (na === a && nb === b) continue;
        if (forbidden(na,nb)) continue;
        const key = `${na},${nb}`;
        if (visited.has(key)) continue;
        visited.add(key);
        const nm = moves + 1;
        if (na === goal || nb === goal) {
          if (na === goal) return { moves: nm, goalBucket: 'one', otherBucket: nb };
          return { moves: nm, goalBucket: 'two', otherBucket: na };
        }
        queue.push([na,nb,nm]);
      }
    }
    throw new Error('No solution possible');
  }
}
```

