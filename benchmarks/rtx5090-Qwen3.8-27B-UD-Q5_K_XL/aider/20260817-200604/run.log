const M = 26;

const gcd = (x, y) => {
  x = Math.abs(x);
  y = Math.abs(y);
  while (y) {
    [x, y] = [y, x % y];
  }
  return x;
};

const mod = (n, m) => ((n % m) + m) % m;

const modularInverse = (a) => {
  const aMod = mod(a, M);
  for (let x = 1; x < M; x += 1) {
    if ((aMod * x) % M === 1) return x;
  }
  return null;
};

const assertCoprime = (a) => {
  if (gcd(a, M) !== 1) {
    throw new Error('a and m must be coprime.');
  }
};

const group = (str) => {
  if (!str) return '';
  return str.match(/.{1,5}/g).join(' ');
};

export const encode = (phrase, key) => {
  assertCoprime(key);
  const normalized = String(phrase).toLowerCase();
  let out = '';
  for (const ch of normalized) {
    const code = ch.charCodeAt(0);
    if (code >= 48 && code <= 57) {
      out += ch;
    } else if (code >= 97 && code <= 122) {
      const i = code - 97;
      const encrypted = mod(key * i + ??? b, M);
    }
  }
  return group(out);
};
