class FoodChain {
    private static final String[] ANIMALS = {"fly", "spider", ...};
    private static final String[] REACTIONS = {"", "It wriggled...", ...};
    String verse(int verse) {
        StringBuilder sb = new StringBuilder();
        sb.append("I know an old lady who swallowed a ").append(ANIMALS[verse-1]).append(".\n");
        if (verse == 8) {
            sb.append("She's dead, of course!\n");
            return sb.toString();
        }
        if (verse > 1) sb.append(REACTIONS[verse-1]).append("\n");
        for (int i = verse - 1; i >= 1; i--) {
            sb.append("She swallowed the ").append(ANIMALS[i]).append(" to catch the ");
            if (i == 2) sb.append("spider that wriggled and jiggled and tickled inside her");
            else sb.append(ANIMALS[i-1]);
            sb.append(".\n");
        }
        sb.append("I don't know why she swallowed the fly. Perhaps she'll die.\n");
        return sb.toString();
    }
    String verses(int startVerse, int endVerse) {
        StringBuilder sb = new StringBuilder();
        for (int i = startVerse; i <= endVerse; i++) {
            sb.append(verse(i)).append("\n");
        }
        return sb.toString();
    }
}
