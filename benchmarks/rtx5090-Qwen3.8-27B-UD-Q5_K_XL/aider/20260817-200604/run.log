```
from collections import deque
from math import gcd


def measure(bucket_one, bucket_two, goal, start_bucket):
    if start_bucket not in ("one", "two"):
        raise ValueError("start_bucket must be 'one' or 'two'")

    if bucket_one < 0 or bucket_two < 0 or goal < 0:
        raise ValueError("bucket sizes and goal must be non-negative")

    if goal == 0:
        return (0, start_bucket, 0)

    if goal > max(bucket_one, bucket_two):
        raise ValueError("No solution possible")

    divisor = gcd(bucket_one, bucket_two)
    if divisor == 0 or goal % divisor != 0:
        raise ValueError("No solution possible")

    def is_forbidden(b1, b2):
        if start_bucket == "one":
            return b1 == 0 and b2 == bucket_two
        return b2 == 0 and b1 == bucket_one

    start_state = (0, 0)
    queue = deque([((0, 0), 0)])
    visited = {start_state}

    def add_state(next_state, current_state, next_moves):
        if next_state == current_state:
            return
        if is_forbidden(*next_state):
            return
        if next_state not in visited:
            visited.add(next_state)
            queue.append((next_state, next_moves))

    while queue:
        state, moves = queue.popleft()
        b1, b2 = state

        if b1 == goal and b2 == goal:
            return (moves, start_bucket, goal)
        if b1 == goal:
            return (moves, "one", b2)
        if b2 == goal:
            return (moves, "two", b1)

        next_moves = moves + 1

        if start_bucket == "one":
            # Fill bucket one.
            add_state((bucket_one, b2), state, next_moves)

            # Pour bucket one into bucket two.
            if b1 > 0 and b2 < bucket_two:
                pour = min(b1, bucket_two - b2)
                add_state((b1 - pour, b2 + pour), state, next_moves)

            # Empty bucket two.
            add_state((b1, 0), state, next_moves)

            # Fill bucket two.
            add_state((b1, bucket_two), state, next_moves)

            # Empty bucket one.
            add_state((0, b2), state, next_moves)

            # Pour bucket two into bucket one.
            if b2 > 0 and b1 < bucket_one:
                pour = min(b2, bucket_one - b1)
                add_state((b1 + pour, b2 - pour), state, next_moves)
        else:
            # Fill bucket two.
            add_state((b1, bucket_two), state, next_moves)

            # Pour bucket two into bucket one.
            if b2 > 0 and b1 < bucket_one:
                pour = min(b2, bucket_one - b1)
                add_state((b1 + pour, b2 - pour), state, next_moves)

            # Empty bucket one.
            add_state((0, b2), state, next_moves)

            # Fill bucket one.
            add_state((bucket_one, b2), state, next_moves)

            # Empty bucket two.
            add_state((b1, 0), state, next_moves)

            # Pour bucket one into bucket two.
            if b1 > 0 and b2 < bucket_two:
                pour = min(b1, bucket_two - b2)
                add_state((b1 - pour, b2 + pour), state, next_moves)

    raise ValueError("No solution possible")
```
