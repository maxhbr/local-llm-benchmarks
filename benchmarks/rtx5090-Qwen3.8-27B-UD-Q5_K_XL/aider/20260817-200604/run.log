```
def _invoke_callback(callback, value):
    try:
        sig = inspect.signature(callback)
    except (TypeError, ValueError):
        callback()
        return
    params = list(sig.parameters.values())
    has_var_positional = any(p.kind == inspect.Parameter.VAR_POSITIONAL for p in params)
    required_positional = [p for p in params if p.kind in (POSITIONAL_ONLY, POSITIONAL_OR_KEYWORD) and p.default is inspect.Parameter.empty]
    if not has_var_positional and len(required_positional) == 1:
        callback(value)
    else:
        callback()
```
