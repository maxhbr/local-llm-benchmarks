class InputCell:
    def __init__(self, initial_value):
        self._value = initial_value
        self._dependents = []

    @property
    def value(self):
        return self._value

    @value.setter
    def value(self, new_value):
        if new_value == self._value:
            return
        self._value = new_value
        self._propagate()

    def _propagate(self):
        # collect affected compute cells
        affected = []
        visited = set()
        stack = [self]
        while stack:
            cell = stack.pop()
            for dep in getattr(cell, '_dependents', []):
                if id(dep) not in visited:
                    visited.add(id(dep))
                    affected.append(dep)
                    stack.append(dep)
        # topological sort
        ...
        changed = {id(self)}
        changed_cells = []
