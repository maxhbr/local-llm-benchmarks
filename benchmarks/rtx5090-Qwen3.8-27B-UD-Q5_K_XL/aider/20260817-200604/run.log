import java.util.ArrayList;
import java.util.Collections;
import java.util.Comparator;
import java.util.List;

class PythagoreanTriplet {

    private final int a;
    private final int b;
    private final int c;

    PythagoreanTriplet(int a, int b, int c) {
        this.a = a;
        this.b = b;
        this.c = c;
    }

    static TripletListBuilder makeTripletsList() {
        return new TripletListBuilder();
    }

    @Override
    public boolean equals(Object obj) {
        if (this == obj) {
            return true;
        }
        if (!(obj instanceof PythagoreanTriplet)) {
            return false;
        }
        PythagoreanTriplet other = (PythagoreanTriplet) obj;
        return a == other.a && b == other.b && c == other.c;
    }

    @Override
    public int hashCode() {
        int result = a;
        result = 31 * result + b;
        result = 31 * result + c;
        return result;
    }

    @Override
    public String toString() {
        return "{" + a + ", " + b + ", " + c + "}";
    }

    static class TripletListBuilder {

        private int sum = 0;
        private int maxFactor = 0;
        private boolean hasMaxFactor = false;

        TripletListBuilder thatSumTo(int sum) {
            this.sum = sum;
            return this;
        }

        TripletListBuilder withFactorsLessThanOrEqualTo(int maxFactor) {
            this.maxFactor = maxFactor;
            this.hasMaxFactor = true;
            return this;
        }

        List<PythagoreanTriplet> build() {
            List<PythagoreanTriplet> triplets = new ArrayList<PythagoreanTriplet>();

            if (sum > 0) {
                generateForSum(sum, triplets);
            } else if (hasMaxFactor && maxFactor > 0) {
                generateUpTo(maxFactor, triplets);
            }

            Collections.sort(triplets, new Comparator<PythagoreanTriplet>() {
                @Override
                public int compare(PythagoreanTriplet left, PythagoreanTriplet right) {
                    if (left.a != right.a) {
                        return Integer.compare(left.a, right.a);
                    }
                    if (left.b != right.b) {
                        return Integer.compare(left.b, right.b);
                    }
                    return Integer.compare(left.c, right.c);
                }
            });

            return triplets;
        }

        private void generateForSum(int sum, List<PythagoreanTriplet> result) {
            long target = sum;

            for (long m = 2; 2L * m * (m + 1) <= target; m++) {
                long twoM = 2L * m;
                if (target % twoM != 0) {
                    continue;
                }

                long quotient = target / twoM;

                for (long n = 1; n < m; n++) {
                    long mPlusN = m + n;
                    if (mPlusN > quotient) {
                        break;
                    }
                    if (quotient % mPlusN != 0) {
                        continue;
                    }
                    if (((m - n) & 1L) == 0L) {
                        continue;
                    }
                    if (gcd(m, n) != 1L) {
                        continue;
                    }

                    long k = quotient / mPlusN;
                    long x = m * m - n * n;
                    long y = 2L * m * n;
                    long c = k * (m * m + n * n);

                    long a = k * Math.min(x, y);
                    long b = k * Math.max(x, y);

                    if (a < b && b < c && a + b + c == target) {
                        if (!hasMaxFactor || c <= maxFactor) {
                            if (a <= Integer.MAX_VALUE && b <= Integer.MAX_VALUE && c <= Integer.MAX_VALUE) {
                                result.add(new PythagoreanTriplet((int) a, (int) b, (int) c));
                            }
                        }
                    }
                }
            }
        }

        private void generateUpTo(int maxFactor, List<PythagoreanTriplet> result) {
            long limit = maxFactor;

            for (long m = 2; m * m + 1L <= limit; m++) {
                for (long n = 1; n < m; n++) {
                    if (((m - n) & 1L) == 0L) {
                        continue;
                    }
                    if (gcd(m, n) != 1L) {
                        continue;
                    }

                    long c0 = m * m + n * n;
                    if (c0 > limit) {
                        break;
                    }

                    long x = m * m - n * n;
                    long y = 2L * m * n;
                    long a0 = Math.min(x, y);
                    long b0 = Math.max(x, y);

                    for (long k = 1; k * c0 <= limit; k++) {
                        long a = k * a0;
                        long b = k * b0;
                        long c = k * c0;

                        if (a < b && b < c) {
                            if (a <= Integer.MAX_VALUE && b <= Integer.MAX_VALUE && c <= Integer.MAX_VALUE) {
                                result.add(new PythagoreanTriplet((int) a, (int) b, (int) c));
                            }
                        }
                    }
                }
            }
        }

        private static long gcd(long a, long b) {
            while (b != 0L) {
                long temp = a % b;
                a = b;
                b = temp;
            }
            return a;
        }
    }
}
