Applied edit to two-bucket.js
response:
The failing tests expect impossible inputs to throw when the `TwoBucket` instance is created, not only when `solve()` is called. I updated the constructor to compute and cache the solution immediately, so invalid/unreachable cases throw during construction.

two-bucket.js
```
export class TwoBucket {
  constructor(bucketOne, bucketTwo, goal, startBucket) {
    this.bucketOne = bucketOne;
    this.bucketTwo = bucketTwo;
    this.goal = goal;
    this.startBucket = startBucket;
    this.solution = this.solve();
  }

  solve() {
    if (this.solution) {
      return this.solution;
    }

    const c1 = Number(this.bucketOne);
    const c2 = Number(this.bucketTwo);
    const goal = Number(this.goal);

    let start = String(this.startBucket).toLowerCase();
    if (start === 'one' || start === 'bucket one') {
      start = 'one';
    } else if (start === 'two' || start === 'bucket two') {
      start = 'two';
    } else {
      throw new Error('No solution possible');
    }

    if (![c1, c2, goal].every(Number.isFinite)) {
      throw new Error('No solution possible');
    }

    if (c1 < 0 || c2 < 0 || goal < 0) {
      throw new Error('No solution possible');
    }

    if (goal === 0) {
      const result = { moves: 0, goalBucket: start, otherBucket: 0 };
      this.solution = result;
      return result;
    }

    if (goal > Math.max(c1, c2)) {
      throw new Error('No solution possible');
    }

    if (Number.isInteger(c1) && Number.isInteger(c2) && Number.isInteger(goal)) {
      const gcd = (a, b) => {
        a = Math.abs(a);
        b = Math.abs(b);
        while (b !== 0) {
          [a, b] = [b, a % b];
        }
        return a;
      };

      const g = gcd(c1, c2);
      if (g === 0 || goal % g !== 0) {
        throw new Error('No solution possible');
      }
    }

    const isForbidden = (a, b) => {
      if (start === 'one') {
        return a === 0 && b === c2;
      }
      return a === c1 && b === 0;
    };

    const [startA, startB] = start === 'one' ? [c1, 0] : [0, c2];

    if (isForbidden(startA, startB)) {
      throw new Error('No solution possible');
    }

    const resultFor = (a, b, moves) => {
      if (a === goal) {
        return { moves, goalBucket: 'one', otherBucket: b };
      }
      if (b === goal) {
        return { moves, goalBucket: 'two', otherBucket: a };
      }
      return null;
    };

    const firstResult = resultFor(startA, startB, 1);
    if (firstResult) {
      this.solution = firstResult;
      return firstResult;
    }

    const visited = new Set([`${startA},${startB}`]);
    const queue = [[startA, startB, 1]];
    let head = 0;

    while (head < queue.length) {
      const [a, b, moves] = queue[head];
      head += 1;

      const pourIntoTwo = Math.min(a, c2 - b);
      const pourIntoOne = Math.min(b, c1 - a);

      const nextStates = [
        [c1, b],
        [a, c2],
        [0, b],
        [a, 0],
        [a - pourIntoTwo, b + pourIntoTwo],
        [a + pourIntoOne, b - pourIntoOne],
      ];

      for (const [nextA, nextB] of nextStates) {
        if (nextA === a && nextB === b) {
          continue;
        }

        if (isForbidden(nextA, nextB)) {
          continue;
        }

        const key = `${nextA},${nextB}`;
        if (visited.has(key)) {
          continue;
        }

        visited.add(key);
        const nextMoves = moves + 1;
        const result = resultFor(nextA, nextB, nextMoves);
        if (result) {
          this.solution = result;
          return result;
        }

        queue.push([nextA, nextB, nextMoves]);
      }
    }

    throw new Error('No solution possible');
  }
}
```
