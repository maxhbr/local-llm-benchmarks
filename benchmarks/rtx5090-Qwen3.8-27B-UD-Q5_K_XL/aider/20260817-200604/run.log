const minMaxCache = new Map();
const getMinMax = (index, mask) => {
  const key = (index << 10) | mask;
  if (minMaxCache.has(key)) return minMaxCache.get(key);
  const k = n - index;
  if (k === 0) { minMaxCache.set(key, [0n,0n]); return [0n,0n]; }
  const digits = [];
  let hasZero = false;
  for (let d=0; d<10; d++) if (!(mask & (1<<d))) { digits.push(d); if (d===0) hasZero=true; }
  if (hasZero && suffixLeadingCount[index] > digits.length - 1) { minMaxCache.set(key, null); return null; }
  // DP
  minMaxCache.set(key, [min,max]); return [min,max];
};
```
