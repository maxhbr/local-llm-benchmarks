package piglatin

import (
    "strings"
    "unicode"
)

func Sentence(sentence string) string {
    words := strings.Split(sentence, " ")
    for i, w := range words {
        words[i] = translate(w)
    }
    return strings.Join(words, " ")
}

func translate(word string) string {
    runes := []rune(word)
    if len(runes) == 0 {
        return ""
    }

    lower := strings.ToLower(word)
    if isVowel(unicode.ToLower(runes[0])) || strings.HasPrefix(lower, "xr") || strings.HasPrefix(lower, "yt") {
        return word + "ay"
    }

    i := 0
    for i < len(runes) {
        c := unicode.ToLower(runes[i])
        if isVowel(c) {
            break
        }
