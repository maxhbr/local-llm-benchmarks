def _add_debt(owes_from, owes_to, amount): # from owes to
    # cancel opposite: to owes from
    opposite = users[to].owes.get(from, 0)
    if opposite:
        cancel = min(opposite, amount)
        # remove cancel from to.owes[from] and from.owed_by[to]
        users[to].owes[from] -= cancel
        if zero delete
        users[from].owed_by[to] -= cancel
        if zero delete
        amount -= cancel
    if amount > 0:
        users[from].owes[to] = users[from].owes.get(to,0)+amount
        users[to].owed_by[from] = users[to].owed_by.get(from,0)+amount
```
