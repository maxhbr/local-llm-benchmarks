#[derive(Debug, PartialEq, Eq)]
pub enum Error {
    IncompleteNumber,
}

pub fn to_bytes(values: &[u32]) -> Vec<u8> {
    let mut bytes = Vec::new();
    for &value in values {
        if value == 0 {
            bytes.push(0);
            continue;
        }
        let bit_length = 32 - value.leading_zeros();
        let groups = (bit_length + 6) / 7;
        for group_index in (0..groups).rev() {
            let mut byte = ((value >> (group_index * 7)) & 0x7F) as u8;
            if group_index > 0 {
                byte |= 0x80;
            }
            bytes.push(byte);
        }
    }
    bytes
}

pub fn from_bytes(bytes: &[u8]) -> Result<Vec<u32>, Error> {
    let mut numbers = Vec::new();
    let mut value: u32 = 0;
    let mut in_number = false;

    for &byte in bytes {
        let part = (byte & 0x7F) as u32;
        // If we already have 32 bits? Need avoid shift overflow.
        // Since big-endian, if value has high bits and shift left 7 may overflow. Use checked_shl.
        let shifted = value.checked_shl(7).ok_or(Error::IncompleteNumber)?;
        value = shifted | part;
        in_number = true;

        if byte & 0x80 == 0 {
            numbers.push(value);
            value = 0;
            in_number = false;
        }
    }

    if in_number {
        Err(Error::IncompleteNumber)
    } else {
        Ok(numbers)
    }
}

