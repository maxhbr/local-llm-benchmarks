    const worker = new Worker(WORKER_CODE, { eval: true });
    worker.on('message', (counts) => {
      for (const [letter, count] of Object.entries(counts)) frequencies[letter] = (frequencies[letter] || 0) + count;
      next();
    });
    worker.on('error', (err) => { throw err; });
    return worker;
  };
  const next = () => {
    const text = queue.shift();
    if (text === undefined) { worker.terminate(); return; }
    worker.postMessage(text);
  };
  await new Promise((resolve, reject) => { ... });
};
