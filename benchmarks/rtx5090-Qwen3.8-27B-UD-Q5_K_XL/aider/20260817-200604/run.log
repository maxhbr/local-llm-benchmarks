package twobucket

import "errors"

type bucketState struct {
	one   int
	two   int
	steps int
}

func Solve(sizeBucketOne, sizeBucketTwo, goalAmount int, startBucket string) (goalBucket string, numSteps, otherBucketLevel int, e error) {
	if sizeBucketOne <= 0 || sizeBucketTwo <= 0 || goalAmount <= 0 {
		return "", 0, 0, errors.New("invalid bucket sizes or goal amount")
	}
	if startBucket != "one" && startBucket != "two" {
		return "", 0, 0, errors.New("invalid start bucket")
	}
	if goalAmount > sizeBucketOne && goalAmount > sizeBucketTwo {
		return "", 0, 0, errors.New("goal amount is larger than both buckets")
	}
	if goalAmount%gcd(sizeBucketOne, sizeBucketTwo) != 0 {
		return "", 0, 0, errors.New("no solution")
	}

	startOne := startBucket == "one"

	forbidden := func(one, two int) bool {
		if startOne {
			return one == 0 && two == sizeBucketTwo
		}
		return one == sizeBucketOne && two == 0
	}

	var start bucketState
	if startOne {
		start = bucketState{one: sizeBucketOne, two: 0, steps: 1}
	} else {
		start = bucketState{one: 0, two: sizeBucketTwo, steps: 1}
	}

	if start.one == goalAmount {
		return "one", start.steps, start.two, nil
	}
	if start.two == goalAmount {
		return "two", start.steps, start.one, nil
	}

	type visitedKey struct {
		one int
		two int
	}

	visited := make(map[visitedKey]struct{})
	visited[visitedKey{one: start.one, two: start.two}] = struct{}{}
	queue := []bucketState{start}

	for i := 0; i < len(queue); i++ {
		cur := queue[i]
		nextSteps := cur.steps + 1

		var candidates [6]bucketState
		n := 0

		if cur.one != sizeBucketOne {
			candidates[n] = bucketState{one: sizeBucketOne, two: cur.two, steps: nextSteps}
			n++
		}
		if cur.two != sizeBucketTwo {
			candidates[n] = bucketState{one: cur.one, two: sizeBucketTwo, steps: nextSteps}
			n++
		}
		if cur.one != 0 {
			candidates[n] = bucketState{one: 0, two: cur.two, steps: nextSteps}
			n++
		}
		if cur.two != 0 {
			candidates[n] = bucketState{one: cur.one, two: 0, steps: nextSteps}
			n++
		}
		if cur.one > 0 && cur.two < sizeBucketTwo {
			pour := cur.one
			space := sizeBucketTwo - cur.two
			if pour > space {
				pour = space
			}
			candidates[n] = bucketState{one: cur.one - pour, two: cur.two + pour, steps: nextSteps}
			n++
		}
		if cur.two > 0 && cur.one < sizeBucketOne {
			pour := cur.two
			space := sizeBucketOne - cur.one
			if pour > space {
				pour = space
			}
			candidates[n] = bucketState{one: cur.one + pour, two: cur.two - pour, steps: nextSteps}
			n++
		}

		for j := 0; j < n; j++ {
			next := candidates[j]

			if forbidden(next.one, next.two) {
				continue
			}

			key := visitedKey{one: next.one, two: next.two}
			if _, ok := visited[key]; ok {
				continue
			}
			visited[key] = struct{}{}

			if next.one == goalAmount {
				return "one", next.steps, next.two, nil
			}
			if next.two == goalAmount {
				return "two", next.steps, next.one, nil
			}

			queue = append(queue, next)
		}
	}

	return "", 0, 0, errors.New("no solution")
}

func gcd(a, b int) int {
	for b != 0 {
		a, b = b, a%b
	}
	return a
}
