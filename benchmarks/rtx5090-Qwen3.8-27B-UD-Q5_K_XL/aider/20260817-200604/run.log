Pseudo:
export const solve = (puzzle) => {
  const normalized = puzzle.replace(/\s*==\s*/g, ' = ');
  const [left, right] = normalized.split('=');
  if (!left || right === undefined) return null;
  const addends = left.split('+').map(s => s.trim()).filter(Boolean);
  const result = right.trim();
  if (addends.length === 0 || !result) return null;

  const allWords = [...addends, result];
  const letters = [...new Set(allWords.join(''))];
  if (letters.length > 10) return null;

  const leading = new Set();
  for (const word of allWords) {
    if (word.length > 1) leading.add(word[0]);
  }

  const maxLen = Math.max(...allWords.map(w => w.length));
  const columns = [];
  for (let col = 0; col < maxLen; col++) {
    const addChars = [];
    for (const word of addends) {
      if (word.length > col) {
        addChars.push(word[word.length - 1 - col]);
      }
    }
    const resChar = result.length > col ? result[result.length - 1 - col] : null;
    columns.push({ addChars, resChar });
  }

  const value = {}; // letter -> digit
  const used = new Array(10).fill(false);

  const isAssigned = (ch) => Object.prototype.hasOwnProperty.call(value, ch);
  const assign = (ch, d) => { value[ch] = d; used[d] = true; };
  const unassign = (ch) => { used[value[ch]] = false; delete value[ch]; };

  const canAssign = (ch, d) => !used[d] && (!leading.has(ch) || d !== 0);

  const solveColumn = (col, carry) => {
    if (col === maxLen) return carry === 0;
    const { addChars, resChar } = columns[col];

    const assignAddends = (idx, sum) => {
      if (idx === addChars.length) {
        const total = sum + carry;
        if (resChar === null) {
          // No result digit in this column. The column must contribute nothing.
          return total === 0 && solveColumn(col + 1, 0);
        }
        const digit = total % 10;
        const nextCarry = Math.floor(total / 10);
        if (Object.prototype.hasOwnProperty.call(value, resChar)) {
          if (value[resChar] !== digit) return false;
          return solveColumn(col + 1, nextCarry);
        }
        if (!canAssign(resChar, digit)) return false;
        assign(resChar, digit);
        if (solveColumn(col + 1, nextCarry)) return true;
        unassign(resChar);
        return false;
      }

      const ch = addChars[idx];
      if (Object.prototype.hasOwnProperty.call(value, ch)) {
        return assignAddends(idx + 1, sum + value[ch]);
      }

      for (let d = 0; d <= 9; d++) {
        if (!canAssign(ch, d)) continue;
        assign(ch, d);
        if (assignAddends(idx + 1, sum + d)) return true;
        unassign(ch);
      }
      return false;
    };

    return assignAddends(0, 0);
  };

  return solveColumn(0, 0) ? { ...value } : null;
};

