#include "spiral_matrix.h"
#include <vector>

namespace spiral_matrix {
    std::vector<std::vector<int>> spiral_matrix(int size) {
        if (size <= 0) return {};
        std::vector<std::vector<int>> matrix(size, std::vector<int>(size, 0));
        int row = 0, col = 0;
        int const dr[4] = {0, 1, 0, -1};
        int const dc[4] = {1, 0, -1, 0};
        int dir = 0;
        int value = 1;
        int total = size * size;
        for (int i = 0; i < total; ++i) {
            matrix[row][col] = value++;
            int next_row = row + dr[dir];
            int next_col = col + dc[dir];
            if (next_row < 0 || next_row >= size || next_col < 0 || next_col >= size || matrix[next_row][next_col] != 0) {
                dir = (dir + 1) % 4;
                next_row = row + dr[dir];
                next_col = col + dc[dir];
            }
            row = next_row;
            col = next_col;
        }
        return matrix;
    }
}
```
