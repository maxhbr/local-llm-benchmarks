private SgfNode toSgfNode(ParsedNode node) {
    List<SgfNode> children = new ArrayList<>();
    for (ParsedNode child : node.children) children.add(toSgfNode(child));
    Map<String, List<String>> props = new HashMap<>();
    for (Map.Entry<String, List<String>> e : node.properties.entrySet()) {
        props.put(e.getKey(), new ArrayList<>(e.getValue()));
    }
    return new SgfNode(props, children);
}
```
