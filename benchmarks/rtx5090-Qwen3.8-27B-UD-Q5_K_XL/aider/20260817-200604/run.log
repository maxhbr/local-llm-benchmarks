Full code:
```
use std::fmt;

#[derive(Debug)]
pub enum Error {
    InvalidTonic,
    InvalidInterval,
}

impl fmt::Display for Error {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        match self {
            Error::InvalidTonic => write!(f, "invalid tonic"),
            Error::InvalidInterval => write!(f, "invalid interval"),
        }
    }
}

impl std::error::Error for Error {}

#[derive(Debug)]
pub struct Scale {
    tonic_pc: u8,
    intervals: Vec<u8>,
    use_flats: bool,
}

const SHARP_NOTES: [&str; 12] = [
    "C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B",
];
const FLAT_NOTES: [&str; 12] = [
    "C", "Db", "D", "Eb", "E", "F", "Gb", "G", "Ab", "A", "Bb", "B",
];

#[derive(Debug)]
struct Tonic {
    pc: u8,
    note: String,
    lower: bool,
}

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
enum ScaleType {
    Major,
    Minor,
    Unknown,
}

impl Scale {
    pub fn new(tonic: &str, intervals: &str) -> Result<Scale, Error> {
        let tonic = parse_tonic(tonic).ok_or(Error::InvalidTonic)?;
        let intervals = parse_intervals(intervals).ok_or(Error::InvalidInterval)?;
        let pcs = pitch_classes(tonic.pc, &intervals);
        let use_flats = choose_use_flats(&tonic, &intervals, &pcs);
        Ok(Scale {
            tonic_pc: tonic.pc,
            intervals,
            use_flats,
        })
    }

    pub fn chromatic(tonic: &str) -> Result<Scale, Error> {
        let tonic = parse_tonic(tonic).ok_or(Error::InvalidTonic)?;
        let intervals = vec![1; 11];
        let pcs = pitch_classes(tonic.pc, &intervals);
        let use_flats = choose_use_flats(&tonic, &intervals, &pcs);
        Ok(Scale {
            tonic_pc: tonic.pc,
            intervals,
            use_flats,
        })
    }

    pub fn enumerate(&self) -> Vec<String> {
        let mut pc = self.tonic_pc;
        let mut notes = Vec::with_capacity(self.intervals.len() + 1);
        notes.push(note_name(pc, self.use_flats).to_string());
        for step in &self.intervals {
            pc = (pc + step) % 12;
            notes.push(note_name(pc, self.use_flats).to_string());
        }
        notes
    }
}

fn parse_tonic(tonic: &str) -> Option<Tonic> {
    let mut chars = tonic.chars();
    let letter = chars.next()?;
    if !letter.is_ascii_alphabetic() {
        return None;
    }

    let lower = letter.is_ascii_lowercase();
    let letter = letter.to_ascii_uppercase();
    let base = match letter {
        'C' => 0,
        'D' => 2,
        'E' => 4,
        'F' => 5,
        'G' => 7,
        'A' => 9,
        'B' => 11,
        _ => return None,
    };

    let mut pc = base;
    let mut note = String::new();
    note.push(letter);

    if let Some(accidental) = chars.next() {
        match accidental {
            '#' => {
                pc = (pc + 1) % 12;
                note.push('#');
            }
            'b' => {
                pc = (pc + 11) % 12;
                note.push('b');
            }
            _ => return None,
        }
    }

    if chars.next().is_some() {
        return None;
    }

    Some(Tonic { pc, note, lower })
}

fn parse_intervals(intervals: &str) -> Option<Vec<u8>> {
    let mut steps = Vec::new();
    for ch in intervals.chars() {
        let step = match ch {
            'm' => 1,
            'M' => 2,
            'A' => 3,
            _ => return None,
        };
        steps.push(step);
    }
    Some(steps)
}

fn pitch_classes(start: u8, intervals: &[u8]) -> Vec<u8> {
    let mut pc = start;
    let mut pcs = Vec::with_capacity(intervals.len() + 1);
    pcs.push(pc);
    for step in intervals {
        pc = (pc + step) % 12;
        pcs.push(pc);
    }
    pcs
}

fn choose_use_flats(tonic: &Tonic, intervals: &[u8], pcs: &[u8]) -> bool {
    match infer_scale_type(intervals, tonic.lower) {
        ScaleType::Major => major_use_flats(&tonic.note),
        ScaleType::Minor => minor_use_flats(&tonic.note),
        ScaleType::Unknown => {
            let sharp_count = count_accidentals(pcs, false);
            let flat_count = count_accidentals(pcs, true);
            if flat_count < sharp_count {
                true
            } else if sharp_count < flat_count {
                false
            } else if tonic.lower {
                minor_use_flats(&tonic.note)
            } else {
                major_use_flats(&tonic.note)
            }
        }
    }
}

fn infer_scale_type(intervals: &[u8], lower_tonic: bool) -> ScaleType {
    if intervals.len() >= 2 {
        match (intervals[0], intervals[1]) {
            (2, 2) => return ScaleType::Major,
            (2, 1) => return ScaleType::Minor,
            _ => {}
        }
    }
    if lower_tonic {
        ScaleType::Minor
    } else {
        ScaleType::Unknown
    }
}

fn major_use_flats(note: &str) -> bool {
    matches!(note, "F" | "Bb" | "Eb" | "Ab" | "Db" | "Gb")
}

fn minor_use_flats(note: &str) -> bool {
    matches!(note, "D" | "G" | "C" | "F" | "Bb" | "Eb")
}

fn count_accidentals(pcs: &[u8], use_flats: bool) -> usize {
    pcs.iter()
        .filter(|&&pc| {
            let name = if use_flats {
                FLAT_NOTES[pc as usize]
            } else {
                SHARP_NOTES[pc as usize]
            };
            name.len() > 1
        })
        .count()
}

fn note_name(pc: u8, use_flats: bool) -> &'static str {
    if use_flats {
        FLAT_NOTES[pc as usize]
    } else {
        SHARP_NOTES[pc as usize]
    }
}
```

