`_add_iou`:
```
def _add_iou(self, lender, borrower, amount):
    lender = str(lender); borrower = str(borrower)
    amount = self._round(abs(float(amount)))
    self._ensure_user(lender); self._ensure_user(borrower)
    if amount <= 0 or lender == borrower:
        return
    opposite = self._round(self.users[lender]['owes'].get(borrower, 0.0))
    if opposite > 0:
        cancel = min(opposite, amount)
        self._decrease_debt(lender, borrower, cancel)
        amount = self._round(amount - cancel)
    if amount > 0:
        self._increase_debt(borrower, lender, amount)
```
