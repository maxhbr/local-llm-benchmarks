        Map<Character, Integer> inorderIndex = new HashMap<>();
        for (int i = 0; i < size; i++) {
            Character value = inorderInput.get(i);
            if (inorderIndex.put(value, i) != null) {
                throw new IllegalArgumentException("Inorder traversal contains duplicate values.");
            }
        }

        Set<Character> seen = new HashSet<>();
        for (Character value : preorderInput) {
            if (!seen.add(value)) {
                throw new IllegalArgumentException("Preorder traversal contains duplicate values.");
            }
        }

        return build(preorderInput, inorderIndex, 0, size, 0, size);
