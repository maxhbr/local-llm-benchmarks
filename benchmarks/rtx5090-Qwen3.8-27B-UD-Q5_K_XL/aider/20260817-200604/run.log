fn encode_chunk(n: u32) -> String {
    let mut result = String::new();
    if n >= 100 {
        result.push_str(ones((n / 100) as usize));
        result.push_str(" hundred");
        n %= 100;
    }
    if n > 0 {
        if !result.is_empty() { result.push(' '); }
        result.push_str(&encode_below_hundred(n));
    }
    result
}

fn encode_below_hundred(n: u32) -> String {
    if n < 20 { return ones(n as usize).to_string(); }
    let tens = n / 10;
    let ones_digit = n % 10;
    let tens_word = match tens { 2=>"twenty",...};
    if ones_digit == 0 { tens_word.to_string() } else { format!("{}-{}", tens_word, ones(ones_digit as usize)) }
}

fn ones(n: usize) -> &'static str { match n {0=>"zero",1=>"one",...}}

