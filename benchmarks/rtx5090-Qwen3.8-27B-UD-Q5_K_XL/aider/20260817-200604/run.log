```
def answer(question):
    q = question.strip().lower()
    if not q.startswith("what is "):
        raise ValueError("syntax error")
    expr = q[len("what is "):].rstrip("?").strip()
    expr = ' '.join(expr.split())
    if not expr:
        raise ValueError("syntax error")
    expr = expr.replace("multiplied by", "multiplied_by").replace("divided by", "divided_by")
    tokens = expr.split()
    ops = {"plus": "+", "minus": "-", "multiplied_by": "*", "divided_by": "/"}

    def to_int(token):
        try:
            return int(token)
        except ValueError:
            return None

    value = to_int(tokens[0])
    if value is None:
        # If it's a known operator in first position, syntax; otherwise unknown? Need choose.
        if tokens[0] in ops:
            raise ValueError("syntax error")
        # Could be unknown operation? But first token should be number. For "What is 52 cubed" first token number. For "What is cubed" maybe unknown? Hmm.
        raise ValueError("syntax error")

    i = 1
    while i < len(tokens):
        op = tokens[i]
        if op not in ops:
            if to_int(op) is not None:
                raise ValueError("syntax error")
            raise ValueError("unknown operation")
        i += 1
        if i >= len(tokens):
            raise ValueError("syntax error")
        num = to_int(tokens[i])
        if num is None:
            if tokens[i] in ops:
                raise ValueError("syntax error")
            # If unknown word where number expected: unknown operation? Let's decide.
            raise ValueError("unknown operation")
        if ops[op] == "+": value += num
        elif ops[op] == "-": value -= num
        elif ops[op] == "*": value *= num
        else:
            if num == 0:
                raise ValueError("syntax error")
            # exact? use //
            value //= num
        i += 1
    return value
```

