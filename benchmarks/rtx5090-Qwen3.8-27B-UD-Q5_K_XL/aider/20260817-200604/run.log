```
export const tournamentTally = (input) => {
  const header = 'Team'.padEnd(30) + ' | MP |  W |  D |  L |  P';
  const teams = new Map();

  const getTeam = (name) => {
    if (!teams.has(name)) {
      teams.set(name, { name, mp: 0, w: 0, d: 0, l: 0, p: 0 });
    }
    return teams.get(name);
  };

  if (input) {
    for (const line of input.split('\n')) {
      const trimmedLine = line.trim();
      if (!trimmedLine) continue;

      const [home, away, result] = trimmedLine.split(';').map((part) => part.trim());
      if (!home || !away || !result) continue;

      const outcome = result.toLowerCase();
      if (outcome !== 'win' && outcome !== 'loss' && outcome !== 'draw') continue;

      const homeTeam = getTeam(home);
      const awayTeam = getTeam(away);

      homeTeam.mp += 1;
      awayTeam.mp += 1;

      if (outcome === 'win') {
        homeTeam.w += 1;
        homeTeam.p += 3;
        awayTeam.l += 1;
      } else if (outcome === 'loss') {
        homeTeam.l += 1;
        awayTeam.w += 1;
        awayTeam.p += 3;
      } else {
        homeTeam.d += 1;
        awayTeam.d += 1;
        homeTeam.p += 1;
        awayTeam.p += 1;
      }
    }
  }

  const sortedTeams = Array.from(teams.values()).sort((a, b) => {
    if (a.p !== b.p) return b.p - a.p;
    if (a.name < b.name) return -1;
    if (a.name > b.name) return 1;
    return 0;
  });

  const rows = sortedTeams.map((team) =>
    [
      team.name.padEnd(30),
      String(team.mp).padStart(2),
      String(team.w).padStart(2),
      String(team.d).padStart(2),
      String(team.l).padStart(2),
      String(team.p).padStart(2),
    ].join(' | ')
  );

  return [header, ...rows].join('\n');
};
```

