phone_number.cpp:
#include "phone_number.h"
#include <stdexcept>
namespace phone_number {
phone_number::phone_number(const std::string& number) {
    std::string digits;
    for (char c : number) if (isdigit(c)) digits += c;
    if (digits.size() == 11) {
        if (digits[0] != '1') throw std::domain_error("...");
        digits = digits.substr(1);
    }
    if (digits.size() != 10) throw std::domain_error("...");
    if (digits[0] < '2') throw std::domain_error("...");
    if (digits[3] < '2') throw std::domain_error("...");
    _number = digits;
}
std::string phone_number::number() const { return _number; }
std::string phone_number::area_code() const { return _number.substr(0,3); }
std::string phone_number::pretty() const { return "(" + _number.substr(0,3) + ") " + _number.substr(3,3) + "-" + _number.substr(6); }
}

