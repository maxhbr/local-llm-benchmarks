//
// This is only a SKELETON file for the 'Promises' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

const settle = (value, onFulfilled, onRejected) => {
  if (value && typeof value.then === 'function') {
    value.then(onFulfilled, onRejected);
  } else {
    onFulfilled(value);
  }
};

const createAllRejectedError = (errors) => {
  if (typeof AggregateError !== 'undefined') {
    return new AggregateError(errors, 'All promises were rejected');
  }

  return new Error('All promises were rejected');
};

export const promisify = (fn) => {
  return (...args) => {
    return new Promise((resolve, reject) => {
      const callback = (error, ...values) => {
        if (error) {
          reject(error);
        } else if (values.length <= 1) {
          resolve(values[0]);
        } else {
          resolve(values);
        }
      };

      args.push(callback);
      fn.apply(this, args);
    });
  };
};

export const all = (promises) => {
  const items = Array.from(promises);

  return new Promise((resolve, reject) => {
    if (items.length === 0) {
      resolve([]);
      return;
    }

    const results = new Array(items.length);
    let remaining = items.length;
    let settled = false;

    items.forEach((item, index) => {
      settle(
        item,
        (value) => {
          if (settled) {
            return;
          }

          results[index] = value;
          remaining -= 1;

          if (remaining === 0) {
            settled = true;
            resolve(results);
          }
        },
        (reason) => {
          if (settled) {
            return;
          }

          settled = true;
          reject(reason);
        }
      );
    });
  });
};

export const allSettled = (promises) => {
  const items = Array.from(promises);

  return new Promise((resolve) => {
    if (items.length === 0) {
      resolve([]);
      return;
    }

    const results = new Array(items.length);
    const settled = new Array(items.length).fill(false);
    let remaining = items.length;

    items.forEach((item, index) => {
      settle(
        item,
        (value) => {
          if (settled[index]) {
            return;
          }

          settled[index] = true;
          results[index] = { status: 'fulfilled', value };
          remaining -= 1;

          if (remaining === 0) {
            resolve(results);
          }
        },
        (reason) => {
          if (settled[index]) {
            return;
          }

          settled[index] = true;
          results[index] = { status: 'rejected', reason };
          remaining -= 1;

          if (remaining === 0) {
            resolve(results);
          }
        }
      );
    });
  });
};

export const race = (promises) => {
  const items = Array.from(promises);

  return new Promise((resolve, reject) => {
    let settled = false;

    items.forEach((item) => {
      settle(
        item,
        (value) => {
          if (settled) {
            return;
          }

          settled = true;
          resolve(value);
        },
        (reason) => {
          if (settled) {
            return;
          }

          settled = true;
          reject(reason);
        }
      );
    });
  });
};

export const any = (promises) => {
  const items = Array.from(promises);

  return new Promise((resolve, reject) => {
    if (items.length === 0) {
      reject(createAllRejectedError([]));
      return;
    }

    const errors = [];
    let remaining = items.length;
    let settled = false;

    items.forEach((item) => {
      settle(
        item,
        (value) => {
          if (settled) {
            return;
          }

          settled = true;
          resolve(value);
        },
        (reason) => {
          if (settled) {
            return;
          }

          errors.push(reason);
          remaining -= 1;

          if (remaining === 0) {
            settled = true;
            reject(createAllRejectedError(errors));
          }
        }
      );
    });
  });
};
```

