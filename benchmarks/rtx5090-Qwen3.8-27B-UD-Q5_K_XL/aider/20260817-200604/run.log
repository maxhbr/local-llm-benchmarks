#[derive(Debug)]
pub struct Error;

#[derive(Debug, Clone)]
pub struct Scale {
    tonic_pc: u8,
    intervals: Vec<u8>,
    use_flats: bool,
}

const SHARP_NOTES: [&str; 12] = ["C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"];
const FLAT_NOTES: [&str; 12] = ["C", "Db", "D", "Eb", "E", "F", "Gb", "G", "Ab", "A", "Bb", "B"];

impl Scale {
    pub fn new(tonic: &str, intervals: &str) -> Result<Scale, Error> {
        let tonic_pc = parse_tonic(tonic).ok_or(Error)?;
        let interval_steps = parse_intervals(intervals).ok_or(Error)?;
        let pcs = pitch_classes(tonic_pc, &interval_steps);
        let use_flats = choose_use_flats(tonic, &interval_steps, &pcs);
        Ok(Scale { tonic_pc, intervals: interval_steps, use_flats })
    }

    pub fn chromatic(tonic: &str) -> Result<Scale, Error> {
        let tonic_pc = parse_tonic(tonic).ok_or(Error)?;
        let interval_steps = vec![1; 11];
        let pcs = pitch_classes(tonic_pc, &interval_steps);
        let use_flats = choose_use_flats(tonic, &interval_steps, &pcs);
        Ok(Scale { tonic_pc, intervals: interval_steps, use_flats })
    }

    pub fn enumerate(&self) -> Vec<String> {
        let mut pc = self.tonic_pc;
        let mut notes = Vec::with_capacity(self.intervals.len() + 1);
        notes.push(note_name(pc, self.use_flats).to_string());
        for step in &self.intervals {
            pc = (pc + step) % 12;
            notes.push(note_name(pc, self.use_flats).to_string());
        }
        notes
    }
}
```

