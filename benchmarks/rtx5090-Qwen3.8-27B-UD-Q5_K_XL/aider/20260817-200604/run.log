class House {
    private static final String[] SUBJECTS = {
        "the house that Jack built.",
        "the malt",
        "the rat",
        "the cat",
        "the dog",
        "the cow with the crumpled horn",
        "the maiden all forlorn",
        "the man all tattered and torn",
        "the priest all shaven and shorn",
        "the rooster that crowed in the morn",
        "the farmer sowing his corn",
        "the horse and the hound and the horn"
    };
    private static final String[] ACTIONS = {
        "lay in",
        "ate",
        "killed",
        "worried",
        "tossed",
        "milked",
        "kissed",
        "married",
        "woke",
        "kept",
        "belonged to"
    };

    String verse(int verse) {
        if (verse < 1 || verse > SUBJECTS.length) {
            throw new IllegalArgumentException("Verse must be between 1 and 12.");
        }
        StringBuilder sb = new StringBuilder("This is ");
        sb.append(SUBJECTS[verse - 1]);
        for (int i = verse - 2; i >= 0; i--) {
            sb.append("\nthat ").append(ACTIONS[i]).append(' ').append(SUBJECTS[i]);
        }
        return sb.toString();
    }

    String verses(int startVerse, int endVerse) {
        if (startVerse < 1 || endVerse > SUBJECTS.length || startVerse > endVerse) {
            throw new IllegalArgumentException("Invalid verse range.");
        }
        StringBuilder sb = new StringBuilder();
        for (int i = startVerse; i <= endVerse; i++) {
            if (i > startVerse) {
                sb.append("\n\n");
            }
            sb.append(verse(i));
        }
        return sb.toString();
    }

    String sing() {
        return verses(1, SUBJECTS.length);
    }
}

