```
class SgfTree:
    def __init__(self, properties=None, children=None):
        self.properties = properties or {}
        self.children = children or []

    def __eq__(self, other):
        if not isinstance(other, SgfTree):
            return False
        if set(self.properties.keys()) != set(other.properties.keys()):
            return False
        for key, value in self.properties.items():
            if not self._values_equal(value, other.properties[key]):
                return False
        if len(self.children) != len(other.children):
            return False
        for child, other_child in zip(self.children, other.children):
            if child != other_child:
                return False
        return True

    @staticmethod
    def _values_equal(left, right):
        if isinstance(left, (list, tuple)) or isinstance(right, (list, tuple)):
            if not isinstance(left, (list, tuple)):
                left = [left]
            if not isinstance(right, (list, tuple)):
                right = [right]
            return list(left) == list(right)
        return left == right

    def __ne__(self, other):
        return not self == other


def parse(input_string):
    if not input_string or input_string[0] != '(':
        raise ValueError("tree missing")

    tree, index = _parse_tree(input_string, 0)

    if index != len(input_string) and input_string[index:].strip():
        raise ValueError("tree missing")

    return tree


def _parse_tree(s, i):
    if i >= len(s) or s[i] != '(':
        raise ValueError("tree missing")

    i += 1

    if i >= len(s):
        raise ValueError("tree missing")

    if s[i] == ')':
        raise ValueError("tree with no nodes")

    if s[i] != ';':
        if s[i] == '(':
            raise ValueError("tree with no nodes")
        raise ValueError("tree missing")

    root, i = _parse_node(s, i)
    current = root

    while i < len(s) and s[i] != ')':
        if s[i] == ';':
            child, i = _parse_node(s, i)
            current.children.append(child)
            current = child
        elif s[i] == '(':
            child, i = _parse_tree(s, i)
            current.children.append(child)
        else:
            raise ValueError("tree missing")

    if i >= len(s) or s[i] != ')':
        raise ValueError("tree missing")

    return root, i + 1


def _parse_node(s, i):
    if i >= len(s) or s[i] != ';':
        raise ValueError("tree missing")

    i += 1
    properties = {}

    while i < len(s) and s[i] not in ';()':
        key, i = _parse_key(s, i)
        values, i = _parse_value_list(s, i)
        properties[key] = values

    return SgfTree(properties=properties, children=[]), i


def _parse_key(s, i):
    start = i

    while i < len(s) and s[i] != '[':
        i += 1

    if i >= len(s) or s[i] != '[':
        raise ValueError("properties without delimiter")

    key = s[start:i]

    if not key or not key.isalpha() or not key.isupper():
        raise ValueError("property must be in uppercase")

    return key, i


def _parse_value_list(s, i):
    if i >= len(s) or s[i] != '[':
        raise ValueError("properties without delimiter")

    values = []

    while i < len(s) and s[i] == '[':
        value, i = _parse_text(s, i)
        values.append(value)

    return values, i


def _parse_text(s, i):
    i += 1
    chars = []

    while i < len(s):
        c = s[i]

        if c == '\\' and i + 1 < len(s):
            nxt = s[i + 1]

            if nxt == '\n':
                i += 2
                continue

            if nxt.isspace():
                chars.append(' ')
                i += 2
                continue

            chars.append(nxt)
            i += 2
            continue

        if c == ']':
            return ''.join(chars), i + 1

        if c == '\n':
            chars.append('\n')
            i += 1
            continue

        if c.isspace():
            chars.append(' ')
            i += 1
            continue

        chars.append(c)
        i += 1

    raise ValueError("properties without delimiter")
```

