func Transpose(input []string) []string {
    if len(input)==0 { return []string{} }
    rows := make([][]rune, len(input))
    maxCols := 0
    for i, s := range input {
        r := []rune(s)
        rows[i] = r
        if len(r) > maxCols { maxCols = len(r) }
    }
    if maxCols == 0 { return []string{} }
    result := make([]string, maxCols)
    for col := 0; col < maxCols; col++ {
        // find last row index where len(rows[row]) > col
        last := -1
        for row := len(rows)-1; row >=0; row-- {
            if len(rows[row]) > col { last = row; break }
        }
        if last == -1 { continue? But maxCols ensures some row has col, so last >=0. }
        var b []rune
        for row := 0; row <= last; row++ {
            if len(rows[row]) > col {
                b = append(b, rows[row][col])
            } else {
                b = append(b, ' ')
            }
        }
        result[col] = string(b)
    }
    return result
}

