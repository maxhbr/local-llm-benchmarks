```
export const combinations = (sum, size, ...excludedArgs) => {
  if (Array.isArray(sum)) {
    [sum, size, ...excludedArgs] = sum;
  }

  const excludedSet = new Set(
    excludedArgs
      .flat(Infinity)
      .filter((digit) => Number.isInteger(digit) && digit >= 1 && digit <= 9)
  );

  const generate = (target, length) => {
    if (!Number.isInteger(target) || !Number.isInteger(length)) return [];
    if (length < 0 || length > 9) return [];
    if (excludedSet.size + length > 9) return [];

    const digits = [];
    for (let d = 1; d <= 9; d += 1) {
      if (!excludedSet.has(d)) digits.push(d);
    }
    if (digits.length < length) return [];

    const minSum = digits.slice(0, length).reduce((a, b) => a + b, 0);
    const maxSum = digits.slice(-length).reduce((a, b) => a + b, 0);
    if (target < minSum || target > maxSum) return [];

    const result = [];
    const current = [];

    const backtrack = (start, currentSum) => {
      if (current.length === length) {
        if (currentSum === target) result.push([...current]);
        return;
      }

      const remaining = length - current.length;
      for (let i = start; i <= digits.length - remaining; i += 1) {
        const digit = digits[i];
        const nextSum = currentSum + digit;
        if (nextSum > target) break;

        // Optional prune: even with smallest remaining digits can't reach target?
        // Could add for efficiency but not needed.
        current.push(digit);
        backtrack(i + 1, nextSum);
        current.pop();
      }
    };

    backtrack(0, 0);
    return result;
  };

  let result;
  if (size === undefined) {
    // infer length by trying 1..9? But generate with length undefined not.
    // We can find smallest length that can produce target.
    let inferredLength = 1;
    for (let len = 1; len <= 9; len += 1) {
      // quick min/max with excluded
      const digits = [];
      for (let d=1; d<=9; d++) if (!excludedSet.has(d)) digits.push(d);
      if (digits.length < len) break;
      const min = digits.slice(0, len).reduce((a,b)=>a+b,0);
      const max = digits.slice(-len).reduce((a,b)=>a+b,0);
      if (Number.isInteger(sum) && sum >= min && sum <= max) {
        inferredLength = len;
        break;
      }
    }
    result = generate(sum, inferredLength);
  } else {
    result = generate(sum, size);
    if (result.length === 0 && Number.isInteger(sum) && Number.isInteger(size)) {
      const swapped = generate(size, sum);
      if (swapped.length > 0) result = swapped;
    }
  }

  return result;
};
```
