Potential robust header:
```
#if !defined(BINARY_SEARCH_TREE_H)
#define BINARY_SEARCH_TREE_H

#include <memory>
#include <stdexcept>
#include <utility>

namespace binary_search_tree {

template <typename T = int>
class binary_search_tree {
public:
    binary_search_tree() = default;

    ~binary_search_tree();

    binary_search_tree(const T& data) : data_(new T(data)) {}

    binary_search_tree(const binary_search_tree<T>& other) {
        if (other.data_) {
            data_.reset(new T(*other.data_));
        }
        if (other.left_) {
            left_.reset(new binary_search_tree<T>(*other.left_));
        }
        if (other.right_) {
            right_.reset(new binary_search_tree<T>(*other.right_));
        }
    }

    binary_search_tree(binary_search_tree<T>&& other) noexcept = default;

    binary_search_tree<T>& operator=(const binary_search_tree<T>& other) {
        if (this != &other) {
            binary_search_tree<T> temporary(other);
            swap(temporary);
        }
        return *this;
    }

    binary_search_tree<T>& operator=(binary_search_tree<T>&& other) noexcept = default;

    void add(const T& data) {
        if (!data_) {
            data_.reset(new T(data));
            return;
        }

        if (data <= *data_) {
            if (!left_) {
                left_.reset(new binary_search_tree<T>(data));
            } else {
                left_->add(data);
            }
        } else {
            if (!right_) {
                right_.reset(new binary_search_tree<T>(data));
            } else {
                right_->add(data);
            }
        }
    }

    bool contains(const T& data) const {
        if (!data_) {
            return false;
        }

        if (data == *data_) {
            return true;
        }

        if (data < *data_) {
            return left_ ? left_->contains(data) : false;
        }

        return right_ ? right_->contains(data) : false;
    }

    T& data() {
        if (!data_) {
            throw std::logic_error("binary_search_tree::data() called on an empty tree");
        }
        return *data_;
    }

    const T& data() const {
        if (!data_) {
            throw std::logic_error("binary_search_tree::data() called on an empty tree");
        }
        return *data_;
    }

    bool empty() const {
        return !data_;
    }

    const binary_search_tree<T>* left() const {
        return left_.get();
    }

    const binary_search_tree<T>* right() const {
        return right_.get();
    }

private:
    void swap(binary_search_tree<T>& other) noexcept {
        data_.swap(other.data_);
        left_.swap(other.left_);
        right_.swap(other.right_);
    }

    std::unique_ptr<T> data_;
    std::unique_ptr<binary_search_tree<T>> left_;
    std::unique_ptr<binary_search_tree<T>> right_;
};

template <typename T>
binary_search_tree<T>::~binary_search_tree() = default;

}  // namespace binary_search_tree

#endif // BINARY_SEARCH_TREE_H
```

