#[derive(Debug, PartialEq, Eq)]
pub enum Error {
    NotEnoughPinsLeft,
    GameComplete,
}

pub struct BowlingGame {
    rolls: Vec<u16>,
}

impl BowlingGame {
    pub fn new() -> Self {
        Self { rolls: Vec::new() }
    }

    pub fn roll(&mut self, pins: u16) -> Result<(), Error> {
        if self.is_complete() {
            return Err(Error::GameComplete);
        }

        let frame = self.current_frame();
        let start = self.frame_start(frame);
        let rolls_in_frame = self.rolls.len() - start;

        let first = if rolls_in_frame > 0 { self.rolls[start] } else { 0 };
        let second = if rolls_in_frame > 1 { self.rolls[start + 1] } else { 0 };

        let valid = if frame < 9 {
            if rolls_in_frame == 0 {
                pins <= 10
            } else {
                pins <= 10 - first
            }
        } else {
            match rolls_in_frame {
                0 => pins <= 10,
                1 => {
                    if first == 10 {
                        pins <= 10
                    } else {
                        pins <= 10 - first
                    }
                }
                2 => {
                    if first == 10 {
                        if second == 10 {
                            pins <= 10
                        } else {
                            pins <= 10 - second
                        }
                    } else {
                        pins <= 10
                    }
                }
                _ => false,
            }
        };

        if !valid {
            return Err(Error::NotEnoughPinsLeft);
        }

        self.rolls.push(pins);
        Ok(())
    }

    pub fn score(&self) -> Option<u16> {
        if !self.is_complete() {
            return None;
        }

        let mut total = 0u16;
        let mut i = 0usize;

        for frame in 0..10 {
            if frame < 9 {
                if self.rolls[i] == 10 {
                    total += 10 + self.rolls[i + 1] + self.rolls[i + 2];
                    i += 1;
                } else {
                    let a = self.rolls[i];
                    let b = self.rolls[i + 1];
                    if a + b == 10 {
                        total += 10 + self.rolls[i + 2];
                    } else {
                        total += a + b;
                    }
                    i += 2;
                }
            } else {
                for &roll in &self.rolls[i..] {
                    total += roll;
                }
            }
        }

        Some(total)
    }

    fn is_complete(&self) -> bool {
        let mut i = 0usize;

        for frame in 0..10 {
            if frame < 9 {
                if i >= self.rolls.len() {
                    return false;
                }
                if self.rolls[i] == 10 {
                    i += 1;
                } else {
                    if i + 1 >= self.rolls.len() {
                        return false;
                    }
                    i += 2;
                }
            } else {
                if i >= self.rolls.len() {
                    return false;
                }
                let first = self.rolls[i];
                if first == 10 {
                    if i + 2 >= self.rolls.len() {
                        return false;
                    }
                    i += 3;
                } else {
                    if i + 1 >= self.rolls.len() {
                        return false;
                    }
                    let second = self.rolls[i + 1];
                    if first + second == 10 {
                        if i + 2 >= self.rolls.len() {
                            return false;
                        }
                        i += 3;
                    } else {
                        i += 2;
                    }
                }
            }
        }

        true
    }

    fn current_frame(&self) -> usize {
        let mut i = 0usize;

        for frame in 0..10 {
            if frame < 9 {
                if i >= self.rolls.len() {
                    return frame;
                }
                if self.rolls[i] == 10 {
                    i += 1;
                } else {
                    i += 2;
                }
            } else {
                return frame;
            }
        }

        10
    }

    fn frame_start(&self, frame: usize) -> usize {
        let mut i = 0usize;

        for f in 0..frame {
            if f < 9 {
                if self.rolls[i] == 10 {
                    i += 1;
                } else {
                    i += 2;
                }
            }
        }

        i
    }
}

