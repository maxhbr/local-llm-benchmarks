import java.util.Arrays;
import java.util.Random;

public class MazeGenerator {
    private static final char ARROW = '\u21E8';
    private static final char HORIZONTAL = '\u2500';
    private static final char VERTICAL = '\u2502';
    private static final char TOP_LEFT = '\u250C';
    private static final char TOP_RIGHT = '\u2510';
    private static final char BOTTOM_LEFT = '\u2514';
    private static final char BOTTOM_RIGHT = '\u2518';
    private static final char T_DOWN = '\u252C';
    private static final char T_UP = '\u2534';
    private static final char T_RIGHT = '\u251C';
    private static final char T_LEFT = '\u2524';
    private static final char CROSS = '\u253C';

    public char[][] generatePerfectMaze(int rows, int columns) {
        return generatePerfectMaze(rows, columns, new Random().nextInt());
    }

    public char[][] generatePerfectMaze(int rows, int columns, int seed) {
        if (rows <= 0 || columns <= 0) {
            throw new IllegalArgumentException("rows and columns must be positive");
        }

        Random random = new Random(seed);

        boolean[][] horizontalWalls = new boolean[rows + 1][columns];
        boolean[][] verticalWalls = new boolean[rows][columns + 1];

        for (int r = 0; r <= rows; r++) {
            Arrays.fill(horizontalWalls[r], true);
        }
        for (int r = 0; r < rows; r++) {
            Arrays.fill(verticalWalls[r], true);
        }

        int entranceRow = rows / 2;
        boolean[][] visited = new boolean[rows][columns];
        int[] stackR = new int[rows * columns];
        int[] stackC = new int[rows * columns];
        int top = 0;

        visited[entranceRow][0] = true;
        stackR[top] = entranceRow;
        stackC[top] = 0;
        top++;

        int[] dr = {-1, 1, 0, 0};
        int[] dc = {0, 0, -1, 1};

        while (top > 0) {
            int r = stackR[top - 1];
            int c = stackC[top - 1];

            int[] candidates = new int[4];
            int count = 0;
            for (int i = 0; i < 4; i++) {
                int nr = r + dr[i];
                int nc = c + dc[i];
                if (nr >= 0 && nr < rows && nc >= 0 && nc < columns && !visited[nr][nc]) {
                    candidates[count++] = i;
                }
            }

            if (count == 0) {
                top--;
                continue;
            }

            int move = candidates[random.nextInt(count)];
            int nr = r + dr[move];
            int nc = c + dc[move];

            if (move == 0) {
                horizontalWalls[r][c] = false;
            } else if (move == 1) {
                horizontalWalls[r + 1][c] = false;
            } else if (move == 2) {
                verticalWalls[r][c] = false;
            } else {
                verticalWalls[r][c + 1] = false;
            }

            visited[nr][nc] = true;
            stackR[top] = nr;
            stackC[top] = nc;
            top++;
        }

        int exitRow = chooseExitRow(rows, columns, horizontalWalls, verticalWalls, entranceRow);

        verticalWalls[entranceRow][0] = false;
        verticalWalls[exitRow][columns] = false;

        char[][] maze = new char[2 * rows + 1][2 * columns + 1];

        for (int i = 0; i < maze.length; i++) {
            for (int j = 0; j < maze[0].length; j++) {
                if ((i & 1) == 1 && (j & 1) == 1) {
                    maze[i][j] = ' ';
                } else if ((i & 1) == 0 && (j & 1) == 1) {
                    maze[i][j] = horizontalWalls[i / 2][j / 2] ? HORIZONTAL : ' ';
                } else if ((i & 1) == 1 && (j & 1) == 0) {
                    maze[i][j] = verticalWalls[i / 2][j / 2] ? VERTICAL : ' ';
                } else {
                    boolean up = i > 0 && verticalWalls[i / 2 - 1][j / 2];
                    boolean down = i < 2 * rows && verticalWalls[i / 2][j / 2];
                    boolean left = j > 0 && horizontalWalls[i / 2][j / 2 - 1];
                    boolean right = j < 2 * columns && horizontalWalls[i / 2][j / 2];
                    maze[i][j] = junction(up, down, left, right);
                }
            }
        }

        maze[2 * entranceRow + 1][0] = ARROW;
        maze[2 * exitRow + 1][2 * columns] = ARROW;

        return maze;
    }

    private int chooseExitRow(int rows, int columns, boolean[][] horizontalWalls,
                              boolean[][] verticalWalls, int entranceRow) {
        int[][] distance = new int[rows][columns];
        for (int[] row : distance) {
            Arrays.fill(row, -1);
        }

        int[] queueR = new int[rows * columns];
        int[] queueC = new int[rows * columns];
        int head = 0;
        int tail = 0;

        distance[entranceRow][0] = 0;
        queueR[tail] = entranceRow;
        queueC[tail] = 0;
        tail++;

        while (head < tail) {
            int r = queueR[head];
            int c = queueC[head];
            head++;

            if (r > 0 && !horizontalWalls[r][c] && distance[r - 1][c] == -1) {
                distance[r - 1][c] = distance[r][c] + 1;
                queueR[tail] = r - 1;
                queueC[tail] = c;
                tail++;
            }
            if (r + 1 < rows && !horizontalWalls[r + 1][c] && distance[r + 1][c] == -1) {
                distance[r + 1][c] = distance[r][c] + 1;
                queueR[tail] = r + 1;
                queueC[tail] = c;
                tail++;
            }
            if (c > 0 && !verticalWalls[r][c] && distance[r][c - 1] == -1) {
                distance[r][c - 1] = distance[r][c] + 1;
                queueR[tail] = r;
                queueC[tail] = c - 1;
                tail++;
            }
            if (c + 1 < columns && !verticalWalls[r][c + 1] && distance[r][c + 1] == -1) {
                distance[r][c + 1] = distance[r][c] + 1;
                queueR[tail] = r;
                queueC[tail] = c + 1;
                tail++;
            }
        }

        int first = rows >= 3 ? 1 : 0;
        int last = rows >= 3 ? rows - 2 : rows - 1;
        int bestRow = entranceRow;
        int bestDistance = -1;

        for (int r = first; r <= last; r++) {
            if (distance[r][columns - 1] > bestDistance) {
                bestDistance = distance[r][columns - 1];
                bestRow = r;
            }
        }

        return bestRow;
    }

    private char junction(boolean up, boolean down, boolean left, boolean right) {
        if (up && down && left && right) {
            return CROSS;
        }
        if (up && left && right) {
            return T_UP;
        }
        if (down && left && right) {
            return T_DOWN;
        }
        if (up && down && right) {
            return T_RIGHT;
        }
        if (up && down && left) {
            return T_LEFT;
        }
        if (up && down) {
            return VERTICAL;
        }
        if (left && right) {
            return HORIZONTAL;
        }
        if (up && right) {
            return BOTTOM_LEFT;
        }
        if (up && left) {
            return BOTTOM_RIGHT;
        }
        if (down && right) {
            return TOP_LEFT;
        }
        if (down && left) {
            return TOP_RIGHT;
        }
        if (up || down) {
            return VERTICAL;
        }
        if (left || right) {
            return HORIZONTAL;
        }
        return ' ';
    }
}
