public class SgfParsing {
    public SgfNode parse(String input) throws SgfParsingException {
        if (input == null || input.isEmpty()) throw new SgfParsingException("Empty string");
        int[] pos = {0};
        SgfNode root = parseTree(input, pos);
        if (pos[0] != input.length()) throw new SgfParsingException("Unbalanced"); // or "Invalid property"?
        return root;
    }

    private SgfNode parseTree(String s, int[] pos) throws SgfParsingException {
        if (pos[0] >= s.length() || s.charAt(pos[0]) != '(') {
            throw new SgfParsingException("Missing root tree");
        }
        pos[0]++;
        SgfNode root = null;
        SgfNode current = null;
        while (pos[0] < s.length()) {
            char c = s.charAt(pos[0]);
            if (c == ')') {
                pos[0]++;
                break;
            } else if (c == ';') {
                SgfNode node = parseNode(s, pos);
                if (root == null) {
                    root = node;
                    current = node;
                } else {
                    current.getChildren().add(node);
                    current = node;
                }
            } else if (c == '(') {
                SgfNode child = parseTree(s, pos);
                if (current == null) {
                    // tree before node in this tree. Could be invalid? Maybe treat as root? But SGF tree must start with node.
                    // If top-level input "((;FF[4]))" invalid. Throw Missing root tree? Unbalanced? Invalid property?
                    throw new SgfParsingException("Missing root tree");
                }
                current.getChildren().add(child);
                // current remains parent
            } else {
                throw new SgfParsingException("Invalid property");
            }
        }
        if (pos[0] >= s.length()) throw new SgfParsingException("Unbalanced");
        if (root == null) throw new SgfParsingException("Missing root tree");
        return root;
    }

    private SgfNode parseNode(String s, int[] pos) throws SgfParsingException {
        // assumes at ';'
        pos[0]++;
        Map<String, List<String>> props = new HashMap<>();
        while (pos[0] < s.length()) {
            char c = s.charAt(pos[0]);
            if (c == ';' || c == '(' || c == ')') break;
            parseProperty(s, pos, props);
        }
        return new SgfNode(props, new ArrayList<>());
    }

    private void parseProperty(String s, int[] pos, Map<String, List<String>> props) throws SgfParsingException {
        int start = pos[0];
        while (pos[0] < s.length()) {
            char c = s.charAt(pos[0]);
            if (c >= 'A' && c <= 'Z') pos[0]++;
            else break;
        }
        String key = s.substring(start, pos[0]);
        if (key.isEmpty()) {
            // If next char is not uppercase. Need distinguish invalid property key vs invalid property.
            // If char is '['? key empty -> invalid property key? Example "(;[4])" maybe invalid property key.
            // If char is ')' or ';' or '('? property missing -> invalid property? But node with no properties is valid, so parseNode wouldn't call if c is delimiter.
So here c is something else.
            throw new SgfParsingException("Invalid property key");
        }
        // key must be all uppercase; if first char not uppercase, key empty -> invalid property key. If key contains lowercase after uppercase? e.g. Ff[4]: key "F", 
then pos at 'f', not '[' -> invalid property? But expected invalid property key. Need parse key as sequence of letters? SGF key is uppercase letters; if lowercase 
appears, invalid property key. We should consume letters (upper/lower?) to detect. Better: key = one or more uppercase letters; if next char is lowercase, invalid 
property key. If next char is not '[' after uppercase, invalid property? For "ff[4]", first char lowercase -> invalid property key. For "Ff[4]", first uppercase then 
lowercase -> invalid property key. For "F1[4]" -> invalid property key? Property identifier must letters, so invalid property key. For "F [4]" -> invalid property 
key? maybe.
        // Need check char after key: if not '[' -> if key length >0 and next char is letter/digit? invalid property key; if next char is delimiter? invalid property?
But parseNode only calls when not delimiter. Could be "C)" -> key C, next ')' -> invalid property (missing value). So if next char == '[' parse values; else if next 
char is letter or digit? invalid property key; else invalid property?
        if (pos[0] >= s.length() || s.charAt(pos[0]) != '[') {
            // If the character is a lowercase letter or digit? invalid property key. But if it's ')' or ';' or '(' -> invalid property.
            char next = pos[0] < s.length() ? s.charAt(pos[0]) : 0;
            if (Character.isLetterOrDigit(next)) { // maybe invalid key
                throw new SgfParsingException("Invalid property key");
            }
            throw new SgfParsingException("Invalid property");
        }
        if (props.containsKey(key)) throw new SgfParsingException("Property already exists");
        List<String> values = new ArrayList<>();
        while (pos[0] < s.length() && s.charAt(pos[0]) == '[') {
            values.add(parseValue(s, pos));
        }
        if (values.isEmpty()) throw new SgfParsingException("Invalid property"); // shouldn't
        props.put(key, values);
    }

    private String parseValue(String s, int[] pos) throws SgfParsingException {
        // assumes at '['
        pos[0]++;
        StringBuilder sb = new StringBuilder();
        while (pos[0] < s.length()) {
            char c = s.charAt(pos[0]);
            if (c == '\\') {
                pos[0]++;
                if (pos[0] >= s.length()) throw new SgfParsingException("Invalid property"); // or Unbalanced
                char e = s.charAt(pos[0]);
                if (e == '\n') {
                    // remove newline
                } else if (isWhitespace(e)) {
                    sb.append(' ');
                } else {
                    sb.append(e);
                }
                pos[0]++;
            } else if (c == ']') {
                pos[0]++;
                return sb.toString();
            } else {
                if (c == '\n') sb.append('\n');
                else if (isWhitespace(c)) sb.append(' ');
                else sb.append(c);
                pos[0]++;
            }
        }
        throw new SgfParsingException("Unbalanced"); // missing ]
    }
}
