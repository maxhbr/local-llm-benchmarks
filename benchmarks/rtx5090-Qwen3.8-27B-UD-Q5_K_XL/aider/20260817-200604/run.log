from collections import deque
from math import gcd

def measure(bucket_one, bucket_two, goal, start_bucket):
    if start_bucket not in ('one', 'two'):
        raise ValueError("start_bucket must be 'one' or 'two'")
    if bucket_one < 0 or bucket_two < 0 or goal < 0:
        raise ValueError("bucket sizes and goal must be non-negative")
    if goal == 0:
        return (0, start_bucket, 0)
    if goal > max(bucket_one, bucket_two):
        raise ValueError("No solution possible")
    g = gcd(bucket_one, bucket_two)
    if g == 0 or goal % g != 0:
        raise ValueError("No solution possible")

    def forbidden(state):
        b1, b2 = state
        if start_bucket == 'one':
            return b1 == 0 and b2 == bucket_two
        return b2 == 0 and b1 == bucket_one

    start = (0,0)
    queue = deque([(start, 0)])
    visited = {start}
    while queue:
        (b1,b2), moves = queue.popleft()
        if b1 == goal or b2 == goal:
            if b1 == goal:
                return (moves, 'one', b2)
            return (moves, 'two', b1)
        # actions
        # To maybe favor deterministic, order: pour from start to other, fill start, empty other, pour other to start, fill other, empty start? But if we want full 
BFS shortest, order only tie. Could choose a reasonable order.
