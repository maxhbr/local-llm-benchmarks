Final code:
```
export const combinations = (sum, size, ...excludedArgs) => {
  if (Array.isArray(sum)) {
    const [first, second, ...rest] = sum;
    sum = first;
    size = second;
    excludedArgs = rest;
  }

  const excluded = new Set(
    excludedArgs
      .flat(Infinity)
      .filter((digit) => Number.isInteger(digit) && digit >= 1 && digit <= 9)
  );

  const generate = (target, length) => {
    if (!Number.isInteger(target) || !Number.isInteger(length)) {
      return [];
    }

    if (length === 0) {
      return target === 0 ? [[]] : [];
    }

    if (length < 0 || length > 9 || excluded.size + length > 9) {
      return [];
    }

    const digits = [];
    for (let digit = 1; digit <= 9; digit += 1) {
      if (!excluded.has(digit)) {
        digits.push(digit);
      }
    }

    if (digits.length < length) {
      return [];
    }

    const minSum = digits.slice(0, length).reduce((total, digit) => total + digit, 0);
    const maxSum = digits.slice(-length).reduce((total, digit) => total + digit, 0);

    if (target < minSum || target > maxSum) {
      return [];
    }

    const result = [];
    const current = [];

    const backtrack = (start, currentSum) => {
      if (current.length === length) {
        if (currentSum === target) {
          result.push([...current]);
        }
        return;
      }

      const remaining = length - current.length;
      for (let i = start; i <= digits.length - remaining; i += 1) {
        const digit = digits[i];
        const nextSum = currentSum + digit;

        if (nextSum > target) {
          break;
        }

        current.push(digit);
        backtrack(i + 1, nextSum);
        current.pop();
      }
    };

    backtrack(0, 0);
    return result;
  };

  let result;

  if (size === undefined) {
    result = [];
    for (let length = 1; length <= 9; length += 1) {
      result = generate(sum, length);
      if (result.length > 0) {
        break;
      }
    }
  } else {
    result = generate(sum, size);

    if (result.length === 0 && Number.isInteger(sum) && Number.isInteger(size)) {
      const swapped = generate(size, sum);
      if (swapped.length > 0) {
        result = swapped;
      }
    }
  }

  return result;
};
```

