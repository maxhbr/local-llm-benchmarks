export const translate = (text) => {
  return text.split(' ').map((word) => {
    if (!word) return word;
    const lower = word.toLowerCase();
    const vowels = 'aeiou';
    if (vowels.includes(lower[0]) || lower.startsWith('xr') || lower.startsWith('yt')) {
      return word + 'ay';
    }
    let i = 0;
    while (i < lower.length) {
      const ch = lower[i];
      if (ch === 'q' && lower[i + 1] === 'u') {
        i += 2;
        break;
      }
      if (vowels.includes(ch)) break;
      if (ch === 'y' && i > 0) break;
      i += 1;
    }
    return word.slice(i) + word.slice(0, i) + 'ay';
  }).join(' ');
};

