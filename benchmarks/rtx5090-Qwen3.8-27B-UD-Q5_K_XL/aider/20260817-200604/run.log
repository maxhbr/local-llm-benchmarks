Compute:
```
const PRICE = [0, 800, 1520, 2160, 2560, 3000];
export const cost = (books) => {
  const counts = [0, 0, 0, 0, 0];
  for (const book of books) {
    counts[book - 1] += 1;
  }
  counts.sort((x, y) => y - x);
  const [a, b, c, d, e] = counts;
  const bottom = d + e;
  let five = 0;
  let four = 0;
  let three = 0;
  if (bottom <= c) {
    four = bottom;
    three = c - bottom;
  } else {
    five = bottom - c;
    four = 2 * c - bottom;
  }
  const two = b - c;
  const one = a - b;
  return five * PRICE[5] + four * PRICE[4] + three * PRICE[3] + two * PRICE[2] + one * PRICE[1];
};
```
