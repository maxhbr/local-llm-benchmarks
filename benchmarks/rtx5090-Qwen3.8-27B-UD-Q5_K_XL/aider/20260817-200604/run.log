public class SgfParsingTest {
    private final SgfParsing sgfParsing = new SgfParsing();

    @Test
    public void emptyInput() {
        assertThatThrownBy(() -> sgfParsing.parse(""))
            .isInstanceOf(SgfParsingException.class)
            .hasMessage("Empty string");
    }

    @Test
    public void nodeWithoutTree() {
        assertThatThrownBy(() -> sgfParsing.parse(";FF[4]"))
            .isInstanceOf(SgfParsingException.class)
            .hasMessage("Missing root tree");
    }

    @Test
    public void nodeWithoutProperties() {
        SgfNode expected = new SgfNode(Map.of(), List.of());
        assertThat(sgfParsing.parse("(;)")).isEqualTo(expected);
    }

    @Test
    public void singleNodeTree() {
        SgfNode expected = new SgfNode(Map.of("FF", List.of("4")), List.of());
        assertThat(sgfParsing.parse("(;FF[4])")).isEqualTo(expected);
    }

    @Test
    public void multipleProperties() {
        Map<String, List<String>> properties = new LinkedHashMap<>();
        properties.put("FF", List.of("4"));
        properties.put("C", List.of("root"));
        properties.put("SZ", List.of("19"));
        SgfNode expected = new SgfNode(properties, List.of());
        assertThat(sgfParsing.parse("(;FF[4]C[root]SZ[19])")).isEqualTo(expected);
    }

    @Test
    public void multiplePropertyValues() {
        Map<String, List<String>> properties = new LinkedHashMap<>();
        properties.put("FF", List.of("4"));
        properties.put("AB", List.of("aa", "ab", "ba"));
        SgfNode expected = new SgfNode(properties, List.of());
        assertThat(sgfParsing.parse("(;FF[4];AB[aa][ab][ba])")).isEqualTo(expected);
    }

    @Test
    public void twoNodes() {
        SgfNode child = new SgfNode(Map.of("B", List.of("aa")), List.of());
        SgfNode expected = new SgfNode(Map.of("FF", List.of("4")), List.of(child));
        assertThat(sgfParsing.parse("(;FF[4];B[aa])")).isEqualTo(expected);
    }

    @Test
    public void twoChildTrees() {
        SgfNode child1 = new SgfNode(Map.of("B", List.of("aa")), List.of());
        SgfNode child2 = new SgfNode(Map.of("B", List.of("dd")), List.of());
        SgfNode expected = new SgfNode(Map.of("FF", List.of("4")), List.of(child1, child2));
