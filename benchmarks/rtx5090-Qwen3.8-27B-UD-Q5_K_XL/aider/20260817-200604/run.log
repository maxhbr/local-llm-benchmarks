def _parse_flags(flags):
    if not flags:
        return set()
    if isinstance(flags, str):
        tokens = flags.split()
    else:
        tokens = list(flags)
    result = set()
    for token in tokens:
        if not isinstance(token, str):
            continue
        token = token.strip()
        if not token:
            continue
        if token.startswith('-'):
            result.update(token[1:])
        else:
            result.update(token)
    return result
```
