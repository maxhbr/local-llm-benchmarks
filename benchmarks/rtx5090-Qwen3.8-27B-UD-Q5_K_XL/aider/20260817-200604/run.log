Let's craft:
```
def grep(pattern, flags, files):
    flag_chars = _parse_flags(flags)
    show_line_numbers = 'n' in flag_chars
    show_file_names = 'l' in flag_chars
    ignore_case = 'i' in flag_chars
    invert = 'v' in flag_chars
    whole_line = 'x' in flag_chars

    multiple_files = len(files) > 1
    output = []

    for file_name in files:
        file_handle = open(file_name)
        lines = _read_lines(file_handle)
        file_matched = False
        for line_number, line in enumerate(lines, 1):
            matched = _line_matches(line, pattern, ignore_case, whole_line)
            selected = not matched if invert else matched
            if not selected:
                continue
            file_matched = True
            if show_file_names:
                continue
            prefix = ''
            if multiple_files:
                prefix += f'{file_name}:'
            if show_line_numbers:
                prefix += f'{line_number}:'
            output.append(prefix + line)
        if show_file_names and file_matched:
            output.append(file_name)

    if not output:
        return ''
    return '\n'.join(output) + '\n'
```
But with show_file_names, we `continue` before appending line, but still set file_matched. Good. However if show_file_names true, we don't need line numbers. Good.

