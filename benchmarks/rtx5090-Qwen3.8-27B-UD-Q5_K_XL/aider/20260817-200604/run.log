#include "zebra_puzzle.h"

#include <algorithm>
#include <array>
#include <string>
#include <vector>

namespace zebra_puzzle {
namespace {

using Assignment = std::array<int, 5>;

constexpr int Englishman = 0;
...

bool color_precheck(const Assignment& color) {
    if (color[1] != Blue) return false;
    for (int i = 0; i + 1 < 5; ++i) {
        if (color[i] == Ivory && color[i + 1] == Green) return true;
    }
    return false;
}

bool nationality_precheck(const Assignment& nationality, const Assignment& color) {
    if (nationality[0] != Norwegian) return false;
    for (int i = 0; i < 5; ++i) {
        if ((nationality[i] == Englishman) != (color[i] == Red)) return false;
    }
    return true;
}

bool drink_precheck(const Assignment& drink, const Assignment& color, const Assignment& nationality) {
    if (drink[2] != Milk) return false;
    for (int i = 0; i < 5; ++i) {
        if ((color[i] == Green) != (drink[i] == Coffee)) return false;
        if ((nationality[i] == Ukrainian) != (drink[i] == Tea)) return false;
    }
    return true;
}

bool pet_precheck(const Assignment& pet, const Assignment& nationality) {
    for (int i = 0; i < 5; ++i) {
        if ((nationality[i] == Spaniard) != (pet[i] == Dog)) return false;
    }
    return true;
}

bool hobby_precheck(const Assignment& hobby, const Assignment& color, const Assignment& drink, const Assignment& nationality, const Assignment& pet) {
    for (int i = 0; i < 5; ++i) {
        if ((color[i] == Yellow) != (hobby[i] == Painting)) return false;
        if ((hobby[i] == Football) != (drink[i] == OrangeJuice)) return false;
        if ((nationality[i] == Japanese) != (hobby[i] == Chess)) return false;
        if ((pet[i] == Snail) != (hobby[i] == Dancing)) return false;
    }
    return true;
}

bool valid(const Assignment& nationality, const Assignment& color, const Assignment& drink, const Assignment& pet, const Assignment& hobby) {
    for (int i = 0; i < 5; ++i) {
        if ((nationality[i] == Englishman) != (color[i] == Red)) return false;
        if ((nationality[i] == Spaniard) != (pet[i] == Dog)) return false;
        if ((color[i] == Green) != (drink[i] == Coffee)) return false;
        if ((nationality[i] == Ukrainian) != (drink[i] == Tea)) return false;
        if ((pet[i] == Snail) != (hobby[i] == Dancing)) return false;
        if ((color[i] == Yellow) != (hobby[i] == Painting)) return false;
        if ((hobby[i] == Football) != (drink[i] == OrangeJuice)) return false;
        if ((nationality[i] == Japanese) != (hobby[i] == Chess)) return false;
    }

    bool green_right_of_ivory = false;
    for (int i = 0; i + 1 < 5; ++i) {
        if (color[i] == Ivory && color[i + 1] == Green) {
            green_right_of_ivory = true;
            break;
        }
    }
    if (!green_right_of_ivory) return false;

    if (drink[2] != Milk) return false;
    if (nationality[0] != Norwegian) return false;

    bool norwegian_next_to_blue = false;
    for (int i = 0; i < 5; ++i) {
        if (nationality[i] != Norwegian) continue;
        if ((i > 0 && color[i - 1] == Blue) || (i + 1 < 5 && color[i + 1] == Blue)) {
            norwegian_next_to_blue = true;
            break;
        }
    }
    if (!norwegian_next_to_blue) return false;

    for (int i = 0; i < 5; ++i) {
        if (hobby[i] == Reading) {
            bool next_to_fox = (i > 0 && pet[i - 1] == Fox) || (i + 1 < 5 && pet[i + 1] == Fox);
            if (!next_to_fox) return false;
        }
        if (pet[i] == Fox) {
            bool next_to_reading = (i > 0 && hobby[i - 1] == Reading) || (i + 1 < 5 && hobby[i + 1] == Reading);
            if (!next_to_reading) return false;
        }
    }

    for (int i = 0; i < 5; ++i) {
        if (hobby[i] == Painting) {
            bool next_to_horse = (i > 0 && pet[i - 1] == Horse) || (i + 1 < 5 && pet[i + 1] == Horse);
            if (!next_to_horse) return false;
        }
        if (pet[i] == Horse) {
            bool next_to_painting = (i > 0 && hobby[i - 1] == Painting) || (i + 1 < 5 && hobby[i + 1] == Painting);
            if (!next_to_painting) return false;
        }
    }

    return true;
}

std::vector<Assignment> make_permutations() {
    std::vector<Assignment> permutations;
    Assignment current{0, 1, 2, 3, 4};
    do {
        permutations.push_back(current);
    } while (std::next_permutation(current.begin(), current.end()));
    return permutations;
}

}  // namespace

Solution solve() {
    static const std::string nationality_names[] = {
        "Englishman", "Spaniard", "Ukrainian", "Norwegian", "Japanese"
    };
    static const std::vector<Assignment> permutations = make_permutations();

    for (const auto& color : permutations) {
        if (!color_precheck(color)) continue;
        for (const auto& nationality : permutations) {
            if (!nationality_precheck(nationality, color)) continue;
            for (const auto& drink : permutations) {
                if (!drink_precheck(drink, color, nationality)) continue;
                for (const auto& pet : permutations) {
                    if (!pet_precheck(pet, nationality)) continue;
                    for (const auto& hobby : permutations) {
                        if (!hobby_precheck(hobby, color, drink, nationality, pet)) continue;
                        if (!valid(nationality, color, drink, pet, hobby)) continue;

                        Solution solution;
                        for (int i = 0; i < 5; ++i) {
                            if (drink[i] == Water) {
                                solution.drinksWater = nationality_names[nationality[i]];
                            }
                            if (pet[i] == Zebra) {
                                solution.ownsZebra = nationality_names[nationality[i]];
                            }
                        }
                        return solution;
                    }
                }
            }
        }
    }

    return Solution{};
}

}  // namespace zebra_puzzle

