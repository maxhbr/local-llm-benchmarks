export class Element {
  constructor(value, next = null) {
    this._value = value;
    this._next = next;
  }

  get value() {
    return this._value;
  }

  set value(value) {
    this._value = value;
  }

  get next() {
    return this._next;
  }

  set next(next) {
    this._next = next;
  }
}

export class List {
  constructor(...args) {
    this._list = null;
    this._length = 0;

    let items;
    if (args.length === 1 && Array.isArray(args[0])) {
      items = args[0];
    } else if (args.length === 1 && (args[0] === undefined || args[0] === null)) {
      items = [];
    } else {
      items = args;
    }

    for (const item of items) {
      this.add(item);
    }
  }

  add(element) {
    if (!(element instanceof Element)) {
      element = new Element(element);
    }

    element.next = this._list;
    this._list = element;
    this._length += 1;

    return this;
  }

  get length() {
    return this._length;
  }

  get head() {
    return this._list;
  }

  toArray() {
    const result = [];
    let current = this._list;

    while (current !== null) {
      result.push(current.value);
      current = current.next;
    }

    return result;
  }

  reverse() {
    let previous = null;
    let current = this._list;

    while (current !== null) {
      const next = current.next;
      current.next = previous;
      previous = current;
      current = next;
    }

    this._list = previous;

    return this;
  }
}
