```
enum ScaleType { Major, Minor, Unknown }
fn infer_scale_type(intervals: &str, tonic_lower: bool) -> ScaleType {
   if intervals == "MMmMMmM" { Major }
   else if intervals == "MmMMmMM" { Minor }
   else if intervals.len() >= 2 {
      match (intervals.as_bytes()[0], intervals.as_bytes()[1]) {
         (b'M', b'M') => Major,
         (b'M', b'm') => Minor,
         _ => Unknown,
      }
   } else if tonic_lower { Minor } else { Unknown }
}
```
