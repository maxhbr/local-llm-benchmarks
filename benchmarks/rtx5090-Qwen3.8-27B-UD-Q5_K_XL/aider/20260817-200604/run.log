private boolean couldHaveWonOnLastMove(String[] board, char player) {
    for (int i=0; i<3; i++) {
      for (int j=0; j<3; j++) {
        if (board[i].charAt(j) != player) continue;
        String[] copy = board.clone();
        String row = copy[i];
        copy[i] = row.substring(0,j) + " " + row.substring(j+1);
        if (!hasWon(copy, player)) return true;
      }
    }
    return false;
}
```
