kindergarten_garden.cpp
```
#include "kindergarten_garden.h"

#include <algorithm>
#include <array>
#include <string>

namespace kindergarten_garden {

namespace {

const std::array<std::string, 12>& students() {
    static const std::array<std::string, 12> names = {
        "Alice", "Bob", "Charlie", "David", "Eve", "Fred",
        "Ginny", "Harriet", "Ileana", "Joseph", "Kincaid", "Larry"
    };
    return names;
}

Plants plant_name(char c) {
    switch (c) {
        case 'G': return Plants::grass;
        case 'C': return Plants::clover;
        case 'R': return Plants::radishes;
        case 'V': return Plants::violets;
        default: return Plants::grass;
    }
}

}  // namespace

std::array<Plants, 4> plants(const std::string& diagram, const std::string& student) {
    std::array<Plants, 4> result = {Plants::grass, Plants::grass, Plants::grass, Plants::grass};

    const auto& all_students = students();
    auto it = std::find(all_students.begin(), all_students.end(), student);
    if (it == all_students.end()) {
        return result;
    }

    std::size_t offset = static_cast<std::size_t>(std::distance(all_students.begin(), it)) * 2;

    std::size_t newline = diagram.find('\n');
    std::string first_row = diagram.substr(0, newline);
    std::string second_row = (newline == std::string::npos) ? "" : diagram.substr(newline + 1);

    if (offset + 1 < first_row.size()) {
        result[0] = plant_name(first_row[offset]);
        result[1] = plant_name(first_row[offset + 1]);
    }

    if (offset + 1 < second_row.size()) {
        result[2] = plant_name(second_row[offset]);
        result[3] = plant_name(second_row[offset + 1]);
    }

    return result;
}

}  // namespace kindergarten_garden
```
