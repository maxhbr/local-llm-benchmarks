import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;

class KindergartenGarden {
    private static final List<String> STUDENTS = Arrays.asList(
        "Alice", "Bob", "Charlie", "David", "Eve", "Fred",
        "Ginny", "Harriet", "Ileana", "Joseph", "Kincaid", "Larry"
    );
    private final String[] rows;

    KindergartenGarden(String garden) {
        String[] parts = garden.trim().split("\\R");
        if (parts.length < 2) {
            // If the diagram is supplied as a single line, split it into two equal rows.
            String line = parts.length == 1 ? parts[0] : "";
            int half = line.length() / 2;
            rows = new String[] { line.substring(0, half), line.substring(half) };
        } else {
            rows = new String[] { parts[0], parts[1] };
        }
    }

    List<Plant> getPlantsOfStudent(String student) {
        int studentIndex = STUDENTS.indexOf(student);
        if (studentIndex == -1) {
            throw new IllegalArgumentException("No student called " + student);
        }

        int left = studentIndex * 2;
        int right = left + 1;

        List<Plant> plants = new ArrayList<>(4);
        plants.add(Plant.getPlantFromCharacter(rows[0].charAt(left)));
        plants.add(Plant.getPlantFromCharacter(rows[0].charAt(right)));
        plants.add(Plant.getPlantFromCharacter(rows[1].charAt(left)));
        plants.add(Plant.getPlantFromCharacter(rows[1].charAt(right)));
        return plants;
    }
}

