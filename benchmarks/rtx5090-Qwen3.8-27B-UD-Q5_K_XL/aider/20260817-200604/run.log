#include <utility>

namespace allergies {

namespace {

const std::array<std::pair<std::string, unsigned int>, 8> kAllergens = {{
    {"eggs", 1u},
...
}};

}  // namespace

AllergyTest::AllergyTest(int score)
    : score_(static_cast<unsigned int>(score) & 0xFFu) {}

bool AllergyTest::allergic_to(const std::string& allergen) const {
    for (const auto& item : kAllergens) {
        if (item.first == allergen) {
            return (score_ & item.second) != 0u;
        }
    }
    return false;
}

std::unordered_set<std::string> AllergyTest::allergies() const {
    std::unordered_set<std::string> result;
    for (const auto& item : kAllergens) {
        if ((score_ & item.second) != 0u) {
            result.emplace(item.first);
        }
    }
    return result;
}

}  // namespace allergies

