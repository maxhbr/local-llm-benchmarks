    String fractionPart = parts[1];
    String amount;
    if (format.dutch) {
        amount = format.currencySymbol + " " + integerPart + format.decimalSeparator + fractionPart;
    } else {
        amount = format.currencySymbol + integerPart + format.decimalSeparator + fractionPart;
    }

