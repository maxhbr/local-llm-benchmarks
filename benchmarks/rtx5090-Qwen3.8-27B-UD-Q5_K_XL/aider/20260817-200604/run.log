I implemented `getPalindromeProductsWithFactors` to:

1. Throw `IllegalArgumentException` for an invalid range.
2. Generate palindromic numbers in the possible product range.
3. Find all valid factor pairs for the smallest and largest palindromes that can be formed from factors in the given range.
4. Return only those smallest/largest entries in a `SortedMap`.

PalindromeCalculator.java
```
import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;
import java.util.SortedMap;
import java.util.TreeMap;

class PalindromeCalculator {

    SortedMap<Long, List<List<Integer>>> getPalindromeProductsWithFactors(int minFactor, int maxFactor) {
        if (minFactor > maxFactor) {
            throw new IllegalArgumentException("minFactor must be less than or equal to maxFactor");
        }

        long p1 = (long) minFactor * minFactor;
        long p2 = (long) minFactor * maxFactor;
        long p3 = (long) maxFactor * minFactor;
        long p4 = (long) maxFactor * maxFactor;

        long minProduct = Math.min(Math.min(p1, p2), Math.min(p3, p4));
        long maxProduct = Math.max(Math.max(p1, p2), Math.max(p3, p4));

        List<Long> palindromes = generatePalindromes(minProduct, maxProduct);
        SortedMap<Long, List<List<Integer>>> result = new TreeMap<>();

        Long smallest = null;
        List<List<Integer>> smallestFactors = null;

        for (long palindrome : palindromes) {
            List<List<Integer>> factors = getFactorPairs(palindrome, minFactor, maxFactor);
            if (!factors.isEmpty()) {
                smallest = palindrome;
                smallestFactors = factors;
                break;
            }
        }

        Long largest = null;
        List<List<Integer>> largestFactors = null;

        for (int i = palindromes.size() - 1; i >= 0; i--) {
            long palindrome = palindromes.get(i);
            List<List<Integer>> factors = getFactorPairs(palindrome, minFactor, maxFactor);
            if (!factors.isEmpty()) {
                largest = palindrome;
                largestFactors = factors;
                break;
            }
        }

        if (smallest != null) {
            result.put(smallest, smallestFactors);
            if (largest != null && !largest.equals(smallest)) {
                result.put(largest, largestFactors);
            }
        }

        return result;
    }

    private List<Long> generatePalindromes(long start, long end) {
        List<Long> palindromes = new ArrayList<>();

        if (start > end) {
            return palindromes;
        }

        if (start <= 0 && end >= 0) {
            palindromes.add(0L);
        }

        if (end <= 0) {
            return palindromes;
        }

        int maxLength = numberOfDigits(end);

        for (int length = 1; length <= maxLength; length++) {
            int halfLength = (length + 1) / 2;
            long halfStart = pow10(halfLength - 1);
            long halfEnd = pow10(halfLength) - 1;

            for (long half = halfStart; half <= halfEnd; half++) {
                long palindrome = (length % 2 == 1) ? makeOddPalindrome(half) : makeEvenPalindrome(half);

                if (palindrome < 0 || palindrome > end) {
                    return palindromes;
                }

                if (palindrome >= start) {
                    palindromes.add(palindrome);
                }
            }
        }

        return palindromes;
    }

    private long makeOddPalindrome(long half) {
        long result = half;
        long divisor = half / 10;

        while (divisor > 0) {
            long digit = divisor % 10;

            if (result > (Long.MAX_VALUE - digit) / 10) {
                return -1L;
            }

            result = result * 10 + digit;
            divisor /= 10;
        }

        return result;
    }

    private long makeEvenPalindrome(long half) {
        long result = half;
        long divisor = half;

        while (divisor > 0) {
            long digit = divisor % 10;

            if (result > (Long.MAX_VALUE - digit) / 10) {
                return -1L;
            }

            result = result * 10 + digit;
            divisor /= 10;
        }

        return result;
    }

    private int numberOfDigits(long value) {
        int count = 0;

        while (value > 0) {
            count++;
            value /= 10;
        }

        return count;
    }

    private long pow10(int exponent) {
        long result = 1L;

        for (int i = 0; i < exponent; i++) {
            result *= 10L;
        }

        return result;
    }

    private List<List<Integer>> getFactorPairs(long product, int minFactor, int maxFactor) {
        List<List<Integer>> pairs = new ArrayList<>();

        if (product < 0) {
            return pairs;
        }

        if (product == 0) {
            if (minFactor <= 0 && maxFactor >= 0) {
                for (int a = minFactor; a < 0; a++) {
                    pairs.add(Arrays.asList(a, 0));
                }

                for (int b = 0; b <= maxFactor; b++) {
                    pairs.add(Arrays.asList(0, b));
                }
            }

            return pairs;
        }

        if (minFactor < 0) {
            long upper = -(long) minFactor;
            long lower = Math.max(1L, -(long) maxFactor);

            if (lower <= upper) {
                long sqrt = integerSqrt(product);
                long limit = Math.min(upper, sqrt);

                for (long y = lower; y <= limit; y++) {
                    if (product % y == 0) {
                        long x = product / y;

                        if (x >= y && x <= upper) {
                            long aLong = -x;
                            long bLong = -y;

                            if (aLong >= minFactor && bLong <= maxFactor && aLong <= bLong) {
                                pairs.add(Arrays.asList((int) aLong, (int) bLong));
                            }
                        }
                    }
                }
            }
        }

        if (maxFactor > 0) {
            int start = Math.max(minFactor, 1);
            long minPossibleFactor = (product + maxFactor - 1L) / maxFactor;

            if (minPossibleFactor > start) {
                start = (int) Math.min(Integer.MAX_VALUE, minPossibleFactor);
            }

            int end = (int) Math.min((long) maxFactor, integerSqrt(product));

            for (int a = start; a <= end; a++) {
                if (product % a == 0) {
                    long b = product / a;

                    if (b >= a && b <= maxFactor) {
                        pairs.add(Arrays.asList(a, (int) b));
                    }
                }
            }
        }

        return pairs;
    }

    private long integerSqrt(long value) {
        long root = (long) Math.sqrt(value);

        while (root > 0 && root > value / root) {
            root--;
        }

        while ((root + 1) > 0 && (root + 1) <= value / (root + 1)) {
            root++;
        }

        return root;
    }
}
