def _read_lines(f):
    # try read
    read = getattr(f, 'read', None)
    if callable(read):
        try:
            content = read()
        except Exception:
            content = None
        if isinstance(content, str):
            return content.splitlines()
        if isinstance(content, bytes):
            return content.decode().splitlines()
    # try readlines
    readlines = getattr(f, 'readlines', None)
    if callable(readlines):
        try:
            lines = readlines()
        except Exception:
            lines = None
        if isinstance(lines, list) and all(isinstance(line, str) for line in lines):
            return [line.rstrip('\n') for line in lines]
    # try iterate
    try:
        return [line.rstrip('\n') for line in f]
    except Exception:
        return []
```
