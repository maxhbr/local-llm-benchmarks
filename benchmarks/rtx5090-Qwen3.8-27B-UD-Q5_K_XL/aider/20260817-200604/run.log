The skeleton needs a real implementation of `Palindromes.generate`. It should:

- Validate that `min <= max`, throwing `"min must be <= max"` otherwise.
- Find the smallest palindromic product and all of its factor pairs.
- Find the largest palindromic product and all of its factor pairs.
- Return `{ smallest, largest }`, where each has `{ value, factors }`.
- Use `value: null` and `factors: []` when no palindrome exists.

palindrome-products.js
```
//
// This is only a SKELETON file for the 'Palindrome Products' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export class Palindromes {
  static generate(min, max) {
    if (typeof min === 'object' && min !== null) {
      ({ min, max } = min);
    }

    if (min > max) {
      throw new Error('min must be <= max');
    }

    const smallest = this.findSmallest(min, max);
    const largest = this.findLargest(min, max);

    return { smallest, largest };
  }

  static findSmallest(min, max) {
    let value = null;
    let factors = [];

    for (let a = min; a <= max; a += 1) {
      if (value !== null && a * a > value) {
        break;
      }

      for (let b = a; b <= max; b += 1) {
        const product = a * b;

        if (value !== null && product > value) {
          break;
        }

        if (this.isPalindrome(product)) {
          if (value === null || product < value) {
            value = product;
            factors = [[a, b]];
          } else if (product === value) {
            factors.push([a, b]);
          }

          break;
        }
      }
    }

    factors.sort((x, y) => x[0] - y[0] || x[1] - y[1]);

    return { value, factors };
  }

  static findLargest(min, max) {
    let value = null;
    let factors = [];

    for (let a = max; a >= min; a -= 1) {
      if (value !== null && a * max < value) {
        break;
      }

      for (let b = max; b >= a; b -= 1) {
        const product = a * b;

        if (value !== null && product < value) {
          break;
        }

        if (this.isPalindrome(product)) {
          if (value === null || product > value) {
            value = product;
            factors = [[a, b]];
          } else if (product === value) {
            factors.push([a, b]);
          }

          break;
        }
      }
    }

    factors.sort((x, y) => x[0] - y[0] || x[1] - y[1]);

    return { value, factors };
  }

  static isPalindrome(number) {
    const text = String(number);

    for (let i = 0; i < Math.floor(text.length / 2); i += 1) {
      if (text[i] !== text[text.length - 1 - i]) {
        return false;
      }
    }

    return true;
  }
}
