import static java.util.Collections.unmodifiableList;

import java.util.ArrayList;
import java.util.List;

public class User {
    private final String name;
    private final List<Iou> owes;
    private final List<Iou> owedBy;

    private User(String name, List<Iou> owes, List<Iou> owedBy) {
        this.name = name;
        this.owes = new ArrayList<>(owes);
        this.owedBy = new ArrayList<>(owedBy);
    }

    public String name() { return name; }

    public List<Iou> owes() { return unmodifiableList(owes); }

    public List<Iou> owedBy() { return unmodifiableList(owedBy); }

    public void owes(String name, double amount) {
        addOrUpdate(owes, name, amount);
    }

    public void owedBy(String name, double amount) {
        addOrUpdate(owedBy, name, amount);
    }

    public double balance() {
        double owedBy = 0.0;
        for (Iou iou : owedBy) {
            owedBy += iou.amount();
        }
        double owes = 0.0;
        for (Iou iou : owes) {
            owes += iou.amount();
        }
        return owedBy - owes;
    }

    private void addOrUpdate(List<Iou> list, String name, double amount) {
        if (amount == 0.0) {
            return;
        }
        for (int i = 0; i < list.size(); i++) {
            Iou iou = list.get(i);
            if (iou.name().equals(name)) {
                double newAmount = iou.amount() + amount;
                if (newAmount == 0.0) {
                    list.remove(i);
                } else {
                    list.set(i, new Iou(name, newAmount));
                }
                return;
            }
        }
        list.add(new Iou(name, amount));
    }

    public static Builder builder() { return new Builder(); }

    public static class Builder { ... unchanged ... }
}
