private ParsedNode parseTree(String s, int[] pos) throws SgfParsingException {
    if (pos[0] >= s.length() || s.charAt(pos[0]) != '(') throw new SgfParsingException("Missing root tree");
    pos[0]++;
    ParsedNode root = null;
    ParsedNode current = null;
    while (pos[0] < s.length()) {
        char c = s.charAt(pos[0]);
        if (c == ')') { pos[0]++; break; }
        if (c == ';') {
            ParsedNode node = parseNode(s, pos);
            if (root == null) { root = node; current = node; }
            else { current.children.add(node); current = node; }
        } else if (c == '(') {
            ParsedNode child = parseTree(s, pos);
            if (current == null) throw new SgfParsingException("Missing root tree");
            current.children.add(child);
        } else {
            throw new SgfParsingException("Invalid property");
        }
    }
    if (pos[0] >= s.length()) throw new SgfParsingException("Unbalanced");
    if (root == null) throw new SgfParsingException("Missing root tree");
    return root;
}
```
