import java.time.LocalDate;
import java.time.format.DateTimeFormatter;
import java.util.ArrayList;
import java.util.Comparator;
import java.util.List;
import java.util.Locale;

/*
Refactoring log:
- Extracted locale/currency configuration into a private Format class.
- Replaced the nested if/else chain with validation plus a configuration lookup.
- Extracted sorting, description truncation, amount formatting, and row formatting into private methods.
- Used Locale.US for the intermediate decimal formatting so the code does not depend on the JVM default locale.
- Kept the public API and the original output behavior.
*/
public class Ledger {
    private static final String HEADER_EN_US = "Date       | Description               | Change       ";
    private static final String HEADER_NL_NL = "Datum      | Omschrijving              | Verandering  ";

    public LedgerEntry createLedgerEntry(String d, String desc, int c) {
        LedgerEntry le = new LedgerEntry();
        le.setChange(c);
        le.setDescription(desc);
        le.setLocalDate(LocalDate.parse(d));
        return le;
    }

    public String format(String cur, String loc, LedgerEntry[] entries) {
        Format format = createFormat(cur, loc);
        StringBuilder result = new StringBuilder(format.header);

        if (entries.length > 0) {
            for (LedgerEntry entry : sortEntries(entries)) {
                result.append('\n').append(formatRow(entry, format));
            }
        }

        return result.toString();
    }

    private static Format createFormat(String cur, String loc) {
        if (!cur.equals("USD") && !cur.equals("EUR")) {
            throw new IllegalArgumentException("Invalid currency");
        }
        if (!loc.equals("en-US") && !loc.equals("nl-NL")) {
            throw new IllegalArgumentException("Invalid locale");
        }

        String currencySymbol = cur.equals("USD") ? "$" : "€";
        boolean dutch = loc.equals("nl-NL");
        String datePattern = dutch ? "dd/MM/yyyy" : "MM/dd/yyyy";
        String decimalSeparator = dutch ? "," : ".";
        String thousandsSeparator = dutch ? "." : ",";
        String header = dutch ? HEADER_NL_NL : HEADER_EN_US;

        return new Format(currencySymbol, datePattern, decimalSeparator, thousandsSeparator, header);
    }

    private static List<LedgerEntry> sortEntries(LedgerEntry[] entries) {
        List<LedgerEntry> negative = new ArrayList<>();
        List<LedgerEntry> positive = new ArrayList<>();

        for (LedgerEntry entry : entries) {
            if (entry.getChange() < 0) {
                negative.add(entry);
            } else {
                positive.add(entry);
            }
        }

        negative.sort(Comparator.comparing(LedgerEntry::getLocalDate));
        positive.sort(Comparator.comparing(LedgerEntry::getLocalDate));

        List<LedgerEntry> sorted = new ArrayList<>(negative.size() + positive.size());
        sorted.addAll(negative);
        sorted.addAll(positive);
        return sorted;
    }

    private static String formatRow(LedgerEntry entry, Format format) {
        String date = entry.getLocalDate().format(DateTimeFormatter.ofPattern(format.datePattern));
        String description = truncateDescription(entry.getDescription());
        String amount = formatAmount(entry, format);
        return String.format("%s | %-25s | %13s", date, description, amount);
    }

    private static String truncateDescription(String description) {
        if (description.length() > 25) {
            return description.substring(0, 22) + "...";
        }
        return description;
    }

    private static String formatAmount(LedgerEntry entry, Format format) {
        double change = entry.getChange();
        double value = change < 0 ? (change / 100) * -1 : change / 100;
        String converted = String.format(Locale.US, "%.2f", value);
        String[] parts = converted.split("\\.");
        String integerPart = groupThousands(parts[0], format.thousandsSeparator);
        String fractionPart = parts[1];

        String amount;
        if (format.dutch) {
            amount = format.currencySymbol + " " + integerPart + format.decimalSeparator + fractionPart;
        } else {
            amount = format.currencySymbol + integerPart + format.decimalSeparator + fractionPart;
        }

        if (change < 0) {
            if (format.dutch) {
                amount = format.currencySymbol + " -" + amount.replace(format.currencySymbol, "").trim() + " ";
            } else {
                amount = "(" + amount + ")";
            }
        } else {
            if (format.dutch) {
                amount = " " + amount + " ";
            } else {
                amount = amount + " ";
            }
        }

        return amount;
    }

    private static String groupThousands(String integerPart, String separator) {
        StringBuilder grouped = new StringBuilder();
        for (int i = 0; i < integerPart.length(); i++) {
            if (i > 0 && (integerPart.length() - i) % 3 == 0) {
                grouped.append(separator);
            }
            grouped.append(integerPart.charAt(i));
        }
        return grouped.toString();
    }

    private static final class Format {
        private final String currencySymbol;
        private final String datePattern;
        private final String decimalSeparator;
        private final String thousandsSeparator;
        private final String header;
        private final boolean dutch;

        private Format(String currencySymbol, String datePattern, String decimalSeparator,
                       String thousandsSeparator, String header) {
            this.currencySymbol = currencySymbol;
            this.datePattern = datePattern;
            this.decimalSeparator = decimalSeparator;
            this.thousandsSeparator = thousandsSeparator;
            this.header = header;
            this.dutch = header.equals(HEADER_NL_NL); // or pass boolean
        }
    }

    public static class LedgerEntry {
        LocalDate localDate;
        String description;
        double change;

        public LocalDate getLocalDate() { return localDate; }
        public void setLocalDate(LocalDate localDate) { this.localDate = localDate; }
        public String getDescription() { return description; }
        public void setDescription(String description) { this.description = description; }
        public double getChange() { return change; }
        public void setChange(double change) { this.change = change; }
    }
}

