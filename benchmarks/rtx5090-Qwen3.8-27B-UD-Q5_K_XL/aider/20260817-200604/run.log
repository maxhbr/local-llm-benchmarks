WordProblemSolver.java
```
class WordProblemSolver {
    int solve(final String wordProblem) {
        if (wordProblem == null) {
            throw new IllegalArgumentException("I'm sorry, I don't understand the question!");
        }

        String question = wordProblem.trim();
        final String prefix = "What is ";

        if (!question.startsWith(prefix) || !question.endsWith("?")) {
            throw new IllegalArgumentException("I'm sorry, I don't understand the question!");
        }

        String expression = question.substring(prefix.length(), question.length() - 1).trim();
        if (expression.isEmpty()) {
            throw new IllegalArgumentException("I'm sorry, I don't understand the question!");
        }

        String[] tokens = expression.split("\\s+");
        int index = 0;

        int result = parseNumber(tokens, index);
        index++;

        while (index < tokens.length) {
            String operator = tokens[index];

            if (operator.equals("plus")) {
                index++;
                result += parseNumber(tokens, index);
                index++;
            } else if (operator.equals("minus")) {
                index++;
                result -= parseNumber(tokens, index);
                index++;
            } else if (operator.equals("multiplied")) {
                if (index + 1 >= tokens.length || !tokens[index + 1].equals("by")) {
                    throw new IllegalArgumentException("I'm sorry, I don't understand the question!");
                }

                index += 2;
                result *= parseNumber(tokens, index);
                index++;
            } else if (operator.equals("divided")) {
                if (index + 1 >= tokens.length || !tokens[index + 1].equals("by")) {
                    throw new IllegalArgumentException("I'm sorry, I don't understand the question!");
                }

                index += 2;
                int divisor = parseNumber(tokens, index);

                if (divisor == 0) {
                    throw new IllegalArgumentException("I'm sorry, I don't understand the question!");
                }

                result /= divisor;
                index++;
            } else {
                throw new IllegalArgumentException("I'm sorry, I don't understand the question!");
            }
        }

        if (index != tokens.length) {
            throw new IllegalArgumentException("I'm sorry, I don't understand the question!");
        }

        return result;
    }

    private int parseNumber(final String[] tokens, final int index) {
        if (index < 0 || index >= tokens.length) {
            throw new IllegalArgumentException("I'm sorry, I don't understand the question!");
        }

        try {
            return Integer.parseInt(tokens[index]);
        } catch (NumberFormatException e) {
            throw new IllegalArgumentException("I'm sorry, I don't understand the question!", e);
        }
    }
}
