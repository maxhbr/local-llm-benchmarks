def test_empty_input(self):
    with self.assertRaises(ValueError) as err:
        parse("")
    self.assertEqual(str(err.exception), "tree missing")

def test_missing_tree(self):
    with self.assertRaises(ValueError) as err:
        parse(";FF[4]")
    self.assertEqual(str(err.exception), "tree missing")

def test_tree_without_nodes(self):
    with self.assertRaises(ValueError) as err:
        parse("()")
    self.assertEqual(str(err.exception), "tree with no nodes")

def test_properties_without_delimiter(self):
    with self.assertRaises(ValueError) as err:
        parse("(;FF)")
    self.assertEqual(str(err.exception), "properties without delimiter")

def test_property_not_uppercase(self):
    with self.assertRaises(ValueError) as err:
        parse("(;ff[4])")
    self.assertEqual(str(err.exception), "property must be in uppercase")

def test_simple_parse(self):
    actual = parse("(;FF[4]C[root]SZ[19])")
    expected = SgfTree(properties={'FF': '4', 'C': 'root', 'SZ': '19'})
    self.assertEqual(actual, expected)

def test_parse_child(self):
    actual = parse("(;FF[4]C[root]SZ[19];B[aa];W[ab])")
    expected = SgfTree(properties={'FF': '4', 'C': 'root', 'SZ': '19'}, children=[SgfTree(properties={'B': 'aa'}, children=[SgfTree(properties={'W': 'ab'})])])
    self.assertEqual(actual, expected)

def test_parse_variations(self):
    actual = parse("(;FF[4](;B[aa];W[ab])(;B[dd];W[ee]))")
    expected = SgfTree(properties={'FF': '4'}, children=[SgfTree(properties={'B': 'aa'}, children=[SgfTree(properties={'W': 'ab'})]), SgfTree(properties={'B': 'dd'}, 
children=[SgfTree(properties={'W': 'ee'})])])
    self.assertEqual(actual, expected)

def test_parse_multiple_values(self):
    actual = parse("(;FF[4];AB[aa][ab][ba])")
    expected = SgfTree(properties={'FF': '4', 'AB': 'aaabba'})
    self.assertEqual(actual, expected)
```
