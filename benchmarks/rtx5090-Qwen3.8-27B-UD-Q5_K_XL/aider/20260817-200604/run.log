Potential final code:
```
package markdown

import (
    "fmt"
    "regexp"
    "strings"
)

var (
    strongRe = regexp.MustCompile(`__([^_]+)__`)
    emRe     = regexp.MustCompile(`_([^_]+)_`)
)

// Render translates markdown to HTML.
func Render(markdown string) string {
    if markdown == "" {
        return ""
    }
    var b strings.Builder
    var listItems []string

    flushList := func() {
        if len(listItems) == 0 {
            return
        }
        b.WriteString("<ul>")
        for _, item := range listItems {
            fmt.Fprintf(&b, "<li>%s</li>", item)
        }
        b.WriteString("</ul>")
        listItems = nil
    }

    for _, line := range strings.Split(markdown, "\n") {
        if line == "" {
            flushList()
            continue
        }
        if level, text, ok := parseHeader(line); ok {
            flushList()
            if level == 7 {
                fmt.Fprintf(&b, "<p>%s</p>", applyEmphasis(line))
            } else {
                fmt.Fprintf(&b, "<h%d>%s</h%d>", level, applyEmphasis(text), level)
            }
            continue
        }
        if item, ok := parseListItem(line); ok {
            listItems = append(listItems, applyEmphasis(item))
            continue
        }
        flushList()
        fmt.Fprintf(&b, "<p>%s</p>", applyEmphasis(line))
    }
    flushList()
    return b.String()
}

func parseHeader(line string) (int, string, bool) {
    if !strings.HasPrefix(line, "#") { return 0, "", false }
    level := 0
    for level < len(line) && line[level] == '#' { level++ }
    if level < 1 || level > 7 { return 0, "", false }
    if level == len(line) { return level, "", true }
    if line[level] != ' ' { return 0, "", false }
    return level, line[level+1:], true
}

func parseListItem(line string) (string, bool) {
    if line == "*" { return "", true }
    if strings.HasPrefix(line, "* ") { return line[2:], true }
    return "", false
}

func applyEmphasis(s string) string {
    s = strongRe.ReplaceAllString(s, `<strong>$1</strong>`)
    s = emRe.ReplaceAllString(s, `<em>$1</em>`)
    return s
}
```

