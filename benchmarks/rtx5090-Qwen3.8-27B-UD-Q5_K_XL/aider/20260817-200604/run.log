Ensure no ellipsis. Code:
```
from collections import Counter

def total(basket):
    counts = sorted(Counter(basket).values(), reverse=True)
    counts = (counts + [0] * 5)[:5]

    c1, c2, c3, c4, c5 = counts

    one = c1 - c2
    two = c2 - c3
    three = c3 - c4
    four = c4 - c5
    five = c5

    # A 5-book group and a 3-book group can be regrouped as two 4-book groups
    # for a better discount.
    swap = min(five, three)

    return (
        one * 800
        + two * 1520
        + (three - swap) * 2160
        + (four + 2 * swap) * 2560
        + (five - swap) * 3000
    )
```

