use std::convert::TryFrom;

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
#[allow(dead_code)]
enum Operation {
    Add,
    Sub,
    Mul,
    Div,
    Pow,
}

pub fn answer(command: &str) -> Option<i32> {
    let command = command.trim();
    let expression = command.strip_prefix("What is ")?;
    let expression = expression.strip_suffix('?')?;
    let tokens: Vec<&str> = expression.split_whitespace().collect();

    let mut index = 0;
    let mut value = parse_number(tokens.get(0)?.copied())?;
    index = 1;

    while index < tokens.len() {
        let operation = parse_operation(&tokens, &mut index)?;
        let operand = parse_number(tokens.get(index)?.copied())?;
        index += 1;
        value = apply(value, operation, operand)?;
    }

    i32::try_from(value).ok()
}

fn parse_number(token: &str) -> Option<i128> {
    token.parse::<i128>().ok()
}

fn parse_operation(tokens: &[&str], index: &mut usize) -> Option<Operation> {
    let token = tokens.get(*index)?.copied();

    if token == "plus" {
        *index += 1;
        Some(Operation::Add)
    } else if token == "minus" {
        *index += 1;
        Some(Operation::Sub)
    } else if token == "multiplied" && tokens.get(*index + 1).copied() == Some("by") {
        *index += 2;
        Some(Operation::Mul)
    } else if token == "divided" && tokens.get(*index + 1).copied() == Some("by") {
        *index += 2;
        Some(Operation::Div)
    } else {
        #[cfg(feature = "exponentials")]
        {
            if token == "raised"
                && tokens.get(*index + 1).copied() == Some("to")
                && tokens.get(*index + 2).copied() == Some("the")
                && tokens.get(*index + 3).copied() == Some("power")
                && tokens.get(*index + 4).copied() == Some("of")
            {
                *index += 5;
                Some(Operation::Pow)
            } else {
                None
            }
        }
        #[cfg(not(feature = "exponentials"))]
        {
            None
        }
    }
}

fn apply(value: i128, operation: Operation, operand: i128) -> Option<i128> {
    match operation {
        Operation::Add => value.checked_add(operand),
        Operation::Sub => value.checked_sub(operand),
        Operation::Mul => value.checked_mul(operand),
        Operation::Div => {
            if operand == 0 {
                None
            } else {
                value.checked_div(operand)
            }
        }
        Operation::Pow => {
            if operand < 0 {
                None
            } else {
                let exponent = u32::try_from(operand).ok()?;
                value.checked_pow(exponent)
            }
        }
    }
}
```
