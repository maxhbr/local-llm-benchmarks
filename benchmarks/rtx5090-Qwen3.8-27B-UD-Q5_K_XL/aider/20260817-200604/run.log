}

int modifier(int score) {
    int value = score - 10;
    if (value >= 0) {
        return value / 2;
    }
    return (value - 1) / 2;
}

int Character::ability() {
    return ::dnd_character::ability();
}

int Character::modifier(int score) {
    return ::dnd_character::modifier(score);
}

Character::Character()
    : strength(ability()),
      dexterity(ability()),
      constitution(ability()),
      intelligence(ability()),
      wisdom(ability()),
      charisma(ability()) {
    hitpoints = 10 + modifier(constitution);
}

}  // namespace dnd_character
