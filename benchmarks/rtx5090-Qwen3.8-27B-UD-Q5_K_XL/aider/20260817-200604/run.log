Code outline:
```
use std::collections::HashSet;
use std::sync::{Mutex, MutexGuard};
use std::time::{SystemTime, UNIX_EPOCH};

pub struct Robot {
    name: String,
}

struct NameState {
    active: HashSet<String>,
    state: u64,
}

static STATE: Mutex<Option<NameState>> = Mutex::new(None);

impl NameState {
    fn new() -> Self {
        let mut seed = SystemTime::now()
            .duration_since(UNIX_EPOCH)
            .map(|d| d.as_nanos() as u64)
            .unwrap_or(0x9e3779b97f4a7c15)
            ^ (std::process::id() as u64).wrapping_mul(0xbf58476d1ce4e5b9)
            ^ (STATE as *const _ as usize).wrapping_mul(0x94d049bb133111eb) as u64;
        if seed == 0 { seed = 0x9e3779b97f4a7c15; }
        NameState { active: HashSet::new(), state: seed }
    }

    fn next_u64(&mut self) -> u64 { ... }

    fn generate_name(&mut self, exclude: Option<&str>) -> String {
        loop {
            let value = self.next_u64();
            let index = (value % 676_000) as usize;
            let letters = index / 1000;
            let digits = index % 1000;
            let first = (b'A' + (letters / 26) as u8) as char;
            let second = (b'A' + (letters % 26) as u8) as char;
            let name = format!("{}{}{:03}", first, second, digits);
            if name != exclude.unwrap_or("") && !self.active.contains(&name) {
                self.active.insert(name.clone());
                return name;
            }
        }
    }
}

fn with_state<F, R>(f: F) -> R where F: FnOnce(&mut NameState) -> R {
    let mut guard = STATE.lock().unwrap_or_else(|e| e.into_inner());
    if guard.is_none() {
        *guard = Some(NameState::new());
    }
    f(guard.as_mut().unwrap())
}

impl Robot {
    pub fn new() -> Self {
        let name = with_state(|state| state.generate_name(None));
        Robot { name }
    }

    pub fn name(&self) -> &str {
        &self.name
    }

    pub fn reset_name(&mut self) {
        let old = self.name.clone();
        let new = with_state(|state| {
            // old should be active, but exclude to be safe
            state.generate_name(Some(&old))
        });
        with_state(|state| {
            state.active.remove(&old);
            // new already inserted by generate_name
        });
        self.name = new;
    }
}

impl Drop for Robot {
    fn drop(&mut self) {
        let name = self.name.clone();
        with_state(|state| {
            state.active.remove(&name);
        });
    }
}
```

