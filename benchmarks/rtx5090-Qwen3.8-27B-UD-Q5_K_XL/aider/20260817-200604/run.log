func replacePairs(s, delim, open, close string) string {
    var b strings.Builder
    i := 0
    for i < len(s) {
        if idx := strings.Index(s[i:], delim); idx != -1 {
            start := i + idx
            b.WriteString(s[i:start])
            b.WriteString(open)
            i = start + len(delim)
