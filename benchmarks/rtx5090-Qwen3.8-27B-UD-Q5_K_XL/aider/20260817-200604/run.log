import random
import string

class Robot:
    _used_names = set()
    _rng = random.SystemRandom()

    def __init__(self):
        self._name = None

    @property
    def name(self):
        if self._name is None:
            self._name = self._generate_name()
        return self._name

    def reset(self):
        self._name = None

    @classmethod
    def _generate_name(cls):
        while True:
            name = ''.join(cls._rng.choice(string.ascii_uppercase) for _ in range(2)) + \
                   ''.join(cls._rng.choice(string.digits) for _ in range(3))
            if name not in cls._used_names:
                cls._used_names.add(name)
                return name
```
