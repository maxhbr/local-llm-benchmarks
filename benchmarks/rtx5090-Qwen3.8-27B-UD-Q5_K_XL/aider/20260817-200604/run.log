fn choose_use_flats(tonic: &Tonic, steps: &[u8], pcs: &[u8]) -> bool {
   let sharp_count = count_accidentals(pcs, false);
   let flat_count = count_accidentals(pcs, true);
   if flat_count < sharp_count { return true; }
   if sharp_count < flat_count { return false; }
   conventional_use_flats(tonic, steps)
}
