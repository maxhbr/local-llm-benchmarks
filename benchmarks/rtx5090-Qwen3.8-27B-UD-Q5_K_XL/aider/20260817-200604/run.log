```
package erratum

import "fmt"

func Use(opener ResourceOpener, input string) (err error) {
	isTransient := func(e error) bool {
		for e != nil {
			if _, ok := e.(TransientError); ok {
				return true
			}
			if _, ok := e.(*TransientError); ok {
				return true
			}
			if u, ok := e.(interface{ Unwrap() error }); ok {
				e = u.Unwrap()
				continue
			}
			return false
		}
		return false
	}

	asError := func(v interface{}) error {
		if e, ok := v.(error); ok {
			return e
		}
		return fmt.Errorf("panic: %v", v)
	}

	resource, err := opener()
	for err != nil {
		if !isTransient(err) {
			return err
		}
		resource, err = opener()
	}

	defer resource.Close()

	defer func() {
		if r := recover(); r != nil {
			switch e := r.(type) {
			case FrobError:
				resource.Defrob(e.defrobTag)
				err = asError(e)
			case *FrobError:
				resource.Defrob(e.defrobTag)
				err = asError(e)
			default:
				err = asError(e)
			}
		}
	}()

	resource.Frob(input)
	return nil
}
