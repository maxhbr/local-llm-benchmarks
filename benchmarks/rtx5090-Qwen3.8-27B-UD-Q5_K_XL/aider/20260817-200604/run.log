private static String formatDouble(double value) {
    if (Double.isNaN(value) || Double.isInfinite(value)) return Double.toString(value);
    BigDecimal bd = BigDecimal.valueOf(value).setScale(2, RoundingMode.HALF_UP);
    if (bd.signum() == 0) bd = BigDecimal.ZERO.setScale(2); // to avoid -0.00
    double d = bd.doubleValue();
    if (d == 0.0) d = 0.0;
    return Double.toString(d);
}
