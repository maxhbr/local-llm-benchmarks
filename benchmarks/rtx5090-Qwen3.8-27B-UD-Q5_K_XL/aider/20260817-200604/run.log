function invokeCallback(callback, value) {
  if (typeof callback === 'function') {
    callback(value);
  } else if (callback && typeof callback.update === 'function') {
    callback.update(value);
  } else if (callback && typeof callback.fn === 'function') {
    callback.value = value;
    callback.fn(value);
  }
}

function getTopologicalOrder(startCell) {
  const reachable = new Set();
  const discovery = [];

  const collect = (cell) => {
    if (cell instanceof InputCell) {
      for (const dependent of cell.dependents) {
        collect(dependent);
      }
      return;
    }

    if (cell instanceof ComputeCell) {
      if (reachable.has(cell)) {
        return;
      }

      reachable.add(cell);
      discovery.push(cell);

      for (const dependent of cell.dependents) {
        collect(dependent);
      }
    }
  };

  collect(startCell);

  const inDegree = new Map();
  const edges = new Map();

  for (const cell of discovery) {
    inDegree.set(cell, 0);
    edges.set(cell, []);
  }

  for (const cell of discovery) {
    for (const inputCell of cell.inputCells) {
      if (inputCell instanceof ComputeCell && reachable.has(inputCell)) {
        inDegree.set(cell, inDegree.get(cell) + 1);
        edges.get(inputCell).push(cell);
      }
    }
  }

  const queue = discovery.filter((cell) => inDegree.get(cell) === 0);
  const sorted = [];

  while (queue.length > 0) {
    const cell = queue.shift();
    sorted.push(cell);

