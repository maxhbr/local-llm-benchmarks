zebra_puzzle.go
```
package zebra

type Solution struct {
	DrinksWater string
	OwnsZebra   string
}

func SolvePuzzle() Solution {
	nationalities := []string{"Englishman", "Spaniard", "Ukrainian", "Norwegian", "Japanese"}
	colors := []string{"Red", "Green", "Ivory", "Yellow", "Blue"}
	pets := []string{"Dog", "Snails", "Fox", "Horse", "Zebra"}
	drinks := []string{"Coffee", "Tea", "Milk", "OrangeJuice", "Water"}
	smokes := []string{"OldGold", "Kools", "Chesterfields", "LuckyStrike", "Parliaments"}

	natPerms := permutations(nationalities)
	colorPerms := permutations(colors)
	drinkPerms := permutations(drinks)
	smokePerms := permutations(smokes)
	petPerms := permutations(pets)

	for _, nat := range natPerms {
		if nat[0] != "Norwegian" {
			continue
		}

		for _, color := range colorPerms {
			if !greenRightOfIvory(color) ||
				!norwegianNextToBlue(nat, color) ||
				!englishInRed(nat, color) {
				continue
			}

			for _, drink := range drinkPerms {
				if drink[2] != "Milk" ||
					!ukrainianDrinksTea(nat, drink) ||
					!coffeeInGreen(color, drink) {
					continue
				}

				for _, smoke := range smokePerms {
					if !koolsInYellow(color, smoke) ||
						!japaneseSmokesParliaments(nat, smoke) ||
						!luckyStrikeDrinksOrangeJuice(drink, smoke) {
						continue
					}

					for _, pet := range petPerms {
						if !spaniardOwnsDog(nat, pet) ||
							!oldGoldOwnsSnails(smoke, pet) ||
							!chesterfieldsNextToFox(smoke, pet) ||
							!koolsNextToHorse(smoke, pet) {
							continue
						}

						return answers(nat, drink, pet)
					}
				}
			}
		}
	}

	return Solution{}
}

func permutations(items []string) [][]string {
	var result [][]string
	var current []string
	used := make([]bool, len(items))

	var permute func()
	permute = func() {
		if len(current) == len(items) {
			perm := make([]string, len(current))
			copy(perm, current)
			result = append(result, perm)
			return
		}

		for i := range items {
			if used[i] {
				continue
			}

			used[i] = true
			current = append(current, items[i])
			permute()
			current = current[:len(current)-1]
			used[i] = false
		}
	}

	permute()
	return result
}

func indexOf(values []string, target string) int {
	for i, value := range values {
		if value == target {
			return i
		}
	}
	return -1
}

func greenRightOfIvory(colors []string) bool {
	i := indexOf(colors, "Ivory")
	return i >= 0 && i+1 < len(colors) && colors[i+1] == "Green"
}

func norwegianNextToBlue(nationalities, colors []string) bool {
	i := indexOf(nationalities, "Norwegian")
	if i < 0 {
		return false
	}

	if i > 0 && colors[i-1] == "Blue" {
		return true
	}

	return i+1 < len(colors) && colors[i+1] == "Blue"
}

func englishInRed(nationalities, colors []string) bool {
	i := indexOf(nationalities, "Englishman")
	return i >= 0 && colors[i] == "Red"
}

func ukrainianDrinksTea(nationalities, drinks []string) bool {
	i := indexOf(nationalities, "Ukrainian")
	return i >= 0 && drinks[i] == "Tea"
}

func coffeeInGreen(colors, drinks []string) bool {
	i := indexOf(colors, "Green")
	return i >= 0 && drinks[i] == "Coffee"
}

func koolsInYellow(colors, smokes []string) bool {
	i := indexOf(colors, "Yellow")
	return i >= 0 && smokes[i] == "Kools"
}

func japaneseSmokesParliaments(nationalities, smokes []string) bool {
	i := indexOf(nationalities, "Japanese")
	return i >= 0 && smokes[i] == "Parliaments"
}

func luckyStrikeDrinksOrangeJuice(drinks, smokes []string) bool {
	i := indexOf(smokes, "LuckyStrike")
	return i >= 0 && drinks[i] == "OrangeJuice"
}

func spaniardOwnsDog(nationalities, pets []string) bool {
	i := indexOf(nationalities, "Spaniard")
	return i >= 0 && pets[i] == "Dog"
}

func oldGoldOwnsSnails(smokes, pets []string) bool {
	i := indexOf(smokes, "OldGold")
	return i >= 0 && pets[i] == "Snails"
}

func chesterfieldsNextToFox(smokes, pets []string) bool {
	i := indexOf(smokes, "Chesterfields")
	if i < 0 {
		return false
	}

	if i > 0 && pets[i-1] == "Fox" {
		return true
	}

	return i+1 < len(pets) && pets[i+1] == "Fox"
}

func koolsNextToHorse(smokes, pets []string) bool {
	i := indexOf(smokes, "Kools")
	if i < 0 {
		return false
	}

	if i > 0 && pets[i-1] == "Horse" {
		return true
	}

	return i+1 < len(pets) && pets[i+1] == "Horse"
}

func answers(nationalities, drinks, pets []string) Solution {
	var waterDrinker string
	var zebraOwner string

	for i := range nationalities {
		if drinks[i] == "Water" {
			waterDrinker = nationalities[i]
		}

		if pets[i] == "Zebra" {
			zebraOwner = nationalities[i]
		}
	}

	return Solution{
		DrinksWater: waterDrinker,
		OwnsZebra:   zebraOwner,
	}
}
