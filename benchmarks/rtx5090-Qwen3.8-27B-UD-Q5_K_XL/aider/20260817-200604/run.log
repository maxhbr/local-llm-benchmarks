```
//
// This is only a SKELETON file...
//

function toArrayLike(value) {
  if (value instanceof List) {
    return value.values;
  }

  if (
    value !== null &&
    typeof value === 'object' &&
    typeof value.length === 'number'
  ) {
    return value;
  }

  return null;
}

function copyItems(value) {
  const source = toArrayLike(value);
  const result = [];
  const length = source ? source.length : 0;

  for (let i = 0; i < length; i += 1) {
    result[i] = source[i];
  }

  return result;
}

function flattenOneLevel(value) {
  const source = toArrayLike(value);
  const result = [];
  const length = source ? source.length : 0;
  let index = 0;

  for (let i = 0; i < length; i += 1) {
    const item = source[i];
    const inner = toArrayLike(item);

    if (inner) {
      const innerLength = inner.length;
      for (let j = 0; j < innerLength; j += 1) {
        result[index] = inner[j];
        index += 1;
      }
    } else {
      result[index] = item;
      index += 1;
    }
  }

  return result;
}

export class List {
  constructor(values = []) {
    this.values = copyItems(values);
  }

  append(list) {
    const other = toArrayLike(list);
    const result = [];
    let index = 0;

    for (let i = 0; i < this.values.length; i += 1) {
      result[index] = this.values[i];
      index += 1;
    }

    if (other) {
      for (let i = 0; i < other.length; i += 1) {
        result[index] = other[i];
        index += 1;
      }
    }

    return new List(result);
  }

  concat(list) {
    if (list === undefined) {
      return new List(flattenOneLevel(this.values));
    }

    const result = copyItems(this.values);
    const flattened = flattenOneLevel(list);
    let index = result.length;

    for (let i = 0; i < flattened.length; i += 1) {
      result[index] = flattened[i];
      index += 1;
    }

    return new List(result);
  }

  filter(predicate) {
    const result = [];
    let index = 0;

    for (let i = 0; i < this.values.length; i += 1) {
      const item = this.values[i];

      if (predicate(item)) {
        result[index] = item;
        index += 1;
      }
    }

    return new List(result);
  }

  map(fn) {
    const result = [];

    for (let i = 0; i < this.values.length; i += 1) {
      result[i] = fn(this.values[i]);
    }

    return new List(result);
  }

  length() {
    return this.values.length;
  }

  foldl(fn, accumulator) {
    let result = accumulator;

    for (let i = 0; i < this.values.length; i += 1) {
      result = fn(result, this.values[i]);
    }

    return result;
  }

  foldr(fn, accumulator) {
    let result = accumulator;

    for (let i = this.values.length - 1; i >= 0; i -= 1) {
      result = fn(result, this.values[i]);
    }

    return result;
  }

  reverse() {
    const result = [];
    const length = this.values.length;

    for (let i = 0; i < length; i += 1) {
      result[length - 1 - i] = this.values[i];
    }

    return new List(result);
  }
}
```

