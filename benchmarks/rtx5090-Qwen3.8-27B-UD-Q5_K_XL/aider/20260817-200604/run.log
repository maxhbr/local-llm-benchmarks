TwoBucket.java
```
import java.util.ArrayDeque;
import java.util.HashSet;
import java.util.Queue;
import java.util.Set;

class TwoBucket {
    private final int bucketOneCap;
    private final int bucketTwoCap;
    private final int desiredLiters;
    private final String startBucket;

    private int totalMoves;
    private String finalBucket;
    private int otherBucket;

    TwoBucket(int bucketOneCap, int bucketTwoCap, int desiredLiters, String startBucket) {
        this.bucketOneCap = bucketOneCap;
        this.bucketTwoCap = bucketTwoCap;
        this.desiredLiters = desiredLiters;
        this.startBucket = startBucket;

        if (bucketOneCap < 0 || bucketTwoCap < 0 || desiredLiters < 0) {
            throw new IllegalArgumentException("Capacities and desired liters must be non-negative.");
        }

        if (startBucket == null || (!startBucket.equals("one") && !startBucket.equals("two"))) {
            throw new IllegalArgumentException("Start bucket must be \"one\" or \"two\".");
        }

        if (desiredLiters == 0) {
            this.totalMoves = 0;
            this.finalBucket = startBucket;
            this.otherBucket = 0;
            return;
        }

        if (desiredLiters > Math.max(bucketOneCap, bucketTwoCap)) {
            throw new IllegalArgumentException("No solution possible.");
        }

        int gcd = gcd(bucketOneCap, bucketTwoCap);
        if (gcd == 0 || desiredLiters % gcd != 0) {
            throw new IllegalArgumentException("No solution possible.");
        }

        solve();
    }

    int getTotalMoves() {
        return totalMoves;
    }

    String getFinalBucket() {
        return finalBucket;
    }

    int getOtherBucket() {
        return otherBucket;
    }

    private void solve() {
        int startOne = startBucket.equals("one") ? bucketOneCap : 0;
        int startTwo = startBucket.equals("one") ? 0 : bucketTwoCap;

        Queue<int[]> queue = new ArrayDeque<>();
        Set<Long> visited = new HashSet<>();

        if (!isForbidden(startOne, startTwo)) {
            queue.add(new int[]{startOne, startTwo, 1});
            visited.add(key(startOne, startTwo));
        }

        while (!queue.isEmpty()) {
            int[] current = queue.poll();
            int one = current[0];
            int two = current[1];
            int moves = current[2];

            if (one == desiredLiters) {
                this.totalMoves = moves;
                this.finalBucket = "one";
                this.otherBucket = two;
                return;
            }

            if (two == desiredLiters) {
                this.totalMoves = moves;
                this.finalBucket = "two";
                this.otherBucket = one;
                return;
            }

            addState(queue, visited, one, two, moves, bucketOneCap, two);
            addState(queue, visited, one, two, moves, one, bucketTwoCap);
            addState(queue, visited, one, two, moves, 0, two);
            addState(queue, visited, one, two, moves, one, 0);

            int pourOneToTwo = Math.min(one, bucketTwoCap - two);
            addState(queue, visited, one, two, moves, one - pourOneToTwo, two + pourOneToTwo);

            int pourTwoToOne = Math.min(two, bucketOneCap - one);
            addState(queue, visited, one, two, moves, one + pourTwoToOne, two - pourTwoToOne);
        }

        throw new IllegalArgumentException("No solution possible.");
    }

    private void addState(
            Queue<int[]> queue,
            Set<Long> visited,
            int currentOne,
            int currentTwo,
            int moves,
            int nextOne,
            int nextTwo
    ) {
        if (nextOne < 0 || nextOne > bucketOneCap || nextTwo < 0 || nextTwo > bucketTwoCap) {
            return;
        }

        if (nextOne == currentOne && nextTwo == currentTwo) {
            return;
        }

        if (isForbidden(nextOne, nextTwo)) {
            return;
        }

        long stateKey = key(nextOne, nextTwo);
        if (visited.add(stateKey)) {
            queue.add(new int[]{nextOne, nextTwo, moves + 1});
        }
    }

    private boolean isForbidden(int one, int two) {
        if (startBucket.equals("one")) {
            return one == 0 && two == bucketTwoCap;
        }
        return one == bucketOneCap && two == 0;
    }

    private long key(int one, int two) {
        return (((long) one) << 32) | (two & 0xffffffffL);
    }

    private static int gcd(int a, int b) {
        a = Math.abs(a);
        b = Math.abs(b);

        while (b != 0) {
            int temp = a % b;
            a = b;
            b = temp;
        }

        return a;
    }
}
