        String[] cleanedRows = new String[this.rows];
        int maxCols = 0;

        for (int r = 0; r < this.rows; r++) {
            String row = board[r] == null ? "" : board[r];
            StringBuilder cleaned = new StringBuilder();

            for (int i = 0; i < row.length(); i++) {
