export const tournamentTally = (input) => {
  const teams = new Map();
  const getTeam = (name) => {
    if (!teams.has(name)) teams.set(name, { name, mp: 0, w: 0, d: 0, l: 0, p: 0 });
    return teams.get(name);
  };

  if (input) {
    for (const line of input.split('\n')) {
      const trimmed = line.trim();
      if (!trimmed) continue;
      const [home, away, result] = trimmed.split(';');
      const homeTeam = getTeam(home);
      const awayTeam = getTeam(away);
      homeTeam.mp += 1;
      awayTeam.mp += 1;
      if (result === 'win') { homeTeam.w += 1; homeTeam.p += 3; awayTeam.l += 1; }
      else if (result === 'loss') { homeTeam.l += 1; awayTeam.w += 1; awayTeam.p += 3; }
      else if (result === 'draw') { homeTeam.d += 1; awayTeam.d += 1; homeTeam.p += 1; awayTeam.p += 1; }
    }
  }

  const sorted = [...teams.values()].sort((a, b) => b.p - a.p || a.name.localeCompare(b.name));
  const header = 'Team'.padEnd(30) + ' | MP |  W |  D |  L |  P';
  const rows = sorted.map(t => `${t.name.padEnd(30)} | ${String(t.mp).padStart(2)} | ${String(t.w).padStart(2)} | ${String(t.d).padStart(2)} | 
${String(t.l).padStart(2)} | ${String(t.p).padStart(2)}`);
  return [header, ...rows].join('\n');
};
```

