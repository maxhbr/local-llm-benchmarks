public class Transpose {
    public String transpose(String toTranspose) {
        if (toTranspose == null) {
            return "";
        }
        String normalized = toTranspose.replace("\r\n", "\n").replace("\r", "\n");
        String[] rows = normalized.split("\n", -1);
        int maxLen = 0;
        for (String row : rows) {
            if (row.length() > maxLen) maxLen = row.length();
        }
        if (maxLen == 0) return "";
        StringBuilder transposed = new StringBuilder();
        for (int col = 0; col < maxLen; col++) {
            int lastRow = -1;
            for (int row = 0; row < rows.length; row++) {
                if (rows[row].length() > col) {
                    lastRow = row;
                }
            }
            if (lastRow == -1) continue; // shouldn't if col<maxLen
            for (int row = 0; row <= lastRow; row++) {
                if (rows[row].length() > col) {
                    transposed.append(rows[row].charAt(col));
                } else {
                    transposed.append(' ');
                }
            }
            if (col < maxLen - 1) {
                transposed.append('\n');
            }
        }
        return transposed.toString();
    }
}

