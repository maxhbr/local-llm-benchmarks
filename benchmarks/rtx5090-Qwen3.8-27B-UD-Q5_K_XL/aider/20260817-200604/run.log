```
class BinaryTree {
    private final Zipper root;

    BinaryTree(int value) {
        this.root = new Zipper(value);
    }

    BinaryTree(Zipper root) {
        this.root = root;
    }

    Zipper getRoot() {
        return root;
    }

    String printTree() {
        return printTree(root, 0);
    }

    private String printTree(Zipper zipper, int level) {
        if (zipper == null) {
            return "";
        }
        StringBuilder sb = new StringBuilder();
        sb.append("  ".repeat(level)).append(zipper.getValue()).append("\n");
        sb.append(printTree(zipper.left, level + 1));
        sb.append(printTree(zipper.right, level + 1));
        return sb.toString();
    }
}
```
