phone_number.cpp:
```
#include "phone_number.h"

#include <stdexcept>
#include <string>

namespace phone_number {

namespace {

bool is_digit(char c) {
    return c >= '0' && c <= '9';
}

}  // namespace

phone_number::phone_number(const std::string& number) {
    std::string digits;
    digits.reserve(number.size());

    for (char c : number) {
        if (is_digit(c)) {
            digits.push_back(c);
        }
    }

    if (digits.size() == 11) {
        if (digits.front() != '1') {
            throw std::domain_error("11-digit number must start with 1");
        }
        digits.erase(digits.begin());
    }

    if (digits.size() != 10) {
        throw std::domain_error("number must be 10 digits");
    }

    if (digits[0] < '2') {
        throw std::domain_error("area code must start with 2-9");
    }

    if (digits[3] < '2') {
        throw std::domain_error("exchange code must start with 2-9");
    }

    number_ = digits;
}

std::string phone_number::number() const {
    return number_;
}

std::string phone_number::area_code() const {
    return number_.substr(0, 3);
}

std::string phone_number::pretty() const {
    return "(" + number_.substr(0, 3) + ") " + number_.substr(3, 3) + "-" + number_.substr(6);
}

}  // namespace phone_number
```

