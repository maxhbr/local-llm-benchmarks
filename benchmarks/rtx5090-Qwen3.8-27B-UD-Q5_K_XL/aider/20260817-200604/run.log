      if (minDp[t+1] === null || valMin < minDp[t+1]) minDp[t+1] = valMin;
      if (maxDp[t] === null) continue;
      const valMax = maxDp[t] + coeffs[t] * bd;
      if (maxDp[t+1] === null || valMax > maxDp[t+1]) maxDp[t+1] = valMax;
