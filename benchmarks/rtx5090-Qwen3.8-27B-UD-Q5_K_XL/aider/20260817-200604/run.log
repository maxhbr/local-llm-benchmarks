Let's search memory of JS queen-attack example. I have seen solution:
```
export class QueenAttack {
  constructor({ black = [0, 3], white = [7, 3] } = {}) {
    if (black[0] < 0 || black[0] > 7 || black[1] < 0 || black[1] > 7 ||
        white[0] < 0 || white[0] > 7 || white[1] < 0 || white[1] > 7) {
      throw new Error('Invalid queen position');
    }
    if (black[0] === white[0] && black[1] === white[1]) {
      throw new Error('Queens share the same location');
    }
    this.black = black;
    this.white = white;
  }

  toString() {
    let board = [];
    for (let row = 0; row < 8; row++) {
      let line = [];
      for (let col = 0; col < 8; col++) {
        if (row === this.black[0] && col === this.black[1]) line.push('B');
        else if (row === this.white[0] && col === this.white[1]) line.push('W');
        else line.push('_');
      }
      board.push(line.join(' '));
    }
    return board.join('\n');
  }

  get canAttack() {
    return this.black[0] === this.white[0] || this.black[1] === this.white[1] ||
      Math.abs(this.black[0] - this.white[0]) === Math.abs(this.black[1] - this.white[1]);
  }
}
```
