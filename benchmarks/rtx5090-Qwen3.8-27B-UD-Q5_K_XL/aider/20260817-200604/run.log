fn is_game_complete(rolls: &[u16]) -> bool {
    let mut i = 0;
    for frame in 0..10 {
        if frame < 9 {
            if i >= rolls.len() { return false; }
            if rolls[i] == 10 { i += 1; }
            else {
                if i + 1 >= rolls.len() { return false; }
                i += 2;
            }
        } else {
            // 10th frame
            if i >= rolls.len() { return false; }
