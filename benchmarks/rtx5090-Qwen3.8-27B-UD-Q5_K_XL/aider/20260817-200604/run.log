```
react.js
```
//
// This is only a SKELETON file for the 'React' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

function invokeCallback(callback, value) {
  if (typeof callback === 'function') {
    callback(value);
  } else if (callback && typeof callback.update === 'function') {
    callback.update(value);
  } else if (callback && typeof callback.fn === 'function') {
    callback.value = value;
    callback.fn(value);
  }
}

function getTopologicalOrder(startCell) {
  const order = [];
  const visited = new Set();
  const visiting = new Set();

  const visit = (cell) => {
    if (cell instanceof InputCell) {
      for (const dependent of cell.dependents) {
        visit(dependent);
      }
      return;
    }

    if (cell instanceof ComputeCell) {
      if (visited.has(cell) || visiting.has(cell)) {
        return;
      }

      visiting.add(cell);
      for (const dependent of cell.dependents) {
        visit(dependent);
      }
      visiting.delete(cell);
      visited.add(cell);
      order.push(cell);
    }
  };

  visit(startCell);
  return order.reverse();
}

export class InputCell {
  constructor(value) {
    this.value = value;
    this.dependents = [];
  }

  setValue(value) {
    if (this.value === value) {
      return;
    }

    this.value = value;

    const order = getTopologicalOrder(this);
    const changedCells = [];

    for (const cell of order) {
      if (cell.recompute()) {
        changedCells.push(cell);
      }
    }

    for (const cell of changedCells) {
      cell.notify();
    }
  }
}

export class ComputeCell {
  constructor(inputCells, fn) {
    this.inputCells = inputCells;
    this.fn = fn;
    this.value = this.compute();
    this.callbacks = [];
    this.dependents = [];

    for (const inputCell of this.inputCells) {
      if (inputCell && Array.isArray(inputCell.dependents)) {
        inputCell.dependents.push(this);
      }
    }
  }

  compute() {
    return this.fn(...this.inputCells.map((cell) => cell.value));
  }

  recompute() {
    const oldValue = this.value;
    this.value = this.compute();
    return oldValue !== this.value;
  }

  notify() {
    const callbacks = this.callbacks.slice();
    for (const callback of callbacks) {
      invokeCallback(callback, this.value);
    }
  }

  update() {
    if (this.recompute()) {
      this.notify();
    }
  }

  addCallback(callback) {
    this.callbacks.push(callback);
  }

  removeCallback(callback) {
    this.callbacks = this.callbacks.filter((cb) => cb !== callback);
  }
}

export class CallbackCell {
  constructor(fn) {
    this.fn = fn;
    this.value = undefined;
  }

  update(value) {
    this.value = value;
    if (typeof this.fn === 'function') {
      this.fn(value);
    }
  }
}
```

