package bookstore

import "sort"

func Cost(books []int) int {
        counts := make([]int, 5)
        remaining := 0
        for _, book := range books {
                if book >= 1 && book <= 5 {
                        counts[book-1]++
                        remaining++
                }
        }

        prices := [6]int{0, 800, 1520, 2160, 2560, 3000}
        total := 0

        for remaining > 0 {
                sort.Slice(counts, func(i, j int) bool {
                        return counts[i] > counts[j]
                })

                size := 0
                switch {
                case counts[4] == 0:
                        for i := 0; i < 5 && counts[i] > 0; i++ {
                                counts[i]--
                                size++
                        }
                case counts[2] > counts[3]:
                        for i := 0; i < 4; i++ {
                                counts[i]--
                        }
                        size = 4
                default:
                        for i := 0; i < 5; i++ {
                                counts[i]--
                        }
                        size = 5
                }

                total += prices[size]
                remaining -= size
        }

        return total
}

