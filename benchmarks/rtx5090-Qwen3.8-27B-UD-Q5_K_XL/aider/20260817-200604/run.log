Classes:
```
export class InputCell {
  constructor(value) {
    this.value = value;
    this.dependents = [];
  }
  setValue(value) {
    if (this.value === value) return;
    this.value = value;
    updateDependents(this);
  }
}

export class ComputeCell {
  constructor(inputCells, fn) {
    this.inputCells = inputCells;
    this.fn = fn;
    this.value = this.compute();
    this.callbacks = [];
    this.dependents = [];
    for (const cell of inputCells) {
      if (cell && Array.isArray(cell.dependents)) cell.dependents.push(this);
    }
  }
  compute() {
    return this.fn(...this.inputCells.map(cell => cell.value));
  }
  update() {
    const oldValue = this.value;
    this.value = this.compute();
    if (oldValue !== this.value) {
      for (const cb of this.callbacks) invokeCallback(cb, this.value);
    }
  }
  addCallback(cb) { this.callbacks.push(cb); }
  removeCallback(cb) { this.callbacks = this.callbacks.filter(c => c !== cb); }
}

export class CallbackCell {
  constructor(fn) {
    this.fn = fn;
    this.value = undefined;
  }
  update(value) {
    this.value = value;
    if (typeof this.fn === 'function') this.fn(value);
  }
}
```
Need `updateDependents(startInput)`:
```
function updateDependents(start) {
  const order = [];
  const visited = new Set();
  const visiting = new Set();
  function visit(cell) {
    if (cell instanceof InputCell) {
      for (const dep of cell.dependents) visit(dep);
    } else if (cell instanceof ComputeCell) {
      if (visited.has(cell) || visiting.has(cell)) return;
      visiting.add(cell);
      for (const dep of cell.dependents) visit(dep);
      visiting.delete(cell);
      visited.add(cell);
      order.push(cell);
    }
  }
  visit(start);
  for (let i = order.length - 1; i >= 0; i--) order[i].update();
}
```
