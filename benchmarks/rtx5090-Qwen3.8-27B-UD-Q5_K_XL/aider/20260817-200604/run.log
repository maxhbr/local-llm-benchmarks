Let's draft code:
```
package scale

import "strings"

var sharpScale = []string{
    "C", "C#", "D", "D#", "E", "F",
    "F#", "G", "G#", "A", "A#", "B",
}

var flatScale = []string{
    "C", "Db", "D", "Eb", "E", "F",
    "Gb", "G", "Ab", "A", "Bb", "B",
}

func Scale(tonic, interval string) []string {
    note, isMinor := parseTonic(tonic)
    if note == "" {
        return nil
    }

    useFlat := usesFlats(note, isMinor)
    scale := sharpScale
    if useFlat {
        scale = flatScale
    }

    idx := findNote(scale, note)
    if idx == -1 {
        other := flatScale
        if useFlat {
            other = sharpScale
        }
        idx = findNote(other, note)
        if idx != -1 {
            scale = other
        }
    }

    if idx == -1 {
        return []string{note}
    }

    if interval == "" {
        result := make([]string, 0, 12)
        for i := 0; i < 12; i++ {
            result = append(result, scale[(idx+i)%12])
        }
        return result
    }

    result := make([]string, 0, len(interval)+1)
    result = append(result, scale[idx])

    for _, r := range interval {
        step := 0
        switch r {
        case 'm':
            step = 1
        case 'M':
            step = 2
        case 'A', 'a':
            step = 3
        }
        idx = (idx + step) % 12
        result = append(result, scale[idx])
    }

    return result
}

func parseTonic(tonic string) (string, bool) {
    if tonic == "" {
        return "", false
    }

    isMinor := tonic[0] >= 'a' && tonic[0] <= 'z'

    tonic = strings.ReplaceAll(tonic, "\u266f", "#")
    tonic = strings.ReplaceAll(tonic, "\u266d", "b")

    return strings.ToUpper(tonic[:1]) + tonic[1:], isMinor
}

func usesFlats(note string, isMinor bool) bool {
    if isMinor {
        switch note {
        case "C", "D", "F", "G", "Ab", "Bb", "Eb":
            return true
        }
        return false
    }

    switch note {
    case "F", "Bb", "Eb", "Ab", "Db", "Gb":
        return true
    }
    return false
}

func findNote(scale []string, note string) int {
    for i, n := range scale {
        if n == note {
            return i
        }
    }
    return -1
}
```

