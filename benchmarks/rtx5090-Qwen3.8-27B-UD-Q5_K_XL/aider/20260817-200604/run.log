String printTree() {
    List<String> lines = new ArrayList<>();
    collect(root, 0, lines);
    return String.join("\n", lines);
}
private void collect(Zipper z, int depth, List<String> lines) {
    if (z == null) return;
    lines.add("  ".repeat(depth) + z.getValue());
    collect(z.left, depth+1, lines);
    collect(z.right, depth+1, lines);
}
```
