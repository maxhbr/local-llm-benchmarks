```
public Connect(String[] board) {
  this.rows = board == null ? 0 : board.length;
  String[] cleaned = new String[this.rows];
  int maxCols = 0;
  for r: clean, cleaned[r]=s, maxCols=Math.max(maxCols,s.length());
  this.cols = maxCols;
  this.board = new char[this.rows][this.cols];
  for r:
    Arrays.fill(board[r], '.');
    for c=0; c<cleaned[r].length(); c++ board[r][c]=cleaned[r].charAt(c);
}
```
