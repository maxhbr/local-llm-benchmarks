```
def translate(text):
    vowels = set('aeiou')

    def word_to_pig_latin(word):
        if not word:
            return word
        lower = word.lower()
        if lower[0] in vowels or lower.startswith('xr') or lower.startswith('yt'):
            return word + 'ay'

        i = 0
        n = len(lower)
        while i < n:
            char = lower[i]
            if char in vowels:
                break
            if char == 'q' and i + 1 < n and lower[i + 1] == 'u':
                i += 2
                break
            if char == 'y' and i > 0:
                break
            i += 1
        return word[i:] + word[:i] + 'ay'

    return ' '.join(word_to_pig_latin(word) for word in text.split())
```

