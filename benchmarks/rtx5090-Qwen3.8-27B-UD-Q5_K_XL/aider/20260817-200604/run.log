    expect(school.roster()).toEqual({});
  });

  test('add a student', () => {
    school.add('Aimee', 2);
    expect(school.roster()).toEqual({ 2: ['Aimee'] });
  });

  test('add another student', () => {
    school.add('Blair', 2);
    school.add('James', 2);
    school.add('Paul', 1);
    expect(school.roster()).toEqual({ 1: ['Paul'], 2: ['Blair', 'James'] });
  });

  test('adding students to different grades in same school', () => {
    school.add('Chelsea', 3);
    school.add('Logan', 7);
    expect(school.roster()).toEqual({ 3: ['Chelsea'], 7: ['Logan'] });
  });

  test('cannot add student to same grade twice', () => {
    expect(school.add('Blair', 2)).toBe(true);
    expect(school.add('Blair', 2)).toBe(false);
  });

  test('cannot add student to different grade', () => {
    expect(school.add('Blair', 2)).toBe(true);
    expect(school.add('Blair', 3)).toBe(false);
  });

  test('grade returns students in grade sorted', () => {
    school.add('Franklin', 5);
    school.add('Bradley', 5);
    school.add('Jeff', 1);
    expect(school.grade(5)).toEqual(['Bradley', 'Franklin']);
  });

  test('grade returns empty array when no students', () => {
