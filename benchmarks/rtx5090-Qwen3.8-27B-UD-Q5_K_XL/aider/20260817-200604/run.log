#include "dnd_character.h"

#include <algorithm>
#include <random>

namespace dnd_character {
namespace {

int roll_ability() {
    static std::mt19937 rng(std::random_device{}());
    std::uniform_int_distribution<int> die(1, 6);

    int rolls[4] = {die(rng), die(rng), die(rng), die(rng)};
    std::sort(rolls, rolls + 4);

    return rolls[1] + rolls[2] + rolls[3];
}

}  // namespace

int ability() {
    return roll_ability();
}

int modifier(int score) {
    int value = score - 10;
    if (value >= 0) {
        return value / 2;
    }
    return (value - 1) / 2;
}

Character::Character()
    : strength(ability()),
      dexterity(ability()),
      constitution(ability()),
      intelligence(ability()),
      wisdom(ability()),
      charisma(ability()) {
    hitpoints = 10 + modifier(constitution);
}

}  // namespace dnd_character
```

