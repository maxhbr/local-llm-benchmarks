RestApi.java
```
import org.json.JSONArray;
import org.json.JSONObject;

import java.math.BigDecimal;
import java.math.RoundingMode;
import java.util.ArrayList;
import java.util.Comparator;
import java.util.List;
import java.util.Map;
import java.util.TreeMap;

class RestApi {
    private final Map<String, User> users;

    RestApi(User... users) {
        this.users = new TreeMap<>();
        for (User user : users) {
            if (user != null && user.name() != null) {
                this.users.put(user.name(), user);
            }
        }
    }

    String get(String url) {
        return get(url, null);
    }

    String get(String url, JSONObject payload) {
        if ("/users".equals(url)) {
            return usersJson(getUsers(payload));
        }
        return "{}";
    }

    String post(String url, JSONObject payload) {
        if ("/add".equals(url)) {
            return addUser(payload);
        }
        if ("/iou".equals(url)) {
            return createIou(payload);
        }
        return "{}";
    }

    private List<User> getUsers(JSONObject payload) {
        List<User> result = new ArrayList<>();

        if (payload != null && payload.has("users")) {
            try {
                JSONArray names = payload.getJSONArray("users");
                for (int i = 0; i < names.length(); i++) {
                    String name = names.getString(i);
                    User user = users.get(name);
                    if (user != null) {
                        result.add(user);
                    }
                }
            } catch (Exception ignored) {
                // Ignore malformed payload and return an empty user list.
            }
        } else {
            result.addAll(users.values());
        }

        result.sort(Comparator.comparing(User::name));
        return result;
    }

    private String addUser(JSONObject payload) {
        if (payload == null || !payload.has("user")) {
            return "{}";
        }

        String name;
        try {
            name = payload.getString("user");
        } catch (Exception e) {
            return "{}";
        }

        if (name == null) {
            return "{}";
        }

        User user = users.get(name);
        if (user == null) {
            user = User.builder().setName(name).build();
            users.put(name, user);
        }

        return userJson(user);
    }

    private String createIou(JSONObject payload) {
        if (payload == null || !payload.has("lender") || !payload.has("borrower") || !payload.has("amount")) {
            return "{}";
        }

        String lenderName;
        String borrowerName;
        try {
            lenderName = payload.getString("lender");
            borrowerName = payload.getString("borrower");
        } catch (Exception e) {
            return "{}";
        }

        if (lenderName == null || borrowerName == null) {
            return "{}";
        }

        double amount;
        try {
            amount = payload.getDouble("amount");
        } catch (Exception e) {
            return "{}";
        }

        User lender = users.get(lenderName);
        if (lender == null) {
            lender = User.builder().setName(lenderName).build();
            users.put(lenderName, lender);
        }

        User borrower = users.get(borrowerName);
        if (borrower == null) {
            borrower = User.builder().setName(borrowerName).build();
            users.put(borrowerName, borrower);
        }

        borrower.owes(lenderName, amount);
        lender.owedBy(borrowerName, amount);

        List<User> updated = new ArrayList<>();
        updated.add(lender);
        if (borrower != lender) {
            updated.add(borrower);
        }
        updated.sort(Comparator.comparing(User::name));

        return usersJson(updated);
    }

    private String usersJson(List<User> userList) {
        StringBuilder sb = new StringBuilder();
        sb.append("{\"users\":[");

        for (int i = 0; i < userList.size(); i++) {
            if (i > 0) {
                sb.append(',');
            }
            sb.append(userJson(userList.get(i)));
        }

        sb.append("]}");
        return sb.toString();
    }

    private String userJson(User user) {
        StringBuilder sb = new StringBuilder();
        sb.append('{');
        sb.append("\"name\":").append(quote(user.name())).append(',');
        sb.append("\"owes\":").append(iouMapJson(user.owes())).append(',');
        sb.append("\"owed_by\":").append(iouMapJson(user.owedBy())).append(',');
        sb.append("\"balance\":").append(formatDouble(user.balance()));
        sb.append('}');
        return sb.toString();
    }

    private String iouMapJson(List<Iou> ious) {
        List<Iou> sorted = new ArrayList<>(ious);
        sorted.sort(Comparator.comparing(Iou::name));

        StringBuilder sb = new StringBuilder();
        sb.append('{');

        for (int i = 0; i < sorted.size(); i++) {
            if (i > 0) {
                sb.append(',');
            }

            Iou iou = sorted.get(i);
            sb.append(quote(iou.name())).append(':').append(formatDouble(iou.amount()));
        }

        sb.append('}');
        return sb.toString();
    }

    private static String quote(String value) {
        StringBuilder sb = new StringBuilder();
        sb.append('"');

        if (value != null) {
            for (int i = 0; i < value.length(); i++) {
                char c = value.charAt(i);

                switch (c) {
                    case '"':
                        sb.append("\\\"");
                        break;
                    case '\\':
                        sb.append("\\\\");
                        break;
                    case '\b':
                        sb.append("\\b");
                        break;
                    case '\f':
                        sb.append("\\f");
                        break;
                    case '\n':
                        sb.append("\\n");
                        break;
                    case '\r':
                        sb.append("\\r");
                        break;
                    case '\t':
                        sb.append("\\t");
                        break;
                    default:
                        if (c < 0x20) {
                            sb.append(String.format("\\u%04x", (int) c));
                        } else {
                            sb.append(c);
                        }
                        break;
                }
            }
        }

        sb.append('"');
        return sb.toString();
    }

    private static String formatDouble(double value) {
        if (Double.isNaN(value) || Double.isInfinite(value)) {
            return Double.toString(value);
        }

        BigDecimal rounded = BigDecimal.valueOf(value).setScale(15, RoundingMode.HALF_UP);
        double result = rounded.doubleValue();

        if (result == 0.0) {
            result = 0.0;
        }

        return Double.toString(result);
    }
}
