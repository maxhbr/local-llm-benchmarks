I implemented `recite` to build each verse from the day names and gifts, returning an array of verse strings for the requested range. If no arguments are provided, it returns the full song.

twelve-days.js
```
//
// This is only a SKELETON file for the 'Twelve Days' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

const DAYS = [
  'first',
  'second',
  'third',
  'fourth',
  'fifth',
  'sixth',
  'seventh',
  'eighth',
  'ninth',
  'tenth',
  'eleventh',
  'twelfth',
];

const GIFTS = [
  'a Partridge in a Pear Tree',
  'two Turtle Doves',
  'three French Hens',
  'four Calling Birds',
  'five Gold Rings',
  'six Geese-a-Laying',
  'seven Swans-a-Swimming',
  'eight Maids-a-Milking',
  'nine Ladies Dancing',
  'ten Lords-a-Leaping',
  'eleven Pipers Piping',
  'twelve Drummers Drumming',
];

const verse = (number) => {
  const gifts = [];

  for (let i = number - 1; i >= 0; i -= 1) {
    if (i === 0 && number > 1) {
      gifts.push(`and ${GIFTS[0]}`);
    } else {
      gifts.push(GIFTS[i]);
    }
  }

  return `On the ${DAYS[number - 1]} day of Christmas my true love gave to me: ${gifts.join(', ')}.`;
};

export const recite = (startVerse, endVerse) => {
  const start = startVerse === undefined ? 1 : startVerse;
  const end = endVerse === undefined ? (startVerse === undefined ? 12 : startVerse) : endVerse;

  if (!Number.isInteger(start) || !Number.isInteger(end) || start < 1 || end > 12 || start > end) {
    return [];
  }

  const verses = [];

  for (let i = start; i <= end; i += 1) {
    verses.push(verse(i));
  }

  return verses;
};
```
