def transpose(text):
    rows = text.split('\n')
    if not rows:
        return ''
    max_len = max(len(row) for row in rows)
    transposed = []
    for col in range(max_len):
        last = -1
        for row_idx, row in enumerate(rows):
            if col < len(row):
                last = row_idx
        if last == -1:
            continue
        transposed.append(''.join(row[col] if col < len(row) else ' ' for row in rows[:last+1]))
    return '\n'.join(transposed)

