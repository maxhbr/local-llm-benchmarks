package bottlesong

import (
	"fmt"
	"strings"
)

var numberWords = map[int]string{
	0:  "no",
	1:  "one",
	2:  "two",
	3:  "three",
	4:  "four",
	5:  "five",
	6:  "six",
	7:  "seven",
	8:  "eight",
	9:  "nine",
	10: "ten",
}

func capitalize(s string) string {
	if s == "" {
		return s
	}
	return strings.ToUpper(s[:1]) + s[1:]
}

func bottleWord(n int) string {
	if n == 1 {
		return "bottle"
	}
	return "bottles"
}

func firstLine(n int) string {
	return fmt.Sprintf("%s green %s hanging on the wall,", capitalize(numberWords[n]), bottleWord(n))
}

func lastLine(n int) string {
	next := n - 1
	return fmt.Sprintf("There'll be %s green %s hanging on the wall.", numberWords[next], bottleWord(next))
}

func Recite(startBottles, takeDown int) []string {
	lines := []string{}

	for i := 0; i < takeDown; i++ {
		n := startBottles - i
		if n < 1 {
			break
		}

		if i > 0 {
			lines = append(lines, "")
		}

		line := firstLine(n)
		lines = append(lines,
			line,
			line,
			"And if one green bottle should accidentally fall,",
			lastLine(n),
		)
	}

	return lines
}
```
