Let's design BFS:
```
export class TwoBucket {
  constructor(bucketOne, bucketTwo, goal, startBucket) {
    this.bucketOne = bucketOne;
    this.bucketTwo = bucketTwo;
    this.goal = goal;
    this.startBucket = startBucket;
  }

  solve() {
    const c1 = this.bucketOne;
    const c2 = this.bucketTwo;
    const goal = this.goal;
    const start = this.startBucket;

    if (goal < 0 || c1 < 0 || c2 < 0) throw new Error('No solution possible');
    if (goal === 0) return { moves: 0, goalBucket: start, otherBucket: 0 };
    if (goal > Math.max(c1, c2)) throw new Error('No solution possible');
    // if start invalid? 
    if (start !== 'one' && start !== 'two') throw new Error('No solution possible');

    const isForbidden = (a,b) => start === 'one' ? (a === 0 && b === c2) : (a === c1 && b === 0);

    let startState;
    if (start === 'one') startState = [c1, 0]; else startState = [0, c2];
    if (isForbidden(...startState)) throw ... // not possible
    const encode = (a,b) => a * (c2 + 1) + b;
    const visited = new Set([encode(...startState)]);
    const queue = [[startState, 1]];
    const check = (a,b,moves) => {
      if (a === goal) return { moves, goalBucket: 'one', otherBucket: b };
      if (b === goal) return { moves, goalBucket: 'two', otherBucket: a };
      return null;
    };
    let result = check(...startState, 1);
    if (result) return result;

    while (queue.length) {
      const [[a,b], moves] = queue.shift();
      const nextStates = [
        [c1, b], // fill one
        [a, c2], // fill two
        [0, b], // empty one
        [a, 0], // empty two
        (() => { const pour = Math.min(a, c2 - b); return [a - pour, b + pour]; })(),
        (() => { const pour = Math.min(b, c1 - a); return [a + pour, b - pour]; })()
      ];
      for (const [na, nb] of nextStates) {
        if (na === a && nb === b) continue;
        if (isForbidden(na, nb)) continue;
        const code = encode(na, nb);
        if (visited.has(code)) continue;
        visited.add(code);
        const res = check(na, nb, moves + 1);
        if (res) return res;
        queue.push([[na, nb], moves + 1]);
      }
    }
    throw new Error('No solution possible');
  }
}
```

