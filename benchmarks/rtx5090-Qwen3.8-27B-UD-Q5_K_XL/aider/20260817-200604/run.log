Algorithm:
vector<unsigned int> convert(unsigned int input_base, const vector<unsigned int>& digits, unsigned int output_base) {
 if (input_base < 2 || output_base < 2) throw invalid_argument;
 for (auto d: digits) if (d >= input_base) throw invalid_argument;
 vector<uint32_t> value; // little endian base 2^32
 for (auto d: digits) {
   uint64_t carry = d;
   for (size_t i=0; i<value.size(); ++i) {
      uint64_t cur = (uint64_t)value[i] * input_base + carry;
      value[i] = (uint32_t)cur;
      carry = cur >> 32;
   }
   while (carry) { value.push_back((uint32_t)carry); carry >>= 32; } // carry may be >2^32? Actually carry after multiplication can be up to input_base-1? But if 
input_base up to 2^32-1, carry after processing limb can be up to 2^32-1? Let's see cur max 2^64-1, carry = cur>>32 up to 2^32-1. So one push enough. But if value 
empty, carry=d < input_base <=2^32-1, one push. while okay.
 }
 // normalize
 while (!value.empty() && value.back()==0) value.pop_back();
 if (value.empty()) return {0};
 vector<unsigned int> result;
 uint64_t rem = 0;
 vector<uint32_t> quotient(value.size());
 for (int i = value.size()-1; i>=0; --i) {
    uint64_t cur = (rem << 32) | value[i];
    quotient[i] = (uint32_t)(cur / output_base);
    rem = cur % output_base;
 }
 // quotient may have leading zeros; but we only need remainders. We can repeatedly divide value by output_base until zero.
 while (true) {
    result.push_back((unsigned int)rem);
    // normalize quotient
    while (!quotient.empty() && quotient.back()==0) quotient.pop_back();
    if (quotient.empty()) break;
    value.swap(quotient);
    rem = 0;
    quotient.assign(value.size(), 0);
    for (int i = value.size()-1; i>=0; --i) { ... }
 }
 // result is least significant first; reverse
 reverse(result.begin(), result.end());
 return result;
}

