def _increase_debt(self, from_user, to_user, amount):
    amount = self._round(amount)
    if amount <= 0: return
    from_user = str(from_user); to_user = str(to_user)
    self._ensure_user(from_user); self._ensure_user(to_user)
    self.users[from_user]['owes'][to_user] = self._round(self.users[from_user]['owes'].get(to_user, 0.0) + amount)
    self.users[to_user]['owed_by'][from_user] = self._round(self.users[to_user]['owed_by'].get(from_user, 0.0) + amount)

def _decrease_debt(self, from_user, to_user, amount):
    amount = self._round(amount)
    if amount <= 0: return
    from_user = str(from_user); to_user = str(to_user)
    current = self._round(self.users.get(from_user, {}).get('owes', {}).get(to_user, 0.0))
    new = self._round(current - amount)
    if new <= 0:
        self.users[from_user]['owes'].pop(to_user, None)
        self.users[to_user]['owed_by'].pop(from_user, None)
    else:
        self.users[from_user]['owes'][to_user] = new
        self.users[to_user]['owed_by'][from_user] = new
```
