use std::collections::HashMap;

/// Count occurrences of words.
pub fn word_count(words: &str) -> HashMap<String, u32> {
    let mut counts = HashMap::new();
    let mut current = String::new();
    let mut chars = words.chars().peekable();

    while let Some(c) = chars.next() {
        if c.is_ascii_alphanumeric() {
            current.push(c.to_ascii_lowercase());
        } else if c == '\'' && !current.is_empty() {
            let next_is_alpha = chars.peek().map_or(false, |next| next.is_ascii_alphabetic());
            let last_is_alpha =
                current.chars().last().map_or(false, |last| last.is_ascii_alphabetic());

            if next_is_alpha && last_is_alpha {
                current.push('\'');
            } else {
                if !current.is_empty() {
                    *counts.entry(std::mem::take(&mut current)).or_insert(0) += 1;
                }
            }
        } else {
            if !current.is_empty() {
                *counts.entry(std::mem::take(&mut current)).or_insert(0) += 1;
            }
        }
    }

    if !current.is_empty() {
        *counts.entry(current).or_insert(0) += 1;
    }

    counts
}
