        if (format.dutch) {
            amount = format.currencySymbol + " -" + amount.replace(format.currencySymbol, "").trim() + " ";
        } else {
            amount = "(" + amount + ")";
        }
    } else {
        if (format.dutch) {
            amount = " " + amount + " ";
        } else {
            amount = amount + " ";
        }
    }
    return amount;
}

