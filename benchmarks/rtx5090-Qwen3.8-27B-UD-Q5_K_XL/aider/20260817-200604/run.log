#include "kindergarten_garden.h"

#include <array>
#include <string>
#include <vector>

namespace kindergarten_garden {

namespace {

const std::array<std::string, 12>& students() {
    static const std::array<std::string, 12> names = {
        "Alice", "Bob", "Charlie", "David", "Eve", "Fred",
        "Ginny", "Harriet", "Ileana", "Joseph", "Kincaid", "Larry"
    };
    return names;
}

std::string plant_name(char c) {
    switch (c) {
        case 'G': return "Grass";
        case 'C': return "Clover";
        case 'R': return "Radishes";
        case 'V': return "Violets";
        default: return "";
    }
}

}  // namespace

std::vector<std::string> plants(const std::string& diagram, const std::string& student) {
    std::vector<std::string> result;
    result.reserve(4);

    auto it = std::find(students().begin(), students().end(), student);
    if (it == students().end()) {
        return result;
    }

    std::size_t offset = static_cast<std::size_t>(std::distance(students().begin(), it)) * 2;

    std::size_t newline = diagram.find('\n');
    std::string first_row = diagram.substr(0, newline);
    std::string second_row = (newline == std::string::npos) ? "" : diagram.substr(newline + 1);

    if (offset + 1 < first_row.size()) {
        result.push_back(plant_name(first_row[offset]));
        result.push_back(plant_name(first_row[offset + 1]));
    }
    if (offset + 1 < second_row.size()) {
        result.push_back(plant_name(second_row[offset]));
        result.push_back(plant_name(second_row[offset + 1]));
    }

    return result;
}

}  // namespace kindergarten_garden
```
