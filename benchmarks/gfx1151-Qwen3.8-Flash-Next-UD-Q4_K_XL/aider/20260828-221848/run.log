```
function parseQuery(url) {
  const queryIndex = url.indexOf('?');
  if (queryIndex === -1) return {};
  const params = {};
  url.slice(queryIndex + 1).split('&').forEach(pair => {
    if (!pair) return;
    const eq = pair.indexOf('=');
    const rawKey = eq === -1 ? pair : pair.slice(0, eq);
    const rawValue = eq === -1 ? '' : pair.slice(eq + 1);
    const key = decodeURIComponent(rawKey);
    const value = decodeURIComponent(rawValue);
    if (Object.prototype.hasOwnProperty.call(params, key)) {
      if (Array.isArray(params[key])) params[key].push(value);
      else params[key] = [params[key], value];
    } else {
      params[key] = value;
    }
  });
  return params;
}
```
Then get names:
```
function extractNames(params) {
  if (!hasOwnProperty(params,'users')) return null;
  const raw = params.users;
  const values = Array.isArray(raw) ? raw : [raw];
  const names = [];
  values.forEach(v => v.split(',').forEach(name => { if (name) names.push(name); }));
  return names;
}
```
