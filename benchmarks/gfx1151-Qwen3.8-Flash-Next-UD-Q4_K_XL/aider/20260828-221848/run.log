robot-name.js
```
const usedNames = new Set();
const MAX_NAMES = 26 * 26 * 10 * 10 * 10;

const randomLetter = () => String.fromCharCode(65 + Math.floor(Math.random() * 26));
const randomDigit = () => Math.floor(Math.random() * 10);

const randomName = () =>
  `${randomLetter()}${randomLetter()}${randomDigit()}${randomDigit()}${randomDigit()}`;

const generateName = () => {
  if (usedNames.size >= MAX_NAMES) {
    throw new Error('No unique names available');
  }

  let name;
  do {
    name = randomName();
  } while (usedNames.has(name));

  usedNames.add(name);
  return name;
};

export class Robot {
  constructor() {
    this._name = null;
  }

  get name() {
    if (this._name === null) {
      this._name = generateName();
    }
    return this._name;
  }

  reset() {
    this._name = null;
  }
}

Robot.releaseNames = () => {
  usedNames.clear();
};
```
