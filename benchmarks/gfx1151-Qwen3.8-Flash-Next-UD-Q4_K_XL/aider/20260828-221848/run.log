export class RestAPI {
  constructor(database = { users: [] }) {
    if (!database || typeof database !== 'object') {
      database = { users: [] };
    }

    this.database = database;

    if (!Array.isArray(this.database.users)) {
      this.database.users = [];
    }
  }

  get(url) {
    const path = getPath(url);
    if (path !== '/users') {
      return {};
    }

    const params = parseQuery(url);
    const allUsers = this.database.users.filter((user) => Boolean(user));
    let users = allUsers;

    if (hasOwn(params, 'users')) {
      const names = extractNames(params);
      users = allUsers.filter((user) => names.includes(user.name));
    }

    return { users: users.map(cloneUser).sort(compareUsers) };
  }

  post(url, payload) {
    const path = getPath(url);

    if (path === '/add') {
      const name = toName(payload && payload.user);
      if (name === null) {
        return {};
      }

      let user = findUser(this.database, name);
      if (!user) {
        user = { name, owes: {}, owed_by: {}, balance: 0 };
        this.database.users.push(user);
      }

      user.balance = calculateBalance(user);
      return cloneUser(user);
    }

    if (path === '/iou') {
      if (!payload) {
        return { users: [] };
      }

      const lenderName = toName(payload.lender);
      const borrowerName = toName(payload.borrower);
      const rawAmount = payload.amount;

      if (rawAmount === undefined || rawAmount === null || rawAmount === '') {
        return { users: [] };
      }

      const amount = Number(rawAmount);
      if (!Number.isFinite(amount)) {
        return { users: [] };
      }

      const lender = findUser(this.database, lenderName);
      const borrower = findUser(this.database, borrowerName);

      if (!lender || !borrower) {
        return { users: [] };
      }

      if (lender !== borrower && amount !== 0) {
        adjustPair(lender, borrower.name, amount);
        adjustPair(borrower, lender.name, -amount);
      }

      lender.balance = calculateBalance(lender);
      borrower.balance = calculateBalance(borrower);

      const updated = lender === borrower ? [lender] : [lender, borrower];
      return { users: updated.map(cloneUser).sort(compareUsers) };
    }

    return {};
  }
}

function getPath(url) {
  const stringUrl = getUrlString(url);
  const queryIndex = stringUrl.indexOf('?');
  let path = queryIndex === -1 ? stringUrl : stringUrl.slice(0, queryIndex);

  if (path.length > 1 && path.endsWith('/')) {
    path = path.slice(0, -1);
  }

  return path;
}

function parseQuery(url) {
  const stringUrl = getUrlString(url);
  const queryIndex = stringUrl.indexOf('?');
  const params = {};

  if (queryIndex === -1) {
    return params;
  }

  const query = stringUrl.slice(queryIndex + 1);

  query.split('&').forEach((pair) => {
    if (!pair) {
      return;
    }

    const eqIndex = pair.indexOf('=');
    const rawKey = eqIndex === -1 ? pair : pair.slice(0, eqIndex);
    const rawValue = eqIndex === -1 ? '' : pair.slice(eqIndex + 1);
    const key = safeDecode(rawKey);
    const value = safeDecode(rawValue);

    if (hasOwn(params, key)) {
      if (Array.isArray(params[key])) {
        params[key].push(value);
      } else {
        params[key] = [params[key], value];
      }
    } else {
      params[key] = value;
    }
  });

  return params;
}

function getUrlString(url) {
  const stringUrl = url === undefined || url === null ? '' : String(url);
  return stringUrl.split('#')[0];
}

function safeDecode(value) {
  const stringValue = String(value);
  try {
    return decodeURIComponent(stringValue.replace(/\+/g, ' '));
  } catch (error) {
    return stringValue;
  }
}

function hasOwn(object, key) {
  return Object.prototype.hasOwnProperty.call(object, key);
}

function extractNames(params) {
  const raw = params.users;
  if (raw === undefined || raw === null) {
    return [];
  }

  const values = Array.isArray(raw) ? raw : [raw];
  const names = [];

  values.forEach((value) => {
    String(value)
      .split(',')
      .forEach((name) => {
        const trimmed = name.trim();
        if (trimmed) {
          names.push(trimmed);
        }
      });
  });

  return names;
}

function toName(value) {
  if (value === undefined || value === null) {
    return null;
  }
  return String(value);
}

function findUser(database, name) {
  if (!database || !Array.isArray(database.users) || name === null || name === undefined) {
    return undefined;
  }

  return database.users.find((user) => user && user.name === name);
}

function cloneUser(user) {
  if (!user) {
    return { name: undefined, owes: {}, owed_by: {}, balance: 0 };
  }

  const owes = {};
  const owed_by = {};

  Object.keys(user.owes || {}).forEach((name) => {
    const value = toMoney(user.owes[name]);
    if (value !== 0) {
      owes[name] = value;
    }
  });

  Object.keys(user.owed_by || {}).forEach((name) => {
    const value = toMoney(user.owed_by[name]);
    if (value !== 0) {
      owed_by[name] = value;
    }
  });

  return {
    name: user.name,
    owes,
    owed_by,
    balance: calculateBalance({ owes, owed_by }),
  };
}

function compareUsers(a, b) {
  const aName = String(a.name);
  const bName = String(b.name);

  if (aName < bName) {
    return -1;
  }
  if (aName > bName) {
    return 1;
  }
  return 0;
}

function adjustPair(user, other, delta) {
  if (!user || other === null || other === undefined) {
    return;
  }

  const amount = Number(delta);
  if (!Number.isFinite(amount)) {
    return;
  }

  ensureDebtMaps(user);

  const owedBy = hasOwn(user.owed_by, other) ? toMoney(user.owed_by[other]) : 0;
  const owes = hasOwn(user.owes, other) ? toMoney(user.owes[other]) : 0;
  const current = cleanMoney(owedBy - owes);
  const next = cleanMoney(current + amount);

  delete user.owes[other];
  delete user.owed_by[other];

  if (next > 0) {
    user.owed_by[other] = next;
  } else if (next < 0) {
    user.owes[other] = -next;
  }
}

function ensureDebtMaps(user) {
  if (!user.owes || typeof user.owes !== 'object') {
    user.owes = {};
  }
  if (!user.owed_by || typeof user.owed_by !== 'object') {
    user.owed_by = {};
  }
}

function calculateBalance(user) {
  if (!user) {
    return 0;
  }

  const owedBy = Object.values(user.owed_by || {}).reduce(
    (sum, value) => sum + toMoney(value),
    0
  );
  const owes = Object.values(user.owes || {}).reduce(
    (sum, value) => sum + toMoney(value),
    0
  );

  return cleanMoney(owedBy - owes);
}

function toMoney(value) {
  const number = Number(value);
  if (!Number.isFinite(number)) {
    return 0;
  }
  return cleanMoney(number);
}

function cleanMoney(value) {
  const number = Number(value);
  if (!Number.isFinite(number)) {
    return number;
  }

  if (Math.abs(number) < 1e-10) {
    return 0;
  }

  if (Math.abs(number) >= 1e21) {
    return number;
  }

  return Number(number.toFixed(12));
}
