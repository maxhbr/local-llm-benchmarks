Algorithm repeated division:
vector<int> convert(int input_base, vector<int> digits, int output_base) {
 if input_base <2 || output_base <2 throw domain_error.
 for d in digits if d<0 || d>=input_base throw domain_error.
 if digits.empty() return {};
 // remove leading zeros? We can keep but need detect zero.
 // Convert to output base by repeatedly dividing the big number represented by digits in input_base by 
output_base, collecting remainders.
 vector<int> result;
 // Remove leading zeros to simplify
 size_t first_nonzero = 0; while first_nonzero < digits.size() && digits[first_nonzero]==0 first_nonzero++;
 if first_nonzero == digits.size() return {0};
 vector<int> current(digits.begin()+first_nonzero, digits.end());
 while (!current.empty()) {
   int remainder = 0;
   vector<int> quotient;
   quotient.reserve(current.size());
   for (int digit : current) {
      int value = remainder * input_base + digit;
      int q = value / output_base;
      remainder = value % output_base;
      if (!quotient.empty() || q != 0) quotient.push_back(q);
   }
   result.push_back(remainder);
   current = quotient;
 }
 reverse(result.begin(), result.end());
 return result;
}

