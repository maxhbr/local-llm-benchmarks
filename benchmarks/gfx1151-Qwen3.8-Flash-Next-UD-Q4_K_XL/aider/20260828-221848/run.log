 #include "all_your_base.h"
+
+#include <algorithm>
+#include <stdexcept>
 
 namespace all_your_base {
 
+std::vector<int> convert(int input_base, std::vector<int> digits, int output_base) {
+    if (input_base < 2) {
+        throw std::domain_error("input base must be >= 2");
+    }
+
+    if (output_base < 2) {
+        throw std::domain_error("output base must be >= 2");
+    }
+
+    for (int digit : digits) {
+        if (digit < 0 || digit >= input_base) {
+            throw std::domain_error("all digits must satisfy 0 <= d < input base");
+        }
+    }
+
+    if (digits.empty()) {
+        return {};
+    }
+
+    std::size_t first_nonzero = 0;
+    while (first_nonzero < digits.size() && digits[first_nonzero] == 0) {
+        ++first_nonzero;
+    }
+
+    if (first_nonzero == digits.size()) {
+        return {0};
+    }
+
+    std::vector<int> current(digits.begin() + first_nonzero, digits.end());
+    std::vector<int> result;
+
+    while (!current.empty()) {
+        long long remainder = 0;
+        std::vector<int> quotient;
+        quotient.reserve(current.size());
+
+        for (int digit : current) {
+            long long value = remainder * input_base + digit;
+            int q = static_cast<int>(value / output_base);
+            remainder = value % output_base;
+
+            if (!quotient.empty() || q != 0) {
+                quotient.push_back(q);
+            }
+        }
+
+        result.push_back(static_cast<int>(remainder));
+        current = quotient;
+    }
+
+    std::reverse(result.begin(), result.end());
+    return result;
+}
+
 }  // namespace all_your_base
