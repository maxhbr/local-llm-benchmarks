function calculateBalance(user) {
  const owedBy = Object.values(user.owed_by || {}).reduce((sum, value) => sum + toMoney(value), 0);
  const owes = Object.values(user.owes || {}).reduce((sum, value) => sum + toMoney(value), 0);
  return cleanMoney(owedBy - owes);
}
