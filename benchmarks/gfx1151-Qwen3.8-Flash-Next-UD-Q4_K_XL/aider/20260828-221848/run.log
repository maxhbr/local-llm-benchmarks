```
function adjustPair(user, other, delta) {
  if (!user || !other) return;
  if (!user.owes) user.owes = {};
  if (!user.owed_by) user.owed_by = {};
  const current = cleanMoney((Number(user.owed_by[other]) || 0) - (Number(user.owes[other]) || 0));
  const next = cleanMoney(current + Number(delta));
  delete user.owes[other];
  delete user.owed_by[other];
  if (next > 0) user.owed_by[other] = next;
  else if (next < 0) user.owes[other] = -next;
}
```
