function normalizeUser(user) {
  if (!user || typeof user !== 'object') return;
  if (!user.owes || typeof user.owes !== 'object') user.owes = {};
  if (!user.owed_by || typeof user.owed_by !== 'object') user.owed_by = {};
  const names = [];
  Object.keys(user.owes).forEach(n => names.push(n));
  Object.keys(user.owed_by).forEach(n => { if (!names.includes(n)) names.push(n); });
  names.forEach((name) => {
    const owes = Number(user.owes[name]) || 0;
    const owedBy = Number(user.owed_by[name]) || 0;
    const net = cleanMoney(owedBy - owes);
    delete user.owes[name];
    delete user.owed_by[name];
    if (net > 0) user.owed_by[name] = net;
    else if (net < 0) user.owes[name] = -net;
  });
  user.balance = calculateBalance(user);
}
```
