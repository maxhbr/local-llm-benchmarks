```
function cloneUser(user) {
  const owes = {};
  const owed_by = {};

  Object.keys(user.owes || {}).forEach((name) => {
    const value = toMoney(user.owes[name]);
    if (value !== 0) owes[name] = value;
  });

  Object.keys(user.owed_by || {}).forEach((name) => {
    const value = toMoney(user.owed_by[name]);
    if (value !== 0) owed_by[name] = value;
  });

  return {
    name: user.name,
    owes,
    owed_by,
    balance: calculateBalance({ owes, owed_by }),
  };
}
```
