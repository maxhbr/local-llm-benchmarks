package cryptosquare

import (
    "math"
    "strings"
    "unicode"
)

func Encode(pt string) string {
    var norm strings.Builder
    for _, r := range pt {
        if unicode.IsLetter(r) || unicode.IsDigit(r) {
            norm.WriteRune(unicode.ToLower(r))
        }
    }
    s := norm.String()
    n := len([]rune(s)) // since s only runes maybe bytes? If unicode letters multi-byte, len bytes not equal 
rune count. Need use rune slice.
    if n == 0 { return "" }
    c := int(math.Ceil(math.Sqrt(float64(n))))
    r := (n + c - 1) / c
    runes := []rune(s)
    chunks := make([]string, 0, c)
    for col := 0; col < c; col++ {
        var chunk strings.Builder
        for row := 0; row < r; row++ {
            idx := row*c + col
            if idx < n {
                chunk.WriteRune(runes[idx])
            } else {
                chunk.WriteRune(' ')
            }
        }
        chunks = append(chunks, chunk.String())
    }
    return strings.Join(chunks, " ")
}

