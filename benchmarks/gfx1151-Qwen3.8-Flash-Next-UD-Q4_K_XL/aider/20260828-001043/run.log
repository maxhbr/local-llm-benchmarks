        groups[size] += 1
        counts = [count - 1 if count > 0 else 0 for count in counts]
    while groups[5] > 0 and groups[3] > 0:
        groups[5] -= 1
        groups[3] -= 1
        groups[4] += 2
    total_cents = sum(groups[size] * price for size, price in enumerate(prices) if size)
    return total_cents / 100
```
