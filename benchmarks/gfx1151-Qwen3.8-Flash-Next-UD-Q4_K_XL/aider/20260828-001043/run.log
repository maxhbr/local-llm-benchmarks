def total(basket):
    counts = [0] * 5
    for book in basket:
        if 1 <= book <= 5:
            counts[book - 1] += 1

    counts.sort()
    groups = [0] * 6
    previous = 0
    for index, count in enumerate(counts):
        if count > previous:
