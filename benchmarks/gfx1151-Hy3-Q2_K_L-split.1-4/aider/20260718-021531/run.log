```
// The code below implements conversion of a binary font grid to a string of digits.
// See instructions for details on font format and error handling.

#[derive(Debug, PartialEq, Eq)]
pub enum Error {
    InvalidRowCount(usize),
    InvalidColumnCount(usize),
}

// Font patterns: each digit represented as 4 rows of 3 columns.
// We store the 12-character grid (top to bottom, left to right) for each digit.
const FONT: [(char, [char; 12]); 10] = [
    ('0', [
        ' ', '_', ' ',
        '|', ' ', '|',
        '|', '_', '|',
        ' ', ' ', ' ',
    ]),
    ('1', [
        ' ', ' ', ' ',
        ' ', '|', ' ',
        ' ', '|', ' ',
        ' ', ' ', ' ',
    ]),
    ('2', [
        ' ', '_', ' ',
        ' ', '_', '|',
        '|', '_', ' ',
        ' ', ' ', ' ',
    ]),
    ('3', [
        ' ', '_', ' ',
        ' ', '_', '|',
        ' ', '_', '|',
        ' ', ' ', ' ',
    ]),
    ('4', [
        ' ', ' ', ' ',
        '|', '_', '|',
        ' ', ' ', '|',
        ' ', ' ', ' ',
    ]),
    ('5', [
        ' ', '_', ' ',
        '|', '_', ' ',
        ' ', '_', '|',
        ' ', ' ', ' ',
    ]),
    ('6', [
        ' ', '_', ' ',
        '|', ' ', ' ',
        '|', '_', '|',
        ' ', ' ', ' ',
    ]),
    ('7', [
        ' ', '_', ' ',
        ' ', ' ', '|',
        ' ', ' ', '|',
        ' ', ' ', ' ',
    ]),
    ('8', [
        ' ', '_', ' ',
        '|', '_', '|',
        '|', '_', '|',
        ' ', ' ', ' ',
    ]),
    ('9', [
        ' ', '_', ' ',
        '|', '_', '|',
        ' ', '_', '|',
        ' ', ' ', ' ',
    ]),
];

pub fn convert(input: &str) -> Result<String, Error> {
    let lines: Vec<&str> = input.lines().collect();
    let row_count = lines.len();
    if row_count == 0 {
        return Err(Error::InvalidRowCount(0));
    }
    if row_count % 4 != 0 {
        return Err(Error::InvalidRowCount(row_count));
    }

    // Determine column count from first line (all lines should have same length)
    let col_count = lines[0].len();
    if col_count % 3 != 0 {
        return Err(Error::InvalidColumnCount(col_count));
    }
    for line in &lines {
        if line.len() != col_count {
            return Err(Error::InvalidColumnCount(line.len()));
        }
    }

    let num_digits_per_block = col_count / 3;
    let mut result_lines = Vec::new();

    for block_row in 0..(row_count / 4) {
        let mut line_digits = String::new();
        for digit_col in 0..num_digits_per_block {
            let mut pattern = [' '; 12];
            for r in 0..4 {
                let line = lines[block_row * 4 + r];
                let start = digit_col * 3;
                let end = start + 3;
                let chars: Vec<char> = line[start..end].chars().collect();
                for c in 0..3 {
                    pattern[r * 3 + c] = chars[c];
                }
            }
            // Match pattern to font
            let mut matched = '?';
            for (digit, font_pattern) in FONT.iter() {
                if pattern == *font_pattern {
                    matched = *digit;
                    break;
                }
            }
            line_digits.push(matched);
        }
        result_lines.push(line_digits);
    }

    Ok(result_lines.join(","))
}
```

This implementation:
- Checks row count is multiple of 4 (else `InvalidRowCount`).
- Checks column count is multiple of 3 (else `InvalidColumnCount`).
- Splits input into 4-row blocks, each block is one line of numbers.
- For each 3x4 digit cell, compares to known font patterns.
- Unrecognized patterns become '?'.
- Joins lines of digits with commas.
- Returns `Result<String, Error>` as required.
