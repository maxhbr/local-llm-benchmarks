          // ok, will be validated later fully
        }
      }
      // Rule 15: Norwegian next to blue
      if (n >= 2) {
        if (houses[0].nationality === 'Norwegian' && houses[1].color && houses[1].color !== 'blue') return false;
      }
      // Rule 2: Englishman red
      for (let i = 0; i < n; i++) {
        if (houses[i].nationality === 'Englishman' && houses[i].color && houses[i].color !== 'red') return false;
        if (houses[i].color === 'red' && houses[i].nationality && houses[i].nationality !== 'Englishman') return false;
      }
      // Rule 3: Spaniard dog
      for (let i = 0; i < n; i++) {
        if (houses[i].nationality === 'Spaniard' && houses[i].pet && houses[i].pet !== 'dog') return false;
        if (houses[i].pet === 'dog' && houses[i].nationality && houses[i].nationality !== 'Spaniard') return false;
      }
      // Rule 4: green coffee
      for (let i = 0; i < n; i++) {
        if (houses[i].color === 'green' && houses[i].drink && houses[i].drink !== 'coffee') return false;
        if (houses[i].drink === 'coffee' && houses[i].color && houses[i].color !== 'green') return false;
      }
      // Rule 5: Ukrainian tea
      for (let i = 0; i < n; i++) {
        if (houses[i].nationality === 'Ukrainian' && houses[i].drink && houses[i].drink !== 'tea') return false;
        if (houses[i].drink === 'tea' && houses[i].nationality && houses[i].nationality !== 'Ukrainian') return false;
      }
      // Rule 7: snail dancing
      for (let i = 0; i < n; i++) {
        if (houses[i].pet === 'snail' && houses[i].hobby && houses[i].hobby !== 'dancing') return false;
        if (houses[i].hobby === 'dancing' && houses[i].pet && houses[i].pet !== 'snail') return false;
      }
      // Rule 8: yellow painter
      for (let i = 0; i < n; i++) {
        if (houses[i].color === 'yellow' && houses[i].hobby && houses[i].hobby !== 'painter') return false;
        if (houses[i].hobby === 'painter' && houses[i].color && houses[i].color !== 'yellow') return false;
      }
      // Rule 13: football orange juice
      for (let i = 0; i < n; i++) {
        if (houses[i].hobby === 'football' && houses[i].drink && houses[i].drink !== 'orange juice') return false;
        if (houses[i].drink === 'orange juice' && houses[i].hobby && houses[i].hobby !== 'football') return false;
      }
      // Rule 14: Japanese chess
      for (let i = 0; i < n; i++) {
        if (houses[i].nationality === 'Japanese' && houses[i].hobby && houses[i].hobby !== 'chess') return false;
        if (houses[i].hobby === 'chess' && houses[i].nationality && houses[i].nationality !== 'Japanese') return false;
      }
      // Rule 11: reading next to fox
      for (let i = 0; i < n; i++) {
        if (houses[i].hobby === 'reading') {
          const adj = [];
          if (i > 0) adj.push(houses[i - 1].pet);
          if (i < n - 1) adj.push(houses[i + 1].pet);
          const valid = adj.some(p => p === 'fox' || p === undefined);
          if (adj.every(p => p !== undefined && p !== 'fox')) return false;
        }
      }
      // Rule 12: painter next to horse
      for (let i = 0; i < n; i++) {
        if (houses[i].hobby === 'painter') {
          const adj = [];
          if (i > 0) adj.push(houses[i - 1].pet);
          if (i < n - 1) adj.push(houses[i + 1].pet);
          const valid = adj.some(p => p === 'horse' || p === undefined);
          if (adj.every(p => p !== undefined && p !== 'horse')) return false;
        }
      }
      // Rule 6 full: green right of ivory (both assigned)
      for (let i = 0; i < n - 1; i++) {
        if (houses[i].color === 'ivory' && houses[i + 1].color && houses[i + 1].color !== 'green') return false;
        if (houses[i + 1].color === 'green' && houses[i].color && houses[i].color !== 'ivory') return false;
      }
      // Rule 15 full: Norwegian next to blue (both assigned)
      for (let i = 0; i < n; i++) {
        if (houses[i].nationality === 'Norwegian') {
          const adj = [];
          if (i > 0) adj.push(houses[i - 1].color);
          if (i < n - 1) adj.push(houses[i + 1].color);
          const valid = adj.some(c => c === 'blue' || c === undefined);
          if (adj.every(c => c !== undefined && c !== 'blue')) return false;
        }
      }
      return true;
