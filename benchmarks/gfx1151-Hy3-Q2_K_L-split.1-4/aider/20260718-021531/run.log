pub type Value = i32;
pub type Result = std::result::Result<(), Error>;

pub struct Forth {
    stack: Vec<Value>,
    words: std::collections::HashMap<String, Vec<String>>,
}

#[derive(Debug, PartialEq, Eq)]
pub enum Error {
    DivisionByZero,
    StackUnderflow,
    UnknownWord,
    InvalidWord,
}

impl Forth {
    pub fn new() -> Forth {
        Forth {
            stack: Vec::new(),
            words: std::collections::HashMap::new(),
        }
    }

    pub fn stack(&self) -> &[Value] {
        &self.stack
    }

    pub fn eval(&mut self, input: &str) -> Result {
        let tokens: Vec<String> = input
            .split_whitespace()
            .map(|s| s.to_ascii_uppercase())
            .collect();

        let mut i = 0;
        while i < tokens.len() {
            if tokens[i] == ":" {
                // definition: : word-name definition ;
                if i + 2 >= tokens.len() {
                    return Err(Error::InvalidWord);
                }
                let word_name = tokens[i + 1].clone();
                if word_name.parse::<Value>().is_ok() {
                    return Err(Error::InvalidWord);
                }
                let mut definition = Vec::new();
                i += 2;
                while i < tokens.len() && tokens[i] != ";" {
                    definition.push(tokens[i].clone());
                    i += 1;
                }
                if i >= tokens.len() {
                    return Err(Error::InvalidWord);
                }
                i += 1; // skip ;
                self.words.insert(word_name, definition);
            } else {
                let token = &tokens[i];
                if token.parse::<Value>().is_ok() {
                    let val = token.parse::<Value>().unwrap();
                    self.stack.push(val);
                } else if self.words.contains_key(token) {
                    let definition = self.words.get(token).unwrap().clone();
                    // evaluate definition tokens iteratively
                    for t in definition {
                        let lower = t.clone();
                        if lower.parse::<Value>().is_ok() {
                            self.stack.push(lower.parse::<Value>().unwrap());
                        } else if self.words.contains_key(&lower) {
                            // nested call: re-evaluate (already stored)
                            let def = self.words.get(&lower).unwrap().clone();
                            for dt in def {
                                if dt.parse::<Value>().is_ok() {
                                    self.stack.push(dt.parse::<Value>().unwrap());
                                } else if self.words.contains_key(&dt) {
                                    return Err(Error::InvalidWord); // simplistic; no nested defs
                                } else {
                                    self.apply_word(&dt)?;
                                }
                            }
                        } else {
                            self.apply_word(&lower)?;
                        }
                    }
                } else {
                    self.apply_word(token)?;
                }
                i += 1;
            }
        }
        Ok(())
    }

    fn apply_word(&mut self, word: &str) -> Result {
        match word {
            "+" => {
                if self.stack.len() < 2 {
                    return Err(Error::StackUnderflow);
                }
                let b = self.stack.pop().unwrap();
                let a = self.stack.pop().unwrap();
                self.stack.push(a + b);
            }
            "-" => {
                if self.stack.len() < 2 {
                    return Err(Error::StackUnderflow);
                }
                let b = self.stack.pop().unwrap();
                let a = self.stack.pop().unwrap();
                self.stack.push(a - b);
            }
            "*" => {
                if self.stack.len() < 2 {
                    return Err(Error::StackUnderflow);
                }
                let b = self.stack.pop().unwrap();
                let a = self.stack.pop().unwrap();
                self.stack.push(a * b);
            }
            "/" => {
                if self.stack.len() < 2 {
                    return Err(Error::StackUnderflow);
                }
                let b = self.stack.pop().unwrap();
                let a = self.stack.pop().unwrap();
                if b == 0 {
                    return Err(Error::DivisionByZero);
                }
                self.stack.push(a / b);
            }
            "DUP" => {
                if self.stack.is_empty() {
                    return Err(Error::StackUnderflow);
                }
                let v = self.stack.last().unwrap().clone();
                self.stack.push(v);
            }
            "DROP" => {
                if self.stack.is_empty() {
                    return Err(Error::StackUnderflow);
                }
                self.stack.pop();
            }
            "SWAP" => {
                if self.stack.len() < 2 {
                    return Err(Error::StackUnderflow);
                }
                let len = self.stack.len();
                self.stack.swap(len - 1, len - 2);
            }
            "OVER" => {
                if self.stack.len() < 2 {
                    return Err(Error::StackUnderflow);
                }
                let len = self.stack.len();
                self.stack.push(self.stack[len - 2]);
            }
            _ => return Err(Error::UnknownWord),
        }
        Ok(())
    }
}
```

