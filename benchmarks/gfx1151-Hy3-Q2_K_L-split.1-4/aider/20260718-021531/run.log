package variablelengthquantity

import (
	"errors"
)

func EncodeVarint(input []uint32) []byte {
	var output []byte
	for _, value := range input {
		// Break 32-bit value into 7-bit groups (LSB first)
		var groups []byte
		v := value
		for {
			groups = append(groups, byte(v&0x7F))
			v >>= 7
			if v == 0 {
				break
			}
		}
		// Output from MSB to LSB, set continuation bit on all but the last (LSB) byte
		for i := len(groups) - 1; i >= 0; i-- {
			b := groups[i]
			if i > 0 {
				b |= 0x80
			}
			output = append(output, b)
		}
	}
	return output
}

func DecodeVarint(input []byte) ([]uint32, error) {
	var result []uint32
	var current uint32
	for _, b := range input {
		// MSB-first accumulation
		current = (current << 7) | uint32(b&0x7F)
		if b&0x80 == 0 {
			// Last byte of this varint
			result = append(result, current)
			current = 0
		}
	}
	if current != 0 {
		// Incomplete sequence (missing terminating byte)
		return nil, errors.New("incomplete variable-length quantity")
	}
	return result, nil
}
