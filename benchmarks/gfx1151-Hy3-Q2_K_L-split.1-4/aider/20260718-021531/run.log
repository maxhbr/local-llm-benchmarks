import java.util.List;
import java.util.ArrayList;
import java.util.Collections;

class ChangeCalculator {
    private List<Integer> currencyCoins;

    ChangeCalculator(List<Integer> currencyCoins) {
        // Defensive copy and sort descending to ease greedy approach
        this.currencyCoins = new ArrayList<>(currencyCoins);
        Collections.sort(this.currencyCoins, Collections.reverseOrder());
    }

    List<Integer> computeMostEfficientChange(int grandTotal) {
        if (grandTotal < 0) {
            throw new IllegalArgumentException("Cannot compute change for a negative amount");
        }
        if (grandTotal == 0) {
            return new ArrayList<>();
        }

        // Check if change can be made with provided coins
        int smallest = currencyCoins.get(currencyCoins.size() - 1);
        if (grandTotal < smallest) {
            throw new IllegalArgumentException("Cannot make change for amount smaller than smallest coin");
        }

        int remaining = grandTotal;
        List<Integer> result = new ArrayList<>();

        for (int coin : currencyCoins) {
            while (remaining >= coin) {
                result.add(coin);
                remaining -= coin;
            }
        }

        if (remaining != 0) {
            throw new IllegalArgumentException("Cannot make exact change with the given coins");
        }

        // Return coins sorted ascending for clarity (optional, matches examples)
        Collections.sort(result);
        return result;
    }
}
