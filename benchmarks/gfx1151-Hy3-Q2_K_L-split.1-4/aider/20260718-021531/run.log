complex_numbers.cpp
```
#include "complex_numbers.h"

#include <cmath>

namespace complex_numbers {

Complex::Complex(double real, double imag) : real_(real), imag_(imag) {}

double Complex::real() const { return real_; }
double Complex::imag() const { return imag_; }

Complex Complex::operator+(const Complex& other) const {
    return Complex(real_ + other.real_, imag_ + other.imag_);
}

Complex Complex::operator-(const Complex& other) const {
    return Complex(real_ - other.real_, imag_ - other.imag_);
}

Complex Complex::operator*(const Complex& other) const {
    return Complex(real_ * other.real_ - imag_ * other.imag_,
                   imag_ * other.real_ + real_ * other.imag_);
}

Complex Complex::operator/(const Complex& other) const {
    double denom = other.real_ * other.real_ + other.imag_ * other.imag_;
    return Complex((real_ * other.real_ + imag_ * other.imag_) / denom,
                   (imag_ * other.real_ - real_ * other.imag_) / denom);
}

Complex Complex::operator+(double d) const {
    return Complex(real_ + d, imag_);
}

Complex Complex::operator-(double d) const {
    return Complex(real_ - d, imag_);
}

Complex Complex::operator*(double d) const {
    return Complex(real_ * d, imag_ * d);
}

Complex Complex::operator/(double d) const {
    return Complex(real_ / d, imag_ / d);
}

Complex Complex::conjugate() const {
    return Complex(real_, -imag_);
}

Complex Complex::conj() const {
    return conjugate();
}

double Complex::abs_sq() const {
    return real_ * real_ + imag_ * imag_;
}

double Complex::abs() const {
    return std::sqrt(abs_sq());
}

Complex Complex::exp() const {
    double e_a = std::exp(real_);
    return Complex(e_a * std::cos(imag_), e_a * std::sin(imag_));
}

// Non-member operators
Complex operator+(double d, const Complex& c) {
    return c + d;
}

Complex operator-(double d, const Complex& c) {
    return Complex(d, 0.0) - c;
}

Complex operator*(double d, const Complex& c) {
    return c * d;
}

Complex operator/(double d, const Complex& c) {
    return Complex(d, 0.0) / c;
}

}  // namespace complex_numbers
```
