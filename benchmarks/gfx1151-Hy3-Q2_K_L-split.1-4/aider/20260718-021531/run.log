```
package pov

type Tree struct {
	value    string
	children []*Tree
}

// New creates and returns a new Tree with the given root value and children.
func New(value string, children ...*Tree) *Tree {
	return &Tree{value: value, children: children}
}

// Value returns the value at the root of a tree.
func (tr *Tree) Value() string {
	return tr.value
}

// Children returns a slice containing the children of a tree.
// There is no need to sort the elements in the result slice,
// they can be in any order.
func (tr *Tree) Children() []*Tree {
	return tr.children
}

// String describes a tree in a compact S-expression format.
// This helps to make test outputs more readable.
// Feel free to adapt this method as you see fit.
func (tr *Tree) String() string {
	if tr == nil {
		return "nil"
	}
	result := tr.Value()
	if len(tr.Children()) == 0 {
		return result
	}
	for _, ch := range tr.Children() {
		result += " " + ch.String()
	}
	return "(" + result + ")"
}

// POV problem-specific functions

// FromPov returns the pov from the node specified in the argument.
func (tr *Tree) FromPov(from string) *Tree {
	if tr.Value() == from {
		return tr
	}
	// find the node and its path from root to the node
	path := findPath(tr, from, nil)
	if path == nil {
		return nil
	}
	// reparent: walk from root to node, reversing parent-child
	for i := 0; i < len(path)-1; i++ {
		parent := path[i]
		child := path[i+1]
		// remove child from parent's children
		parent.children = removeChild(parent.children, child)
		// add parent as child of child
		child.children = append(child.children, parent)
	}
	return path[len(path)-1]
}

// PathTo returns the shortest path between two nodes in the tree.
func (tr *Tree) PathTo(from, to string) []string {
	fromPath := findPath(tr, from, nil)
	toPath := findPath(tr, to, nil)
	if fromPath == nil || toPath == nil {
		return nil
	}
	// find lowest common ancestor
	var lca *Tree
	var lcaIndexFrom, lcaIndexTo int
	for i := 0; i < len(fromPath); i++ {
		for j := 0; j < len(toPath); j++ {
			if fromPath[i] == toPath[j] {
				lca = fromPath[i]
				lcaIndexFrom = i
				lcaIndexTo = j
				break
			}
		}
		if lca != nil {
			break
		}
	}
	if lca == nil {
		return nil
	}
	// build path: from -> lca reversed, then lca -> to
	result := []string{}
	for i := lcaIndexFrom; i >= 0; i-- {
		result = append(result, fromPath[i].Value())
	}
	for i := lcaIndexTo + 1; i < len(toPath); i++ {
		result = append(result, toPath[i].Value())
	}
	return result
}

// findPath finds the path from root to node with given value, returning slice of trees or nil.
func findPath(tr *Tree, val string, acc []*Tree) []*Tree {
	if tr == nil {
		return nil
	}
	path := append(acc, tr)
	if tr.Value() == val {
		return path
	}
	for _, ch := range tr.Children() {
		if res := findPath(ch, val, path); res != nil {
			return res
		}
	}
	return nil
}

// removeChild removes a child from a slice of trees.
func removeChild(children []*Tree, child *Tree) []*Tree {
	result := make([]*Tree, 0, len(children))
	for _, c := range children {
		if c != child {
			result = append(result, c)
		}
	}
	return result
}
```

This implements all required functionality using only the standard library and keeps the existing function signatures intact.
