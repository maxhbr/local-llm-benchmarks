import java.util.Arrays;

class StateOfTicTacToe {
    public enum GameState {
        ONGOING, DRAW, WIN
    }

    public GameState determineState(String[] board) {
        int xCount = 0;
        int oCount = 0;
        for (String row : board) {
            for (char c : row.toCharArray()) {
                if (c == 'X') xCount++;
                else if (c == 'O') oCount++;
                else if (c != ' ') throw new IllegalArgumentException("Invalid character in board");
            }
        }

        if (oCount > xCount) {
            throw new IllegalArgumentException("Invalid board: more O's than X's");
        }
        if (xCount > oCount + 1) {
            throw new IllegalArgumentException("Invalid board: too many X's");
        }

        boolean xWon = checkWin(board, 'X');
        boolean oWon = checkWin(board, 'O');

        if (xWon && oWon) {
            throw new IllegalArgumentException("Invalid board: both players won");
        }

        if (xWon || oWon) {
            if (xWon && xCount == oCount + 1) return GameState.WIN;
            if (oWon && oCount == xCount) return GameState.WIN;
            throw new IllegalArgumentException("Invalid board: game continued after win");
        }

        if (xCount + oCount == 9) {
            return GameState.DRAW;
        }

        if (xCount == oCount + 1 || xCount == oCount) {
            return GameState.ONGOING;
        }

        throw new IllegalArgumentException("Invalid board state");
    }

    private boolean checkWin(String[] board, char player) {
        // rows
        for (int i = 0; i < 3; i++) {
            if (board[i].charAt(0) == player &&
                board[i].charAt(1) == player &&
                board[i].charAt(2) == player) {
                return true;
            }
        }
        // columns
        for (int j = 0; j < 3; j++) {
            if (board[0].charAt(j) == player &&
                board[1].charAt(j) == player &&
                board[2].charAt(j) == player) {
                return true;
            }
        }
        // diagonals
        if (board[0].charAt(0) == player &&
            board[1].charAt(1) == player &&
            board[2].charAt(2) == player) {
            return true;
        }
        if (board[0].charAt(2) == player &&
            board[1].charAt(1) == player &&
            board[2].charAt(0) == player) {
            return true;
        }
        return false;
    }
}
