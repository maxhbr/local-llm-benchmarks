+                       }
+               } else if (start == 1 && b2 == sizeBucketTwo) || (start == 2 && b1 == sizeBucketOne) {
+                       // empty other bucket
+                       if start == 1 {
+                               b2 = 0
+                       } else {
+                               b1 = 0
+                       }
+               } else {
+                       // pour again (loop continues)
+                       continue
+               }
+               steps++
+               // check goal after fill/empty
+               if b1 == goalAmount {
+                       return "one", steps, b2, nil
+               }
+               if b2 == goalAmount {
+                       return "two", steps, b1, nil
+               }
+               if (start == 1 && b1 == 0 && b2 == sizeBucketTwo) || (start == 2 && b2 == 0 && b1 == 
sizeBucketOne) {
