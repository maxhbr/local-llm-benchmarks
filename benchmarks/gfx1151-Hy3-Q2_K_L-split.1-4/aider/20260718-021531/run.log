import io.reactivex.Observable;
import java.util.HashSet;
import java.util.Set;
import java.util.List;
import java.util.ArrayList;

class Hangman {

    private static final int MAX_MISSES = 6;

    Observable<Output> play(Observable<String> words, Observable<String> letters) {
        // State holder for a single game
        class State {
            String secret;
            Set<String> guess = new HashSet<>();
            Set<String> misses = new HashSet<>();
            List<Part> parts = new ArrayList<>();
            Status status = Status.PLAYING;

            State(String secret) {
                this.secret = secret;
            }
        }

        return words
            .switchMap(word -> {
                State initial = new State(word);
                return letters
                    .scan(initial, (state, letter) -> {
                        if (state.status != Status.PLAYING) {
                            return state;
                        }
                        String upperLetter = letter.toUpperCase();
                        if (state.guess.contains(upperLetter) || state.misses.contains(upperLetter)) {
                            return state;
                        }
                        if (state.secret.toUpperCase().contains(upperLetter)) {
                            state.guess.add(upperLetter);
                        } else {
                            state.misses.add(upperLetter);
                            state.parts.add(Part.values()[state.misses.size() - 1]);
                        }
                        // compute discovered
                        StringBuilder discovered = new StringBuilder();
                        for (char c : state.secret.toCharArray()) {
                            if (state.guess.contains(String.valueOf(c).toUpperCase())) {
                                discovered.append(c);
                            } else {
                                discovered.append('_');
                            }
                        }
                        boolean allGuessed = true;
                        for (char c : state.secret.toCharArray()) {
                            if (!state.guess.contains(String.valueOf(c).toUpperCase())) {
                                allGuessed = false;
                                break;
                            }
                        }
                        if (allGuessed) {
                            state.status = Status.WIN;
                        } else if (state.misses.size() >= MAX_MISSES) {
                            state.status = Status.LOSE;
                        }
                        return state;
                    })
                    .map(state -> {
                        StringBuilder discovered = new StringBuilder();
                        for (char c : state.secret.toCharArray()) {
                            if (state.guess.contains(String.valueOf(c).toUpperCase())) {
                                discovered.append(c);
                            } else {
                                discovered.append('_');
                            }
                        }
                        return new Output(
                            state.secret,
                            discovered.toString(),
                            state.guess,
                            state.misses,
                            state.parts,
                            state.status);
                    });
            });
    }

}
```

