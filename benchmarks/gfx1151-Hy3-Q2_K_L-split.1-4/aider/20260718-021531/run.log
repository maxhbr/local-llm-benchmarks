                    roll_index += 1
                elif self.rolls[roll_index] + self.rolls[roll_index + 1] == 10:  # spare
                    total += 10 + self.rolls[roll_index + 2]
                    roll_index += 2
                else:  # open
                    total += self.rolls[roll_index] + self.rolls[roll_index + 1]
                    roll_index += 2
            else:
                # tenth frame
                total += sum(self.tenth_rolls)
        return total
