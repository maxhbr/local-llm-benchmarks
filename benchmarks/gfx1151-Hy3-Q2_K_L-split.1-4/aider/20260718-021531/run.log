```
#include "diamond.h"
#include <string>
#include <vector>
#include <cctype>

namespace diamond {

std::vector<std::string> rows(char letter) {
    letter = static_cast<char>(toupper(letter));
    int n = letter - 'A';  // zero-based index of letter
    int size = 2 * n + 1;
    std::vector<std::string> result;
    result.reserve(size);

    for (int i = 0; i <= n; ++i) {
        char c = static_cast<char>('A' + i);
        std::string row(size, ' ');
        int mid = n;
        row[mid - i] = c;
        row[mid + i] = c;
        result.push_back(row);
    }
    for (int i = n - 1; i >= 0; --i) {
        result.push_back(result[i]);
    }
    return result;
}

std::string make_diamond(char letter) {
    std::vector<std::string> r = rows(letter);
    std::string result;
    for (size_t i = 0; i < r.size(); ++i) {
        result += r[i];
        if (i + 1 < r.size()) {
            result += '\n';
        }
    }
    return result;
}

}  // namespace diamond
```
