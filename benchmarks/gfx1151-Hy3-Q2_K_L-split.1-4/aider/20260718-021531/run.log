//
// This is only a SKELETON file for the 'Zipper' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export class Zipper {
  constructor(tree, parent = null, orientation = null) {
    this.tree = tree;
    this.parent = parent;
    this.orientation = orientation;
  }

  static fromTree(tree) {
    return new Zipper(tree, null, null);
  }

  toTree() {
    let z = this;
    while (z.parent) z = z.parent;
    return z.tree;
  }

  value() {
    return this.tree.value;
  }

  left() {
    if (!this.tree.left) return null;
    return new Zipper(this.tree.left, this, 'left');
  }

  right() {
    if (!this.tree.right) return null;
    return new Zipper(this.tree.right, this, 'right');
  }

  up() {
    return this.parent;
  }

  setValue(value) {
    const newTree = { value, left: this.tree.left, right: this.tree.right };
    if (!this.parent) return new Zipper(newTree, null, null);
    const newParent = this.orientation === 'left'
      ? this.parent.setLeft(newTree)
      : this.parent.setRight(newTree);
    return new Zipper(newTree, newParent, this.orientation);
  }

  setLeft(tree) {
    const newTree = { value: this.tree.value, left: tree, right: this.tree.right };
    if (!this.parent) return new Zipper(newTree, null, null);
    const newParent = this.orientation === 'left'
      ? this.parent.setLeft(newTree)
      : this.parent.setRight(newTree);
    return new Zipper(newTree, newParent, this.orientation);
  }

  setRight(tree) {
    const newTree = { value: this.tree.value, left: this.tree.left, right: tree };
    if (!this.parent) return new Zipper(newTree, null, null);
    const newParent = this.orientation === 'left'
      ? this.parent.setLeft(newTree)
      : this.parent.setRight(newTree);
    return new Zipper(newTree, newParent, this.orientation);
  }
}
