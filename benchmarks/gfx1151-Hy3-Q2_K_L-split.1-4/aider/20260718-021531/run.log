import java.util.ArrayList;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;

public class SgfParsing {
    public SgfNode parse(String input) throws SgfParsingException {
        Parser parser = new Parser(input);
        return parser.parse();
    }

    private static class Parser {
        private final String text;
        private int pos;

        Parser(String text) {
            this.text = text;
            this.pos = 0;
        }

        SgfNode parse() throws SgfParsingException {
            skipWhitespace();
            if (pos >= text.length() || text.charAt(pos) != '(') {
                throw new SgfParsingException("Expected '(' at start of SGF tree");
            }
            return parseTree();
        }

        private SgfNode parseTree() throws SgfParsingException {
            if (text.charAt(pos) != '(') {
                throw new SgfParsingException("Expected '('");
            }
            pos++; // consume '('
            SgfNode node = parseSequence();
            if (text.charAt(pos) != ')') {
                throw new SgfParsingException("Expected ')'");
            }
            pos++; // consume ')'
            skipWhitespace();
            return node;
        }

        private SgfNode parseSequence() throws SgfParsingException {
            SgfNode root = null;
            SgfNode current = null;
            while (pos < text.length() && (text.charAt(pos) == ';' || text.charAt(pos) == '(')) {
                if (text.charAt(pos) == ';') {
                    SgfNode newNode = parseNode();
                    if (root == null) {
                        root = newNode;
                        current = newNode;
                    } else {
                        current.addChild(newNode);
                        current = newNode;
                    }
                } else if (text.charAt(pos) == '(') {
                    SgfNode variationRoot = parseTree();
                    if (root == null) {
                        root = variationRoot;
                        current = variationRoot;
                    } else {
                        current.addChild(variationRoot);
                    }
                }
            }
            if (root == null) {
                throw new SgfParsingException("Empty sequence");
            }
            return root;
        }

        private SgfNode parseNode() throws SgfParsingException {
            if (text.charAt(pos) != ';') {
                throw new SgfParsingException("Expected ';'");
            }
            pos++; // consume ';'
            SgfNode node = new SgfNode();
            while (pos < text.length()) {
                char c = text.charAt(pos);
                if (c == '(' || c == ')' || c == ';') {
                    break;
                }
                if (Character.isUpperCase(c)) {
                    String key = parseKey();
                    while (pos < text.length() && text.charAt(pos) == '[') {
                        String value = parseValue();
                        node.addProperty(key, value);
                    }
                } else {
                    if (Character.isWhitespace(c)) {
                        pos++;
                    } else {
                        throw new SgfParsingException("Unexpected character in node: " + c);
                    }
                }
            }
            return node;
        }

        private String parseKey() throws SgfParsingException {
            StringBuilder key = new StringBuilder();
            while (pos < text.length() && Character.isUpperCase(text.charAt(pos))) {
                key.append(text.charAt(pos));
                pos++;
            }
            if (key.length() == 0) {
                throw new SgfParsingException("Empty property key");
            }
            return key.toString();
        }

        private String parseValue() throws SgfParsingException {
            if (text.charAt(pos) != '[') {
                throw new SgfParsingException("Expected '['");
            }
            pos++; // consume '['
            StringBuilder sb = new StringBuilder();
            while (pos < text.length()) {
                char c = text.charAt(pos);
                if (c == '\\') {
                    pos++;
                    if (pos >= text.length()) {
                        throw new SgfParsingException("Unterminated escape in value");
                    }
                    char escaped = text.charAt(pos);
                    if (escaped == '\n') {
                        pos++;
                        continue;
                    } else if (Character.isWhitespace(escaped)) {
                        sb.append(' ');
                        pos++;
                    } else {
                        sb.append(escaped);
                        pos++;
                    }
                } else if (c == ']') {
                    pos++; // consume ']'
                    return sb.toString();
                } else if (c == '\n') {
                    sb.append(c);
                    pos++;
                } else if (Character.isWhitespace(c)) {
                    sb.append(' ');
                    pos++;
                } else {
                    sb.append(c);
                    pos++;
                }
            }
            throw new SgfParsingException("Unterminated property value");
        }

        private void skipWhitespace() {
            while (pos < text.length() && Character.isWhitespace(text.charAt(pos))) {
                pos++;
            }
        }
    }
}
```

Note: I removed the nested `SgfNode` and `SgfParsingException` classes, assuming they are provided as top-level classes elsewhere (as per typical exercise structure). This should allow the code to compile with the test suite's own definitions and avoid class duplication issues. The Gradle wrapper error is environmental, but cleaning up the file to match expected structure is the best we can do within the given constraints.
