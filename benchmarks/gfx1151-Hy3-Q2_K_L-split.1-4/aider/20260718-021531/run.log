bowling.js
```
//
// This is only a SKELETON file for the 'Bowling' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export class Bowling {
  constructor() {
    this.rolls = [];
    this.currentFrame = 1;
    this.framePins = 0; // pins knocked down in current frame so far
    this.ballInFrame = 1; // 1 or 2 (or fill balls in 10th)
  }

  roll(pins) {
    if (pins < 0 || pins > 10) {
      throw new Error('Pins must be between 0 and 10');
    }
    if (this.currentFrame > 10) {
      throw new Error('Cannot roll after game is over');
    }
    if (this.currentFrame < 10) {
      if (this.ballInFrame === 1) {
        if (pins === 10) {
          // strike
          this.rolls.push(pins);
          this.currentFrame += 1;
          this.ballInFrame = 1;
          this.framePins = 0;
        } else {
          this.rolls.push(pins);
          this.framePins = pins;
          this.ballInFrame = 2;
        }
      } else {
        if (this.framePins + pins > 10) {
          throw new Error('Pin count cannot exceed 10 in a frame');
        }
        this.rolls.push(pins);
        this.currentFrame += 1;
        this.ballInFrame = 1;
        this.framePins = 0;
      }
    } else {
      // 10th frame
      this.rolls.push(pins);
      if (this.ballInFrame === 1) {
        if (pins === 10) {
          this.ballInFrame = 2; // strike, need two fill balls
        } else {
          this.ballInFrame = 2;
          this.framePins = pins;
        }
      } else if (this.ballInFrame === 2) {
        if (this.rolls[this.rolls.length - 2] === 10) {
          // first was strike, second is fill, need third if second is strike too
          if (pins === 10) {
            this.ballInFrame = 3;
          } else {
            this.ballInFrame = 3;
            this.framePins = pins;
          }
        } else {
          if (this.framePins + pins > 10) {
            throw new Error('Pin count cannot exceed 10 in a frame');
          }
          this.ballInFrame = 3; // open or spare, one fill ball if spare
          if (this.framePins + pins < 10) {
            this.currentFrame += 1; // game over after 2 balls if open
          }
        }
      } else if (this.ballInFrame === 3) {
        this.currentFrame += 1; // game over after fill balls
      }
    }
  }

  score() {
    if (this.currentFrame < 10 || (this.currentFrame === 10 && this.ballInFrame < 3 && this.rolls.length < 20)) {
      // not enough rolls to score (simplified check)
      if (this.rolls.length < 20) {
        throw new Error('Score cannot be calculated until the end of the game');
      }
    }
    let total = 0;
    let index = 0;
    for (let frame = 1; frame <= 10; frame++) {
      if (this.rolls[index] === 10) {
        // strike
        total += 10 + (this.rolls[index + 1] || 0) + (this.rolls[index + 2] || 0);
        index += 1;
      } else if (this.rolls[index] + (this.rolls[index + 1] || 0) === 10) {
        // spare
        total += 10 + (this.rolls[index + 2] || 0);
        index += 2;
      } else {
        // open frame
        total += (this.rolls[index] || 0) + (this.rolls[index + 1] || 0);
        index += 2;
      }
    }
    return total;
  }
}
