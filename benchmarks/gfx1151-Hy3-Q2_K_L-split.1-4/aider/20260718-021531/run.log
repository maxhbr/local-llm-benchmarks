```
import java.util.Arrays;

public class CircularBuffer<T> {

    private final T[] buffer;
    private int head;
    private int tail;
    private int count;
    private final int size;

    public CircularBuffer(final int size) {
        this.size = size;
        this.buffer = (T[]) new Object[size];
        this.head = 0;
        this.tail = 0;
        this.count = 0;
    }

    public T read() throws BufferIOException {
        if (count == 0) {
            throw new BufferIOException("Buffer is empty");
        }
        T data = buffer[head];
        buffer[head] = null;
        head = (head + 1) % size;
        count--;
        return data;
    }

    public void write(T data) throws BufferIOException {
        if (count == size) {
            throw new BufferIOException("Buffer is full");
        }
        buffer[tail] = data;
        tail = (tail + 1) % size;
        count++;
    }

    public void overwrite(T data) {
        if (count == size) {
            buffer[head] = data;
            head = (head + 1) % size;
            tail = (tail + 1) % size;
        } else {
            buffer[tail] = data;
            tail = (tail + 1) % size;
            count++;
        }
    }

    public void clear() {
        Arrays.fill(buffer, null);
        head = 0;
        tail = 0;
        count = 0;
    }

}

public class BufferIOException extends Exception {
    public BufferIOException(String message) {
        super(message);
    }
}
```
