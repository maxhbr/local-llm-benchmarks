            return (0, tuple(sorted(ranks, reverse=True)))

    parsed = [parse_hand(h) for h in hands]
    scored = []
    for ranks, suits, orig in parsed:
        score = evaluate(ranks, suits)
        scored.append((score, orig))

    best_score = max(s[0] for s in scored)
    best = [orig for score, orig in scored if score == best_score]
    return best
