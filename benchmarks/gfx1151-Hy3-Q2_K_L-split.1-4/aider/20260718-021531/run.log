fn add_strings(a: &str, b: &str) -> String {
    let mut result = String::new();
    let mut carry = 0;
    let a: Vec<u8> = a.bytes().rev().collect();
    let b: Vec<u8> = b.bytes().rev().collect();
    let len = a.len().max(b.len());
