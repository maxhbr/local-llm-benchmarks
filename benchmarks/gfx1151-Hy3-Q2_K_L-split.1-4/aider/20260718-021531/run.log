export function count(rows) {
  if (!rows || rows.length === 0) return 0;
  // If rows is a single string, split into lines
  if (typeof rows === 'string') {
    rows = rows.split('\n');
  }
  const height = rows.length;
  if (height === 0) return 0;
  const width = rows[0].length;
  let rectangles = 0;

  for (let top = 0; top < height; top++) {
    for (let left = 0; left < width; left++) {
      if (rows[top][left] !== '+') continue;
      for (let bottom = top + 1; bottom < height; bottom++) {
        for (let right = left + 1; right < width; right++) {
          if (rows[bottom][right] !== '+') continue;
          // Check top edge (top, left -> right)
          let topEdgeOk = true;
          for (let c = left; c <= right; c++) {
            const ch = rows[top][c];
            if (ch !== '+' && ch !== '-') { topEdgeOk = false; break; }
          }
          if (!topEdgeOk) continue;
          // Check bottom edge (bottom, left -> right)
          let bottomEdgeOk = true;
          for (let c = left; c <= right; c++) {
            const ch = rows[bottom][c];
            if (ch !== '+' && ch !== '-') { bottomEdgeOk = false; break; }
          }
          if (!bottomEdgeOk) continue;
          // Check left edge (top -> bottom, left)
          let leftEdgeOk = true;
          for (let r = top; r <= bottom; r++) {
            const ch = rows[r][left];
            if (ch !== '+' && ch !== '|') { leftEdgeOk = false; break; }
          }
          if (!leftEdgeOk) continue;
          // Check right edge (top -> bottom, right)
          let rightEdgeOk = true;
          for (let r = top; r <= bottom; r++) {
            const ch = rows[r][right];
            if (ch !== '+' && ch !== '|') { rightEdgeOk = false; break; }
          }
          if (rightEdgeOk) rectangles++;
        }
      }
    }
  }
  return rectangles;
}

// CommonJS fallback for environments that do not support ES modules
if (typeof module !== 'undefined') {
  module.exports = { count };
}
