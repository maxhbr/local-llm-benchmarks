NODE, EDGE, ATTR = range(3)


class Node:
    def __init__(self, name, attrs):
        self.name = name
        self.attrs = attrs

    def __eq__(self, other):
        return self.name == other.name and self.attrs == other.attrs


class Edge:
    def __init__(self, src, dst, attrs):
        self.src = src
        self.dst = dst
        self.attrs = attrs

    def __eq__(self, other):
        return (self.src == other.src and
                self.dst == other.dst and
                self.attrs == other.attrs)


class Graph:
    def __init__(self, data=None):
        if data is None:
            data = []
        if not isinstance(data, list):
            raise TypeError("Graph data malformed")
        self.attrs = {}
        self.nodes = []
        self.edges = []
        node_names = set()
        for item in data:
            if not isinstance(item, tuple) or len(item) < 1:
                raise TypeError("Graph data malformed")
            tag = item[0]
            if tag == ATTR:
                if len(item) != 2 or not isinstance(item[1], dict):
                    raise ValueError("attribute malformed")
                self.attrs.update(item[1])
            elif tag == NODE:
                if len(item) != 3 or not isinstance(item[2], dict):
                    raise ValueError("Node malformed")
                name = item[1]
                attrs = item[2]
                node = Node(name, attrs)
                if name in node_names:
                    raise ValueError("Node malformed")
                node_names.add(name)
                self.nodes.append(node)
            elif tag == EDGE:
                if len(item) != 4 or not isinstance(item[3], dict):
                    raise ValueError("EDGE malformed")
                src = item[1]
                dst = item[2]
                attrs = item[3]
                if src not in node_names or dst not in node_names:
                    raise ValueError("EDGE malformed")
                self.edges.append(Edge(src, dst, attrs))
            else:
                raise TypeError("Graph data malformed")
```
