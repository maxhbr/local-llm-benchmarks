kindergarten_garden.go
```
package kindergarten

import (
	"errors"
	"sort"
	"strings"
)

// Garden represents the planting assignments for the kindergarten class.
type Garden struct {
	plants map[string][]string
}

// The diagram argument starts each row with a '\n'.  This allows Go's
// raw string literals to present diagrams in source code nicely as two
// rows flush left, for example,
//
//     diagram := `
//     VVCCGG
//     VVCCGG`

func NewGarden(diagram string, children []string) (*Garden, error) {
	// Remove leading newline and split rows.
	rows := strings.Split(strings.TrimPrefix(diagram, "\n"), "\n")
	if len(rows) != 2 {
		return nil, errors.New("invalid diagram: expected two rows")
	}
	row1 := rows[0]
	row2 := rows[1]
	if len(row1) != len(row2) {
		return nil, errors.New("invalid diagram: rows must be equal length")
	}
	totalCups := len(row1)
	if totalCups != len(children)*4 {
		return nil, errors.New("invalid diagram: number of cups does not match children")
	}

	// Children must be sorted alphabetically as per assignment rules.
	sortedChildren := make([]string, len(children))
	copy(sortedChildren, children)
	sort.Strings(sortedChildren)

	plantNames := map[byte]string{
		'G': "grass",
		'C': "clover",
		'R': "radish",
		'V': "violet",
	}

	g := &Garden{plants: make(map[string][]string, len(sortedChildren))}
	for i, child := range sortedChildren {
		start := i * 4
		codes := []byte{row1[start], row1[start+1], row2[start], row2[start+1]}
		assigned := make([]string, 0, 4)
		for _, c := range codes {
			name, ok := plantNames[c]
			if !ok {
				return nil, errors.New("invalid plant code in diagram")
			}
			assigned = append(assigned, name)
		}
		g.plants[child] = assigned
	}

	return g, nil
}

func (g *Garden) Plants(child string) ([]string, bool) {
	plants, ok := g.plants[child]
	if !ok {
		return nil, false
	}
	return plants, true
}
```
