```
#include "meetup.h"

#include <ctime>
#include <string>
#include <array>
#include <cstdlib>

namespace meetup {

namespace {

int weekday_to_tm(const std::string& weekday) {
    // tm_day: 0=Sun, 1=Mon, ..., 6=Sat
    static const std::array<std::string, 7> names = {
        "Sunday", "Monday", "Tuesday", "Wednesday",
        "Thursday", "Friday", "Saturday"
    };
    for (int i = 0; i < 7; ++i) {
        if (names[i] == weekday) return i;
    }
    return -1;
}

int days_in_month(int year, int month) {
    int days[] = {31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
    if (month == 2 && (year % 4 == 0 && (year % 100 != 0 || year % 400 == 0))) {
        return 29;
    }
    return days[month - 1];
}

} // anonymous namespace

MeetupDate find_meetup(int year, int month, const std::string& week, const std::string& weekday) {
    int target_wd = weekday_to_tm(weekday);
    int dim = days_in_month(year, month);

    int first_wd = -1;
    {
        std::tm t = {};
        t.tm_year = year - 1900;
        t.tm_mon = month - 1;
        t.tm_mday = 1;
        t.tm_hour = 0; t.tm_min = 0; t.tm_sec = 0;
        t.tm_isdst = -1;
        mktime(&t);
        first_wd = t.tm_wday; // 0=Sun ... 6=Sat
    }

    auto day_for_nth = [&](int n) -> int {
        int day = 1 + (target_wd - first_wd + 7) % 7;
        day += (n - 1) * 7;
        return day;
    };

    MeetupDate result{year, month, 1};

    if (week == "first") {
        result.day = day_for_nth(1);
    } else if (week == "second") {
        result.day = day_for_nth(2);
    } else if (week == "third") {
        result.day = day_for_nth(3);
    } else if (week == "fourth") {
        result.day = day_for_nth(4);
    } else if (week == "last") {
        int d = day_for_nth(5);
        if (d > dim) d = day_for_nth(4);
        result.day = d;
    } else if (week == "teenth") {
        for (int d = 13; d <= 19; ++d) {
            std::tm t = {};
            t.tm_year = year - 1900;
            t.tm_mon = month - 1;
            t.tm_mday = d;
            t.tm_hour = 0; t.tm_min = 0; t.tm_sec = 0;
            t.tm_isdst = -1;
            mktime(&t);
            if (t.tm_wday == target_wd) {
                result.day = d;
                break;
            }
        }
    }

    return result;
}

}  // namespace meetup
```
