I will implement the `answer` function in `wordy.js` to parse and evaluate simple math word problems according to the instructions, handling iterations 0–4 (numbers, addition, subtraction, multiplication, division, multiple operations, and syntax/unsupported operation errors).

wordy.js
```
//
// This is only a SKELETON file for the 'Wordy' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export const answer = (question) => {
  // Normalize and strip trailing question mark
  const trimmed = question.trim().replace(/\?$/, '').trim();
  const prefix = 'What is';
  if (!trimmed.startsWith(prefix)) {
    throw new Error('Unknown operation');
  }
  let body = trimmed.slice(prefix.length).trim();
  if (body === '') {
    throw new Error('Syntax error');
  }

  // Parse the sequence of numbers and operations
  const tokenRegex = /(-?\d+)|(plus|minus|multiplied by|divided by)|(.+)/g;
  let match;
  let currentNumber = null;
  let pendingOp = null;
  let result = null;

  let rest = body;
  while (rest.length > 0) {
    // Match a number or an operation at the start of rest
    const numMatch = rest.match(/^(-?\d+)(.*)$/);
    const opMatch = rest.match(/^(plus|minus|multiplied by|divided by)(.*)$/);
    if (numMatch) {
      const val = parseInt(numMatch[1], 10);
      if (pendingOp === null) {
        if (result === null) {
          result = val;
        } else {
          throw new Error('Syntax error');
        }
      } else {
        switch (pendingOp) {
          case 'plus':
            result += val;
            break;
          case 'minus':
            result -= val;
            break;
          case 'multiplied by':
            result *= val;
            break;
          case 'divided by':
            result /= val;
            break;
        }
        pendingOp = null;
      }
      rest = numMatch[2].trim();
    } else if (opMatch) {
      if (pendingOp !== null) {
        throw new Error('Syntax error');
      }
      pendingOp = opMatch[1];
      rest = opMatch[2].trim();
    } else {
      // Unsupported operation or invalid syntax
      throw new Error('Unknown operation');
    }
  }

  if (pendingOp !== null) {
    throw new Error('Syntax error');
  }

  return result;
};
```
