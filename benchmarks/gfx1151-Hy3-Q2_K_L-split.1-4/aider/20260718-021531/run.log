+const VOWELS = ['a', 'e', 'i', 'o', 'u'];
+
+function translateWord(word) {
+  // Rule 1: begins with vowel, or "xr" or "yt"
+  if (VOWELS.includes(word[0]) || word.startsWith('xr') || word.startsWith('yt')) {
+    return word + 'ay';
+  }
+
+  // Rule 3: zero or more consonants followed by "qu"
+  const quMatch = word.match(/^([^aeiouy]*qu)(.*)$/);
+  if (quMatch) {
+    return quMatch[2] + quMatch[1] + 'ay';
+  }
+
+  // Rule 4: one or more consonants followed by "y"
+  const yMatch = word.match(/^([^aeiouy]+)y(.*)$/);
+  if (yMatch) {
+    return 'y' + yMatch[2] + yMatch[1] + 'ay';
+  }
+
+  // Rule 2: one or more consonants at beginning
+  const consMatch = word.match(/^([^aeiouy]+)(.*)$/);
+  if (consMatch) {
+    return consMatch[2] + consMatch[1] + 'ay';
+  }
+
+  // fallback (shouldn't normally hit)
+  return word + 'ay';
+}
+
+export const translate = (phrase) => {
+  return phrase
+    .split(' ')
+    .map(translateWord)
+    .join(' ');
 };
