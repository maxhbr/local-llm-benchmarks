from json import dumps


class Tree:
    def __init__(self, label, children=None):
        self.label = label
        self.children = children if children is not None else []

    def __dict__(self):
        return {self.label: [c.__dict__() for c in sorted(self.children)]}

    def __str__(self, indent=None):
        return dumps(self.__dict__(), indent=indent)

    def __lt__(self, other):
        return self.label < other.label

    def __eq__(self, other):
        return self.__dict__() == other.__dict__()

    def _find(self, label):
        if self.label == label:
            return self
        for child in self.children:
            res = child._find(label)
            if res is not None:
                return res
        return None

    def from_pov(self, from_node):
        def find_path(node, target):
            if node.label == target:
                return [node]
            for child in node.children:
                res = find_path(child, target)
                if res is not None:
                    return [node] + res
            return None

        path = find_path(self, from_node)
        if path is None:
            raise ValueError("Tree could not be reoriented")

        def build(idx):
            node = path[idx]
            if idx == len(path) - 1:
                children = list(node.children)
                if idx > 0:
                    parent_tree = build(idx - 1)
                    children.append(parent_tree)
                return Tree(node.label, children)
            else:
                below = build(idx + 1)
                other = [c for c in node.children if c.label != path[idx + 1].label]
                return Tree(node.label, other + [below])

        return build(len(path) - 1)

    def path_to(self, from_node, to_node):
        if self._find(from_node) is None:
            raise ValueError("Tree could not be reoriented")
        if self._find(to_node) is None:
            raise ValueError("No path found")

        def root_to(target):
            def dfs(node, target, acc):
                acc.append(node.label)
                if node.label == target:
                    return acc
                for child in node.children:
                    res = dfs(child, target, acc)
                    if res is not None:
                        return res
                acc.pop()
                return None
            return dfs(self, target, [])

        from_path = root_to(from_node)
        to_path = root_to(to_node)

        # find length of common prefix
        common = 0
        while (common < len(from_path) and common < len(to_path)
               and from_path[common] == to_path[common]):
            common += 1

        # path from from_node up to common ancestor and down to to_node
        path = list(reversed(from_path[common - 1:])) + to_path[common:]
        return path
```

