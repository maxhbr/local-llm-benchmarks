Changes needed:
1. Remove the throwing errors and implement `constructor`, `chromatic`, and `interval` methods.
2. Use the chromatic scale with sharps or flats depending on the tonic (following the table in the instructions).
3. Normalize tonics to uppercase (except `b` for flats) and handle natural C/a as sharps ascending.
4. For `chromatic()`: return the 12-note scale starting at the tonic using the appropriate sharp/flat collection, rotated so it begins with the tonic.
5. For `interval(intervals)`: return tonic + notes after skipping per interval (M = whole step = skip 1 note, m = half step = skip 0 notes, A = augmented second = skip 2 notes) using the same chromatic collection as the tonic.

Here is the updated file:

scale-generator.js
```
//
// This is only a SKELETON file for the 'Scale Generator' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

const SHARP_CHROMATIC = ['A', 'A♯', 'B', 'C', 'C♯', 'D', 'D♯', 'E', 'F', 'F♯', 'G', 'G♯'];
const FLAT_CHROMATIC = ['A', 'B♭', 'B', 'C', 'D♭', 'D', 'E♭', 'E', 'F', 'G♭', 'G', 'A♭'];

const SHARP_TONICS = new Set(['C', 'G', 'D', 'A', 'E', 'B', 'F♯', 'a', 'e', 'b', 'f♯', 'c♯', 'g♯', 'd♯']);
const FLAT_TONICS = new Set(['F', 'B♭', 'E♭', 'A♭', 'D♭', 'G♭', 'd', 'g', 'c', 'f', 'b♭', 'e♭']);

export class Scale {
  constructor(tonic) {
    this.tonic = tonic;
    let normalized = tonic.charAt(0).toUpperCase() + tonic.slice(1);
    if (SHARP_TONICS.has(normalized)) {
      this.chromaticScale = SHARP_CHROMATIC;
    } else if (FLAT_TONICS.has(normalized)) {
      this.chromaticScale = FLAT_CHROMATIC;
    } else {
      // default to sharps for unknown / natural C,a
      this.chromaticScale = SHARP_CHROMATIC;
    }
    this.tonicNormal = normalized;
  }

  chromatic() {
    const start = this.chromaticScale.indexOf(this.tonicNormal);
    if (start === -1) {
      // fallback: try to find by uppercase only (should not happen)
      const idx = this.chromaticScale.findIndex(n => n.toUpperCase() === this.tonicNormal.toUpperCase());
      const s = idx === -1 ? 0 : idx;
      return this.chromaticScale.slice(s).concat(this.chromaticScale.slice(0, s));
    }
    return this.chromaticScale.slice(start).concat(this.chromaticScale.slice(0, start));
  }

  interval(intervals) {
    const chrom = this.chromatic();
    const result = [chrom[0]];
    let current = 0;
    for (const iv of intervals) {
      let skip;
      if (iv === 'M') skip = 1;
      else if (iv === 'm') skip = 0;
      else if (iv === 'A') skip = 2;
      else skip = 0; // default safety
      current = (current + skip + 1) % chrom.length;
      result.push(chrom[current]);
    }
    return result;
  }
}
```
