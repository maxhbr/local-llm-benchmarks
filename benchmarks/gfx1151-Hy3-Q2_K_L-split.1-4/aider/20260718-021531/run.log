use std::collections::HashMap;

#[derive(Debug, Clone, PartialEq)]
pub struct Node {
    pub id: String,
    pub attrs: HashMap<String, String>,
}

#[derive(Debug, Clone, PartialEq)]
pub struct Edge {
    pub from: String,
    pub to: String,
    pub attrs: HashMap<String, String>,
}

pub struct Graph {
    pub bgcolor: String,
    pub nodes: Vec<Node>,
    pub edges: Vec<Edge>,
}

impl Graph {
    pub fn new() -> Self {
        Graph {
            bgcolor: "white".to_string(),
            nodes: Vec::new(),
            edges: Vec::new(),
        }
    }

    /// Builder-style method to set the background color.
    pub fn bgcolor(mut self, color: &str) -> Self {
        self.bgcolor = color.to_string();
        self
    }

    /// Builder-style method to add a node with an optional color attribute.
    pub fn node(mut self, id: &str, color: Option<&str>) -> Self {
        let mut attrs = HashMap::new();
        if let Some(c) = color {
            attrs.insert("color".to_string(), c.to_string());
        }
        self.nodes.push(Node {
            id: id.to_string(),
            attrs,
        });
        self
    }

    /// Builder-style method to add an edge between two nodes with an optional color.
    pub fn edge(mut self, from: &str, to: &str, color: Option<&str>) -> Self {
        let mut attrs = HashMap::new();
        if let Some(c) = color {
            attrs.insert("color".to_string(), c.to_string());
        }
        self.edges.push(Edge {
            from: from.to_string(),
            to: to.to_string(),
            attrs,
        });
        self
    }
}
