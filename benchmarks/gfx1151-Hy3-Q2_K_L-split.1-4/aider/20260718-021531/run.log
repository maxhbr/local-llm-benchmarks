#include "queen_attack.h"
#include <cmath>
#include <stdexcept>

namespace queen_attack {

chess_board::chess_board(position_t white, position_t black)
    : white_(white), black_(black) {
    // Validate positions are on an 8x8 board and not the same square
    auto valid = [](position_t p) {
        return p.first >= 0 && p.first < 8 && p.second >= 0 && p.second < 8;
    };
    if (!valid(white_) || !valid(black_)) {
        throw std::invalid_argument("Queen position out of bounds");
    }
    if (white_ == black_) {
        throw std::invalid_argument("Queens cannot occupy the same square");
    }
}

bool chess_board::can_attack() const {
    int dx = white_.first - black_.first;
    int dy = white_.second - black_.second;
    // Same row, same column, or same diagonal (abs(dx) == abs(dy))
    return dx == 0 || dy == 0 || std::abs(dx) == std::abs(dy);
}

}  // namespace queen_attack
```
