//
// This is only a SKELETON file for the 'Meetup' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

const WEEKDAYS = {
  Sunday: 0,
  Monday: 1,
  Tuesday: 2,
  Wednesday: 3,
  Thursday: 4,
  Friday: 5,
  Saturday: 6,
};

const MONTHS = {
  January: 0,
  February: 1,
  March: 2,
  April: 3,
  May: 4,
  June: 5,
  July: 6,
  August: 7,
  September: 8,
  October: 9,
  November: 10,
  December: 11,
};

const meetup = (year, month, weekday, week) => {
  const monthIndex = MONTHS[month];
  const weekdayIndex = WEEKDAYS[weekday];

  if (week === 'teenth') {
    for (let day = 13; day <= 19; day++) {
      const date = new Date(year, monthIndex, day);
      if (date.getDay() === weekdayIndex) {
        return date;
      }
    }
  }

  if (week === 'last') {
    let date = new Date(year, monthIndex + 1, 0); // last day of month
    while (date.getDay() !== weekdayIndex) {
      date.setDate(date.getDate() - 1);
    }
    return date;
  }

  const order = { first: 1, second: 2, third: 3, fourth: 4 }[week];
  let found = 0;
  for (let day = 1; day <= 31; day++) {
    const date = new Date(year, monthIndex, day);
    if (date.getMonth() !== monthIndex) break;
    if (date.getDay() === weekdayIndex) {
      found++;
      if (found === order) {
        return date;
      }
    }
  }

  throw new Error('No matching date found');
};

module.exports = { meetup };
```

