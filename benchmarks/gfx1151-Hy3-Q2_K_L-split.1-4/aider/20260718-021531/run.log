#include "meetup.h"

#include <boost/date_time/gregorian/gregorian.hpp>

namespace meetup {

namespace {

using namespace boost::gregorian;

// Helper to get weekday from string not needed; we use greg_weekday directly.

}  // anonymous namespace

scheduler::scheduler(boost::gregorian::greg_month month, int year)
    : month_(month), year_(year) {}

boost::gregorian::date scheduler::teenth(boost::gregorian::greg_weekday wd) const {
    date d(year_, month_, 13);
    while (d.day_of_week() != wd) {
        ++d;
    }
    return d; // guaranteed to be within 13-19
}

boost::gregorian::date scheduler::nth(boost::gregorian::greg_weekday wd, int n) const {
    date d(year_, month_, 1);
    int count = 0;
    while (d.month() == month_) {
        if (d.day_of_week() == wd) {
            ++count;
            if (count == n) return d;
        }
        ++d;
    }
    return d; // should never go out of month for n<=4
}

boost::gregorian::date scheduler::last(boost::gregorian::greg_weekday wd) const {
    date d(year_, month_, boost::gregorian::gregorian_calendar::end_of_month_day(year_, month_));
    while (d.day_of_week() != wd) {
        --d;
    }
    return d;
}

