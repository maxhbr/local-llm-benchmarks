// This exercise is about translating codons (possibly using shorthand)
// to amino acid names, based on a provided list of exact codon/name pairs.

use std::collections::HashMap;

pub struct CodonsInfo<'a> {
    pairs: HashMap<&'a str, &'a str>,
}

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct Error;

impl<'a> CodonsInfo<'a> {
    pub fn name_for(&self, codon: &str) -> Result<&'a str, Error> {
        let expansions = Self::expand_codon(codon).ok_or(Error)?;
        let mut result: Option<&'a str> = None;
        for exact in expansions {
            let name = self.pairs.get(exact.as_str()).ok_or(Error)?;
            match result {
                None => result = Some(name),
                Some(prev) if prev != *name => return Err(Error),
                _ => {}
            }
        }
        result.ok_or(Error)
    }

    pub fn of_rna(&self, rna: &str) -> Result<Vec<&'a str>, Error> {
        let mut names = Vec::new();
        let mut chars = rna.chars();
        while let Some(c1) = chars.next() {
            let c2 = chars.next().ok_or(Error)?;
            let c3 = chars.next().ok_or(Error)?;
            let codon = format!(
                "{}{}{}",
                c1.to_ascii_uppercase(),
                c2.to_ascii_uppercase(),
                c3.to_ascii_uppercase()
            );
            let name = self.name_for(&codon)?;
            names.push(name);
        }
        Ok(names)
    }

    fn expand_codon(codon: &str) -> Option<Vec<String>> {
        let mut acc = vec![String::new()];
        for ch in codon.chars() {
            let upper = ch.to_ascii_uppercase();
            let variants: &[&str] = match upper {
                'A' => &["A"],
                'C' => &["C"],
                'G' => &["G"],
                'T' => &["T"],
                'R' => &["A", "G"],
                'Y' => &["C", "T"],
                'S' => &["G", "C"],
                'W' => &["A", "T"],
                'K' => &["G", "T"],
                'M' => &["A", "C"],
                'B' => &["C", "G", "T"],
                'D' => &["A", "G", "T"],
                'H' => &["A", "C", "T"],
                'V' => &["A", "C", "G"],
                'N' => &["A", "C", "G", "T"],
                _ => return None,
            };
            let mut next = Vec::new();
            for prefix in &acc {
                for v in variants {
                    next.push(format!("{}{}", prefix, v));
                }
            }
            acc = next;
        }
        Some(acc)
    }
}

pub fn parse<'a>(pairs: Vec<(&'a str, &'a str)>) -> CodonsInfo<'a> {
    let mut map = HashMap::new();
    for (codon, name) in pairs {
        map.insert(codon, name);
    }
    CodonsInfo { pairs: map }
}
```

