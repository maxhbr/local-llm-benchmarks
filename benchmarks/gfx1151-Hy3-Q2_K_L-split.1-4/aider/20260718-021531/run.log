I will implement VLQ encoding and decoding according to the instructions, including raising a `ValueError("incomplete sequence")` when a decode sequence is incomplete (last byte has bit 7 set).

variable_length_quantity.py
```
def encode(numbers):
    encoded = []
    for number in numbers:
        if number < 0 or number > 0xFFFFFFFF:
            raise ValueError("number out of range for 32-bit unsigned integer")
        # Break number into 7-bit groups, LSB first
        if number == 0:
            encoded.append(0)
            continue
        bytes_ = []
        n = number
        while n > 0:
            bytes_.append(n & 0x7F)
            n >>= 7
        # Set bit 7 (0x80) on all but the last byte (which is the first we appended)
        for i in range(len(bytes_) - 1):
            bytes_[i] |= 0x80
        # bytes_ is LSB first, so reverse to MSB first for output
        encoded.extend(reversed(bytes_))
    return encoded


def decode(bytes_):
    numbers = []
    value = 0
    shift = 0
    incomplete = False
    for byte in bytes_:
        if byte & 0x80:
            # Continuation byte
            value |= (byte & 0x7F) << shift
            shift += 7
            incomplete = True
        else:
            # Last byte of this number
            value |= (byte & 0x7F) << shift
            numbers.append(value)
            value = 0
            shift = 0
            incomplete = False
    if incomplete:
        raise ValueError("incomplete sequence")
    return numbers
```
