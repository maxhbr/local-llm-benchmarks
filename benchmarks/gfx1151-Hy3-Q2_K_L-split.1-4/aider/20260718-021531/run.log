package twobucket

import (
	"errors"
	"fmt"
)

func gcd(a, b int) int {
	for b != 0 {
		a, b = b, a%b
	}
	return a
}

func Solve(sizeBucketOne, sizeBucketTwo, goalAmount int, startBucket string) (string, int, int, error) {
	if sizeBucketOne <= 0 || sizeBucketTwo <= 0 || goalAmount <= 0 {
		return "", 0, 0, errors.New("invalid bucket sizes or goal amount")
	}
	if startBucket != "one" && startBucket != "two" {
		return "", 0, 0, errors.New("invalid start bucket")
	}
	if goalAmount > sizeBucketOne && goalAmount > sizeBucketTwo {
		return "", 0, 0, errors.New("goal amount exceeds both bucket sizes")
	}

	// Bonus: if sizes are not relatively prime and goal not divisible by gcd, unsolvable
	if gcd(sizeBucketOne, sizeBucketTwo) != 1 && goalAmount%gcd(sizeBucketOne, sizeBucketTwo) != 0 {
		return "", 0, 0, errors.New("unsolvable combination")
	}

	var start, other int
	if startBucket == "one" {
		start, other = 1, 2
	} else {
		start, other = 2, 1
	}

	b1, b2 := 0, 0
	steps := 0

	// first action: fill start bucket
	if start == 1 {
		b1 = sizeBucketOne
	} else {
		b2 = sizeBucketTwo
	}
	steps++

	// check if first fill already meets goal
	if b1 == goalAmount {
		return "one", steps, b2, nil
	}
	if b2 == goalAmount {
		return "two", steps, b1, nil
	}

	// simulate
	for {
		if start == 1 {
			// pour from bucket one to bucket two
			space := sizeBucketTwo - b2
			if b1 <= space {
				b2 += b1
				b1 = 0
			} else {
				b1 -= space
				b2 = sizeBucketTwo
			}
		} else {
			// pour from bucket two to bucket one
			space := sizeBucketOne - b1
			if b2 <= space {
				b1 += b2
				b2 = 0
			} else {
				b2 -= space
				b1 = sizeBucketOne
			}
		}
		steps++

		// check goal
		if b1 == goalAmount {
			return "one", steps, b2, nil
		}
		if b2 == goalAmount {
			return "two", steps, b1, nil
		}

		// rule: cannot end with start empty and other full
		if (start == 1 && b1 == 0 && b2 == sizeBucketTwo) || (start == 2 && b2 == 0 && b1 == sizeBucketOne) {
			return "", 0, 0, errors.New("invalid state reached")
		}

		// next action: if start bucket empty, fill it; else if other bucket full, empty it; else pour
		if (start == 1 && b1 == 0) || (start == 2 && b2 == 0) {
			// fill start bucket
			if start == 1 {
				b1 = sizeBucketOne
			} else {
				b2 = sizeBucketTwo
			}
		} else if (start == 1 && b2 == sizeBucketTwo) || (start == 2 && b1 == sizeBucketOne) {
			// empty other bucket
			if start == 1 {
				b2 = 0
			} else {
				b1 = 0
			}
		} else {
			// pour again (loop continues)
			continue
		}
		steps++
		// check goal after fill/empty
		if b1 == goalAmount {
			return "one", steps, b2, nil
		}
		if b2 == goalAmount {
			return "two", steps, b1, nil
		}
		if (start == 1 && b1 == 0 && b2 == sizeBucketTwo) || (start == 2 && b2 == 0 && b1 == sizeBucketOne) {
			return "", 0, 0, errors.New("invalid state reached")
		}
	}
