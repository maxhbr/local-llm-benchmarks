+bool chess_board::can_attack() const {
+    int dx = white_.first - black_.first;
+    int dy = white_.second - black_.second;
+    // Same row, same column, or same diagonal (abs(dx) == abs(dy))
+    return dx == 0 || dy == 0 || std::abs(dx) == std::abs(dy);
+}
