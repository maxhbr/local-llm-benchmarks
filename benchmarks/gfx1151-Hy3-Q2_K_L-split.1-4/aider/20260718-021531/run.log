package counter

import (
	"testing"
	"unicode"
	"unicode/utf8"
)

// Counter counts lines, letters and characters of added strings.
type Counter struct {
	lines      int
	letters    int
	characters int
}

// AddString adds the counts of the given string to the totals.
func (c *Counter) AddString(s string) {
	if len(s) > 0 {
		c.lines++
	}
	for _, r := range s {
		c.characters++
		if unicode.IsLetter(r) {
			c.letters++
		}
		if r == '\n' {
			c.lines++
		}
	}
}

// Lines returns the total number of lines added.
func (c *Counter) Lines() int {
	return c.lines
}

// Letters returns the total number of letters added.
func (c *Counter) Letters() int {
	return c.letters
}

// Characters returns the total number of characters (runes) added.
func (c *Counter) Characters() int {
	return c.characters
}

// TestCounter is a basic test suite for the Counter.
func TestCounter(t *testing.T) {
	t.Run("empty", func(t *testing.T) {
		var c Counter
		if c.Lines() != 0 || c.Letters() != 0 || c.Characters() != 0 {
			t.Errorf("empty counter should be zero")
		}
	})
	t.Run("simple string", func(t *testing.T) {
		var c Counter
		c.AddString("hello\nworld")
		if c.Lines() != 2 {
			t.Errorf("expected 2 lines, got %d", c.Lines())
		}
		if c.Letters() != 10 {
			t.Errorf("expected 10 letters, got %d", c.Letters())
		}
		if c.Characters() != 11 {
			t.Errorf("expected 11 characters, got %d", c.Characters())
		}
	})
	t.Run("multiple adds", func(t *testing.T) {
		var c Counter
		c.AddString("a")
		c.AddString("b\nc")
		if c.Lines() != 2 {
			t.Errorf("expected 2 lines, got %d", c.Lines())
		}
		if c.Letters() != 3 {
			t.Errorf("expected 3 letters, got %d", c.Letters())
		}
		if c.Characters() != 4 {
			t.Errorf("expected 4 characters, got %d", c.Characters())
		}
	})
	t.Run("unicode letters", func(t *testing.T) {
		var c Counter
		c.AddString("café")
		if c.Letters() != 4 {
			t.Errorf("expected 4 letters, got %d", c.Letters())
		}
		if c.Characters() != 4 {
			t.Errorf("expected 4 characters, got %d", c.Characters())
		}
	})
}
