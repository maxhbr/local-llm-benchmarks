class BowlingGame:
    def __init__(self):
        self.rolls = []  # flat list of all rolls in order
        self.current_frame = 1

    def roll(self, pins):
        if not (0 <= pins <= 10):
            raise ValueError("pins must be between 0 and 10")

        if self.current_frame > 10:
            raise IndexError("cannot roll after game is over")

        if self.current_frame < 10:
            self.rolls.append(pins)
            if self._frame_done(self.current_frame - 1):
                self.current_frame += 1
        else:
            self.rolls.append(pins)
            self._validate_tenth()
            if self._tenth_done():
                self.current_frame += 1

    def _frame_done(self, frame_index):
        # frame_index is 0-based for frames 1-9
        start = 0
        for f in range(frame_index):
            if self.rolls[start] == 10:  # strike
                start += 1
            else:
                start += 2
        if self.rolls[start] == 10:  # strike
            return True
        if len(self.rolls) >= start + 2:
            if self.rolls[start] + self.rolls[start + 1] > 10:
                raise ValueError("two rolls in a frame cannot exceed 10 pins")
            return True
        return False

    def _validate_tenth(self):
        tenth_start = 0
        for f in range(9):
            if self.rolls[tenth_start] == 10:
                tenth_start += 1
            else:
                tenth_start += 2
        if len(self.rolls) < tenth_start + 1:
            return
        r1 = self.rolls[tenth_start]
        if len(self.rolls) >= tenth_start + 2:
            r2 = self.rolls[tenth_start + 1]
            if r1 != 10 and r1 + r2 > 10:
                raise ValueError("two rolls in tenth frame cannot exceed 10 pins")
        if len(self.rolls) >= tenth_start + 3:
            r3 = self.rolls[tenth_start + 2]
            if r1 == 10:
                if r2 != 10 and r2 + r3 > 10:
                    raise ValueError("two bonus rolls after a strike cannot exceed 10 pins unless first is strike")
            elif r1 + r2 == 10:
                pass
            else:
                raise IndexError("cannot throw bonus with an open tenth frame")

    def _tenth_done(self):
        tenth_start = 0
        for f in range(9):
            if self.rolls[tenth_start] == 10:
                tenth_start += 1
            else:
                tenth_start += 2
        if len(self.rolls) < tenth_start + 1:
            return False
        r1 = self.rolls[tenth_start]
        if r1 == 10:
            return len(self.rolls) >= tenth_start + 3
        if len(self.rolls) >= tenth_start + 2:
            if r1 + self.rolls[tenth_start + 1] == 10:
                return len(self.rolls) >= tenth_start + 3
            return True
        return False

    def score(self):
        if not self._tenth_done():
            raise ValueError("game is not complete, cannot score")

        total = 0
        idx = 0
        for frame in range(10):
            if frame < 9:
                if self.rolls[idx] == 10:  # strike
                    total += 10 + self.rolls[idx + 1] + self.rolls[idx + 2]
                    idx += 1
                elif self.rolls[idx] + self.rolls[idx + 1] == 10:  # spare
                    total += 10 + self.rolls[idx + 2]
                    idx += 2
                else:  # open
                    total += self.rolls[idx] + self.rolls[idx + 1]
                    idx += 2
            else:  # tenth frame
                total += sum(self.rolls[idx:])
        return total
