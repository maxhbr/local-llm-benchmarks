    pets = ['dog', 'snail', 'fox', 'horse', 'zebra']
    drinks = ['coffee', 'tea', 'milk', 'orange juice', 'water']
    hobbies = ['dancing', 'painter', 'reading', 'football', 'chess']

    # Generate all possible assignments for each attribute category
    for color_combo in permutations(colors):
        # Statement 6: green house immediately right of ivory house
        if color_combo.index('green') != color_combo.index('ivory') + 1:
            continue
        # Statement 10: Norwegian in first house
        for nat_combo in permutations(nationalities):
            if nat_combo[0] != 'Norwegian':
                continue
            # Statement 15: Norwegian next to blue house
            if not (color_combo[1] == 'blue' if len(color_combo) > 1 else False):
                # blue must be at index 1 because Norwegian at 0
                continue
            for pet_combo in permutations(pets):
                for drink_combo in permutations(drinks):
                    # Statement 9: middle house drinks milk
                    if drink_combo[2] != 'milk':
                        continue
                    # Statement 4: green house drinks coffee
                    if drink_combo[color_combo.index('green')] != 'coffee':
                        continue
                    # Statement 5: Ukrainian drinks tea
                    if drink_combo[nat_combo.index('Ukrainian')] != 'tea':
                        continue
                    for hobby_combo in permutations(hobbies):
                        # Statement 2: Englishman in red house
                        if color_combo[nat_combo.index('English')] != 'red':
                            continue
                        # Statement 3: Spaniard owns dog
                        if pet_combo[nat_combo.index('Spanish')] != 'dog':
                            continue
                        # Statement 7: snail owner likes dancing
                        if hobby_combo[pet_combo.index('snail')] != 'dancing':
                            continue
                        # Statement 8: yellow house is painter
                        if hobby_combo[color_combo.index('yellow')] != 'painter':
                            continue
                        # Statement 13: football player drinks orange juice
                        if drink_combo[hobby_combo.index('football')] != 'orange juice':
                            continue
                        # Statement 14: Japanese plays chess
                        if hobby_combo[nat_combo.index('Japanese')] != 'chess':
                            continue
                        # Statement 11: reading next to fox
                        reading_idx = hobby_combo.index('reading')
                        fox_idx = pet_combo.index('fox')
                        if abs(reading_idx - fox_idx) != 1:
                            continue
                        # Statement 12: painter next to horse
                        painter_idx = hobby_combo.index('painter')
                        horse_idx = pet_combo.index('horse')
                        if abs(painter_idx - horse_idx) != 1:
                            continue

                        # All constraints satisfied; build house list
                        houses = []
                        for i in range(5):
                            houses.append({
