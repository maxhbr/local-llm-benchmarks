fn add_strings(a: &str, b: &str) -> String {

    let mut result = String::new();

    let mut carry = 0;

    let a: Vec<u8> = a.bytes().rev().collect();

    let b: Vec<u8> = b.bytes().rev().collect();

    let len = a.len().max(b.len());

    for i in 0..len {

        let da = if i < a.len() { a[i] - b'0' } else { 0 };

        let db = if i < b.len() { b[i] - b'0' } else { 0 };

        let sum = da + db + carry;

        carry = sum / 10;

        result.push((sum % 10 + b'0') as char);

    }

    if carry > 0 { result.push(carry as char); }

    result.chars().rev().collect()

}



fn sub_strings(a: &str, b: &str) -> String {

    let mut result = String::new();

    let mut borrow = 0;

    let a: Vec<u8> = a.bytes().rev().collect();

    let b: Vec<u8> = b.bytes().rev().collect();

    let len = a.len().max(b.len());

    for i in 0..len {

        let da = if i < a.len() { a[i] - b'0' } else { 0 };

        let db = if i < b.len() { b[i] - b'0' } else { 0 };

        let mut diff = da as i32 - db as i32 - borrow;

        if diff < 0 { diff += 10; borrow = 1; } else { borrow = 0; }

        result.push((diff as u8 + b'0') as char);

    }

    result.chars().rev().collect()

}



fn mul_strings(a: &str, b: &str) -> String {

    if a == "0" || b == "0" { return "0".to_string(); }

    let a: Vec<u8> = a.bytes().rev().collect();

    let b: Vec<u8> = b.bytes().rev().collect();

    let mut res = vec![0u8; a.len() + b.len()];

    for (i, &x) in a.iter().enumerate() {

        let mut carry = 0;

        for (j, &y) in b.iter().enumerate() {

            let prod = (x - b'0') as u32 * (y - b'0') as u32 + res[i+j] as u32 + carry;

            res[i+j] = (prod % 10) as u8;

            carry = prod / 10;

        }

        if carry > 0 { res[i + b.len()] += carry as u8; }

    }

    res.iter().rev().map(|&d| (d + b'0') as char).collect()

}

