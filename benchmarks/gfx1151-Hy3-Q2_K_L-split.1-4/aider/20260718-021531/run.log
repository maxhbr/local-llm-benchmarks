```
package variablelengthquantity

import (
	"errors"
)

func EncodeVarint(input []uint32) []byte {
	var output []byte
	for _, value := range input {
		// Break 32-bit value into 7-bit groups
		bytes := make([]byte, 0)
		v := value
		for {
			bytes = append(bytes, byte(v&0x7F))
			v >>= 7
			if v == 0 {
				break
			}
		}
		// Set continuation bit (bit 7) on all bytes except the last
		for i := 0; i < len(bytes)-1; i++ {
			bytes[i] |= 0x80
		}
		// Append in reverse order (most significant group first)
		for i := len(bytes) - 1; i >= 0; i-- {
			output = append(output, bytes[i])
		}
	}
	return output
}

func DecodeVarint(input []byte) ([]uint32, error) {
	var result []uint32
	var current uint32
	var shift uint
	for _, b := range input {
		current |= uint32(b&0x7F) << shift
		shift += 7
		if b&0x80 == 0 {
			// Last byte of this varint
			result = append(result, current)
			current = 0
			shift = 0
		}
	}
	if shift != 0 {
		// Incomplete sequence (missing terminating byte)
		return nil, errors.New("incomplete variable-length quantity")
	}
	return result, nil
}
```
