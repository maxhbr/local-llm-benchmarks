use std::collections::HashMap;

pub fn lowest_price(books: &[u32]) -> u32 {
    let mut counts = [0u32; 5];
    for &b in books {
        if b >= 1 && b <= 5 {
            counts[(b - 1) as usize] += 1;
        }
    }

    // sort counts descending for canonical state
    counts.sort_by(|a, b| b.cmp(a));

    fn group_price(size: u32) -> u32 {
        match size {
            1 => 800,
            2 => 1520,
            3 => 2160,
            4 => 2560,
            5 => 3000,
            _ => 0,
        }
    }

    fn calc(state: [u32; 5], memo: &mut HashMap<[u32; 5], u32>) -> u32 {
        if state.iter().all(|&c| c == 0) {
            return 0;
        }
        if let Some(&cached) = memo.get(&state) {
            return cached;
        }

        let mut min_cost = u32::MAX;

        // iterate over all non-empty subsets of the 5 books
        for mask in 1..=31 {
            let mut subset_size = 0;
            let mut new_state = state;
            let mut valid = true;
            for i in 0..5 {
                if (mask & (1 << i)) != 0 {
                    if new_state[i] == 0 {
                        valid = false;
                        break;
                    }
                    new_state[i] -= 1;
                    subset_size += 1;
                }
            }
            if !valid {
                continue;
            }
            // sort descending for canonicalization
            new_state.sort_by(|a, b| b.cmp(a));
            let cost = group_price(subset_size) + calc(new_state, memo);
            if cost < min_cost {
                min_cost = cost;
            }
        }

        memo.insert(state, min_cost);
        min_cost
    }

    let mut memo = HashMap::new();
    calc(counts, &mut memo)
}
```

