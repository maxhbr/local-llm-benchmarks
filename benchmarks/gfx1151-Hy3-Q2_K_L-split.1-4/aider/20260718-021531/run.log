```
use std::collections::{VecDeque, HashSet};

#[derive(PartialEq, Eq, Debug)]
pub enum Bucket {
    One,
    Two,
}

/// A struct to hold your results in.
#[derive(PartialEq, Eq, Debug)]
pub struct BucketStats {
    /// The total number of "moves" it should take to reach the desired number of liters, including
    /// the first fill.
    pub moves: u8,
    /// Which bucket should end up with the desired number of liters? (Either "one" or "two")
    pub goal_bucket: Bucket,
    /// How many liters are left in the other bucket?
    pub other_bucket: u8,
}

/// Solve the bucket problem
pub fn solve(
    capacity_1: u8,
    capacity_2: u8,
    goal: u8,
    start_bucket: &Bucket,
) -> Option<BucketStats> {
    let start = match start_bucket {
        Bucket::One => (capacity_1, 0),
        Bucket::Two => (0, capacity_2),
    };

    let mut queue = VecDeque::new();
    queue.push_back((start.0, start.1, 1));

    let mut visited = HashSet::new();
    visited.insert(start);

    while let Some((b1, b2, moves)) = queue.pop_front() {
        // Check if goal reached
        if b1 == goal {
            return Some(BucketStats {
                moves,
                goal_bucket: Bucket::One,
                other_bucket: b2,
            });
        }
        if b2 == goal {
            return Some(BucketStats {
                moves,
                goal_bucket: Bucket::Two,
                other_bucket: b1,
            });
        }

        // Generate next states
        let next_states = vec![
            // Fill bucket one
            (capacity_1, b2),
            // Fill bucket two
            (b1, capacity_2),
            // Empty bucket one
            (0, b2),
            // Empty bucket two
            (b1, 0),
            // Pour one into two
            {
                let transfer = b1.min(capacity_2 - b2);
                (b1 - transfer, b2 + transfer)
            },
            // Pour two into one
            {
                let transfer = b2.min(capacity_1 - b1);
                (b1 + transfer, b2 - transfer)
            },
        ];

        for (nb1, nb2) in next_states {
            // Rule: cannot end in state where starting bucket is empty and other is full
            let invalid = match start_bucket {
                Bucket::One => nb1 == 0 && nb2 == capacity_2,
                Bucket::Two => nb2 == 0 && nb1 == capacity_1,
            };
            if invalid {
                continue;
            }
            if visited.insert((nb1, nb2)) {
                queue.push_back((nb1, nb2, moves + 1));
            }
        }
    }

    None
}
```

