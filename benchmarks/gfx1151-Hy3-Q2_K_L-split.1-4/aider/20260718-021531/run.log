package bottlesong

import "fmt"

var capWords = map[int]string{
	1:  "One",
	2:  "Two",
	3:  "Three",
	4:  "Four",
	5:  "Five",
	6:  "Six",
	7:  "Seven",
	8:  "Eight",
	9:  "Nine",
	10: "Ten",
}

var lowWords = map[int]string{
	0:  "no",
	1:  "one",
	2:  "two",
	3:  "three",
	4:  "four",
	5:  "five",
	6:  "six",
	7:  "seven",
	8:  "eight",
	9:  "nine",
	10: "ten",
}

func Recite(startBottles, takeDown int) []string {
	var lyrics []string
	for i := 0; i < takeDown; i++ {
		current := startBottles - i
		next := current - 1

		currentBottles := capWords[current] + " green bottle"
		if current != 1 {
			currentBottles += "s"
		}
		currentLine := currentBottles + " hanging on the wall,"

		nextBottles := lowWords[next] + " green bottle"
		if next != 1 {
			nextBottles += "s"
		}
		nextLine := fmt.Sprintf("There'll be %s hanging on the wall.", nextBottles)

		verse := []string{
			currentLine,
			currentLine,
			"And if one green bottle should accidentally fall,",
			nextLine,
		}
		lyrics = append(lyrics, verse...)
		if i != takeDown-1 {
			lyrics = append(lyrics, "")
		}
	}
	return lyrics
}
