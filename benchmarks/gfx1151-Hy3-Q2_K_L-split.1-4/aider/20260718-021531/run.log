import java.util.List;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.Stack;

class ForthEvaluator {
    private HashMap<String, List<String>> userWords = new HashMap<>();

    List<Integer> evaluateProgram(List<String> input) {
        Stack<Integer> stack = new Stack<>();
        List<String> tokens = new ArrayList<>();

        for (String line : input) {
            String[] parts = line.trim().split("\\s+");
            for (String p : parts) {
                if (!p.isEmpty()) {
                    tokens.add(p.toLowerCase());
                }
            }
        }

        List<String> currentDefinition = null;
        String definingWord = null;

        for (String token : tokens) {
            if (currentDefinition != null) {
                if (token.equals(";")) {
                    userWords.put(definingWord, new ArrayList<>(currentDefinition));
                    currentDefinition = null;
                    definingWord = null;
                } else {
                    currentDefinition.add(token);
                }
                continue;
            }

            if (token.equals(":")) {
                currentDefinition = new ArrayList<>();
                // next token is word name
                continue;
            }

            if (userWords.containsKey(token)) {
                // expand user word
                for (String t : userWords.get(token)) {
                    handleToken(t, stack);
                }
                continue;
            }

            handleToken(token, stack);
        }

        return new ArrayList<>(stack);
    }

    private void handleToken(String token, Stack<Integer> stack) {
        if (token.matches("-?\\d+")) {
            stack.push(Integer.parseInt(token));
            return;
        }

        switch (token) {
            case "+":
                checkStack(stack, 2);
                int b = stack.pop();
                int a = stack.pop();
                stack.push(a + b);
                break;
            case "-":
                checkStack(stack, 2);
                b = stack.pop();
                a = stack.pop();
                stack.push(a - b);
                break;
            case "*":
                checkStack(stack, 2);
                b = stack.pop();
                a = stack.pop();
                stack.push(a * b);
                break;
            case "/":
                checkStack(stack, 2);
                b = stack.pop();
                a = stack.pop();
                if (b == 0) throw new ArithmeticException("Division by zero");
                stack.push(a / b);
                break;
            case "dup":
                checkStack(stack, 1);
                stack.push(stack.peek());
                break;
            case "drop":
                checkStack(stack, 1);
                stack.pop();
                break;
            case "swap":
                checkStack(stack, 2);
                b = stack.pop();
                a = stack.pop();
                stack.push(b);
                stack.push(a);
                break;
            case "over":
                checkStack(stack, 2);
                a = stack.get(stack.size() - 2);
                stack.push(a);
                break;
            default:
                throw new UnsupportedOperationException("Unknown word: " + token);
        }
    }

    private void checkStack(Stack<Integer> stack, int needed) {
        if (stack.size() < needed) {
            throw new IllegalStateException("Stack underflow");
        }
    }
}
