            "3" => 3,
            "4" => 4,
            "5" => 5,
            "6" => 6,
            "7" => 7,
            "8" => 8,
            "9" => 9,
            "10" => 10,
            "J" => 11,
            "Q" => 12,
            "K" => 13,
            "A" => 14,
            _ => 0,
        };
        ranks.push(rank);
        suits.push(suit_str.chars().next().unwrap());
    }

    ranks.sort_unstable_by(|a, b| b.cmp(a)); // descending

    let is_flush = suits.iter().all(|&s| s == suits[0]);

    let mut rank_counts: [u8; 15] = [0; 15];
    for &r in &ranks {
        rank_counts[r as usize] += 1;
    }

    let mut sorted_counts: Vec<(u8, u8)> = rank_counts
        .iter()
        .enumerate()
        .filter(|(_, &c)| c > 0)
        .map(|(r, &c)| (c, r as u8))
        .collect();
    sorted_counts.sort_unstable_by(|a, b| b.cmp(a)); // by count desc, then rank desc

    // Safely extract counts (assume at least 1 entry; poker hand has 5 cards)
    let count0 = sorted_counts.get(0).map(|x| x.0).unwrap_or(0);
    let rank0 = sorted_counts.get(0).map(|x| x.1).unwrap_or(0);
    let count1 = sorted_counts.get(1).map(|x| x.0).unwrap_or(0);
    let rank1 = sorted_counts.get(1).map(|x| x.1).unwrap_or(0);
    let rank2 = sorted_counts.get(2).map(|x| x.1).unwrap_or(0);

    let is_straight = (ranks[0] - ranks[4] == 4) && (count0 == 1);
    let is_low_straight = ranks == [14, 5, 4, 3, 2];

    let category: u8 = if is_flush && (is_straight || is_low_straight) {
