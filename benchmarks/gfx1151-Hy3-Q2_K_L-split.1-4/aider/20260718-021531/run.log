package cryptosquare

import (
	"math"
	"strings"
	"unicode"
)

func Encode(pt string) string {
	// Normalize: keep only letters and digits, down-case
	var norm []rune
	for _, r := range pt {
		if unicode.IsLetter(r) || unicode.IsDigit(r) {
			norm = append(norm, unicode.ToLower(r))
		}
	}
	length := len(norm)
	if length == 0 {
		return ""
	}

	// Determine smallest c such that r = ceil(length/c), c >= r, c - r <= 1
	c := int(math.Ceil(math.Sqrt(float64(length))))
	r := (length + c - 1) / c
	for !(c >= r && c-r <= 1) {
		c++
		r = (length + c - 1) / c
	}

	// Read down columns to build encoded string
	var sb strings.Builder
	for col := 0; col < c; col++ {
		for row := 0; row < r; row++ {
			idx := row*c + col
			if idx < length {
				sb.WriteRune(norm[idx])
			}
		}
	}
	encoded := sb.String()

	// Form chunks of length r, pad short chunks with a single trailing space
	chunks := make([]string, c)
	for col := 0; col < c; col++ {
		start := col * r
		end := start + r
		if end > len(encoded) {
			end = len(encoded)
		}
		chunk := encoded[start:end]
		if len(chunk) < r {
			chunk += strings.Repeat(" ", r-len(chunk))
		}
		chunks[col] = chunk
	}

	return strings.Join(chunks, " ")
}
