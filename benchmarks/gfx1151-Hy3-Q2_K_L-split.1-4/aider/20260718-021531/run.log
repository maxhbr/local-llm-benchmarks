import java.util.List;
import java.util.ArrayList;
import java.util.Objects;
import java.util.function.Consumer;
import java.util.function.Function;

public class React {

    public static class Cell<T> {
        protected T value;
        protected List<ComputeCell<T>> dependents = new ArrayList<>();

        public T getValue() {
            return value;
        }

        void addDependent(ComputeCell<T> cell) {
            dependents.add(cell);
        }
    }

    public static class InputCell<T> extends Cell<T> {
        public InputCell(T initialValue) {
            this.value = initialValue;
        }

        public void setValue(T newValue) {
            if (Objects.equals(newValue, value)) {
                return;
            }
            this.value = newValue;
            // Collect all compute cells that need updating (simple BFS/DFS)
            List<ComputeCell<T>> toUpdate = new ArrayList<>();
            collectDependents(this, toUpdate);
            // Update values to new stable state
            for (ComputeCell<T> dep : toUpdate) {
                dep.recompute();
            }
            // After stable state, fire callbacks for those that changed
            for (ComputeCell<T> dep : toUpdate) {
                dep.fireIfChanged();
            }
        }

        private void collectDependents(Cell<T> cell, List<ComputeCell<T>> acc) {
            for (ComputeCell<T> dep : cell.dependents) {
                if (!acc.contains(dep)) {
                    acc.add(dep);
                    collectDependents(dep, acc);
                }
            }
        }
    }

    public static class ComputeCell<T> extends Cell<T> {
        private Function<List<T>, T> function;
        private List<Cell<T>> cells;
        private List<Consumer<T>> callbacks = new ArrayList<>();
        private T previousValue;

        public ComputeCell(Function<List<T>, T> function, List<Cell<T>> cells) {
            this.function = function;
            this.cells = new ArrayList<>(cells);
            for (Cell<T> c : cells) {
                c.addDependent(this);
            }
            this.value = function.apply(getInputValues());
            this.previousValue = value;
        }

        private List<T> getInputValues() {
            List<T> values = new ArrayList<>();
            for (Cell<T> c : cells) {
                values.add(c.getValue());
            }
            return values;
        }

        void recompute() {
            T newValue = function.apply(getInputValues());
            this.value = newValue;
        }

        void fireIfChanged() {
            if (!Objects.equals(value, previousValue)) {
                for (Consumer<T> cb : callbacks) {
                    cb.accept(value);
                }
                previousValue = value;
            }
        }

        public void addCallback(Consumer<T> callback) {
            callbacks.add(callback);
        }

        public void removeCallback(Consumer<T> callback) {
            callbacks.remove(callback);
        }
    }

    public static <T> InputCell<T> inputCell(T initialValue) {
        return new InputCell<>(initialValue);
    }

    public static <T> ComputeCell<T> computeCell(Function<List<T>, T> function, List<Cell<T>> cells) {
        return new ComputeCell<>(function, cells);
    }
}
