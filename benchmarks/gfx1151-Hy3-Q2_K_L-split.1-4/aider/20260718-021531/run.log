```
import java.util.ArrayList;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;

public class SgfParsing {
    public static class SgfParsingException extends Exception {
        public SgfParsingException(String message) {
            super(message);
        }
    }

    public static class SgfNode {
        private final Map<String, List<String>> properties = new LinkedHashMap<>();
        private final List<SgfNode> children = new ArrayList<>();

        public Map<String, List<String>> getProperties() {
            return properties;
        }

        public List<SgfNode> getChildren() {
            return children;
        }

        public void addProperty(String key, String value) {
            properties.computeIfAbsent(key, k -> new ArrayList<>()).add(value);
        }

        public void addChild(SgfNode child) {
            children.add(child);
        }
    }

    public SgfNode parse(String input) throws SgfParsingException {
        Parser parser = new Parser(input);
        return parser.parse();
    }

    private static class Parser {
        private final String text;
        private int pos;

        Parser(String text) {
            this.text = text;
            this.pos = 0;
        }

        SgfNode parse() throws SgfParsingException {
            skipWhitespace();
            if (pos >= text.length() || text.charAt(pos) != '(') {
                throw new SgfParsingException("Expected '(' at start of SGF tree");
            }
            return parseTree();
        }

        private SgfNode parseTree() throws SgfParsingException {
            if (text.charAt(pos) != '(') {
                throw new SgfParsingException("Expected '('");
            }
            pos++; // consume '('
            SgfNode node = parseSequence();
            if (text.charAt(pos) != ')') {
                throw new SgfParsingException("Expected ')'");
            }
            pos++; // consume ')'
            skipWhitespace();
            return node;
        }

        private SgfNode parseSequence() throws SgfParsingException {
            SgfNode root = null;
            SgfNode current = null;
            while (pos < text.length() && (text.charAt(pos) == ';' || text.charAt(pos) == '(')) {
                if (text.charAt(pos) == ';') {
                    SgfNode newNode = parseNode();
                    if (root == null) {
                        root = newNode;
                        current = newNode;
                    } else {
                        current.addChild(newNode);
                        current = newNode;
                    }
                } else if (text.charAt(pos) == '(') {
                    // variation: parseTree returns a node that is the root of that variation's sequence
                    SgfNode variationRoot = parseTree();
                    if (root == null) {
                        root = variationRoot;
                        current = variationRoot;
                    } else {
                        current.addChild(variationRoot);
                        // The variation root is the start of a new branch; we don't change `current`
                        // because subsequent nodes at this level should be siblings of the variation,
                        // not children of the variation root.
                        // Actually, in SGF, a '(' starts a variation which is a child of the preceding node.
                        // So we already added variationRoot as child of current.
                        // The sequence inside '(' is parsed by parseTree which calls parseSequence.
                        // After parseTree, we continue the loop; if there is another ';' it belongs to the original sequence.
                    }
                }
            }
            if (root == null) {
                throw new SgfParsingException("Empty sequence");
            }
            return root;
        }

        private SgfNode parseNode() throws SgfParsingException {
            if (text.charAt(pos) != ';') {
                throw new SgfParsingException("Expected ';'");
            }
            pos++; // consume ';'
            SgfNode node = new SgfNode();
            while (pos < text.length()) {
                char c = text.charAt(pos);
                if (c == '(' || c == ')' || c == ';') {
                    break;
                }
                if (Character.isUpperCase(c)) {
                    String key = parseKey();
                    while (pos < text.length() && text.charAt(pos) == '[') {
                        String value = parseValue();
                        node.addProperty(key, value);
                    }
                } else {
                    // skip whitespace between properties
                    if (Character.isWhitespace(c)) {
                        pos++;
                    } else {
                        throw new SgfParsingException("Unexpected character in node: " + c);
                    }
                }
            }
            return node;
        }

        private String parseKey() throws SgfParsingException {
            StringBuilder key = new StringBuilder();
            while (pos < text.length() && Character.isUpperCase(text.charAt(pos))) {
                key.append(text.charAt(pos));
                pos++;
            }
            if (key.length() == 0) {
                throw new SgfParsingException("Empty property key");
            }
            return key.toString();
        }

        private String parseValue() throws SgfParsingException {
            if (text.charAt(pos) != '[') {
                throw new SgfParsingException("Expected '['");
            }
            pos++; // consume '['
            StringBuilder sb = new StringBuilder();
            while (pos < text.length()) {
                char c = text.charAt(pos);
                if (c == '\\') {
                    pos++;
                    if (pos >= text.length()) {
                        throw new SgfParsingException("Unterminated escape in value");
                    }
                    char escaped = text.charAt(pos);
                    if (escaped == '\n') {
                        // newline immediately after backslash is removed
                        pos++;
                        continue;
                    } else if (Character.isWhitespace(escaped)) {
                        // other whitespace after backslash becomes space
                        sb.append(' ');
                        pos++;
                    } else {
                        // non-whitespace inserted as-is
                        sb.append(escaped);
                        pos++;
                    }
                } else if (c == ']') {
                    pos++; // consume ']'
                    return sb.toString();
                } else if (c == '\n') {
                    // newline not after backslash remains as newline
                    sb.append(c);
                    pos++;
                } else if (Character.isWhitespace(c)) {
                    // other whitespace becomes space
                    sb.append(' ');
                    pos++;
                } else {
                    sb.append(c);
                    pos++;
                }
            }
            throw new SgfParsingException("Unterminated property value");
        }

        private void skipWhitespace() {
            while (pos < text.length() && Character.isWhitespace(text.charAt(pos))) {
                pos++;
            }
        }
    }
}
