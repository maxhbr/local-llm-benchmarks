//
// This is only a SKELETON file for the 'List Ops' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export class List {
  constructor(values = []) {
    this.values = values;
  }

  append(other) {
    let result = [];
    let i = 0;
    while (i < this.values.length) {
      result[result.length] = this.values[i];
      i = i + 1;
    }
    i = 0;
    while (i < other.values.length) {
      result[result.length] = other.values[i];
      i = i + 1;
    }
    return new List(result);
  }

  concat(lists) {
    let result = [];
    let i = 0;
    while (i < this.values.length) {
      result[result.length] = this.values[i];
      i = i + 1;
    }
    i = 0;
    while (i < lists.length) {
      let list = lists[i];
      let j = 0;
      while (j < list.values.length) {
        result[result.length] = list.values[j];
        j = j + 1;
      }
      i = i + 1;
    }
    return new List(result);
  }

  filter(predicate) {
    let result = [];
    let i = 0;
    while (i < this.values.length) {
      if (predicate(this.values[i])) {
        result[result.length] = this.values[i];
      }
      i = i + 1;
    }
    return new List(result);
  }

  map(fn) {
    let result = [];
    let i = 0;
    while (i < this.values.length) {
      result[result.length] = fn(this.values[i]);
      i = i + 1;
    }
    return new List(result);
  }

  length() {
    let count = 0;
    let i = 0;
    while (i < this.values.length) {
      count = count + 1;
      i = i + 1;
    }
    return count;
  }

  foldl(fn, accumulator) {
    let i = 0;
    while (i < this.values.length) {
      accumulator = fn(accumulator, this.values[i]);
      i = i + 1;
    }
    return accumulator;
  }

  foldr(fn, accumulator) {
    let i = this.values.length - 1;
    while (i >= 0) {
      accumulator = fn(this.values[i], accumulator);
      i = i - 1;
    }
    return accumulator;
  }

  reverse() {
    let result = [];
    let i = this.values.length - 1;
    while (i >= 0) {
      result[result.length] = this.values[i];
      i = i - 1;
    }
    return new List(result);
  }
}
```
