class BowlingGame:
    def __init__(self):
        self.rolls = []          # rolls for frames 1-9
        self.tenth = []          # rolls for frame 10 (including fills)
        self.frame = 1

    def roll(self, pins):
        if not (0 <= pins <= 10):
            raise ValueError("pins must be between 0 and 10")
        if self.frame > 10:
            raise IndexError("cannot roll after game is over")

        if self.frame < 10:
            self.rolls.append(pins)
            # frame completion
            if len(self.rolls) % 2 == 1 and pins == 10:
                self.frame += 1
            elif len(self.rolls) % 2 == 0:
                if self.rolls[-2] + pins > 10:
                    raise ValueError("two rolls in a frame cannot exceed 10 pins")
                self.frame += 1
        else:
            # tenth frame
            if len(self.tenth) == 0:
                self.tenth.append(pins)
            elif len(self.tenth) == 1:
                self.tenth.append(pins)
                if self.tenth[0] != 10 and self.tenth[0] + self.tenth[1] > 10:
                    raise ValueError("two rolls in tenth frame cannot exceed 10 pins")
                if self.tenth[0] != 10 and self.tenth[0] + self.tenth[1] < 10:
                    # open tenth, game ends after two rolls
                    self.frame += 1
            elif len(self.tenth) == 2:
                if self.tenth[0] == 10 or sum(self.tenth[:2]) == 10:
                    self.tenth.append(pins)
                    self.frame += 1
                else:
                    raise IndexError("cannot throw bonus with an open tenth frame")
            else:
                raise ValueError("invalid fill balls")

    def score(self):
        # determine if tenth is complete
        if self.frame < 10:
            raise ValueError("game is not complete, cannot score")
        if len(self.tenth) == 2 and (self.tenth[0] == 10 or sum(self.tenth) == 10):
            raise ValueError("game is not complete, cannot score")
        if len(self.tenth) < 2:
            raise ValueError("game is not complete, cannot score")

        total = 0
        idx = 0
        for _ in range(9):
            if self.rolls[idx] == 10:  # strike
                total += 10 + self.rolls[idx + 1] + self.rolls[idx + 2]
                idx += 1
            elif self.rolls[idx] + self.rolls[idx + 1] == 10:  # spare
                total += 10 + self.rolls[idx + 2]
                idx += 2
            else:  # open
                total += self.rolls[idx] + self.rolls[idx + 1]
                idx += 2
        total += sum(self.tenth)
        return total
```

