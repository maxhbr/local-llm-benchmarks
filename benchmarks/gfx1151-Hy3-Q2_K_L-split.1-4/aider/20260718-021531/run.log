pig_latin.go
```
package piglatin

import (
	"strings"
)

func isVowel(b byte) bool {
	switch b {
	case 'a', 'e', 'i', 'o', 'u':
		return true
	}
	return false
}

func translateWord(word string) string {
	if len(word) == 0 {
		return word
	}

	// Rule 1: begins with vowel, or "xr" or "yt"
	if isVowel(word[0]) || strings.HasPrefix(word, "xr") || strings.HasPrefix(word, "yt") {
		return word + "ay"
	}

	// Rule 3: zero or more consonants followed by "qu"
	quIndex := strings.Index(word, "qu")
	if quIndex != -1 {
		// all characters before "qu" must be consonants (or none)
		allConsonants := true
		for i := 0; i < quIndex; i++ {
			if isVowel(word[i]) {
				allConsonants = false
				break
			}
		}
		if allConsonants {
			return word[quIndex+2:] + word[:quIndex+2] + "ay"
		}
	}

	// Rule 4: one or more consonants followed by 'y'
	yIndex := strings.Index(word, "y")
	if yIndex > 0 {
		allConsonants := true
		for i := 0; i < yIndex; i++ {
			if isVowel(word[i]) {
				allConsonants = false
				break
			}
		}
		if allConsonants {
			return word[yIndex:] + word[:yIndex] + "ay"
		}
	}

	// Rule 2: one or more consonants at beginning
	consEnd := 0
	for consEnd < len(word) && !isVowel(word[consEnd]) {
		consEnd++
	}
	return word[consEnd:] + word[:consEnd] + "ay"
}

func Sentence(sentence string) string {
	words := strings.Fields(sentence)
	for i, w := range words {
		words[i] = translateWord(w)
	}
	return strings.Join(words, " ")
}
```
