#endif // KNAPSACK_H
```

knapsack.cpp
```
#include "knapsack.h"
#include <algorithm>
#include <vector>

namespace knapsack
{

int maximum_value(int capacity, const std::vector<Item>& items)
{
    // dp[w] = max value achievable with capacity w using processed items
    std::vector<int> dp(capacity + 1, 0);
    for (const auto& item : items) {
        // traverse backwards to ensure each item used at most once
        for (int w = capacity; w >= item.weight; --w) {
            dp[w] = std::max(dp[w], dp[w - item.weight] + item.value);
        }
    }
    return dp[capacity];
}

} // namespace knapsack
```
