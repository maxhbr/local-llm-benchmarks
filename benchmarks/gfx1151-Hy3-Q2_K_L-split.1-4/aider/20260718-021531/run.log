package erratum

func Use(opener ResourceOpener, input string) error {
	var res Resource
	var err error

	for {
		res, err = opener()
		if err != nil {
			if _, ok := err.(TransientError); ok {
				continue
			}
			return err
		}
		break
	}

	defer res.Close()

	var frobErr error
	func() {
		defer func() {
			if r := recover(); r != nil {
				if fe, ok := r.(FrobError); ok {
					res.Defrob(fe.defrobTag)
					frobErr = fe
				} else {
					frobErr = r.(error)
				}
			}
		}()
		res.Frob(input)
	}()

	if frobErr != nil {
		return frobErr
	}
	return nil
}
```

