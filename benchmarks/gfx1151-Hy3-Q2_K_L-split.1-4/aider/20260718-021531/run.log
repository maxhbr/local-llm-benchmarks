//
// This is only a SKELETON file for the 'Go Counting' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export class GoCounting {
  constructor(board) {
    this.board = board;
    this.rows = board.length;
    this.cols = board[0] ? board[0].length : 0;
  }

  _inBounds(x, y) {
    return x >= 0 && x < this.cols && y >= 0 && y < this.rows;
  }

  _findRegion(x, y) {
    // returns { owner, territory } for the empty region containing (x, y)
    if (!this._inBounds(x, y) || this.board[y][x] !== ' ') {
      return { owner: 'NONE', territory: [] };
    }

    const visited = new Set();
    const key = (cx, cy) => `${cx},${cy}`;
    const queue = [[x, y]];
    visited.add(key(x, y));
    const territory = [];
    let owner = 'NONE';
    const neighbors = [[1, 0], [-1, 0], [0, 1], [0, -1]];

    while (queue.length) {
      const [cx, cy] = queue.shift();
      territory.push([cx, cy]);

      for (const [dx, dy] of neighbors) {
        const nx = cx + dx;
        const ny = cy + dy;
        if (this._inBounds(nx, ny) && !visited.has(key(nx, ny))) {
          const cell = this.board[ny][nx];
          if (cell === ' ') {
            visited.add(key(nx, ny));
            queue.push([nx, ny]);
          } else {
            // border stone
            if (cell === 'B') {
              if (owner === 'NONE') owner = 'BLACK';
              else if (owner === 'WHITE') owner = 'NONE';
            } else if (cell === 'W') {
              if (owner === 'NONE') owner = 'WHITE';
              else if (owner === 'BLACK') owner = 'NONE';
            }
          }
        }
      }
    }

    // sort territory by y then x for deterministic output
    territory.sort((a, b) => (a[1] - b[1]) || (a[0] - b[0]));

    return { owner, territory };
  }

  getTerritory(x, y) {
    const { owner, territory } = this._findRegion(x, y);
    return { owner, territory };
  }

  getTerritories() {
    const territoryBlack = [];
    const territoryWhite = [];
    const territoryNone = [];
    const visited = new Set();
    const key = (cx, cy) => `${cx},${cy}`;

    for (let y = 0; y < this.rows; y++) {
      for (let x = 0; x < this.cols; x++) {
        if (this.board[y][x] === ' ' && !visited.has(key(x, y))) {
          const { owner, territory } = this._findRegion(x, y);
          for (const [tx, ty] of territory) visited.add(key(tx, ty));
          if (owner === 'BLACK') territoryBlack.push(...territory);
          else if (owner === 'WHITE') territoryWhite.push(...territory);
          else territoryNone.push(...territory);
        }
      }
    }

    return {
      territoryBlack,
      territoryWhite,
      territoryNone,
    };
  }
}
```

