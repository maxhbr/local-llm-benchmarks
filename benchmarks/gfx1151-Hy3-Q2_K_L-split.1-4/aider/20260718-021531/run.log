```
#include "binary_search_tree.h"

namespace binary_search_tree {

tree::tree() : root_(nullptr) {}

tree::tree(int initial_value) : root_(new node(initial_value)) {}

void tree::insert_node(std::unique_ptr<node>& current, int value) {
    if (!current) {
        current.reset(new node(value));
        return;
    }
    if (value <= current->data) {
        insert_node(current->left, value);
    } else {
        insert_node(current->right, value);
    }
}

void tree::insert(int value) {
    if (!root_) {
        root_.reset(new node(value));
        return;
    }
    insert_node(root_, value);
}

bool tree::contains(int value) const {
    node* current = root_.get();
    while (current) {
        if (value == current->data) {
            return true;
        } else if (value < current->data) {
            current = current->left.get();
        } else {
            current = current->right.get();
        }
    }
    return false;
}

}  // namespace binary_search_tree
