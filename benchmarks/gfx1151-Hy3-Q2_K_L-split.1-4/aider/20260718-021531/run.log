```
package bowling

import (
	"errors"
)

// Game holds the state of a bowling game.
type Game struct {
	rolls       []int // flat list of all rolls (pins per ball)
	currentFrame int  // 1-based, next frame to play (1..10)
	ballInFrame  int  // 1 or 2 (or 3 for 10th frame fill), 1-based
}

// NewGame returns a new bowling game.
func NewGame() *Game {
	return &Game{
		rolls:       make([]int, 0),
		currentFrame: 1,
		ballInFrame:  1,
	}
}

// Roll records a roll of the given number of pins.
func (g *Game) Roll(pins int) error {
	if pins < 0 || pins > 10 {
		return errors.New("invalid pins")
	}
	// Check not already finished
	if g.currentFrame > 10 {
		return errors.New("game already finished")
	}
	// Validate per-frame sum
	if g.currentFrame < 10 {
		if g.ballInFrame == 1 {
			// first ball in frame
			g.rolls = append(g.rolls, pins)
			if pins == 10 {
				// strike, frame complete
				g.currentFrame++
				g.ballInFrame = 1
			} else {
				g.ballInFrame = 2
			}
		} else {
			// second ball in frame
			if g.rolls[len(g.rolls)-1]+pins > 10 {
				return errors.New("invalid frame sum")
			}
			g.rolls = append(g.rolls, pins)
			g.currentFrame++
			g.ballInFrame = 1
		}
	} else {
		// 10th frame
		if g.ballInFrame == 1 {
			g.rolls = append(g.rolls, pins)
			if pins == 10 {
				// strike in 10th, get two fill balls
				g.ballInFrame = 2
			} else {
				g.ballInFrame = 2
			}
		} else if g.ballInFrame == 2 {
			// second ball in 10th
			first := g.rolls[len(g.rolls)-1]
			if first != 10 && first+pins > 10 {
				return errors.New("invalid frame sum")
			}
			g.rolls = append(g.rolls, pins)
			if first == 10 || first+pins == 10 {
				// earned fill ball
				g.ballInFrame = 3
			} else {
				g.currentFrame++
				g.ballInFrame = 1
			}
		} else {
			// third fill ball
			g.rolls = append(g.rolls, pins)
			g.currentFrame++
			g.ballInFrame = 1
		}
	}
	return nil
}

// Score computes the total score of the game.
func (g *Game) Score() (int, error) {
	// Must have at least 10 frames worth of rolls
	if len(g.rolls) < 12 && g.currentFrame <= 10 {
		return 0, errors.New("game not complete")
	}
	total := 0
	rollIndex := 0
	for frame := 1; frame <= 10; frame++ {
		if rollIndex >= len(g.rolls) {
			return 0, errors.New("game not complete")
		}
		first := g.rolls[rollIndex]
		if first == 10 {
			// strike
			if rollIndex+2 >= len(g.rolls) {
				return 0, errors.New("game not complete")
			}
			next1 := g.rolls[rollIndex+1]
			next2 := g.rolls[rollIndex+2]
			total += 10 + next1 + next2
			rollIndex++
		} else {
			if rollIndex+1 >= len(g.rolls) {
				return 0, errors.New("game not complete")
			}
			second := g.rolls[rollIndex+1]
			if first+second > 10 {
				return 0, errors.New("invalid frame")
			}
			if first+second == 10 {
				// spare
				if rollIndex+2 >= len(g.rolls) {
					return 0, errors.New("game not complete")
				}
				next := g.rolls[rollIndex+2]
				total += 10 + next
			} else {
				// open frame
				total += first + second
			}
			rollIndex += 2
		}
	}
	return total, nil
}
```
