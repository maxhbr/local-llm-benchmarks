package protein

import (
	"errors"
	"fmt"
)

func FromRNA(rna string) ([]string, error) {
	if len(rna)%3 != 0 {
		return nil, errors.New("RNA sequence length is not a multiple of 3")
	}
	var proteins []string
	for i := 0; i < len(rna); i += 3 {
		codon := rna[i : i+3]
		protein, err := FromCodon(codon)
		if err != nil {
			return nil, err
		}
		if protein == "STOP" {
			break
		}
		proteins = append(proteins, protein)
	}
	return proteins, nil
}

func FromCodon(codon string) (string, error) {
	switch codon {
	case "AUG":
		return "Methionine", nil
	case "UUU", "UUC":
		return "Phenylalanine", nil
	case "UUA", "UUG":
		return "Leucine", nil
	case "UCU", "UCC", "UCA", "UCG":
		return "Serine", nil
	case "UAU", "UAC":
		return "Tyrosine", nil
	case "UGU", "UGC":
		return "Cysteine", nil
	case "UGG":
		return "Tryptophan", nil
	case "UAA", "UAG", "UGA":
		return "STOP", nil
	default:
		return "", fmt.Errorf("invalid codon: %s", codon)
	}
}
```
