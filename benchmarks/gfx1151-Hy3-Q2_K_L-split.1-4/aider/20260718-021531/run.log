        JSONObject owedBy = new JSONObject();
        for (Iou iou : user.owedBy()) {
            owedBy.put(iou.name(), owedBy.optDouble(iou.name(), 0.0) + iou.amount());
        }
        obj.put("owes", owes);
        obj.put("owed_by", owedBy);
        obj.put("balance", user.balance());
        return obj;
    }
}
