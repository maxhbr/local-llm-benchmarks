    score = 2 * 1000000000 + pairs[0] * 10000000 + pairs[1] * 100000 + Number(kicker) * 1000;
  } else if (counts[0] === 2) {
    const pair = Object.keys(rankCounts).find(r => rankCounts[r] === 2);
    const kickers = Object.keys(rankCounts).filter(r => rankCounts[r] === 1).map(Number).sort((a, b) => b - a);
    score = 1 * 1000000000 + Number(pair) * 10000000 + kickers[0] * 100000 + kickers[1] * 1000 + kickers[2] * 10;
  } else {
    score = 0 * 1000000000 + sortedRanks.reduce((acc, r, i) => acc + r * Math.pow(100, 4 - i), 0);
  }
  return score;
}

const bestHands = (hands) => {
  if (!hands || hands.length === 0) return [];
  const parsed = hands.map(parseHand);
  const scored = parsed.map(h => ({ ...h, score: evaluate(h) }));
  const maxScore = Math.max(...scored.map(s => s.score));
  return scored.filter(s => s.score === maxScore).map(s => s.hand);
};

module.exports = { bestHands };
```

This change replaces the ES module `export` with `module.exports`, which is standard in Node.js and should allow the test runner (once installed or available) to load the module correctly. No other logic is altered.
