```
//
// This is only a SKELETON file for the 'Grade School' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export class GradeSchool {
  constructor() {
    this.students = {}; // grade -> Set of student names
    this.studentGrade = {}; // student name -> grade
  }

  roster() {
    const result = {};
    const grades = Object.keys(this.students)
      .map(Number)
      .sort((a, b) => a - b);
    for (const grade of grades) {
      result[grade] = Array.from(this.students[grade]).sort();
    }
    return result;
  }

  add(name, grade) {
    if (this.studentGrade[name] !== undefined) {
      const oldGrade = this.studentGrade[name];
      if (oldGrade === grade) {
        return; // already in this grade
      }
      this.students[oldGrade].delete(name);
    }
    if (!this.students[grade]) {
      this.students[grade] = new Set();
    }
    this.students[grade].add(name);
    this.studentGrade[name] = grade;
  }

  grade(gradeNumber) {
    if (!this.students[gradeNumber]) {
      return [];
    }
    return Array.from(this.students[gradeNumber]).sort();
  }
}
```
