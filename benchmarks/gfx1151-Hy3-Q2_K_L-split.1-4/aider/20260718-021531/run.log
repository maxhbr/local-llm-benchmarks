+                               b1 = 0
+                       } else {
+                               b1 -= space
+                               b2 = sizeBucketTwo
+                       }
+               } else {
+                       // pour from bucket two to bucket one
+                       space := sizeBucketOne - b1
+                       if b2 <= space {
+                               b1 += b2
+                               b2 = 0
+                       } else {
+                               b2 -= space
+                               b1 = sizeBucketOne
+                       }
+               }
+               steps++
+
+               // check goal
