package foodchain

import (
	"strings"
)

type animal struct {
	name        string
	action      string
	exclamation string
}

var animals = []animal{
	{name: "fly", action: "", exclamation: ""},
	{name: "spider", action: "It wriggled and jiggled and tickled inside her.", exclamation: ""},
	{name: "bird", action: "", exclamation: "How absurd to swallow a bird!"},
	{name: "cat", action: "", exclamation: "Imagine that, to swallow a cat!"},
	{name: "dog", action: "", exclamation: "What a hog, to swallow a dog!"},
	{name: "goat", action: "", exclamation: "Just opened her throat and swallowed a goat!"},
	{name: "cow", action: "", exclamation: "I don't know how she swallowed a cow!"},
	{name: "horse", action: "", exclamation: "She's dead, of course!"},
}

func Verse(v int) string {
	if v < 1 || v > len(animals) {
		return ""
	}
	a := animals[v-1]
	lines := []string{}
	lines = append(lines, "I know an old lady who swallowed a "+a.name+".")
	if v == 1 {
		lines = append(lines, "I don't know why she swallowed the fly. Perhaps she'll die.")
		return strings.Join(lines, "\n")
	}
	if v == len(animals) {
		lines = append(lines, a.exclamation)
		return strings.Join(lines, "\n")
	}
	if a.action != "" {
		lines = append(lines, a.action)
	}
	if a.exclamation != "" {
		lines = append(lines, a.exclamation)
	}
	for i := v - 1; i >= 1; i-- {
		prev := animals[i-1]
		if i == 2 {
			lines = append(lines, "She swallowed the "+a.name+" to catch the "+prev.name+" that wriggled and jiggled and tickled inside her.")
		} else {
			lines = append(lines, "She swallowed the "+a.name+" to catch the "+prev.name+".")
		}
		a = prev
	}
	lines = append(lines, "I don't know why she swallowed the fly. Perhaps she'll die.")
	return strings.Join(lines, "\n")
}

func Verses(start, end int) string {
	verses := []string{}
	for i := start; i <= end; i++ {
		verses = append(verses, Verse(i))
	}
	return strings.Join(verses, "\n\n")
}

func Song() string {
	return Verses(1, len(animals))
}
