```
import re

def answer(question):
    # Remove trailing question mark and leading "What is "
    if not question.endswith('?'):
        raise ValueError("syntax error")
    q = question[:-1].strip()
    if not q.startswith("What is"):
        raise ValueError("syntax error")
    q = q[len("What is"):].strip()
    if q == "":
        raise ValueError("syntax error")

    # Split into tokens: numbers and operation words
    tokens = q.split()
    if not tokens:
        raise ValueError("syntax error")

    # First token must be a number
    try:
        current = int(tokens[0])
    except ValueError:
        raise ValueError("syntax error")

    # If only one token, return the number
    if len(tokens) == 1:
        return current

    # Map operation words to functions
    operations = {
        "plus": lambda a, b: a + b,
        "minus": lambda a, b: a - b,
        "multiplied": lambda a, b: a * b,  # 'multiplied by'
        "divided": lambda a, b: a // b,   # 'divided by'
    }

    i = 1
    while i < len(tokens):
        op_word = tokens[i]
        # 'multiplied' and 'divided' must be followed by 'by'
        if op_word in ("multiplied", "divided"):
            if i + 1 >= len(tokens) or tokens[i + 1] != "by":
                raise ValueError("syntax error")
            op = operations[op_word]
            i += 2
        elif op_word in operations:
            op = operations[op_word]
            i += 1
        else:
            raise ValueError("unknown operation")

        if i >= len(tokens):
            raise ValueError("syntax error")
        try:
            num = int(tokens[i])
        except ValueError:
            raise ValueError("syntax error")
        current = op(current, num)
        i += 1

    return current
```
