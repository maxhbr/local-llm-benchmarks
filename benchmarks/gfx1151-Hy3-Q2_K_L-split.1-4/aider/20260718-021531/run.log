#include "grade_school.h"

#include <algorithm>

namespace grade_school {

void school::add(const std::string& name, int grade) {
    auto& students_in_grade = students[grade];
    if (std::find(students_in_grade.begin(), students_in_grade.end(), name) != students_in_grade.end()) {
        throw std::invalid_argument("Student already enrolled in this grade");
    }
    students_in_grade.push_back(name);
    std::sort(students_in_grade.begin(), students_in_grade.end());
}

std::vector<std::string> school::grade(int grade) const {
    auto it = students.find(grade);
    if (it == students.end()) {
        return {};
    }
    return it->second;
}

std::map<int, std::vector<std::string>> school::roster() const {
    return students;
}

}  // namespace grade_school
