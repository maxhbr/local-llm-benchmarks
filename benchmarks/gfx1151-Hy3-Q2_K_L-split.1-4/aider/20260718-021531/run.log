```
#include "gigasecond.h"



#include <ctime>



namespace gigasecond {



std::tm gigasecond_after(std::tm from) {

    // Convert the given std::tm (interpreted as UTC) to a time_t.

    // mktime treats the struct as local time, so we adjust by the local/UTC offset.

    std::time_t t = std::mktime(&from);

    std::tm local_tm = *std::localtime(&t);

    std::tm utc_tm = *std::gmtime(&t);

    std::time_t local_as_time = std::mktime(&local_tm);

    std::time_t utc_as_time = std::mktime(&utc_tm);

    std::time_t offset = local_as_time - utc_as_time;

    t += offset; // now t represents the true UTC epoch seconds for 'from'



    // Add one gigasecond (1,000,000,000 seconds).

    t += 1000000000;



    // Convert back to std::tm as UTC.

    std::tm result = *std::gmtime(&t);

    return result;

}



}  // namespace gigasecond

```

