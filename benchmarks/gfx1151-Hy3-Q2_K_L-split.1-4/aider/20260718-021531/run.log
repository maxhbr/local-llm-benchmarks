//
// This is only a SKELETON file for the 'Promises' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

const toPromise = (p) => {
  if (p && typeof p.then === 'function') {
    return p;
  }
  return new Promise((resolve) => resolve(p));
};

export const promisify = (fn) => {
  return function (...args) {
    return new Promise((resolve, reject) => {
      fn(...args, (error, ...values) => {
        if (error) {
          reject(error);
        } else {
          resolve(values.length > 1 ? values : values[0]);
        }
      });
    });
  };
};

export const all = (promises) => {
  return new Promise((resolve, reject) => {
    let remaining = promises.length;
    if (remaining === 0) {
      resolve([]);
      return;
    }
    const results = new Array(remaining);
    promises.forEach((p, i) => {
      toPromise(p).then(
        (value) => {
          results[i] = value;
          remaining--;
          if (remaining === 0) {
            resolve(results);
          }
        },
        (error) => {
          reject(error);
        }
      );
    });
  });
};

export const allSettled = (promises) => {
  return new Promise((resolve) => {
    let remaining = promises.length;
    if (remaining === 0) {
      resolve([]);
      return;
    }
    const results = new Array(remaining);
    promises.forEach((p, i) => {
      toPromise(p).then(
        (value) => {
          results[i] = { status: 'fulfilled', value };
          remaining--;
          if (remaining === 0) {
            resolve(results);
          }
        },
        (reason) => {
          results[i] = { status: 'rejected', reason };
          remaining--;
          if (remaining === 0) {
            resolve(results);
          }
        }
      );
    });
  });
};

export const race = (promises) => {
  return new Promise((resolve, reject) => {
    promises.forEach((p) => {
      toPromise(p).then(resolve, reject);
    });
  });
};

export const any = (promises) => {
  return new Promise((resolve, reject) => {
    let remaining = promises.length;
    if (remaining === 0) {
      const err = typeof AggregateError === 'function'
        ? new AggregateError([], 'All promises rejected')
        : new Error('All promises rejected');
      reject(err);
      return;
    }
    const errors = new Array(remaining);
    promises.forEach((p, i) => {
      toPromise(p).then(resolve, (error) => {
        errors[i] = error;
        remaining--;
        if (remaining === 0) {
          const aggErr = typeof AggregateError === 'function'
            ? new AggregateError(errors, 'All promises rejected')
            : new Error('All promises rejected');
          reject(aggErr);
        }
      });
    });
  });
};
```

