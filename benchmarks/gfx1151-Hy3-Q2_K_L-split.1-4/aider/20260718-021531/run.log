//
// This is only a SKELETON file for the 'Tournament' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export const tournamentTally = (input) => {
  const teams = {};

  const addTeam = (name) => {
    if (!teams[name]) {
      teams[name] = { MP: 0, W: 0, D: 0, L: 0, P: 0 };
    }
  };

  const recordResult = (home, away, outcome) => {
    addTeam(home);
    addTeam(away);
    teams[home].MP += 1;
    teams[away].MP += 1;

    if (outcome === 'win') {
      teams[home].W += 1;
      teams[home].P += 3;
      teams[away].L += 1;
    } else if (outcome === 'loss') {
      teams[home].L += 1;
      teams[away].W += 1;
      teams[away].P += 3;
    } else if (outcome === 'draw') {
      teams[home].D += 1;
      teams[home].P += 1;
      teams[away].D += 1;
      teams[away].P += 1;
    }
  };

  const lines = input.split('\n').filter(line => line.trim() !== '');
  for (const line of lines) {
    const [home, away, outcome] = line.split(';');
    recordResult(home, away, outcome);
  }

  const sortedTeams = Object.keys(teams).sort((a, b) => {
    if (teams[b].P !== teams[a].P) {
      return teams[b].P - teams[a].P;
    }
    return a.localeCompare(b);
  });

  const header = 'Team                           | MP |  W |  D |  L |  P';
  const rows = sortedTeams.map(name => {
    const t = teams[name];
    return `${name.padEnd(30)} | ${String(t.MP).padStart(2)} | ${String(t.W).padStart(2)} | ${String(t.D).padStart(2)} | ${String(t.L).padStart(2)} | ${String(t.P).padStart(2)}`;
  });

  return [header, ...rows].join('\n');
};

export default tournamentTally;
```

