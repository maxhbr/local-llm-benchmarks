import org.json.JSONArray;
import org.json.JSONObject;

import java.util.ArrayList;
import java.util.Collections;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

class RestApi {

    private final Map<String, User> usersByName;

    RestApi(User... users) {
        usersByName = new HashMap<>();
        for (User u : users) {
            usersByName.put(u.name(), u);
        }
    }

    String get(String url) {
        if (url.equals("/users")) {
            List<User> all = new ArrayList<>(usersByName.values());
            Collections.sort(all, (a, b) -> a.name().compareTo(b.name()));
            JSONObject response = new JSONObject();
            JSONArray arr = new JSONArray();
            for (User u : all) {
                arr.put(toUserJson(u));
            }
            response.put("users", arr);
            return response.toString();
        }
        throw new UnsupportedOperationException("Unsupported GET url: " + url);
    }

    String get(String url, JSONObject payload) {
        if (url.equals("/users")) {
            JSONArray names = payload.optJSONArray("users");
            List<User> selected = new ArrayList<>();
            if (names != null) {
                for (int i = 0; i < names.length(); i++) {
                    String name = names.getString(i);
                    User u = usersByName.get(name);
                    if (u != null) {
                        selected.add(u);
                    }
                }
            }
            Collections.sort(selected, (a, b) -> a.name().compareTo(b.name()));
            JSONObject response = new JSONObject();
            JSONArray arr = new JSONArray();
            for (User u : selected) {
                arr.put(toUserJson(u));
            }
            response.put("users", arr);
            return response.toString();
        }
        throw new UnsupportedOperationException("Unsupported GET url with payload: " + url);
    }

    String post(String url, JSONObject payload) {
        if (url.equals("/add")) {
            String name = payload.getString("user");
            if (usersByName.containsKey(name)) {
                throw new IllegalArgumentException("User already exists: " + name);
            }
            User newUser = User.builder().setName(name).build();
            usersByName.put(name, newUser);
            return toUserJson(newUser).toString();
        } else if (url.equals("/iou")) {
            String lenderName = payload.getString("lender");
            String borrowerName = payload.getString("borrower");
            double amount = payload.getDouble("amount");

            User lender = usersByName.get(lenderName);
            User borrower = usersByName.get(borrowerName);
            if (lender == null || borrower == null) {
                throw new IllegalArgumentException("Unknown user");
            }

            // Update lender: owedBy borrower +amount
            User newLender = User.builder()
                    .setName(lender.name())
                    .owedBy(lenderName.equals(borrowerName) ? lenderName : borrowerName, amount)
                    .build();
            // Actually we need to aggregate existing IOUs
            newLender = aggregateUser(lender, borrowerName, amount, true);
            newBorrower = aggregateUser(borrower, lenderName, amount, false);

            usersByName.put(lenderName, newLender);
            usersByName.put(borrowerName, newBorrower);

            List<User> updated = new ArrayList<>();
            updated.add(newLender);
            updated.add(newBorrower);
            Collections.sort(updated, (a, b) -> a.name().compareTo(b.name()));
            JSONObject response = new JSONObject();
            JSONArray arr = new JSONArray();
            for (User u : updated) {
                arr.put(toUserJson(u));
            }
            response.put("users", arr);
            return response.toString();
        }
        throw new UnsupportedOperationException("Unsupported POST url: " + url);
    }

    private User aggregateUser(User existing, String otherName, double amount, boolean owedBy) {
        User.Builder builder = User.builder().setName(existing.name());
        // copy existing owes
        for (Iou iou : existing.owes()) {
            builder.owes(iou.name(), iou.amount());
        }
        for (Iou iou : existing.owedBy()) {
            builder.owedBy(iou.name(), iou.amount());
        }
        if (owedBy) {
            builder.owedBy(otherName, amount);
        } else {
            builder.owes(otherName, amount);
        }
        return builder.build();
    }

    private JSONObject toUserJson(User user) {
        JSONObject obj = new JSONObject();
        obj.put("name", user.name());
        JSONObject owes = new JSONObject();
        for (Iou iou : user.owes()) {
            owes.put(iou.name(), owes.optDouble(iou.name(), 0.0) + iou.amount());
        }
        JSONObject owedBy = new JSONObject();
        for (Iou iou : user.owedBy()) {
            owedBy.put(iou.name(), owedBy.optDouble(iou.name(), 0.0) + iou.amount());
        }
        obj.put("owes", owes);
        obj.put("owed_by", owedBy);
        obj.put("balance", user.balance());
        return obj;
    }
}
