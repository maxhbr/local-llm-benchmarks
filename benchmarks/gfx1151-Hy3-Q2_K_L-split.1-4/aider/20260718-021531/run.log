            digits.push_back(c);
        }
    }
    // Remove leading country code '1' if present (only if total length is 11)
    if (digits.size() == 11 && digits[0] == '1') {
        digits = digits.substr(1);
    }
    // Validate NANP: must be 10 digits, area code and exchange code first digits 2-9
    if (digits.size() != 10) {
        throw std::invalid_argument("Invalid phone number length");
    }
    if (digits[0] < '2' || digits[0] > '9') {
        throw std::invalid_argument("Invalid area code first digit");
    }
    if (digits[3] < '2' || digits[3] > '9') {
        throw std::invalid_argument("Invalid exchange code first digit");
    }
    cleaned = digits;
}

std::string phone_number::number() const {
    return cleaned;
}

}  // namespace phone_number
