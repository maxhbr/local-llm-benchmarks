pub enum Error {
    NotEnoughPinsLeft,
    GameComplete,
}

pub struct BowlingGame {
    rolls: Vec<u16>,
    frame: usize,
    pins_left: u16,
    rolls_in_frame: usize,
    complete: bool,
}

