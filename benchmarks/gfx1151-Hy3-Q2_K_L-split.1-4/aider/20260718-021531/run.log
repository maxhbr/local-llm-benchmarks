const DIGIT_PATTERNS = {
  ' _ | ||_|    ': '0',
  '   | |   |   ': '1',
  ' _  _||_     ': '2',
  ' _  _| _|    ': '3',
  '   |_|  |    ': '4',
  ' _ |_  _|    ': '5',
  ' _ |_|_|     ': '6',
  ' _   |   |   ': '7',
  ' _ |_||_|    ': '8',
  ' _ |_| _|    ': '9'
};

function recognizeDigit(grid) {
  // grid is array of 4 strings, each 3 chars wide
  const key = grid[0] + grid[1] + grid[2] + grid[3];
  return DIGIT_PATTERNS[key] || '?';
}

function convert(input) {
  const lines = input.split('\n');
  // Each digit uses 4 rows, so number of rows must be multiple of 4
  if (lines.length % 4 !== 0) {
    throw new Error('Incorrect size');
  }
