Below is a refactored version of `ledger.js`. I kept the public API (`LedgerEntry`, `createEntry`, `formatEntries`) unchanged and made small, behavior-preserving improvements:

Refactor log (also included as a comment at the top of the file):
1. Extracted duplicate header/date/description/change formatting into shared helpers per locale to remove copy-paste.
2. Unified currency formatting using `Intl.NumberFormat` with locale- and currency-aware options, removing the `if (currency === ...)` branches inside each locale block.
3. Removed repeated sorting logic by extracting a `sortEntries` helper.
4. Centralized truncation of descriptions in a `formatDescription` helper.
5. Made date formatting locale-specific via a `formatDate` helper to avoid mixed date formats.
6. Kept exact output format (padding, signs, parentheses for negatives in en-US) so all original tests still pass.

ledger.js
```
/**
 * Refactor log for ledger.js:
 * 1. Extracted shared helpers: sortEntries, formatDescription, formatDate, formatChange, renderTable.
 * 2. Removed duplicated currency formatting branches by using Intl.NumberFormat per locale/currency.
 * 3. Kept public API (LedgerEntry, createEntry, formatEntries) unchanged.
 * 4. Preserved exact output strings/padding so existing tests pass.
 */

class LedgerEntry {
  constructor() {
    this.date = undefined;
    this.description = undefined;
    this.change = undefined;
  }
}

export function createEntry(date, description, change) {
  let entry = new LedgerEntry();
  entry.date = new Date(date);
  entry.description = description;
  entry.change = change;
  return entry;
}

function sortEntries(entries) {
  entries.sort(
    (a, b) =>
      a.date - b.date ||
      a.change - b.change ||
      a.description.localeCompare(b.description),
  );
}

function formatDescription(description) {
  return description.length > 25
    ? `${description.substring(0, 22)}...`
    : description.padEnd(25, ' ');
}

function formatDate(entry, locale) {
  const d = entry.date;
  if (locale === 'en-US') {
    const mm = (d.getMonth() + 1).toString().padStart(2, '0');
    const dd = d.getDate().toString().padStart(2, '0');
    return `${mm}/${dd}/${d.getFullYear()}`;
  } else if (locale === 'nl-NL') {
    const dd = d.getDate().toString().padStart(2, '0');
    const mm = (d.getMonth() + 1).toString().padStart(2, '0');
    return `${dd}-${mm}-${d.getFullYear()}`;
  }
  return '';
}

function formatChange(entry, currency, locale) {
  const options = {
    style: 'currency',
    currency,
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  };
  if (locale === 'en-US') {
    if (entry.change < 0) {
      return `(${Math.abs(entry.change / 100).toLocaleString('en-US', options)})`;
    }
    return `${(entry.change / 100).toLocaleString('en-US', options)} `;
  } else if (locale === 'nl-NL') {
    options.currencyDisplay = 'narrowSymbol';
    return `${(entry.change / 100).toLocaleString('nl-NL', options)} `;
  }
  return '';
}

function renderTable(currency, locale, entries, headerParts) {
  let table = '';
  table +=
    headerParts.date.padEnd(10, ' ') +
    ' | ' +
    headerParts.description.padEnd(25, ' ') +
    ' | ' +
    headerParts.change.padEnd(13, ' ') +
    '\n';

  sortEntries(entries);

  entries.forEach((entry) => {
    table += `${formatDate(entry, locale)} | `;
    table += `${formatDescription(entry.description)} | `;
    table += formatChange(entry, currency, locale).padStart(13, ' ');
    table += '\n';
  });

  return table.replace(/\n$/, '');
}

export function formatEntries(currency, locale, entries) {
  if (locale === 'en-US') {
    return renderTable(currency, locale, entries, {
      date: 'Date',
      description: 'Description',
      change: 'Change',
    });
  } else if (locale === 'nl-NL') {
    return renderTable(currency, locale, entries, {
      date: 'Datum',
      description: 'Omschrijving',
      change: 'Verandering',
    });
  }
  return '';
}
```
