simple_linked_list.go
```
package linkedlist

import "errors"

// Element represents a node in the singly linked list.
type Element struct {
	value int
	next  *Element
}

// List represents a singly linked list of song IDs.
type List struct {
	head *Element
	size int
}

// New creates a new List from the given slice of song IDs.
func New(elements []int) *List {
	l := &List{}
	for _, e := range elements {
		l.Push(e)
	}
	return l
}

// Size returns the number of elements in the list.
func (l *List) Size() int {
	return l.size
}

// Push adds an element to the end of the list.
func (l *List) Push(element int) {
	node := &Element{value: element}
	if l.head == nil {
		l.head = node
	} else {
		curr := l.head
		for curr.next != nil {
			curr = curr.next
		}
		curr.next = node
	}
	l.size++
}

// Pop removes and returns the last element of the list.
func (l *List) Pop() (int, error) {
	if l.head == nil {
		return 0, errors.New("list is empty")
	}
	if l.head.next == nil {
		val := l.head.value
		l.head = nil
		l.size--
		return val, nil
	}
	curr := l.head
	for curr.next.next != nil {
		curr = curr.next
	}
	val := curr.next.value
	curr.next = nil
	l.size--
	return val, nil
}

// Array returns the elements of the list as a slice in forward order.
func (l *List) Array() []int {
	result := []int{}
	curr := l.head
	for curr != nil {
		result = append(result, curr.value)
		curr = curr.next
	}
	return result
}

// Reverse returns a new list with the elements in reverse order.
func (l *List) Reverse() *List {
	reversed := &List{}
	curr := l.head
	for curr != nil {
		// Push to front of reversed list to reverse order
		node := &Element{value: curr.value}
		node.next = reversed.head
		reversed.head = node
		reversed.size++
		curr = curr.next
	}
	return reversed
}
```

This implementation:
- Defines `Element` (node with `value` and `next`) and `List` (with `head` and `size`).
- `New` builds the list from a slice of song IDs by pushing each.
- `Size`, `Push`, `Pop`, `Array`, and `Reverse` are implemented per the instructions (singly linked list, reverse to play opposite order).
- Uses only standard library (`errors`).
- Keeps all original function signatures unchanged.
