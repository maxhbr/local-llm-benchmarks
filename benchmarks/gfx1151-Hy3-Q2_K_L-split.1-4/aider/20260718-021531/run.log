#[derive(Debug)]
pub struct Error;

pub struct Scale {
    notes: Vec<String>,
}

const SHARP_CHROMATIC: [&str; 12] = [
    "A", "A#", "B", "C", "C#", "D", "D#", "E", "F", "F#", "G", "G#",
];

const FLAT_CHROMATIC: [&str; 12] = [
    "A", "Bb", "B", "C", "Db", "D", "Eb", "E", "F", "Gb", "G", "Ab",
];

fn uses_flats(tonic: &str) -> bool {
    let t = tonic.to_lowercase();
    matches!(
        t.as_str(),
        "f" | "bb" | "eb" | "ab" | "db" | "gb" | "d" | "g" | "c" | "f" | "bb" | "eb"
    ) || tonic == "F" || tonic == "Bb" || tonic == "Eb" || tonic == "Ab" || tonic == "Db"
        || tonic == "Gb"
}

impl Scale {
    pub fn new(tonic: &str, intervals: &str) -> Result<Scale, Error> {
        let chromatic = if uses_flats(tonic) {
            FLAT_CHROMATIC
        } else {
            SHARP_CHROMATIC
        };

        let start = tonic.to_string();
        let mut start_idx = chromatic
            .iter()
            .position(|&n| n.to_lowercase() == tonic.to_lowercase())
            .ok_or(Error)?;

        let mut notes = Vec::new();
        notes.push(start);

        let mut idx = start_idx;
        for step in intervals.chars() {
            match step {
                'm' => idx = (idx + 1) % 12,
                'M' => idx = (idx + 2) % 12,
                'A' => idx = (idx + 3) % 12,
                _ => return Err(Error),
            }
            notes.push(chromatic[idx].to_string());
        }

        Ok(Scale { notes })
    }

    pub fn chromatic(tonic: &str) -> Result<Scale, Error> {
        let chromatic = if uses_flats(tonic) {
            FLAT_CHROMATIC
        } else {
            SHARP_CHROMATIC
        };

        let start_idx = chromatic
            .iter()
            .position(|&n| n.to_lowercase() == tonic.to_lowercase())
            .ok_or(Error)?;

        let mut notes: Vec<String> = Vec::new();
        for i in 0..12 {
            notes.push(chromatic[(start_idx + i) % 12].to_string());
        }

        Ok(Scale { notes })
    }

    pub fn enumerate(&self) -> Vec<String> {
        self.notes.clone()
    }
}
