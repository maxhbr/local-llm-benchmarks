affine_cipher.py
```
import math

def _is_coprime(a, m):
    return math.gcd(a, m) == 1

def _modular_inverse(a, m):
    # find x such that (a * x) % m == 1
    for x in range(1, m):
        if (a * x) % m == 1:
            return x
    raise ValueError("No modular inverse exists.")

def encode(plain_text, a, b):
    if not _is_coprime(a, 26):
        raise ValueError("a and m must be coprime.")
    
    plain_text = plain_text.lower()
    result = []
    for ch in plain_text:
        if ch.isdigit():
            result.append(ch)
        elif ch.isalpha():
            i = ord(ch) - ord('a')
            encrypted = (a * i + b) % 26
            result.append(chr(encrypted + ord('a')))
        # ignore spaces and punctuation
    
    # group into blocks of 5
    grouped = []
    for idx in range(0, len(result), 5):
        grouped.append(''.join(result[idx:idx+5]))
    return ' '.join(grouped)

def decode(ciphered_text, a, b):
    if not _is_coprime(a, 26):
        raise ValueError("a and m must be coprime.")
    
    mmi = _modular_inverse(a, 26)
    result = []
    for ch in ciphered_text:
        if ch == ' ':
            continue
        if ch.isdigit():
            result.append(ch)
        elif ch.isalpha():
            y = ord(ch) - ord('a')
            decrypted = (mmi * (y - b)) % 26
            result.append(chr(decrypted + ord('a')))
    return ''.join(result)
```
