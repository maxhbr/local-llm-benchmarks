word-search.js
```
//
// This is only a SKELETON file for the 'Word Search' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

class WordSearch {
  constructor(puzzle) {
    this.puzzle = puzzle;
  }

  find(words) {
    const grid = this.puzzle;
    const rows = grid.length;
    const cols = grid[0].length;
    const result = {};

    const directions = [
      [0, 1],   // right
      [1, 0],   // down
      [1, 1],   // down-right
      [0, -1],  // left
      [-1, 0],  // up
      [-1, -1], // up-left
      [1, -1],  // down-left
      [-1, 1],  // up-right
    ];

    for (const word of words) {
      let found = false;
      for (let r = 0; r < rows && !found; r++) {
        for (let c = 0; c < cols && !found; c++) {
          if (grid[r][c] === word[0]) {
            for (const [dr, dc] of directions) {
              let rr = r;
              let cc = c;
              let match = true;
              for (let i = 1; i < word.length; i++) {
                rr += dr;
                cc += dc;
                if (rr < 0 || rr >= rows || cc < 0 || cc >= cols) {
                  match = false;
                  break;
                }
                if (grid[rr][cc] !== word[i]) {
                  match = false;
                  break;
                }
              }
              if (match) {
                const start = { row: r + 1, column: c + 1 };
                const end = { row: rr + 1, column: cc + 1 };
                result[word] = { start, end };
                found = true;
                break;
              }
            }
          }
        }
      }
    }

    return result;
  }
}

export default WordSearch;
```
