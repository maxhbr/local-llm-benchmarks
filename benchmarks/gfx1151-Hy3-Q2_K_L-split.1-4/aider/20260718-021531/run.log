//
// This is the implementation for the 'Two Bucket' exercise.
//

export class TwoBucket {
  constructor(size1, size2, goal, startBucket) {
    this.size1 = size1;
    this.size2 = size2;
    this.goal = goal;
    this.startBucket = startBucket; // 'one' or 'two'
  }

  solve() {
    const cap1 = this.size1;
    const cap2 = this.size2;
    const goal = this.goal;
    const start = this.startBucket;

    // Current amounts in bucket one and bucket two
    let b1 = 0;
    let b2 = 0;

    // Fill the starting bucket first
    if (start === 'one') {
      b1 = cap1;
    } else {
      b2 = cap2;
    }

    let moves = 1;

    // If the first fill already meets the goal
    if (b1 === goal) {
      return { moves, goalBucket: 'one', otherBucket: b2 };
    }
    if (b2 === goal) {
      return { moves, goalBucket: 'two', otherBucket: b1 };
    }

    // Helper to check forbidden state: start bucket empty and other full
    const isForbidden = (a, b) => {
      if (start === 'one') return a === 0 && b === cap2;
      return b === 0 && a === cap1;
    };

    // State history to avoid loops
    const seen = new Set();
    const key = (a, b) => `${a},${b}`;
    seen.add(key(b1, b2));

    while (true) {
      // Determine action: pour, empty, or fill
      let nextB1 = b1;
      let nextB2 = b2;

      if (b1 === 0) {
        // Fill bucket one
        nextB1 = cap1;
      } else if (b2 === cap2) {
        // Empty bucket two
        nextB2 = 0;
      } else {
        // Pour from bucket one to bucket two
        const space = cap2 - b2;
        const pour = Math.min(b1, space);
        nextB1 = b1 - pour;
        nextB2 = b2 + pour;
      }

      // Check forbidden state after action
      if (isForbidden(nextB1, nextB2)) {
        // If forbidden, we must choose alternative: if we were going to fill start bucket when empty,
        // instead pour from the other bucket? Actually rule: cannot end in start empty & other full.
        // So if next state is forbidden, we need to do a different valid action.
        // Alternative: if b1===0 and start==='one', instead of filling one (which leads to forbidden only if other is full),
        // but other is full means b2===cap2, so we must empty the other instead of filling start.
        if (start === 'one' && nextB1 === 0 && nextB2 === cap2) {
          nextB2 = 0; // empty bucket two instead of filling bucket one
        } else if (start === 'two' && nextB2 === 0 && nextB1 === cap1) {
          nextB1 = 0; // empty bucket one instead of filling bucket two
        }
      }

      b1 = nextB1;
      b2 = nextB2;
      moves++;

      // Check goal
      if (b1 === goal) {
        return { moves, goalBucket: 'one', otherBucket: b2 };
      }
      if (b2 === goal) {
        return { moves, goalBucket: 'two', otherBucket: b1 };
      }

      const stateKey = key(b1, b2);
      if (seen.has(stateKey)) {
