@@ -1,5 +1,53 @@
 #include "circular_buffer.h"
 
 namespace circular_buffer {
 
+template<typename T>
+buffer<T>::buffer(size_t size) : size_(size), data_(size), head_(0), tail_(0), full_(false) {}
+
+template<typename T>
+void buffer<T>::write(const T& value) {
+    if (full_) {
+        throw std::domain_error("buffer full");
+    }
+    data_[head_] = value;
+    head_ = (head_ + 1) % size_;
+    if (head_ == tail_) {
+        full_ = true;
+    }
+}
+
+template<typename T>
+void buffer<T>::overwrite(const T& value) {
+    if (full_) {
+        // overwrite oldest (tail_)
+        data_[tail_] = value;
+        tail_ = (tail_ + 1) % size_;
+        head_ = tail_;
+    } else {
+        data_[head_] = value;
+        head_ = (head_ + 1) % size_;
+        if (head_ == tail_) {
+            full_ = true;
+        }
+    }
+}
+
+template<typename T>
+T buffer<T>::read() {
+    if (!full_ && head_ == tail_) {
+        throw std::domain_error("buffer empty");
+    }
+    T val = data_[tail_];
+    tail_ = (tail_ + 1) % size_;
+    full_ = false;
+    return val;
+}
+
+template<typename T>
+void buffer<T>::clear() {
+    head_ = tail_ = 0;
+    full_ = false;
+}
+
 }  // namespace circular_buffer
```



