```
package sublist

// Relation type is defined in relations.go file.

func Sublist(l1, l2 []int) Relation {
	if len(l1) == len(l2) {
		equal := true
		for i := range l1 {
			if l1[i] != l2[i] {
				equal = false
				break
			}
		}
		if equal {
			return Equal
		}
		return Unequal
	}

	if len(l1) > len(l2) {
		// l1 is superlist of l2 if l2 is contained in l1
		if contains(l1, l2) {
			return Superlist
		}
		return Unequal
	}

	// len(l1) < len(l2)
	if contains(l2, l1) {
		return Sublist
	}
	return Unequal
}

func contains(outer, inner []int) bool {
	if len(inner) == 0 {
		return true
	}
	for i := 0; i <= len(outer)-len(inner); i++ {
		match := true
		for j := 0; j < len(inner); j++ {
			if outer[i+j] != inner[j] {
				match = false
				break
			}
		}
		if match {
			return true
		}
	}
