	2:  "two",
	3:  "three",
	4:  "four",
	5:  "five",
	6:  "six",
	7:  "seven",
	8:  "eight",
	9:  "nine",
	10: "ten",
}

func Recite(startBottles, takeDown int) []string {
	var lyrics []string
	for i := 0; i < takeDown; i++ {
		current := startBottles - i
		next := current - 1

		currentBottles := capWords[current] + " green bottle"
		if current != 1 {
			currentBottles += "s"
		}
