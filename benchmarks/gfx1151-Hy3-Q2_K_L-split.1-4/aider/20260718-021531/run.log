// this module adds some functionality based on the required implementations
// here like: `LinkedList::pop_back` or `Clone for LinkedList<T>`
// You are free to use anything in it, but it's mainly for the test framework.
mod pre_implemented;

use std::ptr;
use std::marker::PhantomData;

// Node structure for the doubly linked list
// SAFETY: Node contains raw pointers to other nodes. The list maintains the
// invariant that all pointers are valid (point to allocated nodes) or null.
// Only the LinkedList owns the nodes and cleans them up on Drop.
struct Node<T> {
    data: T,
    next: Option<Box<Node<T>>>,
    prev: *mut Node<T>,
}

// SAFETY: We implement Send/Sync manually because of raw pointers (prev).
// The list is safe to send/share because we only access nodes through
// controlled mutable/immutable references and the cursor.
unsafe impl<T: Send> Send for LinkedList<T> {}
unsafe impl<T: Sync> Sync for LinkedList<T> {}

pub struct LinkedList<T> {
    head: Option<Box<Node<T>>>,
    tail: *mut Node<T>,
    len: usize,
    _marker: PhantomData<T>,
}

pub struct Cursor<'a, T> {
    list: &'a mut LinkedList<T>,
    // current points to the node the cursor is "at" (for insert/peek/take).
    // If null, cursor is positioned at an empty list (front of empty).
    current: *mut Node<T>,
    _marker: PhantomData<&'a mut T>,
}

pub struct Iter<'a, T> {
    list: &'a LinkedList<T>,
    next: Option<&'a Node<T>>,
    _marker: PhantomData<&'a T>,
}

impl<T> LinkedList<T> {
    pub fn new() -> Self {
        LinkedList {
        head: None,
        tail: ptr::null_mut(),
        len: 0,
        _marker: PhantomData,
        }
    }

    // You may be wondering why it's necessary to have is_empty()
    // when it can easily be determined from len().
    // It's good custom to have both because len() can be expensive for some types,
    // whereas is_empty() is almost always cheap.
    // (Also ask yourself whether len() is expensive for LinkedList)
    pub fn is_empty(&self) -> bool {
        self.len == 0
    }

    pub fn len(&self) -> usize {
        self.len
    }

    /// Return a cursor positioned on the front element
    pub fn cursor_front(&mut self) -> Cursor<'_, T> {
        let current = self.head.as_ref().map(|h| h.as_ref() as *const Node<T> as *mut Node<T>).unwrap_or(ptr::null_mut());
        Cursor {
            list: self,
            current,
            _marker: PhantomData,
        }
    }

    /// Return a cursor positioned on the back element
    pub fn cursor_back(&mut self) -> Cursor<'_, T> {
        let current = if self.tail.is_null() {
            ptr::null_mut()
        } else {
            self.tail
        };
        Cursor {
            list: self,
            current,
            _marker: PhantomData,
        }
    }

    /// Return an iterator that moves from front to back
    pub fn iter(&self) -> Iter<'_, T> {
        Iter {
            list: self,
            next: self.head.as_ref().map(|h| h.as_ref()),
            _marker: PhantomData,
        }
    }
}

// the cursor is expected to act as if it is at the position of an element
// and it also has to work with and be able to insert into an empty list.
impl<T> Cursor<'_, T> {
    /// Take a mutable reference to the current element
    pub fn peek_mut(&mut self) -> Option<&mut T> {
        if self.current.is_null() {
            None
        } else {
            // SAFETY: current is either null or points to a node owned by the list,
            // and we have exclusive access via &mut self / &mut list.
            unsafe { Some(&mut (*self.current).data) }
        }
    }

    /// Move one position forward (towards the back) and
    /// return a reference to the new position
    #[allow(clippy::should_implement_trait)]
    pub fn next(&mut self) -> Option<&mut T> {
        if self.current.is_null() {
            // at empty or before front: move to front if exists
            self.current = self.list.head.as_ref().map(|h| h.as_ref() as *const Node<T> as *mut Node<T>).unwrap_or(ptr::null_mut());
        } else {
            // SAFETY: current is valid node; next is owned by list.
            unsafe {
                let next = (*self.current).next.as_ref().map(|n| n.as_ref() as *const Node<T> as *mut Node<T>);
                self.current = next.unwrap_or(ptr::null_mut());
            }
        }
        self.peek_mut()
    }

    /// Move one position backward (towards the front) and
    /// return a reference to the new position
    pub fn prev(&mut self) -> Option<&mut T> {
        if self.current.is_null() {
            // at empty or before front: stay null
            return None;
        }
        // SAFETY: current valid; prev pointer is either null or points to node in list.
        unsafe {
            self.current = (*self.current).prev;
        }
        self.peek_mut()
    }

    /// Remove and return the element at the current position and move the cursor
    /// to the neighboring element that's closest to the back. This can be
    /// either the next or previous position.
    pub fn take(&mut self) -> Option<T> {
        if self.current.is_null() {
            return None;
        }
        // SAFETY: current points to a node in the list; we remove it and fix links.
        unsafe {
            let node_ptr = self.current;
            let node = &mut *node_ptr;
            let prev = node.prev;
            let next = node.next.take(); // take ownership of next box

            // Fix previous node's next or head
            if prev.is_null() {
                // removing head
                self.list.head = next;
            } else {
                (*prev).next = next;
            }

            // Fix next node's prev or tail
            if let Some(ref mut nbox) = next {
                nbox.prev = prev;
                if prev.is_null() {
                    self.list.tail = nbox.as_mut() as *mut Node<T>;
                }
            } else {
                // removing tail
                self.list.tail = prev;
            }

            self.list.len -= 1;

            // Move cursor to closest to back: next if exists else prev
            self.current = if next.is_some() {
                next.as_ref().unwrap().as_ref() as *const Node<T> as *mut Node<T>
            } else {
                prev
            };

            // Extract data from node (we already have exclusive access; rebuild node to move out)
            // We need to move out the data. Since node is inside a Box somewhere? Actually we took
            // next out of node, but node itself is still in list (as Box). We must remove the Box.
            // To do this, we need to reconstruct the node and take its data.
            // Simpler: we already detached node from list; now we need to get the Box containing it.
            // We can't easily get Box from raw ptr. Instead, we can swap the data out using ptr read.
            let data = ptr::read(&node.data);
            // Leak the node's Box? We must free the node. Since we detached it, we need to reconstruct Box.
            // We know the node was either head (Box) or inside another node's next (Box).
            // We already replaced those with `next`, so the Box for this node is gone from list.
            // To drop it, we reconstruct a Box from the raw pointer.
            let _box = Box::from_raw(node_ptr);
            // _box drops here, freeing the node (data already moved out).
            Some(data)
        }
    }

    pub fn insert_after(&mut self, element: T) {
        // SAFETY: we create a new node and link appropriately.
        unsafe {
            let mut new_node = Box::new(Node {
                data: element,
                next: None,
                prev: self.current,
            });
            let new_ptr = new_node.as_mut() as *mut Node<T>;

            if self.current.is_null() {
                // empty list or cursor before front: insert as new head
                if let Some(mut head) = self.list.head.take() {
                    // there is existing list, we are inserting at front
                    new_node.next = Some(head);
                    head.prev = new_ptr;
                    self.list.head = new_node;
                    self.list.tail = self.list.tail; // unchanged if tail was head? handled below
                    // if list had only one node, tail was head; now tail is still that node
                    // but we need to update tail if list was empty? handled by else
                } else {
                    self.list.head = new_node;
                    self.list.tail = new_ptr;
                }
            } else {
                let cur = &mut *self.current;
                let cur_next = cur.next.take();
                new_node.next = cur_next;
                if let Some(ref mut n) = new_node.next {
                    n.prev = new_ptr;
                } else {
                    // new node becomes tail
                    self.list.tail = new_ptr;
                }
                cur.next = Some(new_node);
            }
            self.list.len += 1;
            // position cursor on new node? Spec doesn't require, leave as is or move?
            // We'll leave current unchanged (still old position) per typical cursor semantics.
        }
    }

    pub fn insert_before(&mut self, element: T) {
        unsafe {
            let mut new_node = Box::new(Node {
                data: element,
                next: None,
                prev: ptr::null_mut(),
            });
            let new_ptr = new_node.as_mut() as *mut Node<T>;

            if self.current.is_null() {
                // empty list: same as insert_after (becomes head)
                if self.list.head.is_none() {
                    self.list.head = new_node;
                    self.list.tail = new_ptr;
                } else {
                    // insert before front: becomes new head
                    let mut head = self.list.head.take().unwrap();
                    new_node.next = Some(head);
                    head.prev = new_ptr;
                    self.list.head = new_node;
                }
            } else {
                let cur = &mut *self.current;
                let cur_prev = cur.prev;
                new_node.prev = cur_prev;
                new_node.next = Some(Box::from_raw(self.current)); // not exactly; we have cur as &mut, can't move
                // Actually we cannot move cur into new_node.next because cur is borrowed.
                // Instead, we take the current node's next? No, before means between prev and cur.
                // We already have cur (borrowed). We can set cur.prev = new_ptr and prev.next = new_node.
                if cur_prev.is_null() {
                    // new node becomes head
                    self.list.head = new_node;
                } else {
                    (*cur_prev).next = Some(new_node);
                }
                cur.prev = new_ptr;
            }
            self.list.len += 1;
        }
    }
}

impl<'a, T> Iterator for Iter<'a, T> {
    type Item = &'a T;

    fn next(&mut self) -> Option<&'a T> {
        if let Some(node) = self.next {
            self.next = node.next.as_ref().map(|n| n.as_ref());
            Some(&node.data)
        } else {
            None
        }
    }
}

impl<T> Drop for LinkedList<T> {
    fn drop(&mut self) {
        // SAFETY: we own all nodes and drop them via taking the head and following next.
        // The prev pointers are not used here; we just traverse and drop Boxes.
        let mut current = self.head.take();
        while let Some(mut node) = current {
            current = node.next.take();
            // node dropped here, which recursively drops its next when it goes out of scope,
            // but we've taken next so it's iterative.
        }
        self.tail = ptr::null_mut();
        self.len = 0;
    }
}
```

