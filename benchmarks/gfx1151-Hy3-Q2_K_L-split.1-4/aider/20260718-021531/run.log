        {"shellfish", 4},
        {"strawberries", 8},
        {"tomatoes", 16},
        {"chocolate", 32},
        {"pollen", 64},
        {"cats", 128}
    };
}

allergy_test::allergy_test(unsigned score) : score_(score & mask) {}

bool allergy_test::is_allergic_to(const std::string& item) const {
