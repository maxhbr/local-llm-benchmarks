#pragma once

#include <vector>
#include <algorithm>

namespace sublist {

enum class Relation {
    Equal,
    Superlist,
    Sublist,
    Unequal
};

template <typename T>
Relation classify(const std::vector<T>& a, const std::vector<T>& b) {
    if (a == b) return Relation::Equal;
    if (a.empty() && !b.empty()) return Relation::Sublist;
    if (!a.empty() && b.empty()) return Relation::Superlist;
    if (a.size() >= b.size() &&
        std::search(a.begin(), a.end(), b.begin(), b.end()) != a.end())
        return Relation::Superlist;
    if (b.size() >= a.size() &&
        std::search(b.begin(), b.end(), a.begin(), a.end()) != b.end())
        return Relation::Sublist;
    return Relation::Unequal;
}

}  // namespace sublist
```

