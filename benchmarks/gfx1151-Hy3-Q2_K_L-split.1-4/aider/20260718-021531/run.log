def can_chain(dominoes):
    if not dominoes:
        return []

    n = len(dominoes)
    used = [False] * n

    def backtrack(chain, current_end):
        if len(chain) == n:
            # all used, check if chain closes
            if chain[0][0] == current_end:
                return chain.copy()
            return None
        for i in range(n):
            if not used[i]:
                a, b = dominoes[i]
                if a == current_end:
                    used[i] = True
                    chain.append([a, b])
                    res = backtrack(chain, b)
                    if res is not None:
                        return res
                    chain.pop()
                    used[i] = False
                elif b == current_end:
                    used[i] = True
                    chain.append([b, a])
                    res = backtrack(chain, a)
                    if res is not None:
                        return res
                    chain.pop()
                    used[i] = False
        return None

    for i in range(n):
        used[i] = True
        # start with domino i in either orientation
        a, b = dominoes[i]
        # orientation 1: start with [a,b], end = b, start = a
        chain = [[a, b]]
        res = backtrack(chain, b)
        if res is not None:
            return res
        chain = [[b, a]]
        res = backtrack(chain, a)
        if res is not None:
            return res
        used[i] = False

    return False
```

