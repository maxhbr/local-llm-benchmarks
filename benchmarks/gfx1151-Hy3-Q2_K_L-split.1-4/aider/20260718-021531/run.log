```go
package forth

import (
	"errors"
	"fmt"
	"strconv"
	"strings"
)

func Forth(input []string) ([]int, error) {
	stack := []int{}
	words := map[string][]string{}

	// Collect definitions
	for _, line := range input {
		line = strings.TrimSpace(line)
		if line == "" {
			continue
		}
		if strings.HasPrefix(line, ":") {
			parts := strings.Fields(line)
			if len(parts) < 4 || parts[len(parts)-1] != ";" {
				return nil, errors.New("invalid word definition")
			}
			name := strings.ToLower(parts[1])
			def := parts[2 : len(parts)-1]
			words[name] = def
		}
	}

	// Execute
	for _, line := range input {
		line = strings.TrimSpace(line)
		if line == "" || strings.HasPrefix(line, ":") {
			continue
		}
		tokens := strings.Fields(line)
		queue := append([]string{}, tokens...)
		for len(queue) > 0 {
			tok := queue[0]
			queue = queue[1:]
			lower := strings.ToLower(tok)
			if isNumber(tok) {
				num, err := strconv.Atoi(tok)
				if err != nil {
					return nil, fmt.Errorf("invalid number %q", tok)
				}
				stack = append(stack, num)
				continue
			}
			if def, ok := words[lower]; ok {
				queue = append(queue, def...)
				continue
			}
			if err := executeWord(lower, &stack); err != nil {
				return nil, err
			}
		}
	}

	return stack, nil
}

func executeWord(word string, stack *[]int) error {
	n := len(*stack)
	switch word {
	case "+":
		if n < 2 {
			return errors.New("stack underflow for +")
		}
		a := (*stack)[n-2]
		b := (*stack)[n-1]
		(*stack)[n-2] = a + b
		*stack = (*stack)[:n-1]
	case "-":
		if n < 2 {
			return errors.New("stack underflow for -")
		}
		a := (*stack)[n-2]
		b := (*stack)[n-1]
		(*stack)[n-2] = a - b
		*stack = (*stack)[:n-1]
	case "*":
		if n < 2 {
			return errors.New("stack underflow for *")
		}
		a := (*stack)[n-2]
		b := (*stack)[n-1]
		(*stack)[n-2] = a * b
		*stack = (*stack)[:n-1]
	case "/":
		if n < 2 {
			return errors.New("stack underflow for /")
		}
		a := (*stack)[n-2]
		b := (*stack)[n-1]
		if b == 0 {
			return errors.New("division by zero")
		}
		(*stack)[n-2] = a / b
		*stack = (*stack)[:n-1]
	case "dup":
		if n < 1 {
			return errors.New("stack underflow for dup")
		}
		*stack = append(*stack, (*stack)[n-1])
	case "drop":
		if n < 1 {
			return errors.New("stack underflow for drop")
		}
		*stack = (*stack)[:n-1]
	case "swap":
		if n < 2 {
			return errors.New("stack underflow for swap")
		}
		(*stack)[n-2], (*stack)[n-1] = (*stack)[n-1], (*stack)[n-2]
	case "over":
		if n < 2 {
			return errors.New("stack underflow for over")
		}
		*stack = append(*stack, (*stack)[n-2])
	default:
		return fmt.Errorf("unknown word %q", word)
	}
	return nil
}

func isNumber(s string) bool {
	if len(s) == 0 {
		return false
	}
	for _, r := range s {
		if r < '0' || r > '9' {
			return false
		}
	}
	return true
}
```

This removes recursion and should fix the stack overflow. Also, note that we now do two passes over input: first to collect definitions, then to execute. This is fine and matches Forth's requirement that words are defined before use (though in our original code, definitions were stored as encountered, and execution happened after the definition line, so it was already before use). But two passes is simpler and ensures all definitions are known before execution.

One minor issue: if a line contains a definition AND also other tokens (not according to spec), we skip it in execution pass because it starts with `:`. That's fine.

