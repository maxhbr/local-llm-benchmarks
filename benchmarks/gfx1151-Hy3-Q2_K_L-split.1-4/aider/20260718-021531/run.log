template<typename T>
class binary_tree {
    T data_;
    std::unique_ptr<binary_tree> left_, right_;
    std::vector<T> sorted_; // for iteration
public:
    explicit binary_tree(const T& val) : data_(val) { sorted_.push_back(val); }
    binary_tree(const std::vector<T>& vals) {
        if (!vals.empty()) {
            data_ = vals.front();
            for (const auto& v : vals) insert(v);
        }
    }
    void insert(const T& val) {
        if (val <= data_) {
            if (left_) left_->insert(val);
            else left_ = std::make_unique<binary_tree>(val);
        } else {
            if (right_) right_->insert(val);
            else right_ = std::make_unique<binary_tree>(val);
        }
        // insert into sorted_ (keep sorted)
        auto it = std::lower_bound(sorted_.begin(), sorted_.end(), val);
        sorted_.insert(it, val);
    }
    T data() const { return data_; }
    binary_tree* left() const { return left_.get(); }
    binary_tree* right() const { return right_.get(); }
