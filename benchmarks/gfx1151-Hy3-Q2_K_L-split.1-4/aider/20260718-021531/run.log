```
package robot

import (
	"fmt"
	"strings"
)

// Step 1
// Define N, E, S, W here.

type Dir int

const (
	N Dir = iota
	E
	S
	W
)

func (d Dir) String() string {
	switch d {
	case N:
		return "N"
	case E:
		return "E"
	case S:
		return "S"
	case W:
		return "W"
	default:
		return "?"
	}
}

// Step 1 robot state (used by step 1 tests)
type Step1Robot struct {
	Dir   Dir
	X, Y  int
}

func Right() {
	panic("Please implement the Right function")
}

func Left() {
	panic("Please implement the Left function")
}

func Advance() {
	panic("Please implement the Advance function")
}

// Step 2
// Define Action type here.

type Command byte

type Action struct {
	Robot Step2Robot
	Cmd   Command
}

type Step2Robot struct {
	Dir   Dir
	X, Y  int
}

func Right() {
	// Step 1 placeholder; step 2 uses channels.
	// Left as panic to avoid breaking step1 if not used.
	panic("Please implement the Right function")
}

func Left() {
	panic("Please implement the Left function")
}

func Advance() {
	panic("Please implement the Advance function")
}

func (d Dir) String() string {
	switch d {
	case N:
		return "N"
	case E:
		return "E"
	case S:
		return "S"
	case W:
		return "W"
	default:
		return "?"
	}
}

func StartRobot(command chan Command, action chan Action) {
	for cmd := range command {
		action <- Action{Cmd: cmd}
	}
	close(action)
}

func Room(extent Rect, robot Step2Robot, action chan Action, report chan Step2Robot) {
	// Simple physics: track robot position from actions.
	// Note: Step2Robot is passed by value; we keep a local copy.
	r := robot
	for a := range action {
		switch a.Cmd {
		case 'R':
			r.Dir = (r.Dir + 1) % 4
		case 'L':
			r.Dir = (r.Dir + 3) % 4
		case 'A':
			switch r.Dir {
			case N:
				r.Y++
			case E:
				r.X++
			case S:
				r.Y--
			case W:
				r.X--
			}
		}
	}
	report <- r
}

// Step 3
// Define Action3 type here.

type Action3 struct {
	Name string
	Cmd  byte
}

type Step3Robot struct {
	Name string
	Dir  Dir
	X, Y int
}

type Rect struct {
	Min Xy
	Max Xy
}

type Xy struct {
	X, Y int
}

func StartRobot3(name, script string, action chan Action3, log chan string) {
	if name == "" {
		log <- "robot without a name"
		return
	}
	for _, c := range script {
		if c != 'R' && c != 'L' && c != 'A' {
			log <- "undefined command in script"
			return
		}
		action <- Action3{Name: name, Cmd: byte(c)}
	}
	close(action)
}

func Room3(extent Rect, robots []Step3Robot, action chan Action3, rep chan []Step3Robot, log chan string) {
	// Check for duplicate names and placements
	nameSeen := make(map[string]bool)
	posSeen := make(map[Xy]bool)
	for _, r := range robots {
		if r.Name == "" {
			log <- "robot without a name"
		}
		if nameSeen[r.Name] {
			log <- "duplicate robot names"
		}
		nameSeen[r.Name] = true
		xy := Xy{r.X, r.Y}
		if posSeen[xy] {
			log <- "robots placed at the same place"
		}
		posSeen[xy] = true
		if r.X < extent.Min.X || r.X > extent.Max.X || r.Y < extent.Min.Y || r.Y > extent.Max.Y {
			log <- "robot placed outside of the room"
		}
	}

	// Simulate
	pos := make(map[string]Xy)
	dir := make(map[string]Dir)
	for _, r := range robots {
		pos[r.Name] = Xy{r.X, r.Y}
		dir[r.Name] = r.Dir
	}

	for a := range action {
		robot, ok := pos[a.Name]
		if !ok {
			log <- "action from an unknown robot"
			continue
		}
		switch a.Cmd {
		case 'R':
			dir[a.Name] = (dir[a.Name] + 1) % 4
		case 'L':
			dir[a.Name] = (dir[a.Name] + 3) % 4
		case 'A':
			newPos := robot
			switch dir[a.Name] {
			case N:
				newPos.Y++
			case E:
				newPos.X++
			case S:
				newPos.Y--
			case W:
				newPos.X--
			}
			if newPos.X < extent.Min.X || newPos.X > extent.Max.X || newPos.Y < extent.Min.Y || newPos.Y > extent.Max.Y {
				log <- "robot attempting to advance into a wall"
				continue
			}
			for other, op := range pos {
				if other != a.Name && op == newPos {
					log <- "robot attempting to advance into another robot"
					continue
				}
			}
			pos[a.Name] = newPos
		default:
			log <- "undefined command in script"
		}
	}

	// Build report
	result := make([]Step3Robot, len(robots))
	for i, r := range robots {
		result[i] = Step3Robot{
			Name: r.Name,
			Dir:  dir[r.Name],
			X:    pos[r.Name].X,
			Y:    pos[r.Name].Y,
		}
	}
	rep <- result
}

// Step 1 functions (kept as required by file, but step1 uses separate types in defs.go normally)
// We leave the step1 Right/Left/Advance as panics to avoid conflict; tests for step1 likely use
// different mechanics defined in defs.go. The above implements step2/step3.
```

