//
// This is the implementation of the 'Rational Numbers' exercise.
//

function gcd(a, b) {
  a = Math.abs(a);
  b = Math.abs(b);
  while (b !== 0) {
    const temp = b;
    b = a % b;
    a = temp;
  }
  return a;
}

class Rational {
  constructor(a, b) {
    this.a = a;
    this.b = b;
    this.reduce();
  }

  add(other) {
    const a1 = this.a;
    const b1 = this.b;
    const a2 = other.a;
    const b2 = other.b;
    const num = a1 * b2 + a2 * b1;
    const den = b1 * b2;
    return new Rational(num, den);
  }

  sub(other) {
    const a1 = this.a;
    const b1 = this.b;
    const a2 = other.a;
    const b2 = other.b;
    const num = a1 * b2 - a2 * b1;
    const den = b1 * b2;
    return new Rational(num, den);
  }

  mul(other) {
    const num = this.a * other.a;
    const den = this.b * other.b;
    return new Rational(num, den);
  }

  div(other) {
    if (other.a === 0) {
      throw new Error('Cannot divide by zero rational');
    }
    const num = this.a * other.b;
    const den = this.b * other.a;
    return new Rational(num, den);
  }

  abs() {
    return new Rational(Math.abs(this.a), Math.abs(this.b));
  }

  exprational(n) {
    if (n >= 0) {
      return new Rational(Math.pow(this.a, n), Math.pow(this.b, n));
    } else {
      const m = Math.abs(n);
      return new Rational(Math.pow(this.b, m), Math.pow(this.a, m));
    }
  }

  expreal(x) {
    return Math.pow(x, this.a) / Math.pow(x, this.b);
  }

  reduce() {
    const g = gcd(this.a, this.b);
    let num = this.a / g;
    let den = this.b / g;
    if (den < 0) {
      num = -num;
      den = -den;
    }
    this.a = num;
    this.b = den;
    return this;
  }
}

module.exports = Rational;
```

This removes the ESM `export` and uses `module.exports`, which should allow the test runner (Jest with CommonJS) to load the class. The `jest: not found` error is environmental, but if tests are run via `npm test` (which uses local jest), this code change ensures module compatibility.
