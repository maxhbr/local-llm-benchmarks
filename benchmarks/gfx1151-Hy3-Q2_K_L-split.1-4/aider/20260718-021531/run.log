            rolls: Vec::new(),
            frame: 0,
            pins_left: 10,
            rolls_in_frame: 0,
            complete: false,
        }
    }

    pub fn roll(&mut self, pins: u16) -> Result<(), Error> {
        if self.complete {
            return Err(Error::GameComplete);
        }
        if pins > self.pins_left {
            return Err(Error::NotEnoughPinsLeft);
        }
        self.rolls.push(pins);
        if self.frame < 9 {
            if self.rolls_in_frame == 0 {
                if pins == 10 {
                    self.frame += 1;
                    self.pins_left = 10;
                    self.rolls_in_frame = 0;
                } else {
                    self.pins_left -= pins;
                    self.rolls_in_frame += 1;
                }
            } else {
                self.frame += 1;
                self.pins_left = 10;
                self.rolls_in_frame = 0;
            }
        } else {
            // 10th frame
            if self.rolls_in_frame == 0 {
                if pins == 10 {
                    self.pins_left = 10;
                    self.rolls_in_frame = 1;
                } else {
                    self.pins_left -= pins;
                    self.rolls_in_frame = 1;
                }
            } else if self.rolls_in_frame == 1 {
                if self.rolls[self.rolls.len() - 2] == 10 {
                    // first was strike
                    if pins == 10 {
                        self.pins_left = 10;
                    } else {
                        self.pins_left -= pins;
                    }
                    self.rolls_in_frame = 2;
                } else {
                    // second roll of 10th (non-strike first)
                    if self.rolls[self.rolls.len() - 2] + pins == 10 {
                        // spare, need fill
                        self.pins_left = 10;
                        self.rolls_in_frame = 2;
                    } else {
                        self.complete = true;
                    }
                }
            } else if self.rolls_in_frame == 2 {
                // fill ball done
                self.complete = true;
            }
        }
        Ok(())
    }

    pub fn score(&self) -> Option<u16> {
        if !self.complete {
            return None;
        }
        let r = &self.rolls;
        let mut total = 0;
        let mut i = 0;
        for frame in 0..10 {
            if frame < 9 {
                if r[i] == 10 {
                    total += 10 + r[i + 1] + r[i + 2];
