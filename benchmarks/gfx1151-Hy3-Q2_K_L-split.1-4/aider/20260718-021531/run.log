use std::time::{SystemTime, UNIX_EPOCH};



fn shift(c: char, key_offset: i32) -> char {

    if !c.is_ascii_lowercase() {

        return c;

    }

    let base = b'a';

    let shifted = (c as u8 as i32 - base as i32 + key_offset).rem_euclid(26) as u8;

    (base + shifted) as char

}



pub fn encode(key: &str, s: &str) -> Option<String> {

    if key.is_empty() || !key.chars().all(|c| c.is_ascii_lowercase()) {

        return None;

    }

    let encoded: String = s

        .chars()

        .zip(key.chars().cycle())

        .map(|(c, k)| shift(c, (k as u8 - b'a') as i32))

        .collect();

    Some(encoded)

}



pub fn decode(key: &str, s: &str) -> Option<String> {

    if key.is_empty() || !key.chars().all(|c| c.is_ascii_lowercase()) {

        return None;

    }

    let decoded: String = s

        .chars()

        .zip(key.chars().cycle())

        .map(|(c, k)| shift(c, -((k as u8 - b'a') as i32)))

        .collect();

    Some(decoded)

}



pub fn encode_random(s: &str) -> (String, String) {

    // Simple LCG seeded with current time

    let seed = SystemTime::now()

        .duration_since(UNIX_EPOCH)

        .unwrap()

        .as_nanos() as u64;

    let mut state = seed.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);

    let mut key = String::new();

    for _ in 0..100 {

        state = state.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);

        let ch = (b'a' + ((state % 26) as u8)) as char;

        key.push(ch);

    }

    let encoded = encode(&key, s).unwrap_or_default();

    (key, encoded)

}

