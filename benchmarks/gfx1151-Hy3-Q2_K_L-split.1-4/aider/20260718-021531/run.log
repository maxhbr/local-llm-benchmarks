import java.math.BigInteger;

public class AffineCipher {
    
    private static final int M = 26;
    private static final int GROUP_SIZE = 5;

    private boolean areCoprime(int a, int b) {
        return BigInteger.valueOf(a).gcd(BigInteger.valueOf(b)).intValue() == 1;
    }

    private int mod(int x, int m) {
        int r = x % m;
        if (r < 0) r += m;
        return r;
    }

    private int modularMultiplicativeInverse(int a, int m) {
        // find x such that (a * x) % m == 1
        for (int x = 1; x < m; x++) {
            if (mod(a * x, m) == 1) {
                return x;
            }
        }
        throw new IllegalArgumentException("No modular multiplicative inverse exists.");
    }

    public String encode(String text, int coefficient1, int coefficient2) {
        if (!areCoprime(coefficient1, M)) {
            throw new IllegalArgumentException("coefficient1 and m must be coprime.");
        }
        StringBuilder prepared = new StringBuilder();
        for (char c : text.toLowerCase().toCharArray()) {
            if (Character.isLetter(c)) {
                int i = c - 'a';
                int y = mod(coefficient1 * i + coefficient2, M);
                prepared.append((char) ('a' + y));
            } else if (Character.isDigit(c)) {
                prepared.append(c);
            }
            // spaces and punctuation are excluded
        }
        // group into blocks of GROUP_SIZE separated by space
        StringBuilder grouped = new StringBuilder();
        for (int i = 0; i < prepared.length(); i++) {
            if (i > 0 && i % GROUP_SIZE == 0) {
                grouped.append(' ');
            }
            grouped.append(prepared.charAt(i));
        }
        return grouped.toString();
    }

    public String decode(String text, int coefficient1, int coefficient2) {
        if (!areCoprime(coefficient1, M)) {
            throw new IllegalArgumentException("coefficient1 and m must be coprime.");
        }
        int mmi = modularMultiplicativeInverse(coefficient1, M);
        StringBuilder decoded = new StringBuilder();
        // remove spaces from ciphertext
        String cleaned = text.replaceAll(" ", "");
        for (char c : cleaned.toCharArray()) {
            if (Character.isDigit(c)) {
                decoded.append(c);
            } else if (Character.isLetter(c)) {
                int y = c - 'a';
                int i = mod(mmi * (y - coefficient2), M);
                decoded.append((char) ('a' + i));
            }
        }
        return decoded.toString();
    }
}
