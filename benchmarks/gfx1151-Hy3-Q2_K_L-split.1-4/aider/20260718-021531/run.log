package wordsearch

import (
	"errors"
	"fmt"
)

func Solve(words []string, puzzle []string) (map[string][2][2]int, error) {
	result := make(map[string][2][2]int)
	rows := len(puzzle)
	if rows == 0 {
		return nil, errors.New("empty puzzle")
	}
	cols := len(puzzle[0])

	// directions: dr, dc
	dirs := [][2]int{
		{0, 1},   // right
		{0, -1},  // left
		{1, 0},   // down
		{-1, 0},  // up
		{1, 1},   // down-right
		{-1, -1}, // up-left
		{1, -1},  // down-left
		{-1, 1},  // up-right
	}

	for _, word := range words {
		found := false
		wordRunes := []rune(word)
		wl := len(wordRunes)
		if wl == 0 {
			continue
		}
		for r := 0; r < rows; r++ {
			for c := 0; c < cols; c++ {
				if puzzle[r][c] == byte(wordRunes[0]) {
					for _, d := range dirs {
						dr, dc := d[0], d[1]
						// check bounds
						endR := r + (wl-1)*dr
						endC := c + (wl-1)*dc
						if endR < 0 || endR >= rows || endC < 0 || endC >= cols {
							continue
						}
						// verify word
						match := true
						for i := 0; i < wl; i++ {
							rr := r + i*dr
							cc := c + i*dc
							if puzzle[rr][cc] != byte(wordRunes[i]) {
								match = false
								break
							}
						}
						if match {
							result[word] = [2][2]int{{r, c}, {endR, endC}}
							found = true
							break
						}
					}
					if found {
						break
					}
				}
			}
			if found {
				break
			}
		}
		if !found {
			return nil, fmt.Errorf("word %q not found", word)
		}
	}
	return result, nil
}
