    public Winner computeWinner() {
        // Check O: top to bottom
        if (hasPath('O', true)) {
            return Winner.O;
        }
        // Check X: left to right
        if (hasPath('X', false)) {
            return Winner.X;
        }
        return Winner.NONE;
    }

    private boolean hasPath(char player, boolean vertical) {
        boolean[][] visited = new boolean[rows][cols];
        Queue<int[]> queue = new ArrayDeque<>();
        if (vertical) {
            // O: start from top row
            for (int c = 0; c < cols; c++) {
                if (grid[0][c] == player) {
                    queue.add(new int[]{0, c});
                    visited[0][c] = true;
                }
            }
        } else {
            // X: start from left column
            for (int r = 0; r < rows; r++) {
                if (grid[r][0] == player) {
                    queue.add(new int[]{r, 0});
                    visited[r][0] = true;
                }
            }
        }

        int[][] dirs = {
            {-1, 0}, {1, 0}, {0, -1}, {0, 1},
            {-1, 1}, {1, -1}
        };

        while (!queue.isEmpty()) {
            int[] cur = queue.poll();
            int r = cur[0], c = cur[1];
            if (vertical && r == rows - 1) return true;
            if (!vertical && c == cols - 1) return true;
            for (int[] d : dirs) {
                int nr = r + d[0], nc = c + d[1];
                if (nr >= 0 && nr < rows && nc >= 0 && nc < cols
                        && !visited[nr][nc] && grid[nr][nc] == player) {
                    visited[nr][nc] = true;
                    queue.add(new int[]{nr, nc});
                }
            }
        }
        return false;
    }
}

enum Winner {
    O, X, NONE
}
