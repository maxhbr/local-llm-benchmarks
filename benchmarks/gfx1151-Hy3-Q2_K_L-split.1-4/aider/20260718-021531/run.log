def transpose(text):

    if not text:

        return ""

    rows = text.splitlines()

    max_len = max(len(row) for row in rows)

    padded_rows = [row.ljust(max_len) for row in rows]

    transposed_rows = []

    for j in range(max_len):

        transposed_row = "".join(padded_rows[i][j] for i in range(len(padded_rows)))

        transposed_rows.append(transposed_row.rstrip())

    return "\n".join(transposed_rows)

```

