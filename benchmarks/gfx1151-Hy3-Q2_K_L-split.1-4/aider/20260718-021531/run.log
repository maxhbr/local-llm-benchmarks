```
//
// This is only a SKELETON file for the 'Phone Number' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export const clean = (input) => {
  // Remove all non-digit characters
  let digits = input.replace(/\D/g, '');

  // If the number starts with country code '1', remove it (only if length is 11)
  if (digits.length === 11 && digits[0] === '1') {
    digits = digits.slice(1);
  }

  // Validate length and NXX NXX-XXXX rules
  if (digits.length !== 10) {
    throw new Error('Invalid phone number');
  }

  const areaCodeFirst = digits[0];
  const exchangeCodeFirst = digits[3];

  if (areaCodeFirst < '2' || areaCodeFirst > '9') {
    throw new Error('Invalid area code');
  }

  if (exchangeCodeFirst < '2' || exchangeCodeFirst > '9') {
    throw new Error('Invalid exchange code');
  }

  return digits;
};
```
