package zebra

import (
	"sort"
)

type Solution struct {
	DrinksWater string
	OwnsZebra   string
}

type house struct {
	color    string
	national string
	pet      string
	drink    string
	smoke    string
}

func permutations(arr []string) [][]string {
	var result [][]string
	var permute func([]string, int)
	permute = func(a []string, k int) {
		if k == len(a) {
			result = append(result, append([]string{}, a...))
			return
		}
		for i := k; i < len(a); i++ {
			a[k], a[i] = a[i], a[k]
			permute(a, k+1)
			a[k], a[i] = a[i], a[k]
		}
	}
	permute(arr, 0)
	return result
}

func SolvePuzzle() Solution {
	colors := []string{"Red", "Green", "Ivory", "Yellow", "Blue"}
	nationals := []string{"Englishman", "Spaniard", "Ukrainian", "Norwegian", "Japanese"}
	pets := []string{"Dog", "Snails", "Fox", "Horse", "Zebra"}
	drinks := []string{"Coffee", "Tea", "Milk", "OrangeJuice", "Water"}
	smokes := []string{"OldGold", "Kools", "Chesterfields", "LuckyStrike", "Parliaments"}

	colorPerms := permutations(colors)
	nationalPerms := permutations(nationals)
	petPerms := permutations(pets)
	drinkPerms := permutations(drinks)
	smokePerms := permutations(smokes)

	for _, cp := range colorPerms {
		// Green immediately right of Ivory
		ivoryIdx := indexOf(cp, "Ivory")
		if ivoryIdx == -1 || ivoryIdx == 4 {
			continue
		}
		if cp[ivoryIdx+1] != "Green" {
			continue
		}
		// Blue next to Norwegian (Norwegian handled later)
		for _, np := range nationalPerms {
			norIdx := indexOf(np, "Norwegian")
			if norIdx != 0 {
				continue // statement 10: first house
			}
			// Norwegian next to blue (statement 15)
			if !((norIdx > 0 && cp[norIdx-1] == "Blue") || (norIdx < 4 && cp[norIdx+1] == "Blue")) {
				continue
			}
			// Englishman in red (statement 2)
			engIdx := indexOf(np, "Englishman")
			if engIdx == -1 || cp[engIdx] != "Red" {
				continue
			}
			// Spaniard owns dog (statement 3) checked with pets
			// Ukrainian drinks tea (statement 5) checked with drinks
			// Japanese smokes Parliaments (statement 14) checked with smokes
			for _, pp := range petPerms {
				spaIdx := indexOf(np, "Spaniard")
				if spaIdx == -1 || pp[spaIdx] != "Dog" {
					continue
				}
				// Kools next to horse (statement 12) checked with smokes
				// Chesterfields next to fox (statement 11) checked with smokes
				for _, dp := range drinkPerms {
					if dp[2] != "Milk" { // statement 9: middle house
						continue
					}
					// Coffee in green (statement 4)
					greenIdx := indexOf(cp, "Green")
					if greenIdx == -1 || dp[greenIdx] != "Coffee" {
						continue
					}
					// Ukrainian drinks tea (statement 5)
					ukrIdx := indexOf(np, "Ukrainian")
					if ukrIdx == -1 || dp[ukrIdx] != "Tea" {
						continue
					}
					// LuckyStrike drinks orange juice (statement 13)
					for _, smp := range smokePerms {
						lsIdx := indexOf(smp, "LuckyStrike")
						if lsIdx == -1 || dp[lsIdx] != "OrangeJuice" {
							continue
						}
						// Kools in yellow (statement 8)
						yellowIdx := indexOf(cp, "Yellow")
						koolsIdx := indexOf(smp, "Kools")
						if yellowIdx == -1 || koolsIdx == -1 || yellowIdx != koolsIdx {
							continue
						}
						// OldGold owns snails (statement 7)
						ogIdx := indexOf(smp, "OldGold")
						if ogIdx == -1 || pp[ogIdx] != "Snails" {
							continue
						}
						// Japanese smokes Parliaments (statement 14)
						jpIdx := indexOf(np, "Japanese")
						if jpIdx == -1 || smp[jpIdx] != "Parliaments" {
							continue
						}
						// Chesterfields next to fox (statement 11)
						cfIdx := indexOf(smp, "Chesterfields")
						foxIdx := indexOf(pp, "Fox")
						if cfIdx == -1 || foxIdx == -1 || abs(cfIdx-foxIdx) != 1 {
							continue
						}
						// Kools next to horse (statement 12)
						horseIdx := indexOf(pp, "Horse")
						if koolsIdx == -1 || horseIdx == -1 || abs(koolsIdx-horseIdx) != 1 {
							continue
						}
						// All constraints satisfied; find water drinker and zebra owner
						waterIdx := indexOf(dp, "Water")
						zebraIdx := indexOf(pp, "Zebra")
						return Solution{
							DrinksWater: np[waterIdx],
							OwnsZebra:   np[zebraIdx],
						}
					}
				}
			}
		}
	}
	// Should never reach here for valid puzzle
	return Solution{}
}

func indexOf(arr []string, s string) int {
	for i, v := range arr {
		if v == s {
