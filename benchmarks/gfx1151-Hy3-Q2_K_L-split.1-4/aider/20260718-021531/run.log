package cryptosquare

import (
	"math"
	"strings"
	"unicode"
)

func Encode(pt string) string {
	// Normalize: remove punctuation/spaces, down-case
	var norm []rune
	for _, r := range pt {
		if unicode.IsLetter(r) || unicode.IsDigit(r) {
			norm = append(norm, unicode.ToLower(r))
		}
	}
	length := len(norm)
	if length == 0 {
		return ""
	}

	// Determine c and r
	c := int(math.Ceil(math.Sqrt(float64(length))))
	r := (length + c - 1) / c
	for !(c >= r && c-r <= 1) {
		c++
		r = (length + c - 1) / c
	}

	// Build encoded by reading columns
	var sb strings.Builder
	for col := 0; col < c; col++ {
		for row := 0; row < r; row++ {
			idx := row*c + col
			if idx < length {
				sb.WriteRune(norm[idx])
			}
		}
	}
	encoded := sb.String()

	// Chunks of r length, c chunks, separated by spaces, pad last n chunks with space
	chunks := make([]string, c)
	for col := 0; col < c; col++ {
		start := col * r
		end := start + r
		if end > len(encoded) {
			end = len(encoded)
		}
		chunk := encoded[start:end]
		if len(chunk) < r {
			chunk += strings.Repeat(" ", r-len(chunk))
		}
		chunks[col] = chunk
	}

	return strings.Join(chunks, " ")
}
