package react

// Interfaces as implied by the method signatures and return types.
type Canceler interface {
	Cancel()
}

type Cell interface {
	Value() int
}

type InputCell interface {
	Cell
	SetValue(value int)
}

type ComputeCell interface {
	Cell
	AddCallback(callback func(int)) Canceler
}

type Reactor interface {
	CreateInput(initial int) InputCell
	CreateCompute1(dep Cell, compute func(int) int) ComputeCell
	CreateCompute2(dep1, dep2 Cell, compute func(int, int) int) ComputeCell
}

type canceler struct {
	remove func()
}

func (c *canceler) Cancel() {
	c.remove()
}

type cell struct {
	reactor     *reactor
	value       int
	compute     func() int
	callbacks   []func(int)
	dependents  []*cell
	isInput     bool
}

func (c *cell) Value() int {
	return c.value
}

func (c *cell) SetValue(value int) {
	if c.isInput {
		c.value = value
		c.reactor.propagate()
	}
}

func (c *cell) AddCallback(callback func(int)) Canceler {
	c.callbacks = append(c.callbacks, callback)
	cb := callback
	remove := func() {
		for i, cbx := range c.callbacks {
			if cbx == cb {
				c.callbacks = append(c.callbacks[:i], c.callbacks[i+1:]...)
				break
			}
		}
	}
	return &canceler{remove: remove}
}

func (c *cell) update() {
	if !c.isInput && c.compute != nil {
		newVal := c.compute()
		if newVal != c.value {
			c.value = newVal
			for _, dep := range c.dependents {
				dep.update()
			}
		}
	}
}

func (c *cell) notify() {
	// notify only if value changed from last stable? We track lastStable in reactor.
}

type reactor struct {
	cells []*cell
}

func New() Reactor {
	return &reactor{}
}

func (r *reactor) CreateInput(initial int) InputCell {
	c := &cell{
		reactor: r,
		value:   initial,
		isInput: true,
	}
	r.cells = append(r.cells, c)
	return c
}

func (r *reactor) CreateCompute1(dep Cell, compute func(int) int) ComputeCell {
	depCell := dep.(*cell)
	c := &cell{
		reactor: r,
		compute: func() int {
			return compute(dep.Value())
		},
	}
	c.value = c.compute()
	depCell.dependents = append(depCell.dependents, c)
	r.cells = append(r.cells, c)
	return c
}

func (r *reactor) CreateCompute2(dep1, dep2 Cell, compute func(int, int) int) ComputeCell {
	d1 := dep1.(*cell)
	d2 := dep2.(*cell)
	c := &cell{
		reactor: r,
		compute: func() int {
			return compute(d1.Value(), d2.Value())
		},
	}
	c.value = c.compute()
	d1.dependents = append(d1.dependents, c)
	d2.dependents = append(d2.dependents, c)
	r.cells = append(r.cells, c)
	return c
}

func (r *reactor) propagate() {
	// Update all compute cells in order (simplified: repeated update until stable)
	for _, c := range r.cells {
		c.update()
	}
	// Notify callbacks for cells whose value changed from previous stable state
	// We'll track previous values via a map in reactor for simplicity.
