pub fn answer(command: &str) -> Option<i32> {

    let command = command.trim_end_matches('?').trim();

    if !command.starts_with("What is ") {

        return None;

    }

    let body = &command["What is ".len()..];

    if body.is_empty() {

        return None;

    }

    let mut parts = body.split_whitespace();

    let first = parts.next()?;

    let mut acc = first.parse::<i32>().ok()?;



    let tokens: Vec<&str> = parts.collect();

    let mut i = 0;

    while i < tokens.len() {

        let op = tokens[i];

        if op == "plus" {

            i += 1;

            let num = tokens.get(i)?.parse::<i32>().ok()?;

            acc += num;

        } else if op == "minus" {

            i += 1;

            let num = tokens.get(i)?.parse::<i32>().ok()?;

            acc -= num;

        } else if op == "multiplied" {

            if tokens.get(i + 1)? == "by" {

                i += 2;

                let num = tokens.get(i)?.parse::<i32>().ok()?;

                acc *= num;

            } else {

                return None;

            }

        } else if op == "divided" {

            if tokens.get(i + 1)? == "by" {

                i += 2;

                let num = tokens.get(i)?.parse::<i32>().ok()?;

                acc /= num;

            } else {

                return None;

            }

        } else {

            return None;

        }

        i += 1;

    }

    Some(acc)

