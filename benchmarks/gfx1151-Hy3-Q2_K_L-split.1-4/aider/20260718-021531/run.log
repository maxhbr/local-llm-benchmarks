PalindromeCalculator.java
```
import java.util.ArrayList;
import java.util.List;
import java.util.SortedMap;
import java.util.TreeMap;

class PalindromeCalculator {

    SortedMap<Long, List<List<Integer>>> getPalindromeProductsWithFactors(int minFactor, int maxFactor) {
        if (minFactor > maxFactor) {
            throw new IllegalArgumentException("minFactor must be less than or equal to maxFactor");
        }

        long smallest = -1;
        long largest = -1;

        // Find smallest and largest palindrome products in range
        for (int i = minFactor; i <= maxFactor; i++) {
            for (int j = i; j <= maxFactor; j++) {
                long product = (long) i * j;
                if (isPalindrome(product)) {
                    if (smallest == -1 || product < smallest) {
                        smallest = product;
                    }
                    if (largest == -1 || product > largest) {
                        largest = product;
                    }
                }
            }
        }

        SortedMap<Long, List<List<Integer>>> result = new TreeMap<>();

        if (smallest != -1) {
            result.put(smallest, getFactorsForProduct(smallest, minFactor, maxFactor));
        }
        if (largest != -1 && largest != smallest) {
            result.put(largest, getFactorsForProduct(largest, minFactor, maxFactor));
        }

        return result;
    }

    private boolean isPalindrome(long number) {
        String s = Long.toString(number);
        int left = 0;
        int right = s.length() - 1;
        while (left < right) {
            if (s.charAt(left) != s.charAt(right)) {
                return false;
            }
            left++;
            right--;
        }
        return true;
    }

    private List<List<Integer>> getFactorsForProduct(long product, int minFactor, int maxFactor) {
        List<List<Integer>> factors = new ArrayList<>();
        // Only need to check up to sqrt to avoid duplicate pairs
        for (int i = minFactor; i <= maxFactor && (long) i * i <= product; i++) {
            if (product % i == 0) {
                long other = product / i;
                if (other >= minFactor && other <= maxFactor) {
                    int otherInt = (int) other;
                    List<Integer> pair = new ArrayList<>();
                    pair.add(i);
                    pair.add(otherInt);
                    factors.add(pair);
                }
            }
        }
        return factors;
    }

}
```

Note: The Gradle wrapper error (`ClassNotFoundException: org.gradle.wrapper.GradleWrapperMain`) typically means the `gradle/wrapper/gradle-wrapper.jar` is missing or corrupted in your project, not a problem with this Java file. You may need to re-download the wrapper jar or run `gradle wrapper` to fix the build environment. The code above is correct for the palindrome task.
