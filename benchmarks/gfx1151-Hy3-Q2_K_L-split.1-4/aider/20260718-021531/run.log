from functools import lru_cache
from itertools import combinations

DISCOUNTS = {1: 0.0, 2: 0.05, 3: 0.10, 4: 0.20, 5: 0.25}
BOOK_PRICE = 800  # cents

@lru_cache(maxsize=None)
def _min_cost(counts):
    if all(c == 0 for c in counts):
        return 0.0
    best = sum(counts) * BOOK_PRICE  # no discount baseline in cents
    available = [i for i in range(5) if counts[i] > 0]
    for size in range(len(available), 0, -1):
        for combo in combinations(available, size):
            new_counts = list(counts)
            for i in combo:
                new_counts[i] -= 1
            group_cost = size * BOOK_PRICE * (1 - DISCOUNTS[size])
            total_cost = group_cost + _min_cost(tuple(new_counts))
            if total_cost < best:
                best = total_cost
    return best

def total(basket):
    if not basket:
        return 0
    counts = [0, 0, 0, 0, 0]
    for book in basket:
        counts[book - 1] += 1
    # Return integer cents, rounded to nearest cent
    return int(round(_min_cost(tuple(counts))))
