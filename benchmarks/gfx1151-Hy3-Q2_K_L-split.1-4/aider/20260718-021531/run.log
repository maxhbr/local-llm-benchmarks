dominoes.go
```
package dominoes

// Domino represents a domino stone with two numbers.
type Domino [2]int

// MakeChain attempts to construct a legal chain of dominoes.
// It returns the chain and true if successful, otherwise nil and false.
func MakeChain(input []Domino) (chain []Domino, ok bool) {
	if len(input) == 0 {
		return []Domino{}, true
	}
	if len(input) == 1 {
		if input[0][0] == input[0][1] {
			return input, true
		}
		return nil, false
	}

	used := make([]bool, len(input))
	var current []Domino

	// Try each domino as the starting point, in both orientations.
	for i := 0; i < len(input); i++ {
		for flip := 0; flip < 2; flip++ {
			used[i] = true
			if flip == 0 {
				current = append(current, input[i])
			} else {
				current = append(current, Domino{input[i][1], input[i][0]})
			}
			if backtrack(input, used, current, &chain) {
				return chain, true
			}
			current = current[:len(current)-1]
			used[i] = false
		}
	}

	return nil, false
}

func backtrack(input []Domino, used []bool, current []Domino, chain *[]Domino) bool {
	if len(current) == len(input) {
		// All dominoes used; check if first and last match.
		first := current[0][0]
		last := current[len(current)-1][1]
		if first == last {
			*chain = append([]Domino{}, current...)
			return true
		}
		return false
	}

	lastVal := current[len(current)-1][1]
	for i := 0; i < len(input); i++ {
		if used[i] {
			continue
		}
		// Try without flip.
		if input[i][0] == lastVal {
			used[i] = true
			current = append(current, input[i])
			if backtrack(input, used, current, chain) {
				return true
			}
			current = current[:len(current)-1]
			used[i] = false
		}
		// Try with flip.
		if input[i][1] == lastVal {
			used[i] = true
			current = append(current, Domino{input[i][1], input[i][0]})
			if backtrack(input, used, current, chain) {
				return true
			}
			current = current[:len(current)-1]
			used[i] = false
		}
	}
	return false
}
