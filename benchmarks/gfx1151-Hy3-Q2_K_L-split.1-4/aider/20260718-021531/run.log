from collections import deque

def measure(bucket_one, bucket_two, goal, start_bucket):
    def gcd(a, b):
        while b:
            a, b = b, a % b
        return a

    if goal > max(bucket_one, bucket_two):
        raise ValueError("Goal cannot be greater than the size of both buckets.")
    if goal % gcd(bucket_one, bucket_two) != 0:
        raise ValueError("Goal must be a multiple of the greatest common divisor of the bucket sizes.")
    if start_bucket not in ('one', 'two'):
        raise ValueError("start_bucket must be either 'one' or 'two'.")

    # initial fill
    if start_bucket == 'one':
        start_state = (bucket_one, 0)
        start_idx = 0  # bucket one is start
    else:
        start_state = (0, bucket_two)
        start_idx = 1

    # BFS
    queue = deque()
    queue.append((start_state[0], start_state[1], 1))  # (b1, b2, actions)
    visited = set()
    visited.add((start_state[0], start_state[1]))

    while queue:
        b1, b2, actions = queue.popleft()

        if b1 == goal:
            return (actions, 'one', b2)
        if b2 == goal:
            return (actions, 'two', b1)

        # generate next states
        next_states = []
        # fill bucket one
        next_states.append((bucket_one, b2))
        # fill bucket two
        next_states.append((b1, bucket_two))
        # empty bucket one
        next_states.append((0, b2))
        # empty bucket two
        next_states.append((b1, 0))
        # pour one to two
        transfer = min(b1, bucket_two - b2)
        next_states.append((b1 - transfer, b2 + transfer))
        # pour two to one
        transfer = min(b2, bucket_one - b1)
        next_states.append((b1 + transfer, b2 - transfer))

        for nb1, nb2 in next_states:
            if nb1 < 0 or nb2 < 0 or nb1 > bucket_one or nb2 > bucket_two:
                continue
            # forbidden state check
            if start_bucket == 'one' and nb1 == 0 and nb2 == bucket_two:
                continue
            if start_bucket == 'two' and nb2 == 0 and nb1 == bucket_one:
                continue
            if (nb1, nb2) not in visited:
                visited.add((nb1, nb2))
                queue.append((nb1, nb2, actions + 1))

    raise ValueError("Unable to reach goal with given bucket sizes.")
