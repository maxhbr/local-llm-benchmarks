tree_building.py
```
class Record:
    def __init__(self, record_id, parent_id):
        self.record_id = record_id
        self.parent_id = parent_id


class Node:
    def __init__(self, node_id):
        self.node_id = node_id
        self.children = []


def BuildTree(records):
    if not records:
        return None

    # Sort records by record_id
    records.sort(key=lambda x: x.record_id)

    # Validate contiguous IDs from 0 to n-1
    expected_id = 0
    for rec in records:
        if rec.record_id != expected_id:
            raise ValueError('Record IDs must be contiguous starting from 0')
        expected_id += 1

    # Validate root and parent relationships
    for rec in records:
        if rec.record_id == 0:
            if rec.parent_id != 0:
                raise ValueError('Root record (ID 0) must have parent_id 0')
        else:
            if rec.parent_id >= rec.record_id:
                raise ValueError('Parent ID must be lower than record ID')
            if rec.parent_id < 0:
                raise ValueError('Parent ID must not be negative')

    # Create nodes for each record
    nodes = {}
    for rec in records:
        nodes[rec.record_id] = Node(rec.record_id)

    # Attach children to parents
    for rec in records:
        if rec.record_id != 0:
            parent_node = nodes[rec.parent_id]
            parent_node.children.append(nodes[rec.record_id])

    # Root is node 0
    return nodes[0]
```

This refactored version is faster, clearer, and raises `ValueError` with meaningful messages for invalid input as instructed.
