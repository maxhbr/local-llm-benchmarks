@@ -1,5 +1,54 @@
 #include "kindergarten_garden.h"
+
+#include <map>
+#include <vector>
+#include <string>
 
 namespace kindergarten_garden {
 
+namespace {
+const std::vector<std::string> children = {
+    "Alice", "Bob", "Charlie", "David", "Eve", "Fred",
+    "Ginny", "Harriet", "Ileana", "Joseph", "Kincaid", "Larry"
+};
+
+const std::map<char, std::string> plant_names = {
+    {'G', "grass"},
+    {'C', "clover"},
+    {'R', "radish"},
+    {'V', "violet"}
+};
+}  // namespace
+
+std::vector<std::string> plants(const std::string& diagram, const 
std::string& child) {
+    // Find child index
+    int index = -1;
+    for (int i = 0; i < static_cast<int>(children.size()); ++i) {
+        if (children[i] == child) {
+            index = i;
+            break;
+        }
+    }
+    if (index == -1) return {};
+
+    // Diagram is two rows concatenated: first row length = 
diagram.size()/2
+    size_t row_length = diagram.size() / 2;
+    size_t first_row_start = index * 2;
+    size_t second_row_start = row_length + index * 2;
+
+    std::vector<std::string> result;
+    // Get four plants: two from first row, two from second row
+    char c1 = diagram[first_row_start];
+    char c2 = diagram[first_row_start + 1];
+    char c3 = diagram[second_row_start];
+    char c4 = diagram[second_row_start + 1];
+
+    result.push_back(plant_names.at(c1));
+    result.push_back(plant_names.at(c2));
+    result.push_back(plant_names.at(c3));
+    result.push_back(plant_names.at(c4));
+
+    return result;
+}
+
 }  // namespace kindergarten_garden
```



