#include "yacht.h"

#include <algorithm>
#include <vector>

namespace yacht {

int score(const std::vector<int>& dice, Category category) {
    // Count occurrences of each face (1-6)
    int counts[7] = {0};
    for (int d : dice) {
        if (d >= 1 && d <= 6) counts[d]++;
    }

    switch (category) {
        case Category::Ones:
            return counts[1] * 1;
        case Category::Twos:
            return counts[2] * 2;
        case Category::Threes:
            return counts[3] * 3;
        case Category::Fours:
            return counts[4] * 4;
        case Category::Fives:
            return counts[5] * 5;
        case Category::Sixes:
            return counts[6] * 6;
        case Category::FullHouse: {
            bool hasThree = false;
            bool hasTwo = false;
            for (int i = 1; i <= 6; ++i) {
                if (counts[i] == 3) hasThree = true;
                if (counts[i] == 2) hasTwo = true;
            }
            if (hasThree && hasTwo) {
                int total = 0;
                for (int d : dice) total += d;
                return total;
            }
            return 0;
        }
        case Category::FourOfAKind: {
            for (int i = 1; i <= 6; ++i) {
                if (counts[i] >= 4) {
                    return i * 4;
                }
            }
            return 0;
        }
        case Category::LittleStraight: {
            bool isLittle = true;
            for (int i = 1; i <= 5; ++i) {
                if (counts[i] != 1) isLittle = false;
            }
            if (isLittle && counts[6] == 0) return 30;
            return 0;
        }
        case Category::BigStraight: {
            bool isBig = true;
            for (int i = 2; i <= 6; ++i) {
                if (counts[i] != 1) isBig = false;
            }
            if (isBig && counts[1] == 0) return 30;
            return 0;
        }
        case Category::Choice: {
            int total = 0;
            for (int d : dice) total += d;
            return total;
        }
        case Category::Yacht: {
            for (int i = 1; i <= 6; ++i) {
                if (counts[i] == 5) return 50;
            }
            return 0;
        }
    }
    return 0;
}

}  // namespace yacht
```
