import java.util.Arrays;

class ZebraPuzzle {
    private static String waterDrinker;
    private static String zebraOwner;

    static {
        solvePuzzle();
    }

    String getWaterDrinker() {
        return waterDrinker;
    }

    String getZebraOwner() {
        return zebraOwner;    }

    private static void solvePuzzle() {
        String[] colors = {"red", "green", "ivory", "yellow", "blue"};
        String[] nations = {"English", "Spanish", "Ukrainian", "Norwegian", "Japanese"};
        String[] pets = {"dog", "snail", "fox", "horse", "zebra"};
        String[] drinks = {"coffee", "tea", "milk", "orange juice", "water"};
        String[] hobbies = {"dancing", "painting", "reading", "football", "chess"};

        String[] colorAssign = new String[5];
        String[] nationAssign = new String[5];
        String[] petAssign = new String[5];
        String[] drinkAssign = new String[5];
        String[] hobbyAssign = new String[5];

        boolean[] colorUsed = new boolean[5];
        boolean[] nationUsed = new boolean[5];
        boolean[] petUsed = new boolean[5];
        boolean[] drinkUsed = new boolean[5];
        boolean[] hobbyUsed = new boolean[5];

        backtrack(0, colors, nations, pets, drinks, hobbies,
                colorAssign, nationAssign, petAssign, drinkAssign, hobbyAssign,
                colorUsed, nationUsed, petUsed, drinkUsed, hobbyUsed);
    }

    private static boolean backtrack(int house,
                                     String[] colors, String[] nations, String[] pets, String[] drinks, String[] hobbies,
                                     String[] colorAssign, String[] nationAssign, String[] petAssign, String[] drinkAssign, String[] hobbyAssign,
                                     boolean[] colorUsed, boolean[] nationUsed, boolean[] petUsed, boolean[] drinkUsed, boolean[] hobbyUsed) {
        if (house == 5) {
            if (checkAll(colorAssign, nationAssign, petAssign, drinkAssign, hobbyAssign)) {
                for (int i = 0; i < 5; i++) {
                    if ("water".equals(drinkAssign[i])) {
                        waterDrinker = nationAssign[i];
                    }
                    if ("zebra".equals(petAssign[i])) {
                        zebraOwner = nationAssign[i];
                    }
                }
                return true;
            }
            return false;
        }

        for (int c = 0; c < 5; c++) {
            if (!colorUsed[c]) {
                colorUsed[c] = true;
                colorAssign[house] = colors[c];
                for (int n = 0; n < 5; n++) {
                    if (!nationUsed[n]) {
                        nationUsed[n] = true;
                        nationAssign[house] = nations[n];
                        for (int p = 0; p < 5; p++) {
                            if (!petUsed[p]) {
                                petUsed[p] = true;
                                petAssign[house] = pets[p];
                                for (int d = 0; d < 5; d++) {
                                    if (!drinkUsed[d]) {
                                        drinkUsed[d] = true;
                                        drinkAssign[house] = drinks[d];
                                        for (int h = 0; h < 5; h++) {
                                            if (!hobbyUsed[h]) {
                                                hobbyUsed[h] = true;
                                                hobbyAssign[house] = hobbies[h];

                                                if (backtrack(house + 1, colors, nations, pets, drinks, hobbies,
                                                        colorAssign, nationAssign, petAssign, drinkAssign, hobbyAssign,
                                                        colorUsed, nationUsed, petUsed, drinkUsed, hobbyUsed)) {
                                                    return true;
                                                }

                                                hobbyUsed[h] = false;
                                            }
                                        }
                                        drinkUsed[d] = false;
                                    }
                                }
                                petUsed[p] = false;
                            }
                        }
                        nationUsed[n] = false;
                    }
                }
                colorUsed[c] = false;
            }
        }
        return false;
    }

    private static boolean checkAll(String[] color, String[] nation, String[] pet, String[] drink, String[] hobby) {
        // 2
        for (int i = 0; i < 5; i++) {
            if ("English".equals(nation[i]) && !"red".equals(color[i])) return false;
            // 3
            if ("Spanish".equals(nation[i]) && !"dog".equals(pet[i])) return false;
            // 4
            if ("green".equals(color[i]) && !"coffee".equals(drink[i])) return false;
            // 5
            if ("Ukrainian".equals(nation[i]) && !"tea".equals(drink[i])) return false;
            // 7
            if ("snail".equals(pet[i]) && !"dancing".equals(hobby[i])) return false;
            // 8
            if ("yellow".equals(color[i]) && !"painting".equals(hobby[i])) return false;
            // 13
            if ("football".equals(hobby[i]) && !"orange juice".equals(drink[i])) return false;
            // 14
            if ("Japanese".equals(nation[i]) && !"chess".equals(hobby[i])) return false;
        }
        // 6: green immediately right of ivory
        for (int i = 1; i < 5; i++) {
            if ("green".equals(color[i]) && !"ivory".equals(color[i - 1])) return false;
        }
        // 9: middle house drinks milk
        if (!"milk".equals(drink[2])) return false;
        // 10: Norwegian in first house
        if (!"Norwegian".equals(nation[0])) return false;
        // 15: Norwegian next to blue house
        if (!("blue".equals(color[1]) || (0 < 4 && "blue".equals(color[0]) /* not possible */))) {
            boolean ok = false;
            if ("Norwegian".equals(nation[0]) && "blue".equals(color[1])) ok = true;
            if ("Norwegian".equals(nation[4]) && "blue".equals(color[3])) ok = true;
            for (int i = 1; i < 4; i++) {
                if ("Norwegian".equals(nation[i]) && ("blue".equals(color[i - 1]) || "blue".equals(color[i + 1]))) ok = true;
            }
            if (!ok) return false;
        }
        // 11: reading next to fox
        for (int i = 0; i < 5; i++) {
            if ("reading".equals(hobby[i])) {
                boolean next = false;
                if (i > 0 && "fox".equals(pet[i - 1])) next = true;
                if (i < 4 && "fox".equals(pet[i + 1])) next = true;
                if (!next) return false;
            }
        }
        // 12: painter next to horse
        for (int i = 0; i < 5; i++) {
            if ("painting".equals(hobby[i])) {
                boolean next = false;
                if (i > 0 && "horse".equals(pet[i - 1])) next = true;
                if (i < 4 && "horse".equals(pet[i + 1])) next = true;
                if (!next) return false;
            }
        }
        return true;
    }
}
