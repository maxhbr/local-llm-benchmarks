package com.example;

import java.util.regex.Matcher;
import java.util.regex.Pattern;

public class PigLatinTranslator {
    public String translate(String word) {
        if (word == null || word.isEmpty()) {
            return word;
        }

        String lower = word.toLowerCase();

        // Rule 1: begins with vowel, or starts with "xr" or "yt"
        if (lower.matches("^[aeiou].*") || lower.startsWith("xr") || lower.startsWith("yt")) {
            return word + "ay";
        }

        // Rule 3: zero or more consonants followed by "qu"
        Pattern quPattern = Pattern.compile("^([^aeiou]*qu)(.*)");
        Matcher quMatcher = quPattern.matcher(lower);
        if (quMatcher.matches()) {
            String front = quMatcher.group(1);
            String rest = quMatcher.group(2);
            return rest + front + "ay";
        }

        // Rule 4: one or more consonants followed by "y"
        Pattern yPattern = Pattern.compile("^([^aeiou]+)y(.*)");
        Matcher yMatcher = yPattern.matcher(lower);
        if (yMatcher.matches()) {
            String consonants = yMatcher.group(1);
            String rest = "y" + yMatcher.group(2);
            return rest + consonants + "ay";
        }

        // Rule 2: one or more consonants at start
        Pattern conPattern = Pattern.compile("^([^aeiou]+)(.*)");
        Matcher conMatcher = conPattern.matcher(lower);
        if (conMatcher.matches()) {
            String consonants = conMatcher.group(1);
            String rest = conMatcher.group(2);
            return rest + consonants + "ay";
        }

        // fallback (should not happen for valid words)
        return word + "ay";
    }

}
```

