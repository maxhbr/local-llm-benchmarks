import java.awt.Point;
import java.util.Map;
import java.util.HashMap;
import java.util.HashSet;
import java.util.Set;
import java.util.ArrayDeque;
import java.util.Deque;

class GoCounting {
    private char[][] board;
    private int rows;
    private int cols;

    GoCounting(String board) {
        String[] lines = board.trim().split("\n");
        rows = lines.length;
        cols = lines[0].length();
        this.board = new char[rows][cols];
        for (int y = 0; y < rows; y++) {
            this.board[y] = lines[y].toCharArray();
        }
    }

    Player getTerritoryOwner(int x, int y) {
        if (x < 0 || x >= cols || y < 0 || y >= rows) throw new IllegalArgumentException("Coordinates out of bounds");
        if (board[y][x] != ' ') return null; // not empty
        Set<Point> territory = getTerritory(x, y);
        Player owner = null;
        boolean hasBlack = false;
        boolean hasWhite = false;
        for (Point p : territory) {
            // check neighbors
            int[] dx = {1, -1, 0, 0};
            int[] dy = {0, 0, 1, -1};
            for (int i = 0; i < 4; i++) {
                int nx = p.x + dx[i];
                int ny = p.y + dy[i];
                if (nx >= 0 && nx < cols && ny >= 0 && ny < rows) {
                    char c = board[ny][nx];
                    if (c == 'B') hasBlack = true;
                    else if (c == 'W') hasWhite = true;
                }
            }
        }
        if (hasBlack && hasWhite) return null; // neutral
        if (hasBlack) return Player.BLACK;
        if (hasWhite) return Player.WHITE;
        return null; // no stones surrounding, neutral
    }

    Set<Point> getTerritory(int x, int y) {
        if (x < 0 || x >= cols || y < 0 || y >= rows) throw new IllegalArgumentException("Coordinates out of bounds");
        if (board[y][x] != ' ') return new HashSet<>(); // not empty, no territory
        Set<Point> territory = new HashSet<>();
        Deque<Point> stack = new ArrayDeque<>();
        stack.push(new Point(x, y));
        territory.add(new Point(x, y));
        int[] dx = {1, -1, 0, 0};
        int[] dy = {0, 0, 1, -1};
        while (!stack.isEmpty()) {
            Point p = stack.pop();
            for (int i = 0; i < 4; i++) {
                int nx = p.x + dx[i];
                int ny = p.y + dy[i];
                if (nx >= 0 && nx < cols && ny >= 0 && ny < rows) {
                    if (board[ny][nx] == ' ' && !territory.contains(new Point(nx, ny))) {
                        Point np = new Point(nx, ny);
                        territory.add(np);
                        stack.push(np);
                    }
                }
            }
        }
        return territory;
    }

    Map<Player, Set<Point>> getTerritories() {
        Map<Player, Set<Point>> result = new HashMap<>();
        boolean[][] visited = new boolean[rows][cols];
        for (int y = 0; y < rows; y++) {
            for (int x = 0; x < cols; x++) {
                if (board[y][x] == ' ' && !visited[y][x]) {
                    Set<Point> terr = getTerritory(x, y);
                    for (Point p : terr) visited[p.y][p.x] = true;
                    Player owner = getTerritoryOwnerForTerritory(terr);
                    if (owner != null) {
                        result.computeIfAbsent(owner, k -> new HashSet<>()).addAll(terr);
                    }
                }
            }
        }
        return result;
    }

    private Player getTerritoryOwnerForTerritory(Set<Point> territory) {
        boolean hasBlack = false;
        boolean hasWhite = false;
        for (Point p : territory) {
            int[] dx = {1, -1, 0, 0};
            int[] dy = {0, 0, 1, -1};
            for (int i = 0; i < 4; i++) {
                int nx = p.x + dx[i];
                int ny = p.y + dy[i];
                if (nx >= 0 && nx < cols && ny >= 0 && ny < rows) {
                    char c = board[ny][nx];
                    if (c == 'B') hasBlack = true;
                    else if (c == 'W') hasWhite = true;
                }
            }
        }
        if (hasBlack && hasWhite) return null;
        if (hasBlack) return Player.BLACK;
        if (hasWhite) return Player.WHITE;
        return null;
    }
}
