package poker

import (
	"errors"
	"fmt"
	"sort"
	"strings"
)

type card struct {
	rank int // 2-14 (11=J,12=Q,13=K,14=A)
	suit string
}

type handEval struct {
	hand        string
	categories  []int // category rank followed by tie-breaker ranks
}

func parseCard(s string) (card, error) {
	// s like "10H" or "AH"
	rankStr := s[:len(s)-1]
	suit := s[len(s)-1:]
	var rank int
	switch rankStr {
	case "A":
		rank = 14
	case "K":
		rank = 13
	case "Q":
		rank = 12
	case "J":
		rank = 11
	case "10":
		rank = 10
	default:
		n, err := fmt.Sprintf("%d", rankStr), errors.New("invalid rank")
		if err != nil {
			return card{}, errors.New("invalid card: " + s)
		}
		// Actually parse integer
		val := 0
		for _, c := range rankStr {
			if c < '2' || c > '9' {
				return card{}, errors.New("invalid rank: " + rankStr)
			}
			val = val*10 + int(c-'0')
		}
		rank = val
		_ = n
	}
	if len(suit) != 1 || !strings.Contains("SHCD", suit) {
		return card{}, errors.New("invalid suit: " + suit)
	}
	return card{rank: rank, suit: suit}, nil
}

func parseHand(hand string) ([]card, error) {
	parts := strings.Split(hand, " ")
	if len(parts) != 5 {
		return nil, errors.New("invalid hand length")
	}
	cards := make([]card, 5)
	for i, p := range parts {
		c, err := parseCard(p)
		if err != nil {
			return nil, err
		}
		cards[i] = c
	}
	return cards, nil
}

func evaluate(hand string, cards []card) handEval {
	// copy and sort cards by rank descending
	sorted := make([]card, len(cards))
	copy(sorted, cards)
	sort.Slice(sorted, func(i, j int) bool {
		return sorted[i].rank > sorted[j].rank
	})

	// count ranks
	counts := map[int]int{}
	for _, c := range cards {
		counts[c.rank]++
	}
	// get counts sorted by count desc then rank desc
	type rc struct {
		rank  int
		count int
	}
	var rcs []rc
	for r, c := range counts {
		rcs = append(rcs, rc{rank: r, count: c})
	}
	sort.Slice(rcs, func(i, j int) bool {
		if rcs[i].count != rcs[j].count {
			return rcs[i].count > rcs[j].count
		}
		return rcs[i].rank > rcs[j].rank
	})

	// check flush
	flush := true
	for i := 1; i < len(cards); i++ {
		if cards[i].suit != cards[0].suit {
			flush = false
			break
		}
	}

	// check straight (including wheel A-2-3-4-5)
	straight := true
	for i := 1; i < len(sorted); i++ {
		if sorted[i].rank != sorted[i-1].rank-1 {
			straight = false
			break
		}
	}
	if !straight && len(counts) == 5 {
		// check wheel: A,2,3,4,5
		wheel := []int{14, 5, 4, 3, 2}
		isWheel := true
		for i, c := range sorted {
			if c.rank != wheel[i] {
				isWheel = false
				break
			}
		}
		if isWheel {
			straight = true
			// for tie-breaker, treat wheel as 5-high: A is low
			// we will handle by adjusting sorted order later if needed
		}
	}

	// determine category
	var category int
	var tiebreakers []int
	if flush && straight {
		category = 8
		if straight && len(counts) == 5 && sorted[0].rank == 14 && sorted[1].rank == 5 {
			// wheel straight flush: treat as 5-high
			tiebreakers = []int{5, 4, 3, 2, 14}
		} else {
			for _, c := range sorted {
				tiebreakers = append(tiebreakers, c.rank)
			}
		}
	} else if rcs[0].count == 4 {
		category = 7
		tiebreakers = []int{rcs[0].rank, rcs[1].rank}
	} else if rcs[0].count == 3 && rcs[1].count == 2 {
		category = 6
		tiebreakers = []int{rcs[0].rank, rcs[1].rank}
	} else if flush {
		category = 5
		for _, c := range sorted {
			tiebreakers = append(tiebreakers, c.rank)
		}
	} else if straight {
		category = 4
		if len(counts) == 5 && sorted[0].rank == 14 && sorted[1].rank == 5 {
			tiebreakers = []int{5, 4, 3, 2, 14}
		} else {
			for _, c := range sorted {
				tiebreakers = append(tiebreakers, c.rank)
			}
		}
	} else if rcs[0].count == 3 {
		category = 3
		tiebreakers = []int{rcs[0].rank, rcs[1].rank, rcs[2].rank}
	} else if rcs[0].count == 2 && rcs[1].count == 2 {
		category = 2
		tiebreakers = []int{rcs[0].rank, rcs[1].rank, rcs[2].rank}
	} else if rcs[0].count == 2 {
		category = 1
		tiebreakers = []int{rcs[0].rank, rcs[1].rank, rcs[2].rank, rcs[3].rank}
	} else {
		category = 0
		for _, c := range sorted {
			tiebreakers = append(tiebreakers, c.rank)
		}
	}

	cat := []int{category}
	cat = append(cat, tiebreakers...)
	return handEval{hand: hand, categories: cat}
}

func BestHand(hands []string) ([]string, error) {
	if len(hands) == 0 {
		return nil, errors.New("no hands provided")
	}
	var evals []handEval
	for _, h := range hands {
		cards, err := parseHand(h)
		if err != nil {
			return nil, err
		}
		evals = append(evals, evaluate(h, cards))
	}

	// find best
	best := evals[0]
	for _, e := range evals {
		if compareEval(e, best) > 0 {
			best = e
		}
	}
	var result []string
	for _, e := range evals {
		if compareEval(e, best) == 0 {
			result = append(result, e.hand)
		}
	}
	return result, nil
}

func compareEval(a, b handEval) int {
	for i := 0; i < len(a.categories) && i < len(b.categories); i++ {
		if a.categories[i] > b.categories[i] {
			return 1
		} else if a.categories[i] < b.categories[i] {
			return -1
		}
	}
	return 0
}
