const DIGIT_PATTERNS = {
  ' _ | ||_|': '0',
  '   | |  ': '1',
  ' _  _||_ ': '2',
  ' _  _| _|': '3',
  '   |_|  |': '4',
  ' _ |_  _|': '5',
  ' _ |_|_| ': '6',
  ' _   |  ': '7',
  ' _ |_||_|': '8',
  ' _ |_| _|': '9'
};

function recognizeDigit(grid) {
  // grid is array of 4 strings, each 3 chars wide
  const key = grid[0] + grid[1] + grid[2] + grid[3];
  return DIGIT_PATTERNS[key] || '?';
}

export const convert = (input) => {
  const lines = input.split('\n');
  // Each digit uses 4 rows, so number of rows must be multiple of 4
  if (lines.length % 4 !== 0) {
    throw new Error('Incorrect size');
  }
  const results = [];
  for (let i = 0; i < lines.length; i += 4) {
    const rowBlock = lines.slice(i, i + 4);
    // Each line in block must be same length and multiple of 3
    const width = rowBlock[0].length;
    if (width % 3 !== 0 || rowBlock.some(l => l.length !== width)) {
      throw new Error('Incorrect size');
    }
    let numberStr = '';
    for (let col = 0; col < width; col += 3) {
      const digitGrid = rowBlock.map(line => line.substring(col, col + 3));
      numberStr += recognizeDigit(digitGrid);
    }
    results.push(numberStr);
  }
  return results.join(',');
};
```

