```
#include "diamond.h"
#include <string>
#include <vector>
#include <cctype>

namespace diamond {

std::string make_diamond(char letter) {
    letter = static_cast<char>(toupper(letter));
    int n = letter - 'A';  // zero-based index of letter
    int size = 2 * n + 1;
    std::vector<std::string> rows;
    rows.reserve(size);

    for (int i = 0; i <= n; ++i) {
        char c = static_cast<char>('A' + i);
        std::string row(size, ' ');
        int mid = n;
        row[mid - i] = c;
        row[mid + i] = c;
        rows.push_back(row);
    }
    for (int i = n - 1; i >= 0; --i) {
        rows.push_back(rows[i]);
    }

    std::string result;
    for (size_t i = 0; i < rows.size(); ++i) {
        result += rows[i];
        if (i + 1 < rows.size()) {
            result += '\n';
        }
    }
    return result;
}

}  // namespace diamond
```
