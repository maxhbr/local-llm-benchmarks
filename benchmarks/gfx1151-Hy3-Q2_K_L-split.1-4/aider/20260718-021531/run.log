```
import java.util.Random;
import java.util.Stack;

public class MazeGenerator {

    private static final char HORIZONTAL_WALL = '─';
    private static final char VERTICAL_WALL = '│';
    private static final char TOP_LEFT = '┌';
    private static final char TOP_RIGHT = '┐';
    private static final char BOTTOM_LEFT = '└';
    private static final char BOTTOM_RIGHT = '┘';
    private static final char CROSS = '┬';
    private static final char T_DOWN = '├';
    private static final char T_UP = '┤';
    private static final char T_RIGHT = '┴';
    private static final char EMPTY = ' ';
    private static final char ENTRANCE = '⇨';

    public char[][] generatePerfectMaze(int rows, int columns) {
        return generatePerfectMaze(rows, columns, (int) System.currentTimeMillis());
    }

    public char[][] generatePerfectMaze(int rows, int columns, int seed) {
        if (rows < 5 || rows > 100 || columns < 5 || columns > 100) {
            throw new IllegalArgumentException("Rows and columns must be between 5 and 100");
        }

        Random rand = new Random(seed);
        int cellRows = rows;
        int cellCols = columns;
        int gridRows = 2 * cellRows + 1;
        int gridCols = 2 * cellCols + 1;

        // grid: true = wall, false = passage (carved)
        boolean[][] grid = new boolean[gridRows][gridCols];
        for (int i = 0; i < gridRows; i++) {
            for (int j = 0; j < gridCols; j++) {
                grid[i][j] = true; // wall by default
            }
        }

        boolean[][] visited = new boolean[cellRows][cellCols];
        Stack<int[]> stack = new Stack<>();
        int startR = 0, startC = 0;
        visited[startR][startC] = true;
        // mark cell as passage
        grid[2 * startR + 1][2 * startC + 1] = false;
        stack.push(new int[]{startR, startC});

        int[][] dirs = {{1, 0}, {-1, 0}, {0, 1}, {0, -1}};

        while (!stack.isEmpty()) {
            int[] cell = stack.pop();
            int r = cell[0], c = cell[1];

            // shuffle directions
            int[] order = {0, 1, 2, 3};
            for (int i = order.length - 1; i > 0; i--) {
                int idx = rand.nextInt(i + 1);
                int tmp = order[i];
                order[i] = order[idx];
                order[idx] = tmp;
            }

            for (int k : order) {
                int nr = r + dirs[k][0];
                int nc = c + dirs[k][1];
                if (nr >= 0 && nr < cellRows && nc >= 0 && nc < cellCols && !visited[nr][nc]) {
                    visited[nr][nc] = true;
                    // carve passage cell
                    grid[2 * nr + 1][2 * nc + 1] = false;
                    // carve wall between
                    int wallR = r + nr + 1;
                    int wallC = c + nc + 1;
                    grid[wallR][wallC] = false;
                    stack.push(new int[]{nr, nc});
                }
            }
        }

        // Build output characters
        char[][] maze = new char[gridRows][gridCols];
        for (int i = 0; i < gridRows; i++) {
            for (int j = 0; j < gridCols; j++) {
                if (!grid[i][j]) {
                    maze[i][j] = EMPTY;
                } else {
                    // wall: determine correct box character
                    if (i % 2 == 0 && j % 2 == 0) {
                        boolean up = (i > 0 && !grid[i - 1][j]);
                        boolean down = (i < gridRows - 1 && !grid[i + 1][j]);
                        boolean left = (j > 0 && !grid[i][j - 1]);
                        boolean right = (j < gridCols - 1 && !grid[i][j + 1]);
                        if (up && down && left && right) maze[i][j] = CROSS;
                        else if (up && !down && left && right) maze[i][j] = T_DOWN;
                        else if (!up && down && left && right) maze[i][j] = T_UP;
                        else if (left && right && up && !down) maze[i][j] = T_RIGHT;
                        else if (up && down && !left && right) maze[i][j] = T_DOWN;
                        else if (up && down && left && !right) maze[i][j] = T_UP;
                        else if (!up && !down && left && right) maze[i][j] = HORIZONTAL_WALL;
                        else if (!up && !down && !left && right) maze[i][j] = TOP_LEFT;
                        else if (!up && !down && left && !right) maze[i][j] = TOP_RIGHT;
                        else if (up && !down && !left && !right) maze[i][j] = BOTTOM_LEFT;
                        else if (!up && down && !left && !right) maze[i][j] = BOTTOM_RIGHT;
                        else if (i == 0 && j == 0) maze[i][j] = TOP_LEFT;
                        else if (i == 0 && j == gridCols - 1) maze[i][j] = TOP_RIGHT;
                        else if (i == gridRows - 1 && j == 0) maze[i][j] = BOTTOM_LEFT;
                        else if (i == gridRows - 1 && j == gridCols - 1) maze[i][j] = BOTTOM_RIGHT;
                        else maze[i][j] = HORIZONTAL_WALL;
                    } else if (i % 2 == 0 && j % 2 != 0) {
                        boolean up = (i > 0 && !grid[i - 1][j]);
                        boolean down = (i < gridRows - 1 && !grid[i + 1][j]);
                        if (up && down) maze[i][j] = CROSS;
                        else if (up && !down) maze[i][j] = T_DOWN;
                        else if (!up && down) maze[i][j] = T_UP;
                        else maze[i][j] = HORIZONTAL_WALL;
                    } else if (i % 2 != 0 && j % 2 == 0) {
                        boolean left = (j > 0 && !grid[i][j - 1]);
                        boolean right = (j < gridCols - 1 && !grid[i][j + 1]);
                        if (left && right) maze[i][j] = CROSS;
                        else if (left && !right) maze[i][j] = T_UP;
                        else if (!left && right) maze[i][j] = T_DOWN;
                        else maze[i][j] = VERTICAL_WALL;
                    } else {
                        maze[i][j] = EMPTY;
                    }
                }
            }
        }

        // Entrance on left (row 1, col 0) and exit on right (row 1, col gridCols-1)
        maze[1][0] = ENTRANCE;
        maze[1][gridCols - 1] = ENTRANCE;

        return maze;
    }
}
```

