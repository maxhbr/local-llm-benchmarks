        if (consistent(houses) && assign(houseIdx + 1)) return true;
        house.color = null; used.color.delete(c);
      }
      for (const n of domains.nationality) {
        house.nationality = n; used.nationality.add(n);
        if (consistent(houses) && assign(houseIdx + 1)) return true;
        house.nationality = null; used.nationality.delete(n);
      }
      for (const p of domains.pet) {
        house.pet = p; used.pet.add(p);
        if (consistent(houses) && assign(houseIdx + 1)) return true;
        house.pet = null; used.pet.delete(p);
      }
      for (const d of domains.drink) {
        house.drink = d; used.drink.add(d);
        if (consistent(houses) && assign(houseIdx + 1)) return true;
        house.drink = null; used.drink.delete(d);
      }
      for (const h of domains.hobby) {
        house.hobby = h; used.hobby.add(h);
        if (consistent(houses) && assign(houseIdx + 1)) return true;
        house.hobby = null; used.hobby.delete(h);
      }
      return false;
    };

    for (let i = 0; i < 5; i++) {
      houses.push({ color: null, nationality: null, pet: null, drink: null, hobby: null });
    }
    assign(0);
    return houses;
  }

  fullValid(houses) {
    // All 15 rules fully checked when all assigned
    if (houses[0].nationality !== 'Norwegian') return false;
    if (houses[2].drink !== 'milk') return false;
    // green right of ivory
    let ivoryIdx = houses.findIndex(h => h.color === 'ivory');
    let greenIdx = houses.findIndex(h => h.color === 'green');
    if (greenIdx !== ivoryIdx + 1) return false;
    // Englishman red
    if (houses.find(h => h.nationality === 'Englishman').color !== 'red') return false;
    // Spaniard dog
    if (houses.find(h => h.nationality === 'Spaniard').pet !== 'dog') return false;
    // green coffee
    if (houses.find(h => h.color === 'green').drink !== 'coffee') return false;
    // Ukrainian tea
    if (houses.find(h => h.nationality === 'Ukrainian').drink !== 'tea') return false;
    // snail dancing
    if (houses.find(h => h.pet === 'snail').hobby !== 'dancing') return false;
    // yellow painter
    if (houses.find(h => h.color === 'yellow').hobby !== 'painter') return false;
    // reading next to fox
    const readingIdx = houses.findIndex(h => h.hobby === 'reading');
    if (!((readingIdx > 0 && houses[readingIdx - 1].pet === 'fox') || (readingIdx < 4 && houses[readingIdx + 1].pet === 'fox'))) return false;
    // painter next to horse
    const painterIdx = houses.findIndex(h => h.hobby === 'painter');
    if (!((painterIdx > 0 && houses[painterIdx - 1].pet === 'horse') || (painterIdx < 4 && houses[painterIdx + 1].pet === 'horse'))) return false;
    // football orange juice
    if (houses.find(h => h.hobby === 'football').drink !== 'orange juice') return false;
    // Japanese chess
    if (houses.find(h => h.nationality === 'Japanese').hobby !== 'chess') return false;
    // Norwegian next to blue
    if (!((houses[0].color === 'blue') || (houses[1].color === 'blue'))) return false;
    return true;
  }

  waterDrinker() {
    const house = this.solution.find(h => h.drink === 'water');
    return house.nationality;
  }

  zebraOwner() {
    const house = this.solution.find(h => h.pet === 'zebra');
    return house.nationality;
  }
}
