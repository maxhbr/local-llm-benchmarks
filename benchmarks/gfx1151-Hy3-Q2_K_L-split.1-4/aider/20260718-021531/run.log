        num /= 10;
        let digit3 = (num % 10) as u8;
        let name = format!("{}{}{}{}{}", letter1, letter2, digit1, digit2, digit3);
        let mut set = names.lock().unwrap();
        if !set.contains(&name) {
            set.insert(name.clone());
            return name;
        }
    }
}

