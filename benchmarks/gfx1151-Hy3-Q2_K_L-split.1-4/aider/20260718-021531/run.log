+std::vector<int> convert(int from_base, const std::vector<int>& digits, int to_base) {
+    if (from_base < 2) throw std::invalid_argument("invalid input base");
+    if (to_base < 2) throw std::invalid_argument("invalid output base");
+    for (int d : digits) {
+        if (d < 0 || d >= from_base) throw std::invalid_argument("invalid digit");
