//
// This is only a SKELETON file for the 'React' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export class InputCell {
  constructor(value) {
    this._value = value;
  }

  setValue(value) {
    this._value = value;
  }

  get value() {
    return this._value;
  }
}

export class ComputeCell {
  constructor(inputCells, fn) {
    this._inputCells = inputCells;
    this._fn = fn;
    this._callbacks = [];
    this._value = fn(...inputCells.map(c => c.value));
    this._previousValue = this._value;
  }

  get value() {
    return this._value;
  }

  addCallback(cb) {
    this._callbacks.push(cb);
  }

  removeCallback(cb) {
    this._callbacks = this._callbacks.filter(c => c !== cb);
  }

  // Internal: recompute and propagate if inputs changed
  _recompute() {
    const newValue = this._fn(...this._inputCells.map(c => c.value));
    if (newValue !== this._value) {
      this._value = newValue;
    }
  }

  // Called when inputs change to update and notify
  _update() {
    const oldValue = this._value;
    this._recompute();
    if (this._value !== oldValue) {
      this._callbacks.forEach(cb => cb.valueChanged(this));
    }
  }
}

export class CallbackCell {
  constructor(fn) {
    this._fn = fn;
    this._lastValue = undefined;
  }

  valueChanged(cell) {
    const newValue = this._fn(cell.value);
    this._lastValue = newValue;
  }

  get lastValue() {
    return this._lastValue;
  }
}
