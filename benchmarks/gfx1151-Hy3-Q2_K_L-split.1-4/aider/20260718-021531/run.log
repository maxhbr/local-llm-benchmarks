public class Zipper {
    public int value;
    public Zipper up;
    public Zipper left;
    public Zipper right;

    public Zipper(int val) {
        this.value = val;
        this.up = null;
        this.left = null;
        this.right = null;
    }

    public BinaryTree toTree() {
        Zipper root = this;
        while (root.up != null) {
            root = root.up;
        }
        return new BinaryTree(root);
    }

    public int getValue() {
        return this.value;
    }

    public Zipper setLeft(Zipper leftChild) {
        this.left = leftChild;
        if (leftChild != null) {
            leftChild.up = this;
        }
        return this;
    }

    public Zipper setRight(Zipper rightChild) {
        this.right = rightChild;
        if (rightChild != null) {
            rightChild.up = this;
        }
        return this;
    }

    public Zipper setValue(int val) {
        this.value = val;
        return this;
    }
}

public class BinaryTree {
    private Zipper root;

    public BinaryTree(int value) {
        this.root = new Zipper(value);
    }

    public BinaryTree(Zipper root) {
        this.root = root;
    }

    public Zipper getRoot() {
        return this.root;
    }

    public String printTree() {
        StringBuilder sb = new StringBuilder();
        printTree(this.root, sb);
        return sb.toString().trim();
    }

