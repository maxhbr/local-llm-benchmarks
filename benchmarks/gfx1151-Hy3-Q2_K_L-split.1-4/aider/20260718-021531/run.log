        // Iteration 0: just a number
        if (expr.matches("-?\\d+")) {
            return Integer.parseInt(expr);
        }

        // Match sequence: number op number op number ...
        Pattern seqPattern = Pattern.compile(
            "^(-?\\d+)(\\s+(plus|minus|multiplied by|divided by)\\s+(-?\\d+))*$");
        if (!seqPattern.matcher(expr).matches()) {
            throw new IllegalArgumentException("Unsupported operation or invalid syntax");
        }

        // Parse left-to-right
        Pattern tokenPattern = Pattern.compile("(-?\\d+)|(plus|minus|multiplied by|divided by)");
        Matcher tokenMatcher = tokenPattern.matcher(expr);

        if (!tokenMatcher.find()) {
            throw new IllegalArgumentException("No number found");
        }
        int result = Integer.parseInt(tokenMatcher.group(1));

        String pendingOp = null;
        while (tokenMatcher.find()) {
            if (tokenMatcher.group(2) != null) {
                pendingOp = tokenMatcher.group(2);
            } else {
                int num = Integer.parseInt(tokenMatcher.group(1));
                switch (pendingOp) {
                    case "plus":
                        result += num;
                        break;
                    case "minus":
                        result -= num;
                        break;
                    case "multiplied by":
                        result *= num;
                        break;
                    case "divided by":
                        result /= num;
                        break;
                    default:
                        throw new IllegalArgumentException("Unsupported operation");
                }
                pendingOp = null;
            }
        }

        if (pendingOp != null) {
            throw new IllegalArgumentException("Invalid syntax: dangling operation");
        }

        return result;
    }
}
```

