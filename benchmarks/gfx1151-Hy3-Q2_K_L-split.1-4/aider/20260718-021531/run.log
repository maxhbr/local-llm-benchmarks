def proverb(items, qualifier=None):
    lines = []
    for i in range(len(items) - 1):
        want = items[i]
        lost = items[i + 1]
        lines.append(f"For want of a {want} the {lost} was lost.")
    if items:
        last_item = items[0]
        if qualifier:
