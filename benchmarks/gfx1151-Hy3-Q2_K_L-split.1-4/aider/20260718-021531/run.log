```
import java.util.ArrayList;
import java.util.List;
import java.util.Map;
import java.util.HashMap;

class BookStore {

    private static final double BOOK_PRICE = 8.0;
    private static final double[] DISCOUNTS = {0.0, 0.0, 0.05, 0.10, 0.20, 0.25};

    double calculateBasketCost(List<Integer> books) {
        Map<Integer, Integer> counts = new HashMap<>();
        for (Integer book : books) {
            counts.put(book, counts.getOrDefault(book, 0) + 1);
        }

        List<Integer> sortedCounts = new ArrayList<>(counts.values());
        sortedCounts.sort((a, b) -> b - a); // descending

        return calculateOptimal(sortedCounts);
    }

    private double calculateOptimal(List<Integer> sortedCounts) {
        if (sortedCounts.isEmpty()) {
            return 0.0;
        }

        double best = Double.MAX_VALUE;
        // Try all possible group sizes from 1 to 5 (number of distinct books available)
        int maxGroupSize = sortedCounts.size();
        for (int groupSize = 1; groupSize <= maxGroupSize; groupSize++) {
            // Make a working copy of counts
            List<Integer> work = new ArrayList<>(sortedCounts);
            // Remove one book from each of the top 'groupSize' categories
            List<Integer> reduced = new ArrayList<>();
            for (int i = 0; i < groupSize; i++) {
                int c = work.get(i) - 1;
                if (c > 0) {
                    reduced.add(c);
                }
            }
            // Add remaining counts (those beyond groupSize)
            for (int i = groupSize; i < work.size(); i++) {
                reduced.add(work.get(i));
            }
            reduced.sort((a, b) -> b - a);

            double costForGroup = groupSize * BOOK_PRICE * (1 - DISCOUNTS[groupSize]);
            double total = costForGroup + calculateOptimal(reduced);
            if (total < best) {
                best = total;
            }
        }
        return best;
    }

}
