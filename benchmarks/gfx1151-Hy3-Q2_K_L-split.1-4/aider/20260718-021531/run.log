//
// This is only a SKELETON file for the 'Beer Song' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export const recite = (initialBottlesCount, takeDownCount) => {
  const lyrics = [];

  for (let i = 0; i < takeDownCount; i++) {
    let current = initialBottlesCount - i;

    if (current > 0) {
      let currentLabel = current === 1 ? '1 bottle' : `${current} bottles`;
      let next = current - 1;
      let nextLabel;
      if (next === 0) {
        nextLabel = 'no more bottles';
      } else if (next === 1) {
        nextLabel = '1 bottle';
      } else {
        nextLabel = `${next} bottles`;
      }

      lyrics.push(`${currentLabel} of beer on the wall, ${currentLabel} of beer.`);
      if (current === 1) {
        lyrics.push(`Take it down and pass it around, ${nextLabel} of beer on the wall.`);
      } else {
        lyrics.push(`Take one down and pass it around, ${nextLabel} of beer on the wall.`);
      }
    } else if (current === 0) {
      lyrics.push(`No more bottles of beer on the wall, no more bottles of beer.`);
      lyrics.push(`Go to the store and buy some more, 99 bottles of beer on the wall.`);
    }
  }

  return lyrics;
};
```

