```
#include "parallel_letter_frequency.h"
#include <algorithm>
#include <execution>
#include <cctype>

namespace parallel_letter_frequency {

std::map<char, int> frequency(const std::vector<std::string>& texts) {
    auto count_text = [](const std::string& text) {
        std::map<char, int> local;
        for (char c : text) {
            if (std::isalpha(static_cast<unsigned char>(c))) {
                char lower = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
                local[lower]++;
            }
        }
        return local;
    };

    auto merge = [](std::map<char, int> a, const std::map<char, int>& b) {
        for (const auto& pair : b) {
            a[pair.first] += pair.second;
        }
        return a;
    };

    std::map<char, int> empty;
    return std::transform_reduce(std::execution::par,
                                 texts.begin(), texts.end(),
                                 empty, merge, count_text);
}

}
```

