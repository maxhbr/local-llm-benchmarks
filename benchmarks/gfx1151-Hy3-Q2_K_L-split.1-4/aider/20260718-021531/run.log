    const numMatch = rest.match(/^(-?\d+)(.*)$/);

    const opMatch = rest.match(/^(plus|minus|multiplied by|divided by)(.*)$/);

    if (numMatch) {

      const val = parseInt(numMatch[1], 10);

      if (pendingOp === null) {

        if (result === null) {

          result = val;

        } else {

          throw new Error('Syntax error');

        }

      } else {

        if (result === null) {

          throw new Error('Syntax error');

        }

        switch (pendingOp) {

          case 'plus':

            result += val;

            break;

          case 'minus':

            result -= val;

            break;

          case 'multiplied by':

            result *= val;

            break;

          case 'divided by':

            result /= val;

            break;

        }

        pendingOp = null;

      }

      rest = numMatch[2].trim();

    } else if (opMatch) {

      if (pendingOp !== null) {

        throw new Error('Syntax error');

      }

      pendingOp = opMatch[1];

      rest = opMatch[2].trim();

    } else {

      // Unsupported operation or invalid syntax

      throw new Error('Unknown operation');

    }

  }



  if (pendingOp !== null) {

    throw new Error('Syntax error');

  }



  return result;

};

```

