package scale

import (
	"strings"
)

var sharps = []string{"A", "A♯", "B", "C", "C♯", "D", "D♯", "E", "F", "F♯", "G", "G♯"}
var flats = []string{"A", "B♭", "B", "C", "D♭", "D", "E♭", "E", "F", "G♭", "G", "A♭"}

func useFlats(tonic string) bool {
	t := strings.ToLower(tonic)
	switch t {
	case "f", "b♭", "e♭", "a♭", "d♭", "g♭", "d", "g", "c", "f", "b♭", "e♭":
		return true
	case "f♯", "e", "b", "f♯", "c♯", "g♯", "d♯":
		return false
	default:
		return false
	}
}

func chromatic(tonic string) []string {
	var base []string
	if useFlats(tonic) {
		base = flats
	} else {
		base = sharps
	}
	t := strings.ToUpper(tonic)
	// find starting index
	start := 0
	for i, n := range base {
		if strings.ToUpper(n) == t || n == tonic {
			start = i
			break
		}
	}
	// if not found (e.g., tonic has ♯ but flat version not in base), try matching sharp
	if start == 0 && base == flats {
		for i, n := range sharps {
			if strings.ToUpper(n) == t {
				start = i
				base = sharps
				break
			}
		}
	}
	res := make([]string, 0, 12)
	for i := 0; i < 12; i++ {
		res = append(res, base[(start+i)%12])
	}
	return res
}

func Scale(tonic, interval string) []string {
	chrom := chromatic(tonic)
	if interval == "" || interval == "m" {
		// chromatic scale: 12 notes
		return chrom
	}
	// diatonic or other scale
	steps := map[rune]int{
		'm': 1, // half step
		'M': 2, // whole step
		'A': 3, // augmented second
	}
	res := []string{chrom[0]}
	idx := 0
	for _, r := range interval {
		step, ok := steps[r]
		if !ok {
			step = 1
		}
		idx = (idx + step) % 12
		res = append(res, chrom[idx])
	}
	return res
}
