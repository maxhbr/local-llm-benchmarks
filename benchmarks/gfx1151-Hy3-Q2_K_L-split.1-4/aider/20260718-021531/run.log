```
package say

import (
	"fmt"
	"strconv"
)

var smallNumbers = []string{
	"zero", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine",
	"ten", "eleven", "twelve", "thirteen", "fourteen", "fifteen", "sixteen",
	"seventeen", "eighteen", "nineteen",
}

var tens = []string{
	"", "", "twenty", "thirty", "forty", "fifty", "sixty", "seventy", "eighty", "ninety",
}

var scales = []string{
	"", "thousand", "million", "billion", "trillion",
}

// Say spells out an integer from 0 to 999,999,999,999 in English.
// Returns (string, bool) where bool is true on success, false if out of range.
func Say(n int64) (string, bool) {
	if n < 0 || n > 999999999999 {
		return "", false
	}

	if n == 0 {
		return "zero", true
	}

	// break into chunks of 1000
	chunks := []int64{}
	cur := n
	for cur > 0 {
		chunks = append([]int64{cur % 1000}, chunks...)
		cur /= 1000
	}

	words := []string{}
	for i, chunk := range chunks {
		if chunk == 0 {
			continue
		}
		chunkWords := spellChunk(chunk)
		scale := scales[len(chunks)-1-i]
		if scale != "" {
			chunkWords = chunkWords + " " + scale
		}
		words = append(words, chunkWords)
	}

	result := ""
	for i, w := range words {
		if i > 0 {
			result += " "
		}
		result += w
	}

	return result, true
}

func spellChunk(chunk int64) string {
	if chunk < 100 {
		return spellUnder100(chunk)
	}
	// 100-999
	hundreds := chunk / 100
	rest := chunk % 100
	w := smallNumbers[hundreds] + " hundred"
	if rest != 0 {
		w += " " + spellUnder100(rest)
	}
	return w
}

func spellUnder100(n int64) string {
	if n < 20 {
		return smallNumbers[n]
	}
	tensDigit := n / 10
	onesDigit := n % 10
	if onesDigit == 0 {
		return tens[tensDigit]
	}
	return tens[tensDigit] + "-" + smallNumbers[onesDigit]
}

// helper not used but kept for possible debugging
func toString(n int64) string {
	return strconv.FormatInt(n, 10)
}

var _ = fmt.Sprintf
