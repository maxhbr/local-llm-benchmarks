    const assign = (houseIdx) => {
      if (houseIdx === 5) {
        // All houses assigned, do final full validation
        if (this.fullValid(houses)) return true;
        return false;
      }
      const house = houses[houseIdx];
      const domains = {
        color: colors.filter(c => !used.color.has(c)),
        nationality: nationalities.filter(n => !used.nationality.has(n)),
        pet: pets.filter(p => !used.pet.has(p)),
        drink: drinks.filter(d => !used.drink.has(d)),
        hobby: hobbies.filter(h => !used.hobby.has(h)),
      };
      for (const c of domains.color) {
