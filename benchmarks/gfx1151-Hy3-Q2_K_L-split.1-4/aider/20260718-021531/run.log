 func Answer(question string) (int, bool) {
-       panic("Please implement the Answer function")
+       // Remove the leading "What is " and trailing "?"
+       q := strings.TrimSpace(question)
+       if !strings.HasPrefix(q, "What is ") || !strings.HasSuffix(q, "?") {
+               return 0, false
+       }
+       body := strings.TrimSuffix(strings.TrimPrefix(q, "What is "), "?")
+       body = strings.TrimSpace(body)
+
+       // Iteration 0: just a number
+       if num, err := strconv.Atoi(body); err == nil {
+               return num, true
+       }
+
+       // Split into tokens by spaces
+       parts := strings.Split(body, " ")
+       if len(parts) == 0 || len(parts)%3 != 1 {
+               // Expect pattern: number op number op number ... => len % 3 == 1
+               return 0, false
+       }
+
+       // First number
+       current, err := strconv.Atoi(parts[0])
+       if err != nil {
+               return 0, false
+       }
+
+       // Process operations
+       for i := 1; i < len(parts); i += 2 {
+               if i+1 >= len(parts) {
+                       return 0, false
+               }
+               op := parts[i]
+               nextStr := parts[i+1]
+               next, err := strconv.Atoi(nextStr)
+               if err != nil {
+                       return 0, false
+               }
+               switch op {
+               case "plus":
+                       current += next
+               case "minus":
+                       current -= next
+               case "multiplied":
+                       if i+2 < len(parts) && parts[i+2] == "by" {
+                               // adjust for "multiplied by" being three tokens
+                               current *= next
+                               i++
+                               continue
+                       }
+                       return 0, false
+               case "divided":
+                       if i+2 < len(parts) && parts[i+2] == "by" {
+                               if next == 0 {
+                                       return 0, false
+                               }
+                               current /= next
+                               i++
+                               continue
+                       }
+                       return 0, false
+               default:
+                       // Unsupported operation
+                       return 0, false
+               }
+       }
+
+       return current, true
 }
