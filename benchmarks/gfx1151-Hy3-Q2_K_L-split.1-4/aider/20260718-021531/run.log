package connect



import (

        "strings"

)



func ResultOf(lines []string) (string, error) {

        // strip spaces to get grid of cells

        board := make([]string, len(lines))

        for i, line := range lines {

                board[i] = strings.ReplaceAll(line, " ", "")

        }

        rows := len(board)

        if rows == 0 {

                return "", nil

        }

        cols := len(board[0])



        // BFS for O: top to bottom

        visited := make([][]bool, rows)

        for r := range visited {

                visited[r] = make([]bool, cols)

        }

        type point struct{ r, c int }

        for c := 0; c < cols; c++ {

                if board[0][c] == 'O' {

                        stack := []point{{0, c}}

                        visited[0][c] = true

                        for len(stack) > 0 {

                                p := stack[len(stack)-1]

                                stack = stack[:len(stack)-1]

                                if p.r == rows-1 {

                                        return "O", nil

                                }

                                // neighbors

                                neighbors := []point{

                                        {p.r - 1, p.c},

                                        {p.r + 1, p.c},

                                        {p.r - 1, p.c + 1},

                                        {p.r + 1, p.c - 1},

                                        {p.r, p.c - 1},

                                        {p.r, p.c + 1},

                                }

                                for _, n := range neighbors {

                                        if n.r >= 0 && n.r < rows && n.c >= 0 && n.c < cols {

                                                if !visited[n.r][n.c] && board[n.r][n.c] == 'O' {

                                                        visited[n.r][n.c] = true

                                                        stack = append(stack, n)

                                                }

                                        }

                                }

                        }

                }

        }



        // BFS for X: left to right

        for r := 0; r < rows; r++ {

                for c := 0; c < cols; c++ {

                        visited[r][c] = false

                }

        }

        for r := 0; r < rows; r++ {

                if board[r][0] == 'X' {

                        stack := []point{{r, 0}}

                        visited[r][0] = true

                        for len(stack) > 0 {

                                p := stack[len(stack)-1]

                                stack = stack[:len(stack)-1]

                                if p.c == cols-1 {

                                        return "X", nil

                                }

                                neighbors := []point{

                                        {p.r - 1, p.c},

                                        {p.r + 1, p.c},

                                        {p.r - 1, p.c + 1},

                                        {p.r + 1, p.c - 1},

                                        {p.r, p.c - 1},

                                        {p.r, p.c + 1},

                                }

                                for _, n := range neighbors {

                                        if n.r >= 0 && n.r < rows && n.c >= 0 && n.c < cols {

                                                if !visited[n.r][n.c] && board[n.r][n.c] == 'X' {

                                                        visited[n.r][n.c] = true

                                                        stack = append(stack, n)

                                                }

                                        }

                                }

                        }

                }

        }



        return "", nil

}

