//
// This is the implementation of the 'Zebra Puzzle' exercise.
//

export class ZebraPuzzle {
  constructor() {
    this.solution = this.solve();
  }

  // Solve the puzzle and return the solution mapping
  solve() {
    const colors = ['red', 'green', 'ivory', 'yellow', 'blue'];
    const nationalities = ['Englishman', 'Spaniard', 'Ukrainian', 'Norwegian', 'Japanese'];
    const pets = ['dog', 'snail', 'fox', 'horse', 'zebra'];
    const drinks = ['coffee', 'tea', 'milk', 'orange juice', 'water'];
    const hobbies = ['dancing', 'painter', 'reading', 'football', 'chess'];

    // We'll assign houses 0..4 (left to right)
    // Each house: {color, nationality, pet, drink, hobby}
    const houses = [];

    // Helper: check partial assignment consistency with given constraints
    const consistent = (houses) => {
      const n = houses.length;
      // Rule 10: Norwegian in house 0
      if (n >= 1 && houses[0].nationality && houses[0].nationality !== 'Norwegian') return false;
      // Rule 9: middle house (index 2) drinks milk
      if (n >= 3 && houses[2].drink && houses[2].drink !== 'milk') return false;
      // Rule 6: green immediately right of ivory
      for (let i = 0; i < n - 1; i++) {
