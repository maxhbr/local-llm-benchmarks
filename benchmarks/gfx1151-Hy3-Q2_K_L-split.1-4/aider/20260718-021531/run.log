matrix.go
```
package matrix

import (
	"errors"
	"strconv"
	"strings"
)

// Matrix represents a 2D matrix of integers.
type Matrix [][]int

func New(s string) (Matrix, error) {
	lines := strings.Split(s, "\n")
	mat := make(Matrix, 0, len(lines))
	for _, line := range lines {
		line = strings.TrimSpace(line)
		if line == "" {
			return nil, errors.New("empty row in matrix")
		}
		fields := strings.Fields(line)
		row := make([]int, len(fields))
		for i, f := range fields {
			val, err := strconv.Atoi(f)
			if err != nil {
				return nil, errors.New("invalid number in matrix")
			}
			row[i] = val
		}
		mat = append(mat, row)
	}
	if len(mat) == 0 {
		return nil, errors.New("empty matrix")
	}
	// Ensure rectangular shape
	width := len(mat[0])
	for _, row := range mat {
		if len(row) != width {
			return nil, errors.New("irregular matrix rows")
		}
	}
	return mat, nil
}

// Cols and Rows must return the results without affecting the matrix.
func (m Matrix) Cols() [][]int {
	if len(m) == 0 {
		return [][]int{}
	}
	cols := make([][]int, len(m[0]))
	for c := range cols {
		col := make([]int, len(m))
		for r := range m {
			col[r] = m[r][c]
		}
		cols[c] = col
	}
	return cols
}

func (m Matrix) Rows() [][]int {
	rows := make([][]int, len(m))
	for r := range m {
		// copy the row so the original matrix is not affected
		row := make([]int, len(m[r]))
		copy(row, m[r])
		rows[r] = row
	}
	return rows
}

func (m Matrix) Set(row, col, val int) bool {
	if row < 0 || row >= len(m) || len(m) == 0 {
		return false
	}
	if col < 0 || col >= len(m[0]) {
		return false
	}
	m[row][col] = val
	return true
}
```
