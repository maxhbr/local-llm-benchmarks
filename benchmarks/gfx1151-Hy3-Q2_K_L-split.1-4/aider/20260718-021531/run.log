  const discount = DISCOUNTS[count] || 0;
  return Math.floor(count * PRICE_PER_BOOK * (1 - discount));
}

export const cost = (books) => {
  if (books.length === 0) return 0;

  // Count occurrences of each book (1-5)
  const counts = [0, 0, 0, 0, 0];
  for (const b of books) {
    counts[b - 1] += 1;
  }

  let bestPrice = Infinity;

  // Explore all possible ways to group books into sets of distinct titles
  function buildGroups(remaining, currentGroups, currentPrice) {
    const totalLeft = remaining.reduce((a, b) => a + b, 0);
    if (totalLeft === 0) {
      if (currentPrice < bestPrice) bestPrice = currentPrice;
      return;
    }

    // Generate all possible groups from remaining distinct books
    const available = [];
    for (let i = 0; i < 5; i++) {
      if (remaining[i] > 0) available.push(i);
    }

    // Try every possible subset of available (size 1 to available.length)
    const maxSize = Math.min(available.length, 5);
    for (let size = 1; size <= maxSize; size++) {
      // Use recursive combination generation
      const combine = (start, combo) => {
        if (combo.length === size) {
          const newRemaining = remaining.slice();
          for (const idx of combo) newRemaining[idx] -= 1;
          const newPrice = currentPrice + groupCost(combo.map((i) => i + 1));
          buildGroups(newRemaining, currentGroups.concat([combo]), newPrice);
          return;
        }
        for (let i = start; i < available.length; i++) {
          combine(i + 1, combo.concat([available[i]]));
        }
      };
      combine(0, []);
    }
  }

  buildGroups(counts, [], 0);
  return bestPrice;
};
```

This version exhaustively tries every distinct subset of available books for each step, guaranteeing the optimal discount (as required by the problem). It uses only standard JavaScript and does not rely on any external packages.
