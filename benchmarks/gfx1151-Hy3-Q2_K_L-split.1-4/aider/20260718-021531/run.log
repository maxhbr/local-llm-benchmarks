```
class ConnectGame:

    def __init__(self, board):

        # Parse board into a 2D grid of characters

        self.grid = []

        for line in board.strip().splitlines():

            # Split by whitespace to get cells for the row

            cells = line.split()

            self.grid.append(cells)

        self.rows = len(self.grid)

        if self.rows > 0:

            self.cols = len(self.grid[0]) if self.grid[0] else 0

        else:

            self.cols = 0



    def get_winner(self):

        # Check if O (top to bottom) wins

        if self._winner_top_bottom('O'):

            return 'O'

        # Check if X (left to right) wins

        if self._winner_left_right('X'):

            return 'X'

        return ""



    def _winner_top_bottom(self, player):

        # player 'O' connects top row to bottom row

        if self.rows == 0 or self.cols == 0:

            return False

        visited = [[False] * self.cols for _ in range(self.rows)]

        stack = []

        for c in range(self.cols):

            if self.grid[0][c] == player:

                stack.append((0, c))

                visited[0][c] = True

        while stack:

            r, c = stack.pop()

            if r == self.rows - 1:

                return True

            for nr, nc in self._neighbors(r, c):

                if 0 <= nr < self.rows and 0 <= nc < self.cols:

                    if not visited[nr][nc] and self.grid[nr][nc] == player:

                        visited[nr][nc] = True

                        stack.append((nr, nc))

        return False



    def _winner_left_right(self, player):

        # player 'X' connects left column to right column

        if self.rows == 0 or self.cols == 0:

            return False

        visited = [[False] * self.cols for _ in range(self.rows)]

        stack = []

        for r in range(self.rows):

            if self.grid[r][0] == player:

                stack.append((r, 0))

                visited[r][0] = True

        while stack:

            r, c = stack.pop()

            if c == self.cols - 1:

                return True

            for nr, nc in self._neighbors(r, c):

                if 0 <= nr < self.rows and 0 <= nc < self.cols:

                    if not visited[nr][nc] and self.grid[nr][nc] == player:

                        visited[nr][nc] = True

                        stack.append((nr, nc))

        return False



    def _neighbors(self, r, c):

        # Hex neighbors in parallelogram representation (row r indented by r spaces)

        return [

            (r-1, c), (r-1, c+1),

            (r, c-1), (r, c+1),

            (r+1, c-1), (r+1, c)

        ]

```

