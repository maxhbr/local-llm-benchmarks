beer_song.go
```
package beer

import (
	"errors"
	"fmt"
	"strings"
)

func Song() string {
	s, _ := Verses(99, 0)
	return s
}

func Verses(start, stop int) (string, error) {
	if start < 0 || start > 99 || stop < 0 || stop > 99 || start < stop {
		return "", errors.New("invalid range")
	}
	var verses []string
	for i := start; i >= stop; i-- {
		v, err := Verse(i)
		if err != nil {
			return "", err
		}
		verses = append(verses, v)
	}
	return strings.Join(verses, "\n\n"), nil
}

func Verse(n int) (string, error) {
	if n < 0 || n > 99 {
		return "", errors.New("verse out of range")
	}
	var subject, nextSubject, action string
	if n == 0 {
		subject = "No more bottles of beer"
		nextSubject = "no more bottles of beer"
		action = "Go to the store and buy some more, 99 bottles of beer on the wall."
	} else {
		if n == 1 {
			subject = "1 bottle of beer"
			nextSubject = "no more bottles of beer"
			action = "Take it down and pass it around, no more bottles of beer on the wall."
		} else {
			subject = fmt.Sprintf("%d bottles of beer", n)
			nextSubject = fmt.Sprintf("%d bottles of beer", n-1)
			if n-1 == 1 {
				nextSubject = "1 bottle of beer"
			}
			action = fmt.Sprintf("Take one down and pass it around, %s on the wall.", nextSubject)
		}
	}
	if n == 0 {
		return fmt.Sprintf("%s on the wall, %s.\n%s", subject, nextSubject, action), nil
	}
	return fmt.Sprintf("%s on the wall, %s.\n%s", subject, subject, action), nil
}
