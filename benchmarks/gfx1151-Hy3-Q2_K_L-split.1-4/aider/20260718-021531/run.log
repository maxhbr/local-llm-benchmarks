def _find(self, label):
    if self.label == label:
        return self
    for c in self.children:
        res = c._find(label)
        if res: return res
    return None

def from_pov(self, from_node):
    def find_path(node, target):
        if node.label == target:
            return [node]
        for child in node.children:
            res = find_path(child, target)
            if res: return [node] + res
        return None
    path = find_path(self, from_node)
    if path is None:
        raise ValueError("Tree could not be reoriented")
    # Build reparented tree with target as root
    def build(idx):
        node = path[idx]
        if idx == len(path) - 1:
            # target: original children plus parent tree if exists
            children = list(node.children)
            if idx > 0:
                parent_tree = build(idx - 1)
                children.append(parent_tree)
            return Tree(node.label, children)
        else:
            # node above target: its children are other original children + tree below
            below = build(idx + 1)
            other = [c for c in node.children if c.label != path[idx+1].label]
            return Tree(node.label, other + [below])
    return build(len(path) - 1)

def path_to(self, from_node, to_node):
    if self._find(from_node) is None:
        raise ValueError("Tree could not be reoriented")
    if self._find(to_node) is None:
        raise ValueError("No path found")
    # find paths from root to each node
    def root_to(target):
        # returns list of labels from root to target
        def dfs(node, target, acc):
            acc.append(node.label)
            if node.label == target:
                return acc
            for child in node.children:
                res = dfs(child, target, acc)
                if res: return res
            acc.pop()
            return None
        return dfs(self, target, [])
    from_path = root_to(from_node)
    to_path = root_to(to_node)
    # combine: reverse from_path without last, + to_path
    path = list(reversed(from_path[:-1])) + to_path
    return path
