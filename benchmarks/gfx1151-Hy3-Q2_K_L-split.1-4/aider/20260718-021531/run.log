bottle-song.js
```
//
// This is only a SKELETON file for the 'Bottle Song' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

const numberWords = [
  'no', 'one', 'two', 'three', 'four', 'five',
  'six', 'seven', 'eight', 'nine', 'ten'
];

export const recite = (initialBottlesCount, takeDownCount) => {
  const lyrics = [];

  let current = initialBottlesCount;
  for (let i = 0; i < takeDownCount; i++) {
    const pluralCurrent = current === 1 ? 'bottle' : 'bottles';
    const next = current - 1;
    const pluralNext = next === 1 ? 'bottle' : 'bottles';
    const nextWord = next === 0 ? 'no' : numberWords[next];

    lyrics.push(`${capitalize(numberWords[current])} green ${pluralCurrent} hanging on the wall,`);
    lyrics.push(`${capitalize(numberWords[current])} green ${pluralCurrent} hanging on the wall,`);
    lyrics.push(`And if one green bottle should accidentally fall,`);
    lyrics.push(`There'll be ${nextWord} green ${pluralNext} hanging on the wall.`);

    if (i < takeDownCount - 1) {
      lyrics.push('');
    }

    current = next;
  }

  return lyrics;
};

function capitalize(word) {
  return word.charAt(0).toUpperCase() + word.slice(1);
}
```
