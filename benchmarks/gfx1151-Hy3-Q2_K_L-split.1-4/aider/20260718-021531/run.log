+from functools import lru_cache
+
+DISCOUNTS = {1: 0.0, 2: 0.05, 3: 0.10, 4: 0.20, 5: 0.25}
+BOOK_PRICE = 8.0
+
+@lru_cache(maxsize=None)
+def _min_cost(counts):
+    # counts is a tuple of 5 ints: copies remaining for each book
+    if all(c == 0 for c in counts):
+        return 0.0
+    # Option 1: charge individually (no grouping) - not optimal but baseline
+    # Actually we always try to group as many as possible first.
+    best = sum(counts) * BOOK_PRICE  # worst case: no discount
+    # Try to form a group of size k (1..5) using distinct books we have
+    # Generate all possible combinations of distinct books (subsets of available)
+    # But simpler: try to take one of each for group sizes from 5 down to 1
+    for size in range(5, 0, -1):
+        # pick any 'size' distinct books that have count > 0
+        # we can just iterate over combinations of indices
+        indices = [i for i in range(5) if counts[i] > 0]
+        # if we have at least 'size' distinct, we can form a group
+        if len(indices) >= size:
+            from itertools import combinations
+            for combo in combinations(indices, size):
+                new_counts = list(counts)
+                for i in combo:
+                    new_counts[i] -= 1
+                group_cost = size * BOOK_PRICE * (1 - DISCOUNTS[size])
+                total = group_cost + _min_cost(tuple(new_counts))
+                if total < best:
+                    best = total
+    return best
