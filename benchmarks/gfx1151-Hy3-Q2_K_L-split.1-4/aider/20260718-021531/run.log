VariableLengthQuantity.java
```
import java.util.List;
import java.util.ArrayList;

class VariableLengthQuantity {

    List<String> encode(List<Long> numbers) {
        List<String> result = new ArrayList<>();
        for (Long number : numbers) {
            // Restrict to 32-bit unsigned integer range
            long value = number & 0xFFFFFFFFL;
            List<Integer> bytes = new ArrayList<>();
            bytes.add((int) (value & 0x7F));
            value >>= 7;
            while (value > 0) {
                bytes.add(0, (int) ((value & 0x7F) | 0x80));
                value >>= 7;
            }
            for (Integer b : bytes) {
                result.add(String.format("%02X", b));
            }
        }
        return result;
    }

    List<String> decode(List<Long> bytes) {
        List<String> result = new ArrayList<>();
        long value = 0;
        boolean continuation = false;
        for (Long b : bytes) {
            int byteVal = (int) (b & 0xFF);
            if ((byteVal & 0x80) != 0) {
                value = (value << 7) | (byteVal & 0x7F);
                continuation = true;
            } else {
                value = (value << 7) | byteVal;
                result.add(String.format("%08X", value & 0xFFFFFFFFL));
                value = 0;
                continuation = false;
            }
        }
        if (continuation) {
            throw new IllegalArgumentException("Incomplete VLQ sequence");
        }
        return result;
    }
}
```
