import re

def answer(question):
    if not question.endswith('?'):
        raise ValueError("syntax error")
    q = question[:-1].strip()
    if not q.startswith("What is"):
        raise ValueError("unknown operation")
    q = q[len("What is"):].strip()
    if q == "":
        raise ValueError("syntax error")

    tokens = q.split()
    if not tokens:
        raise ValueError("syntax error")

    try:
        current = int(tokens[0])
    except ValueError:
        raise ValueError("syntax error")

    if len(tokens) == 1:
        return current

    operations = {
        "plus": lambda a, b: a + b,
        "minus": lambda a, b: a - b,
        "multiplied": lambda a, b: a * b,
        "divided": lambda a, b: a // b,
    }

    i = 1
    while i < len(tokens):
        op_word = tokens[i]
        if op_word in ("multiplied", "divided"):
            if i + 1 >= len(tokens) or tokens[i + 1] != "by":
                raise ValueError("syntax error")
            op = operations[op_word]
            i += 2
        elif op_word in operations:
            op = operations[op_word]
            i += 1
        else:
            # op_word is not a known operation word
            try:
                int(op_word)
                # it's a number where an operation was expected
                raise ValueError("syntax error")
            except ValueError:
                # not a number, so it's an unknown operation word
                raise ValueError("unknown operation")

        if i >= len(tokens):
            raise ValueError("syntax error")
        try:
            num = int(tokens[i])
        except ValueError:
            raise ValueError("syntax error")
        current = op(current, num)
        i += 1

    return current
