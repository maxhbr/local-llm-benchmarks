I need to implement the `Solve` function in `alphametics.go` to solve alphametics puzzles according to the instructions. The current file just has a panic stub.

I'll write a Go implementation that:
1. Parses the puzzle string to extract words (left of `+` and right of `==`).
2. Collects unique letters.
3. Uses backtracking to assign digits 0-9 to letters, ensuring leading digits aren't zero and all digits distinct.
4. Checks if the sum of left terms equals the right term.
5. Returns the mapping or an error if no solution.

Below is the full updated file.

alphametics.go
```
package alphametics

import (
	"errors"
	"strings"
)

func Solve(puzzle string) (map[string]int, error) {
	// Split puzzle into left and right of "=="
	parts := strings.Split(puzzle, "==")
	if len(parts) != 2 {
		return nil, errors.New("invalid puzzle format")
	}
	left := strings.TrimSpace(parts[0])
	right := strings.TrimSpace(parts[1])

	// Split left terms by '+'
	leftTerms := strings.Split(left, "+")
	for i := range leftTerms {
		leftTerms[i] = strings.TrimSpace(leftTerms[i])
	}
	right = strings.TrimSpace(right)

	// Collect all unique letters and leading letters (cannot be zero)
	lettersSet := make(map[rune]bool)
	leadingSet := make(map[rune]bool)
	allWords := append(leftTerms, right)
	for _, w := range allWords {
		if len(w) == 0 {
			return nil, errors.New("invalid empty word")
		}
		leadingSet[rune(w[0])] = true
		for _, ch := range w {
			lettersSet[rune(ch)] = true
		}
	}
	letters := make([]rune, 0, len(lettersSet))
	for ch := range lettersSet {
		letters = append(letters, ch)
	}
	if len(letters) > 10 {
		return nil, errors.New("too many letters for digits")
	}

	// Prepare structures for backtracking
	solution := make(map[string]int)
	used := make([]bool, 10)
	var assign func(idx int) bool
	assign = func(idx int) bool {
		if idx == len(letters) {
			// Evaluate sum
			sumLeft := 0
			for _, term := range leftTerms {
				num := 0
				for _, ch := range term {
					num = num*10 + solution[string(ch)]
				}
				sumLeft += num
			}
			numRight := 0
			for _, ch := range right {
				numRight = numRight*10 + solution[string(ch)]
			}
			if sumLeft == numRight {
				return true
			}
			return false
		}
		ch := letters[idx]
		for d := 0; d <= 9; d++ {
			if used[d] {
				continue
			}
			// Leading digit cannot be zero
			if d == 0 && leadingSet[ch] {
				continue
			}
			used[d] = true
			solution[string(ch)] = d
			if assign(idx + 1) {
				return true
			}
			used[d] = false
			delete(solution, string(ch))
		}
		return false
	}

	if assign(0) {
		return solution, nil
	}
	return nil, errors.New("no solution found")
}
```
