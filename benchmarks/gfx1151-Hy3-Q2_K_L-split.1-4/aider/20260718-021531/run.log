Applied edit to rest_api.py
response:
The tests expect `get` and `post` methods to return a **JSON string** (since they call `json.loads(response)`), but the current code returns Python dicts. Also, the IOU logic must correctly net symmetric debts between lender and borrower (the current code only nets if both already have entries, but the tests show that new IOUs should reduce existing opposite-direction debts). I'll rewrite `rest_api.py` to return JSON strings and handle debt netting properly.

rest_api.py
```
import json

class RestAPI:
    def __init__(self, database=None):
        self.users = {}
        if database and "users" in database:
            for user in database["users"]:
                self.users[user["name"]] = {
                    "name": user["name"],
                    "owes": dict(user.get("owes", {})),
                    "owed_by": dict(user.get("owed_by", {}))
                }

    def _user_object(self, name):
        user = self.users[name]
        owes = user["owes"]
        owed_by = user["owed_by"]
        balance = sum(owed_by.values()) - sum(owes.values())
        return {
            "name": name,
            "owes": owes,
            "owed_by": owed_by,
            "balance": round(balance, 10)
        }

    def get(self, url, payload=None):
        if url == "/users":
            if payload is None:
                names = sorted(self.users.keys())
                return json.dumps({"users": [self._user_object(n) for n in names]})
            else:
                data = json.loads(payload) if isinstance(payload, str) else payload
                names = sorted(data.get("users", []))
                return json.dumps({"users": [self._user_object(n) for n in names if n in self.users]})
        return json.dumps({})

    def post(self, url, payload=None):
        data = json.loads(payload) if isinstance(payload, str) else payload
        if url == "/add":
            name = data["user"]
            if name not in self.users:
                self.users[name] = {"name": name, "owes": {}, "owed_by": {}}
            return json.dumps(self._user_object(name))
        elif url == "/iou":
            lender = data["lender"]
            borrower = data["borrower"]
            amount = float(data["amount"])
            l = self.users[lender]
            b = self.users[borrower]

            # Add new loan: borrower owes lender
            b["owes"][lender] = b["owes"].get(lender, 0.0) + amount
            l["owed_by"][borrower] = l["owed_by"].get(borrower, 0.0) + amount

            # Net symmetric debt between lender and borrower
            if lender in b["owes"] and borrower in l["owed_by"]:
                owe = b["owes"][lender]
                owed = l["owed_by"][borrower]
                if owe > owed:
                    b["owes"][lender] = owe - owed
                    del l["owed_by"][borrower]
                elif owed > owe:
                    l["owed_by"][borrower] = owed - owe
                    del b["owes"][lender]
                else:
                    del b["owes"][lender]
                    del l["owed_by"][borrower]

            # Remove zero/empty entries
            if lender in b["owes"] and b["owes"][lender] == 0:
                del b["owes"][lender]
            if borrower in l["owed_by"] and l["owed_by"][borrower] == 0:
                del l["owed_by"][borrower]

            names = sorted([lender, borrower])
            return json.dumps({"users": [self._user_object(n) for n in names]})
        return json.dumps({})
```
