 #include "diamond.h"
+#include <string>
+#include <vector>
+#include <cctype>
 
 namespace diamond {
 
+std::string make_diamond(char letter) {
+    letter = static_cast<char>(toupper(letter));
+    int n = letter - 'A';  // zero-based index of letter
+    int size = 2 * n + 1;
+    std::vector<std::string> rows;
+    rows.reserve(size);
+
+    for (int i = 0; i <= n; ++i) {
+        char c = static_cast<char>('A' + i);
+        std::string row(size, ' ');
+        int mid = n;
+        row[mid - i] = c;
