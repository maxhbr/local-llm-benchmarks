+std::unordered_set<std::string> allergy_test::get_allergies() const {
+    std::unordered_set<std::string> result;
+    for (const auto& pair : allergen_values) {
+        if ((score_ & pair.second) != 0) {
+            result.emplace(pair.first);
+        }
+    }
+    return result;
+}
+
 }  // namespace allergies
