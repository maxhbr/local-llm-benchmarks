Rational.java
```
import java.util.Objects;

class Rational {

    private final int numerator;
    private final int denominator;

    Rational(int numerator, int denominator) {
        if (denominator == 0) {
            throw new ArithmeticException("Denominator cannot be zero");
        }
        // Reduce to lowest terms and ensure denominator is positive
        int gcd = gcd(Math.abs(numerator), Math.abs(denominator));
        int num = numerator / gcd;
        int den = denominator / gcd;
        if (den < 0) {
            num = -num;
            den = -den;
        }
        this.numerator = num;
        this.denominator = den;
    }

    private static int gcd(int a, int b) {
        a = Math.abs(a);
        b = Math.abs(b);
        while (b != 0) {
            int temp = b;
            b = a % b;
            a = temp;
        }
        return a;
    }

    int getNumerator() {
        return this.numerator;
    }

    int getDenominator() {
        return this.denominator;
    }

    Rational add(Rational other) {
        int num = this.numerator * other.denominator + other.numerator * this.denominator;
        int den = this.denominator * other.denominator;
        return new Rational(num, den);
    }

    Rational subtract(Rational other) {
        int num = this.numerator * other.denominator - other.numerator * this.denominator;
        int den = this.denominator * other.denominator;
        return new Rational(num, den);
    }

    Rational multiply(Rational other) {
        int num = this.numerator * other.numerator;
        int den = this.denominator * other.denominator;
        return new Rational(num, den);
    }

    Rational divide(Rational other) {
        if (other.numerator == 0) {
            throw new ArithmeticException("Cannot divide by zero rational");
        }
        int num = this.numerator * other.denominator;
        int den = this.denominator * other.numerator;
        return new Rational(num, den);
    }

    Rational abs() {
        return new Rational(Math.abs(this.numerator), Math.abs(this.denominator));
    }

    Rational pow(int power) {
        if (power >= 0) {
            return new Rational(
                (int) Math.pow(this.numerator, power),
                (int) Math.pow(this.denominator, power)
            );
        } else {
            int m = -power;
            return new Rational(
                (int) Math.pow(this.denominator, m),
                (int) Math.pow(this.numerator, m)
            );
        }
    }

    double exp(double exponent) {
        return Math.pow(this.numerator, exponent) / Math.pow(this.denominator, exponent);
    }

    double exp(double base, Rational exponent) {
        return Math.pow(base, (double) this.numerator / this.denominator);
    }

    @Override
    public String toString() {
        return String.format("%d/%d", this.getNumerator(), this.getDenominator());
    }

    @Override
    public boolean equals(Object obj) {
        if (obj instanceof Rational other) {
            return this.getNumerator() == other.getNumerator()
                    && this.getDenominator() == other.getDenominator();
        }

        return false;
    }

    @Override
    public int hashCode() {
        return Objects.hash(this.getNumerator(), this.getDenominator());
    }
}
```

Note: The instructions mention "exponentiation of a real number to a rational number" as an operation. The supplied `Rational` class originally only had `exp(double exponent)` (rational to real power). I added an extra `exp(double base, Rational exponent)` method to cover the real-number-to-rational-power case, while keeping the original `exp(double exponent)` method signature intact. If you prefer to keep strictly to the original method signatures, you could instead implement that as a static method or outside the class, but the above fulfills the required operations within the class. Let me know if you'd like it adjusted.
