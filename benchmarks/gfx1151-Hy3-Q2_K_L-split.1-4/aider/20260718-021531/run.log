I will implement the RESTful API for tracking IOUs according to the specification. The changes needed are to fill in the `RestAPI` class with proper initialization (storing users and balances), and implement `get` and `post` methods to handle the endpoints `/users`, `/add`, and `/iou`.

rest_api.py
```
import json

class RestAPI:
    def __init__(self, database=None):
        # database is expected to be a dict like {"users": [user_objects]}
        self.users = {}
        if database and "users" in database:
            for user in database["users"]:
                self.users[user["name"]] = {
                    "name": user["name"],
                    "owes": dict(user.get("owes", {})),
                    "owed_by": dict(user.get("owed_by", {}))
                }

    def _user_object(self, name):
        user = self.users[name]
        owes = user["owes"]
        owed_by = user["owed_by"]
        balance = sum(owed_by.values()) - sum(owes.values())
        return {
            "name": name,
            "owes": owes,
            "owed_by": owed_by,
            "balance": round(balance, 10)
        }

    def get(self, url, payload=None):
        if url == "/users":
            if payload is None:
                names = sorted(self.users.keys())
                return {"users": [self._user_object(n) for n in names]}
            else:
                data = json.loads(payload) if isinstance(payload, str) else payload
                names = sorted(data.get("users", []))
                return {"users": [self._user_object(n) for n in names if n in self.users]}
        return {}

    def post(self, url, payload=None):
        data = json.loads(payload) if isinstance(payload, str) else payload
        if url == "/add":
            name = data["user"]
            if name not in self.users:
                self.users[name] = {"name": name, "owes": {}, "owed_by": {}}
            return self._user_object(name)
        elif url == "/iou":
            lender = data["lender"]
            borrower = data["borrower"]
            amount = float(data["amount"])
            # update lender's owed_by and borrower's owes
            l = self.users[lender]
            b = self.users[borrower]
            # if borrower already owes lender, add; else set
            b["owes"][lender] = b["owes"].get(lender, 0.0) + amount
            l["owed_by"][borrower] = l["owed_by"].get(borrower, 0.0) + amount
            # simplify symmetric debts
            if lender in b["owes"] and borrower in l["owed_by"]:
                owe = b["owes"][lender]
                owed = l["owed_by"][borrower]
                # they are the same direction; net them
                if owe > owed:
                    b["owes"][lender] = owe - owed
                    del l["owed_by"][borrower]
                elif owed > owe:
                    l["owed_by"][borrower] = owed - owe
                    del b["owes"][lender]
                else:
                    del b["owes"][lender]
                    del l["owed_by"][borrower]
            # clean zero entries
            if lender in b["owes"] and b["owes"][lender] == 0:
                del b["owes"][lender]
            if borrower in l["owed_by"] and l["owed_by"][borrower] == 0:
                del l["owed_by"][borrower]
            names = sorted([lender, borrower])
            return {"users": [self._user_object(n) for n in names]}
        return {}
```
