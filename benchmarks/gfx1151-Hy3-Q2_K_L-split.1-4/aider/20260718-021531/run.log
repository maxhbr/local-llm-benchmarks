#[derive(Debug, PartialEq, Eq)]
pub enum Error {
    IncompleteNumber,
}

/// Convert a list of numbers to a stream of bytes encoded with variable length encoding.
pub fn to_bytes(values: &[u32]) -> Vec<u8> {
    let mut bytes = Vec::new();
    for &value in values {
        let mut v = value;
        // Extract 7-bit groups from LSB to MSB
        let mut groups = Vec::new();
        loop {
            let group = (v & 0x7F) as u8;
            groups.push(group);
            v >>= 7;
            if v == 0 {
                break;
            }
        }
        // groups are LSB first; iterate from MSB to LSB
        for (i, &group) in groups.iter().rev().enumerate() {
            if i < groups.len() - 1 {
                // Not the last byte: set bit 7 (continuation bit)
                bytes.push(group | 0x80);
            } else {
                // Last byte: bit 7 clear
                bytes.push(group);
            }
        }
    }
    bytes
}

/// Given a stream of bytes, extract all numbers which are encoded in there.
pub fn from_bytes(bytes: &[u8]) -> Result<Vec<u32>, Error> {
    let mut numbers = Vec::new();
    let mut current: u32 = 0;
    let mut shift: u32 = 0;
    let mut incomplete = false;

    for &byte in bytes {
        let is_last = (byte & 0x80) == 0;
        let payload = byte & 0x7F;
        current |= (payload as u32) << shift;
        shift += 7;

        if is_last {
            numbers.push(current);
            current = 0;
            shift = 0;
            incomplete = false;
        } else {
            incomplete = true;
        }
    }

    if incomplete {
        Err(Error::IncompleteNumber)
    } else {
        Ok(numbers)
    }
}
