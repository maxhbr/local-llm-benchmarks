public class Satellite {

    public Tree treeFromTraversals(List<Character> preorderInput, List<Character> inorderInput) {

        if (preorderInput == null || inorderInput == null) {

            throw new IllegalArgumentException("Traversal inputs cannot be null.");

        }

        if (preorderInput.size() != inorderInput.size()) {

            throw new IllegalArgumentException("Traversal lists must be the same size.");

        }

        Set<Character> preSet = new HashSet<>(preorderInput);

        Set<Character> inSet = new HashSet<>(inorderInput);

        if (!preSet.equals(inSet)) {

            throw new IllegalArgumentException("Traversal lists must contain the same elements.");

        }

        if (preSet.size() != preorderInput.size()) {

            throw new IllegalArgumentException("Traversal lists must not contain duplicates.");

        }

        if (preorderInput.isEmpty()) {

            return null;

        }

        Map<Character, Integer> inorderIndex = new HashMap<>();

        for (int i = 0; i < inorderInput.size(); i++) {

            inorderIndex.put(inorderInput.get(i), i);

        }

        return buildTree(preorderInput, inorderInput, 0, preorderInput.size() - 1, 0, inorderInput.size() - 1, inorderIndex);

    }



    private Tree buildTree(List<Character> preorder, List<Character> inorder,

                           int preStart, int preEnd, int inStart, int inEnd,

                           Map<Character, Integer> inorderIndex) {

        if (preStart > preEnd || inStart > inEnd) {

            return null;

        }

        Character rootValue = preorder.get(preStart);

        int rootInorderIndex = inorderIndex.get(rootValue);

        int leftSize = rootInorderIndex - inStart;



        Tree left = buildTree(preorder, inorder, preStart + 1, preStart + leftSize, inStart, rootInorderIndex - 1, inorderIndex);

        Tree right = buildTree(preorder, inorder, preStart + leftSize + 1, preEnd, rootInorderIndex + 1, inEnd, inorderIndex);



        return new Tree(rootValue, left, right);

    }

}

