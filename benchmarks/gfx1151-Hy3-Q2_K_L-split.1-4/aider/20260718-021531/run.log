class Scale:
    CHROMATIC_SHARP = ["A", "A♯", "B", "C", "C♯", "D", "D♯", "E", "F", "F♯", "G", "G♯"]
    CHROMATIC_FLAT = ["A", "B♭", "B", "C", "D♭", "D", "E♭", "E", "F", "G♭", "G", "A♭"]

    SHARP_TONICS = {"C", "G", "D", "A", "E", "B", "F♯", "e", "b", "f♯", "c♯", "g♯", "d♯"}
    FLAT_TONICS = {"F", "B♭", "E♭", "A♭", "D♭", "G♭", "d", "g", "c", "f", "b♭", "e♭"}
    NATURAL_MAJOR = "C"
    NATURAL_MINOR = "a"

    def __init__(self, tonic):
        # Normalize tonic: uppercase except keep 'b' lowercase for flats
        if tonic.endswith("b"):
            self.tonic = tonic[0].upper() + "♭"
        else:
            self.tonic = tonic[0].upper() + tonic[1:]

        if self.tonic in self.SHARP_TONICS or self.tonic == "C" or self.tonic == "a":
            self.use_flats = False
        elif self.tonic in self.FLAT_TONICS:
            self.use_flats = True
        else:
            # default to sharps for unknown/natural
            self.use_flats = False

    def _base_chromatic(self):
        if self.use_flats:
            return list(self.CHROMATIC_FLAT)
        else:
            return list(self.CHROMATIC_SHARP)

    def chromatic(self):
        base = self._base_chromatic()
        # find index of tonic in base
        idx = base.index(self.tonic)
        # rotate so tonic is first
        rotated = base[idx:] + base[:idx]
        return rotated

    def interval(self, intervals):
        chrom = self.chromatic()
        notes = [chrom[0]]
        current_idx = 0
        for iv in intervals:
            if iv == "m":
                step = 1
            elif iv == "M":
                step = 2
            elif iv == "A":
                step = 3
            else:
                step = 1  # default half step for unknown
            current_idx = (current_idx + step) % len(chrom)
            notes.append(chrom[current_idx])
        return notes
