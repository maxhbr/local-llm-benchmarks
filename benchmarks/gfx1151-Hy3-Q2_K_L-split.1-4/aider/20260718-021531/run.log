//
// This is only a SKELETON file for the 'Parallel Letter Frequency' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

import { Worker } from 'node:worker_threads';
import { fileURLToPath } from 'node:url';

export const parallelLetterFrequency = async (texts) => {
  const workers = texts.map(
    (text) =>
      new Promise((resolve, reject) => {
        const worker = new Worker(fileURLToPath(import.meta.url), {
          workerData: text,
        });
        worker.on('message', resolve);
        worker.on('error', reject);
        worker.on('exit', (code) => {
          if (code !== 0) {
            reject(new Error(`Worker stopped with exit code ${code}`));
          }
        });
      })
  );

  const results = await Promise.all(workers);

  const total = {};
  for (const freq of results) {
    for (const [letter, count] of Object.entries(freq)) {
      total[letter] = (total[letter] || 0) + count;
    }
  }
  return total;
};

if (!process.env.WORKER_MODE) {
  // This block is not used in the main thread; it's just a marker.
} else {
  // Worker code
  const { parentPort, workerData } = require('node:worker_threads');
  const text = workerData;
  const freq = {};
  for (const char of text.toLowerCase()) {
    if (/[a-z]/.test(char)) {
      freq[char] = (freq[char] || 0) + 1;
    }
  }
  parentPort.postMessage(freq);
}
```

