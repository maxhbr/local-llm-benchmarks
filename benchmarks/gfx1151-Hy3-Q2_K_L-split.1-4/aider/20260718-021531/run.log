circular_buffer.h
```
#if !defined(CIRCULAR_BUFFER_H)
#define CIRCULAR_BUFFER_H

#include <vector>
#include <stdexcept>

namespace circular_buffer {

template<typename T>
class circular_buffer {
public:
    explicit circular_buffer(size_t size) : size_(size), data_(size), head_(0), tail_(0), full_(false) {}
    void write(const T& value) {
        if (full_) {
            throw std::domain_error("buffer full");
        }
        data_[head_] = value;
        head_ = (head_ + 1) % size_;
        if (head_ == tail_) {
            full_ = true;
        }
    }
    void overwrite(const T& value) {
        if (full_) {
            data_[tail_] = value;
            tail_ = (tail_ + 1) % size_;
            head_ = tail_;
        } else {
            data_[head_] = value;
            head_ = (head_ + 1) % size_;
            if (head_ == tail_) {
                full_ = true;
            }
        }
    }
    T read() {
        if (!full_ && head_ == tail_) {
            throw std::domain_error("buffer empty");
        }
        T val = data_[tail_];
        tail_ = (tail_ + 1) % size_;
        full_ = false;
        return val;
    }
    void clear() {
        head_ = tail_ = 0;
        full_ = false;
    }

private:
    size_t size_;
    std::vector<T> data_;
    size_t head_;
    size_t tail_;
    bool full_;
};

}  // namespace circular_buffer

#endif // CIRCULAR_BUFFER_H
```

