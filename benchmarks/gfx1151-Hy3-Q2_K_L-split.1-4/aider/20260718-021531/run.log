say.js
```
//
// This is only a SKELETON file for the 'Say' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

const ONES = [
  'zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine',
  'ten', 'eleven', 'twelve', 'thirteen', 'fourteen', 'fifteen', 'sixteen',
  'seventeen', 'eighteen', 'nineteen'
];
const TENS = ['', '', 'twenty', 'thirty', 'forty', 'fifty', 'sixty', 'seventy', 'eighty', 'ninety'];
const SCALES = ['', 'thousand', 'million', 'billion', 'trillion'];

function spellBelow1000(n) {
  if (n < 20) return ONES[n];
  const tens = Math.floor(n / 10);
  const ones = n % 10;
  let word = TENS[tens];
  if (ones > 0) word += '-' + ONES[ones];
  return word;
}

function spellChunk(n) {
  // n is between 0 and 999 inclusive
  if (n === 0) return '';
  if (n < 100) return spellBelow1000(n);
  const hundreds = Math.floor(n / 100);
  const rest = n % 100;
  let word = ONES[hundreds] + ' hundred';
  if (rest > 0) word += ' ' + spellBelow1000(rest);
  return word;
}

export const say = (n) => {
  if (!Number.isInteger(n) || n < 0 || n > 999999999999) {
    throw new Error('Number out of range (0 to 999,999,999,999)');
  }
  if (n === 0) return 'zero';

  const chunks = [];
  let remaining = n;
  while (remaining > 0) {
    chunks.unshift(remaining % 1000);
    remaining = Math.floor(remaining / 1000);
  }

  const words = [];
  const scaleCount = chunks.length;
  chunks.forEach((chunk, idx) => {
    const scaleIndex = scaleCount - 1 - idx;
    if (chunk === 0) return;
    const chunkWord = spellChunk(chunk);
    const scaleWord = SCALES[scaleIndex];
    let phrase = chunkWord;
    if (scaleWord) phrase += ' ' + scaleWord;
    words.push(phrase);
  });

  return words.join(' ');
};
```
