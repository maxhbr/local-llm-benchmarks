use std::cmp::Ordering;

use std::ops::{Add, Sub, Mul};

use std::str::FromStr;



/// Arbitrary-precision decimal number.

#[derive(Debug, Clone)]

pub struct Decimal {

    digits: String,

    negative: bool,

    scale: usize,

}



impl Decimal {

    pub fn try_from(input: &str) -> Option<Decimal> {

        Self::from_str(input).ok()

    }



    fn align(&self, other: &Decimal) -> (String, String, usize) {

        let scale = self.scale.max(other.scale);

        (self.with_scale(scale), other.with_scale(scale), scale)

    }



    fn with_scale(&self, target_scale: usize) -> String {

        if self.scale == target_scale {

            return self.digits.clone();

        }

        if self.scale < target_scale {

            let diff = target_scale - self.scale;

            let mut d = self.digits.clone();

            for _ in 0..diff {

                d.push('0');

            }

            d

        } else {

            let diff = self.scale - target_scale;

            if diff >= self.digits.len() {

                let mut d = String::new();

                for _ in 0..(diff - self.digits.len() + 1) {

                    d.push('0');

                }

                d

            } else {

                self.digits[..self.digits.len() - diff].to_string()

            }

        }

    }



    fn normalize(&mut self) {

        if self.scale > 0 {

            let mut i = self.digits.len() - 1;

            let mut trimmed = 0;

            while i > 0 && self.digits.chars().nth(i).unwrap() == '0' && trimmed < self.scale {

                trimmed += 1;

                i -= 1;

            }

            if trimmed > 0 {

                self.digits.truncate(self.digits.len() - trimmed);

                self.scale -= trimmed;

            }

        }

        let first_non_zero = self.digits.find(|c| c != '0').unwrap_or(self.digits.len());

        if first_non_zero > 0 {

            self.digits = self.digits[first_non_zero..].to_string();

            if self.digits.is_empty() {

                self.digits = "0".to_string();

                self.negative = false;

            }

        }

    }

}



impl FromStr for Decimal {

    type Err = ();

    fn from_str(input: &str) -> Result<Self, ()> {

        let input = input.trim();

        if input.is_empty() { return Err(()); }

        let (negative, body) = if let Some(s) = input.strip_prefix('-') { (true, s) }

            else if let Some(s) = input.strip_prefix('+') { (false, s) }

            else { (false, input) };

        let (int_part, frac_part) = match body.find('.') {

            Some(idx) => (body[..idx].to_string(), body[idx+1..].to_string()),

            None => (body.to_string(), String::new()),

        };

        if int_part.is_empty() || !int_part.chars().all(|c| c.is_ascii_digit()) { return Err(()); }

        if !frac_part.chars().all(|c| c.is_ascii_digit()) { return Err(()); }

        let scale = frac_part.len();

        let mut dec = Decimal { digits: format!("{}{}", int_part, frac_part), negative, scale };

        dec.normalize();

        Ok(dec)

    }

}



