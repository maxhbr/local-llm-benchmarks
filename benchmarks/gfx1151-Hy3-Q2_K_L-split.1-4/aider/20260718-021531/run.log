package palindrome

import (
	"errors"
	"strconv"
)

// Product represents a palindrome product with its factor pairs.
type Product struct {
	Value        int
	FactorPairs  [][2]int
}

// isPalindrome checks if a number reads the same forwards and backwards.
func isPalindrome(n int) bool {
	s := strconv.Itoa(n)
	for i, j := 0, len(s)-1; i < j; i, j = i+1, j-1 {
		if s[i] != s[j] {
			return false
		}
	}
	return true
}

// Products returns the smallest and largest palindrome products with their factor pairs.
func Products(fmin, fmax int) (Product, Product, error) {
	if fmin > fmax {
		return Product{}, Product{}, errors.New("fmin cannot be greater than fmax")
	}

	smallest := Product{Value: -1}
	largest := Product{Value: -1}

	for i := fmin; i <= fmax; i++ {
		for j := i; j <= fmax; j++ {
			product := i * j
			if isPalindrome(product) {
				if smallest.Value == -1 || product < smallest.Value {
					smallest = Product{Value: product, FactorPairs: [][2]int{{i, j}}}
				} else if product == smallest.Value {
					smallest.FactorPairs = append(smallest.FactorPairs, [2]int{i, j})
				}
				if product > largest.Value {
					largest = Product{Value: product, FactorPairs: [][2]int{{i, j}}}
				} else if product == largest.Value {
					largest.FactorPairs = append(largest.FactorPairs, [2]int{i, j})
				}
			}
		}
	}

	if smallest.Value == -1 || largest.Value == -1 {
		return Product{}, Product{}, errors.New("no palindrome products found in the given range")
	}

	return smallest, largest, nil
}
```
