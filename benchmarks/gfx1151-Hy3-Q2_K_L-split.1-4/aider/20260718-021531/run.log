```
use anyhow::{Error, Context};
use std::fs;

/// While using `&[&str]` to handle flags is convenient for exercise purposes,
/// and resembles the output of [`std::env::args`], in real-world projects it is
/// both more convenient and more idiomatic to contain runtime configuration in
/// a dedicated struct. Therefore, we suggest that you do so in this exercise.
///
/// [`std::env::args`]: https://doc.rust-lang.org/std/env/fn.args.html
#[derive(Debug, Default)]
pub struct Flags {
    pub number: bool,      // -n
    pub files_with_matches: bool, // -l
    pub ignore_case: bool, // -i
    pub invert: bool,      // -v
    pub exact: bool,       // -x
}

impl Flags {
    pub fn new(flags: &[&str]) -> Self {
        let mut f = Flags::default();
        for flag in flags {
            match *flag {
                "-n" => f.number = true,
                "-l" => f.files_with_matches = true,
                "-i" => f.ignore_case = true,
                "-v" => f.invert = true,
                "-x" => f.exact = true,
                _ => {}
            }
        }
        f
    }
}

pub fn grep(pattern: &str, flags: &Flags, files: &[&str]) -> Result<Vec<String>, Error> {
    let mut results = Vec::new();

    // Prepare search pattern based on case sensitivity
    let search_pattern = if flags.ignore_case {
        pattern.to_lowercase()
    } else {
        pattern.to_string()
    };

    for file in files {
        let content = fs::read_to_string(file)
            .with_context(|| format!("failed to read file {}", file))?;

        let mut file_matched = false;

        for (idx, line) in content.lines().enumerate() {
            let compare_line = if flags.ignore_case {
                line.to_lowercase()
            } else {
                line.to_string()
            };

            let matches = if flags.exact {
                compare_line == search_pattern
            } else {
                compare_line.contains(&search_pattern)
            };

            let is_match = if flags.invert { !matches } else { matches };

            if is_match {
                file_matched = true;
                if flags.files_with_matches {
                    // Only output filename once per file
                    if !results.contains(&file.to_string()) {
                        results.push(file.to_string());
                    }
                    break; // move to next file
                } else {
                    let mut output_line = String::new();
                    if files.len() > 1 {
                        output_line.push_str(&format!("{}:", file));
                    }
                    if flags.number {
                        output_line.push_str(&format!("{}:", idx + 1));
                    }
                    output_line.push_str(line);
                    results.push(output_line);
                }
            }
        }

        if flags.files_with_matches && file_matched && !results.contains(&file.to_string()) {
            results.push(file.to_string());
        }
    }

    Ok(results)
}
```
