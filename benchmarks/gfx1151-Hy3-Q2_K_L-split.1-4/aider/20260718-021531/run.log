class BottleSong {

    String recite(int startBottles, int takeDown) {
        StringBuilder result = new StringBuilder();
        int current = startBottles;
        for (int i = 0; i < takeDown; i++) {
            int next = current - 1;
            String currentWord = numberToWords(current);
            String nextWord = next == 0 ? "no" : numberToWords(next);
            String bottleCurrent = current == 1 ? "bottle" : "bottles";
            String bottleNext = next == 1 ? "bottle" : "bottles";

            result.append(capitalize(currentWord))
                  .append(" green ")
                  .append(bottleCurrent)
                  .append(" hanging on the wall,\n");
            result.append(capitalize(currentWord))
                  .append(" green ")
                  .append(bottleCurrent)
                  .append(" hanging on the wall,\n");
            result.append("And if one green bottle should accidentally fall,\n");
            result.append("There'll be ")
                  .append(nextWord)
                  .append(" green ")
                  .append(bottleNext)
                  .append(" hanging on the wall.\n");

            if (i < takeDown - 1) {
                result.append("\n");
            }
            current = next;
        }
        return result.toString();
    }

    private String numberToWords(int n) {
        switch (n) {
            case 10: return "ten";
            case 9: return "nine";
            case 8: return "eight";
            case 7: return "seven";
            case 6: return "six";
            case 5: return "five";
            case 4: return "four";
            case 3: return "three";
            case 2: return "two";
            case 1: return "one";
            default: return "no";
        }
    }

    private String capitalize(String s) {
        if (s == null || s.isEmpty()) return s;
        return s.substring(0, 1).toUpperCase() + s.substring(1);
    }

}
