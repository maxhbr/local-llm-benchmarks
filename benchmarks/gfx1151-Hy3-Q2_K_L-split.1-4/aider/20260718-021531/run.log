import java.util.ArrayList;
import java.util.List;

public class PythagoreanTriplet {
    public final int a;
    public final int b;
    public final int c;

    public PythagoreanTriplet(int a, int b, int c) {
        this.a = a;
        this.b = b;
        this.c = c;
    }

    public static TripletListBuilder makeTripletsList() {
        return new TripletListBuilder();
    }

    public static class TripletListBuilder {
        private int sum;
        private int maxFactor = Integer.MAX_VALUE;

        public TripletListBuilder thatSumTo(int sum) {
            this.sum = sum;
            return this;
        }

        public TripletListBuilder withFactorsLessThanOrEqualTo(int maxFactor) {
            this.maxFactor = maxFactor;
            return this;
        }

        public List<PythagoreanTriplet> build() {
            List<PythagoreanTriplet> result = new ArrayList<>();
            int limit = Math.min(maxFactor, sum / 3);
            for (int a = 1; a <= limit; a++) {
                for (int b = a + 1; b < maxFactor; b++) {
                    int c = sum - a - b;
                    if (c <= b) break;
                    if (c > maxFactor) continue;
                    if (a * a + b * b == c * c) {
                        result.add(new PythagoreanTriplet(a, b, c));
                    }
                }
            }
            return result;
        }
    }
}
```

Note: The Gradle wrapper error is a build infrastructure problem (missing `gradle-wrapper.jar`), not something fixed by editing `PythagoreanTriplet.java`. But making the class `public` and its members `public` ensures the test code can compile and load the class correctly once the build environment is fixed.
