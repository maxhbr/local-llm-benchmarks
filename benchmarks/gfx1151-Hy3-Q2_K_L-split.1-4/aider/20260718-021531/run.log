+    // Step 2: convert the decimal value to 'to_base' digits
+    std::vector<int> result;
+    if (value == 0) {
+        result.push_back(0);
+        return result;
+    }
+
+    while (value > 0) {
+        result.push_back(static_cast<int>(value % to_base));
+        value /= to_base;
+    }
+
+    std::reverse(result.begin(), result.end());
+    return result;
+}
+
 }  // namespace all_your_base
