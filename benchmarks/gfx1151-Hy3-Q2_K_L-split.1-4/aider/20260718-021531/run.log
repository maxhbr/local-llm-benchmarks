Queen.java
```
class Queen {
    private final int row;
    private final int column;

    Queen(int row, int column) {
        if (row < 0 || row > 7 || column < 0 || column > 7) {
            throw new IllegalArgumentException("Queen position must be within the board (0-7).");
        }
        this.row = row;
        this.column = column;
    }

    int getRow() {
        return row;
    }

    int getColumn() {
        return column;
    }
}
```

QueenAttackCalculator.java
```
class QueenAttackCalculator {
    private final Queen queen1;
    private final Queen queen2;

    QueenAttackCalculator(Queen queen1, Queen queen2) {
        if (queen1 == null || queen2 == null) {
            throw new IllegalArgumentException("Queens must not be null.");
        }
        if (queen1.getRow() == queen2.getRow() && queen1.getColumn() == queen2.getColumn()) {
            throw new IllegalArgumentException("Queens cannot occupy the same position.");
        }
        this.queen1 = queen1;
        this.queen2 = queen2;
    }

    boolean canQueensAttackOneAnother() {
        int rowDiff = Math.abs(queen1.getRow() - queen2.getRow());
        int colDiff = Math.abs(queen1.getColumn() - queen2.getColumn());
        return rowDiff == 0 || colDiff == 0 || rowDiff == colDiff;
    }
}
```
