    def __init__(self):
        self.rolls = []
        self.current_frame = 1
        self.in_tenth = False
        self.tenth_rolls = []
        self.tenth_bonus_needed = 0  # 0 = none, 1 = spare fill, 2 = strike fill

    def roll(self, pins):
        if not (0 <= pins <= 10):
            raise ValueError("pins must be between 0 and 10")

        if self.current_frame < 10:
            self.rolls.append(pins)
            # Determine if frame is complete
            if pins == 10:  # strike
                self.current_frame += 1
            elif len(self.rolls) % 2 == 0 and sum(self.rolls[-2:]) < 10:
                # two rolls in frame, not a spare -> frame done
                self.current_frame += 1
            elif len(self.rolls) % 2 == 0 and sum(self.rolls[-2:]) == 10:
                # spare -> frame done
                self.current_frame += 1
            # if only one roll and not strike, wait for second roll
            if self.current_frame == 10:
                self.in_tenth = True
                # prepare for tenth frame logic
        elif self.current_frame == 10:
            self.tenth_rolls.append(pins)
            if self.tenth_bonus_needed == 0:
                # first roll of tenth
                if pins == 10:
                    self.tenth_bonus_needed = 2
                else:
                    self.tenth_bonus_needed = -1  # need second roll normally
            elif self.tenth_bonus_needed == -1:
                # second roll of tenth (normal or spare)
                if sum(self.tenth_rolls[:2]) == 10:
                    self.tenth_bonus_needed = 1
                else:
                    self.tenth_bonus_needed = 0
                    self.current_frame += 1  # game over
            elif self.tenth_bonus_needed == 2:
                # first fill ball after strike
                self.tenth_bonus_needed = 1
            elif self.tenth_bonus_needed == 1:
                # second fill ball after strike or spare fill
                self.tenth_bonus_needed = 0
                self.current_frame += 1  # game over
            else:
                raise ValueError("invalid fill balls")
        else:
            raise IndexError("cannot roll after game is over")

    def score(self):
        if self.current_frame < 10 or (self.current_frame == 10 and self.tenth_bonus_needed != 0):
            raise ValueError("game is not complete, cannot score")

        total = 0
        roll_index = 0
