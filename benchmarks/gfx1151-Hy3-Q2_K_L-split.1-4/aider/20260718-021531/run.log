//
// This is only a SKELETON file for the 'State of Tic Tac Toe' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export const gamestate = (board) => {
  // Count marks and validate turn order
  let xCount = 0;
  let oCount = 0;
  for (const row of board) {
    for (const cell of row) {
      if (cell === 'X') xCount++;
      else if (cell === 'O') oCount++;
      else if (cell !== ' ') throw new Error('Invalid board: illegal character');
    }
  }

  if (oCount > xCount) throw new Error('Invalid board: O played too many times');
  if (xCount > oCount + 1) throw new Error('Invalid board: X played too many times');

  // Check for a win
  const lines = [
    [board[0][0], board[0][1], board[0][2]],
    [board[1][0], board[1][1], board[1][2]],
    [board[2][0], board[2][1], board[2][2]],
    [board[0][0], board[1][0], board[2][0]],
    [board[0][1], board[1][1], board[2][1]],
    [board[0][2], board[1][2], board[2][2]],
    [board[0][0], board[1][1], board[2][2]],
    [board[0][2], board[1][1], board[2][0]],
  ];

  let xWon = false;
  let oWon = false;
  for (const line of lines) {
    if (line[0] === 'X' && line[1] === 'X' && line[2] === 'X') xWon = true;
    if (line[0] === 'O' && line[1] === 'O' && line[2] === 'O') oWon = true;
  }

  if (xWon && oWon) throw new Error('Invalid board: both players won');
  if (xWon || oWon) {
    // Game ended in a win; ensure no moves after win
    if (xWon && xCount === oCount) throw new Error('Invalid board: continued after win');
    if (oWon && xCount > oCount) throw new Error('Invalid board: continued after win');
    return 'win';
  }

  // No winner: check if board is full -> draw, else ongoing
  if (xCount + oCount === 9) return 'draw';
  return 'ongoing';
};

export const gameState = gamestate;
```

