def transpose(text):
    if not text:
        return ""
    rows = text.splitlines()
    max_len = max(len(row) for row in rows)
    # pad rows to max_len with spaces on the right (to form rectangle)
    padded_rows = [row.ljust(max_len) for row in rows]
