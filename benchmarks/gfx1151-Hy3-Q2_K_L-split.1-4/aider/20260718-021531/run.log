        if not (0 <= pins <= 10):
            raise ValueError("pins must be between 0 and 10")
        if self.frame > 10:
            raise IndexError("cannot roll after game is over")

        if self.frame < 10:
            self.rolls.append(pins)
            # frame accounting
            if len(self.rolls) % 2 == 1 and pins == 10:
                self.frame += 1
            elif len(self.rolls) % 2 == 0:
                if self.rolls[-2] + pins > 10:
                    raise ValueError("two rolls in a frame cannot exceed 10 pins")
                self.frame += 1
        else:
            # tenth frame
            self.tenth_rolls.append(pins)
            if len(self.tenth_rolls) == 1:
                if pins != 10:
                    # need second roll
                    pass
            elif len(self.tenth_rolls) == 2:
                if self.tenth_rolls[0] == 10:
                    # strike: need third fill
                    pass
                else:
                    if self.tenth_rolls[0] + self.tenth_rolls[1] > 10:
                        raise ValueError("two rolls in tenth frame cannot exceed 10 pins")
                    if self.tenth_rolls[0] + self.tenth_rolls[1] == 10:
                        # spare: need third fill
                        pass
                    else:
                        self.frame += 1  # open tenth, game over
            elif len(self.tenth_rolls) == 3:
                self.frame += 1  # game over after fills
            else:
                raise ValueError("invalid fill balls")

    def score(self):
        if self.frame < 10 or len(self.tenth_rolls) < (3 if (self.tenth_rolls and (self.tenth_rolls[0] == 10 or (len(self.tenth_rolls) >= 2 and sum(self.tenth_rolls[:2]) == 10))) else 2):
            raise ValueError("game is not complete, cannot score")

        total = 0
        idx = 0
        for _ in range(9):
            if self.rolls[idx] == 10:
                total += 10 + self.rolls[idx + 1] + self.rolls[idx + 2]
                idx += 1
            elif self.rolls[idx] + self.rolls[idx + 1] == 10:
                total += 10 + self.rolls[idx + 2]
                idx += 2
            else:
                total += self.rolls[idx] + self.rolls[idx + 1]
                idx += 2
        total += sum(self.tenth_rolls)
        return total
