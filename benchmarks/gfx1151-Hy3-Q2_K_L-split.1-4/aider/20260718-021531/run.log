pub fn translate(input: &str) -> String {
    fn is_vowel(c: char) -> bool {
        matches!(c.to_ascii_lowercase(), 'a' | 'e' | 'i' | 'o' | 'u')
    }

    fn translate_word(word: &str) -> String {
        let lower = word.to_ascii_lowercase();
        let chars: Vec<char> = lower.chars().collect();

        // Rule 1: begins with vowel, or "xr" or "yt"
        if !chars.is_empty() && is_vowel(chars[0]) {
            return format!("{word}ay");
        }
        if chars.len() >= 2 && (lower.starts_with("xr") || lower.starts_with("yt")) {
            return format!("{word}ay");
        }

        // Rule 3: zero or more consonants followed by "qu"
        if let Some(qu_idx) = lower.find("qu") {
            let (consonants, rest) = lower.split_at(qu_idx + 2);
            return format!("{rest}{consonants}ay");
        }

        // Rule 4: one or more consonants followed by 'y'
        if let Some(y_idx) = lower.find('y') {
            // only if all chars before y are consonants
            let mut all_consonants = true;
            for &c in &chars[0..y_idx] {
                if is_vowel(c) {
                    all_consonants = false;
                    break;
                }
            }
            if all_consonants && y_idx > 0 {
                let (consonants, rest) = lower.split_at(y_idx);
                return format!("{rest}{consonants}ay");
            }
        }

        // Rule 2: one or more consonants at start
        let mut idx = 0;
        while idx < chars.len() && !is_vowel(chars[idx]) {
            idx += 1;
        }
        let (consonants, rest) = lower.split_at(idx);
        format!("{rest}{consonants}ay")
    }

    input
        .split_whitespace()
        .map(translate_word)
        .collect::<Vec<_>>()
        .join(" ")
}
```
