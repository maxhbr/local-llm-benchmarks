simple-linked-list.js
```
//
// This is only a SKELETON file for the 'Simple Linked List' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export class Element {
  constructor(value, next = null) {
    this._value = value;
    this._next = next;
  }

  get value() {
    return this._value;
  }

  get next() {
    return this._next;
  }
}

export class List {
  constructor() {
    this._head = null;
    this._length = 0;
  }

  add(nextValue) {
    const newElement = new Element(nextValue, this._head);
    this._head = newElement;
    this._length += 1;
  }

  get length() {
    return this._length;
  }

  get head() {
    return this._head;
  }

  toArray() {
    const result = [];
    let current = this._head;
    while (current !== null) {
      result.push(current.value);
      current = current.next;
    }
    return result;
  }

  reverse() {
    let prev = null;
    let current = this._head;
    while (current !== null) {
      const next = current.next;
      current._next = prev;
      prev = current;
      current = next;
    }
    this._head = prev;
    return this;
  }
}
```
