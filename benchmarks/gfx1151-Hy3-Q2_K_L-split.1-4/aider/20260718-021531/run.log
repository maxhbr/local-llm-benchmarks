/*
Refactoring log for ledger.go:
1. Removed unsafe goroutine-based parallelism for formatting entries; replaced with simple sequential formatting.
2. Extracted header generation into `headerFor(locale)`.
3. Extracted date formatting into `formatDate(entry, locale)`.
4. Extracted amount/change formatting into `formatChange(currency, locale, change)`.
5. Extracted description truncation/padding into `formatDescription(desc)`.
6. Replaced the obscure manual sorting with standard library `sort.Slice` using clear comparator logic.
7. Removed the weird recursive/self-call when entries are empty (original code called FormatLedger again for no reason); now just returns header for empty input.
8. Added basic validation for date format in one place (`validateDate`).
9. Overall: removed map-based arithmetic, reduced repetition, improved naming and structure.
10. Fixed amount formatting: correctly group thousands from the left, pad change column to 13 chars, and align Dutch/euro output per test expectations.

Note: Behavior (output format) is preserved to keep tests passing.
*/

package ledger

import (
	"errors"
	"sort"
	"strconv"
	"strings"
)

type Entry struct {
	Date        string // "Y-m-d"
	Description string
	Change      int // in cents
}

func FormatLedger(currency string, locale string, entries []Entry) (string, error) {
	if locale != "en-US" && locale != "nl-NL" {
		return "", errors.New("unsupported locale")
	}
	if currency != "EUR" && currency != "USD" {
		return "", errors.New("unsupported currency")
	}

	entriesCopy := make([]Entry, len(entries))
	copy(entriesCopy, entries)
	sort.Slice(entriesCopy, func(i, j int) bool {
		a, b := entriesCopy[i], entriesCopy[j]
		if a.Date != b.Date {
			return a.Date < b.Date
		}
		if a.Description != b.Description {
			return a.Description < b.Description
		}
		return a.Change < b.Change
	})

	var sb strings.Builder
	sb.WriteString(headerFor(locale))

	for _, e := range entriesCopy {
		if err := validateDate(e.Date); err != nil {
			return "", err
		}
		dateStr := formatDate(e, locale)
		descStr := formatDescription(e.Description)
		changeStr, err := formatChange(currency, locale, e.Change)
		if err != nil {
			return "", err
		}

		dateCol := dateStr + strings.Repeat(" ", 10-len(dateStr))
		descCol := descStr + " | "
		changeCol := strings.Repeat(" ", 13-len(changeStr)) + changeStr
		sb.WriteString(dateCol + " | " + descCol + changeCol + "\n")
	}

	return sb.String(), nil
}

func headerFor(locale string) string {
	if locale == "nl-NL" {
		return pad("Datum", 10) + " | " + pad("Omschrijving", 25) + " | Verandering\n"
	}
	return pad("Date", 10) + " | " + pad("Description", 25) + " | Change\n"
}

func pad(s string, n int) string {
	return s + strings.Repeat(" ", n-len(s))
}

func validateDate(date string) error {
	if len(date) != 10 {
		return errors.New("invalid date length")
	}
	if date[4] != '-' || date[7] != '-' {
		return errors.New("invalid date format")
	}
	return nil
}

func formatDate(e Entry, locale string) string {
	y, m, d := e.Date[0:4], e.Date[5:7], e.Date[8:10]
	if locale == "nl-NL" {
		return d + "-" + m + "-" + y
	}
	return m + "/" + d + "/" + y
}

func formatDescription(desc string) string {
	if len(desc) > 25 {
		return desc[:22] + "..."
	}
	return desc + strings.Repeat(" ", 25-len(desc))
}

func formatChange(currency, locale string, change int) (string, error) {
	negative := change < 0
	cents := change
	if negative {
		cents = -cents
	}

	centsStr := strconv.Itoa(cents)
	switch len(centsStr) {
	case 1:
		centsStr = "00" + centsStr
	case 2:
		centsStr = "0" + centsStr
	}
	whole := centsStr[:len(centsStr)-2]
	frac := centsStr[len(centsStr)-2:]

	// group whole part with thousands separators from left to right
	var grouped string
	if len(whole) > 3 {
		parts := []string{}
		for len(whole) > 3 {
			parts = append([]string{whole[len(whole)-3:]}, parts...)
			whole = whole[:len(whole)-3]
		}
		parts = append([]string{whole}, parts...)
		if locale == "nl-NL" {
			grouped = strings.Join(parts, ".")
		} else {
			grouped = strings.Join(parts, ",")
		}
	} else {
		grouped = whole
	}

	symbol := ""
	if currency == "EUR" {
		symbol = "€"
	} else if currency == "USD" {
		symbol = "$"
	} else {
		return "", errors.New("unsupported currency")
	}

	if locale == "nl-NL" {
		// e.g. € 1.234,56 or $ 1.234,56 (negative at end)
		amount := symbol + " " + grouped + "," + frac
		if negative {
			amount += "-"
		} else {
			amount += " "
		}
		return amount, nil
	}
	// en-US
	open, close := "", ""
	if negative {
		open, close = "(", ")"
	}
	amount := open + symbol + grouped + "." + frac + close
	if !negative {
		amount += " "
	}
	return amount, nil
}
