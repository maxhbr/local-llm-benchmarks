def recite(start, take=1):
    verses = []
    for i in range(start, start - take, -1):
        if i > 1:
            bottles_current = f"{i} bottles"
            bottles_next = f"{i - 1} bottles"
            take_line = "Take one down and pass it around"
        elif i == 1:
            bottles_current = "1 bottle"
            bottles_next = "no more bottles"
            take_line = "Take it down and pass it around"
        else:
            # i == 0 (no more bottles verse)
            bottles_current = "no more bottles"
            bottles_next = "99 bottles"
            take_line = "Go to the store and buy some more"
        # Build the verse lines
        line1 = f"{bottles_current} of beer on the wall, {bottles_current} of beer."
        line2 = f"{take_line}, {bottles_next} of beer on the wall."
        verses.append(line1)
        verses.append(line2)
        # Add blank line between verses except after the last one
        if i > start - take + 1:
            verses.append("")
    return verses
