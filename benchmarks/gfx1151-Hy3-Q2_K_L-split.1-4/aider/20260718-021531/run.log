export class InputCell {
  constructor(value) {
    this._value = value;
    this._dependents = [];
  }

  get value() {
    return this._value;
  }

  setValue(value) {
    if (value !== this._value) {
      this._value = value;
      // Propagate to dependents (compute cells)
