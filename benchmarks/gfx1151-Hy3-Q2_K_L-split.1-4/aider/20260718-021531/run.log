class SgfTree:
    def __init__(self, properties=None, children=None):
        self.properties = properties or {}
        self.children = children or []

    def __eq__(self, other):
        if not isinstance(other, SgfTree):
            return False
        for key, value in self.properties.items():
            if key not in other.properties:
                return False
            if other.properties[key] != value:
                return False
        for key in other.properties.keys():
            if key not in self.properties:
                return False
        if len(self.children) != len(other.children):
            return False
        for child, other_child in zip(self.children, other.children):
            if child != other_child:
                return False
        return True

    def __ne__(self, other):
        return not self == other


def parse(input_string):
    # Helper to parse SGF text value according to spec
    def parse_text_value(raw):
        # raw is the content inside [ ... ], already without the brackets
        result = []
        i = 0
        while i < len(raw):
            ch = raw[i]
            if ch == '\\':
                if i + 1 < len(raw):
                    nxt = raw[i + 1]
                    if nxt == '\n':
                        # newline after backslash is removed
                        i += 2
                        continue
                    else:
                        # non-whitespace after backslash inserted as-is
                        result.append(nxt)
                        i += 2
                        continue
                else:
                    # trailing backslash, ignore
                    i += 1
                    continue
            elif ch == '\n':
                # newline remains as newline
                result.append('\n')
                i += 1
            elif ch.isspace() and ch != '\n':
                # other whitespace converted to space
                result.append(' ')
                i += 1
            else:
                result.append(ch)
                i += 1
        return ''.join(result)

    if not input_string:
        raise ValueError("tree missing")
    if input_string[0] != '(':
        raise ValueError("tree missing")
    if input_string[-1] != ')':
        raise ValueError("tree missing")

    index = 1  # after '('
    n = len(input_string)

    def parse_node_sequence(start):
        # parse a sequence of nodes and variations starting at index start
        # returns (list_of_children_trees, new_index)
        nodes = []
        variations = []
        i = start
        while i < n:
            if input_string[i] == ';':
                # start of a node
                i += 1
                props = {}
                while i < n and input_string[i] != '(' and input_string[i] != ';' and input_string[i] != ')':
                    # parse property: key then values
                    key_start = i
                    while i < n and input_string[i].isalpha():
                        i += 1
                    key = input_string[key_start:i]
                    if not key:
                        break
                    if not key.isupper():
                        raise ValueError("property must be in uppercase")
                    if key in props:
                        # key can only occur once per node
                        raise ValueError("properties without delimiter")
                    values = []
                    while i < n and input_string[i] == '[':
                        # find matching closing bracket respecting escapes
                        j = i + 1
                        while j < n:
                            if input_string[j] == '\\':
                                j += 2
                                continue
                            if input_string[j] == ']':
                                break
                            j += 1
                        if j >= n:
                            raise ValueError("properties without delimiter")
                        raw_val = input_string[i + 1:j]
                        values.append(parse_text_value(raw_val))
                        i = j + 1
                    if not values:
                        raise ValueError("properties without delimiter")
                    props[key] = values
                node = SgfTree(props, [])
                nodes.append(node)
            elif input_string[i] == '(':
                # variation: parse subtree
                sub_children, i = parse_node_sequence(i + 1)
                if input_string[i] != ')':
                    raise ValueError("tree missing")
                i += 1
                # attach variation to the last node if any, else to root list
                if nodes:
                    nodes[-1].children.extend(sub_children)
                else:
                    variations.extend(sub_children)
            elif input_string[i] == ')':
                # end of current sequence
                break
            else:
                # unexpected character
                raise ValueError("tree missing")
        if not nodes and not variations:
            return ([], i)
        if nodes:
            # link consecutive nodes as parent-child
            for k in range(len(nodes) - 1):
                nodes[k].children.append(nodes[k + 1])
            # variations already attached to nodes[-1] if present
            return (nodes, i)
        else:
            return (variations, i)

    children, end_index = parse_node_sequence(index)
    if end_index != n - 1:
        raise ValueError("tree missing")
    if not children:
        raise ValueError("tree with no nodes")

    # The root of the tree is the first node sequence; we wrap in a SgfTree?
    # According to typical SGF, the first '(' encloses the root node sequence.
    # We return the first node as the root tree.
    # If multiple top-level nodes, they are chained; first is root.
    root = children[0]
    return root
```

Note: The above implementation is a straightforward recursive descent parser for the simplified SGF described. It raises the required `ValueError` messages and returns an `SgfTree` representing the parsed tree (the root node). The `SgfTree` class is unchanged except for the added `parse` function below it.

If you need adjustments (e.g., returning a wrapper `SgfTree` for the whole tree rather than the first node), let me know, but the exercise typically expects the root node tree.
