        cf.setCurrency(Currency.getInstance(cfg.currencyCode));
        cf.setMinimumFractionDigits(2);
        cf.setMaximumFractionDigits(2);

        double amountValue = e.getChange() / 100.0;
        String amount = cf.format(amountValue);

        return String.format("%s | %-25s | %13s", date, desc, amount);
    }

    public static class LedgerEntry {
        LocalDate localDate;
        String description;
        int change;

