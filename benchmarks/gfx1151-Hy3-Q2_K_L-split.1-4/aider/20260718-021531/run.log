+    const unsigned mask = 255;
+    const std::unordered_map<std::string, unsigned> allergen_values = {
+        {"eggs", 1},
+        {"peanuts", 2},
+        {"shellfish", 4},
+        {"strawberries", 8},
+        {"tomatoes", 16},
+        {"chocolate", 32},
+        {"pollen", 64},
+        {"cats", 128}
+    };
