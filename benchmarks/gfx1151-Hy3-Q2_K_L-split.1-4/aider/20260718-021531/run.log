use std::collections::HashSet;
use std::sync::{Mutex, Once};
use std::time::{SystemTime, UNIX_EPOCH, Duration};
use std::cell::RefCell;

static mut ROBOT_NAMES: Option<Mutex<HashSet<String>>> = None;
static INIT: Once = Once::new();

fn get_names_set() -> &'static Mutex<HashSet<String>> {
    unsafe {
        INIT.call_once(|| {
            ROBOT_NAMES = Some(Mutex::new(HashSet::new()));
        });
        ROBOT_NAMES.as_ref().unwrap()
    }
}

fn generate_unique_name() -> String {
    let names = get_names_set();
    loop {
        let now = SystemTime::now().duration_since(UNIX_EPOCH).unwrap_or(Duration::from_secs(0));
        let nanos = now.subsec_nanos() as u64;
        let secs = now.as_secs();
        let mut num = (secs.wrapping_mul(2654435761)) ^ nanos.wrapping_mul(40503);
        let letter1 = (b'A' + ((num % 26) as u8)) as char;
        num /= 26;
        let letter2 = (b'A' + ((num % 26) as u8)) as char;
        num /= 26;
        let digit1 = (num % 10) as u8;
        num /= 10;
        let digit2 = (num % 10) as u8;
        num /= 10;
        let digit3 = (num % 10) as u8;
        let name = format!("{}{}{}{}{}", letter1, letter2, digit1, digit2, digit3);
        let mut set = names.lock().unwrap();
        if !set.contains(&name) {
            set.insert(name.clone());
            return name;
        }
    }
}

pub struct Robot {
    name: RefCell<Option<String>>,
}

impl Robot {
    pub fn new() -> Self {
        Robot { name: RefCell::new(None) }
    }

    pub fn name(&self) -> &str {
        let mut borrowed = self.name.borrow_mut();
        if borrowed.is_none() {
            *borrowed = Some(generate_unique_name());
        }
        let result = borrowed.as_ref().unwrap().as_str();
        drop(borrowed);
        result
    }

    pub fn reset_name(&mut self) {
        let mut borrowed = self.name.borrow_mut();
        if let Some(old) = borrowed.take() {
            let names = get_names_set();
            names.lock().unwrap().remove(&old);
        }
        // Next call to name() will generate a new unique name.
    }
}
```

