package wordy

import (
	"strconv"
	"strings"
)

func Answer(question string) (int, bool) {
	q := strings.TrimSpace(question)
	if !strings.HasPrefix(q, "What is ") || !strings.HasSuffix(q, "?") {
		return 0, false
	}
	body := strings.TrimSuffix(strings.TrimPrefix(q, "What is "), "?")
	body = strings.TrimSpace(body)

	// Iteration 0: just a number (may be negative)
	if num, err := strconv.Atoi(body); err == nil {
		return num, true
	}

	parts := strings.Fields(body)
	if len(parts) == 0 {
		return 0, false
	}

	// first token must be a number
	current, err := strconv.Atoi(parts[0])
	if err != nil {
		return 0, false
	}

	i := 1
	for i < len(parts) {
		op := parts[i]
		var next int
		var consumed int // number of tokens consumed for op + number

		switch op {
		case "plus":
			if i+1 >= len(parts) {
				return 0, false
			}
			next, err = strconv.Atoi(parts[i+1])
			if err != nil {
				return 0, false
			}
			current += next
			consumed = 2
		case "minus":
			if i+1 >= len(parts) {
				return 0, false
			}
			next, err = strconv.Atoi(parts[i+1])
			if err != nil {
				return 0, false
			}
			current -= next
			consumed = 2
		case "multiplied":
			if i+2 >= len(parts) || parts[i+1] != "by" {
				return 0, false
			}
			next, err = strconv.Atoi(parts[i+2])
			if err != nil {
				return 0, false
			}
			current *= next
			consumed = 3
		case "divided":
			if i+2 >= len(parts) || parts[i+1] != "by" {
				return 0, false
			}
			next, err = strconv.Atoi(parts[i+2])
			if err != nil {
				return 0, false
			}
			if next == 0 {
				return 0, false
			}
			current /= next
			consumed = 3
		default:
			return 0, false
		}
		i += consumed
	}

	return current, true
}
```

