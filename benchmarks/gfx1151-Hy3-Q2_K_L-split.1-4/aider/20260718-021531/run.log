        if path is None:

            raise ValueError("Tree does not contain the from_node")



        # Build the reparented tree from the path (bottom-up)

        new_trees = [None] * len(path)

        new_trees[-1] = Tree(path[-1].label, list(path[-1].children))

        for i in range(len(path) - 2, -1, -1):

