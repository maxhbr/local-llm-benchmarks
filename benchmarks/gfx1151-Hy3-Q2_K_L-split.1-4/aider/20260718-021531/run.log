import java.util.List;
import java.util.ArrayList;
import java.util.Collections;

class Domino {
    private int left;
    private int right;

    Domino(int left, int right) {
        this.left = left;
        this.right = right;
    }

    public int getLeft() {
        return left;
    }

    public int getRight() {
        return right;
    }

    public Domino reversed() {
        return new Domino(right, left);
    }

    @Override
    public String toString() {
        return left + "|" + right;
    }
}

class ChainNotFoundException extends Exception {
    public ChainNotFoundException(String message) {
        super(message);
    }
}

class Dominoes {

    List<Domino> formChain(List<Domino> inputDominoes) throws ChainNotFoundException {
        if (inputDominoes.isEmpty()) {
            return new ArrayList<>();
        }
        List<Domino> result = new ArrayList<>();
        boolean[] used = new boolean[inputDominoes.size()];
        if (backtrack(inputDominoes, used, new ArrayList<>(), result, -1)) {
            return result;
        }
        throw new ChainNotFoundException("No valid chain found");
    }

    private boolean backtrack(List<Domino> dominoes, boolean[] used, List<Domino> current, List<Domino> result, int prevRight) {
        if (current.size() == dominoes.size()) {
            Domino first = current.get(0);
            Domino last = current.get(current.size() - 1);
            if (first.getLeft() == last.getRight()) {
                result.addAll(current);
                return true;
            }
            return false;
        }
        for (int i = 0; i < dominoes.size(); i++) {
            if (used[i]) continue;
            Domino d = dominoes.get(i);
            if (prevRight == -1) {
                used[i] = true;
                current.add(d);
