#include "space_age.h"

namespace space_age {

const double EARTH_ORBIT_SECONDS = 31557600.0;

SpaceAge::SpaceAge(double seconds) : seconds_(seconds) {}

double SpaceAge::seconds() const {
    return seconds_;
}

double SpaceAge::age_on_planet(double orbital_period) const {
    return (seconds_ / EARTH_ORBIT_SECONDS) / orbital_period;
}

double SpaceAge::on_mercury() const {
    return age_on_planet(0.2408467);
}

double SpaceAge::on_venus() const {
    return age_on_planet(0.61519726);
}

double SpaceAge::on_earth() const {
    return age_on_planet(1.0);
}

double SpaceAge::on_mars() const {
    return age_on_planet(1.8808158);
}

double SpaceAge::on_jupiter() const {
    return age_on_planet(11.862615);
}

double SpaceAge::on_saturn() const {
    return age_on_planet(29.447498);
}

double SpaceAge::on_uranus() const {
    return age_on_planet(84.016846);
}

double SpaceAge::on_neptune() const {
    return age_on_planet(164.79132);
}

}  // namespace space_age
