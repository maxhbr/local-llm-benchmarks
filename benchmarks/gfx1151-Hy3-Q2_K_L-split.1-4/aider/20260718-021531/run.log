Tree.java
```
import java.util.*;

class Tree {
    private final String label;
    private final List<Tree> children;

    public Tree(String label) {
        this(label, new ArrayList<>());
    }

    public Tree(String label, List<Tree> children) {
        this.label = label;
        this.children = children;
    }

    public static Tree of(String label) {
        return new Tree(label);
    }

    public static Tree of(String label, List<Tree> children) {
        return new Tree(label, children);
    }

    @Override
    public boolean equals(Object o) {
        if (this == o) return true;
        if (o == null || getClass() != o.getClass()) return false;
        Tree tree = (Tree) o;
        return label.equals(tree.label)
                && children.size() == tree.children.size()
                && children.containsAll(tree.children)
                && tree.children.containsAll(children);
    }

    @Override
    public int hashCode() {
        return Objects.hash(label, children);
    }

    @Override
    public String toString() {
        return "Tree{" + label +
                ", " + children +
                "}";
    }

    public Tree fromPov(String fromNode) {
        if (!label.equals(fromNode)) {
            for (Tree child : children) {
                try {
                    Tree reparented = child.fromPov(fromNode);
                    List<Tree> newChildren = new ArrayList<>(children);
                    newChildren.remove(child);
                    newChildren.add(new Tree(label, newChildren));
                    reparented.children.add(new Tree(label, newChildren));
                    return reparented;
                } catch (UnsupportedOperationException e) {
                    // continue searching in other children
                }
            }
            throw new UnsupportedOperationException("Tree could not be reoriented");
        }
        return this;
    }

    public List<String> pathTo(String fromNode, String toNode) {
        List<String> path = findPath(this, fromNode, toNode, new ArrayList<>());
        if (path == null) {
            throw new UnsupportedOperationException("No path found");
        }
        return path;
    }

    private static List<String> findPath(Tree node, String fromNode, String toNode, List<String> currentPath) {
        currentPath.add(node.label);
        if (node.label.equals(fromNode)) {
            List<String> subPath = findPathTo(node, toNode, new ArrayList<>());
            if (subPath != null) {
                return subPath;
            }
        }
        for (Tree child : node.children) {
            List<String> result = findPath(child, fromNode, toNode, new ArrayList<>(currentPath));
            if (result != null) {
                return result;
            }
        }
        return null;
    }

    private static List<String> findPathTo(Tree node, String toNode, List<String> current) {
        current.add(node.label);
        if (node.label.equals(toNode)) {
            return new ArrayList<>(current);
        }
        for (Tree child : node.children) {
            List<String> result = findPathTo(child, toNode, new ArrayList<>(current));
            if (result != null) {
                return result;
            }
        }
        return null;
    }
}
```
