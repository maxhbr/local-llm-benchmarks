import java.util.regex.Matcher;
import java.util.regex.Pattern;

class WordProblemSolver {
    int solve(final String wordProblem) {
        // Normalize input: remove trailing question mark and trim
        String input = wordProblem.trim();
        if (input.endsWith("?")) {
            input = input.substring(0, input.length() - 1).trim();
        }

        // Must start with "What is"
        Pattern pattern = Pattern.compile("^What is (.+)$");
        Matcher matcher = pattern.matcher(input);
        if (!matcher.matches()) {
            throw new IllegalArgumentException("Invalid question format");
        }

        String expression = matcher.group(1).trim();

        // Iteration 0: just a number
        if (expression.matches("-?\\d+")) {
            return Integer.parseInt(expression);
        }

        // Tokenize the expression: number, operation, number, operation, number, ...
        // Supported operations: plus, minus, multiplied by, divided by
        Pattern tokenPattern = Pattern.compile(
            "(-?\\d+)\\s+(plus|minus|multiplied by|divided by)\\s+(-?\\d+)");
        Matcher tokenMatcher = tokenPattern.matcher(expression);

        // We will parse left-to-right, ignoring typical order of operations
        String[] parts = expression.split("\\s+(?=(?:plus|minus|multiplied by|divided by)\\s+)");
        // Actually simpler: replace operation phrases with placeholders and split
        // Let's do a manual sequential parse using regex find

        // First number
        Pattern numPattern = Pattern.compile("-?\\d+");
        Matcher numMatcher = numPattern.matcher(expression);
        if (!numMatcher.find()) {
            throw new IllegalArgumentException("No number found");
        }
        int result = Integer.parseInt(numMatcher.group());

        // Remaining operations and numbers
        Pattern opNumPattern = Pattern.compile(
            "\\s+(plus|minus|multiplied by|divided by)\\s+(-?\\d+)");
        Matcher opNumMatcher = opNumPattern.matcher(expression);
        opNumMatcher.region(numMatcher.end(), expression.length());

        while (opNumMatcher.find()) {
            String op = opNumMatcher.group(1);
            int num = Integer.parseInt(opNumMatcher.group(2));
            switch (op) {
                case "plus":
                    result += num;
                    break;
                case "minus":
                    result -= num;
                    break;
                case "multiplied by":
                    result *= num;
                    break;
                case "divided by":
                    result /= num;
                    break;
                default:
                    throw new IllegalArgumentException("Unsupported operation: " + op);
            }
        }

        // Check if there is any leftover text (invalid syntax)
        String leftover = expression.substring(
            (opNumMatcher.regionStart() + (opNumMatcher.hitEnd() ? 0 : 0))).trim();
        // Simpler: ensure we consumed the whole expression
        // Reconstruct consumed length
        int consumed = numMatcher.end();
        opNumMatcher.reset();
        opNumMatcher.region(numMatcher.end(), expression.length());
        while (opNumMatcher.find()) {
            consumed = opNumMatcher.end();
        }
        if (consumed != expression.length()) {
            throw new IllegalArgumentException("Invalid syntax or unsupported operation");
        }

        return result;
    }
}
