class StackUnderflowError(Exception):
    """Exception raised when Stack is not sufficiently filled.
       message: explanation of the error.
    """
    def __init__(self, message):
        self.message = message


def evaluate(input_data):
    stack = []
    definitions = {}

    tokens = input_data.replace('\n', ' ').split()

    i = 0
    while i < len(tokens):
        token = tokens[i].upper()

        if token == ':':
            # word definition: : name body ;
            name = tokens[i + 1].upper()
            body = []
            j = i + 2
            while j < len(tokens) and tokens[j] != ';':
                body.append(tokens[j].upper())
                j += 1
            if j >= len(tokens):
                raise ValueError("invalid word definition: missing ;")
            definitions[name] = body
            i = j + 1
            continue

        if token in definitions:
            # expand defined word
            # push its tokens to processing (simple inline expansion)
            for word in definitions[token]:
                tokens.insert(i + 1, word)
            # remove the defined word token itself
            tokens.pop(i)
            # restart processing from current i to handle inserted tokens
            continue

        if token.isdigit() or (token[0] == '-' and token[1:].isdigit()):
            stack.append(int(token))
            i += 1
            continue

        # stack manipulation and arithmetic
        if token == 'DUP':
            if len(stack) < 1:
                raise StackUnderflowError("Insufficient number of items in stack")
            stack.append(stack[-1])
        elif token == 'DROP':
            if len(stack) < 1:
                raise StackUnderflowError("Insufficient number of items in stack")
            stack.pop()
        elif token == 'SWAP':
            if len(stack) < 2:
                raise StackUnderflowError("Insufficient number of items in stack")
            stack[-1], stack[-2] = stack[-2], stack[-1]
        elif token == 'OVER':
            if len(stack) < 2:
                raise StackUnderflowError("Insufficient number of items in stack")
            stack.append(stack[-2])
        elif token == '+':
            if len(stack) < 2:
                raise StackUnderflowError("Insufficient number of items in stack")
            b = stack.pop()
            a = stack.pop()
            stack.append(a + b)
        elif token == '-':
            if len(stack) < 2:
                raise StackUnderflowError("Insufficient number of items in stack")
            b = stack.pop()
            a = stack.pop()
            stack.append(a - b)
        elif token == '*':
            if len(stack) < 2:
                raise StackUnderflowError("Insufficient number of items in stack")
            b = stack.pop()
            a = stack.pop()
            stack.append(a * b)
        elif token == '/':
            if len(stack) < 2:
                raise StackUnderflowError("Insufficient number of items in stack")
            b = stack.pop()
            a = stack.pop()
            if b == 0:
                raise ZeroDivisionError("divide by zero")
            stack.append(a // b)
        else:
            raise ValueError("undefined operation")

        i += 1

    return stack
```
