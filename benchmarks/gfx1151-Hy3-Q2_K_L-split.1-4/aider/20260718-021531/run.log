import java.util.Map;

import java.util.HashMap;

import java.util.List;

import java.util.ArrayList;

import java.util.HashSet;

import java.util.Set;



class Alphametics {



    private final String userInput;

    private List<String> leftTerms;

    private String rightTerm;

    private Set<Character> leadingLetters;

    private List<Character> uniqueLetters;



    Alphametics(String userInput) {

        this.userInput = userInput;

        parseInput();

    }



    private void parseInput() {

        String[] parts = userInput.split("=");

        if (parts.length != 2) {

            throw new IllegalArgumentException("Invalid puzzle format");

        }

        String leftSide = parts[0].trim();

        rightTerm = parts[1].trim().replaceAll("\\s+", "");

        leftTerms = new ArrayList<>();

        for (String term : leftSide.split("\\+")) {

            leftTerms.add(term.trim().replaceAll("\\s+", ""));

        }

        leadingLetters = new HashSet<>();

        for (String term : leftTerms) {

            if (!term.isEmpty()) leadingLetters.add(term.charAt(0));

        }

        if (!rightTerm.isEmpty()) leadingLetters.add(rightTerm.charAt(0));



        Set<Character> uniq = new HashSet<>();

        for (String term : leftTerms) {

            for (char c : term.toCharArray()) uniq.add(c);

        }

        for (char c : rightTerm.toCharArray()) uniq.add(c);

        uniqueLetters = new ArrayList<>(uniq);

    }



    Map<Character, Integer> solve() throws UnsolvablePuzzleException {

        int[] assignment = new int[10];

        boolean[] used = new boolean[10];

        Map<Character, Integer> result = new HashMap<>();

        if (backtrack(0, assignment, used, result)) {

            return result;

        } else {

            throw new UnsolvablePuzzleException("Puzzle cannot be solved");

        }

    }



    private boolean backtrack(int idx, int[] assignment, boolean[] used, Map<Character, Integer> result) {

        if (idx == uniqueLetters.size()) {

            long leftSum = 0;

            for (String term : leftTerms) {

                long val = 0;

                for (char c : term.toCharArray()) {

                    val = val * 10 + result.get(c);

                }

                leftSum += val;

            }

            long rightVal = 0;

            for (char c : rightTerm.toCharArray()) {

                rightVal = rightVal * 10 + result.get(c);

            }

            return leftSum == rightVal;

        }



        char letter = uniqueLetters.get(idx);

        boolean isLeading = leadingLetters.contains(letter);

        for (int digit = 0; digit <= 9; digit++) {

            if (used[digit]) continue;

            if (isLeading && digit == 0) continue;

            used[digit] = true;

            result.put(letter, digit);

            if (backtrack(idx + 1, assignment, used, result)) {

                return true;

            }

            result.remove(letter);

            used[digit] = false;

        }

        return false;

    }



    static class UnsolvablePuzzleException extends Exception {

        public UnsolvablePuzzleException(String message) {

            super(message);

        }

    }



}

