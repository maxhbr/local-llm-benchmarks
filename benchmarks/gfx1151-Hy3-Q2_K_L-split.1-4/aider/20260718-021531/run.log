const ALPHABET = 'abcdefghijklmnopqrstuvwxyz';
const M = ALPHABET.length;

function gcd(a, b) {
  while (b !== 0) {
    [a, b] = [b, a % b];
  }
  return a;
}

function modInverse(a, m) {
  for (let x = 1; x < m; x++) {
    if ((a * x) % m === 1) {
      return x;
    }
  }
  throw new Error('No modular inverse exists');
}

function sanitize(phrase) {
  return phrase
    .toLowerCase()
    .replace(/[^a-z0-9]/g, '');
}

function encode(phrase, key) {
  const { a, b } = key;
  if (gcd(a, M) !== 1) {
    throw new Error('a and m must be coprime');
  }

  const clean = sanitize(phrase);
  let result = '';

  for (const ch of clean) {
    if (ch >= '0' && ch <= '9') {
      result += ch;
    } else {
      const i = ALPHABET.indexOf(ch);
      const e = (a * i + b) % M;
      result += ALPHABET[e];
    }
  }

  return result.replace(/(.{5})/g, '$1 ').trim();
}

function decode(phrase, key) {
  const { a, b } = key;
  if (gcd(a, M) !== 1) {
    throw new Error('a and m must be coprime');
  }

  const mmi = modInverse(a, M);
  const clean = sanitize(phrase);
  let result = '';

  for (const ch of clean) {
    if (ch >= '0' && ch <= '9') {
      result += ch;
    } else {
      const y = ALPHABET.indexOf(ch);
      const d = (mmi * (y - b)) % M;
      const idx = (d + M) % M;
      result += ALPHABET[idx];
    }
  }

  return result;
}

module.exports = { encode, decode };
```

