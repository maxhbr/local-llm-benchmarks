//

// This is only a SKELETON file for the 'Variable Length Quantity' exercise. It's been provided as a

// convenience to get you started writing code faster.

//



export const encode = (numbers) => {

  const bytes = [];

  for (const n of numbers) {

    if (n < 0 || n > 0xFFFFFFFF) {

      throw new Error('Number out of range');

    }

    let value = n;

    const chunks = [];

    // extract 7-bit chunks from right to left

    chunks.push(value & 0x7F);

    value >>>= 7;

    while (value > 0) {

      chunks.unshift(value & 0x7F); // continuation bit added below

      value >>>= 7;

    }

    // set continuation bit on all but the last chunk

    for (let i = 0; i < chunks.length - 1; i++) {

      chunks[i] |= 0x80;

    }

    bytes.push(...chunks);

  }

  return bytes;

};



export const decode = (bytes) => {

  const numbers = [];

  let value = 0;

  let shift = 0;

  let started = false;

  for (const byte of bytes) {

    started = true;

    value |= (byte & 0x7F) << shift;

    shift += 7;

    if ((byte & 0x80) === 0) {

      numbers.push(value);

      value = 0;

      shift = 0;

    }

  }

  if (started && shift !== 0) {

    throw new Error('Incomplete sequence');

  }

  return numbers;

};



if (typeof module !== 'undefined') {

  module.exports = { encode, decode };

}

```

