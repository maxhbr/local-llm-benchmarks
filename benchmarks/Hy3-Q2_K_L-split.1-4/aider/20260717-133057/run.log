@@ -1,5 +1,44 @@
 #include "dnd_character.h"
+
+#include <algorithm>
+#include <cmath>
+#include <random>
+#include <vector>
 
 namespace dnd_character {
 
+int ability_roll() {
+    std::random_device rd;
+    std::mt19937 gen(rd());
+    std::uniform_int_distribution<> dis(1, 6);
+
+    std::vector<int> rolls(4);
+    for (int i = 0; i < 4; ++i) {
+        rolls[i] = dis(gen);
+    }
+    std::sort(rolls.begin(), rolls.end());
+    // Sum the largest three (discard the smallest)
+    return rolls[1] + rolls[2] + rolls[3];
+}
+
+int modifier(int constitution) {
+    return static_cast<int>(std::floor((constitution - 10) / 2.0));
+}
+
+Character generate_character() {
+    Character c;
+    c.strength = ability_roll();
+    c.dexterity = ability_roll();
+    c.constitution = ability_roll();
+    c.intelligence = ability_roll();
+    c.wisdom = ability_roll();
+    c.charisma = ability_roll();
+    c.hitpoints = 10 + modifier(c.constitution);
+    return c;
+}
+
+Character::Character()
+    : strength(0), dexterity(0), constitution(0),
+      intelligence(0), wisdom(0), charisma(0), hitpoints(0) {}
+
 }  // namespace dnd_character
```



