```java
class Connect {

    public enum Winner {
        NONE, O, X
    }

    private final char[][] grid;
    private final int rows;
    private final int cols;

    public Connect(String[] board) {
        // parse board: remove spaces
        rows = board.length;
        grid = new char[rows][];
        for (int i = 0; i < rows; i++) {
            String s = board[i].replaceAll(" ", "");
            grid[i] = s.toCharArray();
            if (i == 0) cols = grid[i].length;
        }
    }

    public Winner computeWinner() {
        if (checkWinner('O', 0, rows - 1, 0, 0)) return Winner.O;
        if (checkWinner('X', 0, 0, 0, cols - 1)) return Winner.X;
        return Winner.NONE;
    }

    private boolean checkWinner(char player, int startRow, int endRow, int startCol, int endCol) {
        // BFS from all starting edge cells
        boolean[][] visited = new boolean[rows][cols];
        java.util.Queue<int[]> queue = new java.util.LinkedList<>();
        for (int c = 0; c < cols; c++) {
            if (grid[startRow][c] == player) {
                queue.add(new int[]{startRow, c});
                visited[startRow][c] = true;
            }
        }
        int[][] deltas = {{-1, 0}, {-1, 1}, {0, -1}, {0, 1}, {1, -1}, {1, 0}};
        while (!queue.isEmpty()) {
            int[] cell = queue.poll();
            int r = cell[0], c = cell[1];
            if (r == endRow) {
                // reached opposite side for this player
                // For O: endRow is bottom; for X: we need to reach endCol, so we check c == endCol below.
                // Actually for X, startRow=0, endRow=0, startCol=0, endCol=cols-1, so we need to check c == endCol.
                if (player == 'O' && r == endRow) return true;
                if (player == 'X' && c == endCol) return true;
            }
            for (int[] d : deltas) {
                int nr = r + d[0], nc = c + d[1];
                if (nr >= 0 && nr < rows && nc >= 0 && nc < cols && !visited[nr][nc] && grid[nr][nc] == player) {
                    visited[nr][nc] = true;
                    queue.add(new int[]{nr, nc});
                }
            }
        }
        return false;
    }
}
```

