class ConnectGame:
    def __init__(self, board):
        # board is a string with rows separated by newlines, possibly with leading spaces
        self.grid = []
        for line in board.strip().split('\n'):
            # Remove leading spaces (indentation) but keep all cell characters
            stripped = line.lstrip()
            # Actually we need to preserve the hex offset? The spaces are just indentation.
            # The cells are separated by spaces? In example: ". O . X ." has spaces between cells.
            # Wait, the example shows spaces between characters. So we need to split on whitespace and get characters.
            # Let's split the line by whitespace to get the cell chars.
            cells = line.split()
            self.grid.append(cells)
        self.rows = len(self.grid)
        self.cols = len(self.grid[0]) if self.rows > 0 else 0

    def get_winner(self):
        # Check O: top to bottom
        if self._check_winner('O'):
            return 'O'
        if self._check_winner('X'):
            return 'X'
        return ''

    def _check_winner(self, player):
        # player 'O' connects top (row 0) to bottom (row rows-1)
        # player 'X' connects left (col 0) to right (col cols-1)
        visited = [[False]*self.cols for _ in range(self.rows)]
        stack = []
        if player == 'O':
            for c in range(self.cols):
                if self.grid[0][c] == 'O':
                    stack.append((0, c))
        else:  # 'X'
            for r in range(self.rows):
                if self.grid[r][0] == 'X':
                    stack.append((r, 0))

        while stack:
            r, c = stack.pop()
            if visited[r][c]:
                continue
            visited[r][c] = True
            # Check if reached opposite side
            if player == 'O' and r == self.rows - 1:
                return True
            if player == 'X' and c == self.cols - 1:
                return True
            # Neighbors
            for dr, dc in [(-1,-1), (-1,0), (0,-1), (0,1), (1,-1), (1,0)]:
                nr, nc = r + dr, c + dc
                if 0 <= nr < self.rows and 0 <= nc < self.cols:
                    if not visited[nr][nc] and self.grid[nr][nc] == player:
                        stack.append((nr, nc))
        return False
```

