@@ -1,5 +1,73 @@
 #include "meetup.h"
+
+#include <ctime>
 
 namespace meetup {
 
+Meetup::Meetup(int year, int month) : year_(year), month_(month) {}
+
+int Meetup::weekdayToTm(Weekday wd) {
+    return static_cast<int>(wd); // tm_wday: 0=Sun ... 6=Sat matches our 
enum
+}
+
+Weekday Meetup::tmToWeekday(int tm_wday) {
+    return static_cast<Weekday>(tm_wday);
+}
+
+Date Meetup::day(Weekday weekday, Week week) const {
+    int target_wd = weekdayToTm(weekday);
+
+    // Find all days in month matching weekday
+    int days_in_month[31] = {0};
+    int num_days = 0;
+    std::tm tm = {};
+    tm.tm_year = year_ - 1900;
+    tm.tm_mon = month_ - 1;
+    tm.tm_mday = 1;
+    tm.tm_hour = 0;
+    tm.tm_min = 0;
+    tm.tm_sec = 0;
+    tm.tm_isdst = -1;
+    mktime(&tm); // normalize
+
+    int first_wday = tm.tm_wday;
+    for (int d = 1; d <= 31; ++d) {
+        tm.tm_mday = d;
+        mktime(&tm);
+        if (tm.tm_mon != month_ - 1) break; // overflow to next month
+        if (tm.tm_wday == target_wd) {
+            days_in_month[num_days++] = d;
+        }
+    }
+
+    int chosen_day = 0;
+    switch (week) {
+        case Week::first:
+            chosen_day = days_in_month[0];
+            break;
+        case Week::second:
+            chosen_day = days_in_month[1];
+            break;
+        case Week::third:
+            chosen_day = days_in_month[2];
+            break;
+        case Week::fourth:
+            chosen_day = days_in_month[3];
+            break;
+        case Week::last:
+            chosen_day = days_in_month[num_days - 1];
+            break;
+        case Week::teenth:
+            for (int i = 0; i < num_days; ++i) {
+                if (days_in_month[i] >= 13 && days_in_month[i] <= 19) {
+                    chosen_day = days_in_month[i];
+                    break;
+                }
+            }
+            break;
+    }
+
+    return Date{year_, month_, chosen_day};
+}
+
 }  // namespace meetup
