#include "meetup.h"

#include <boost/date_time/gregorian/gregorian.hpp>

namespace meetup {

scheduler::scheduler(boost::gregorian::months_of_year month, int year)
    : month_(month), year_(year) {}

boost::gregorian::date scheduler::teenth(int weekday) const {
    using namespace boost::gregorian;
    date d(year_, month_, 13);
    while (d.day_of_week().as_number() != weekday) {
        d += days(1);
    }
    return d;
}

boost::gregorian::date scheduler::nth(int weekday, int n) const {
    using namespace boost::gregorian;
    date d(year_, month_, 1);
    int count = 0;
    while (d.month() == month_) {
        if (d.day_of_week().as_number() == weekday) {
            ++count;
            if (count == n) return d;
        }
        d += days(1);
    }
    return d; // should not happen
}

boost::gregorian::date scheduler::last(int weekday) const {
    using namespace boost::gregorian;
    date d(year_, month_, 1);
    date result;
    bool found = false;
    while (d.month() == month_) {
        if (d.day_of_week().as_number() == weekday) {
            result = d;
            found = true;
        }
        d += days(1);
    }
    (void)found;
    return result;
}

boost::gregorian::date scheduler::monteenth() const { return teenth(1); }
boost::gregorian::date scheduler::tuesteenth() const { return teenth(2); }
boost::gregorian::date scheduler::wednesteenth() const { return teenth(3); }
boost::gregorian::date scheduler::thursteenth() const { return teenth(4); }
boost::gregorian::date scheduler::friteenth() const { return teenth(5); }
boost::gregorian::date scheduler::saturteenth() const { return teenth(6); }
boost::gregorian::date scheduler::sunteenth() const { return teenth(0); }

boost::gregorian::date scheduler::first_monday() const { return nth(1, 1); }
boost::gregorian::date scheduler::first_tuesday() const { return nth(2, 1); }
boost::gregorian::date scheduler::first_wednesday() const { return nth(3, 1); }
boost::gregorian::date scheduler::first_thursday() const { return nth(4, 1); }
boost::gregorian::date scheduler::first_friday() const { return nth(5, 1); }
boost::gregorian::date scheduler::first_saturday() const { return nth(6, 1); }
boost::gregorian::date scheduler::first_sunday() const { return nth(0, 1); }

boost::gregorian::date scheduler::second_monday() const { return nth(1, 2); }
boost::gregorian::date scheduler::second_tuesday() const { return nth(2, 2); }
boost::gregorian::date scheduler::second_wednesday() const { return nth(3, 2); }
boost::gregorian::date scheduler::second_thursday() const { return nth(4, 2); }
boost::gregorian::date scheduler::second_friday() const { return nth(5, 2); }
boost::gregorian::date scheduler::second_saturday() const { return nth(6, 2); }
boost::gregorian::date scheduler::second_sunday() const { return nth(0, 2); }

