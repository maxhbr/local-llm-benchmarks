variable_length_quantity.go
```
package variablelengthquantity

import (
	"errors"
)

func EncodeVarint(input []uint32) []byte {
	var output []byte
	for _, value := range input {
		// Break value into 7-bit groups
		var bytes []byte
		if value == 0 {
			bytes = append(bytes, 0x00)
		} else {
			for value > 0 {
				bytes = append(bytes, byte(value&0x7F))
				value >>= 7
			}
		}
		// Set continuation bit on all but the last byte
		for i := 0; i < len(bytes)-1; i++ {
			bytes[i] |= 0x80
		}
		// Append in reverse order (least significant group first)
		for i := len(bytes) - 1; i >= 0; i-- {
			output = append(output, bytes[i])
		}
	}
	return output
}

func DecodeVarint(input []byte) ([]uint32, error) {
	var output []uint32
	var current uint32 = 0
	var shift uint = 0
	for _, b := range input {
		current |= uint32(b&0x7F) << shift
		shift += 7
		if b&0x80 == 0 {
			// Last byte of this varint
			output = append(output, current)
			current = 0
			shift = 0
		} else if shift >= 32 {
			// Continuation bit set but we've exceeded 32 bits
			return nil, errors.New("varint too long for 32-bit uint")
		}
	}
	if shift != 0 {
		// Input ended with a continuation bit (incomplete varint)
		return nil, errors.New("incomplete varint")
	}
	return output, nil
}
