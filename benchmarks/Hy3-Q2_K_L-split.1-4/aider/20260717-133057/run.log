Changes needed:
1. Implement `__init__` to store a database of users (name -> owes/owed_by mapping).
2. Implement `get` to handle `/users` and return user objects (all or filtered by payload).
3. Implement `post` to handle `/add` (create user) and `/iou` (record IOU and update balances).
4. Add helper methods to build user objects and update debts.

rest_api.py
```
import json

class RestAPI:
    def __init__(self, database=None):
        # database format: {"users": [{"name": str, "owes": {}, "owed_by": {}}]}
        self.users = {}
        if database and "users" in database:
            for u in database["users"]:
                self.users[u["name"]] = {
                    "owes": dict(u.get("owes", {})),
                    "owed_by": dict(u.get("owed_by", {}))
                }

    def _user_object(self, name):
        data = self.users[name]
        owes = data["owes"]
        owed_by = data["owed_by"]
        balance = sum(owed_by.values()) - sum(owes.values())
        return {
            "name": name,
            "owes": owes,
            "owed_by": owed_by,
            "balance": round(balance, 10)
        }

    def get(self, url, payload=None):
        if url == "/users":
            if payload:
                data = json.loads(payload) if isinstance(payload, str) else payload
                names = data.get("users", [])
            else:
                names = list(self.users.keys())
            user_objs = [self._user_object(n) for n in names]
            user_objs.sort(key=lambda u: u["name"])
            return {"users": user_objs}
        return {}

    def post(self, url, payload=None):
        data = json.loads(payload) if isinstance(payload, str) else payload
        if url == "/add":
            name = data["user"]
            if name not in self.users:
                self.users[name] = {"owes": {}, "owed_by": {}}
            return self._user_object(name)
        elif url == "/iou":
            lender = data["lender"]
            borrower = data["borrower"]
            amount = float(data["amount"])
            # lender owed_by borrower increases
            self.users[lender]["owed_by"][borrower] = (
                self.users[lender]["owed_by"].get(borrower, 0.0) + amount
            )
            # borrower owes lender increases
            self.users[borrower]["owes"][lender] = (
                self.users[borrower]["owes"].get(lender, 0.0) + amount
            )
            # simplify symmetric debts
            self._simplify(lender, borrower)
            user_objs = [self._user_object(lender), self._user_object(borrower)]
            user_objs.sort(key=lambda u: u["name"])
            return {"users": user_objs}
        return {}

    def _simplify(self, user1, user2):
        u1 = self.users[user1]
        u2 = self.users[user2]
        # net what user1 owes user2
        owed_by_1_to_2 = u1["owes"].get(user2, 0.0)
        owed_by_2_to_1 = u2["owes"].get(user1, 0.0)
        net = owed_by_1_to_2 - owed_by_2_to_1
        if net > 0:
            # user1 owes user2 net
            u1["owes"][user2] = net
            u2["owed_by"][user1] = net
        elif net < 0:
            # user2 owes user1 -net
            u2["owes"][user1] = -net
            u1["owed_by"][user2] = -net
        else:
            # zero out
            u1["owes"].pop(user2, None)
            u2["owed_by"].pop(user1, None)
        # clean zeros
        if u1["owes"].get(user2, 0.0) == 0.0:
            u1["owes"].pop(user2, None)
        if u2["owed_by"].get(user1, 0.0) == 0.0:
            u2["owed_by"].pop(user1, None)
        if u2["owes"].get(user1, 0.0) == 0.0:
            u2["owes"].pop(user1, None)
        if u1["owed_by"].get(user2, 0.0) == 0.0:
            u1["owed_by"].pop(user2, None)
```
