                    stack.append((0, c))
        else:  # 'X'
            for r in range(self.rows):
                if self.grid[r][0] == 'X':
                    stack.append((r, 0))

        # Hex adjacency directions for offset rows
        directions = [(-1, -1), (-1, 0), (0, -1), (0, 1), (1, -1), (1, 0)]

        while stack:
            r, c = stack.pop()
            if visited[r][c]:
