// You should change this.
//
// Depending on your implementation, there are a variety of potential errors
// which might occur. They aren't checked by the test suite in order to
// allow the greatest freedom of implementation, but real libraries should
// provide useful, descriptive errors so that downstream code can react
// appropriately.
//
// One common idiom is to define an Error enum which wraps all potential
// errors. Another common idiom is to use a helper type such as failure::Error
// which does more or less the same thing but automatically.
#[derive(Debug)]
pub struct Error;

pub struct Scale {
    notes: Vec<String>,
    start_index: usize,
    intervals: Vec<usize>,
}

impl Scale {
    pub fn new(tonic: &str, intervals: &str) -> Result<Scale, Error> {
        let flat_tonics = [
            "F", "Bb", "Eb", "Ab", "Db", "Gb",
            "d", "g", "c", "f", "bb", "eb",
        ];
        let use_flats = flat_tonics.contains(&tonic);

        let chromatic = if use_flats {
            vec![
                "A", "Bb", "B", "C", "Db", "D", "Eb", "E", "F", "Gb", "G", "Ab",
            ]
            .iter()
            .map(|s| s.to_string())
            .collect::<Vec<String>>()
        } else {
            vec![
                "A", "A#", "B", "C", "C#", "D", "D#", "E", "F", "F#", "G", "G#",
            ]
            .iter()
            .map(|s| s.to_string())
            .collect::<Vec<String>>()
        };

        let tonic_capitalized = if let Some(first) = tonic.chars().next() {
            let rest = &tonic[1..];
            format!("{}{}", first.to_uppercase(), rest)
        } else {
            tonic.to_string()
        };

        let start_index = chromatic
            .iter()
            .position(|n| n == &tonic_capitalized)
            .unwrap_or(0);

        let intervals_parsed = intervals
            .chars()
            .map(|c| match c {
                'm' => 1,
                'M' => 2,
                'A' => 3,
                _ => 1,
            })
            .collect::<Vec<usize>>();

        Ok(Scale {
            notes: chromatic,
            start_index,
            intervals: intervals_parsed,
        })
    }

    pub fn chromatic(tonic: &str) -> Result<Scale, Error> {
        Self::new(tonic, "mmmmmmmmmmmm")
    }

    pub fn enumerate(&self) -> Vec<String> {
        let mut result = Vec::new();
        let mut current = self.start_index;
        result.push(self.notes[current].clone());
        for &interval in &self.intervals {
            current = (current + interval) % self.notes.len();
            result.push(self.notes[current].clone());
        }
        result
    }
}
```

