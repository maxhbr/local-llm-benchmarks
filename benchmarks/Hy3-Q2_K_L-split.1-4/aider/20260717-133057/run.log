package twobucket

import (
	"errors"
	"fmt"
)

func gcd(a, b int) int {
	for b != 0 {
		a, b = b, a%b
	}
	return a
}

func Solve(sizeBucketOne, sizeBucketTwo, goalAmount int, startBucket string) (string, int, int, error) {
	if sizeBucketOne <= 0 || sizeBucketTwo <= 0 {
		return "", 0, 0, errors.New("bucket sizes must be positive")
	}
	if goalAmount <= 0 {
		return "", 0, 0, errors.New("goal amount must be positive")
	}
	if goalAmount > sizeBucketOne && goalAmount > sizeBucketTwo {
		return "", 0, 0, errors.New("goal amount exceeds both bucket sizes")
	}
	if startBucket != "one" && startBucket != "two" {
		return "", 0, 0, errors.New("start bucket must be 'one' or 'two'")
	}

	// Bonus: check if solvable (gcd must divide goal)
	if goalAmount%gcd(sizeBucketOne, sizeBucketTwo) != 0 {
		return "", 0, 0, errors.New("cannot solve with given bucket sizes")
	}

	var b1, b2 int // current levels
	steps := 0

	// initial fill
	if startBucket == "one" {
		b1 = sizeBucketOne
		b2 = 0
	} else {
		b1 = 0
		b2 = sizeBucketTwo
	}
	steps = 1

	if b1 == goalAmount {
		return "one", steps, b2, nil
	}
	if b2 == goalAmount {
		return "two", steps, b1, nil
	}

	// simulate
	for {
		if startBucket == "one" {
			// forbidden: b1 == 0 && b2 == sizeBucketTwo
			if b1 == 0 && b2 == sizeBucketTwo {
				return "", 0, 0, errors.New("invalid state reached")
			}
		} else {
			if b2 == 0 && b1 == sizeBucketOne {
				return "", 0, 0, errors.New("invalid state reached")
			}
		}

		// action: pour from one to two or two to one
		if startBucket == "one" {
			// pour from one to two
			transfer := b1
			if b2+transfer > sizeBucketTwo {
				transfer = sizeBucketTwo - b2
			}
			b1 -= transfer
			b2 += transfer
		} else {
			// pour from two to one
			transfer := b2
			if b1+transfer > sizeBucketOne {
				transfer = sizeBucketOne - b1
			}
			b2 -= transfer
			b1 += transfer
		}
		steps++
		if b1 == goalAmount {
			return "one", steps, b2, nil
		}
		if b2 == goalAmount {
			return "two", steps, b1, nil
		}

		// next action: if start bucket empty, fill it; else empty other? Actually standard algorithm:
		// alternate between pouring and then either filling start or emptying other.
		// We follow typical water jug: after pour, if start bucket empty, fill it; if other full, empty it.
		if startBucket == "one" {
			if b1 == 0 {
				b1 = sizeBucketOne
				steps++
				if b1 == goalAmount {
					return "one", steps, b2, nil
				}
				if b2 == goalAmount {
					return "two", steps, b1, nil
				}
			} else if b2 == sizeBucketTwo {
				b2 = 0
				steps++
				if b1 == goalAmount {
					return "one", steps, b2, nil
				}
				if b2 == goalAmount {
					return "two", steps, b1, nil
				}
			}
		} else {
			if b2 == 0 {
				b2 = sizeBucketTwo
				steps++
				if b1 == goalAmount {
					return "one", steps, b2, nil
