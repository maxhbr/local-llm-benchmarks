package twobucket



import (

        "errors"

)



func gcd(a, b int) int {

        for b != 0 {

                a, b = b, a%b

        }

        return a

}



func Solve(sizeBucketOne, sizeBucketTwo, goalAmount int, startBucket string) (string, int, int, error) {

        if sizeBucketOne <= 0 || sizeBucketTwo <= 0 {

                return "", 0, 0, errors.New("invalid bucket sizes")

        }

        if goalAmount <= 0 {

                return "", 0, 0, errors.New("invalid goal amount")

        }

        if goalAmount > sizeBucketOne && goalAmount > sizeBucketTwo {

                return "", 0, 0, errors.New("goal amount too large")

        }

        if startBucket != "one" && startBucket != "two" {

                return "", 0, 0, errors.New("invalid start bucket")

        }



        // Bonus: check solvability

        if goalAmount%gcd(sizeBucketOne, sizeBucketTwo) != 0 {

                return "", 0, 0, errors.New("unsolvable")

        }



        b1, b2 := 0, 0

        steps := 0



        // step 1: fill start bucket

        if startBucket == "one" {

                b1 = sizeBucketOne

        } else {

                b2 = sizeBucketTwo

        }

        steps = 1

        if b1 == goalAmount {

                return "one", steps, b2, nil

        }

        if b2 == goalAmount {

                return "two", steps, b1, nil

        }



        // loop following rules

        for steps < 1000 { // safety limit

                if startBucket == "one" {

                        if b1 == 0 {

                                // fill bucket one

                                b1 = sizeBucketOne

                                steps++

                        } else if b2 == sizeBucketTwo {

                                // empty bucket two

                                b2 = 0

                                steps++

                        } else {

                                // pour from one to two

                                transfer := b1

                                if b2+transfer > sizeBucketTwo {

                                        transfer = sizeBucketTwo - b2

                                }

                                b1 -= transfer

                                b2 += transfer

                                steps++

                        }

                } else {

                        if b2 == 0 {

                                // fill bucket two

                                b2 = sizeBucketTwo

                                steps++

                        } else if b1 == sizeBucketOne {

                                // empty bucket one

                                b1 = 0

                                steps++

                        } else {

                                // pour from two to one

                                transfer := b2

                                if b1+transfer > sizeBucketOne {

                                        transfer = sizeBucketOne - b1

                                }

                                b2 -= transfer

                                b1 += transfer

                                steps++

                        }

                }



                if b1 == goalAmount {

                        return "one", steps, b2, nil

                }

                if b2 == goalAmount {

                        return "two", steps, b1, nil

                }

        }



        return "", 0, 0, errors.New("no solution found")

}

