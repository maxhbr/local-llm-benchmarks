The tests expect `get` and `post` methods to return a **JSON string** (since they call `json.loads(response)`), but the current implementation returns Python dicts. Also, the IOU logic must correctly net out symmetric debts between lender and borrower (the current `_simplify` method is wrong and causes incorrect balances). We need to:

1. Make `get` and `post` return `json.dumps(...)` strings.
2. Fix the IOU recording so that adding a new loan correctly reduces any existing opposite debt (netting) instead of just adding both sides.
3. Ensure balances and structures match the spec (e.g., remove zero entries, keep correct owed/owes).

Here is the corrected file:

rest_api.py
```
import json

class RestAPI:
    def __init__(self, database=None):
        # database format: {"users": [{"name": str, "owes": {}, "owed_by": {}}]}
        self.users = {}
        if database and "users" in database:
            for u in database["users"]:
                self.users[u["name"]] = {
                    "owes": dict(u.get("owes", {})),
                    "owed_by": dict(u.get("owed_by", {}))
                }

    def _user_object(self, name):
        data = self.users[name]
        owes = data["owes"]
        owed_by = data["owed_by"]
        balance = sum(owed_by.values()) - sum(owes.values())
        return {
            "name": name,
            "owes": owes,
            "owed_by": owed_by,
            "balance": round(balance, 10)
        }

    def get(self, url, payload=None):
        if url == "/users":
            if payload:
                data = json.loads(payload) if isinstance(payload, str) else payload
                names = data.get("users", [])
            else:
                names = list(self.users.keys())
            user_objs = [self._user_object(n) for n in names]
            user_objs.sort(key=lambda u: u["name"])
            return json.dumps({"users": user_objs})
        return json.dumps({})

    def post(self, url, payload=None):
        data = json.loads(payload) if isinstance(payload, str) else payload
        if url == "/add":
            name = data["user"]
            if name not in self.users:
                self.users[name] = {"owes": {}, "owed_by": {}}
            return json.dumps(self._user_object(name))
        elif url == "/iou":
            lender = data["lender"]
            borrower = data["borrower"]
            amount = float(data["amount"])
            # Record new loan: borrower owes lender 'amount'
            # First net out any existing opposite debt
            existing_opposite = self.users[lender]["owes"].get(borrower, 0.0)
            if existing_opposite > 0:
                # lender already owes borrower => reduce that debt
                net = existing_opposite - amount
                if net > 0:
                    self.users[lender]["owes"][borrower] = net
                    self.users[borrower]["owed_by"][lender] = net
                else:
                    # lender no longer owes borrower
                    self.users[lender]["owes"].pop(borrower, None)
                    self.users[borrower]["owed_by"].pop(lender, None)
                    if net < 0:
                        # borrower now owes lender -net
                        self.users[borrower]["owes"][lender] = -net
                        self.users[lender]["owed_by"][borrower] = -net
            else:
                # no existing opposite debt, just add new debt
                self.users[borrower]["owes"][lender] = (
                    self.users[borrower]["owes"].get(lender, 0.0) + amount
                )
                self.users[lender]["owed_by"][borrower] = (
                    self.users[lender]["owed_by"].get(borrower, 0.0) + amount
                )
            # clean up zero entries
            for a, b in [(lender, borrower), (borrower, lender)]:
                if self.users[a]["owes"].get(b, 0.0) == 0.0:
                    self.users[a]["owes"].pop(b, None)
                if self.users[a]["owed_by"].get(b, 0.0) == 0.0:
                    self.users[a]["owed_by"].pop(b, None)
            user_objs = [self._user_object(lender), self._user_object(borrower)]
            user_objs.sort(key=lambda u: u["name"])
            return json.dumps({"users": user_objs})
        return json.dumps({})
```
