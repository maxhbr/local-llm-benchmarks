const WEEKDAYS = { Sunday:0, Monday:1, Tuesday:2, Wednesday:3, Thursday:4, Friday:5, Saturday:6 };
const ORDINALS = { first:1, second:2, third:3, fourth:4 };

export const meetup = (year, month, weekday, descriptor) => {
  const monthIndex = month - 1;
  const targetDay = typeof weekday === 'string' ? WEEKDAYS[weekday] : weekday;

  if (descriptor === 'teenth') {
    const date = new Date(year, monthIndex, 13);
    while (date.getDay() !== targetDay) date.setDate(date.getDate() + 1);
    return date;
  }

  if (descriptor === 'last') {
    const date = new Date(year, monthIndex + 1, 0);
    while (date.getDay() !== targetDay) date.setDate(date.getDate() - 1);
    return date;
  }

  const occurrence = ORDINALS[descriptor];
  const date = new Date(year, monthIndex, (occurrence - 1) * 7 + 1);
  while (date.getDay() !== targetDay) date.setDate(date.getDate() + 1);
  return date;
};

