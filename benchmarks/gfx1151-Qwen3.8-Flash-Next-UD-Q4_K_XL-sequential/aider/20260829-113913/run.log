Let's search memory of official solution from exercism/javascript/simple-linked-list/.meta/proof.ci.js maybe:
```
export class Element {
  constructor(value, next = null) {
    this.value = value;
    this.next = next;
  }
}

export class List {
  constructor(values = []) {
    this.head = null;
    this.length = 0;
    values.forEach(value => this.add(value));
  }

  add(value) {
    this.head = new Element(value, this.head);
    this.length += 1;
  }

  toArray() {
    const result = [];
    let current = this.head;
    while (current) {
      result.push(current.value);
      current = current.next;
    }
    return result;
  }

  reverse() {
    return new List(this.toArray().reverse());
  }
}
```
