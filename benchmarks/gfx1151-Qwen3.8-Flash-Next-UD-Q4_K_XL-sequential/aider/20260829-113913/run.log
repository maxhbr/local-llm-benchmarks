```
const WEEKDAYS = {
  sun: 0,
  mon: 1,
  tue: 2,
  wed: 3,
  thu: 4,
  fri: 5,
  sat: 6,
};

const ORDINALS = {
  first: 1,
  second: 2,
  third: 3,
  fourth: 4,
  fifth: 5,
};

const toWeekdayNumber = (weekday) => {
  if (typeof weekday === 'number') {
    return weekday;
  }
  return WEEKDAYS[weekday.slice(0, 3).toLowerCase()];
};

export const meetup = (year, month, weekday, descriptor) => {
  const monthIndex = month - 1;
  const targetDay = toWeekdayNumber(weekday);
  const week = descriptor.toLowerCase();

  if (targetDay === undefined) {
    throw new Error('Unknown weekday');
  }

  if (week === 'teenth') {
    const startDay = new Date(year, monthIndex, 13).getDay();
    const day = 13 + ((targetDay - startDay + 7) % 7);
    return new Date(year, monthIndex, day);
  }

  if (week === 'last') {
    const lastDay = new Date(year, monthIndex + 1, 0).getDate();
    const lastWeekday = new Date(year, monthIndex, lastDay).getDay();
    const day = lastDay - ((lastWeekday - targetDay + 7) % 7);
    return new Date(year, monthIndex, day);
  }

  const occurrence = ORDINALS[week];
  if (occurrence === undefined) {
    throw new Error('Unknown week descriptor');
  }

  const firstWeekday = new Date(year, monthIndex, 1).getDay();
  const day = 1 + ((targetDay - firstWeekday + 7) % 7) + (occurrence - 1) * 7;
  const lastDay = new Date(year, monthIndex + 1, 0).getDate();

  if (day > lastDay) {
    throw new Error('Invalid meetup date');
  }

  return new Date(year, monthIndex, day);
};
```

