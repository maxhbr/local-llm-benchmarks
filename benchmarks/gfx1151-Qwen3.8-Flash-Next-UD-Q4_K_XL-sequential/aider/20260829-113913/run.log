constructor(values = []) {
  this._head = null;
  this._tail = null;
  this._length = 0;
  if (values) for (const value of values) this.add(value);
}
add(nextValue) {
  const element = new Element(nextValue, null);
  if (!this._head) {
    this._head = element;
    this._tail = element;
  } else {
    this._tail._next = element;
    this._tail = element;
  }
  this._length += 1;
}
reverse() {
  let previous = null;
  let current = this._head;
  const oldHead = this._head;
  while (current) {
    const next = current.next;
    current._next = previous;
    previous = current;
    current = next;
  }
  this._head = previous;
  this._tail = oldHead;
  return this;
}
```
