const WEEKDAYS = {
  sun: 0,
  mon: 1,
  tue: 2,
  wed: 3,
  thu: 4,
  fri: 5,
  sat: 6,
};

const ORDINALS = {
  first: 1,
  second: 2,
  third: 3,
  fourth: 4,
  fifth: 5,
};

const weekdayNumber = (weekday) => {
  if (typeof weekday === 'number') {
    return weekday;
  }
  return WEEKDAYS[weekday.slice(0, 3).toLowerCase()];
};

export const meetup = (year, month, weekday, descriptor) => {
  const monthIndex = month - 1;
  const targetDay = weekdayNumber(weekday);
  const week = descriptor.toLowerCase();

  if (week === 'teenth') {
    const teenthStartDay = new Date(year, monthIndex, 13).getDay();
    const day = 13 + ((targetDay - teenthStartDay + 7) % 7);
    return new Date(year, monthIndex, day);
  }

  if (week === 'last') {
    const lastDayOfMonth = new Date(year, monthIndex + 1, 0).getDate();
    const lastDayOfWeek = new Date(year, monthIndex, lastDayOfMonth).getDay();
    const day = lastDayOfMonth - ((lastDayOfWeek - targetDay + 7) % 7);
    return new Date(year, monthIndex, day);
  }

  const occurrence = ORDINALS[week];
  const firstDayOfMonth = new Date(year, monthIndex, 1).getDay();
  const day = 1 + ((targetDay - firstDayOfMonth + 7) % 7) + (occurrence - 1) * 7;

  if (occurrence === undefined || day > new Date(year, monthIndex + 1, 0).getDate()) {
    throw new Error('Invalid meetup date');
  }

  return new Date(year, monthIndex, day);
};
```

