Implementation:
```
const WEEKDAYS = { sun:0, mon:1, tue:2, wed:3, thu:4, fri:5, sat:6 };
const ORDINALS = { first:1, second:2, third:3, fourth:4 };

const weekdayNumber = (weekday) => {
  if (typeof weekday === 'number') return weekday;
  return WEEKDAYS[weekday.slice(0, 3).toLowerCase()];
};

export const meetup = (year, month, weekday, descriptor) => {
  const monthIndex = month - 1;
  const target = weekdayNumber(weekday);
  const key = descriptor.toLowerCase();

  if (key === 'teenth') {
    const start = new Date(year, monthIndex, 13).getDay();
    const day = 13 + ((target - start + 7) % 7);
    return new Date(year, monthIndex, day);
  }

  if (key === 'last') {
    const lastDay = new Date(year, monthIndex + 1, 0).getDate();
    const lastWeekday = new Date(year, monthIndex, lastDay).getDay();
    const day = lastDay - ((lastWeekday - target + 7) % 7);
    return new Date(year, monthIndex, day);
  }

  const occurrence = ORDINALS[key];
  const firstDay = new Date(year, monthIndex, 1).getDay();
  const day = 1 + ((target - firstDay + 7) % 7) + (occurrence - 1) * 7;
  return new Date(year, monthIndex, day);
};
```

