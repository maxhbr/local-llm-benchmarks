simple-linked-list.js
```
export class Element {
  constructor(value, next = null) {
    this._value = value;
    this._next = next;
  }

  get value() {
    return this._value;
  }

  get next() {
    return this._next;
  }
}

export class List {
  constructor(values = []) {
    this._head = null;
    this._length = 0;

    if (values) {
      for (const value of values) {
        this.add(value);
      }
    }
  }

  add(nextValue) {
    this._head = new Element(nextValue, this._head);
    this._length += 1;
  }

  get length() {
    return this._length;
  }

  get head() {
    return this._head;
  }

  toArray() {
    const values = [];
    let current = this._head;

    while (current) {
      values.push(current.value);
      current = current.next;
    }

    return values;
  }

  reverse() {
    let previous = null;
    let current = this._head;

    while (current) {
      const next = current.next;
      current._next = previous;
      previous = current;
      current = next;
    }

    this._head = previous;
    return this;
  }
}
```
