    this._length += 1;
  }
  get length() { return this._length; }
  get head() { return this._head; }
  toArray() {
    const result = [];
    let current = this._head;
    while (current) { result.push(current.value); current = current.next; }
    return result;
  }
  reverse() {
    return new List(this.toArray().reverse());
  }
}
