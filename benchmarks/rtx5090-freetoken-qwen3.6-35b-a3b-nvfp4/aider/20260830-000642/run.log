              for (int i = 0; i < letters.size(); i++) {
                  result.put(letters.get(i), assignment[i]);
              }
              return result;
          }
          throw new UnsolvablePuzzleException();
      }

      private boolean backtrack(int idx, long currentSum, int[] assignment, boolean[] used) {
          if (idx == letters.size()) {
              return currentSum == 0;
          }

          char c = letters.get(idx);
          long weight = letterWeights[idx];
          boolean isLeading = nonZeroLetters.contains(c);

