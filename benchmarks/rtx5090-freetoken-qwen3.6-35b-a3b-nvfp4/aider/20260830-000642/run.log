// this module adds some functionality based on the required implementations
// here like: `LinkedList::pop_back` or `Clone for LinkedList<T>`
// You are free to use anything in it, but it's mainly for the test framework.
mod pre_implemented;

struct Node<T> {
    prev: *mut Node<T>,
    next: *mut Node<T>,
    data: T,
}

pub struct LinkedList<T> {
    head: *mut Node<T>,
    tail: *mut Node<T>,
    len: usize,
}

pub struct Cursor<'a, T> {
    list: *mut LinkedList<T>,
    current: *mut Node<T>,
    _marker: std::marker::PhantomData<&'a mut T>,
}

pub struct Iter<'a, T> {
    current: *mut Node<T>,
    _marker: std::marker::PhantomData<&'a T>,
}

impl<T> LinkedList<T> {
    pub fn new() -> Self {
        LinkedList {
            head: std::ptr::null_mut(),
            tail: std::ptr::null_mut(),
            len: 0,
        }
    }

    pub fn is_empty(&self) -> bool {
        self.len == 0
    }

    pub fn len(&self) -> usize {
        self.len
    }

    /// Return a cursor positioned on the front element
    pub fn cursor_front(&mut self) -> Cursor<'_, T> {
        Cursor {
            list: self as *mut LinkedList<T>,
            current: self.head,
            _marker: std::marker::PhantomData,
        }
    }

    /// Return a cursor positioned on the back element
    pub fn cursor_back(&mut self) -> Cursor<'_, T> {
        Cursor {
            list: self as *mut LinkedList<T>,
            current: self.tail,
            _marker: std::marker::PhantomData,
        }
    }

    /// Return an iterator that moves from front to back
    pub fn iter(&self) -> Iter<'_, T> {
        Iter {
            current: self.head,
            _marker: std::marker::PhantomData,
        }
    }
}

// the cursor is expected to act as if it is at the position of an element
// and it also has to work with and be able to insert into an empty list.
impl<T> Cursor<'_, T> {
    /// Take a mutable reference to the current element
    pub fn peek_mut(&mut self) -> Option<&mut T> {
        if self.current.is_null() {
            None
        } else {
            // SAFETY: `self.current` is guaranteed to be a valid pointer to a `Node<T>`
            // that is owned by the `LinkedList`. Dereferencing it is safe.
            Some(unsafe { &mut (*self.current).data })
        }
    }

    /// Move one position forward (towards the back) and
    /// return a reference to the new position
    #[allow(clippy::should_implement_trait)]
    pub fn next(&mut self) -> Option<&mut T> {
        if self.current.is_null() {
            return None;
        }
        let node = unsafe { &mut *self.current };
        self.current = node.next;
        if self.current.is_null() {
            None
        } else {
            // SAFETY: `self.current` now points to a valid node in the list.
            Some(unsafe { &mut (*self.current).data })
        }
    }

    /// Move one position backward (towards the front) and
    /// return a reference to the new position
    pub fn prev(&mut self) -> Option<&mut T> {
        if self.current.is_null() {
            return None;
        }
        let node = unsafe { &mut *self.current };
        self.current = node.prev;
        if self.current.is_null() {
            None
        } else {
            // SAFETY: `self.current` now points to a valid node in the list.
            Some(unsafe { &mut (*self.current).data })
        }
    }

    /// Remove and return the element at the current position and move the cursor
    /// to the neighboring element that's closest to the back. This can be
    /// either the next or previous position.
    pub fn take(&mut self) -> Option<T> {
        if self.current.is_null() {
            return None;
        }
        
        let list = unsafe { &mut *self.list };
        let node_ptr = self.current;
        
        // SAFETY: `node_ptr` is a valid pointer to a `Node<T>` owned by the list.
        let node = unsafe { &mut *node_ptr };
        let prev = node.prev;
        let next = node.next;
        
        // Update list links
        if let Some(prev) = unsafe { prev.as_mut() } {
            prev.next = next;
        } else {
            list.head = next;
        }
        
        if let Some(next) = unsafe { next.as_mut() } {
            next.prev = prev;
        } else {
            list.tail = prev;
        }
        
        list.len -= 1;
        
        // Move cursor
        if next.is_null() {
            self.current = prev;
        } else {
            self.current = next;
        }
        
        // Extract data and free node
        // SAFETY: We have exclusive access to the node (unlinked from the list).
        let data = unsafe { std::ptr::read(&(*node_ptr).data) };
        drop(unsafe { Box::from_raw(node_ptr) });
        
        Some(data)
    }

    pub fn insert_after(&mut self, element: T) {
        self.insert(element, true)
    }

    pub fn insert_before(&mut self, element: T) {
        self.insert(element, false)
    }
    
    fn insert(&mut self, element: T, after: bool) {
        let new_node = Box::into_raw(Box::new(Node {
            prev: std::ptr::null_mut(),
            next: std::ptr::null_mut(),
            data: element,
        }));
        
        let list = unsafe { &mut *self.list };
        
        if self.current.is_null() {
            list.head = new_node;
            list.tail = new_node;
        } else if after {
            let next = unsafe { (*self.current).next };
            unsafe { (*self.current).next = new_node };
            unsafe { (*new_node).prev = self.current };
            unsafe { (*new_node).next = next };
            if next.is_null() {
                list.tail = new_node;
            } else {
                unsafe { (*next).prev = new_node };
            }
        } else {
            let prev = unsafe { (*self.current).prev };
            unsafe { (*self.current).prev = new_node };
            unsafe { (*new_node).next = self.current };
            unsafe { (*new_node).prev = prev };
            if prev.is_null() {
                list.head = new_node;
            } else {
                unsafe { (*prev).next = new_node };
            }
        }
        
        list.len += 1;
        self.current = new_node;
    }
}

impl<'a, T> Iterator for Iter<'a, T> {
    type Item = &'a T;

    fn next(&mut self) -> Option<&'a T> {
        if self.current.is_null() {
            None
        } else {
            // SAFETY: `self.current` points to a valid node in the list.
            let node = unsafe { &*self.current };
            self.current = node.next;
            Some(&node.data)
        }
    }
}

impl<T> Drop for LinkedList<T> {
    fn drop(&mut self) {
        let mut current = self.head;
        while !current.is_null() {
            // SAFETY: `current` is a valid pointer to a `Node<T>` allocated in the list.
            let node = unsafe { Box::from_raw(current) };
            current = node.next;
            drop(node);
        }
    }
}

// SAFETY: `LinkedList` contains raw pointers, but its behavior is safe as long as `T` is `Send`.
// All mutations are controlled and memory is properly managed.
unsafe impl<T: Send> Send for LinkedList<T> {}

// SAFETY: `LinkedList` contains raw pointers, but its behavior is safe as long as `T` is `Sync`.
// Concurrent reads are safe, and mutations are controlled via `&mut self`.
unsafe impl<T: Sync> Sync for LinkedList<T> {}
