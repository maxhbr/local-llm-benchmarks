```java
import org.json.JSONObject;
import org.json.JSONArray;
import java.util.*;
import java.util.stream.Collectors;

class RestApi {
    private final Map<String, User> users = new LinkedHashMap<>();

    RestApi(User... users) {
        for (User user : users) {
            this.users.put(user.name(), user);
        }
    }

    String get(String url) {
        return get(url, null);
    }

    String get(String url, JSONObject payload) {
        if ("/users".equals(url)) {
            JSONArray usersArray = new JSONArray();
            List<User> userList = new ArrayList<>(users.values());

            if (payload != null && payload.has("users")) {
                JSONArray filterNames = payload.getJSONArray("users");
                List<String> names = new ArrayList<>();
                for (int i = 0; i < filterNames.length(); i++) {
                    names.add(filterNames.getString(i));
                }
                userList = userList.stream()
                        .filter(u -> names.contains(u.name()))
                        .collect(Collectors.toList());
            }

            userList.sort(Comparator.comparing(User::name));
            for (User u : userList) {
                usersArray.put(userToJson(u));
            }

            JSONObject response = new JSONObject();
            response.put("users", usersArray);
            return response.toString();
        }
        return "";
    }

    String post(String url, JSONObject payload) {
        if ("/add".equals(url)) {
            String name = payload.getString("user");
            User newUser = User.builder().setName(name).build();
            users.put(name, newUser);
            return userToJson(newUser).toString();
        } else if ("/iou".equals(url)) {
            String lender = payload.getString("lender");
            String borrower = payload.getString("borrower");
            double amount = payload.getDouble("amount");

            User updatedLender = updateOwedBy(users.get(lender), borrower, amount);
            User updatedBorrower = updateOwes(users.get(borrower), lender, amount);

            users.put(lender, updatedLender);
            users.put(borrower, updatedBorrower);

            List<User> result = new ArrayList<>();
            result.add(updatedLender);
            result.add(updatedBorrower);
            result.sort(Comparator.comparing(User::name));

            JSONArray usersArray = new JSONArray();
            for (User u : result) {
                usersArray.put(userToJson(u));
            }
            JSONObject response = new JSONObject();
            response.put("users", usersArray);
            return response.toString();
        }
        return "";
    }

    private User updateOwedBy(User user, String name, double amount) {
        List<Iou> newOwedBy = new ArrayList<>();
        double existingAmount = 0;
        boolean found = false;
        for (Iou iou : user.owedBy()) {
            if (iou.name().equals(name)) {
                existingAmount = iou.amount();
                found = true;
            } else {
                newOwedBy.add(iou);
            }
        }
        if (found) {
            existingAmount += amount;
        } else {
            existingAmount = amount;
        }
        if (existingAmount > 0) {
            newOwedBy.add(new Iou(name, existingAmount));
        }
        return User.builder()
                .setName(user.name())
                .owes(user.owes().stream().map(i -> new Iou(i.name(), i.amount())).collect(Collectors.toList()))
                .owedBy(newOwedBy)
                .build();
    }

    private User updateOwes(User user, String name, double amount) {
        List<Iou> newOwes = new ArrayList<>();
        double existingAmount = 0;
        boolean found = false;
        for (Iou iou : user.owes()) {
            if (iou.name().equals(name)) {
                existingAmount = iou.amount();
                found = true;
            } else {
                newOwes.add(iou);
            }
        }
        if (found) {
            existingAmount += amount;
        } else {
            existingAmount = amount;
        }
        if (existingAmount > 0) {
            newOwes.add(new Iou(name, existingAmount));
        }
        return User.builder()
                .setName(user.name())
                .owes(newOwes)
                .owedBy(user.owedBy().stream().map(i -> new Iou(i.name(), 
i.amount())).collect(Collectors.toList()))
                .build();
    }

    private JSONObject userToJson(User user) {
        JSONObject json = new JSONObject();
        json.put("name", user.name());

        JSONObject owes = new JSONObject();
        for (Iou iou : user.owes()) {
            owes.put(iou.name(), iou.amount());
        }
        json.put("owes", owes);

        JSONObject owedBy = new JSONObject();
        for (Iou iou : user.owedBy()) {
            owedBy.put(iou.name(), iou.amount());
        }
        json.put("owed_by", owedBy);

        json.put("balance", user.balance());

        return json;
    }
}
