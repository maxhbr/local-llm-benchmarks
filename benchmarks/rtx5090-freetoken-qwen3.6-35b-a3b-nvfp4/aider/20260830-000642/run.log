#include "kindergarten_garden.h"
#include <string>
#include <vector>
#include <cstddef>

namespace kindergarten_garden {

    Plant char_to_plant(char c) {
        switch(c) {
            case 'G': return Plant::Grass;
            case 'C': return Plant::Clover;
            case 'R': return Plant::Radishes;
            case 'V': return Plant::Violets;
            default: return Plant::Grass;
        }
    }

    std::vector<Plant> plants(std::string diagram, std::string student) {
        std::vector<Plant> result;
        result.reserve(4);

        size_t newline_pos = diagram.find('\n');
        size_t row1_start = 0;
        size_t row2_start = newline_pos + 1;
        
        size_t student_index = student[0] - 'A';
        size_t offset = student_index * 2;

        result.push_back(char_to_plant(diagram[row1_start + offset]));
        result.push_back(char_to_plant(diagram[row1_start + offset + 1]));
        result.push_back(char_to_plant(diagram[row2_start + offset]));
        result.push_back(char_to_plant(diagram[row2_start + offset + 1]));

        return result;
    }

}  // namespace kindergarten_garden
```
