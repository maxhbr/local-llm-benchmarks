```java
public String parse(List<String> input) {
    if (input.size() % 4 != 0) {
        throw new IllegalArgumentException("Number of horizontal lines must be a multiple of 4");
    }
    for (String line : input) {
        if (line.length() % 3 != 0) {
            throw new IllegalArgumentException("Number of vertical columns must be a multiple of 3");
        }
    }
    
    StringBuilder result = new StringBuilder();
    int numLines = input.size() / 4;
    int numDigits = input.get(0).length() / 3;
    
    for (int i = 0; i < numLines; i++) {
        if (i > 0) result.append(",");
        for (int j = 0; j < numDigits; j++) {
            String pattern = input.get(i * 4).substring(j * 3, j * 3 + 3) +
                             input.get(i * 4 + 1).substring(j * 3, j * 3 + 3) +
                             input.get(i * 4 + 2).substring(j * 3, j * 3 + 3) +
                             input.get(i * 4 + 3).substring(j * 3, j * 3 + 3);
            result.append(recognize(pattern));
        }
    }
    return result.toString();
}

private String recognize(String pattern) {
    switch (pattern) {
        case " _ | ||_|   ": return "0";
        case "     |  |   ": return "1";
        case " _  _||_    ": return "2";
        case " _  _| _|   ": return "3";
        case "   |_|  |   ": return "4";
        case " _ |_  _|   ": return "5";
        case " _ |_ |_|   ": return "6";
        case " _   |  |   ": return "7";
        case " _ |_||_|   ": return "8";
        case " _ |_| _|   ": return "9";
        default: return "?";
    }
}
```

