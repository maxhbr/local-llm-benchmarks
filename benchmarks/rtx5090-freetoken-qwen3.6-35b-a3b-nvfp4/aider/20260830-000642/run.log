export class Board {
  constructor(board) {
    this.grid = board.map(row => row.replace(/\s/g, '').split(''));
  }

  winner() {
    const rows = this.grid.length;
    if (rows === 0) return '';
    const cols = this.grid[0].length;
    if (cols === 0) return '';

    if (this.checkWin('O', (r, c) => r === rows - 1)) return 'O';
    if (this.checkWin('X', (r, c) => c === cols - 1)) return 'X';
    return '';
  }

  checkWin(player, isTarget) {
    const rows = this.grid.length;
    const cols = this.grid[0].length;
    const queue = [];
    const visited = new Set();

    if (player === 'O') {
      for (let c = 0; c < cols; c++) {
        if (this.grid[0][c] === 'O') {
          queue.push([0, c]);
          visited.add(`0,${c}`);
        }
      }
    } else {
      for (let r = 0; r < rows; r++) {
        if (this.grid[r][0] === 'X') {
          queue.push([r, 0]);
          visited.add(`${r},0`);
        }
      }
    }

    const directions = [[-1, 0], [-1, 1], [0, -1], [0, 1], [1, -1], [1, 0]];
    let head = 0;

    while (head < queue.length) {
      const [r, c] = queue[head++];
      if (isTarget(r, c)) return true;

      for (const [dr, dc] of directions) {
        const nr = r + dr;
        const nc = c + dc;
        if (nr >= 0 && nr < rows && nc >= 0 && nc < cols) {
          const key = `${nr},${nc}`;
          if (!visited.has(key) && this.grid[nr][nc] === player) {
            visited.add(key);
            queue.push([nr, nc]);
          }
        }
      }
    }
    return false;
  }
}
