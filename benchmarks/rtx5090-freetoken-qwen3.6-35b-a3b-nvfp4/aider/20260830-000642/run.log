        if self.throws_in_frame == 0:
            return False
        if self.throws_in_frame == 1:
            return self.rolls[-1] == 10 or self.rolls[self.frame_start_index] + self.rolls[-1] == 10
        return True

    def score(self):
        if not self.is_game_over():
            raise ValueError("score cannot be taken until the end of the game")
            
        score = 0
