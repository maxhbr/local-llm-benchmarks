```javascript
export const tournamentTally = (input) => {
  if (!input || input.trim() === '') {
    return 'Team                           | MP |  W |  D |  L |  P';
  }

  const teams = {};

  const lines = input.split('\n');
  for (const line of lines) {
    const trimmedLine = line.trim();
    if (!trimmedLine) continue;

    const parts = trimmedLine.split(';');
    if (parts.length !== 3) continue;

    const [team1, team2, result] = parts;

    if (!teams[team1]) teams[team1] = { mp: 0, w: 0, d: 0, l: 0, p: 0 };
    if (!teams[team2]) teams[team2] = { mp: 0, w: 0, d: 0, l: 0, p: 0 };

    teams[team1].mp++;
    teams[team2].mp++;

    if (result === 'win') {
      teams[team1].w++;
      teams[team1].p += 3;
      teams[team2].l++;
    } else if (result === 'loss') {
      teams[team1].l++;
      teams[team2].w++;
      teams[team2].p += 3;
    } else if (result === 'draw') {
      teams[team1].d++;
      teams[team1].p += 1;
      teams[team2].d++;
      teams[team2].p += 1;
    }
  }

  const header = 'Team                           | MP |  W |  D |  L |  P';
  const rows = Object.entries(teams).map(([name, stats]) => {
    return `${name.padEnd(31)}| ${stats.mp.toString().padStart(2)} | ${stats.w.toString().padStart(2)} | 
${stats.d.toString().padStart(2)} | ${stats.l.toString().padStart(2)} | ${stats.p.toString().padStart(2)}`;
  });

  rows.sort((a, b) => {
    // Extract points and name from the formatted string? 
    // Better to sort the entries before formatting.
    return 0;
  });
  
  // Let's sort the entries array directly
  const sortedEntries = Object.entries(teams).sort((a, b) => {
    if (b[1].p !== a[1].p) {
      return b[1].p - a[1].p;
    }
    return a[0].localeCompare(b[0]);
  });

  const formattedRows = sortedEntries.map(([name, stats]) => {
    return `${name.padEnd(31)}| ${stats.mp.toString().padStart(2)} | ${stats.w.toString().padStart(2)} | 
${stats.d.toString().padStart(2)} | ${stats.l.toString().padStart(2)} | ${stats.p.toString().padStart(2)}`;
  });

  return [header, ...formattedRows].join('\n');
};
```

