```
//
// This is only a SKELETON file for the 'Bottle Song' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

const numberWords = [
  'no', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten'
];

const getVerse = (n) => {
  const currentWord = numberWords[n];
  const nextWord = numberWords[n - 1];
  const currentBottle = n === 1 ? 'bottle' : 'bottles';
  const nextBottle = (n - 1) === 1 ? 'bottle' : 'bottles';
  
  const line1 = `${currentWord.charAt(0).toUpperCase() + currentWord.slice(1)} green ${currentBottle} hanging on the wall,`;
  const line3 = 'And if one green bottle should accidentally fall,';
  const line4 = `There'll be ${nextWord} green ${nextBottle} hanging on the wall.`;
  
  return `${line1}\n${line1}\n${line3}\n${line4}`;
};

export const recite = (initialBottlesCount, takeDownCount) => {
  const verses = [];
  for (let i = 0; i < takeDownCount; i++) {
    verses.push(getVerse(initialBottlesCount - i));
  }
  return verses.join('\n\n');
};
```
