export const tournamentTally = (input) => {
  if (!input || input.trim() === '') {
    return 'Team                           | MP |  W |  D |  L |  P';
  }

  const teams = {};

  const lines = input.split('\n');
  for (const line of lines) {
    const trimmedLine = line.trim();
    if (!trimmedLine) continue;

    const parts = trimmedLine.split(';');
    if (parts.length !== 3) continue;

    const [team1, team2, result] = parts;

    if (!teams[team1]) teams[team1] = { mp: 0, w: 0, d: 0, l: 0, p: 0 };
    if (!teams[team2]) teams[team2] = { mp: 0, w: 0, d: 0, l: 0, p: 0 };

    teams[team1].mp++;
    teams[team2].mp++;

    if (result === 'win') {
      teams[team1].w++;
      teams[team1].p += 3;
      teams[team2].l++;
    } else if (result === 'loss') {
      teams[team1].l++;
      teams[team2].w++;
      teams[team2].p += 3;
    } else if (result === 'draw') {
      teams[team1].d++;
      teams[team1].p += 1;
      teams[team2].d++;
      teams[team2].p += 1;
    }
