import java.util.*;

class ForthEvaluator {
    List<Integer> evaluateProgram(List<String> input) {
        Deque<Integer> stack = new ArrayDeque<>();
        Map<String, List<String>> definitions = new HashMap<>();
        
        for (String line : input) {
            String[] tokens = line.trim().split("\\s+");
            if (tokens.length == 0 || (tokens.length == 1 && tokens[0].isEmpty())) continue;
            
            if (tokens[0].equals(":")) {
                parseDefinition(tokens, definitions);
            } else {
                execute(tokens, stack, definitions);
            }
        }
        return new ArrayList<>(stack);
    }
    
    private void parseDefinition(String[] tokens, Map<String, List<String>> definitions) {
        if (tokens.length < 4) {
            throw new IllegalArgumentException("Invalid definition");
        }
        String name = tokens[1].toLowerCase();
        if (isNumber(name)) {
            throw new IllegalArgumentException("Cannot redefine numbers");
        }
        List<String> body = new ArrayList<>();
        for (int i = 2; i < tokens.length - 1; i++) {
            body.add(tokens[i].toLowerCase());
        }
        definitions.put(name, body);
    }
    
    private void execute(String[] tokens, Deque<Integer> stack, Map<String, List<String>> definitions) {
        Deque<String> program = new ArrayDeque<>(Arrays.asList(tokens));
        while (!program.isEmpty()) {
            String token = program.pollFirst();
            String lower = token.toLowerCase();
            
            if (isNumber(lower)) {
                stack.push(Integer.parseInt(lower));
            } else if (isBuiltIn(lower)) {
                executeBuiltIn(lower, stack);
            } else if (definitions.containsKey(lower)) {
                List<String> def = definitions.get(lower);
                for (int i = def.size() - 1; i >= 0; i--) {
                    program.addFirst(def.get(i));
                }
            } else {
                throw new IllegalArgumentException("Unknown word: " + token);
            }
        }
    }
    
    private boolean isNumber(String s) {
        try {
            Integer.parseInt(s);
            return true;
        } catch (NumberFormatException e) {
            return false;
        }
    }
    
    private boolean isBuiltIn(String s) {
        return s.equals("+") || s.equals("-") || s.equals("*") || s.equals("/") ||
               s.equals("dup") || s.equals("drop") || s.equals("swap") || s.equals("over");
    }
    
    private void executeBuiltIn(String op, Deque<Integer> stack) {
        if (stack.size() < 2) {
            throw new IllegalArgumentException("Stack underflow");
        }
        switch (op) {
            case "+":
                stack.push(stack.pop() + stack.pop());
                break;
            case "-":
                int sub2 = stack.pop();
                int sub1 = stack.pop();
                stack.push(sub1 - sub2);
                break;
            case "*":
                stack.push(stack.pop() * stack.pop());
                break;
            case "/":
                int div2 = stack.pop();
                int div1 = stack.pop();
                if (div2 == 0) throw new IllegalArgumentException("Division by zero");
                stack.push(div1 / div2);
                break;
            case "dup":
                stack.push(stack.peek());
                break;
            case "drop":
                stack.pop();
                break;
            case "swap":
                int s2 = stack.pop();
                int s1 = stack.pop();
                stack.push(s2);
                stack.push(s1);
                break;
            case "over":
                int o2 = stack.pop();
                int o1 = stack.peek();
                stack.push(o2);
                stack.push(o1);
                break;
        }
    }
}
