class Scale:
    SHARPS = ["A", "A#", "B", "C", "C#", "D", "D#", "E", "F", "F#", "G", "G#"]
    FLATS = ["A", "Bb", "B", "C", "Db", "D", "Eb", "E", "F", "Gb", "G", "Ab"]

    def __init__(self, tonic):
        use_flats = 'b' in tonic.lower()
        base_scale = self.FLATS if use_flats else self.SHARPS
        tonic_idx = [note.lower() for note in base_scale].index(tonic.lower())
        self.chromatic = base_scale[tonic_idx:] + base_scale[:tonic_idx]

    def chromatic(self):
        return self.chromatic

    def interval(self, intervals):
        result = [self.chromatic[0]]
        idx = 0
        for interval in intervals:
            if interval == 'm':
                idx = (idx + 1) % 12
            elif interval == 'M':
                idx = (idx + 2) % 12
            elif interval == 'A':
                idx = (idx + 3) % 12
            result.append(self.chromatic[idx])
        return result
```

