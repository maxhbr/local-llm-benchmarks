book_store.py
```python
def total(basket):
    if not basket:
        return 0
        
    # Prices in cents to avoid floating point precision issues
    # 1 book: 8.00, 2 books: 15.20, 3 books: 21.60, 4 books: 25.60, 5 books: 30.00
    prices_cents = [0, 800, 1520, 2160, 2560, 3000]
    
    counts = {}
    for book in basket:
        counts[book] = counts.get(book, 0) + 1
        
    groups = []
    while counts:
        distinct_count = len(counts)
        groups.append(distinct_count)
        
        # Decrement count for each distinct book in the current group
        for book in list(counts.keys()):
            counts[book] -= 1
            if counts[book] == 0:
                del counts[book]
                
    # Optimization: Two groups of 4 books ($25.60 * 2 = $51.20) are cheaper than
    # one group of 5 and one group of 3 ($30.00 + $21.60 = $51.60).
    while 5 in groups and 3 in groups:
        groups.remove(5)
        groups.remove(3)
        groups.append(4)
        groups.append(4)
        
    return sum(prices_cents[g] for g in groups)
```
