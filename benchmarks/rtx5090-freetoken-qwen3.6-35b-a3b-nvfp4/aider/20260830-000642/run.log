```java
import java.util.List;
import java.util.ArrayList;
import java.util.Map;
import java.util.HashMap;

class BookStore {

    double calculateBasketCost(List<Integer> books) {
        if (books == null || books.isEmpty()) {
            return 0.0;
        }

        int[] counts = new int[6]; // 1-based indexing for books 1-5
        for (int book : books) {
            counts[book]++;
        }

        List<Integer> groups = new ArrayList<>();
        while (true) {
            int distinct = 0;
            for (int i = 1; i <= 5; i++) {
                if (counts[i] > 0) {
                    distinct++;
                }
            }
            if (distinct == 0) break;
            
            groups.add(distinct);
            for (int i = 1; i <= 5; i++) {
                if (counts[i] > 0) {
                    counts[i]--;
                }
            }
        }

        int num5 = 0;
        int num3 = 0;
        for (int g : groups) {
            if (g == 5) num5++;
            if (g == 3) num3++;
        }

        int swaps = Math.min(num5, num3);
        
        double totalCost = 0.0;
        for (int g : groups) {
            totalCost += getPrice(g);
        }
        
        // Each swap of (5, 3) to (4, 4) saves $0.40
        totalCost -= swaps * 0.4;
        
        return totalCost;
    }

    private double getPrice(int numBooks) {
        double basePrice = numBooks * 8.0;
        switch (numBooks) {
            case 1: return basePrice;
            case 2: return basePrice * 0.95;
            case 3: return basePrice * 0.90;
            case 4: return basePrice * 0.80;
            case 5: return basePrice * 0.75;
            default: return basePrice;
        }
    }
}
```

