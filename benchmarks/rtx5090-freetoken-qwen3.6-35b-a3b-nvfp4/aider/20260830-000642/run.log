        std::lock_guard<std::mutex> lock(mtx_);
        if (!is_open_) throw std::logic_error("Account closed");
        if (amount <= 0) throw std::logic_error("Invalid amount");
        if (balance_ < amount) throw std::logic_error("Insufficient funds");
        balance_ -= amount;
    }

    long long balance() const {
        std::lock_guard<std::mutex> lock(mtx_);
        if (!is_open_) throw std::logic_error("Account closed");
        return balance_;
    }

private:
    mutable std::mutex mtx_;
    long long balance_ = 0;
    bool is_open_ = false;
};

}  // namespace Bankaccount
