```java
class Card {
    int rank;
    char suit;
    Card(String s) {
        String rankStr = s.substring(0, s.length() - 1);
        this.suit = s.charAt(s.length() - 1);
        switch (rankStr) {
            case "A": rank = 14; break;
            case "K": rank = 13; break;
            case "Q": rank = 12; break;
            case "J": rank = 11; break;
            case "10": rank = 10; break;
            default: rank = Integer.parseInt(rankStr); break;
        }
    }
}
```

