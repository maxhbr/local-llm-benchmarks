import java.util.List;
import java.util.ArrayList;
import java.util.Arrays;
import java.util.Collections;
import java.util.HashMap;
import java.util.Map;

class Poker {
    private final List<Hand> hands;

    Poker(List<String> hands) {
        this.hands = new ArrayList<>();
        for (String h : hands) {
            this.hands.add(new Hand(h));
        }
    }

    List<String> getBestHands() {
        if (hands.isEmpty()) {
            return Collections.emptyList();
        }

        Hand best = hands.get(0);
        for (int i = 1; i < hands.size(); i++) {
            if (hands.get(i).compareTo(best) > 0) {
                best = hands.get(i);
            }
        }

        List<String> result = new ArrayList<>();
        for (Hand h : hands) {
            if (h.compareTo(best) == 0) {
                result.add(h.original);
            }
        }
        return result;
    }

    private static class Hand implements Comparable<Hand> {
        String original;
        int[] score;

        Hand(String original) {
            this.original = original;
            String[] parts = original.split(" ");
            int[] ranks = new int[5];
            char[] suits = new char[5];

            for (int i = 0; i < 5; i++) {
                String card = parts[i];
                suits[i] = card.charAt(card.length() - 1);
                String rankStr = card.substring(0, card.length() - 1);
                switch (rankStr) {
                    case "A": ranks[i] = 14; break;
                    case "K": ranks[i] = 13; break;
                    case "Q": ranks[i] = 12; break;
                    case "J": ranks[i] = 11; break;
                    case "10": ranks[i] = 10; break;
                    default: ranks[i] = Integer.parseInt(rankStr); break;
                }
            }

            Arrays.sort(ranks);
            for (int i = 0; i < 2; i++) {
                int temp = ranks[i];
                ranks[i] = ranks[4 - i];
                ranks[4 - i] = temp;
            }

            boolean isFlush = true;
            for (int i = 1; i < 5; i++) {
                if (suits[i] != suits[0]) {
                    isFlush = false;
                    break;
                }
            }

            boolean isStraight = true;
            for (int i = 0; i < 4; i++) {
                if (ranks[i] - ranks[i + 1] != 1) {
                    if (i == 0 && ranks[0] == 14 && ranks[1] == 5 && ranks[2] == 4 && ranks[3] == 3 && ranks[4] 
== 2) {
                        ranks = new int[]{5, 4, 3, 2, 1};
                    } else {
                        isStraight = false;
                    }
                    break;
                }
            }

            Map<Integer, Integer> counts = new HashMap<>();
            for (int r : ranks) counts.put(r, counts.getOrDefault(r, 0) + 1);

            java.util.List<Map.Entry<Integer, Integer>> entryList = new java.util.ArrayList<>(counts.entrySet());
            entryList.sort((a, b) -> {
                int cmp = b.getValue().compareTo(a.getValue());
                if (cmp != 0) return cmp;
                return b.getKey().compareTo(a.getKey());
            });

            int[] countRanks = new int[5];
            for (int i = 0; i < entryList.size(); i++) {
                countRanks[i] = entryList.get(i).getKey();
            }

            int[] score = new int[6];
            int type;
            if (isFlush && isStraight) type = 9;
            else if (entryList.get(0).getValue() == 4) type = 8;
            else if (entryList.get(0).getValue() == 3 && entryList.get(1).getValue() == 2) type = 7;
            else if (isFlush) type = 6;
            else if (isStraight) type = 5;
            else if (entryList.get(0).getValue() == 3) type = 4;
            else if (entryList.get(0).getValue() == 2 && entryList.get(1).getValue() == 2) type = 3;
            else if (entryList.get(0).getValue() == 2) type = 2;
            else type = 1;

            score[0] = type;

            if (type == 6 || type == 5) {
                for (int i = 0; i < 5; i++) score[i + 1] = ranks[i];
            } else {
                for (int i = 0; i < 5; i++) score[i + 1] = countRanks[i];
            }

            this.score = score;
        }

        @Override
        public int compareTo(Hand other) {
            for (int i = 0; i < 6; i++) {
                if (this.score[i] != other.score[i]) {
                    return Integer.compare(this.score[i], other.score[i]);
                }
            }
            return 0;
        }
    }
}
