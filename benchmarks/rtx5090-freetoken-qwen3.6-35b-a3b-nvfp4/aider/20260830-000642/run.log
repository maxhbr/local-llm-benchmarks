class WordSearch {
  constructor(puzzle) {
    this.puzzle = puzzle;
    this.rows = puzzle.length;
    this.cols = puzzle[0] ? puzzle[0].length : 0;
  }

  find(words) {
    const results = {};
    for (const word of words) {
      results[word] = this.findWord(word);
    }
    return results;
  }

  findWord(word) {
    for (let r = 0; r < this.rows; r++) {
      for (let c = 0; c < this.cols; c++) {
        if (this.puzzle[r][c] === word[0]) {
          for (const [dr, dc] of DIRECTIONS) {
            const result = this.checkDirection(word, r, c, dr, dc);
            if (result) return result;
          }
        }
      }
    }
    return undefined;
  }

  checkDirection(word, startRow, startCol, dr, dc) {
    let r = startRow;
    let c = startCol;
    for (let i = 0; i < word.length; i++) {
      if (r < 0 || r >= this.rows || c < 0 || c >= this.cols || this.puzzle[r][c] !== word[i]) {
        return null;
      }
      r += dr;
      c += dc;
    }
    // If we get here, the word was found.
    // The last character was at (r - dr, c - dc)
    const endRow = r - dr;
    const endCol = c - dc;
    return {
      start: { column: startCol + 1, row: startRow + 1 },
      end: { column: endCol + 1, row: endRow + 1 }
    };
  }
}
