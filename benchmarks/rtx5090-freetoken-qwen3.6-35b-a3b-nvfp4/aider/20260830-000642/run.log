class BowlingGame {
    private int[] rolls = new int[21];
    private int rollIndex = 0;
    private int pinsRemaining = 10;
    private boolean gameOver = false;

    void roll(int pins) {
        if (pins < 0 || pins > 10) {
            throw new IllegalArgumentException("Invalid number of pins");
        }
        if (gameOver) {
            throw new IllegalStateException("Game is already over");
        }
        if (pins > pinsRemaining) {
            throw new IllegalArgumentException("Too many pins");
        }

        rolls[rollIndex++] = pins;
        pinsRemaining -= pins;

        if (pins == 10) {
            pinsRemaining = 10;
        } else if (pinsRemaining == 0) {
            pinsRemaining = 10;
        } else {
            if (rollIndex == 19) {
                gameOver = true;
            }
        }

        if (rollIndex >= 18 && !gameOver) {
            if (rolls[18] == 10) {
                if (rollIndex == 20) {
                    gameOver = true;
                }
            } else {
                if (rollIndex == 19 && (rolls[18] + rolls[19] < 10)) {
                    gameOver = true;
                } else if (rollIndex == 20) {
                    gameOver = true;
                }
            }
        }
    }

    int score() {
        if (!gameOver) {
            throw new IllegalStateException("Score cannot be taken until the end of the game");
        }
        int score = 0;
        int rollIdx = 0;
        for (int f = 0; f < 10; f++) {
            if (rolls[rollIdx] == 10) {
                score += 10 + rolls[rollIdx + 1] + rolls[rollIdx + 2];
                rollIdx++;
            } else if (rolls[rollIdx] + rolls[rollIdx + 1] == 10) {
                score += 10 + rolls[rollIdx + 2];
                rollIdx += 2;
            } else {
                score += rolls[rollIdx] + rolls[rollIdx + 1];
                rollIdx += 2;
            }
        }
        return score;
    }
}
