```python
class BowlingGame:
    def __init__(self):
        self.rolls = []
        self.frame = 1
        self.throws_in_frame = 0
        self.frame_start_index = 0

    def roll(self, pins):
        if pins < 0 or pins > 10:
            raise ValueError("invalid pins")
            
        if self.is_game_over():
            raise ValueError("cannot roll after game is over")
            
        self.rolls.append(pins)
        
        if self.frame < 10:
            if self.throws_in_frame == 1:
                if self.rolls[-2] + pins > 10:
                    raise ValueError("pins cannot exceed 10 in a frame")
                self.frame += 1
                self.throws_in_frame = 0
                self.frame_start_index = len(self.rolls)
            else:
                self.throws_in_frame += 1
        else: # 10th frame
            if self.throws_in_frame == 1:
                first_roll = self.rolls[self.frame_start_index]
                if first_roll != 10 and first_roll + pins > 10:
                    raise ValueError("pins cannot exceed 10 in a frame")
                self.throws_in_frame = 2
            elif self.throws_in_frame == 2:
                first_bonus = self.rolls[self.frame_start_index]
                if first_bonus != 10 and first_bonus + pins > 10:
                    raise ValueError("pins cannot exceed 10 in a frame")
                self.throws_in_frame = 3

    def is_game_over(self):
        if self.frame < 10:
            return False
        
        start = self.frame_start_index
        if self.throws_in_frame == 3:
            return True
        if self.throws_in_frame == 2:
            first = self.rolls[start]
            second = self.rolls[start+1]
            if first != 10 and first + second < 10:
                return True
            return False
        return False

    def score(self):
        if not self.is_game_over():
            raise ValueError("score cannot be taken until the end of the game")
            
        score = 0
        roll_idx = 0
        for _ in range(10):
            if self.rolls[roll_idx] == 10:  # Strike
                score += 10 + self.rolls[roll_idx+1] + self.rolls[roll_idx+2]
                roll_idx += 1
            elif self.rolls[roll_idx] + self.rolls[roll_idx+1] == 10:  # Spare
                score += 10 + self.rolls[roll_idx+2]
                roll_idx += 2
            else:  # Open frame
                score += self.rolls[roll_idx] + self.rolls[roll_idx+1]
                roll_idx += 2
        return score
```

