```rust
use std::collections::HashMap;

pub fn lowest_price(books: &[u32]) -> u32 {
    let mut counts = [0u32; 5];
    for &b in books {
        if b >= 1 && b <= 5 {
            counts[b as usize - 1] += 1;
        }
    }
    let mut memo = HashMap::new();
    solve(&counts, &mut memo)
}

fn solve(counts: &[u32; 5], memo: &mut HashMap<[u32; 5], u32>) -> u32 {
    if counts.iter().all(|&c| c == 0) {
        return 0;
    }
    if let Some(&price) = memo.get(counts) {
        return price;
    }

    let mut min_price = u32::MAX;

    // Try all possible subsets of distinct books
    // There are 2^5 - 1 = 31 non-empty subsets
    for mask in 1..32 {
        let mut next_counts = *counts;
        let mut set_size = 0;
        let mut valid = true;
        for i in 0..5 {
            if mask & (1 << i) != 0 {
                if next_counts[i] > 0 {
                    next_counts[i] -= 1;
                    set_size += 1;
                } else {
                    valid = false;
                    break;
                }
            }
        }
        if valid {
            let price = match set_size {
                1 => 800,
                2 => 1520,
                3 => 2160,
                4 => 2560,
                5 => 3000,
                _ => unreachable!(),
            };
            let total = price + solve(&next_counts, memo);
            if total < min_price {
                min_price = total;
            }
        }
    }

    memo.insert(*counts, min_price);
    min_price
}
```
