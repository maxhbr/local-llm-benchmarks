        this.stack.push(this.stack.pop() * this.stack.pop());
        break;
      case '/':
        this.checkStack(2);
        const b2 = this.stack.pop();
        if (b2 === 0) throw new Error('Division by zero');
        const a2 = this.stack.pop();
        this.stack.push(Math.trunc(a2 / b2));
        break;
      case 'dup':
        this.checkStack(1);
        this.stack.push(this.stack[this.stack.length - 1]);
        break;
      case 'drop':
        this.checkStack(1);
        this.stack.pop();
        break;
      case 'swap':
        this.checkStack(2);
        const a3 = this.stack.pop();
        const b3 = this.stack.pop();
        this.stack.push(a3);
        this.stack.push(b3);
        break;
      case 'over':
        this.checkStack(2);
        this.stack.push(this.stack[this.stack.length - 2]);
        break;
    }
  }

  checkStack(n) {
    if (this.stack.length < n) throw new Error('Stack empty');
  }

  get stack() {
    return this.stack;
  }
}
