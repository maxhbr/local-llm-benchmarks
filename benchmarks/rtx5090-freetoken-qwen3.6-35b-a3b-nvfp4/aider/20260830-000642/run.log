package wordy

import (
        "strconv"
        "strings"
)

func Answer(question string) (int, bool) {
        if !strings.HasPrefix(question, "What is ") || !strings.HasSuffix(question, "?") {
                return 0, false
        }
        
        // Remove "What is " and "?"
        inner := question[len("What is "):len(question)-1]
        if inner == "" {
                return 0, false
        }
        
        tokens := strings.Split(inner, " ")
        if len(tokens) == 0 {
                return 0, false
        }
        
        // Parse first number
        num, err := strconv.Atoi(tokens[0])
        if err != nil {
                return 0, false
        }
        
        result := num
        i := 1
        for i < len(tokens) {
                if i+1 >= len(tokens) {
                        // Missing operator or number
                        return 0, false
                }
                
                op := tokens[i]
                numStr := tokens[i+1]
                i += 2
                
                nextNum, err := strconv.Atoi(numStr)
                if err != nil {
                        return 0, false
                }
                
                switch op {
                case "plus":
                        result += nextNum
                case "minus":
                        result -= nextNum
                case "multiplied":
                        result *= nextNum
                case "divided":
                        result /= nextNum
                default:
                        return 0, false
                }
        }
        
        return result, true
}
```

