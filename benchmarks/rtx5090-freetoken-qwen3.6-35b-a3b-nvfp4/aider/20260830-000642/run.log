def can_chain(dominoes):
    if not dominoes:
        return []
    
    # We'll use a recursive function that tries to extend the chain
    # chain: list of dominoes used so far
    # remaining: list of dominoes not yet used
    
    def solve(chain, remaining):
        if not remaining:
            # Check if the chain forms a valid loop
            if chain[0][0] == chain[-1][1]:
                return chain
            return None
        
        last_val = chain[-1][1]
        
        for i, domino in enumerate(remaining):
            a, b = domino
            # Try orientation (a, b)
            if a == last_val:
                res = solve(chain + [(a, b)], remaining[:i] + remaining[i+1:])
                if res:
                    return res
            # Try orientation (b, a)
            if b == last_val:
                # If a == b, we already tried it, avoid duplicate work
                if a != b:
                    res = solve(chain + [(b, a)], remaining[:i] + remaining[i+1:])
                    if res:
                        return res
        return None

    # Start with the first domino in both orientations
    d0 = dominoes[0]
    rem = dominoes[1:]
    
    # Try starting with d0 as (a, b)
    res = solve([d0], rem)
    if res:
        return res
        
    # Try starting with d0 as (b, a) if different
    if d0[0] != d0[1]:
        res = solve([(d0[1], d0[0])], rem)
        if res:
            return res
            
    return None
```

