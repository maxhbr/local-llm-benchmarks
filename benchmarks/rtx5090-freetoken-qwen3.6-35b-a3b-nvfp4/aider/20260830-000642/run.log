export class Forth {
  constructor() {
    this.stack = [];
    this.definitions = {};
  }

  evaluate(input) {
    const trimmed = input.trim();
    if (!trimmed) return;
    
    const tokens = trimmed.split(/\s+/);
    let i = 0;
    while (i < tokens.length) {
      const token = tokens[i].toLowerCase();
      if (token === ':') {
        i++;
        if (i >= tokens.length) throw new Error('Invalid definition');
        const wordName = tokens[i].toLowerCase();
        if (/^-?\d+$/.test(wordName)) throw new Error('Invalid definition');
        i++;
        const defTokens = [];
        while (i < tokens.length && tokens[i] !== ';') {
          defTokens.push(tokens[i].toLowerCase());
          i++;
        }
        if (i >= tokens.length) throw new Error('Invalid definition');
        this.definitions[wordName] = defTokens;
        i++; // skip ;
      } else {
        this.executeToken(token);
        i++;
      }
    }
  }

  executeToken(token) {
    if (/^-?\d+$/.test(token)) {
      this.stack.push(parseInt(token, 10));
    } else if (this.definitions[token]) {
      for (const defToken of this.definitions[token]) {
        this.executeToken(defToken);
      }
    } else if (this.isBuiltIn(token)) {
      this.runBuiltIn(token);
    } else {
      throw new Error(`Undefined word '${token}'`);
    }
  }

  isBuiltIn(token) {
    return ['+', '-', '*', '/', 'dup', 'drop', 'swap', 'over'].includes(token);
  }

  runBuiltIn(token) {
    switch (token) {
      case '+':
        this.checkStack(2);
        this.stack.push(this.stack.pop() + this.stack.pop());
        break;
