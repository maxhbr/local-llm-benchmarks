```javascript
export class InputCell {
  constructor(value) {
    this.value = value;
    this.dependents = [];
  }

  setValue(newValue) {
    if (this.value === newValue) return;
    this.value = newValue;
    this._propagate();
  }

  _propagate() {
    const affected = [];
    const queue = [...this.dependents];
    while (queue.length > 0) {
      const cell = queue.shift();
      if (!affected.includes(cell)) {
        affected.push(cell);
        queue.push(...cell.dependents);
      }
    }

    const depths = new Map();
    const getDepth = (cell) => {
      if (depths.has(cell)) return depths.get(cell);
      let max = 0;
      if (cell.inputCells) {
        for (const dep of cell.inputCells) {
          max = Math.max(max, getDepth(dep) + 1);
        }
      }
      depths.set(cell, max);
      return max;
    };

    for (const cell of affected) {
      getDepth(cell);
      cell._initialValue = cell.value;
    }

    affected.sort((a, b) => (depths.get(a) || 0) - (depths.get(b) || 0));

    for (const cell of affected) {
      cell.value = cell.calc();
    }

    for (const cell of affected) {
      if (cell.value !== cell._initialValue) {
        for (const cb of cell.callbacks) {
          cb(cell.value);
        }
      }
    }
  }
}

export class ComputeCell {
  constructor(inputCells, fn) {
    this.inputCells = inputCells;
    this.fn = fn;
    this.value = this.calc();
    this.callbacks = [];
    this.dependents = [];
    for (const cell of inputCells) {
      cell.dependents.push(this);
    }
  }

  calc() {
    return this.fn(this.inputCells);
  }

  addCallback(cb) {
    this.callbacks.push(cb);
  }

  removeCallback(cb) {
    this.callbacks = this.callbacks.filter(c => c !== cb);
  }
}

export class CallbackCell {
  constructor(fn) {
    this.fn = fn;
  }

  get value() {
    return this.fn();
  }
}
```

