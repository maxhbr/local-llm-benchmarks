	Command Command
}

func StartRobot(command chan Command, action chan Action) {
	for cmd := range command {
		action <- Action{Command: cmd}
	}
}

func Room(extent Rect, robot Step2Robot, action chan Action, report chan Step2Robot) {
	for act := range action {
		switch act.Command {
		case 'R':
			robot.Dir = (robot.Dir + 1) % 4
		case 'L':
			robot.Dir = (robot.Dir + 3) % 4
		case 'A':
			switch robot.Dir {
			case N:
				if robot.Y < extent.Max.Y {
					robot.Y++
				}
			case E:
				if robot.X < extent.Max.X {
					robot.X++
				}
			case S:
				if robot.Y > extent.Min.Y {
					robot.Y--
				}
			case W:
				if robot.X > extent.Min.X {
					robot.X--
				}
			}
		}
	}
	report <- robot
}

// Step 3
type Action3 struct {
	Name    string
	Command Command
}

func StartRobot3(name, script string, action chan Action3, log chan string) {
	if name == "" {
		log <- "robot without a name"
	}
	for _, cmd := range script {
		if cmd != 'A' && cmd != 'L' && cmd != 'R' {
			log <- "undefined command"
			continue
		}
		action <- Action3{Name: name, Command: Command(cmd)}
	}
}

func Room3(extent Rect, robots []Step3Robot, action chan Action3, rep chan []Step3Robot, log chan string) {
	// Validate initial placement
	for i, r := range robots {
		if r.Name == "" {
			log <- "robot without a name"
		}
		for j := i + 1; j < len(robots); j++ {
			if robots[j].Name == r.Name {
				log <- "duplicate robot name"
			}
			if robots[i].X == robots[j].X && robots[i].Y == robots[j].Y {
				log <- "robots at the same place"
			}
		}
		if r.X < extent.Min.X || r.X > extent.Max.X || r.Y < extent.Min.Y || r.Y > extent.Max.Y {
			log <- "robot placed outside of the room"
		}
	}

	for act := range action {
		idx := -1
		for i, r := range robots {
			if r.Name == act.Name {
				idx = i
				break
			}
		}
		if idx == -1 {
			log <- "unknown robot"
			continue
		}

		switch act.Command {
		case 'R':
			robots[idx].Dir = (robots[idx].Dir + 1) % 4
		case 'L':
			robots[idx].Dir = (robots[idx].Dir + 3) % 4
		case 'A':
			nextX, nextY := robots[idx].X, robots[idx].Y
			switch robots[idx].Dir {
			case N:
				nextY++
			case E:
				nextX++
			case S:
				nextY--
			case W:
				nextX--
			}
			if nextX < extent.Min.X || nextX > extent.Max.X || nextY < extent.Min.Y || nextY > extent.Max.Y {
				log <- "robot hit a wall"
			} else {
				collision := false
				for i, r := range robots {
					if i != idx && r.X == nextX && r.Y == nextY {
						collision = true
						break
					}
				}
				if collision {
					log <- "robot hit another robot"
				} else {
					robots[idx].X, robots[idx].Y = nextX, nextY
				}
			}
		default:
			log <- "undefined command"
		}
	}
	rep <- robots
}
```
