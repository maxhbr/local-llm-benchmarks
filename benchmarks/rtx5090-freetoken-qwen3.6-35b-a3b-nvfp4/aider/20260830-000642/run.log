```python
def transpose(text):
    if not text:
        return ""
    rows = text.split('\n')
    max_len = max(len(r) for r in rows)
    result = []
    for i in range(max_len):
        # Find the last row that has a character at index i
        last_j = -1
        for j in range(len(rows) - 1, -1, -1):
            if i < len(rows[j]):
                last_j = j
                break
        
        new_row = []
        for j in range(last_j + 1):
            if i < len(rows[j]):
                new_row.append(rows[j][i])
            else:
                new_row.append(' ')
        result.append(''.join(new_row))
    return '\n'.join(result)
```

