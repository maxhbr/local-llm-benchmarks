  findPath(starts, targetRow, targetCol, player) {
    const queue = starts;
    const visited = new Set(starts.map(([r, c]) => `${r},${c}`));
    const directions = [[-1, 0], [-1, 1], [0, -1], [0, 1], [1, -1], [1, 0]];
    const rows = this.grid.length;
    const cols = this.grid[0].length;

    while (queue.length > 0) {
      const [r, c] = queue.shift();
      
      if (player === 'O' && r === rows - 1) return true;
      if (player === 'X' && c === cols - 1) return true;

      for (const [dr, dc] of directions) {
        const nr = r + dr;
        const nc = c + dc;
        if (nr >= 0 && nr < rows && nc >= 0 && nc < cols) {
          if (!visited.has(`${nr},${nc}`) && this.grid[nr][nc] === player) {
            visited.add(`${nr},${nc}`);
            queue.push([nr, nc]);
          }
        }
      }
    }
    return false;
  }
