            this.users.put(user.name(), user);
        }
    }

    String get(String url) {
        return get(url, null);
    }

    String get(String url, JSONObject payload) {
        if ("/users".equals(url)) {
            if (payload == null) {
                return new JSONArray(users.values()).toString();
            } else {
                JSONArray names = payload.getJSONArray("users");
                List<User> filtered = new ArrayList<>();
                for (int i = 0; i < names.length(); i++) {
                    String name = names.getString(i);
                    if (users.containsKey(name)) {
                        filtered.add(users.get(name));
                    }
                }
                // sorted by name
                filtered.sort(Comparator.comparing(User::name));
                return new JSONArray(filtered).toString();
            }
        }
        return "";
    }

