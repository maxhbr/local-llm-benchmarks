package wordy

import (
        "strconv"
        "strings"
)

func Answer(question string) (int, bool) {
        if !strings.HasPrefix(question, "What is ") || !strings.HasSuffix(question, "?") {
                return 0, false
        }

        inner := question[len("What is "):len(question)-1]
        if inner == "" {
                return 0, false
        }

        // Normalize multi-word operators
        inner = strings.ReplaceAll(inner, "multiplied by", "multiplied")
        inner = strings.ReplaceAll(inner, "divided by", "divided")

        tokens := strings.Split(inner, " ")
        if len(tokens) == 0 {
                return 0, false
        }

        result, err := strconv.Atoi(tokens[0])
        if err != nil {
                return 0, false
        }

        i := 1
        for i < len(tokens) {
                if i+1 >= len(tokens) {
                        return 0, false
                }

                op := tokens[i]
                numStr := tokens[i+1]
                i += 2

                num, err := strconv.Atoi(numStr)
                if err != nil {
                        return 0, false
                }

                switch op {
                case "plus":
                        result += num
                case "minus":
                        result -= num
                case "multiplied":
                        result *= num
                case "divided":
                        result /= num
                default:
                        return 0, false
                }
        }

        return result, true
}
```

