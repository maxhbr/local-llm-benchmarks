                    if doubled > 9 {
                        sum += doubled - 9;
                    } else {
                        sum += doubled;
                    }
                } else {
                    sum += digit;
                }
            } else {
                return false;
            }
        }
        
        count > 1 && sum % 10 == 0
    }
}
