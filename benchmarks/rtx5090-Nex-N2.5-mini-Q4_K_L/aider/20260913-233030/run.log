import java.util.ArrayList;

class BuildTree {
    TreeNode buildTree(ArrayList<Record> records) throws InvalidRecordsException {
        if (records == null || records.isEmpty()) return null;
        int size = records.size();
        Record[] recordsById = new Record[size];
        for (Record record : records) {
            int id = record.getRecordId();
            if (id < 0 || id >= size || recordsById[id] != null) throw...
            recordsById[id] = record;
        }
        TreeNode[] treeNodes = new TreeNode[size];
        for (int id=0; id<size; id++) treeNodes[id] = new TreeNode(id);
        for (int id=0; id<size; id++) {
           Record record = recordsById[id];
           int parentId = record.getParentId();
           if (id == 0) {
              if (parentId != 0) throw...
           } else {
              if (parentId < 0 || parentId >= id) throw...
              treeNodes[parentId].getChildren().add(treeNodes[id]);
           }
        }
        return treeNodes[0];
    }
