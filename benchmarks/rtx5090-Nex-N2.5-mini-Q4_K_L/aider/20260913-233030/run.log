OpticalCharacterReader.java
```
import java.util.List;
import java.util.Map;

class OpticalCharacterReader {

    private static final Map<String, String> DIGITS = Map.of(
        " _ \n| |\n|_| \n   ", "0",
        "   \n  |\n  |\n   ", "1",
        " _ \n _| \n|_  \n   ", "2",
        " _ \n _| \n _| \n   ", "3",
        "   \n|_|\n  |\n   ", "4",
        " _ \n|_ \n|_  \n   ", "5",
        " _ \n|_ \n|_| \n   ", "6",
        " _ \n  |\n  |\n   ", "7",
        " _ \n|_|\n|_|\n   ", "8",
        " _ \n|_|\n _| \n   ", "9"
    );

    String parse(List<String> input) {
        if (input.size() % 4 != 0) {
            throw new IllegalArgumentException("Number of input lines must be a multiple of four");
        }
        if (input.isEmpty()) {
            return "";
        }

        int columnCount = input.get(0).length();
        if (columnCount % 3 != 0) {
            throw new IllegalArgumentException("Number of input columns must be a multiple of three");
        }
        for (String line : input) {
            if (line.length() != columnCount) {
                throw new IllegalArgumentException("All input lines must have the same length");
            }
        }

        StringBuilder result = new StringBuilder();
        int numberOfNumbers = input.size() / 4;

        for (int number = 0; number < numberOfNumbers; number++) {
            if (number > 0) {
                result.append(',');
            }

            int rowOffset = number * 4;
            for (int column = 0; column < columnCount; column += 3) {
                StringBuilder digit = new StringBuilder();
                for (int row = 0; row < 4; row++) {
                    digit.append(input.get(rowOffset + row), column, column + 3);
                }
                result.append(DIGITS.getOrDefault(digit.toString(), "?"));
            }
        }

        return result.toString();
    }
}
```
