import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;
import java.util.Map;
import java.util.HashMap;

class KindergartenGarden {

    private static final List<String> STUDENTS = Arrays.asList(
        "Alice", "Bob", "Charlie", "David", "Eve", "Fred",
        "Ginny", "Harriet", "Ileana", "Joseph", "Kincaid", "Larry"
    );

    private final Map<String, List<Plant>> plantsByStudent = new HashMap<>();

    KindergartenGarden(String garden) {
        String[] rows = garden.split("\\R");
        if (rows.length != 2) {
            throw new IllegalArgumentException("Garden diagram must contain exactly two rows");
        }

        String firstRow = rows[0];
        String secondRow = rows[1];
        if (firstRow.length() != secondRow.length()) {
            throw new IllegalArgumentException("Garden rows must have the same length");
        }

        for (int i = 0; i < STUDENTS.size(); i++) {
            int start = i * 2;
            List<Plant> studentPlants = new ArrayList<>(4);
            studentPlants.add(plantAt(firstRow, start));
            studentPlants.add(plantAt(firstRow, start + 1));
            studentPlants.add(plantAt(secondRow, start));
            studentPlants.add(plantAt(secondRow, start + 1));
            plantsByStudent.put(STUDENTS.get(i), List.copyOf(studentPlants));
        }
    }

    List<Plant> getPlantsOfStudent(String student) {
        List<Plant> plants = plantsByStudent.get(student);
        if (plants == null) {
            throw new IllegalArgumentException("Unknown student: " + student);
        }
        return plants;
    }

    private Plant plantAt(String row, int index) {
        char code = row.charAt(index);
        return switch (code) {
            case 'G' -> Plant.GRASS;
            case 'C' -> Plant.CLOVER;
            case 'R' -> Plant.RADISHES;
            case 'V' -> Plant.VIOLETS;
            default -> throw new IllegalArgumentException("Invalid plant code: " + code);
        };
    }
}
```
