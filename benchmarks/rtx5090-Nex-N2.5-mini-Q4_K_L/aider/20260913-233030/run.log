bottle-song.js
```
//
// This is only a SKELETON file for the 'Bottle Song' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

const numberWords = [
  'no',
  'one',
  'two',
  'three',
  'four',
  'five',
  'six',
  'seven',
  'eight',
  'nine',
  'ten',
];

const bottlePhrase = (count) => {
  const bottleWord = count === 1 ? 'bottle' : 'bottles';
  return `${numberWords[count]} green ${bottleWord}`;
};

const capitalize = (text) =>
  text.charAt(0).toUpperCase() + text.slice(1);

export const recite = (initialBottlesCount, takeDownCount) => {
  const lyrics = [];

  for (let bottlesOnWall = initialBottlesCount; bottlesOnWall > initialBottlesCount - takeDownCount; bottlesOnWall--) {
    const nextBottles = bottlesOnWall - 1;
    const currentBottles = capitalize(bottlePhrase(bottlesOnWall));

    lyrics.push(`${currentBottles} hanging on the wall,`);
    lyrics.push(`${currentBottles} hanging on the wall,`);
    lyrics.push('And if one green bottle should accidentally fall,');
    lyrics.push(`There'll be ${bottlePhrase(nextBottles)} hanging on the wall.`);

    if (bottlesOnWall > initialBottlesCount - takeDownCount + 1) {
      lyrics.push('');
    }
  }

  return lyrics;
};
```
