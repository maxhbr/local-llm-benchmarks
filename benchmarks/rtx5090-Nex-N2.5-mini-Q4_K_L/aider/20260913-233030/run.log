class OpticalCharacterReader {
    private static final Map<String, String> DIGITS = Map.of(...);
    String parse(List<String> input) {
        if (input.size() % 4 != 0) throw new IllegalArgumentException("Number of input lines must be a multiple 
of four");
        List<String> result = new ArrayList<>();
        for (int i=0; i<input.size(); i+=4) {
            StringBuilder number = new StringBuilder();
            int digitCount = input.get(i).length()/4;
            for (int digit=0; digit<digitCount; digit++) {
                StringBuilder digitPattern = new StringBuilder();
                for (int row=0; row<4; row++) {
                    digitPattern.append(input.get(i+row).substring(digit*4, digit*4+4));
                }
                number.append(DIGITS.getOrDefault(digitPattern.toString(), "?"));
            }
            result.add(number.toString());
        }
        return String.join(",", result);
    }
}
