package linkedlist

import "errors"

type List struct {
        head *Element
        tail *Element
}

type Element struct {
        data int
        next *Element
}

var ErrNoElements = errors.New("no elements")
var ErrNotImplemented = errors.New("not implemented")

func New(elements []int) *List {
        l := &List{}
        for _, element := range elements {
                l.Push(element)
        }
        return l
}

func (l *List) Size() int {
        count := 0
        for node := l.head; node != nil; node = node.next {
                count++
        }
        return count
}

func (l *List) Push(element int) {
        node := &Element{data: element}
        if l.tail == nil {
                l.head = node
                l.tail = node
        } else {
                l.tail.next = node
                l.tail = node
        }
}

func (l *List) Pop() (int, error) {
        if l.tail == nil {
                return 0, ErrNoElements
        }
        element := l.tail.data
        l.tail = l.tail.next
        if l.tail == nil {
                l.head = nil
        } else {
                l.tail.next = nil
        }
        return element, nil
}

func (l *List) Array() []int {
        result := make([]int, 0, l.Size())
        for node := l.head; node != nil; node = node.next {
                result = append(result,node.data)
        }
        return result
}

func (l *List) Reverse() *List {
        var previous *Element
        for node := l.head; node != nil; {
                next := node.next
                node.next = previous
                previous = node
                node = next
        }
        l.head = previous
        l.tail = previous
        return l
}

