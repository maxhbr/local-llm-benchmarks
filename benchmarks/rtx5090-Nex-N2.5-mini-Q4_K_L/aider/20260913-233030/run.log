Let's write code carefully:

```
import java.util.ArrayList;

class BuildTree {

    TreeNode buildTree(ArrayList<Record> records) throws InvalidRecordsException {
        if (records.isEmpty()) {
            return null;
        }

        int size = records.size();
        Record[] recordsById = new Record[size];

        for (Record record : records) {
            int recordId = record.getRecordId();

            if (recordId < 0 || recordId >= size || recordsById[recordId] != null) {
                throw new InvalidRecordsException("Invalid Records");
            }

            recordsById[recordId] = record;
        }

        TreeNode[] treeNodes = new TreeNode[size];
        for (int recordId = 0; recordId < size; recordId++) {
            treeNodes[recordId] = new TreeNode(recordId);
        }

        for (int recordId = 0; recordId < size; recordId++) {
            Record record = recordsById[recordId];
            int parentId = record.getParentId();

            if (recordId == 0) {
                if (parentId != 0) {
                    throw new InvalidRecordsException("Invalid Records");
                }
            } else {
                if (parentId < 0 || parentId >= recordId) {
                    throw new InvalidRecordsException("Invalid Records");
                }
                treeNodes[parentId].getChildren().add(treeNodes[recordId]);
            }
        }

        return treeNodes[0];
    }
}
```
