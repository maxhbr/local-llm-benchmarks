#include "allergies.h"

namespace allergies {

const std::unordered_set<std::string> kItems = {
    {"eggs", 1},
    {"peanuts", 2},
    {"shellfish", 4},
    {"strawberries", 8},
    {"tomatoes", 16},
    {"chocolate", 32},
    {"pollen", 64},
    {"cats", 128},
};

allergy_test::allergy_test(unsigned score) : score_(score) {}

bool allergy_test::is_allergic_to(const std::string& item) const {
    for (const auto& entry : kItems) {
        if (entry.first == item && (score_ & entry.second)) {
            return true;
        }
    }
    return false;
}

std::unordered_set<std::string> allergy_test::get_allergies() const {
    std::unordered_set<std::string> result;
    for (const auto& entry : kItems) {
        if (score_ & entry.second) {
            result.emplace(entry.first);
        }
    }
    return result;
}

}  // namespace allergies
