def _evaluate_hand(hand):
    """Return a comparable score tuple for a hand (higher is better)."""
    parsed = [_parse_card(card) for card in hand]
    ranks = sorted((r for r, _ in parsed), reverse=True)
    suits = [s for _, s in parsed]

    counts = Counter(ranks)
    # Most frequent rank first; ties broken by higher rank.
    groups = sorted(counts.items(), key=lambda item: (-item[1], -item[0]))
    group_ranks = [rank for rank, _ in groups]
    group_counts = [count for _, count in groups]

    unique_ranks = sorted(set(ranks), reverse=True)
    straight_high = _straight_high(unique_ranks)
    is_flush = len(set(suits)) == 1

    if straight_high is not None and is_flush:
        return (8, straight_high)          # straight flush / royal flush
    if group_counts[0] == 4:
        return (7, group_ranks[0], group_ranks[1])  # four of a kind
    if group_counts[0] == 3 and group_counts[1] == 2:
        return (6, group_ranks[0], group_ranks[1])  # full house
    if is_flush:
        return (5, *ranks)                # flush
    if straight_high is not None:
        return (4, straight_high)       # straight
    if group_counts[0] == 3:
        return (3, group_ranks[0], *group_ranks[1:])  # three of a kind
    if group_counts[0] == 2 and group_counts[1] == 2:
        return (2, group_ranks[0], group_ranks[1], group_ranks[2])  # two pair
    if group_counts[0] == 2:
        return (1, group_ranks[0], *group_ranks[1:])  # one pair
    return (0, *ranks)                               # high card
