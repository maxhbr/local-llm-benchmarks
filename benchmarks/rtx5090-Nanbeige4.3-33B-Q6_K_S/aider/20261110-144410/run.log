import java.util.List;

class OpticalCharacterReader {

    String parse(List<String> input) {
        if (input == null || input.size() != 4 || input.get(0).length() % 3 != 0) {
            throw new IllegalArgumentException("Invalid input size");
        }

        StringBuilder result = new StringBuilder();
        int width = input.get(0).length() / 3;

        for (int digitIndex = 0; digitIndex < width; digitIndex++) {
            int col = digitIndex * 3;
            char[][] grid = new char[4][3];
            for (int row = 0; row < 4; row++) {
                for (int colOffset = 0; colOffset < 3; colOffset++) {
                    grid[row][colOffset] = input.get(row).charAt(col + colOffset);
                }
            }

            int value = 0;
            for (int row = 0; row < 3; row++) {
                for (int col = 0; col < 3; col++) {
                    char c = grid[row][col];
                    if (c == '|' || c == '_') {
                        value = value * 2 + (c == '|');
                    } else if (c == ' ') {
                        value = value * 2;
                    } else {
                        value = -1;
                    }
                }
            }

            if (value >= 0 && value < 10) {
                result.append((char) ('0' + value));
            } else {
                result.append('?');
            }
        }

        return result.toString();
    }

}
