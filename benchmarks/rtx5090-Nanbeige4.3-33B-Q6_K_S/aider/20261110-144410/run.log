twelve-days.js
```
//
// This is only a SKELETON file for the 'Twelve Days' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

const gifts = [
  'a Partridge in a Pear Tree',
  'two Turtle Doves',
  'three French Hens',
  'four Calling Birds',
  'five Gold Rings',
  'six Geese-a-Laying',
  'seven Swans-a-Swimming',
  'eight Maids-a-Milking',
  'nine Ladies Dancing',
  'ten Lords-a-Leaping',
  'eleven Pipers Piping',
  'twelve Drummers Drumming',
];

export const recite = () => {
  const verses = gifts
    .map((gift, index) => {
      const day = gifts.length - index;
      const items = gifts
        .slice(0, index + 1)
        .reverse()
        .map((item) => item);
      const list = items.join(', ');
      return `On the ${day} day of Christmas my true love gave to me: ${list}.`;
    })
    .join('\n\n');

  return verses;
};
```
