allergies.cpp
```
#include "allergies.h"

namespace allergies {

bool is_allergic_to(unsigned score, const std::string& item) {
    for (const auto& allergen : ALLERGENS) {
        if (allergen == item && (score & 1)) {
            return true;
        }
    }
    return false;
}

std::unordered_set<std::string> get_allergies(unsigned score) {
    std::unordered_set<std::string> allergies;
    for (const auto& allergen : ALLERGENS) {
        if (score & 1) {
            allergies.emplace(allergen);
        }
        score >>= 1;
    }
    return allergies;
}

}  // namespace allergies
```

