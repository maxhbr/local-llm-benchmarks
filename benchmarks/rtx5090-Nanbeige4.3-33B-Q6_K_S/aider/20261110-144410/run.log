I will update `twelve-days.js` so that `recite` accepts one or two day arguments and returns the requested verses in order, with the exact wording and formatting the tests expect.

twelve-days.js
```
//
// This is only a SKELETON file for the 'Twelve Days' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

const gifts = [
  'a Partridge in a Pear Tree',
  'two Turtle Doves',
  'three French Hens',
  'four Calling Birds',
  'five Gold Rings',
  'six Geese-a-Laying',
  'seven Swans-a-Swimming',
  'eight Maids-a-Milking',
  'nine Ladies Dancing',
  'ten Lords-a-Leaping',
  'eleven Pipers Piping',
  'twelve Drummers Drumming',
];

const dayNames = [
  '',
  'first',
  'second',
  'third',
  'fourth',
  'fifth',
  'sixth',
  'seventh',
  'eighth',
  'ninth',
  'tenth',
  'eleventh',
  'twelfth',
];

const verseForDay = (day) => {
  const items = gifts
    .slice(0, day)
    .reverse()
    .map((item, index) => {
      if (index === day - 1) {
        return item;
      }
      return `${item}, and ${gifts[day - 2 - index]}`;
    });

  return `On the ${dayNames[day]} day of Christmas my true love gave to me: ${items.join(', ')}.`;
};

export const recite = (...days) => {
  const verses = days.map(verseForDay);

  return verses.join('\n\n') + '\n';
};
```
