import java.util.List;

class OpticalCharacterReader {

    String parse(List<String> input) {
        if (input == null || input.size() % 4 != 0) {
            throw new IllegalArgumentException("Input must contain a multiple of 4 lines.");
        }

        StringBuilder result = new StringBuilder();

        for (int blockIndex = 0; blockIndex < input.size() / 4; blockIndex++) {
            List<String> block = new ArrayList<>(input.subList(blockIndex * 4, blockIndex * 4 + 4));
            int columns = block.get(0).length();

            if (columns % 3 != 0) {
                throw new IllegalArgumentException("Input must contain a multiple of 3 columns.");
            }

            for (int digitIndex = 0; digitIndex < columns / 3; digitIndex++) {
                int digit = readDigit(block, digitIndex * 3);
                result.append(digit);
            }
        }

        return result.toString();
    }

    private int readDigit(List<String> block, int column) {
        int[] bits = new int[4];

        for (int row = 0; row < 4; row++) {
            String line = block.get(row);
            for (int col = column; col < column + 3; col++) {
                char c = line.charAt(col);
                if (c == '|') {
                    bits[row] |= 1 << (3 - col - column);
                } else if (c == '_') {
                    if (row == 0) {
                        bits[0] |= 1 << (3 - col - column);
                    } else if (row == 1) {
                        bits[1] |= 1 << (3 - col - column);
                    } else if (row == 2) {
                        bits[2] |= 1 << (3 - col - column);
                    }
                }
            }
        }

        int value = (bits[0] << 3) | (bits[1] << 2) | (bits[2] << 1) | bits[3];

        if (value == 0b0000 || value == 0b1111 || value == 0b1110 || value == 0b1101 || value == 0b1011 || value == 0b1010 || value == 0b0111 || value
== 0b0101 || value == 0b0011 || value == 0b0001) {
            return '?';
        }

        return String.valueOf(value).charAt(0);
    }
}
