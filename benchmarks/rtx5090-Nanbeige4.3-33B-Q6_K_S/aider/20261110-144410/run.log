```js
//
// This file implements the 'Connect' exercise for the Hex / Polygon game.
//

const HEX_DIRECTIONS = [
  [-1, 0],
  [-1, 1],
  [0, 1],
  [1, 0],
  [1, -1],
  [0, -1],
];

export class Board {
  constructor(board = '') {
    this.board = board;
    this.rows = board.trim().split('\n').map((line) => line.trim());
    this.height = this.rows.length;
    this.width = Math.max(...this.rows.map((line) => line.length));
    this.cells = this._parseCells();
  }

  _parseCells() {
    const cells = [];

    for (let r = 0; r < this.height; r++) {
      const line = this.rows[r];
      for (let c = 0; c < this.width; c++) {
        const char = line[c] || '.';
        cells.push({
          row: r,
          col: c,
          value: char,
        });
      }
    }

    return cells;
  }

  _cellAt(row, col) {
    if (row < 0 || col < 0 || row >= this.height || col >= this.width) {
      return null;
    }

    return this.cells[row * this.width + col];
  }

  _adjacentCells(cell) {
    const neighbors = [];

    for (const [dr, dc] of HEX_DIRECTIONS) {
      const neighbor = this._cellAt(cell.row + dr, cell.col + dc);
      if (neighbor) {
        neighbors.push(neighbor);
      }
    }

    return neighbors;
  }

  _connectedCells(startCell, player) {
    const visited = new Set();
    const queue = [startCell];
    const connected = [];

    while (queue.length) {
      const cell = queue.shift();
      if (visited.has(cell)) {
        continue;
      }

      visited.add(cell);
      connected.push(cell);

      for (const neighbor of this._adjacentCells(cell)) {
        if (!visited.has(neighbor) && neighbor.value === player) {
          queue.push(neighbor);
        }
      }
    }

    return connected;
  }

  _playerWins(player, connectsOppositeSides) {
    const startCells = this.cells.filter((cell) => cell.value === player);

    for (const startCell of startCells) {
      const connected = this._connectedCells(startCell, player);

      if (connectsOppositeSides) {
        const rows = new Set(connected.map((cell) => cell.row));
        if (rows.size === this.height) {
          return true;
        }
      } else {
        const cols = new Set(connected.map((cell) => cell.col));
        if (cols.size === this.width) {
          return true;
        }
      }
    }

    return false;
  }

  winner() {
    if (this._playerWins('O', true)) {
      return 'O';
    }

    if (this._playerWins('X', false)) {
      return 'X';
    }

    return null;
  }
}
```

This should resolve the failing tests because it now:

- Accepts the board representation.
- Builds a cell grid.
- Traverses only legal adjacent hexes.
- Checks whether `O` connects top to bottom.
- Checks whether `X` connects left to right.
- Returns `null` when nobody has won.

If the tests still fail, the likely next issue is how the board string is offset or how the sides are interpreted, but this implementation follows the standard hex adjacency model described in the instructions.
