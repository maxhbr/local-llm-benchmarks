export class Triangle {
  constructor(...sides) {
    if (sides.length !== 3) {
      throw new Error('A triangle must have exactly three sides');
    }
    const [a, b, c] = sides;
    if (a <= 0 || b <= 0 || c <= 0) {
      throw new Error('Sides must be greater than zero');
    }
    if (a + b < c || b + c < a || a + c < b) {
      throw new Error('The sides violate the triangle inequality');
    }
    this.sides = sides;
  }

  get isEquilateral() {
    const [a, b, c] = this.sides;
    return a === b && b === c;
  }

  get isIsosceles() {
    const [a, b, c] = this.sides;
    return a === b || b === c || a === c;
  }

  get isScalene() {
    const [a, b, c] = this.sides;
    return a !== b && b !== c && a !== c;
  }
}
```

