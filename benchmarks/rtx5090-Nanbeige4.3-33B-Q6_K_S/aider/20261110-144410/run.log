sgf_parsing.py
```python
class SgfTree:
    def __init__(self, properties=None, children=None):
        self.properties = properties or {}
        self.children = children or []

    def __eq__(self, other):
        if not isinstance(other, SgfTree):
            return False
        for key, value in self.properties.items():
            if key not in other.properties:
                return False
            if other.properties[key] != value:
                return False
        for key in other.properties.keys():
            if key not in self.properties:
                return False
        if len(self.children) != len(other.children):
            return False
        for child, other_child in zip(self.children, other.children):
            if child != other_child:
                return False
        return True

    def __ne__(self, other):
        return not self == other


def _unescape_text(text):
    result = []
    i = 0
    while i < len(text):
        ch = text[i]
        if ch == '\\':
            i += 1
            if i >= len(text):
                break
            nxt = text[i]
            if nxt == '\n':
                # Newline removed if it comes immediately after a backslash
                continue
            if nxt.isspace():
                # Any whitespace character after backslash follows the above rules:
                # non-whitespace inserted as-is; whitespace converted to space
                result.append(' ')
            else:
                result.append(nxt)
            i += 1
        else:
            if ch == '\n':
                result.append(ch)
            elif ch.isspace():
                result.append(' ')
            else:
                result.append(ch)
            i += 1
    return ''.join(result)


def _parse_properties(segment):
    props = {}
    i = 0
    n = len(segment)
    while i < n:
        if segment[i] != '[':
            raise ValueError("properties without delimiter")
        i += 1
        key_chars = []
        while i < n and segment[i] != ']':
            key_chars.append(segment[i])
            i += 1
        if i >= n:
            raise ValueError("properties without delimiter")
        key = ''.join(key_chars)
        if not key:
            raise ValueError("property must be in uppercase")
        if not key.isupper():
            raise ValueError("property must be in uppercase")
        i += 1  # skip ']'
        values = []
        while i < n and segment[i] == '[':
            i += 1
            value_chars = []
            while i < n and segment[i] != ']':
                value_chars.append(segment[i])
                i += 1
            if i >= n:
                raise ValueError("properties without delimiter")
            values.append(''.join(value_chars))
            i += 1  # skip ']'
        if not values:
            raise ValueError("property without value")
        if key in props:
            # A key can only occur once but may have multiple values
            props[key] = props[key] + values
        else:
            props[key] = values
    return props


def _parse_node(segment):
    if segment.startswith('('):
        if not segment.endswith(')'):
            raise ValueError("tree missing")
        inner = segment[1:-1]
        children = []
        if inner:
            start = 0
            depth = 0
            for idx, ch in enumerate(inner):
                if ch == '(':
                    depth += 1
                elif ch == ')':
                    depth -= 1
                elif ch == ';' and depth == 0:
                    children.append(inner[start:idx])
                    start = idx + 1
            children.append(inner[start:])
        props = _parse_properties('')
        return SgfTree(props, children)
    else:
        props = _parse_properties(segment)
        return SgfTree(props)


def parse(input_string):
    if not input_string:
        raise ValueError("tree missing")
    if not input_string.startswith('(') or not input_string.endswith(')'):
        raise ValueError("tree missing")
    inner = input_string[1:-1]
    if not inner:
        raise ValueError("tree with no nodes")
    start = 0
    depth = 0
    nodes = []
    for idx, ch in enumerate(inner):
        if ch == '(':
            depth += 1
        elif ch == ')':
            depth -= 1
        elif ch == ';' and depth == 0:
            nodes.append(inner[start:idx])
            start = idx + 1
    nodes.append(inner[start:])
    if not nodes:
        raise ValueError("tree with no nodes")
    root = _parse_node(input_string)
    if not root.children and not root.properties:
        raise ValueError("tree with no nodes")
    return root
```

