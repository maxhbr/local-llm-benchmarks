import re


class SgfTree:
    def __init__(self, properties=None, children=None):
        self.properties = properties or {}
        self.children = children or []

    def __eq__(self, other):
        if not isinstance(other, SgfTree):
            return False
        for key, value in self.properties.items():
            if key not in other.properties:
                return False
            if other.properties[key] != value:
                return False
        for key in other.properties.keys():
            if key not in self.properties:
                return False
        if len(self.children) != len(other.children):
            return False
        for child, other_child in zip(self.children, other.children):
            if child != other_child:
                return False
        return True

    def __ne__(self, other):
        return not self == other


def _unescape_text(text):
    result = []
    i = 0
    while i < len(text):
        char = text[i]
        if char == "\\" and i + 1 < len(text):
            next_char = text[i + 1]
            if next_char == "\n":
                i += 2
                continue
            if next_char.isspace():
                result.append(" ")
                i += 2
                continue
            result.append(next_char)
            i += 2
            continue
        if char == "\n":
            result.append("\n")
        elif char.isspace():
            result.append(" ")
        else:
            result.append(char)
        i += 1
    return "".join(result)


def _parse_node(text, pos, root):
    properties = {}
    children = []

    while True:
        if pos >= len(text):
            raise ValueError("tree missing")

        char = text[pos]

        if char == ";":
            pos += 1
            if pos >= len(text) or text[pos] != "[":
                raise ValueError("properties without delimiter")
            values = []
            while True:
                if pos >= len(text) or text[pos] != "[":
                    raise ValueError("properties without delimiter")
                pos += 1
                value_chars = []
                while pos < len(text) and text[pos] != "]":
                    value_chars.append(text[pos])
                    pos += 1
                if pos >= len(text):
                    raise ValueError("properties without delimiter")
                pos += 1
                values.append(_unescape_text("".join(value_chars)))
                if pos < len(text) and text[pos] == "[":
                    continue
                break
            if char.islower() or char.isupper():
                if not char.isupper():
                    raise ValueError("property must be in uppercase")
                if char in properties:
                    properties[char].extend(values)
                else:
                    properties[char] = values
            else:
                raise ValueError("property must be in uppercase")
            continue

        if char == "(":
            pos += 1
            child = _parse_node(text, pos, root)
            children.append(child)
            continue

        if char == ")":
            pos += 1
            return SgfTree(properties, children)

        raise ValueError("tree missing")


def parse(input_string):
    if not input_string:
        raise ValueError("tree missing")

    if not input_string.startswith("(") or not input_string.endswith(")"):
        raise ValueError("tree missing")

    pos = 1
    if pos >= len(input_string):
        raise ValueError("tree with no nodes")

    if input_string[pos] == ";":
        pos += 1
    elif input_string[pos] == "(":
        pass
    else:
        raise ValueError("tree missing")

    tree = _parse_node(input_string, pos, None)

    if tree.children:
        raise ValueError("tree missing")

    if not tree.properties and not tree.children:
        raise ValueError("tree with no nodes")

    return tree
```
