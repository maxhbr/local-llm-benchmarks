```
use std::collections::HashMap;

/// Count occurrences of words.
pub fn word_count(words: &str) -> HashMap<String, u32> {
    let mut counts = HashMap::new();

    // Split on any character that is not a letter, digit, or apostrophe.
    // This handles punctuation and whitespace as separators.
    let mut current_word: Option<String> = None;

    for ch in words.chars() {
        if ch.is_alphanumeric() || ch == '\'' {
            // Append character to current word
            match &mut current_word {
                Some(word) => word.push(ch),
                None => current_word = Some(ch.to_string()),
            }
        } else {
            // Separator encountered; finalize current word if any
            if let Some(word) = current_word.take() {
                let lower = word.to_lowercase();
                *counts.entry(lower).or_insert(0) += 1;
            }
        }
    }

    // Process any trailing word
    if let Some(word) = current_word.take() {
        let lower = word.to_lowercase();
        *counts.entry(lower).or_insert(0) += 1;
    }

    counts
}
```

