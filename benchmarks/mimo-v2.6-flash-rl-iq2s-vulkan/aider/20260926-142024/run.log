ForthEvaluator.java
```
import java.util.*;

class ForthEvaluator {
    List<Integer> evaluateProgram(List<String> input) {
        Deque<Integer> stack = new ArrayDeque<>();
        Map<String, List<String>> definitions = new HashMap<>();
        Deque<String> tokens = new ArrayDeque<>();

        // Split each input string by whitespace to get individual tokens
        for (String line : input) {
            for (String word : line.trim().split("\\s+")) {
                if (!word.isEmpty()) {
                    tokens.add(word);
                }
            }
        }

        while (!tokens.isEmpty()) {
            String token = tokens.poll();
            String upper = token.toUpperCase();

            // Handle word definition
            if (upper.equals(":")) {
                if (tokens.isEmpty()) {
                    throw new IllegalArgumentException("Missing word name after ':'");
                }
                String wordName = tokens.poll().toUpperCase();
                if (isNumber(wordName)) {
                    throw new IllegalArgumentException("Cannot redefine numbers");
                }
                List<String> definition = new ArrayList<>();
                while (!tokens.isEmpty()) {
                    String defToken = tokens.poll();
                    if (defToken.equals(";")) {
                        break;
                    }
                    definition.add(defToken);
                }
                definitions.put(wordName, definition);
                continue;
            }

            // If token is a number
            if (isNumber(token)) {
                stack.push(Integer.parseInt(token));
                continue;
            }

            // If token is a user-defined word
            if (definitions.containsKey(upper)) {
                List<String> def = definitions.get(upper);
                for (int i = def.size() - 1; i >= 0; i--) {
                    tokens.push(def.get(i));
                }
                continue;
            }

            // Built-in operations
            switch (upper) {
                case "+":
                    if (stack.size() < 2) throw new IllegalArgumentException("Addition requires that the stack contain at least 2 values");
                    int b = stack.pop();
                    int a = stack.pop();
                    stack.push(a + b);
                    break;
                case "-":
                    if (stack.size() < 2) throw new IllegalArgumentException("Subtraction requires that the stack contain at least 2 values");
                    int d = stack.pop();
                    int c = stack.pop();
                    stack.push(c - d);
                    break;
                case "*":
                    if (stack.size() < 2) throw new IllegalArgumentException("Multiplication requires that the stack contain at least 2 values");
                    int f = stack.pop();
                    int e = stack.pop();
                    stack.push(e * f);
                    break;
                case "/":
                    if (stack.size() < 2) throw new IllegalArgumentException("Division requires that the stack contain at least 2 values");
                    int h = stack.pop();
                    int g = stack.pop();
                    if (h == 0) throw new IllegalArgumentException("Division by 0 is not allowed");
                    stack.push(g / h);
                    break;
                case "DUP":
                    if (stack.isEmpty()) throw new IllegalArgumentException("Duplicating requires that the stack contain at least 1 value");
                    stack.push(stack.peek());
                    break;
                case "DROP":
                    if (stack.isEmpty()) throw new IllegalArgumentException("Dropping requires that the stack contain at least 1 value");
                    stack.pop();
                    break;
                case "SWAP":
                    if (stack.size() < 2) throw new IllegalArgumentException("Swapping requires that the stack contain at least 2 values");
                    int top = stack.pop();
                    int second = stack.pop();
                    stack.push(top);
                    stack.push(second);
                    break;
                case "OVER":
                    if (stack.size() < 2) throw new IllegalArgumentException("Overing requires that the stack contain at least 2 values");
                    int secondTop = stack.pop();
                    int firstTop = stack.pop();
                    stack.push(firstTop);
                    stack.push(secondTop);
                    stack.push(firstTop);
                    break;
                default:
                    throw new IllegalArgumentException("No definition available for operator \"" + token + "\"");
            }
        }

        List<Integer> result = new ArrayList<>();
        while (!stack.isEmpty()) {
            result.add(stack.pop());
        }
        Collections.reverse(result);
        return result;
    }

    private boolean isNumber(String s) {
        if (s == null || s.isEmpty()) return false;
        int start = 0;
        if (s.charAt(0) == '-' || s.charAt(0) == '+') {
            if (s.length() == 1) return false;
            start = 1;
        }
        for (int i = start; i < s.length(); i++) {
            if (!Character.isDigit(s.charAt(i))) return false;
        }
        return true;
    }
}
