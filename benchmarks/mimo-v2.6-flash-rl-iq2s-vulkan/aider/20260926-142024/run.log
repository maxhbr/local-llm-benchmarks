class School:
    def __init__(self):
        self._grades = {}
        self._added = []

    def add_student(self, name, grade):
        # Check if the student is already in any grade
        for students in self._grades.values():
            if name in students:
                return False
        self._grades.setdefault(grade, []).append(name)
        # Keep each grade's list sorted alphabetically
        self._grades[grade].sort()
        self._added.append(True)
        return True

    def roster(self):
        # Return students sorted by grade, then by name
        result = []
        for grade in sorted(self._grades):
            result.extend(self._grades[grade])
        return result

    def grade(self, grade_number):
        # Return a copy of the sorted list for the given grade
        return list(self._grades.get(grade_number, []))

    def added(self):
        # Return a list of True for each successful add
        return list(self._added)
```
