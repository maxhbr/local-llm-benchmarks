transpose.go
```
package transpose

func Transpose(input []string) []string {
	if len(input) == 0 {
		return []string{}
	}

	// Find the maximum length of the input rows
	maxLen := 0
	for _, row := range input {
		if len(row) > maxLen {
			maxLen = len(row)
		}
	}

	result := make([]string, 0, maxLen)

	for col := 0; col < maxLen; col++ {
		// Find the first row that has a character at this column
		firstRow := -1
		for r, row := range input {
			if len(row) > col {
				firstRow = r
				break
			}
		}

		// Build the transposed row
		var sb []byte
		for r, row := range input {
			if len(row) > col {
				sb = append(sb, row[col])
			} else if firstRow > r {
				// Pad left with spaces only if there is a later row with a character
				sb = append(sb, ' ')
			}
			// If the row is shorter and there is no later row with a character,
			// we skip adding anything (no right padding)
		}

		result = append(result, string(sb))
	}

	return result
}
```
