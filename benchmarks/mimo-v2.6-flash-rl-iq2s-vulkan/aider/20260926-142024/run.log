response:
Looking at the test failures, the issue is with how we handle padding. The current logic only adds spaces when `firstRow > r`, but we should always add a space when a row doesn't have a character at the current column, then trim trailing spaces from the result.

transpose.go
```
package transpose

func Transpose(input []string) []string {
	if len(input) == 0 {
		return []string{}
	}

	// Find the maximum length of the input rows
	maxLen := 0
	for _, row := range input {
		if len(row) > maxLen {
			maxLen = len(row)
		}
	}

	result := make([]string, 0, maxLen)

	for col := 0; col < maxLen; col++ {
		// Build the transposed row
		var sb []byte
		for _, row := range input {
			if len(row) > col {
				sb = append(sb, row[col])
			} else {
				sb = append(sb, ' ')
			}
		}

		// Trim trailing spaces (don't pad to the right)
		for len(sb) > 0 && sb[len(sb)-1] == ' ' {
			sb = sb[:len(sb)-1]
		}

		result = append(result, string(sb))
	}

	return result
}
```
