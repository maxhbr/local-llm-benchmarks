```
import java.util.*;

class ForthEvaluator {
    List<Integer> evaluateProgram(List<String> input) {
        // Stack of integers
        Deque<Integer> stack = new ArrayDeque<>();
        // Map of user-defined words to their definitions
        Map<String, List<String>> definitions = new HashMap<>();
        // Queue of tokens to process
        Deque<String> tokens = new ArrayDeque<>(input);

        while (!tokens.isEmpty()) {
            String token = tokens.poll();
            String upper = token.toUpperCase();

            // Handle word definition
            if (upper.equals(":")) {
                // Next token is the word name
                if (tokens.isEmpty()) {
                    throw new IllegalArgumentException("Missing word name after ':'");
                }
                String wordName = tokens.poll().toUpperCase();
                List<String> definition = new ArrayList<>();
                // Collect tokens until ';'
                while (!tokens.isEmpty()) {
                    String defToken = tokens.poll();
                    if (defToken.equals(";")) {
                        break;
                    }
                    definition.add(defToken);
                }
                definitions.put(wordName, definition);
                continue;
            }

            // If token is a number
            if (isNumber(token)) {
                stack.push(Integer.parseInt(token));
                continue;
            }

            // If token is a user-defined word
            if (definitions.containsKey(upper)) {
                List<String> def = definitions.get(upper);
                // Push definition tokens in reverse order so they are processed in order
                for (int i = def.size() - 1; i >= 0; i--) {
                    tokens.push(def.get(i));
                }
                continue;
            }

            // Built-in operations
            switch (upper) {
                case "+":
                    if (stack.size() < 2) throw new IllegalArgumentException("Stack underflow for '+'");
                    int b = stack.pop();
                    int a = stack.pop();
                    stack.push(a + b);
                    break;
                case "-":
                    if (stack.size() < 2) throw new IllegalArgumentException("Stack underflow for '-'");
                    int d = stack.pop();
                    int c = stack.pop();
                    stack.push(c - d);
                    break;
                case "*":
                    if (stack.size() < 2) throw new IllegalArgumentException("Stack underflow for '*'");
                    int f = stack.pop();
                    int e = stack.pop();
                    stack.push(e * f);
                    break;
                case "/":
                    if (stack.size() < 2) throw new IllegalArgumentException("Stack underflow for '/'");
                    int h = stack.pop();
                    int g = stack.pop();
                    if (h == 0) throw new ArithmeticException("Division by zero");
                    stack.push(g / h);
                    break;
                case "DUP":
                    if (stack.isEmpty()) throw new IllegalArgumentException("Stack underflow for 'DUP'");
                    stack.push(stack.peek());
                    break;
                case "DROP":
                    if (stack.isEmpty()) throw new IllegalArgumentException("Stack underflow for 'DROP'");
                    stack.pop();
                    break;
                case "SWAP":
                    if (stack.size() < 2) throw new IllegalArgumentException("Stack underflow for 'SWAP'");
                    int top = stack.pop();
                    int second = stack.pop();
                    stack.push(top);
                    stack.push(second);
                    break;
                case "OVER":
                    if (stack.size() < 2) throw new IllegalArgumentException("Stack underflow for 'OVER'");
                    int secondTop = stack.pop();
                    int firstTop = stack.pop();
                    stack.push(firstTop);
                    stack.push(secondTop);
                    stack.push(firstTop);
                    break;
                default:
                    throw new IllegalArgumentException("Unknown word: " + token);
            }
        }

        // Convert stack to list (top of stack is last element)
        List<Integer> result = new ArrayList<>();
        while (!stack.isEmpty()) {
            result.add(stack.pop());
        }
        Collections.reverse(result);
        return result;
    }

    private boolean isNumber(String s) {
        if (s == null || s.isEmpty()) return false;
        int start = 0;
        if (s.charAt(0) == '-' || s.charAt(0) == '+') {
            if (s.length() == 1) return false;
            start = 1;
        }
        for (int i = start; i < s.length(); i++) {
            if (!Character.isDigit(s.charAt(i))) return false;
        }
        return true;
    }
}
