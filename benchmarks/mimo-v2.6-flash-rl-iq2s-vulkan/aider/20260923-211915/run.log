                    Node {
                        name: name.to_string(),
                        attrs: Vec::new(),
                    }
                }
                
                pub fn with_attrs(mut self, attrs: &[(&str, &str)]) -> Self {
                    self.attrs = attrs.iter().map(|(k, v)| (k.to_string(), v.to_string())).collect();
                    self
                }
            }
        }
        
        pub mod edge {
            #[derive(Debug, Clone, PartialEq)]
            pub struct Edge {
                pub from: String,
                pub to: String,
                pub attrs: Vec<(String, String)>,
            }
            
            impl Edge {
                pub fn new(from: &str, to: &str) -> Self {
                    Edge {
                        from: from.to_string(),
                        to: to.to_string(),
                        attrs: Vec::new(),
                    }
                }
                
                pub fn with_attrs(mut self, attrs: &[(&str, &str)]) -> Self {
                    self.attrs = attrs.iter().map(|(k, v)| (k.to_string(), v.to_string())).collect();
                    self
                }
            }
        }
    }
    
    #[derive(Debug, Clone, PartialEq)]
