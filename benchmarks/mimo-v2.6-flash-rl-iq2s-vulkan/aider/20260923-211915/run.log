+    # Handle empty input
+    if not text:
+        return ""
+
+    # Split into rows
+    rows = text.splitlines()
+    if not rows:
+        return ""
+
+    # Determine the maximum row length
+    max_len = max(len(row) for row in rows)
+
+    transposed_rows = []
+    for col_idx in range(max_len):
+        col_chars = []
+        for row in rows:
+            if col_idx < len(row):
