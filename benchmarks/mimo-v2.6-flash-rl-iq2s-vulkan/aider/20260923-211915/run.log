package bowling

// Game represents a bowling game.
type Game struct {
        rolls []int
}

// NewGame creates a new bowling game.
func NewGame() *Game {
        return &Game{rolls: make([]int, 0, 21)}
}

// Roll records a roll of the given number of pins.
func (g *Game) Roll(pins int) error {
        if pins < 0 || pins > 10 {
                return &RollError{Pins: pins}
        }
        
        // Find current frame
        frame := 0
        i := 0
        
        for frame < 9 && i < len(g.rolls) {
                if g.rolls[i] == 10 {
                        i++
                } else {
                        if i+1 >= len(g.rolls) {
                                break
                        }
                        i += 2
                }
                frame++
        }
        
        // If we're still in frames 1-9
        if frame < 9 {
                rollsInFrame := len(g.rolls) - i
                if rollsInFrame == 0 {
                        g.rolls = append(g.rolls, pins)
                } else {
                        if g.rolls[i] + pins > 10 {
                                return &RollError{Pins: pins}
                        }
                        g.rolls = append(g.rolls, pins)
                }
                return nil
        }
        
        // We're at frame 10
        rollsInFrame10 := len(g.rolls) - i
        
        if rollsInFrame10 == 0 {
                g.rolls = append(g.rolls, pins)
                return nil
        }
        
        if rollsInFrame10 == 1 {
                if g.rolls[i] == 10 {
                        // Strike in frame 10, first bonus roll
                        g.rolls = append(g.rolls, pins)
                        return nil
                } else {
                        // Second roll of frame 10
                        if g.rolls[i] + pins > 10 {
                                return &RollError{Pins: pins}
                        }
                        g.rolls = append(g.rolls, pins)
                        return nil
                }
        }
        
        if rollsInFrame10 == 2 {
                if g.rolls[i] == 10 {
                        // Strike in frame 10, second bonus roll
                        if g.rolls[i+1] == 10 {
                                // First bonus roll was a strike
                                g.rolls = append(g.rolls, pins)
                                return nil
                        } else {
                                // First bonus roll was not a strike
                                if g.rolls[i+1] + pins > 10 {
                                        return &RollError{Pins: pins}
                                }
                                g.rolls = append(g.rolls, pins)
                                return nil
                        }
                } else if g.rolls[i] + g.rolls[i+1] == 10 {
                        // Spare in frame 10, bonus roll
                        g.rolls = append(g.rolls, pins)
                        return nil
                } else {
                        // Open frame, game is over
                        return &GameOverError{}
                }
        }
        
        // Game is over
        return &GameOverError{}
}

// Score calculates the total score of the game.
func (g *Game) Score() (int, error) {
        score := 0
        i := 0
        for frame := 0; frame < 10; frame++ {
                if i >= len(g.rolls) {
                        return 0, &IncompleteGameError{}
                }
                if g.rolls[i] == 10 { // strike
                        if i+2 >= len(g.rolls) {
                                return 0, &IncompleteGameError{}
                        }
                        score += 10 + g.rolls[i+1] + g.rolls[i+2]
                        i++
                } else {
                        if i+1 >= len(g.rolls) {
                                return 0, &IncompleteGameError{}
                        }
                        frameScore := g.rolls[i] + g.rolls[i+1]
                        if frameScore == 10 { // spare
                                if i+2 >= len(g.rolls) {
                                        return 0, &IncompleteGameError{}
                                }
                                score += 10 + g.rolls[i+2]
                        } else {
                                score += frameScore
                        }
                        i += 2
                }
        }
        return score, nil
}

// RollError is returned when a roll is invalid.
type RollError struct {
        Pins int
}

func (e *RollError) Error() string {
        return "invalid number of pins"
}

// GameOverError is returned when the game is already over.
type GameOverError struct{}

func (e *GameOverError) Error() string {
        return "cannot roll after game is over"
}

// IncompleteGameError is returned when the game is not finished.
type IncompleteGameError struct{}

func (e *IncompleteGameError) Error() string {
        return "game is not complete"
}
