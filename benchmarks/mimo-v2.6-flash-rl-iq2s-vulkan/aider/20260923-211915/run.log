public class SgfNode {
    private final Map<String, List<String>> properties = new LinkedHashMap<>();
    private final List<SgfNode> children = new ArrayList<>();

    public SgfNode() {
    }

    public SgfNode(Map<String, List<String>> properties) {
        this.properties.putAll(properties);
    }

    public SgfNode(Map<String, List<String>> properties, List<SgfNode> children) {
        this.properties.putAll(properties);
        this.children.addAll(children);
    }

    public void addProperty(String key, String value) {
        properties.computeIfAbsent(key, k -> new ArrayList<>()).add(value);
    }

    public void addChild(SgfNode child) {
        children.add(child);
    }

    public Map<String, List<String>> getProperties() {
        return properties;
    }

    public List<SgfNode> getChildren() {
        return children;
    }
}
