book-store.js
```
//
// This is only a SKELETON file for the 'BookStore' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export const cost = (books) => {
  // Count how many copies of each book (0-4) are in the basket
  const counts = [0, 0, 0, 0, 0];
  for (const book of books) {
    counts[book - 1]++;
  }

  // Discount table: index = number of distinct books in a group
  const discounts = [0, 0, 5, 10, 20, 25];

  // Helper to compute total cost for a given grouping strategy
  const computeCost = (groupSizes) => {
    let total = 0;
    for (const size of groupSizes) {
      if (size === 0) continue;
      const pricePerBook = 800 * (100 - discounts[size]) / 100;
      total += size * pricePerBook;
    }
    return total;
  };

  // Generate all possible ways to partition the counts into groups
  // We'll use a recursive approach to try all groupings
  const findBestCost = (remaining) => {
    // If all books are used, return 0
    if (remaining.every(c => c === 0)) return 0;

    // Find the first book with remaining copies
    let idx = remaining.findIndex(c => c > 0);
    if (idx === -1) return 0;

    // Try all possible group sizes from 5 down to 1
    let best = Infinity;
    for (let size = 5; size >= 1; size--) {
      // Check if we can form a group of this size
      const newRemaining = [...remaining];
      let used = 0;
      for (let i = 0; i < 5; i++) {
        if (newRemaining[i] > 0) {
          newRemaining[i]--;
          used++;
          if (used === size) break;
        }
      }
      if (used === size) {
        const pricePerBook = 800 * (100 - discounts[size]) / 100;
        const groupCost = size * pricePerBook;
        const restCost = findBestCost(newRemaining);
        best = Math.min(best, groupCost + restCost);
      }
    }
    return best;
  };

  return findBestCost(counts);
};
```
