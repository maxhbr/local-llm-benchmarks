};

}  // namespace grade_school

#endif  // GRADE_SCHOOL_H
```

grade_school.cpp:
```cpp
#include "grade_school.h"

#include <algorithm>
#include <stdexcept>

namespace grade_school {

void roster::add(int grade, const std::string& student) {
   const auto it = grades_.find(grade);
   if (it == grades_.end()) {
      grades_[grade] = std::vector<std::string>{student};
      return;
   }

   auto& students = it->second;
   if (std::find(students.begin(), students.end(), student) != students.end()) {
      throw std::domain_error("Student already enrolled in grade " +
                               std::to_string(grade) + ": " + student);
   }

   students.push_back(student);
   std::sort(students.begin(), students.end());
}

std::vector<std::string> roster::get_roster() const {
   std::vector<std::string> all;
   for (const auto& grade_and_students : grades_) {
      const auto& students = grade_and_students.second;
      all.insert(all.end(), students.begin(), students.end());
   }
   return all;
}

std::vector<std::string> roster::grades(int grade) const {
   const auto it = grades_.find(grade);
   if (it == grades_.end()) {
      return std::vector<std::string>{};
   }
   return it->second;
}

}  // namespace grade_school
```

