        // constraint 4: Ukrainian drinks tea (needs drink later)
        // constraint 9: Norwegian first house
        if (natPerm[0] != NORWEGIAN) continue;
        // constraint 14: Norwegian next to blue house
        // blue house index
        int blueIdx = indexOf(colorPerm, BLUE);
        if (Math.abs(0 - blueIdx) != 1) continue; // Norwegian at 0, blue must be 1
        // constraint 13: Japanese plays chess (needs hobby later)
        for (int[] petPerm : petPerms) {
            // constraint 2: Spaniard owns dog
            int spanIdx = indexOf(natPerm, SPANISH);
            if (petPerm[spanIdx] != DOG) continue;
            // constraint 6: snail owner likes dancing (needs hobby later)
            // constraint 10: reading next to fox (needs hobby later)
            // constraint 11: painter next to horse (needs hobby later)
            // constraint 12: football drinks orange juice (needs hobby later)
            for (int[] drinkPerm : drinkPerms) {
                // constraint 3: green house drinks coffee
                if (drinkPerm[greenIdx] != COFFEE) continue;
                // constraint 4: Ukrainian drinks tea
                int ukrIdx = indexOf(natPerm, UKRAINIAN);
                if (drinkPerm[ukrIdx] != TEA) continue;
                // constraint 8: middle house drinks milk
                if (drinkPerm[2] != MILK) continue;
                // constraint 12: football drinks orange juice (needs hobby later)
                for (int[] hobbyPerm : hobbyPerms) {
                    // constraint 6: snail owner likes dancing
                    int snailIdx = indexOf(petPerm, SNAIL);
                    if (hobbyPerm[snailIdx] != DANCING) continue;
                    // constraint 7: yellow house painter
                    int yellowIdx = indexOf(colorPerm, YELLOW);
                    if (hobbyPerm[yellowIdx] != PAINTER) continue;
                    // constraint 10: reading next to fox
                    int readingIdx = indexOf(hobbyPerm, READING);
                    int foxIdx = indexOf(petPerm, FOX);
                    if (Math.abs(readingIdx - foxIdx) != 1) continue;
                    // constraint 11: painter next to horse
                    int painterIdx = indexOf(hobbyPerm, PAINTER);
                    int horseIdx = indexOf(petPerm, HORSE);
                    if (Math.abs(painterIdx - horseIdx) != 1) continue;
                    // constraint 12: football drinks orange juice
                    int footballIdx = indexOf(hobbyPerm, FOOTBALL);
                    if (drinkPerm[footballIdx] != ORANGE_JUICE) continue;
                    // constraint 13: Japanese plays chess
                    int japIdx = indexOf(natPerm, JAPANESE);
                    if (hobbyPerm[japIdx] != CHESS) continue;
                    // All constraints satisfied
                    // Find water drinker
                    int waterIdx = indexOf(drinkPerm, WATER);
                    String waterDrinker = NATIONALITIES[natPerm[waterIdx]];
                    // Find zebra owner
                    int zebraIdx = indexOf(petPerm, ZEBRA);
                    String zebraOwner = NATIONALITIES[natPerm[zebraIdx]];
                    // store results
                    this.waterDrinker = waterDrinker;
                    this.zebraOwner = zebraOwner;
                    return;
                }
            }
        }
    }
}

We need to generate permutations for each attribute.

We'll create a method generatePermutations(int n) returning List<int[]>.

We'll use recursion.

Implementation:

private static List<int[]> generatePermutations(int n) {
    List<int[]> result = new ArrayList<>();
    int[] arr = new int[n];
    for (int i=0;i<n;i++) arr[i]=i;
    permute(arr, 0, result);
    return result;
}

private static void permute(int[] arr, int k, List<int[]> result) {
    if (k == arr.length) {
        result.add(arr.clone());
        return;
    }
    for (int i=k; i<arr.length; i++) {
        swap(arr, k, i);
        permute(arr, k+1, result);
        swap(arr, k, i);
    }
}

private static void swap(int[] arr, int i, int j) {
    int temp = arr[i];
    arr[i] = arr[j];
    arr[j] = temp;
}

We also need indexOf method: given int[] perm and target index (attribute index), return position where 
perm[pos]==target.

private static int indexOf(int[] perm, int target) {
    for (int i=0;i<perm.length;i++) if (perm[i]==target) return i;
    return -1;
}

