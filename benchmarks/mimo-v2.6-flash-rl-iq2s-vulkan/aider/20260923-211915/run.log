def proverb(*args, qualifier=None):
    """Generate the proverb based on the given items.

    Parameters
    ----------
    *args : str
        The items that make up the proverb.
    qualifier : str, optional
        A word prepended to the first item in the final line.

    Returns
    -------
    list of str
        The lines of the proverb.
    """
    lines = []
    for i in range(len(args) - 1):
        lines.append(f"For want of a {args[i]} the {args[i+1]} was lost.")

    if args:
        first = f"{qualifier} {args[0]}" if qualifier else args[0]
        lines.append(f"And all for the want of a {first}.")

    return lines
```
