def proverb(*args, qualifier=None):
    """Generate the proverb based on the given items.

    Parameters
    ----------
    *args : str
        The items that make up the proverb.
    qualifier : str, optional
        The word used in the final line. If not provided, the first
        item in ``args`` is used.

    Returns
    -------
    str
        The full text of the proverb, with each line separated by a
        newline character.
    """
    if not args:
        return ""

    lines = []
    for i in range(len(args) - 1):
        lines.append(f"For want of a {args[i]} the {args[i+1]} was lost.")

    final_word = qualifier if qualifier is not None else args[0]
    lines.append(f"And all for the want of a {final_word}.")

    return "\n".join(lines)
```
