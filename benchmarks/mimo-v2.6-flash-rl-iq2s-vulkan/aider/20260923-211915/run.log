```
import java.util.Map;
import java.util.HashMap;
import java.util.ArrayList;
import java.util.List;
import java.util.Set;
import java.util.HashSet;
import java.util.Collections;

class Alphametics {

    private final String userInput;
    private final List<String> terms;
    private final String result;
    private final Set<Character> letters;
    private final Map<Character, Integer> assignment;

    Alphametics(String userInput) {
        this.userInput = userInput;
        this.terms = new ArrayList<>();
        this.letters = new HashSet<>();
        this.assignment = new HashMap<>();

        // Parse input: format "A + B = C" where A, B, C are words separated by '+' and '='
        String[] parts = userInput.split("=");
        if (parts.length != 2) {
            throw new IllegalArgumentException("Invalid format: expected 'A + B = C'");
        }
        String left = parts[0].trim();
        result = parts[1].trim();

        String[] addends = left.split("\\+");
        for (String addend : addends) {
            String word = addend.trim();
            terms.add(word);
            for (char c : word.toCharArray()) {
                letters.add(c);
            }
        }
        for (char c : result.toCharArray()) {
            letters.add(c);
        }
    }

    Map<Character, Integer> solve() throws UnsolvablePuzzleException {
        // Prepare list of letters for backtracking
        List<Character> letterList = new ArrayList<>(letters);
        Collections.shuffle(letterList);

        // Determine which letters cannot be zero (leading letters of any word)
        Set<Character> nonZero = new HashSet<>();
        for (String word : terms) {
            nonZero.add(word.charAt(0));
        }
        nonZero.add(result.charAt(0));

        // Backtracking
        if (backtrack(0, letterList, nonZero)) {
            return new HashMap<>(assignment);
        } else {
            throw new UnsolvablePuzzleException();
        }
    }

    private boolean backtrack(int index, List<Character> letterList, Set<Character> nonZero) {
        if (index == letterList.size()) {
            return checkSum();
        }
        char letter = letterList.get(index);
        for (int digit = 0; digit <= 9; digit++) {
            if (nonZero.contains(letter) && digit == 0) continue;
            if (assignment.containsValue(digit)) continue; // digit already used
            assignment.put(letter, digit);
            if (backtrack(index + 1, letterList, nonZero)) return true;
            assignment.remove(letter);
        }
        return false;
    }

    private boolean checkSum() {
        // Convert each term to number
        long sum = 0;
        for (String word : terms) {
            sum += toNumber(word);
        }
        long resultNum = toNumber(result);
        return sum == resultNum;
    }

    private long toNumber(String word) {
        long num = 0;
        for (char c : word.toCharArray()) {
            num = num * 10 + assignment.get(c);
        }
        return num;
    }
}
