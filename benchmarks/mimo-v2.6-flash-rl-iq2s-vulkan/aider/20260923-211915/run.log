pub type Value = i32;
pub type Result = std::result::Result<(), Error>;

use std::collections::HashMap;

pub struct Forth {
    stack: Vec<Value>,
    definitions: HashMap<String, Vec<String>>,
}

#[derive(Debug, PartialEq, Eq)]
pub enum Error {
    DivisionByZero,
    StackUnderflow,
    UnknownWord,
    InvalidWord,
}

impl Forth {
    pub fn new() -> Forth {
        Forth {
            stack: Vec::new(),
            definitions: HashMap::new(),
        }
    }

    pub fn stack(&self) -> &[Value] {
        &self.stack
    }

    pub fn eval(&mut self, input: &str) -> Result {
        let mut tokens = input.split_whitespace().peekable();
        let mut in_definition = false;
        let mut def_name: Option<String> = None;
        let mut def_tokens: Vec<String> = Vec::new();

        while let Some(token) = tokens.next() {
            if in_definition {
                if token == ";" {
                    if let Some(name) = def_name.take() {
                        self.definitions.insert(name, def_tokens.clone());
                    }
                    def_tokens.clear();
                    in_definition = false;
                } else {
                    def_tokens.push(token.to_uppercase());
                }
                continue;
            }

            if token == ":" {
                let name = tokens.next().ok_or(Error::InvalidWord)?;
                if name.parse::<i32>().is_ok() {
                    return Err(Error::InvalidWord);
                }
                def_name = Some(name.to_uppercase());
                def_tokens.clear();
                in_definition = true;
                continue;
            }

            if token == ";" {
                return Err(Error::InvalidWord);
            }

            self.process_token(token)?;
        }

        if in_definition {
            return Err(Error::InvalidWord);
        }

        Ok(())
    }

    fn process_token(&mut self, token: &str) -> Result {
        if let Ok(num) = token.parse::<i32>() {
            self.stack.push(num);
            return Ok(());
        }

        let upper = token.to_uppercase();
        match upper.as_str() {
            "+" => self.binary_op(|a, b| a + b),
            "-" => self.binary_op(|a, b| a - b),
            "*" => self.binary_op(|a, b| a * b),
            "/" => {
                let b = self.pop()?;
                let a = self.pop()?;
                if b == 0 {
                    return Err(Error::DivisionByZero);
                }
                self.stack.push(a / b);
                Ok(())
            }
            "DUP" => {
                let top = *self.stack.last().ok_or(Error::StackUnderflow)?;
                self.stack.push(top);
                Ok(())
            }
            "DROP" => {
                self.pop()?;
                Ok(())
            }
            "SWAP" => {
                let b = self.pop()?;
                let a = self.pop()?;
                self.stack.push(b);
                self.stack.push(a);
                Ok(())
            }
            "OVER" => {
                if self.stack.len() < 2 {
                    return Err(Error::StackUnderflow);
                }
                let second = self.stack[self.stack.len() - 2];
                self.stack.push(second);
                Ok(())
            }
            _ => {
                if let Some(def) = self.definitions.get(&upper) {
                    let def_clone = def.clone();
                    for t in def_clone {
                        self.process_token(&t)?;
                    }
                    Ok(())
                } else {
                    Err(Error::UnknownWord)
                }
            }
        }
    }

    fn pop(&mut self) -> std::result::Result<Value, Error> {
        self.stack.pop().ok_or(Error::StackUnderflow)
    }

    fn binary_op<F>(&mut self, f: F) -> Result
    where
        F: FnOnce(Value, Value) -> Value,
    {
        let b = self.pop()?;
        let a = self.pop()?;
        self.stack.push(f(a, b));
        Ok(())
    }
}
```
