```
#include "crypto_square.h"

#include <cmath>
#include <cctype>
#include <vector>

namespace crypto_square {

std::string encode(const std::string& text) {
    // Normalize: remove spaces and punctuation, lowercase
    std::string normalized;
    for (char ch : text) {
        if (std::isalnum(static_cast<unsigned char>(ch))) {
            normalized += std::tolower(static_cast<unsigned char>(ch));
        }
    }

    size_t n = normalized.size();
    if (n == 0) {
        return "";
    }

    // Compute rectangle dimensions
    size_t c = static_cast<size_t>(std::ceil(std::sqrt(n)));
    size_t r = static_cast<size_t>(std::ceil(static_cast<double>(n) / c));
    // Ensure conditions
    while (c < r || (c - r) > 1) {
        // Adjust if needed (should not happen with above formulas)
        if (c < r) {
            c = r;
        } else {
            // Increase c
            c++;
        }
        r = static_cast<size_t>(std::ceil(static_cast<double>(n) / c));
    }

    // Build rows
    std::vector<std::string> rows(r, std::string(c, ' '));
    size_t idx = 0;
    for (size_t i = 0; i < r; ++i) {
        for (size_t j = 0; j < c; ++j) {
            if (idx < n) {
                rows[i][j] = normalized[idx++];
            }
        }
    }

    // Build chunks (columns)
    std::vector<std::string> chunks(c);
    for (size_t j = 0; j < c; ++j) {
        for (size_t i = 0; i < r; ++i) {
            if (rows[i][j] != ' ') {
                chunks[j] += rows[i][j];
            }
        }
    }

    // Pad short chunks with a trailing space
    for (auto& chunk : chunks) {
        if (chunk.size() < r) {
            chunk += ' ';
        }
    }

    // Join chunks with spaces
    std::string result;
    for (size_t i = 0; i < c; ++i) {
        if (i > 0) {
            result += ' ';
        }
        result += chunks[i];
    }

    return result;
}

}  // namespace crypto_square
```

