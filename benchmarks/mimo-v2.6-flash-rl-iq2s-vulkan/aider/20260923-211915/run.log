Let me write the fixed code:

```python
def transpose(text):
    if not text:
        return ""

    rows = text.splitlines()
    if not rows:
        return ""

    max_len = max(len(row) for row in rows)

    transposed_rows = []
    for col_idx in range(max_len):
        col_chars = []
        for row in rows:
            if col_idx < len(row):
                col_chars.append(row[col_idx])
            else:
                col_chars.append(" ")
        # Strip trailing spaces (don't pad to the right)
        result = "".join(col_chars).rstrip()
        transposed_rows.append(result)

    return "\n".join(transposed_rows)
```

