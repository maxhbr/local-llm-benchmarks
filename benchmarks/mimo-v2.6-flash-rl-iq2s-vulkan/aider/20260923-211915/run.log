class BaseConverter {

    private final int originalBase;
    private final int[] originalDigits;

    BaseConverter(int originalBase, int[] originalDigits) {
        if (originalBase < 2) {
            throw new IllegalArgumentException("Bases must be at least 2.");
        }
        if (originalDigits == null) {
            throw new IllegalArgumentException("Digits must not be null.");
        }
        for (int digit : originalDigits) {
            if (digit < 0 || digit >= originalBase) {
                throw new IllegalArgumentException("Digit out of range for base " + originalBase + ".");
            }
        }
        this.originalBase = originalBase;
        this.originalDigits = originalDigits.clone();
    }

    int[] convertToBase(int newBase) {
        if (newBase < 2) {
            throw new IllegalArgumentException("Bases must be at least 2.");
        }

        // Convert original digits to a decimal value using arbitrary precision
        // via repeated multiplication in the target base (no big integer library needed
        // beyond simple arrays of digits in base 10... but simplest is to do the
        // conversion directly from source base to target base using division).
        //
        // Strategy: represent the number as an array of digits in the original base,
        // then repeatedly divide by newBase, collecting remainders.

        int[] digits = originalDigits.clone();

        // Remove leading zeros
        int start = 0;
        while (start < digits.length - 1 && digits[start] == 0) {
            start++;
        }
        int[] trimmed = new int[digits.length - start];
        System.arraycopy(digits, start, trimmed, 0, trimmed.length);

        // If the number is zero
        if (trimmed.length == 1 && trimmed[0] == 0) {
            return new int[] { 0 };
        }

        // Repeated division: divide the number (in originalBase) by newBase
        java.util.ArrayList<Integer> result = new java.util.ArrayList<>();

        int[] current = trimmed;
        while (!(current.length == 1 && current[0] == 0)) {
            int remainder = 0;
            int[] quotient = new int[current.length];
            for (int i = 0; i < current.length; i++) {
                int dividend = remainder * originalBase + current[i];
                quotient[i] = dividend / newBase;
                remainder = dividend % newBase;
            }
            result.add(remainder);

            // Trim leading zeros from quotient
            int qStart = 0;
            while (qStart < quotient.length - 1 && quotient[qStart] == 0) {
                qStart++;
            }
            current = new int[quotient.length - qStart];
            System.arraycopy(quotient, qStart, current, 0, current.length);
        }

        int[] converted = new int[result.size()];
        for (int i = 0; i < result.size(); i++) {
            converted[i] = result.get(result.size() - 1 - i);
        }
        return converted;
    }

}
