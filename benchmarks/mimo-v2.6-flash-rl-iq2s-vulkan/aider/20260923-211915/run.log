namespace grade_school {

class roster {
 public:
   // Enroll a student in the given grade.
   // Throws std::domain_error if the student is already enrolled in that grade.
   void add(int grade, const std::string& student);

   // All students in all grades, sorted by grade, then by name.
   std::vector<std::string> get_roster() const;

   // Students enrolled in the given grade, sorted by name.
   // Empty if no such grade exists.
   std::vector<std::string> grades(int grade) const;

 private:
