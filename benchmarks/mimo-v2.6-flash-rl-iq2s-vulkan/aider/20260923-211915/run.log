namespace grade_school {

void roster::add(int grade, const std::string& name) {
  auto& students = grades_[grade];
  if (std::find(students.begin(), students.end(), name) != students.end()) {
    return;
  }
  students.push_back(name);
  std::sort(students.begin(), students.end());
}

std::vector<std::string> roster::grades(int grade) const {
  auto it = grades_.find(grade);
  if (it == grades_.end()) {
    return {};
  }
  return it->second;
}

std::vector<std::string> roster::roster() const {
  std::vector<std::string> all;
  for (const auto& [grade, students] : grades_) {
    all.insert(all.end(), students.begin(), students.end());
  }
  return all;
}

}  // namespace grade_school
```

