The issue is that `-0` is not considered equal to `0` by Jest's `toEqual`. When the imaginary part is `0`, negating it produces `-0`. We need to normalize `-0` back to `0`.

complex-numbers.js
```
export class ComplexNumber {
  constructor(real, imag) {
    this._real = real;
    this._imag = imag;
  }

  get real() {
    return this._real;
  }

  get imag() {
    return this._imag;
  }

  add({ real, imag }) {
    return new ComplexNumber(this._real + real, this._imag + imag);
  }

  sub({ real, imag }) {
    return new ComplexNumber(this._real - real, this._imag - imag);
  }

  div({ real, imag }) {
    const denom = real * real + imag * imag;
    return new ComplexNumber(
      (this._real * real + this._imag * imag) / denom,
      (this._imag * real - this._real * imag) / denom
    );
  }

  mul({ real, imag }) {
    return new ComplexNumber(
      this._real * real - this._imag * imag,
      this._imag * real + this._real * imag
    );
  }

  get abs() {
    return Math.sqrt(this._real * this._real + this._imag * this._imag);
  }

  get conj() {
    const imag = -this._imag;
    return new ComplexNumber(this._real, imag === 0 ? 0 : imag);
  }

  get exp() {
    const magnitude = Math.exp(this._real);
    return new ComplexNumber(
      magnitude * Math.cos(this._imag),
      magnitude * Math.sin(this._imag)
    );
  }
}
```
