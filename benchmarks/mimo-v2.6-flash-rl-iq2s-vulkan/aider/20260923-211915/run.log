response:
The issue is that when forming a group, the code always picks the first `size` available books (from index 0 onwards), rather than trying all possible combinations of which books to include in a group.

book-store.js
```
//
// This is only a SKELETON file for the 'BookStore' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export const cost = (books) => {
  // Count how many copies of each book (0-4) are in the basket
  const counts = [0, 0, 0, 0, 0];
  for (const book of books) {
    counts[book - 1]++;
  }

  // Discount table: index = number of distinct books in a group
  const discounts = [0, 0, 5, 10, 20, 25];

  // Generate all combinations of `size` distinct books from those with remaining copies
  const getCombinations = (remaining, size) => {
    const available = [];
    for (let i = 0; i < 5; i++) {
      if (remaining[i] > 0) available.push(i);
    }

    const combinations = [];

    const helper = (start, current) => {
      if (current.length === size) {
        combinations.push([...current]);
        return;
      }
      for (let i = start; i < available.length; i++) {
        current.push(available[i]);
        helper(i + 1, current);
        current.pop();
      }
    };

    helper(0, []);
    return combinations;
  };

  // Recursive search for the best cost
  const findBestCost = (remaining) => {
    if (remaining.every(c => c === 0)) return 0;

    let best = Infinity;

    for (let size = 5; size >= 1; size--) {
      const combinations = getCombinations(remaining, size);
      for (const combo of combinations) {
        const newRemaining = [...remaining];
        for (const idx of combo) {
          newRemaining[idx]--;
        }
        const pricePerBook = 800 * (100 - discounts[size]) / 100;
        const groupCost = size * pricePerBook;
        const restCost = findBestCost(newRemaining);
        best = Math.min(best, groupCost + restCost);
      }
    }

    return best;
  };

  return findBestCost(counts);
};
```
