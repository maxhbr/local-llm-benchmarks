say.js
```
//
// Implementation of the Say exercise.
//

const ones = [
  '', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine',
  'ten', 'eleven', 'twelve', 'thirteen', 'fourteen', 'fifteen', 'sixteen',
  'seventeen', 'eighteen', 'nineteen'
];

const tens = [
  '', '', 'twenty', 'thirty', 'forty', 'fifty', 'sixty', 'seventy', 'eighty',
  'ninety'
];

const scales = ['', 'thousand', 'million', 'billion'];

function spellUnder1000(num) {
  if (num === 0) return '';
  if (num < 20) return ones[num];
  if (num < 100) {
    const t = Math.floor(num / 10);
    const o = num % 10;
    return tens[t] + (o ? '-' + ones[o] : '');
  }
  const h = Math.floor(num / 100);
  const rest = num % 100;
  let result = ones[h] + ' hundred';
  if (rest > 0) result += ' ' + spellUnder1000(rest);
  return result;
}

export const say = (n) => {
  if (!Number.isInteger(n) || n < 0 || n > 999999999999) {
    throw new Error('Number must be between 0 and 999,999,999,999.');
  }
  if (n === 0) return 'zero';

  const parts = [];
  const billions = Math.floor(n / 1e9);
  const millions = Math.floor((n % 1e9) / 1e6);
  const thousands = Math.floor((n % 1e6) / 1000);
  const units = n % 1000;

  if (billions > 0) parts.push(spellUnder1000(billions) + ' billion');
  if (millions > 0) parts.push(spellUnder1000(millions) + ' million');
  if (thousands > 0) parts.push(spellUnder1000(thousands) + ' thousand');
  if (units > 0) parts.push(spellUnder1000(units));

  return parts.join(' ');
};
```
