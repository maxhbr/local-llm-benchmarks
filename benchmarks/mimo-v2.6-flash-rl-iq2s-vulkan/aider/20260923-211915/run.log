#include "clock.h"

namespace date_independent {

Clock::Clock(int hours, int minutes) {
    int total = hours * 60 + minutes;
    total %= 1440;
    if (total < 0) total += 1440;
    hours_ = total / 60;
    minutes_ = total % 60;
}

Clock Clock::add(int minutes) const {
    int total = hours_ * 60 + minutes_ + minutes;
    total %= 1440;
    if (total < 0) total += 1440;
    return Clock(total / 60, total % 60);
}

Clock Clock::subtract(int minutes) const {
    return add(-minutes);
}

bool Clock::operator==(const Clock& other) const {
    return hours_ == other.hours_ && minutes_ == other.minutes_;
}

bool Clock::operator!=(const Clock& other) const {
    return !(*this == other);
}

std::string Clock::to_string() const {
