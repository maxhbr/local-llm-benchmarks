def recite(start, take=1):
    number_words = {
        0: "no",
        1: "One",
        2: "Two",
        3: "Three",
        4: "Four",
        5: "Five",
        6: "Six",
        7: "Seven",
        8: "Eight",
        9: "Nine",
        10: "Ten",
    }

    def bottle_word(count):
        return "bottle" if count == 1 else "bottles"

    lines = []
    for i in range(take):
        current = start - i
        next_count = current - 1

        current_word = number_words[current]
        next_word = number_words[next_count]

        if i > 0:
            lines.append("")

        lines.append(f"{current_word} green {bottle_word(current)} hanging on the wall,")
        lines.append(f"{current_word} green {bottle_word(current)} hanging on the wall,")
        lines.append("And if one green bottle should accidentally fall,")
        lines.append(f"There'll be {next_word} green {bottle_word(next_count)} hanging on the wall.")

    return lines
```
