class WordProblemSolver {
    int solve(final String wordProblem) {
        if (wordProblem == null || !wordProblem.toLowerCase().startsWith("what is")) {
            throw new IllegalArgumentException("I'm sorry, I don't understand the question!");
        }

        String expression = wordProblem.substring("what is".length()).trim();
        if (expression.endsWith("?")) {
            expression = expression.substring(0, expression.length() - 1).trim();
        }
        if (expression.isEmpty()) {
            throw new IllegalArgumentException("I'm sorry, I don't understand the question!");
        }

        String[] tokens = expression.split("\\s+");
        int result = parseNumber(tokens[0]);

        int i = 1;
        while (i < tokens.length) {
            String operator = tokens[i];
            if (operator.equals("multiplied") || operator.equals("divided")) {
                if (i + 2 >= tokens.length || !tokens[i + 1].equals("by")) {
                    throw new IllegalArgumentException("I'm sorry, I don't understand the question!");
                }
                int operand = parseNumber(tokens[i + 2]);
                if (operator.equals("multiplied")) {
                    result *= operand;
                } else {
                    if (operand == 0) throw new ArithmeticException("Division by zero");
                    result /= operand;
                }
                i += 3;
            } else if (operator.equals("plus") || operator.equals("minus")) {
                if (i + 1 >= tokens.length) {
                    throw new IllegalArgumentException("I'm sorry, I don't understand the question!");
                }
                int operand = parseNumber(tokens[i + 1]);
                if (operator.equals("plus")) {
                    result += operand;
                } else {
                    result -= operand;
                }
                i += 2;
            } else {
                throw new IllegalArgumentException("I'm sorry, I don't understand the question!");
            }
        }

        return result;
    }

    private int parseNumber(final String token) {
        try {
            return Integer.parseInt(token);
        } catch (NumberFormatException e) {
            throw new IllegalArgumentException("I'm sorry, I don't understand the question!");
        }
    }
}
