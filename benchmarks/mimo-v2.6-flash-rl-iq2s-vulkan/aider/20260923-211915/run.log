export class Binary {
  constructor(binaryString) {
    if (typeof binaryString !== 'string' || /[^01]/.test(binaryString)) {
      this.binaryString = null;
    } else {
      this.binaryString = binaryString;
    }
  }

  toDecimal() {
    if (this.binaryString === null) {
      return null;
    }
    let result = 0;
    for (const digit of this.binaryString) {
      result = result * 2 + Number(digit);
    }
    return result;
  }
}
