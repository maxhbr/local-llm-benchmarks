```javascript
export class Zipper {
  constructor(node, parent = null, direction = null) {
    this._node = node;
    this._parent = parent;
    this._direction = direction;
  }

  static fromTree(tree) {
    return new Zipper(tree);
  }

  toTree() {
    let zipper = this;
    while (zipper._parent) {
      zipper = zipper.up();
    }
    return zipper._node;
  }

  value() {
    return this._node.value;
  }

  left() {
    if (!this._node.left) return null;
    return new Zipper(this._node.left, this, 'left');
  }

  right() {
    if (!this._node.right) return null;
    return new Zipper(this._node.right, this, 'right');
  }

  up() {
    if (!this._parent) return null;
    return this._parent;
  }

  setValue(value) {
    const newNode = { ...this._node, value };
    return this._rebuild(newNode);
  }

  setLeft(left) {
    const newNode = { ...this._node, left };
    return this._rebuild(newNode);
  }

  setRight(right) {
    const newNode = { ...this._node, right };
    return this._rebuild(newNode);
  }

  _rebuild(newNode) {
    if (!this._parent) {
      return new Zipper(newNode);
    }
    // Rebuild parent with updated child
    const parent = this._parent;
    let updatedParent;
    if (this._direction === 'left') {
      updatedParent = { ...parent._node, left: newNode };
    } else {
      updatedParent = { ...parent._node, right: newNode };
    }
    return new Zipper(updatedParent, parent._parent, parent._direction);
  }
}
```

