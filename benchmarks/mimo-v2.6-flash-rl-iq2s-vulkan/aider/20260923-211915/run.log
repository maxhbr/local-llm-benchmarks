```
export const encode = (numbers) => {
  const bytes = [];

  for (const number of numbers) {
    let value = number;
    const chunks = [];

    do {
      chunks.unshift(value & 0x7f);
      value >>>= 7;
    } while (value > 0);

    for (let i = 0; i < chunks.length; i++) {
      const isLast = i === chunks.length - 1;
      bytes.push(isLast ? chunks[i] : chunks[i] | 0x80);
    }
  }

  return bytes;
};

export const decode = (bytes) => {
  const numbers = [];
  let value = 0;

  for (const byte of bytes) {
    value = (value << 7) | (byte & 0x7f);

    if ((byte & 0x80) === 0) {
      numbers.push(value);
      value = 0;
    }
  }

  return numbers;
};
```
