transpose.py
```
def transpose(text):
    """
    Transpose a matrix represented by a string of lines.

    The input text is split into lines. Each line is treated as a row of
    the matrix. The transpose is produced by turning rows into columns.

    Padding rules:
    - If a row is shorter than the current column index, a space is
      inserted **only** if no character has been added yet for that
      column (i.e., pad to the left).
    - No padding is added to the right.

    Parameters
    ----------
    text : str
        The input matrix as a string with newline-separated rows.

    Returns
    -------
    str
        The transposed matrix as a string with newline-separated rows.
    """
    # Handle empty input
    if not text:
        return ""

    # Split into rows
    rows = text.splitlines()
    if not rows:
        return ""

    # Determine the maximum row length
    max_len = max(len(row) for row in rows)

    transposed_rows = []
    for col_idx in range(max_len):
        col_chars = []
        for row in rows:
            if col_idx < len(row):
                col_chars.append(row[col_idx])
            else:
                # Pad left with a space only if no character has been
                # added yet for this column.
                if not col_chars:
                    col_chars.append(" ")
                # Otherwise, skip (do not pad to the right)
        transposed_rows.append("".join(col_chars))

    return "\n".join(transposed_rows)
```
