beer-song.js
```
//
// This is only a SKELETON file for the 'Beer Song' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

const bottlePhrase = (count) => {
  if (count === 0) return 'no more bottles';
  if (count === 1) return '1 bottle';
  return `${count} bottles`;
};

const generateVerse = (count) => {
  let firstLine;
  if (count === 0) {
    firstLine = 'No more bottles of beer on the wall, no more bottles of beer.';
  } else {
    const phrase = bottlePhrase(count);
    firstLine = `${phrase} of beer on the wall, ${phrase} of beer.`;
  }

  let secondLine;
  if (count === 0) {
    secondLine = 'Go to the store and buy some more, 99 bottles of beer on the wall.';
  } else {
    const nextCount = count - 1;
    const nextPhrase = bottlePhrase(nextCount);
    const action = count === 1 ? 'Take it down' : 'Take one down';
    secondLine = `${action} and pass it around, ${nextPhrase} of beer on the wall.`;
  }

  return `${firstLine}\n${secondLine}`;
};

export const recite = (initialBottlesCount, takeDownCount) => {
  const verses = [];
  for (let count = initialBottlesCount; count >= takeDownCount; count--) {
    verses.push(generateVerse(count));
  }
  return verses.join('\n\n');
};
```
