#if !defined(GRADE_SCHOOL_H)
#define GRADE_SCHOOL_H

#include <map>
#include <string>
#include <vector>

namespace grade_school {

class school {
 public:
   // Enroll a student in the given grade.
   // Throws std::domain_error if the student is already enrolled in that grade.
   void add(const std::string& student, int grade);

   // All students in all grades, sorted by grade, then by name.
   std::vector<std::string> roster() const;

   // Students enrolled in the given grade, sorted by name.
   // Empty if no such grade exists.
   std::vector<std::string> grade(int grade) const;

 private:
   std::map<int, std::vector<std::string>> grades_;
};

}  // namespace grade_school

#endif  // GRADE_SCHOOL_H
