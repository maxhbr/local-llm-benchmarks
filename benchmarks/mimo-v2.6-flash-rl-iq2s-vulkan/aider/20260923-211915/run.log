class ConnectGame:
    def __init__(self, board):
        # board is expected to be a list of strings representing rows
        self.board = board
        self.rows = len(board)
        self.cols = max((len(row) for row in board), default=0)
        # Build a mapping of cell positions to player
        self.cells = {}
        for r, row in enumerate(board):
            for c, ch in enumerate(row):
                if ch in ('O', 'X'):
                    self.cells[(r, c)] = ch

        # Determine leftmost and rightmost column indices among cells
        if self.cells:
            self.min_col = min(c for (_, c) in self.cells)
            self.max_col = max(c for (_, c) in self.cells)
        else:
            self.min_col = self.max_col = 0

    def get_winner(self):
        # Check for O connecting top to bottom
        if self._check_player('O', start_rows={0}, goal_rows={self.rows - 1}):
            return 'O'
        # Check for X connecting left to right
        if self._check_player('X', start_cols={self.min_col}, goal_cols={self.max_col}):
            return 'X'
        return None

    def _check_player(self, player, start_rows=None, goal_rows=None, start_cols=None, goal_cols=None):
        # Determine starting cells
        starts = []
        if start_rows is not None:
            for r in start_rows:
                for (rr, cc), p in self.cells.items():
                    if rr == r and p == player:
                        starts.append((rr, cc))
        if start_cols is not None:
            for c in start_cols:
                for (rr, cc), p in self.cells.items():
                    if cc == c and p == player:
                        starts.append((rr, cc))
        if not starts:
            return False

        # Determine goal cells
        goals = set()
        if goal_rows is not None:
            for r in goal_rows:
                for (rr, cc), p in self.cells.items():
                    if rr == r and p == player:
                        goals.add((rr, cc))
        if goal_cols is not None:
            for c in goal_cols:
                for (rr, cc), p in self.cells.items():
                    if cc == c and p == player:
                        goals.add((rr, cc))
        if not goals:
            return False

        # BFS
        visited = set()
        queue = list(starts)
        for s in starts:
            visited.add(s)
        while queue:
            r, c = queue.pop(0)
            if (r, c) in goals:
                return True
            # Neighbors in hex grid with offset rows
            neighbors = [
                (r, c - 1), (r, c + 1),
                (r - 1, c - 1), (r - 1, c),
                (r + 1, c), (r + 1, c + 1)
            ]
            for nr, nc in neighbors:
                if (nr, nc) in self.cells and self.cells[(nr, nc)] == player and (nr, nc) not in visited:
                    visited.add((nr, nc))
                    queue.append((nr, nc))
        return False
```
