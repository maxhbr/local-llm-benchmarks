public class SgfParsing {
    public SgfNode parse(String input) throws SgfParsingException {
        if (input == null || input.isEmpty()) {
            throw new SgfParsingException("Input string is empty or null");
        }
        Parser parser = new Parser(input);
        return parser.parseGameTree();
    }

    private static class Parser {
        private final String input;
        private int pos;

        Parser(String input) {
            this.input = input;
            this.pos = 0;
        }

        SgfNode parseGameTree() throws SgfParsingException {
            expect('(');
            SgfNode root = parseSequence();
            while (peek() == '(') {
                SgfNode child = parseGameTree();
                root.addChild(child);
            }
            expect(')');
            return root;
        }

        private SgfNode parseSequence() throws SgfParsingException {
            SgfNode first = parseNode();
            SgfNode current = first;
            while (peek() == ';') {
                SgfNode next = parseNode();
                current.addChild(next);
                current = next;
            }
            return first;
        }

        private SgfNode parseNode() throws SgfParsingException {
            expect(';');
            SgfNode node = new SgfNode();
            parsePropertyList(node);
            return node;
        }

        private void parsePropertyList(SgfNode node) throws SgfParsingException {
            while (pos < input.length() && Character.isUpperCase(input.charAt(pos))) {
                parseProperty(node);
            }
        }

        private void parseProperty(SgfNode node) throws SgfParsingException {
            StringBuilder keyBuilder = new StringBuilder();
            while (pos < input.length() && Character.isUpperCase(input.charAt(pos))) {
                keyBuilder.append(input.charAt(pos));
                pos++;
            }
            String key = keyBuilder.toString();
            if (key.isEmpty()) {
                throw new SgfParsingException("Expected property key at position " + pos);
            }
            java.util.List<String> values = new java.util.ArrayList<>();
            while (peek() == '[') {
                values.add(parseValue());
            }
            if (values.isEmpty()) {
                throw new SgfParsingException("Property '" + key + "' has no values");
            }
            for (String value : values) {
                node.addProperty(key, value);
            }
        }

        private String parseValue() throws SgfParsingException {
            expect('[');
            StringBuilder sb = new StringBuilder();
            while (pos < input.length() && input.charAt(pos) != ']') {
                char c = input.charAt(pos);
                if (c == '\\') {
                    pos++;
                    if (pos >= input.length()) {
                        throw new SgfParsingException("Unexpected end of input after backslash");
                    }
                    char next = input.charAt(pos);
                    if (next == '\n') {
                        // newline after backslash is removed
                        pos++;
                    } else if (Character.isWhitespace(next)) {
                        // whitespace other than newline after backslash becomes space
                        sb.append(' ');
                        pos++;
                    } else {
                        // non-whitespace after backslash is inserted as-is
                        sb.append(next);
                        pos++;
                    }
                } else if (c == '\n') {
                    sb.append('\n');
                    pos++;
                } else if (Character.isWhitespace(c)) {
                    sb.append(' ');
                    pos++;
                } else {
                    sb.append(c);
                    pos++;
                }
            }
            expect(']');
            return sb.toString();
        }

        private char peek() throws SgfParsingException {
            if (pos >= input.length()) {
                throw new SgfParsingException("Unexpected end of input");
            }
            return input.charAt(pos);
        }

        private void expect(char expected) throws SgfParsingException {
            if (pos >= input.length() || input.charAt(pos) != expected) {
                throw new SgfParsingException("Expected '" + expected + "' at position " + pos);
            }
            pos++;
        }
    }
}
