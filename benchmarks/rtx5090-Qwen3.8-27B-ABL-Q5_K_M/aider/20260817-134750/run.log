const SHARP: [&str; 12] = ["C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"];
const FLAT: [&str; 12] = ["C", "Db", "D", "Eb", "E", "F", "Gb", "G", "Ab", "A", "Bb", "B"];
fn scale(tonic: &str, intervals: &str) -> Vec<String> {
    let flat = matches!(tonic, "F" | "Bb" | ... | "d" | ...);
    let chromatic = if flat { FLAT } else { SHARP };
    let start = pitch(tonic);
    let mut notes = vec![tonic.to_uppercase()];
    let mut pitch = start;
    for interval in intervals.chars() {
       pitch = (pitch + semitones(interval)) % 12;
       notes.push(chromatic[pitch]);
    }
    notes.pop(); // remove final
    notes
}
```
