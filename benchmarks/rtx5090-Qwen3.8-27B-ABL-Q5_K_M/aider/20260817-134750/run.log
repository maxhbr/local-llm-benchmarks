pub struct Scale { notes: Vec<String> }

impl Scale {
    pub fn new(tonic: &str, intervals: &str) -> Result<Scale, Error> {
        let (tonic_pc, tonic_canonical, preference) = parse_tonic(tonic)?;
        let mut notes = vec![tonic_canonical.clone()];
        let mut pc = tonic_pc;
        for ch in intervals.chars() {
            let step = match ch { 'm' => 1, 'M' => 2, 'A' => 3, _ => return Err(Error) };
            pc = (pc + step) % 12;
            let note = if pc == tonic_pc { tonic_canonical.clone() } else { preferred_note(pc, preference, tonic_case) };
            notes.push(note);
        }
        Ok(Scale { notes })
    }
    pub fn chromatic(tonic: &str) -> Result<Scale, Error> {
        let mut intervals = String::new();
        for _ in 0..11 { intervals.push('m'); }
        Self::new(tonic, &intervals)
    }
    pub fn enumerate(&self) -> Vec<String> { self.notes.clone() }
}
```
