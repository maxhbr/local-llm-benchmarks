Exercism Bookstore known optimal algorithm:
```
fn lowest_price(books: &[u32]) -> u32 {
    let mut counts = [0;5];
    for &b in books { counts[(b-1) as usize] += 1; }
    counts.sort_unstable_by(|a,b| b.cmp(a));
    let mut price = 0;
    while counts.iter().any(|&c| c > 0) {
        let mut group_size = 0;
        for c in counts.iter_mut() {
            if *c > 0 { *c -= 1; group_size += 1; }
        }
        price += discount(group_size);
    }
    price
}
```
