robot_simulator.go
```
package robot

import "fmt"

const (
	N Dir = iota
	E
	S
	W
)

func (r *Robot) Right() {
	r.Dir = (r.Dir + 1) % 4
}

func (r *Robot) Left() {
	r.Dir = (r.Dir + 3) % 4
}

func (r *Robot) Advance() {
	switch r.Dir {
	case N:
		r.Pos[1]++
	case E:
		r.Pos[0]++
	case S:
		r.Pos[1]--
	case W:
		r.Pos[0]--
	}
}

func (d Dir) String() string {
	switch d {
	case N:
		return "north"
	case E:
		return "east"
	case S:
		return "south"
	case W:
		return "west"
	}
	return "unknown"
}

type Action struct {
	Command Command
}

func StartRobot(command chan Command, action chan Action) {
	for cmd := range command {
		action <- Action{Command: cmd}
	}
	close(action)
}

func inExtent(extent Rect, p [2]int) bool {
	minX, maxX := extent[0][0], extent[1][0]
	if minX > maxX {
		minX, maxX = maxX, minX
	}
	minY, maxY := extent[0][1], extent[1][1]
	if minY > maxY {
		minY, maxY = maxY, minY
	}
	return p[0] >= minX && p[0] <= maxX && p[1] >= minY && p[1] <= maxY
}

func Room(extent Rect, robot Step2Robot, action chan Action, report chan Step2Robot) {
	state := robot
	for act := range action {
		if !inExtent(extent, state.Pos) {
			continue
		}

		switch string(act.Command) {
		case "R":
			state.Dir = (state.Dir + 1) % 4
		case "L":
			state.Dir = (state.Dir + 3) % 4
		case "A":
			newPos := state.Pos
			switch state.Dir {
			case N:
				newPos[1]++
			case E:
				newPos[0]++
			case S:
				newPos[1]--
			case W:
				newPos[0]--
			}
			if inExtent(extent, newPos) {
				state.Pos = newPos
			}
		}
	}
	report <- state
}

type Action3 struct {
	RobotName string
	Command    Command
}

const robotShutdownPrefix = "\x00"

func StartRobot3(name, script string, action chan Action3, log chan string) {
	for _, c := range script {
		action <- Action3{
			RobotName: name,
			Command:    Command(string(c)),
		}
	}
	action <- Action3{
		RobotName: robotShutdownPrefix + name,
	}
}

func Room3(extent Rect, robots []Step3Robot, action chan Action3, rep chan []Step3Robot, log chan string) {
	nameCount := make(map[string]int)
	posCount := make(map[[2]int]int)
	for _, r := range robots {
		nameCount[r.Name]++
		posCount[r.Pos]++
	}

	emptyNameLogged := false
	dupNameLogged := make(map[string]bool)
	samePosLogged := make(map[[2]int]bool)

	for _, r := range robots {
		if r.Name == "" {
			if !emptyNameLogged {
				log <- "Robot without a name"
				emptyNameLogged = true
			}
		}
		if r.Name != "" && nameCount[r.Name] > 1 && !dupNameLogged[r.Name] {
			log <- fmt.Sprintf("Duplicate robot name: %s", r.Name)
			dupNameLogged[r.Name] = true
		}
		if !inExtent(extent, r.Pos) {
			log <- fmt.Sprintf("Robot %s: placed outside of the room", r.Name)
		}
		if posCount[r.Pos] > 1 && !samePosLogged[r.Pos] {
			log <- fmt.Sprintf("Robots placed at the same place: %v", r.Pos)
			samePosLogged[r.Pos] = true
		}
	}

	active := make([]bool, len(robots))
	nameIndex := make(map[string]int)
	knownNames := make(map[string]bool)
	for i, r := range robots {
		knownNames[r.Name] = true
		if r.Name != "" && nameCount[r.Name] == 1 && inExtent(extent, r.Pos) {
			active[i] = true
			if _, ok := nameIndex[r.Name]; !ok {
				nameIndex[r.Name] = i
			}
		}
	}

	shutdownRemaining := make(map[string]int)
	for _, r := range robots {
		shutdownRemaining[r.Name]++
	}
	totalExpected := len(robots)
	totalDone := 0
	reported := false

	sendReport := func() {
		if !reported {
			reported = true
			rep <- robots
		}
	}

	if totalExpected == 0 {
		sendReport()
		return
	}

	for act := range action {
		if reported {
			continue
		}

		if len(act.RobotName) > 0 && act.RobotName[0] == 0 {
			name := act.RobotName[1:]
			if remaining, ok := shutdownRemaining[name]; ok && remaining > 0 {
				shutdownRemaining[name]--
				totalDone++
				if totalDone == totalExpected {
					sendReport()
					return
				}
			}
			continue
		}

		idx, ok := nameIndex[act.RobotName]
		if !ok || !active[idx] {
			if !knownNames[act.RobotName] {
				log <- fmt.Sprintf("Action from unknown robot: %s", act.RobotName)
			}
			continue
		}

		cmd := string(act.Command)
		switch cmd {
		case "R":
			robots[idx].Dir = (robots[idx].Dir + 1) % 4
		case "L":
			robots[idx].Dir = (robots[idx].Dir + 3) % 4
		case "A":
			newPos := robots[idx].Pos
			switch robots[idx].Dir {
			case N:
				newPos[1]++
			case E:
				newPos[0]++
			case S:
				newPos[1]--
			case W:
				newPos[0]--
			}
			if !inExtent(extent, newPos) {
				log <- fmt.Sprintf("Robot %s: attempted to advance into a wall", act.RobotName)
				break
			}
			collides := false
			for j, other := range robots {
				if j != idx && active[j] && other.Pos == newPos {
					collides = true
					break
				}
			}
			if collides {
				log <- fmt.Sprintf("Robot %s: attempted to advance into another robot", act.RobotName)
				break
			}
			robots[idx].Pos = newPos
		default:
			log <- fmt.Sprintf("Robot %s: undefined command %q", act.RobotName, cmd)
		}
	}

	if !reported {
		sendReport()
	}
}
```
