```
fn preference(tonic: &str) -> Preference {
    match tonic {
        "C" | "a" => Natural,
        "G" | "D" | "A" | "E" | "B" | "F#" | "e" | "b" | "f#" | "c#" | "g#" | "d#" => Sharp,
        "F" | "Bb" | "Eb" | "Ab" | "Db" | "Gb" | "d" | "g" | "c" | "f" | "bb" | "eb" => Flat,
        _ => {
            if tonic.contains('#') { Sharp }
            else if tonic.contains('b') { Flat }
            else {
                match tonic {
                    "C" => Natural,
                    "G" | "D" | "A" | "E" | "B" => Sharp,
                    "F" => Flat,
                    "g" | "d" | "c" | "f" => Flat,
                    "e" | "b" => Sharp,
                    "a" => Natural,
                    _ => Sharp,
                }
            }
        }
    }
}
```
