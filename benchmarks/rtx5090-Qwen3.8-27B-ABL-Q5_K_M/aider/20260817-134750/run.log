`preferred_note(pc: u8, preference: Preference, lowercase: bool) -> String`:
```
fn preferred_note(pc: u8, pref: Preference, lowercase: bool) -> String {
    let (letter, accidental) = match (pc, pref) {
        (0, _) => ('C', None),
        (1, Preference::Flat) => ('D', Some('b')),
        (1, _) => ('C', Some('#')),
        (2, _) => ('D', None),
        (3, Preference::Flat) => ('E', Some('b')),
        (3, _) => ('D', Some('#')),
        (4, _) => ('E', None),
        (5, _) => ('F', None),
        (6, Preference::Flat) => ('G', Some('b')),
        (6, _) => ('F', Some('#')),
        (7, _) => ('G', None),
        (8, Preference::Flat) => ('A', Some('b')),
        (8, _) => ('G', Some('#')),
        (9, _) => ('A', None),
        (10, Preference::Flat) => ('B', Some('b')),
        (10, _) => ('A', Some('#')),
        (11, _) => ('B', None),
    };
    let mut s = String::new();
    let mut c = letter;
    if lowercase { c = c.to_ascii_lowercase(); }
    s.push(c);
    if let Some(a) = accidental { s.push(a); }
    s
}
```
