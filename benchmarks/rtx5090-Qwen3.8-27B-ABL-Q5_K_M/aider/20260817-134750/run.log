class PigLatinTranslator {
    public String translate(String word) {
        if (word == null) {
            return null;
        }
        if (word.indexOf(' ') >= 0) {
            String[] parts = word.split(" ", -1);
            StringBuilder result = new StringBuilder();
            for (int i = 0; i < parts.length; i++) {
                if (i > 0) {
                    result.append(' ');
                }
                result.append(translateWord(parts[i]));
            }
            return result.toString();
        }
        return translateWord(word);
    }

    private String translateWord(String word) {
        if (word == null || word.isEmpty()) {
            return "";
        }
        String lower = word.toLowerCase(java.util.Locale.ROOT);
        if (isVowel(lower.charAt(0)) || lower.startsWith("xr") || lower.startsWith("yt")) {
            return word + "ay";
        }
        int quIndex = lower.indexOf("qu");
        if (quIndex >= 0 && isAllConsonants(lower, 0, quIndex)) {
            String prefix = word.substring(0, quIndex + 2);
            String remainder = word.substring(quIndex + 2);
            return remainder + prefix + "ay";
        }
        int yIndex = lower.indexOf('y');
        if (yIndex > 0 && isAllConsonants(lower, 0, yIndex)) {
            String prefix = word.substring(0, yIndex);
            String remainder = word.substring(yIndex);
            return remainder + prefix + "ay";
        }
        int consonantEnd = 0;
        while (consonantEnd < word.length() && !isVowel(lower.charAt(consonantEnd))) {
            consonantEnd++;
        }
        String prefix = word.substring(0, consonantEnd);
        String remainder = word.substring(consonantEnd);
        return remainder + prefix + "ay";
    }

    private boolean isVowel(char c) {
        return c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u';
    }

    private boolean isAllConsonants(String lower, int start, int end) {
        for (int i = start; i < end; i++) {
            if (isVowel(lower.charAt(i))) {
                return false;
            }
        }
        return true;
    }
}

