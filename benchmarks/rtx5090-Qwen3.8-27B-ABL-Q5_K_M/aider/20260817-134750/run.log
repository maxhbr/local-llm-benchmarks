#include "grade_school.h"

namespace grade_school {

bool School::add(const std::string& name, int grade) {
    for (const auto& [g, names] : students_) {
        if (names.count(name)) {
            return false;
        }
    }
    students_[grade].insert(name);
    return true;
}

std::vector<std::string> School::grade(int g) const {
    auto it = students_.find(g);
    if (it == students_.end()) {
        return {};
    }
    return std::vector<std::string>(it->second.begin(), it->second.end());
}

std::vector<std::string> School::sort() const {
    std::vector<std::string> result;
    for (const auto& [g, names] : students_) {
        for (const auto& name : names) {
            result.push_back(name);
        }
    }
    return result;
}

}  // namespace grade_school
```

This looks correct. The `std::map` iterates in key order (grade number), and `std::set` iterates in alphabetical order. The `add` function checks all grades for 
