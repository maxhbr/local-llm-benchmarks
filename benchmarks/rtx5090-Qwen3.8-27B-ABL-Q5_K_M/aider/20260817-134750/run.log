package robot

import "fmt"

const (
        N Dir = iota
        E
        S
        W
)

type Robot struct {
        Pos Pos
        Dir Dir
}

func (r *Robot) Right() {
        r.Dir = (r.Dir + 1) % 4
}

func (r *Robot) Left() {
        r.Dir = (r.Dir + 3) % 4
}

func (r *Robot) Advance() {
        switch r.Dir {
        case N:
                r.Pos.Y++
        case E:
                r.Pos.X++
        case S:
                r.Pos.Y--
        case W:
                r.Pos.X--
        }
}

func (d Dir) String() string {
        switch d {
        case N:
                return "north"
        case E:
                return "east"
        case S:
                return "south"
        case W:
                return "west"
        }
        return "unknown"
}

type Action struct {
        Command Command
}

