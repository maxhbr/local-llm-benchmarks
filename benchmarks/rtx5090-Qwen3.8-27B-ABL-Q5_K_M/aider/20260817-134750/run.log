package matrix

import (
	"fmt"
	"strconv"
	"strings"
)

type matrixData struct {
	grid [][]int
}

// Matrix represents a two-dimensional grid of integers.
type Matrix *matrixData

// New parses a string of newline- and space-separated integers into a Matrix.
func New(s string) (Matrix, error) {
	var grid [][]int
	lines := strings.Split(s, "\n")
	for _, line := range lines {
		fields := strings.Fields(line)
		if len(fields) == 0 {
			continue
		}
		row := make([]int, len(fields))
		for i, f := range fields {
			val, err := strconv.Atoi(f)
			if err != nil {
				return nil, fmt.Errorf("invalid number: %q", f)
			}
			row[i] = val
		}
		grid = append(grid, row)
	}
	return &matrixData{grid: grid}, nil
}

// Cols returns the columns of the matrix, reading each column top-to-bottom
// while moving left-to-right.
func (m Matrix) Cols() [][]int {
	if m == nil || len(m.grid) == 0 {
		return nil
	}
	rows := len(m.grid)
	cols := len(m.grid[0])
	result := make([][]int, cols)
	for c := 0; c < cols; c++ {
		result[c] = make([]int, rows)
		for r := 0; r < rows; r++ {
			result[c][r] = m.grid[r][c]
		}
	}
	return result
}

// Rows returns the rows of the matrix, reading each row left-to-right
// while moving top-to-bottom.
func (m Matrix) Rows() [][]int {
	if m == nil {
		return nil
	}
	return m.grid
}

// Set sets the value at the given zero-based row and column.
// It returns true on success, false if the coordinates are out of bounds.
func (m Matrix) Set(row, col, val int) bool {
	if m == nil || row < 0 || row >= len(m.grid) || col < 0 || col >= len(m.grid[row]) {
		return false
	}
	m.grid[row][col] = val
	return true
}
```
