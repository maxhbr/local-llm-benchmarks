Let's design final code.

```
from json import dumps


class Tree:
    def __init__(self, label, children=None):
        self.label = label
        self.children = children if children is not None else []

    def __dict__(self):
        return {self.label: [c.__dict__() for c in sorted(self.children)]}

    def __str__(self, indent=None):
        return dumps(self.__dict__(), indent=indent)

    def __lt__(self, other):
        return self.label < other.label

    def __eq__(self, other):
        return self.__dict__() == other.__dict__()

    def _find_path_nodes(self, target):
        if self.label == target:
            return [self]
        for child in self.children:
            path = child._find_path_nodes(target)
            if path is not None:
                return [self] + path
        return None

    def _copy_subtree(self, node):
        return Tree(node.label, [self._copy_subtree(child) for child in node.children])

    def from_pov(self, from_node):
        path = self._find_path_nodes(from_node)
        if path is None:
            raise ValueError(f"Cannot reorient: {from_node} is missing")

        def build_path_node(index):
            node = path[index]
            next_node = path[index + 1] if index + 1 < len(path) else None
            children = [
                self._copy_subtree(child)
                for child in node.children
                if child is not next_node
            ]
            if index > 0:
                children.append(build_path_node(index - 1))
            return Tree(node.label, children)

        return build_path_node(len(path) - 1)

    def path_to(self, from_node, to_node):
        source_path = self._find_path_nodes(from_node)
        if source_path is None:
            raise ValueError(f"Cannot find path: {from_node} is missing")
        destination_path = self._find_path_nodes(to_node)
        if destination_path is None:
            raise ValueError(f"Cannot find path: {to_node} is missing")

        # find last common ancestor by identity
        lca_index = 0
        while (
            lca_index < len(source_path)
            and lca_index < len(destination_path)
            and source_path[lca_index] is destination_path[lca_index]
        ):
            lca_index += 1
        lca_index -= 1

        if lca_index < 0:
            raise ValueError(f"Cannot find path: {from_node} to {to_node}")

        return [node.label for node in reversed(source_path[lca_index:])] + [
            node.label for node in destination_path[lca_index + 1:]
        ]
```

