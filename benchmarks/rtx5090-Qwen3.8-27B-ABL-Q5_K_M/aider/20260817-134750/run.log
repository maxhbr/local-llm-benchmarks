```
#[derive(Debug)]
pub struct Error;

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
enum Preference { Sharp, Flat, Natural }

#[derive(Debug)]
pub struct Scale { notes: Vec<String> }

impl Scale {
    pub fn new(tonic: &str, intervals: &str) -> Result<Scale, Error> {
        let (tonic_pc, tonic_canonical, preference, lowercase) = parse_tonic(tonic)?;
        let mut notes = vec![tonic_canonical.clone()];
        let mut pc = tonic_pc;
        for ch in intervals.chars() {
            let step = match ch {
                'm' => 1,
                'M' => 2,
                'A' => 3,
                _ => return Err(Error),
            };
            pc = (pc + step) % 12;
            let note = if pc == tonic_pc {
                tonic_canonical.clone()
            } else {
                preferred_note(pc, preference, lowercase)
            };
            notes.push(note);
        }
        Ok(Scale { notes })
    }

    pub fn chromatic(tonic: &str) -> Result<Scale, Error> {
        let mut intervals = String::new();
        for _ in 0..11 {
            intervals.push('m');
        }
        Self::new(tonic, &intervals)
    }

    pub fn enumerate(&self) -> Vec<String> {
        self.notes.clone()
    }
}

fn parse_tonic(tonic: &str) -> Result<(u8, String, Preference, bool), Error> {
    let mut chars = tonic.chars();
    let letter = chars.next().ok_or(Error)?;
    let base = match letter.to_ascii_uppercase() {
        'C' => 0,
        'D' => 2,
        'E' => 4,
        'F' => 5,
        'G' => 7,
        'A' => 9,
        'B' => 11,
        _ => return Err(Error),
    };
    let mut pc = base;
    let mut canonical = String::new();
    canonical.push(letter);
    if let Some(acc) = chars.next() {
        match acc {
            '#' => {
                pc = (pc + 1) % 12;
                canonical.push('#');
            }
            'b' | 'B' => {
                pc = (pc + 11) % 12;
                canonical.push('b');
            }
            _ => return Err(Error),
        }
    }
    if chars.next().is_some() {
        return Err(Error);
    }
    let preference = preference_for(&canonical);
    let lowercase = letter.is_ascii_lowercase();
    Ok((pc, canonical, preference, lowercase))
}

fn preference_for(tonic: &str) -> Preference {
    match tonic {
        "C" | "a" => Preference::Natural,
        "G" | "D" | "A" | "E" | "B" | "F#" | "e" | "b" | "f#" | "c#" | "g#" | "d#" => Preference::Sharp,
        "F" | "Bb" | "Eb" | "Ab" | "Db" | "Gb" | "d" | "g" | "c" | "f" | "bb" | "eb" => Preference::Flat,
        _ => {
            if tonic.ends_with('#') {
                Preference::Sharp
            } else if tonic.ends_with('b') {
                Preference::Flat
            } else {
                Preference::Sharp
            }
        }
    }
}

fn preferred_note(pc: u8, preference: Preference, lowercase: bool) -> String {
    let (letter, accidental) = match (pc, preference) {
        (0, _) => ('C', None),
        (1, Preference::Flat) => ('D', Some('b')),
        (1, _) => ('C', Some('#')),
        (2, _) => ('D', None),
        (3, Preference::Flat) => ('E', Some('b')),
        (3, _) => ('D', Some('#')),
        (4, _) => ('E', None),
        (5, _) => ('F', None),
        (6, Preference::Flat) => ('G', Some('b')),
        (6, _) => ('F', Some('#')),
        (7, _) => ('G', None),
        (8, Preference::Flat) => ('A', Some('b')),
        (8, _) => ('G', Some('#')),
        (9, _) => ('A', None),
        (10, Preference::Flat) => ('B', Some('b')),
        (10, _) => ('A', Some('#')),
        (11, _) => ('B', None),
    };
    let mut note = String::new();
    let mut c = letter;
    if lowercase {
        c = c.to_ascii_lowercase();
    }
    note.push(c);
    if let Some(acc) = accidental {
        note.push(acc);
    }
    note
}
```

