export const answer = (question) => {
  if (!question.startsWith('What is ') || !question.endsWith('?')) {
    throw new Error('Invalid question');
  }

  const expr = question.slice('What is '.length, -1);

  const fullPattern = /^-?\d+( (plus|minus|multiplied by|divided by) -?\d+)*$/;
  if (!fullPattern.test(expr)) {
    throw new Error('Invalid question');
  }

  const tokens = expr.match(/-?\d+|plus|minus|multiplied by|divided by/g);

  let result = parseInt(tokens[0], 10);
  for (let i = 1; i < tokens.length; i += 2) {
    const op = tokens[i];
    const num = parseInt(tokens[i + 1], 10);
    switch (op) {
      case 'plus': result += num; break;
      case 'minus': result -= num; break;
      case 'multiplied by': result *= num; break;
      case 'divided by': result /= num; break;
    }
  }

  return result;
};
