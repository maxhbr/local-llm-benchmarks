Code:

func Room3(extent Rect, robots []Step3Robot, action chan Action3, rep chan []Step3Robot, log chan string) {
    nameCount := make(map[string]int)
    posCount := make(map[[2]int]int)
    for _, r := range robots {
        nameCount[r.Name]++
        posCount[r.Pos]++
    }

    emptyNameLogged := false
    dupNameLogged := make(map[string]bool)
    samePosLogged := make(map[[2]int]bool)

    for _, r := range robots {
        if r.Name == "" {
            if !emptyNameLogged {
                log <- "Robot without a name"
                emptyNameLogged = true
            }
        }
        if r.Name != "" && nameCount[r.Name] > 1 && !dupNameLogged[r.Name] {
            log <- fmt.Sprintf("Duplicate robot name: %s", r.Name)
            dupNameLogged[r.Name] = true
        }
        if !inExtent(extent, r.Pos) {
            log <- fmt.Sprintf("Robot %s: placed outside of the room", r.Name)
        }
        if posCount[r.Pos] > 1 && !samePosLogged[r.Pos] {
            log <- fmt.Sprintf("Robots placed at the same place: %v", r.Pos)
            samePosLogged[r.Pos] = true
        }
    }

    active := make([]bool, len(robots))
    nameIndex := make(map[string]int)
    knownNames := make(map[string]bool)
    for i, r := range robots {
        knownNames[r.Name] = true
        if r.Name != "" && nameCount[r.Name] == 1 && inExtent(extent, r.Pos) {
            active[i] = true
            if _, ok := nameIndex[r.Name]; !ok {
                nameIndex[r.Name] = i
            }
        }
    }

    shutdownRemaining := make(map[string]int)
    for _, r := range robots {
        shutdownRemaining[r.Name]++
    }
    totalExpected := len(robots)
    totalDone := 0
    reported := false

    sendReport := func() {
        if !reported {
            reported = true
            rep <- robots
            close(rep)
        }
    }

    if totalExpected == 0 {
        sendReport()
        // Consume any stray actions so senders do not block, then exit.
        for range action {
        }
        return
    }

    for act := range action {
        if reported {
            continue
        }

        if len(act.RobotName) > 0 && act.RobotName[0] == 0 {
            name := act.RobotName[1:]
            if remaining, ok := shutdownRemaining[name]; ok && remaining > 0 {
                shutdownRemaining[name]--
                totalDone++
                if totalDone == totalExpected {
                    sendReport()
                }
            }
            continue
        }

        idx, ok := nameIndex[act.RobotName]
        if !ok || !active[idx] {
            if !knownNames[act.RobotName] {
                log <- fmt.Sprintf("Action from unknown robot: %s", act.RobotName)
            }
            continue
        }

        cmd := string(act.Command)
        switch cmd {
        case "R":
            robots[idx].Dir = (robots[idx].Dir + 1) % 4
        case "L":
            robots[idx].Dir = (robots[idx].Dir + 3) % 4
        case "A":
            newPos := robots[idx].Pos
            switch robots[idx].Dir {
            case N:
                newPos[1]++
            case E:
                newPos[0]++
            case S:
                newPos[1]--
            case W:
                newPos[0]--
            }
            if !inExtent(extent, newPos) {
                log <- fmt.Sprintf("Robot %s: attempted to advance into a wall", act.RobotName)
                break
            }
            collides := false
            for j, other := range robots {
                if j != idx && active[j] && other.Pos == newPos {
                    collides = true
                    break
                }
            }
            if collides {
                log <- fmt.Sprintf("Robot %s: attempted to advance into another robot", act.RobotName)
                break
            }
            robots[idx].Pos = newPos
        default:
            log <- fmt.Sprintf("Robot %s: undefined command %q", act.RobotName, cmd)
        }
    }

    if !reported {
        sendReport()
    }
}

