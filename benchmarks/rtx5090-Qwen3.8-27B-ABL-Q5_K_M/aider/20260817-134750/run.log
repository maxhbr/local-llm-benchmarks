Now, code structure:
```
#[derive(Debug)]
pub struct Error;

pub struct Scale { notes: Vec<String> }

impl Scale {
    pub fn new(tonic: &str, intervals: &str) -> Result<Scale, Error> {
        let start = parse_pitch(tonic).ok_or(Error)?;
        let flat = uses_flats(tonic);
        let chromatic = if flat { FLAT } else { SHARP };
        let mut notes = vec![chromatic[start].to_string()];
        let mut pitch = start;
        for ch in intervals.chars() {
            let step = match ch { 'm'=>1, 'M'=>2, 'A'=>3, _=>return Err(Error) };
            pitch = (pitch as u16 + step).rem_euclid(12) as u8;
            notes.push(chromatic[pitch].to_string());
        }
        if notes.len() > 1 && pitch == start { notes.pop(); }
        Ok(Scale { notes })
    }
    pub fn chromatic(tonic: &str) -> Result<Scale,  Error> {
        let start = parse_pitch(tonic).ok_or(Error)?;
        let flat = uses_flats(tonic);
        let chromatic = if flat { FLAT } else { SHARP };
        let notes = (0..12).map(|i| chromatic[(start + i) % 12].to_string()).collect();
        Ok(Scale { notes })
    }
    pub fn enumerate(&self) -> Vec<String> { self.notes.clone() }
}
```
