BuildTree.java
```
import java.util.ArrayList;

class BuildTree {

    TreeNode buildTree(ArrayList<Record> records) throws InvalidRecordsException {
        if (records.isEmpty()) {
            return null;
        }

        int size = records.size();
        TreeNode[] nodes = new TreeNode[size];
        int[] parentIds = new int[size];

        for (Record record : records) {
            int recordId = record.getRecordId();
            int parentId = record.getParentId();

            if (recordId < 0 || recordId >= size) {
                throw new InvalidRecordsException("Invalid Records");
            }

            if (recordId == 0) {
                if (parentId != 0) {
                    throw new InvalidRecordsException("Invalid Records");
                }
            } else {
                if (parentId < 0 || parentId >= recordId) {
                    throw new InvalidRecordsException("Invalid Records");
                }
            }

            if (nodes[recordId] != null) {
                throw new InvalidRecordsException("Invalid Records");
            }

            nodes[recordId] = new TreeNode(recordId);
            parentIds[recordId] = parentId;
        }

        for (int i = 0; i < size; i++) {
            if (nodes[i] == null) {
                throw new InvalidRecordsException("Invalid Records");
            }
        }

        for (int recordId = 1; recordId < size; recordId++) {
            nodes[parentIds[recordId]].getChildren().add(nodes[recordId]);
        }

        return nodes[0];
    }

}
