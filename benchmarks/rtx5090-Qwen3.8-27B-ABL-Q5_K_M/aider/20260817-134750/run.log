    cmd := string(act.Command)
    switch cmd {
    case "R":
        robots[idx].Dir = (robots[idx].Dir + 1) % 4
    case "L":
        robots[idx].Dir = (robots[idx].Dir + 3) % 4
    case "A":
        newPos := robots[idx].Pos
