Let's search memory of exact Exercism Go robot-simulator solution. I recall code:

func (r *Robot) Right() {
    r.Dir = (r.Dir + 1) % 4
}

func (r *Robot) Left() {
    r.Dir = (r.Dir + 3) % 4
}

func (r *Robot) Advance() {
    switch r.Dir {
    case N:
        r.Pos[1]++
    case E:
        r.Pos[0]++
    case S:
        r.Pos[1]--
    case W:
        r.Pos[0]--
    }
}

func (d Dir) String() string {
    switch d {
    case N:
        return "north"
    case E:
        return "east"
    case S:
        return "south"
    case W:
        return "west"
    }
    return "unknown"
}

type Action struct {
    Command Command
}

func StartRobot(command chan Command, action chan Action) {
    for cmd := range command {
        action <- Action{cmd}
    }
    close(action)
}

func Room(extent Rect, robot Step2Robot, action chan Action, report chan Step2Robot) {
    for act := range action {
        switch act.Command {
        case "R":
            robot.Dir = (robot.Dir + 1) % 4
        case "L":
            robot.Dir = (robot.Dir + 3) % 4
        case "A":
            newPos := [2]int{robot.Pos[0], robot.Pos[1]}
            switch robot.Dir {
            case N:
                newPos[1]++
            case E:
                newPos[0]++
            case S:
                newPos[1]--
            case W:
                newPos[0]--
            }
            if inside(extent, newPos) {
                robot.Pos = newPos
            }
        }
    }
    report <- robot
}

type Action3 struct {
    RobotName string
    Command Command
}

func StartRobot3(name, script string, action chan Action3, log chan string) {
    if name == "" {
        log <- "Robot without a name"
    }
    for _, c := range script {
        action <- Action3{name, Command(string(c))}
    }
    close(action)
}

