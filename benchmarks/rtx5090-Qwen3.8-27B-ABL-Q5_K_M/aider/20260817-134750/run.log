```python
def transpose(text):
    lines = text.split('\n')
    if not lines:
        return ''
    max_len = max(len(line) for line in lines)
    result = []
    for j in range(max_len):
        col = ''
        for line in lines:
            if j < len(line):
                col += line[j]
            else:
                col += ' '
        result.append(col.rstrip())
    return '\n'.join(result)
```

