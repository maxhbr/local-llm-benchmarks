```python
def transpose(text):
    lines = text.split('\n')
    if not lines:
        return ''
    max_len = max(len(line) for line in lines)
    if max_len == 0:
        return ''
    result = []
    for j in range(max_len):
        col = []
        for line in lines:
            if j < len(line):
                col.append(line[j])
            else:
                col.append(' ')
        # Strip trailing spaces that are padding
        # A trailing space is padding if the corresponding row is shorter than j+1
        i = len(col) - 1
        while i >= 0 and col[i] == ' ' and j >= len(lines[i]):
            i -= 1
        result.append(''.join(col[:i+1]))
    return '\n'.join(result)
```

