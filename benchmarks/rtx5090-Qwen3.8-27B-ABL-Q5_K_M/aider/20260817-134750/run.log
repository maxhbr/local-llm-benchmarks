Pseudo:
```
import java.util.*;

class OpticalCharacterReader {
    private static final String[][] DIGITS = {
        {" _ ", "| |", "|_|", "   "},
        {"   ", "  |", "  |", "   "},
        {" _ ", " _|", "|_ ", "   "},
        {" _ ", " _|", " _|", "   "},
        {"   ", "|_|", "  |", "   "},
        {" _ ", "|_ ", " _|", "   "},
        {" _ ", "|_ ", "|_|", "   "},
        {" _ ", "  |", "  |", "   "},
        {" _ ", "|_|", "|_|", "   "},
        {" _ ", "|_|", " _|", "   "}
    };

    String parse(List<String> input) {
        if (input.isEmpty()) return "";
        if (input.size() % 4 != 0) throw new IllegalArgumentException("Invalid input size");
        List<String> numbers = new ArrayList<>();
        for (int start=0; start<input.size(); start+=4) {
            String[] lines = new String[4];
            int width = -1;
            for (int r=0; r<4; r++) {
                String line = input.get(start+r);
                if (line.length() % 3 != 0) throw new IllegalArgumentException("Invalid line length");
                if (width == -1) width = line.length();
                else if (line.length() != width) throw new IllegalArgumentException("Inconsistent line length");
                lines[r] = line;
            }
            if (width == 0) throw new IllegalArgumentException("Invalid input size");
            StringBuilder number = new StringBuilder();
            for (int col=0; col<width; col+=3) {
                String pattern = lines[0].substring(col, col+3)
                    + lines[1].substring(col, col+3)
                    + lines[2].substring(col, col+3)
                    + lines[3].substring(col, col+3);
                number.append(digitFor(pattern));
            }
            numbers.add(number.toString());
        }
        return String.join(",", numbers);
    }

    private String digitFor(String pattern) {
        for (int d=0; d<DIGITS.length; d++) {
            String expected = String.join("", DIGITS[d]);
            if (expected.equals(pattern)) return String.valueOf(d);
        }
        return "?";
    }
