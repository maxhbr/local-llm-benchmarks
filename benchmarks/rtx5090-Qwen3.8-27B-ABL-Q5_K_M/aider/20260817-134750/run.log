ChangeCalculator.java
```
import java.util.List;
import java.util.ArrayList;
import java.util.Arrays;

class ChangeCalculator {

    private final List<Integer> currencyCoins;

    ChangeCalculator(List<Integer> currencyCoins) {
        this.currencyCoins = currencyCoins;
    }

    List<Integer> computeMostEfficientChange(int grandTotal) {
        if (grandTotal < 0) {
            throw new IllegalArgumentException("Cannot make change for a negative amount");
        }

        int[] dp = new int[grandTotal + 1];
        Arrays.fill(dp, Integer.MAX_VALUE);
        dp[0] = 0;

        int[] lastCoin = new int[grandTotal + 1];
        Arrays.fill(lastCoin, -1);

        for (int i = 1; i <= grandTotal; i++) {
            for (int coin : currencyCoins) {
                if (coin <= i && dp[i - coin] != Integer.MAX_VALUE && dp[i - coin] + 1 < dp[i]) {
                    dp[i] = dp[i - coin] + 1;
                    lastCoin[i] = coin;
                }
            }
        }

        if (dp[grandTotal] == Integer.MAX_VALUE) {
            throw new IllegalArgumentException("Cannot make change for " + grandTotal);
        }

        List<Integer> result = new ArrayList<>();
        int remaining = grandTotal;
        while (remaining > 0) {
            int coin = lastCoin[remaining];
            result.add(coin);
            remaining -= coin;
        }

        return result;
    }

}
