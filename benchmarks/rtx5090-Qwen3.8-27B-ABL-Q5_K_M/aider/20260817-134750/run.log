func Room(extent Rect, robot Step2Robot, action chan Action, report chan Step2Robot) {
    state := robot
    for act := range action {
        switch string(act.Command) {
        case "R":
            state.Dir = (state.Dir + 1) % 4
        case "L":
            state.Dir = (state.Dir + 3) % 4
        case "A":
            newPos := state.Pos
            switch state.Dir {
            case N:
                newPos[1]++
            case E:
                newPos[0]++
            case S:
                newPos[1]--
            case W:
                newPos[0]--
            }
            if inExtent(extent, newPos) {
                state.Pos = newPos
            }
        }
    }
    report <- state
    close(report)
}

