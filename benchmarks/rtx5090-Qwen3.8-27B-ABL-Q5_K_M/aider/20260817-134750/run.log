                                newPos.Y++
                        case E:
                                newPos.X++
                        case S:
                                newPos.Y--
                        case W:
                                newPos.X--
                        }
                        if inExtent(extent, newPos) {
                                state.Pos = newPos
                        }
                }
        }
        report <- state
}

