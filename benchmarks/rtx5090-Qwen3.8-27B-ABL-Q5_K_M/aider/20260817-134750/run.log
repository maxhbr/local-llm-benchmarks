                break
            }
        }
        if collides {
            log <- fmt.Sprintf("Robot %s: attempted to advance into another robot", act.RobotName)
            break
        }
        robots[idx].Pos = newPos
    default:
        log <- fmt.Sprintf("Robot %s: undefined command %q", act.RobotName, cmd)
    }
}
