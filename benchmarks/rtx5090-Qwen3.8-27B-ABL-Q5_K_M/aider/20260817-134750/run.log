Alphametics.java
```
import java.util.*;

class Alphametics {

    private final List<String> addends;
    private final String result;
    private final List<Character> letters;
    private final Set<Character> leadingLetters;

    Alphametics(String userInput) {
        String[] sides = userInput.split(" == ");
        String left = sides[0].trim();
        String right = sides[1].trim();

        addends = Arrays.asList(left.split(" \\+ "));
        result = right;

        Set<Character> letterSet = new LinkedHashSet<>();
        for (String word : addends) {
            for (char c : word.toCharArray()) {
                letterSet.add(c);
            }
        }
        for (char c : result.toCharArray()) {
            letterSet.add(c);
        }
        letters = new ArrayList<>(letterSet);

        leadingLetters = new HashSet<>();
        for (String word : addends) {
            if (word.length() > 1) {
                leadingLetters.add(word.charAt(0));
            }
        }
        if (result.length() > 1) {
            leadingLetters.add(result.charAt(0));
        }
    }

    Map<Character, Integer> solve() throws UnsolvablePuzzleException {
        if (letters.size() > 10) {
            throw new UnsolvablePuzzleException();
        }

        int[] assignment = new int[letters.size()];
        Arrays.fill(assignment, -1);
        boolean[] used = new boolean[10];

        if (backtrack(0, assignment, used)) {
            Map<Character, Integer> solution = new HashMap<>();
            for (int i = 0; i < letters.size(); i++) {
                solution.put(letters.get(i), assignment[i]);
            }
            return solution;
        }

        throw new UnsolvablePuzzleException();
    }

    private boolean backtrack(int index, int[] assignment, boolean[] used) {
        if (index == letters.size()) {
            return verify(assignment);
        }

        char letter = letters.get(index);
        int start = leadingLetters.contains(letter) ? 1 : 0;

        for (int d = start; d <= 9; d++) {
            if (!used[d]) {
                used[d] = true;
                assignment[index] = d;
                if (backtrack(index + 1, assignment, used)) {
                    return true;
                }
                used[d] = false;
                assignment[index] = -1;
            }
        }
        return false;
    }

    private boolean verify(int[] assignment) {
        Map<Character, Integer> map = new HashMap<>();
        for (int i = 0; i < letters.size(); i++) {
            map.put(letters.get(i), assignment[i]);
        }

        long sum = 0;
        for (String word : addends) {
            sum += wordValue(word, map);
        }
        return sum == wordValue(result, map);
    }

    private long wordValue(String word, Map<Character, Integer> map) {
        long val = 0;
        for (char c : word.toCharArray()) {
            val = val * 10 + map.get(c);
        }
        return val;
    }
}
