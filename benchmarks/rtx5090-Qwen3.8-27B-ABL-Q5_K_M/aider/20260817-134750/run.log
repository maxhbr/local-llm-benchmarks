Let's craft code:
```
pub fn lowest_price(books: &[u32]) -> u32 {
    let mut counts = [0u64; 5];

    for &book in books {
        // The exercise uses book IDs 1..=5.
        if (1..=5).contains(&book) {
            counts[(book - 1) as usize] += 1;
        }
    }

    counts.sort_unstable_by(|a, b| b.cmp(a));

    let c1 = counts[0];
    let c2 = counts[1];
    let c3 = counts[2];
    let c4 = counts[3];
    let c5 = counts[4];

    let mut size_5 = c5;
    let mut size_4 = c4 - c5;
    let mut size_3 = c3 - c4;
    let size_2 = c2 - c3;
    let size_1 = c1 - c2;

    let swaps = size_5.min(size_3);
    size_5 -= swaps;
    size_3 -= swaps;
    size_4 += 2 * swaps;

    let price = size_1 * 800
        + size_2 * 1520
        + size_3 * 2160
        + size_4 * 2560
        + size_5 * 3000;

    price as u32
}
```

