Pseudo:

func Room3(extent Rect, robots []Step3Robot, action chan Action3, rep chan []Step3Robot, log chan string) {
    nameCount := make(map[string]int)
    for _, r := range robots { nameCount[r.Name]++ }
    posCount := make(map[[2]int]int)
    for _, r := range robots { posCount[r.Pos]++ }
    active := make([]bool, len(robots))
    nameIndex := make(map[string]int)
    for i, r := range robots {
        if r.Name == "" { log <- fmt.Sprintf("Robot without a name") }
        if nameCount[r.Name] > 1 { log <- fmt.Sprintf("Duplicate robot name: %s", r.Name) }
        if !inside(extent, r.Pos) { log <- fmt.Sprintf("Robot %s: placed outside of the room", r.Name) }
        if posCount[r.Pos] > 1 { log <- fmt.Sprintf("Robots placed at the same place: %v", r.Pos) }
        // active if name non-empty, unique, inside
        if r.Name != "" && nameCount[r.Name] == 1 && inside(extent, r.Pos) {
            active[i] = true
            if _, ok := nameIndex[r.Name]; !ok { nameIndex[r.Name] = i }
        }
    }

