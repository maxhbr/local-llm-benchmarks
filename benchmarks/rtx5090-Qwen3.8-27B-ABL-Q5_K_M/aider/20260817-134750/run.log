crypto_square.go
```
package cryptosquare

import (
	"math"
	"strings"
	"unicode"
)

func Encode(pt string) string {
	var normalized strings.Builder
	for _, ch := range pt {
		if unicode.IsLetter(ch) || unicode.IsDigit(ch) {
			normalized.WriteRune(unicode.ToLower(ch))
		}
	}
	norm := normalized.String()
	length := len(norm)

	if length == 0 {
		return ""
	}

	s := int(math.Ceil(math.Sqrt(float64(length))))
	var r, c int
	if s*(s-1) >= length {
		c = s
		r = s - 1
	} else {
		c = s
		r = s
	}

	padded := norm
	for len(padded) < r*c {
		padded += " "
	}

	var chunks []string
	for col := 0; col < c; col++ {
		var chunk strings.Builder
		for row := 0; row < r; row++ {
			chunk.WriteByte(padded[row*c+col])
		}
		chunks = append(chunks, chunk.String())
	}

	return strings.Join(chunks, " ")
}
```
