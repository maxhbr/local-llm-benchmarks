import java.util.ArrayList;
import java.util.List;

class OpticalCharacterReader {
    private static final String[][] DIGITS = {
        {" _ ", "| |", "|_|", "   "},
        {"   ", "  |", "  |", "   "},
        {" _ ", " _|", "|_ ", "   "},
        {" _ ", " _|", " _|", "   "},
        {"   ", "|_|", "  |", "   "},
        {" _ ", "|_ ", " _|", "   "},
        {" _ ", "|_ ", "|_|", "   "},
        {" _ ", "  |", "  |", "   "},
        {" _ ", "|_|", "|_|", "   "},
        {" _ ", "|_|", " _|", "   "}
    };

    String parse(List<String> input) {
        if (input == null) {
            throw new IllegalArgumentException("Input must not be null");
        }
        if (input.isEmpty()) {
            return "";
        }
        if (input.size() % 4 != 0) {
            throw new IllegalArgumentException("Input must contain a multiple of four lines");
        }

        List<String> numbers = new ArrayList<>();
        for (int start = 0; start < input.size(); start += 4) {
            String[] lines = new String[4];
            int width = -1;
            for (int row = 0; row < 4; row++) {
                String line = input.get(start + row);
                if (line == null) {
                    throw new IllegalArgumentException("Input lines must not be null");
                }
                if (line.length() % 3 != 0) {
                    throw new IllegalArgumentException("Each line must be a multiple of three characters wide");
                }
                if (width == -1) {
                    width = line.length();
                } else if (line.length() != width) {
                    throw new IllegalArgumentException("All lines in a number must have the same width");
                }
                lines[row] = line;
            }
            if (width == 0) {
                throw new IllegalArgumentException("Each number must be at least three characters wide");
            }

            StringBuilder number = new StringBuilder();
            for (int col = 0; col < width; col += 3) {
                String pattern = lines[0].substring(col, col + 3)
                        + lines[1].substring(col, col + 3)
                        + lines[2].substring(col, col + 3)
                        + lines[3].substring(col, col + 3);
                number.append(digitFor(pattern));
            }
            numbers.add(number.toString());
        }
        return String.join(",", numbers);
    }

    private String digitFor(String pattern) {
        for (int digit = 0; digit < DIGITS.length; digit++) {
            if (expectedPattern(digit).equals(pattern)) {
                return String.valueOf(digit);
            }
        }
        return "?";
    }

    private String expectedPattern(int digit) {
        StringBuilder pattern = new StringBuilder();
        for (String row : DIGITS[digit]) {
            pattern.append(row);
        }
        return pattern.toString();
    }
}
