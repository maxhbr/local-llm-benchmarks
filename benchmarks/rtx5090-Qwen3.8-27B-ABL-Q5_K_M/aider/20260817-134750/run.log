The tests expect specific error messages: `"Unknown operation"` for unrecognized words/operations, and `"Syntax error"` for structural problems (wrong token ordering, missing operands, empty expressions). The current code throws a generic `"Invalid question"` for all failures.

The fix:
1. Extract the expression leniently (strip `"What is "` prefix and `"?"` suffix if present) so non-math questions still get tokenized.
2. Tokenize using a regex that matches numbers, known multi-word ops, single-word ops, and arbitrary words.
3. Validate the alternating number/op structure, throwing `"Unknown operation"` when an unrecognized word appears, and `"Syntax error"` when the structure is broken (two numbers in a row, two ops in a row, prefix/postfix notation, missing operand, empty expression).

wordy.js
```
//
// This is only a SKELETON file for the 'Wordy' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export const answer = (question) => {
  let expr = question;
  if (expr.startsWith('What is ')) {
    expr = expr.slice('What is '.length);
  }
  if (expr.endsWith('?')) {
    expr = expr.slice(0, -1);
  }

  if (expr.trim() === '') {
    throw new Error('Syntax error');
  }

  const tokens = expr.match(/-?\d+|multiplied by|divided by|plus|minus|[a-zA-Z]+/g);

  if (!tokens || tokens.length === 0) {
    throw new Error('Syntax error');
  }

  const knownOps = new Set(['plus', 'minus', 'multiplied by', 'divided by']);

  for (let i = 0; i < tokens.length; i++) {
    const token = tokens[i];
    const isNumber = /^-?\d+$/.test(token);
    const isKnownOp = knownOps.has(token);

    if (i % 2 === 0) {
      // Expect a number
      if (!isNumber) {
        if (isKnownOp) {
          throw new Error('Syntax error');
        }
        throw new Error('Unknown operation');
      }
    } else {
      // Expect a known operation
      if (!isKnownOp) {
        if (isNumber) {
          throw new Error('Syntax error');
        }
        throw new Error('Unknown operation');
      }
    }
  }

  // Length must be odd (number, then pairs of op+number)
  if (tokens.length % 2 === 0) {
    throw new Error('Syntax error');
  }

  // Evaluate left-to-right, ignoring operator precedence
  let result = parseInt(tokens[0], 10);
  for (let i = 1; i < tokens.length; i += 2) {
    const op = tokens[i];
    const num = parseInt(tokens[i + 1], 10);
    switch (op) {
      case 'plus': result += num; break;
      case 'minus': result -= num; break;
      case 'multiplied by': result *= num; break;
      case 'divided by': result /= num; break;
    }
  }

  return result;
};
