Implement:
```
pub fn lowest_price(books: &[u32]) -> u32 {
    let mut counts = [0u64; 5];
    for &book in books {
        // Assume book IDs are 1..=5.
        if (1..=5).contains(&book) {
            counts[(book - 1) as usize] += 1;
        }
    }
    counts.sort_unstable_by(|a, b| b.cmp(a)); // descending
    let c1 = counts[0]; ...
    let mut size_counts = [0u64; 6]; // index size
    size_counts[5] = c5;
    size_counts[4] = c4 - c5;
    size_counts[3] = c3 - c4;
    size_counts[2] = c2 - c3;
    size_counts[1] = c1 - c2;
    let swaps = size_counts[5].min(size_counts[3]);
    size_counts[5] -= swaps;
    size_counts[3] -= swaps;
    size_counts[4] += 2 * swaps;
    let costs = [0u64, 800, 1520, 2160, 2560, 3000];
    let price: u64 = (1..=5).map(|s| size_counts[s] * costs[s]).sum();
    price as u32
}
```
