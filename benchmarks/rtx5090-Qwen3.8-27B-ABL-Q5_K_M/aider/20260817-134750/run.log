      if (!isNumber) {
        if (isKnownOp) throw new Error('Syntax error');
        throw new Error('Unknown operation');
      }
    } else {
      if (!isKnownOp) {
        if (isNumber) throw new Error('Syntax error');
        throw new Error('Unknown operation');
      }
    }
  }

