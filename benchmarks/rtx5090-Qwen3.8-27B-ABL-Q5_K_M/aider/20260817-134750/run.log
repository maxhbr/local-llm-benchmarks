Dominoes.java
```
import java.util.*;

class Dominoes {

    List<Domino> formChain(List<Domino> inputDominoes) throws ChainNotFoundException {
        if (inputDominoes == null || inputDominoes.isEmpty()) {
            return new ArrayList<>();
        }

        int n = inputDominoes.size();

        // Build adjacency list: vertex -> list of {neighbor, edgeIndex}
        Map<Integer, List<int[]>> adj = new HashMap<>();
        for (int i = 0; i < n; i++) {
            int a = inputDominoes.get(i).getLeft();
            int b = inputDominoes.get(i).getRight();
            adj.computeIfAbsent(a, k -> new ArrayList<>()).add(new int[]{b, i});
            adj.computeIfAbsent(b, k -> new ArrayList<>()).add(new int[]{a, i});
        }

        // Every vertex must have even degree for an Eulerian circuit to exist
        for (List<int[]> edges : adj.values()) {
            if (edges.size() % 2 != 0) {
                throw new ChainNotFoundException("No valid chain: odd degree vertex");
            }
        }

        // Verify the graph is connected (BFS from any vertex)
        int startVertex = adj.keySet().iterator().next();
        Set<Integer> visited = new HashSet<>();
        Deque<Integer> queue = new ArrayDeque<>();
        queue.add(startVertex);
        visited.add(startVertex);
        while (!queue.isEmpty()) {
            int v = queue.poll();
            for (int[] edge : adj.get(v)) {
                if (!visited.contains(edge[0])) {
                    visited.add(edge[0]);
                    queue.add(edge[0]);
                }
            }
        }
        if (visited.size() != adj.size()) {
            throw new ChainNotFoundException("No valid chain: graph is disconnected");
        }

        // Hierholzer's algorithm to find the Eulerian circuit
        boolean[] used = new boolean[n];
        Deque<Integer> stack = new ArrayDeque<>();
        List<Integer> circuit = new ArrayList<>();

        stack.push(startVertex);
        while (!stack.isEmpty()) {
            int v = stack.peek();
            boolean found = false;
            for (int[] edge : adj.get(v)) {
                if (!used[edge[1]]) {
                    used[edge[1]] = true;
                    stack.push(edge[0]);
                    found = true;
                    break;
                }
            }
            if (!found) {
                circuit.add(stack.pop());
            }
        }

        // circuit is produced in reverse order
        Collections.reverse(circuit);

        // Map the vertex sequence back to oriented dominoes
        List<Domino> result = new ArrayList<>();
        boolean[] matched = new boolean[n];
        for (int i = 0; i < n; i++) {
            int from = circuit.get(i);
            int to = circuit.get(i + 1);
            for (int j = 0; j < n; j++) {
                if (!matched[j]) {
                    int a = inputDominoes.get(j).getLeft();
                    int b = inputDominoes.get(j).getRight();
                    if ((a == from && b == to) || (a == to && b == from)) {
                        matched[j] = true;
                        if (a == from && b == to) {
                            result.add(inputDominoes.get(j));
                        } else {
                            result.add(new Domino(b, a));
                        }
                        break;
                    }
                }
            }
        }

        return result;
    }

}
