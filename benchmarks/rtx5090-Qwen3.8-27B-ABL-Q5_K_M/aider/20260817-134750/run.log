2. Map each interval character to its semitone distance:
   - `m` = 1
   - `M` = 2
   - `A` = 3
3. Choose the enharmonic spelling representation based on the tonic’s key-signature category:
   - flat representation for the listed flat keys
   - sharp representation otherwise
4. Generate the scale by stepping through the intervals from the tonic.
5. If the interval pattern completes the octave and returns to the starting pitch class, omit the final repeated tonic.
6. Implement `Scale::chromatic` by returning the full 12-note chromatic scale starting at the tonic, using the same sharp/flat representation rule.

lib.rs
```
#[derive(Debug)]
pub struct Error;

const SHARP: [&str; 12] = [
    "C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B",
];

const FLAT: [&str; 12] = [
    "C", "Db", "D", "Eb", "E", "F", "Gb", "G", "Ab", "A", "Bb", "B",
];

pub struct Scale {
    notes: Vec<String>,
}

impl Scale {
    pub fn new(tonic: &str, intervals: &str) -> Result<Scale, Error> {
        let start = parse_pitch(tonic).ok_or(Error)?;
        let chromatic = chromatic_for(tonic);

        let mut notes = vec![chromatic[start].to_string()];
        let mut pitch = start;

        for interval in intervals.chars() {
            let step = match interval {
                'm' => 1,
                'M' => 2,
                'A' => 3,
                _ => return Err(Error),
            };

            pitch = (pitch as i32 + step).rem_euclid(12) as u8;
            notes.push(chromatic[pitch].to_string());
        }

        if notes.len() > 1 && pitch == start {
            notes.pop();
        }

        Ok(Scale { notes })
    }

    pub fn chromatic(tonic: &str) -> Result<Scale, Error> {
        let start = parse_pitch(tonic).ok_or(Error)?;
        let chromatic = chromatic_for(tonic);

        let notes = (0..12)
            .map(|i| chromatic[(start + i) % 12].to_string())
            .collect();

        Ok(Scale { notes })
    }

    pub fn enumerate(&self) -> Vec<String> {
        self.notes.clone()
    }
}

fn chromatic_for(tonic: &str) -> &'static [&'static str] {
    if uses_flats(tonic) {
        &FLAT
    } else {
        &SHARP
    }
}

fn uses_flats(tonic: &str) -> bool {
    matches!(
        tonic,
        "F" | "Bb" | "Eb" | "Ab" | "Db" | "Gb"
            | "d" | "g" | "c" | "f" | "bb" | "eb"
    )
}

fn parse_pitch(tonic: &str) -> Option<u8> {
    let mut chars = tonic.chars();
    let first = chars.next()?;

    let letter = match first.to_ascii_uppercase() {
        'C' => 0,
        'D' => 2,
        'E' => 4,
        'F' => 5,
        'G' => 7,
        'A' => 9,
        'B' => 11,
        _ => return None,
    };

    let accidental = if tonic.len() > 1 {
        match tonic.chars().last() {
            Some('#') => 1,
            Some('b') => -1,
            _ => 0,
        }
    } else {
        0
    };

    Some((letter as i32 + accidental).rem_euclid(12) as u8)
}
```
