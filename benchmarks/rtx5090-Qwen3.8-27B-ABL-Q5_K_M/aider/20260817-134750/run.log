pub fn answer(command: &str) -> Option<i32> {
    let inner = command.strip_prefix("What is ")?;
    let inner = inner.strip_suffix('?')?;

    let raw_tokens: Vec<&str> = inner.split_whitespace().collect();
    if raw_tokens.is_empty() {
        return None;
    }

    // Combine multi-word operators into single tokens.
    let mut tokens: Vec<String> = Vec::new();
    let mut i = 0;
    while i < raw_tokens.len() {
        if i + 1 < raw_tokens.len()
            && ((raw_tokens[i] == "multiplied" && raw_tokens[i + 1] == "by")
                || (raw_tokens[i] == "divided" && raw_tokens[i + 1] == "by"))
        {
            tokens.push(format!("{} {}", raw_tokens[i], raw_tokens[i + 1]));
            i += 2;
        } else {
            tokens.push(raw_tokens[i].to_string());
            i += 1;
        }
    }

    // First token must be a number.
    let mut result: i32 = tokens[0].parse().ok()?;

    // Remaining tokens must alternate: operator, number, operator, number, ...
    let mut i = 1;
