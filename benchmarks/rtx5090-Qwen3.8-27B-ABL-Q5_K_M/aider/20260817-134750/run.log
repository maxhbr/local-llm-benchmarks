lib.rs
```
pub fn lowest_price(books: &[u32]) -> u32 {
    let mut counts = [0u64; 5];

    for &book in books {
        if (1..=5).contains(&book) {
            counts[(book - 1) as usize] += 1;
        }
    }

    counts.sort_by(|a, b| b.cmp(a));

    let mut groups_of_5 = counts[4];
    let mut groups_of_4 = counts[3] - counts[4];
    let mut groups_of_3 = counts[2] - counts[3];
    let mut groups_of_2 = counts[1] - counts[2];
    let groups_of_1 = counts[0] - counts[1];

    let swaps = groups_of_5.min(groups_of_3);
    groups_of_5 -= swaps;
    groups_of_3 -= swaps;
    groups_of_4 += 2 * swaps;

    let total = groups_of_1 * 800
        + groups_of_2 * 1520
        + groups_of_3 * 2160
        + groups_of_4 * 2560
        + groups_of_5 * 3000;

    total as u32
}
```
