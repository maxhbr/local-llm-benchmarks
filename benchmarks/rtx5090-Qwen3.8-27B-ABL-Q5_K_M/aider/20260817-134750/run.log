    # Straight detection (ace can be low)
    straight_high = None
    if ranks_desc[0] - ranks_desc[-1] == 4:
        straight_high = ranks_desc[0]
    elif ranks_desc == [14, 5, 4, 3, 2]:
        straight_high = 5

    # Rank frequency sorted by (count desc, rank desc)
    freq = Counter(r for r, _ in cards)
    ordered = sorted(freq.items(), key=lambda x: (x[1], x[0]), reverse=True)

    counts = [c for _, c in ordered]

    if is_flush and straight_high:
        return (8, straight_high)
    if 4 in counts:
        quad = [r for r, c in ordered if c == 4][0]
        kicker = [r for r, c in ordered if c == 1][0]
        return (7, quad, kicker)
    if 3 in counts and 2 in counts:
        trips = [r for r, c in ordered if c == 3][0]
        pair = [r for r, c in ordered if c == 2][0]
        return (6, trips, pair)
    if is_flush:
        return (5, tuple(ranks_desc))
    if straight_high:
        return (4, straight_high)
    if 3 in counts:
        trips = [r for r, c in ordered if c == 3][0]
        kickers = [r for r, c in ordered if c == 1]
        return (3, trips, *kickers)
    if counts.count(2) == 2:
        pairs = sorted((r for r, c in ordered if c == 2), reverse=True)
        kicker = [r for r, c in ordered if c == 1][0]
        return (2, pairs[0], pairs[1], kicker)
    if 2 in counts:
        pair = [r for r, c in ordered if c == 2][0]
        kickers = [r for r, c in ordered if c == 1]
        return (1, pair, *kickers)
    return (0, tuple(ranks_desc))


def best_hands(hands):
    scored = [(_evaluate(hand), hand) for hand in hands]
    best = max(s for s, _ in scored)
    return [hand for s, hand in scored if s == best]
