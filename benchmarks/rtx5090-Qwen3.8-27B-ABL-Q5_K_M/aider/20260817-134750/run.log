Pseudo:
class PigLatinTranslator {
    public String translate(String word) {
        if (word == null) return null;
        if (word.isEmpty()) return "ay"? or ""? Need decide.
        // If contains spaces? maybe handle.
        String lower = word.toLowerCase();
        if (isVowelStart(lower) || lower.startsWith("xr") || lower.startsWith("yt")) return word + "ay";
        int quIndex = lower.indexOf("qu");
        if (quIndex >= 0 && isAllConsonants(lower, 0, quIndex)) {
            String prefix = word.substring(0, quIndex + 2);
            String remainder = word.substring(quIndex + 2);
            return remainder + prefix + "ay";
        }
        int yIndex = lower.indexOf('y');
        if (yIndex > 0 && isAllConsonants(lower, 0, yIndex)) {
            String prefix = word.substring(0, yIndex);
            String remainder = word.substring(yIndex);
            return remainder + prefix + "ay";
        }
        int consonantEnd = 0;
        while (consonantEnd < word.length() && !isVowel(lower.charAt(consonantEnd))) consonantEnd++;
        String prefix = word.substring(0, consonantEnd);
        String remainder = word.substring(consonantEnd);
        return remainder + prefix + "ay";
    }
    private boolean isVowel(char c) { return "aeiou".indexOf(c) >=0; }
    private boolean isAllConsonants(String lower, int start, int end) { for i start to end-1 if isVowel(lower.charAt(i)) return false; return true; }
}

