`parse_tonic` returns `(u8, String, Preference, bool)`.
```
fn parse_tonic(tonic: &str) -> Result<(u8, String, Preference, bool), Error> {
    let mut chars = tonic.chars();
    let letter = chars.next().ok_or(Error)?;
    let upper = letter.to_ascii_uppercase();
    let base = match upper { 'C'=>0, 'D'=>2, 'E'=>4, 'F'=>5, 'G'=>7, 'A'=>9, 'B'=>11, _ => return Err(Error) };
    let mut pc = base;
    let mut canonical = String::new();
    canonical.push(letter); // preserve case
    let mut accidental: Option<char> = None;
    if let Some(acc) = chars.next() {
        match acc {
            '#' => { pc = (pc + 1) % 12; canonical.push('#'); accidental = Some('#'); }
            'b' | 'B' => { pc = (pc + 11) % 12; canonical.push('b'); accidental = Some('b'); }
            _ => return Err(Error),
        }
    }
    if chars.next().is_some() { return Err(Error); }
    let preference = preference_for(&canonical);
    let lowercase = letter.is_ascii_lowercase();
    Ok((pc, canonical, preference, lowercase))
}
```
But if tonic is empty, `chars.next()` None -> Err.

`preference_for(canonical: &str) -> Preference`:
```
fn preference_for(tonic: &str) -> Preference {
    match tonic {
        "C" | "a" => Preference::Natural,
        "G" | "D" | "A" | "E" | "B" | "F#" | "e" | "b" | "f#" | "c#" | "g#" | "d#" => Preference::Sharp,
        "F" | "Bb" | "Eb" | "Ab" | "Db" | "Gb" | "d" | "g" | "c" | "f" | "bb" | "eb" => Preference::Flat,
        _ => {
            // fallback based on accidental or natural letter case
            if tonic.contains('#') { Preference::Sharp }
            else if tonic.contains('b') { Preference::Flat }
            else {
                match tonic {
                    "C" => Preference::Natural, // already
                    "G" | "D" | "A" | "E" | "B" => Preference::Sharp,
                    "F" => Preference::Flat,
                    "g" | "d" | "c" | "f" => Preference::Flat,
                    "e" | "b" => Preference::Sharp,
                    "a" => Preference::Natural,
                    _ => Preference::Sharp,
                }
            }
        }
    }
}
```
But the explicit match already covers all natural letters uppercase/lowercase? Uppercase: C natural, G/D/A/E/B sharp, F flat. Lowercase: a natural, e/b sharp, d/g/c/f
