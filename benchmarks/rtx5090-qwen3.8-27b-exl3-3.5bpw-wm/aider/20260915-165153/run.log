namespace spiral_matrix {

std::vector<std::vector<int>> matrix(int size) {

    std::vector<std::vector<int>> result(size, std::vector<int>(size, 0));

    int top=0, bottom=size-1, left=0, right=size-1;

    int value=1;

    while (top <= bottom && left <= right) {

        for (int col=left; col<=right; ++col) result[top][col]=value++;

        ++top;

        for (int row=top; row<=bottom; ++row) result[row][right]=value++;

        --right;

        if (top <= bottom) {

            for (int col=right; col>=left; --col) result[bottom][col]=value++;

            --bottom;

        }

        if (left <= right) {

            for (int row=bottom; row>=top; --row) result[row][left]=value++;

            ++left;

        }

    }

    return result;

}

}

