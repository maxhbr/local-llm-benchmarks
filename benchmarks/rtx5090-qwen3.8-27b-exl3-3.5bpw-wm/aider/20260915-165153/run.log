export class RestAPI {

  constructor(database) {

    this.database = database || { users: [] };

  }



  get(url) {

    const [path, query] = url.split('?');

    if (path === '/users') {

      let users = this.database.users;

      if (query) {

        const params = new URLSearchParams(query);

        const names = params.get('users').split(',');

        users = users.filter(user => names.includes(user.name)).sort((a,b)=>a.name.localeCompare(b.name));

      } else {

        users = [...users].sort((a,b)=>a.name.localeCompare(b.name));

      }

      return JSON.stringify({ users });

    }

    return JSON.stringify({ error: 'Not found' });

  }



  post(url, payload) {

    const data = JSON.parse(payload);

    if (url === '/add') {

      const user = { name: data.user, owes: {}, owed_by: {}, balance: 0 };

      this.database.users.push(user);

      return JSON.stringify(user);

    }

    if (url === '/iou') {

      const { lender, borrower, amount } = data;

      const lenderUser = this.database.users.find(u => u.name === lender);

      const borrowerUser = this.database.users.find(u => u.name === borrower);

      // update

      // If borrower owes lender amount: borrower.owes[lender] += amount; lender.owed_by[borrower] += amount;

      // balance: lender.balance += amount; borrower.balance -= amount;

      // Need remove zero entries? likely yes? User object may omit zero? Spec shows only non-zero? Need decide.

      // Many solutions delete zero values to keep clean.

      // Return sorted updated user objects for lender and borrower.

    }

  }

}



