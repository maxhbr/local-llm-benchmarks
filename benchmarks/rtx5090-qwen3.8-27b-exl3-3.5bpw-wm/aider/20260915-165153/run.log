export class GradeSchool {

  constructor() {

    this.students = {};

  }



  roster() {

    const result = {};

    const grades = Object.keys(this.students).map(Number).sort((a,b)=>a-b);

    for (const grade of grades) {

      result[grade] = [...this.students[grade]].sort();

    }

    return result;

  }



  add(name, grade) {

    const allStudents = Object.values(this.students).flat();

    if (allStudents.includes(name)) return false;

    if (!this.students[grade]) this.students[grade] = [];

    this.students[grade].push(name);

    return true;

  }



  grade(grade) {

    return [...(this.students[grade] || [])].sort();

  }

}

```


