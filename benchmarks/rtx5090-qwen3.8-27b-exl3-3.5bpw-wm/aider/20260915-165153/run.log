func Verse(v int) string {
    if v < 1 || v > len(animals) {
        return ""
    }
    var b strings.Builder
    b.WriteString("I know an old lady who swallowed a ")
    b.WriteString(animals[v-1])
    b.WriteString(".\n")
    b.WriteString(verseLines[v-1])
    if v < len(animals) {
        for i := v - 1; i >= 1; i-- {
            b.WriteString("\nShe swallowed the ")
            b.WriteString(animals[i])
            b.WriteString(" to catch the ")
            if i == 1 {
                b.WriteString("spider that wriggled and jiggled and tickled inside her.")
            } else {
                b.WriteString(animals[i-1])
                b.WriteString(".")
            }
        }
        b.WriteString("\nI don't know why she swallowed the fly. Perhaps she'll die.")
    }
    return b.String()
}

