wordy.js
```
export const answer = (question) => {
  const match = question.match(/^What is (.+)\?$/);
  if (!match) {
    throw new Error('Unknown operation');
  }

  const tokens = match[1].trim().split(/\s+/);
  if (tokens.length === 0) {
    throw new Error('Unknown operation');
  }

  const isNumber = (token) => /^-?\d+$/.test(token);

  if (!isNumber(tokens[0])) {
    throw new Error('Unknown operation');
  }

  let result = Number(tokens[0]);
  let index = 1;

  while (index < tokens.length) {
    let operator;

    if (tokens[index] === 'plus') {
      operator = 'plus';
      index += 1;
    } else if (tokens[index] === 'minus') {
      operator = 'minus';
      index += 1;
    } else if (tokens[index] === 'multiplied' && tokens[index + 1] === 'by') {
      operator = 'multiplied';
      index += 2;
    } else if (tokens[index] === 'divided' && tokens[index + 1] === 'by') {
      operator = 'divided';
      index += 2;
    } else {
      throw new Error('Unknown operation');
    }

    if (index >= tokens.length || !isNumber(tokens[index])) {
      throw new Error('Unknown operation');
    }

    const operand = Number(tokens[index]);
    index += 1;

    if (operator === 'plus') {
      result += operand;
    } else if (operator === 'minus') {
      result -= operand;
    } else if (operator === 'multiplied') {
      result *= operand;
    } else if (operator === 'divided') {
      if (operand === 0) {
        throw new Error('Unknown operation');
      }
      result /= operand;
    }
  }

  return result;
};
```
