export class ZebraPuzzle {

  constructor() {

    this.solution = this.solve();

  }



  waterDrinker() {

    return this.solution.waterDrinker;

  }



  zebraOwner() {

    return this.solution.zebraOwner;

  }



  solve() {

    const nationalities = ['Englishman', 'Spaniard', 'Ukrainian', 'Norwegian', 'Japanese'];

    const colors = ['Red', 'Green', 'Ivory', 'Yellow', 'Blue'];

    const pets = ['Dog', 'Snail', 'Fox', 'Horse', 'Zebra'];

    const drinks = ['Coffee', 'Tea', 'Milk', 'Orange Juice', 'Water'];

    const hobbies = ['Dancing', 'Painting', 'Reading', 'Football', 'Chess'];



    const permutations = (items) => {

      if (items.length <= 1) return [items.slice()];

      const result = [];

      items.forEach((item, index) => {

        const rest = items.slice(0, index).concat(items.slice(index + 1));

        for (const perm of permutations(rest)) {

          result.push([item, ...perm]);

        }

      });

      return result;

    };



    const nextTo = (a, b) => Math.abs(a - b) === 1;



    for (const nationality of permutations(nationalities)) {

      if (nationality[0] !== 'Norwegian') continue;

      for (const color of permutations(colors)) {

        if (color[nationality.indexOf('Englishman')] !== 'Red') continue;

        const green = color.indexOf('Green');

        const ivory = color.indexOf('Ivory');

        if (green !== ivory + 1) continue;

        if (color[1] !== 'Blue') continue; // Norwegian next to blue, only house 1

        for (const drink of permutations(drinks)) {

          if (drink[2] !== 'Milk') continue;

          if (drink[color.indexOf('Green')] !== 'Coffee') continue;

          if (drink[nationality.indexOf('Ukrainian')] !== 'Tea') continue;

          for (const hobby of permutations(hobbies)) {

            if (hobby[color.indexOf('Yellow')] !== 'Painting') continue;

            if (hobby[nationality.indexOf('Japanese')] !== 'Chess') continue;

            if (drink[hobby.indexOf('Football')] !== 'Orange Juice') continue;

            for (const pet of permutations(pets)) {

              if (pet[nationality.indexOf('Spaniard')] !== 'Dog') continue;

              if (pet[hobby.indexOf('Dancing')] !== 'Snail') continue;

              if (!nextTo(hobby.indexOf('Reading'), pet.indexOf('Fox'))) continue;

              if (!nextTo(hobby.indexOf('Painting'), pet.indexOf('Horse'))) continue;

              const waterDrinker = nationality[drink.indexOf('Water')];

              const zebraOwner = nationality[pet.indexOf('Zebra')];

              return { waterDrinker, zebraOwner };

            }

          }

        }

      }

    }

    throw new Error('No solution found');

  }

}



