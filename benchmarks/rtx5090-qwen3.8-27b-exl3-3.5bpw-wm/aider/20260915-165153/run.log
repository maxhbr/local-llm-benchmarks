        10: "ten",
    }

    def word(n):
        return numbers.get(n, str(n))

    def bottle_phrase(n, capitalize=False):
        count = word(n)
        if capitalize:
            count = count.capitalize()
        bottle = "bottle" if n == 1 else "bottles"
        return f"{count} green {bottle}"

    lines = []
    for i in range(start, start - take, -1):
        current = bottle_phrase(i, capitalize=True)
        next_phrase = bottle_phrase(i - 1)
        lines.append(f"{current} hanging on the wall,")
        lines.append(f"{current} hanging on the wall,")
        lines.append("And if one green bottle should accidentally fall,")
        lines.append(f"There'll be {next_phrase} hanging on the wall.")
        if i != start - take:
            lines.append("")
    return lines
```
