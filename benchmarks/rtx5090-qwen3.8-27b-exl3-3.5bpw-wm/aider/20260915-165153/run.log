export const combinations = (cage) => {

  const [sum, size, ...excluded] = cage;

  const digits = [1,2,3,4,5,6,7,8,9].filter(d => !excluded.includes(d));

  const results = [];

  const combine = (start, current, currentSum) => {

    if (current.length === size) {

      if (currentSum === sum) results.push([...current]);

      return;

    }

    for (let i = start; i < digits.length; i++) {

      if (currentSum + digits[i] > sum) break;

      current.push(digits[i]);

      combine(i + 1, current, currentSum + digits[i]);

      current.pop();

    }

  };

  combine(0, [], 0);

  return results;

};

```
