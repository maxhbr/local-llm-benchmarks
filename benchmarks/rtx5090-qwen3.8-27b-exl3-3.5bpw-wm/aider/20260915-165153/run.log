    def test_multiplies_two_numbers(self):
        self.assertEqual(evaluate("2 4 *"), [8])
    def test_divides_two_numbers(self):
        self.assertEqual(evaluate("8 3 /"), [2])
    def test_handles_addition_of_negative_numbers(self):
        self.assertEqual(evaluate("-1 -2 +"), [-3])
    def test_handles_subtraction_of_negative_numbers(self):
        self.assertEqual(evaluate("-1 -2 -"), [1])
    def test_handles_multiplication_of_negative_numbers(self):
        self.assertEqual(evaluate("-1 -2 *"), [2])
    def test_handles_division_of_negative_numbers(self):
        self.assertEqual(evaluate("-1 -2 /"), [0])
```
