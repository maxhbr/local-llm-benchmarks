export const meetup = (year, month, week, weekday) => {
  const days = ['sunday', 'monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday'];
  const targetDay = days.indexOf(String(weekday).toLowerCase());
  if (targetDay === -1) throw new Error('Invalid weekday');
  const weekValue = String(week).toLowerCase();

  const daysInMonth = new Date(year, month, 0).getDate();
  const firstDay = new Date(year, month - 1, 1).getDay();

  let date;
  if (weekValue === 'teenth') {
    const teenthStart = 13;
    const teenthStartDay = new Date(year, month - 1, teenthStart).getDay();
    date = teenthStart + ((targetDay - teenthStartDay + 7) % 7);
  } else if (weekValue === 'last') {
    const lastDay = new Date(year, month - 1, daysInMonth).getDay();
    date = daysInMonth - ((lastDay - targetDay + 7) % 7);
  } else {
    const offsets = { first: 0, second: 7, third: 14, fourth: 21 };
    if (!(weekValue in offsets)) throw new Error('Invalid week');
    date = 1 + offsets[weekValue] + ((targetDay - firstDay + 7) % 7);
  }
  return new Date(year, month - 1, date);
};
```
