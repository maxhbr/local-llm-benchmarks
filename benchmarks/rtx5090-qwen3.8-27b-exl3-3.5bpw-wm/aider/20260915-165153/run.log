type Element struct {

    data int

    next *Element

}

type List struct {

    head *Element

}

func New(elements []int) *List {

    list := &List{}

    for i := len(elements) - 1; i >= 0; i-- {

        list.Push(elements[i])

    }

    return list

}

func (l *List) Size() int {

    size := 0

    for e := l.head; e != nil; e = e.next { size++ }

    return size

}

func (l *List) Push(element int) {

    l.head = &Element{data: element, next: l.head}

}

func (l *List) Pop() (int, error) {

    if l.head == nil { return 0, errors.New("pop from empty list") }

    data := l.head.data

    l.head = l.head.next

    return data, nil

}

func (l *List) Array() []int {

    arr := []int{}

    for e := l.head; e != nil; e = e.next { arr = append(arr, e.data) }

    return arr

}

func (l *List) Reverse() *List {

    reversed := &List{}

    for e := l.head; e != nil; e = e.next { reversed.Push(e.data) }

    return reversed

}



