def proverb(*parts, qualifier=None):
    if not parts:
        return []

    lines = [
        f"For want of a {current} the {next} was lost."
        for current, next in zip(parts, parts[1:])
    ]

    if qualifier:
        lines.append(f"And all for the want of a {qualifier} {parts[0]}.")
    else:
        lines.append(f"And all for the want of a {parts[0]}.")

    return lines
```
