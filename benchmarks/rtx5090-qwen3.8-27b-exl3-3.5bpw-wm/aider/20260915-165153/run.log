I recall solution:

class SimpleLinkedList<T> {

    private Node<T> head;

    private int size;



    private static class Node<T> {

        T value;

        Node<T> next;

        Node(T value) { this.value = value; }

    }



    SimpleLinkedList() {}

    SimpleLinkedList(T[] values) {

        for (int i = values.length - 1; i >= 0; i--) push(values[i]);

    }



    void push(T value) {

        Node<T> node = new Node<>(value);

        node.next = head;

        head = node;

        size++;

    }



    T pop() {

        if (head == null) throw new NoSuchElementException();

        T value = head.value;

        head = head.next;

        size--;

        return value;

    }



    void reverse() {

        Node<T> prev = null;

        Node<T> curr = head;

        while (curr != null) {

            Node<T> next = curr.next;

            curr.next = prev;

            prev = curr;

            curr = next;

        }

        head = prev;

    }



    T[] asArray(Class<T> clazz) {

        T[] array = (T[]) java.lang.reflect.Array.newInstance(clazz, size);

        int i = 0;

        for (Node<T> node = head; node != null; node = node.next) {

            array[i++] = node.value;

        }

        return array;

    }



    int size() { return size; }

}



