export class Triangle {
  constructor(...sides) {
    this.sides = sides;
  }

  get isValid() {
    const [a,b,c] = this.sides;
    return a > 0 && b > 0 && c > 0 && a + b >= c && b + c >= a && a + c >= b;
  }

  get isEquilateral() {
    return this.isValid && this.sides[0] === this.sides[1] && this.sides[1] === this.sides[2];
  }

  get isIsosceles() {
    return this.isValid && (this.sides[0] === this.sides[1] || this.sides[1] === this.sides[2] || this.sides[0] === this.sides[2]);
  }

  get isScalene() {
    return this.isValid && this.sides[0] !== this.sides[1] && this.sides[1] !== this.sides[2] && this.sides[0] !== this.sides[2];
  }
}

