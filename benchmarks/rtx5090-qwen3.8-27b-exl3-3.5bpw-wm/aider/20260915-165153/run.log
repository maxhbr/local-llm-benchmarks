#include "diamond.h"

#include <string>
#include <vector>

namespace diamond {

std::vector<std::string> rows(char letter) {
    const int n = letter - 'A';
    const int size = 2 * n + 1;
    std::vector<std::string> result;
    result.reserve(size);

    for (int r = 0; r < size; ++r) {
        const int k = (r <= n) ? r : (size - 1 - r);
        std::string row(size, ' ');

        if (k == 0) {
            row[n] = 'A';
        } else {
            const char c = static_cast<char>('A' + k);
            const int leading = n - k;
            row[leading] = c;
            row[size - 1 - leading] = c;
        }

        result.push_back(std::move(row));
    }

    return result;
}

}  // namespace diamond
```

