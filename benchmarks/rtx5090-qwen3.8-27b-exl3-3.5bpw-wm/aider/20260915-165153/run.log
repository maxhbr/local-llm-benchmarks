class ResistorColorTrio {

    String label(String[] colors) {

        int first = colorValue(colors[0]);

        int second = colorValue(colors[1]);

        int multiplier = colorValue(colors[2]);

        long ohms = (first * 10L + second) * pow10(multiplier);

        if (ohms >= 1_000_000_000L) {

            return (ohms / 1_000_000_000L) + " gigaohms";

        } else if (ohms >= 1_000_000L) {

            return (ohms / 1_000_000L) + " megaohms";

        } else if (ohms >= 1_000L) {

            return (ohms / 1_000L) + " kiloohms";

        } else {

            return ohms + " ohms";

        }

    }



