```rust
use std::collections::HashMap;
use std::thread;

pub fn frequency(input: &[&str], worker_count: usize) -> HashMap<char, usize> {
    let worker_count = worker_count.max(1);
    
    // Split input into chunks for each worker
    let chunk_size = (input.len() + worker_count - 1) / worker_count;
    
    let handles: Vec<_> = input
        .chunks(chunk_size)
        .map(|chunk| {
            thread::spawn(move || {
                let mut local: HashMap<char, usize> = HashMap::new();
                for text in chunk {
                    for c in text.chars() {
                        if c.is_ascii_lowercase() {
                            *local.entry(c).or_insert(0) += 1;
                        }
                    }
                }
                local
            })
        })
        .collect();
    
    let mut result: HashMap<char, usize> = HashMap::new();
    for handle in handles {
        let local = handle.join().unwrap();
        for (c, count) in local {
            *result.entry(c).or_insert(0) += count;
        }
    }
    
    result
}
```

