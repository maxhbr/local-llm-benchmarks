#include "perfect_numbers.h"

namespace perfect_numbers {

classification classify(int number) {
    if (number <= 0) {
        throw std::domain_error("Only positive integers are allowed");
    }

    long long n = number;
    long long aliquot_sum = 0;

    if (n > 1) {
        aliquot_sum = 1;
    }

    for (long long divisor = 2; divisor * divisor <= n; ++divisor) {
        if (n % divisor == 0) {
            aliquot_sum += divisor;
            long long other = n / divisor;
            if (other != divisor) {
                aliquot_sum += other;
            }
        }
        if (aliquot_sum > n) {
            return classification::abundant;
        }
    }

    if (aliquot_sum == n) {
        return classification::perfect;
    }
    if (aliquot_sum > n) {
        return classification::abundant;
    }
    return classification::deficient;
}

}  // namespace perfect_numbers

