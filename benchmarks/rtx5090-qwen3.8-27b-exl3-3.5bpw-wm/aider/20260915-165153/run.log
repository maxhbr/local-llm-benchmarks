class Hangman {

    Observable<Output> play(Observable<String> words, Observable<String> letters) {

        return words

            .map(word -> letters

                .scan(new State(word), (state, letter) -> state.guess(letter))

                .map(State::toOutput)

                .startWith(new State(word).toOutput()))

            .switchOnLatest(Function.identity());

    }

}



