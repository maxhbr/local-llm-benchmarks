export class GoCounting {

  constructor(board) {

    this.board = board;

  }



  getTerritory(x, y) {

    if (this.board[y] && this.board[y][x] !== ' ') {

      return { owner: 'NONE', territory: [] };

    }

    const territory = [];

    const owners = new Set();

    const queue = [[x, y]];

    const visited = new Set();

    while (queue.length) {

      const [cx, cy] = queue.shift();

      const key = `${cx},${cy}`;

      if (visited.has(key)) continue;

      visited.add(key);

      if (this.board[cy] && this.board[cy][cx] === ' ') {

        territory.push([cx, cy]);

        for (const [dx, dy] of [[0,1],[0,-1],[1,0],[-1,0]]) {

          const nx = cx + dx, ny = cy + dy;

          if (this.board[ny] && this.board[ny][nx] === ' ') {

            queue.push([nx, ny]);

          } else if (this.board[ny] && (this.board[ny][nx] === 'B' || this.board[ny][nx] === 'W')) {

            owners.add(this.board[ny][nx]);

          }

        }

      }

    }

    territory.sort((a,b) => a[0]-b[0] || a[1]-b[1]);

    const owner = owners.size === 1 ? (owners.has('B') ? 'BLACK' : 'WHITE') : 'NONE';

    return { owner, territory };

  }



  getTerritories() {

    const black = new Set();

    const white = new Set();

    const none = new Set();

    const visited = new Set();

    for (let y=0; y<this.board.length; y++) {

      for (let x=0; x<this.board[y].length; x++) {

        if (this.board[y][x] === ' ' && !visited.has(`${x},${y}`)) {

          const { owner, territory } = this.getTerritory(x,y);

          territory.forEach(([tx,ty]) => visited.add(`${tx},${ty}`));

          if (owner === 'BLACK') territory.forEach(c => black.add(`${c[0]},${c[1]}`));

          else if (owner === 'WHITE') ...

          else ...

        }

      }

    }

    const toArr = set => [...set].map(s => s.split(',').map(Number)).sort(...);

    return { territoryBlack: toArr(black), territoryWhite: toArr(white), territoryNone: toArr(none) };

  }

}



