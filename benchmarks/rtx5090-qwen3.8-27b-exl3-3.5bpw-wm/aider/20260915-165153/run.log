package palindrome



type Product struct {

    Product int

    Factors [][2]int

}



func Products(fmin, fmax int) (Product, Product, error) {

    if fmin > fmax {

        return Product{}, Product{}, errors.New("fmin > fmax")

    }

    var smallest, largest Product

    found := false

    for i := fmin; i <= fmax; i++ {

        for j := i; j <= fmax; j++ {

            p := i * j

            if isPalindrome(p) {

                if !found || p < smallest.Product {

                    smallest = Product{p, [][2]int{{i, j}}}

                    found = true

                } else if p == smallest.Product {

                    smallest.Factors = append(smallest.Factors, [2]int{i, j})

                }

                if p > largest.Product {

                    largest = Product{p, [][2]int{{i, j}}}

                } else if p == largest.Product {

                    largest.Factors = append(largest.Factors, [2]int{i, j})

                }

            }

        }

    }

    if !found {

        return Product{}, Product{}, errors.New("no palindromes")

    }

    return smallest, largest, nil

}



