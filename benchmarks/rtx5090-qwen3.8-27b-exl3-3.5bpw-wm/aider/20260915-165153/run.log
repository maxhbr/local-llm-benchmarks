public class VariableLengthQuantity {

    public List<String> encode(List<Long> numbers) {

        List<String> result = new ArrayList<>();

        for (Long number : numbers) {

            result.add(encodeNumber(number));

        }

        return result;

    }



    private String encodeNumber(Long number) {

        StringBuilder sb = new StringBuilder();

        long n = number;

        long[] bytes = new long[5];

        int i = 0;

        do {

            bytes[i++] = n & 0x7F;

            n >>= 7;

        } while (n != 0);

        for (int j = i - 1; j >= 0; j--) {

            if (j > 0) bytes[j] |= 0x80;

            sb.append(String.format("%02X", bytes[j]));

            if (j > 0) sb.append(" ");

        }

        return sb.toString();

    }



    public List<Long> decode(List<Long> bytes) {

        List<Long> result = new ArrayList<>();

        long value = 0;

        for (long b : bytes) {

            value = (value << 7) | (b & 0x7F);

            if ((b & 0x80) == 0) {

                result.add(value);

                value = 0;

            }

        }

        return result;

    }

}



