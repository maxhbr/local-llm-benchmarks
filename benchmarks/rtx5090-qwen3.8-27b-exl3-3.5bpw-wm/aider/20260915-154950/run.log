meetup.js
```
//
// This is only a SKELETON file for the 'Meetup' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

const DAY_NAMES = [
  'sunday',
  'monday',
  'tuesday',
  'wednesday',
  'thursday',
  'friday',
  'saturday',
];

const WEEK_OFFSETS = {
  first: 0,
  second: 7,
  third: 14,
  fourth: 21,
};

export const meetup = (year, month, week, dayOfWeek) => {
  const targetDay = DAY_NAMES.indexOf(String(dayOfWeek).toLowerCase());
  const firstDay = new Date(year, month - 1, 1).getDay();
  const daysInMonth = new Date(year, month, 0).getDate();

  let day;

  if (week === 'teenth') {
    day = 13 + ((targetDay - 13 + 7) % 7);
  } else if (week === 'last') {
    day = daysInMonth - ((daysInMonth - targetDay + 7) % 7);
  } else {
    day = 1 + WEEK_OFFSETS[week] + ((targetDay - firstDay + 7) % 7);
  }

  return new Date(year, month - 1, day);
};
```
