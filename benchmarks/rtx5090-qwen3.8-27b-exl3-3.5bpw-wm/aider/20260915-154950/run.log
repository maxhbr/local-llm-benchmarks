export class GoCounting {

  constructor(board) { this.board = board; }

  getTerritory(x, y) {

    if (this.board[y] && this.board[y][x] === ' ') {

      const territory = [];

      const owners = new Set();

      const visited = new Set();

      const stack = [[x,y]];

      while (stack.length) {

        const [cx, cy] = stack.pop();

        if (visited.has(`${cx},${cy}`)) continue;

        visited.add(...);

        territory.push([cx, cy]);

        for (dx,dy) {

          nx,ny;

