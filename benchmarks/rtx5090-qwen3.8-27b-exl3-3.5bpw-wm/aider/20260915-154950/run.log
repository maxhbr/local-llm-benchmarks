Potential design:

class Zipper {

  constructor(focus, path) { this.focus = focus; this.path = path; } // path array of {side, parent} maybe.

  static fromTree(tree) { return new Zipper(tree, []); }

  toTree() { let node = this.focus; for (let i = this.path.length -1; i>=0; i--) { const {side, parent} = this.path[i]; if (side === 'left') parent.left = node; else parent.right = node; node = parent; } return node; }

  value() { return this.focus.value; }

  left() { if (!this.focus.left) return null; return new Zipper(this.focus.left, [...this.path, {side:'left', parent:this.focus}]); }

  right() similar.

  up() { if (this.path.length === 0) return null; const path = this.path.slice(0,-1); const last = this.path[this.path.length-1]; return new Zipper(last.parent, path); }

  setValue(value) { const newFocus = { ...this.focus, value }; return new Zipper(newFocus, this.path); }

  setLeft(left) { const newFocus = { ...this.focus, left }; return new Zipper(newFocus, this.path); }

  setRight(right) { const newFocus = { ...this.focus, right }; return new Zipper(newFocus, this.path); }

}



