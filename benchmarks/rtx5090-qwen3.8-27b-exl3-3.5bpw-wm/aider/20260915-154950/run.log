            if board[ny][nx] === ' ' && !visited -> push

            else if board[ny][nx] === 'B' owners.add('BLACK')

            else if 'W' owners.add('WHITE')

        }

      }

      territory.sort((a,b)=> a[0]-b[0] || a[1]-b[1]);

      const owner = owners.size === 1 ? [...owners][0] : 'NONE';

      return { owner, territory };

    }

    return { owner: 'NONE', territory: [] };

  }

