export class GradeSchool {

  #roster = {};



  roster() {

    return Object.keys(this.#roster)

      .sort((a, b) => a - b)

      .reduce((acc, grade) => {

        acc[grade] = [...this.#roster[grade]].sort();

        return acc;

      }, {});

  }



  add(name, grade) {

    if (Object.values(this.#roster).some(students => students.includes(name))) {

      return false;

    }

    if (!this.#roster[grade]) this.#roster[grade] = [];

    this.#roster[grade].push(name);

    return true;

  }



  grade(grade) {

    return [...(this.#roster[grade] || [])].sort();

  }

}

```
