class WordProblemSolver {

    int solve(final String wordProblem) {

        if (wordProblem == null) throw new IllegalArgumentException();

        String problem = wordProblem.trim();

        if (!problem.startsWith("What is ")) {

            throw new IllegalArgumentException();

        }

        if (!problem.endsWith("?")) {

            throw new IllegalArgumentException();

        }

        String expression = problem.substring("What is ".length(), problem.length() - 1).trim();

        if (expression.isEmpty()) throw new IllegalArgumentException();

        String[] tokens = expression.split("\\s+");

        int index = 0;

        int result = parseNumber(tokens[index++]);

        while (index < tokens.length) {

            String op = tokens[index++];

            if (op.equals("plus")) {

                result += parseNumber(tokens[index++]);

            } else if (op.equals("minus")) {

                result -= parseNumber(tokens[index++]);

            } else if (op.equals("multiplied")) {

                if (index >= tokens.length || !tokens[index].equals("by")) throw new IllegalArgumentException();

                index++; // consume by

                result *= parseNumber(tokens[index++]);

            } else if (op.equals("divided")) {

                if (index >= tokens.length || !tokens[index].equals("by")) throw new IllegalArgumentException();

                index++;

                int divisor = parseNumber(tokens[index++]);

                if (divisor == 0) throw new IllegalArgumentException(); // maybe not tested, but avoid ArithmeticException? Tests may expect? Division by zero maybe not in spec. Could throw IllegalArgument.

                result /= divisor;

            } else {

                throw new IllegalArgumentException();

            }

        }

        return result;

    }

    private int parseNumber(String token) {

        try {

            return Integer.parseInt(token);

        } catch (NumberFormatException e) {

            throw new IllegalArgumentException();

        }

    }

}



