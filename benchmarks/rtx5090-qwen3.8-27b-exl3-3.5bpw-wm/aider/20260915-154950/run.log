            sb.append(verse(current, next));
        }
        return sb.toString();
    }
    private String verse(int current, int next) {
       String currentLine = bottleLine(current);
       String nextLine = bottleLine(next);
       return currentLine + ",\n" + currentLine + ",\nAnd if one green bottle should accidentally fall,\nThere'll be " + nextLine + " hanging on the wall.\n";
    }
    private String bottleLine(int count) {
       if (count == 0) return "no green bottles";
       String number = numbers[count]; // need array accessible.
       return count == 1 ? number + " green bottle" : number + " green bottles";
    }
}

