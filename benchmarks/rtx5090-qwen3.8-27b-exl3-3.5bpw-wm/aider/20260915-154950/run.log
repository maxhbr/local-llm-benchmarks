vector<vector<int>> matrix(int size) {

 vector<vector<int>> result(size, vector<int>(size));

 int top=0,bottom=size-1,left=0,right=size-1,num=1;

 while (top <= bottom && left <= right) {

  for (int j=left; j<=right; ++j) result[top][j]=num++;

  ++top;

  for (int i=top; i<=bottom; ++i) result[i][right]=num++;

  --right;

  if (top <= bottom) for (int j=right; j>=left; --j) result[bottom][j]=num++;

  --bottom;

  if (left <= right) for (int i=bottom; i>=top; --i) result[i][left]=num++;

  ++left;

 }

 return result;

}

