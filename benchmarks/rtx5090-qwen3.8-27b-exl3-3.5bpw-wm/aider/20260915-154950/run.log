namespace kindergarten_garden {
std::vector<std::string> plants(const std::string& diagram, const std::string& student) {
    static const std::vector<std::string> students = {...};
    static const std::unordered_map<char, std::string> plant_map = {...};
    auto it = std::find(students.begin(), students.end(), student);
    int index = std::distance(students.begin(), it);
    std::vector<std::string> result;
    result.push_back(plant_map[diagram[2*index]]);
    result.push_back(plant_map[diagram[2*index+1]]);
    result.push_back(plant_map[diagram[diagram.size()/2 + 2*index]]);
    result.push_back(plant_map[diagram[diagram.size()/2 + 2*index+1]]);
    return result;
}
}

