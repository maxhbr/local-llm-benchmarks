```
export class QueenAttack {

  constructor({ black = [0, 3], white = [7, 3] } = {}) {

    if (!this.isValid(black) || !this.isValid(white) || black[0] === white[0] && black[1] === white[1]) {

      throw new Error('Invalid position');

    }

    this.black = black;

    this.white = white;

  }



  toString() {

    const board = Array.from({ length: 8 }, () => Array(8).fill('_'));

    board[this.black[0]][this.black[1]] = 'b';

    board[this.white[0]][this.white[1]] = 'w';

    return board.map(row => row.join(' ')).join('\n');

  }



  get canAttack() {

    return this.black[0] === this.white[0] ||

      this.black[1] === this.white[1] ||

      Math.abs(this.black[0] - this.white[0]) === Math.abs(this.black[1] - this.white[1]);

  }

}

```
