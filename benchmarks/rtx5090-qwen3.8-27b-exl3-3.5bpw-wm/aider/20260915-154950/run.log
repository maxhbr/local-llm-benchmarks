#include "diamond.h"

#include <cctype>

#include <string>

#include <vector>



namespace diamond {

std::vector<std::string> make(char letter) {

    if (letter >= 'a' && letter <= 'z') letter = char(letter - 'a' + 'A');

    int n = letter - 'A' + 1;

    int width = 2 * n - 1;

    std::vector<std::string> result;

    result.reserve(2*n -1);

    for (int row=0; row < width; ++row) {

       int idx = row < n ? row : width - 1 - row;

       char c = 'A' + idx;

       std::string line;

       if (idx == 0) {

          line.assign(n - 1, ' ');

          line += c;

          line.append(n - 1, ' ');

       } else {

          int leading = n - 1 - idx;

          int inner = 2 * idx - 1;

          line.assign(leading, ' ');

          line += c;

          line.append(inner, ' ');

          line += c;

          line.append(leading, ' ');

       }

       result.push_back(line);

    }

    return result;

}

}



