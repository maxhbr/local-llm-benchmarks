export function count(input) {

  const rows = typeof input === 'string' ? input.split(/\r?\n/) : input;

  if (!rows || rows.length < 2) return 0;

  const width = rows[0] ? rows[0].length : 0;

  if (width < 2) return 0;

  let total = 0;

  const isHorizontal = (r,c) => rows[r][c] === '+' || rows[r][c] === '-';

  const isVertical = (r,c) => rows[r][c] === '+' || rows[r][c] === '|';

  for (let top=0; top<R; top++) {

    for (let bottom=top+1; bottom<R; bottom++) {

      for (let left=0; left<width; left++) {

        if (rows[top][left] !== '+' || rows[bottom][left] !== '+') continue;

        // vertical left valid?

        let leftOk = true;

        for (let r=top+1; r<bottom; r++) if (!isVertical(r,left)) { leftOk=false; break; }

        if (!leftOk) continue;

        for (let right=left+1; right<width; right++) {

          if (rows[top][right] !== '+' || rows[bottom][right] !== '+') continue;

          // vertical right

          let rightOk = true;

          for (let r=top+1; r<bottom; r++) if (!isVertical(r,right)) { rightOk=false; break; }

          if (!rightOk) continue;

          // horizontal top

          let topOk = true;

          for (let c=left+1; c<right; c++) if (!isHorizontal(top,c)) { topOk=false; break; }

          if (!topOk) continue;

          // horizontal bottom

          let bottomOk = true;

          for (let c=left+1; c<right; c++) if (!isHorizontal(bottom,c)) { bottomOk=false; break; }

          if (!bottomOk) continue;

          total++;

        }

      }

    }

  }

  return total;

}

```
