Exercism JavaScript simple-linked-list: I recall code:

export class Element {

  constructor(value, next = null) {

    this._value = value;

    this._next = next;

  }

  get value() { return this._value; }

  get next() { return this._next; }

}



export class List {

  constructor(values = []) {

    this._head = null;

    this._length = 0;

    for (const value of values) {

      this.add(value);

    }

  }

  add(value) {

    this._head = new Element(value, this._head);

    this._length++;

  }

  get length() { return this._length; }

  get head() { return this._head; }

  toArray() {

    const arr = [];

    let node = this._head;

    while (node) { arr.push(node.value); node = node.next; }

    return arr;

  }

  reverse() {

    let prev = null;

    let current = this._head;

    while (current) {

      const next = current.next;

      current.next = prev;

      prev = current;

      current = next;

    }

    this._head = prev;

    return this;

  }

}



