class TwelveDays {

    private static final String[] DAYS = {"first", ...};

    private static final String[] GIFTS = {"a Partridge in a Pear Tree", "two Turtle Doves", ...};



    String verse(int verseNumber) {

        StringBuilder sb = new StringBuilder();

        sb.append("On the ").append(DAYS[verseNumber - 1]).append(" day of Christmas my true love gave to me: ");

        if (verseNumber == 1) {

            sb.append(GIFTS[0]);

        } else {

            for (int i = verseNumber - 1; i >= 1; i--) {

                sb.append(GIFTS[i]).append(", ");

            }

            sb.append("and ").append(GIFTS[0]);

        }

        sb.append(".");

        return sb.toString();

    }



    String verses(int startVerse, int endVerse) {

        StringBuilder sb = new StringBuilder();

        for (int i = startVerse; i <= endVerse; i++) {

            if (i > startVerse) sb.append("\n");

            sb.append(verse(i));

        }

        return sb.toString();

    }



    String sing() {

        return verses(1,12);

    }

}



