export class ResistorColorTrio {

  constructor(colors) {

    this.colors = colors;

  }



  label() {

    const values = { black:0, brown:1, red:2, orange:3, yellow:4, green:5, blue:6, violet:7, grey:8, white:9 };

    const [first, second, multiplier] = this.colors;

    const main = (values[first] * 10 + values[second]) * Math.pow(10, values[multiplier]);

    if (main >= 1e9) return `${main / 1e9} gigaohms`;

    if (main >= 1e6) return `${main / 1e6} megaohms`;

    if (main >= 1e3) return `${main / 1e3} kiloohms`;

    return `${main} ohms`;

  }

}



