import { Palindromes } from './palindrome-products';



describe('Palindrome Products', () => {

  test('finds the smallest palindrome from single digit factors', () => {

    const result = Palindromes.generate({ min: 1, max: 9 });

    expect(result.smallest.value).toEqual(1);

    expect(result.smallest.factors).toEqual([[1, 1]]);

  });

  test('finds the largest palindrome from single digit factors', () => {

    const result = Palindromes.generate({ min: 1, max: 9 });

    expect(result.largest.value).toEqual(9);

    expect(result.largest.factors).toEqual([[1, 9], [3, 3]]);

  });

  test('finds the smallest palindrome from double digit factors', () => {

    const result = Palindromes.generate({ min: 10, max: 99 });

    expect(result.smallest.value).toEqual(121);

    expect(result.smallest.factors).toEqual([[11, 11]]);

  });

  test('finds the largest palindrome from double digit factors', () => {

    const result = Palindromes.generate({ min: 10, max: 99 });

    expect(result.largest.value).toEqual(9009);

    expect(result.largest.factors).toEqual([[91, 99]]);

  });

  test('finds the smallest palindrome from triple digit factors', () => {

    const result = Palindromes.generate({ min: 100, max: 999 });

    expect(result.smallest.value).toEqual(10201);

    expect(result.smallest.factors).toEqual([[101, 101]]);

  });

  test('finds the largest palindrome from triple digit factors', () => {

    const result = Palindromes.generate({ min: 100, max: 999 });

    expect(result.largest.value).toEqual(906609);

    expect(result.largest.factors).toEqual([[913, 993]]);

  });

  test('finds the smallest palindrome from four digit factors', () => {

    const result = Palindromes.generate({ min: 1000, max: 9999 });

    expect(result.smallest.value).toEqual(1002001);

    expect(result.smallest.factors).toEqual([[1001, 1001]]);

  });

  test('finds the largest palindrome from four digit factors', () => {

    const result = Palindromes.generate({ min: 1000, max: 9999 });

    expect(result.largest.value).toEqual(99000099);

    expect(result.largest.factors).toEqual([[9901, 9999]]);

  });

  test('reports that no palindrome can be made as a product of two numbers in range from 100 to 100', () => {

    const result = Palindromes.generate({ min: 100, max: 100 });

    expect(result.largest.value).toBeNull();

    expect(result.largest.factors).toEqual([]);

    expect(result.smallest.value).toBeNull();

    expect(result.smallest.factors).toEqual([]);

  });
```



