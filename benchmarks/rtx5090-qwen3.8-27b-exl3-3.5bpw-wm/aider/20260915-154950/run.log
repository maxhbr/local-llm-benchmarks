type Garden struct {

    plants map[string][]string

}



var plantNames = map[byte]string{'G':"grass", 'C':"clover", 'R':"radishes", 'V':"violets"}



func NewGarden(diagram string, children []string) (*Garden, error) {

    sort.Strings(children)

    rows := strings.Split(strings.TrimLeft(diagram, "\n"), "\n")

    if len(rows) != 2 { return nil, errors.New("diagram must have two rows") }

    if len(rows[0]) != len(rows[1]) { return nil, errors.New("rows must be same length") }

    if len(rows[0])%2 != 0 { return nil, errors.New("row length must be even") }

    if len(rows[0])/2 > len(children) { maybe error? }

    g := &Garden{plants: map[string][]string{}}

    for i, child := range children {

       if i*2+1 >= len(rows[0]) { break? }

