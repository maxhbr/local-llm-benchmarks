package say



import "strings"



var ones = []string{"zero", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten", "eleven", "twelve", "thirteen", "fourteen", "fifteen", "sixteen", "seventeen", "eighteen", "nineteen"}

var tens = []string{"", "", "twenty", "thirty", "forty", "fifty", "sixty", "seventy", "eighty", "ninety"}



func Say(n int64) (string, bool) {

 if n < 0 || n > 999999999999 { return "", false }

 if n == 0 { return "zero", true }

 var parts []string

 if n >= 1000000000 {

   parts = append(parts, under1000(n/1000000000) + " billion")

   n %= 1000000000

 }

 if n >= 1000000 {

   parts = append(parts, under1000(n/1000000) + " million")

   n %= 1000000

 }

 if n >= 1000 {

   parts = append(parts, under1000(n/1000) + " thousand")

   n %= 1000

 }

 if n > 0 {

   parts = append(parts, under1000(n))

 }

 return strings.Join(parts, " "), true

}



func under1000(n int64) string {

 if n == 0 { return "" }

 var parts []string

 if n >= 100 {

   parts = append(parts, ones[n/100] + " hundred")

   n %= 100

 }

 if n >= 20 {

   t := n / 10

   o := n % 10

   if o == 0 {

     parts = append(parts, tens[t])

   } else {

     parts = append(parts, tens[t]+"-"+ones[o])

   }

 } else if n > 0 {

   parts = append(parts, ones[n])

 }

 return strings.Join(parts, " ")

}



