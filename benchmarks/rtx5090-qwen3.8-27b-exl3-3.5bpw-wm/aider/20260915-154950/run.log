  const days = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];

  const day = days.indexOf(dayOfWeek);

  const date = new Date(year, month - 1, 1);

  let firstDay = date.getDay();

  let offset = (day - firstDay + 7) % 7;

  let result;

  switch (week) {

    case 'first': result = 1 + offset; break;

    case 'second': result = 8 + offset; break;

    case 'third': result = 15 + offset; break;

    case 'fourth': result = 22 + offset; break;

