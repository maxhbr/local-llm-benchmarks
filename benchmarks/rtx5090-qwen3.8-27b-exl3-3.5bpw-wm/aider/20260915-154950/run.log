public String transpose(String toTranspose) {

 if (toTranspose == null || toTranspose.isEmpty()) return "";

 String[] rows = toTranspose.split("\n", -1);

 int maxLen = 0;

 for (String row : rows) maxLen = Math.max(maxLen, row.length());

 StringBuilder result = new StringBuilder();

 for (int col = 0; col < maxLen; col++) {

   StringBuilder line = new StringBuilder();

   for (String row : rows) {

     if (col < row.length()) line.append(row.charAt(col));

     else line.append(' ');

   }

   // remove trailing spaces

   int end = line.length();

   while (end > 0 && line.charAt(end - 1) == ' ') end--;

   line.setLength(end);

   if (col > 0) result.append('\n');

   result.append(line);

 }



