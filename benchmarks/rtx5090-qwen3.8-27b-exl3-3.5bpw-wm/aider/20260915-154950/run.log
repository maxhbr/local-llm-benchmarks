class EmptyListException(Exception):
    pass

class Node:
    def __init__(self, value):
        self._value = value
        self._next = None

    def value(self):
        return self._value

    def next(self):
        return self._next

class LinkedList:
    def __init__(self, values=None):
        self._head = None
        self._length = 0
        if values is not None:
            for value in values:
                self.push(value)

    def __iter__(self):
        node = self._head
        while node is not None:
            yield node.value()
            node = node.next()

    def __len__(self):
        return self._length

    def head(self):
        if self._head is None:
            raise EmptyListException("The list is empty.")
        return self._head

    def push(self, value):
        self._head = Node(value)
        self._head._next = self._head? Wait need set next to old head.
        new_node = Node(value)
        new_node._next = self._head
        self._head = new_node
        self._length += 1

    def pop(self):
        if self._head is None: raise EmptyListException
        value = self._head.value()
        self._head = self._head.next()
        self._length -= 1
        return value

    def reversed(self):
        reversed_list = LinkedList()
        node = self._head
        while node is not None:
            reversed_list.push(node.value())
            node = node.next()
        return reversed_list

But need be careful: Node.next() method returns self._next. In push, if new_node._next = self._head, okay. But if using new_node.next? no.

Potential issue: reversed method name shadows built-in but required. It returns LinkedList. If list empty returns empty.

