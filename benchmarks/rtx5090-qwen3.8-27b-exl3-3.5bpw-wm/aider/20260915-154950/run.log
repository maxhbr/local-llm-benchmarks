var ones = []string{"zero", "one", ... "nineteen"}
var tens = []string{"", "", "twenty", "thirty", "forty", "fifty", "sixty", "seventy", "eighty", "ninety"}

func twoDigits(n int64) string:
 if n < 20 return ones[n]
 t := n/10; o := n%10; if o==0 return tens[t]; return tens[t]+"-"+ones[o]

func threeDigits(n int64) string:
 if n == 0 return ""
 h := n/100; r := n%100
 s := ones[h] + " hundred"
 if r != 0 { s += " " + twoDigits(r) }
 return s

func Say(n int64) (string, bool) {
 if n < 0 || n > 999999999999 { return "", false }
 if n == 0 return "zero", true
 var parts []string
 scales := []struct{div int64; name string}{ {1000000000, "billion"}, {1000000, "million"}, {1000, "thousand"} }
 for _, s := range scales {
   chunk := n / s.div
   if chunk > 0 {
      parts = append(parts, threeDigits(chunk) + " " + s.name)
   }
   n %= s.div
 }
 if n > 0 { parts = append(parts, twoDigits(n)) } // n < 1000 after mod? Actually after billion/million/thousand, n < 1000. Could use threeDigits(n) to handle hundreds.
 return strings.Join(parts, " "), true
}

