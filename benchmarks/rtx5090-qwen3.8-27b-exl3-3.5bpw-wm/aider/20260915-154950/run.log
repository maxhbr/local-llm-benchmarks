public class AffineCipher {

    public String encode(String text, int a, int b) {

        if (gcd(a, 26) != 1) throw new IllegalArgumentException("a and m must be coprime.");

        StringBuilder sb = new StringBuilder();

        int count = 0;

        for (char c : text.toLowerCase().toCharArray()) {

            if (Character.isLetter(c)) {

                int x = c - 'a';

                int encrypted = (a * x + b) % 26;

                if (encrypted < 0) encrypted += 26;

                if (count == 5) { sb.append(' '); count = 0; }

                sb.append((char)('a' + encrypted));

                count++;

            } else if (Character.isDigit(c)) {

                if (count == 5) { sb.append(' '); count = 0; }

                sb.append(c);

                count++;

            }

        }

        return sb.toString();

    }

    public String decode(String text, int a, int b) {

        if (gcd(a, 26) != 1) throw new IllegalArgumentException(...);

        int inv = modularInverse(a, 26);

        StringBuilder sb = new StringBuilder();

        for (char c : text.toCharArray()) {

            if (Character.isLetter(c)) {

                int y = c - 'a';

                int decrypted = (inv * ((y - b) % 26 + 26)) % 26; // careful

                sb.append((char)('a' + decrypted));

            } else if (Character.isDigit(c)) {

                sb.append(c);

            }

        }

        return sb.toString();

    }

}



