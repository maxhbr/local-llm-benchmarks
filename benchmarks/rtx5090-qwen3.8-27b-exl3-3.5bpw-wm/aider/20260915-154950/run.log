type Element struct {

    data int

    next *Element

}

type List struct {

    first *Element

    size int

}

func New(elements []int) *List {

    l := &List{}

    for _, e := range elements {

        l.Push(e)

    }

    return l

}

func (l *List) Size() int { return l.size }

func (l *List) Push(element int) {

    l.first = &Element{data: element, next: l.first}

    l.size++

}

func (l *List) Pop() (int, error) {

    if l.first == nil { return 0, errors.New("pop from empty list") }

    e := l.first

    l.first = e.next

    l.size--

    return e.data, nil

}

func (l *List) Array() []int {

    arr := make([]int, 0, l.size)

    for e := l.first; e != nil; e = e.next { arr = append(arr, e.data) }

    return arr

}

func (l *List) Reverse() *List {

    reversed := &List{}

    for e := l.first; e != nil; e = e.next { reversed.Push(e.data) }

    return reversed

}

