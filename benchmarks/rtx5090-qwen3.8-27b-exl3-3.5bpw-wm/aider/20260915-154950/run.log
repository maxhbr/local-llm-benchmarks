package matrix



import (

    "errors"

    "strconv"

    "strings"

)



type Matrix struct {

    rows [][]int

}



func New(s string) (Matrix, error) {

    var m Matrix

    if s == "" {

        return m, nil

    }

    lines := strings.Split(s, "\n")

    for _, line := range lines {

        fields := strings.Fields(line)

        if len(fields) == 0 {

            return m, errors.New("empty row")

        }

        row := make([]int, len(fields))

        for i, f := range fields {

            n, err := strconv.Atoi(f)

            if err != nil {

                return m, err

            }

            row[i] = n

        }

        if len(m.rows) > 0 && len(row) != len(m.rows[0]) {

            return m, errors.New("uneven rows")

        }

        m.rows = append(m.rows, row)

    }

    return m, nil

}



func (m Matrix) Cols() [][]int {

    if len(m.rows) == 0 {

        return nil

    }

    cols := make([][]int, len(m.rows[0]))

    for i := range cols {

        cols[i] = make([]int, len(m.rows))

        for r := range m.rows {

            cols[i][r] = m.rows[r][i]

        }

    }

    return cols

}



func (m Matrix) Rows() [][]int {

    rows := make([][]int, len(m.rows))

    for i, row := range m.rows {

        rows[i] = make([]int, len(row))

        copy(rows[i], row)

    }

    return rows

}



func (m Matrix) Set(row, col, val int) bool {

    if row < 0 || row >= len(m.rows) || col < 0 || col >= len(m.rows[row]) {

        return false

    }

    m.rows[row][col] = val

    return true

}



