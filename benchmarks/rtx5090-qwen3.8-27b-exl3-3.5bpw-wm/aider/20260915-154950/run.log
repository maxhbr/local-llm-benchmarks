public class Satellite {

    public Tree treeFromTraversals(List<Character> preorderInput, List<Character> inorderInput) {

        if (preorderInput.isEmpty()) return new Tree(null, null, null);

        return build(preorderInput, inorderInput);

    }

    private Tree build(List<Character> preorder, List<Character> inorder) {

       if (preorder.isEmpty()) return new Tree(null, null, null);

       char root = preorder.get(0);

       int index = inorder.indexOf(root);

       List<Character> leftInorder = inorder.subList(0, index);

       List<Character> rightInorder = inorder.subList(index+1, inorder.size());

       List<Character> leftPreorder = preorder.subList(1, index+1);

       List<Character> rightPreorder = preorder.subList(index+1, preorder.size());

       return new Tree(root, build(leftPreorder, leftInorder), build(rightPreorder, rightInorder));

    }

}

