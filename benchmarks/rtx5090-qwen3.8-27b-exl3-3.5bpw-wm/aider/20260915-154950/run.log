#include "phone_number.h"

#include <string>

#include <cctype>

namespace phone_number {

phone::phone(const std::string& number) {

    std::string digits;

    for (char c : number) if (isdigit(c)) digits += c;

    if (digits.size() == 11 && digits[0] == '1') digits.erase(0,1);

    if (digits.size() != 10) throw std::domain_error("invalid");

    if (digits[0] < '2' || digits[3] < '2') throw std::domain_error("invalid");

    _number = digits;

}

std::string phone::number() const { return _number; }

std::string phone::area_code() const { return _number.substr(0,3); }

std::string phone::pretty() const { return "(" + _number.substr(0,3) + ") " + _number.substr(3,3) + "-" + _number.substr(6); }

}

```
