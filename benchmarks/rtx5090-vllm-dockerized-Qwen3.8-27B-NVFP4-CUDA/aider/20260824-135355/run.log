package counter

import "testing"

func TestCounter(t *testing.T) {
    tests := []struct {
        name           string
        inputs         []string
        wantLines      int
        wantLetters    int
        wantCharacters int
    }{
        {
            name:           "zero value",
            inputs:         nil,
            wantLines:      0,
            wantLetters:    0,
            wantCharacters: 0,
        },
        {
            name:           "empty string",
            inputs:         []string{""},
            wantLines:      0,
            wantLetters:    0,
            wantCharacters: 0,
        },
        {
            name:           "single line",
            inputs:         []string{"abc"},
            wantLines:      1,
            wantLetters:    3,
            wantCharacters: 3,
        },
        {
            name:           "trailing newline",
            inputs:         []string{"abc\n"},
            wantLines:      1,
            wantLetters:    3,
            wantCharacters: 4,
        },
        {
            name:           "blank line",
            inputs:         []string{"\n"},
            wantLines:      1,
            wantLetters:    0,
            wantCharacters: 1,
        },
        {
            name:           "multiple lines",
            inputs:         []string{"abc\ndef"},
            wantLines:      2,
            wantLetters:    6,
            wantCharacters: 7,
        },
        {
            name:           "multiple trailing newlines",
            inputs:         []string{"abc\n\n"},
            wantLines:      2,
            wantLetters:    3,
            wantCharacters: 5,
        },
        {
            name:           "multiple strings",
            inputs:         []string{"ab", "cd\nef"},
            wantLines:      3,
            wantLetters:    6,
            wantCharacters: 7,
        },
        {
            name:           "unicode letters",
            inputs:         []string{"héllo"},
            wantLines:      1,
            wantLetters:    5,
            wantCharacters: 5,
        },
        {
            name:           "digits and punctuation",
            inputs:         []string{"a1b2!"},
            wantLines:      1,
            wantLetters:    2,
            wantCharacters: 5,
        },
        {
            name:           "spaces are not letters",
            inputs:         []string{"a b"},
            wantLines:      1,
            wantLetters:    2,
            wantCharacters: 3,
        },
    }

    for _, tt := range tests {
        t.Run(tt.name, func(t *testing.T) {
            c := New()
            for _, s := range tt.inputs {
                c.AddString(s)
            }
            if got := c.Lines(); got != tt.wantLines {
                t.Errorf("Lines() = %d, want %d", got, tt.wantLines)
            }
            if got := c.Letters(); got != tt.wantLetters {
                t.Errorf("Letters() = %d, want %d", got, tt.wantLetters)
            }
            if got := c.Characters(); got != tt.wantCharacters {
                t.Errorf("Characters() = %d, want %d", got, tt.wantCharacters)
            }
        })
    }
}

func TestCounterIndependence(t *testing.T) {
    a := New()
    b := New()
    a.AddString("abc")
    if a.Lines() != 1 || b.Lines() != 0 {
        t.Errorf("counters are not independent: a.Lines()=%d b.Lines()=%d", a.Lines(), b.Lines())
    }
}

func TestCounterReset(t *testing.T) {
    c := New()
    c.AddString("abc\ndef")
    c.Reset()
    if c.Lines() != 0 || c.Letters() != 0 || c.Characters() != 0 {
        t.Errorf("Reset did not clear counter: lines=%d letters=%d characters=%d", c.Lines(), c.Letters(), c.Characters())
    }
}

func TestCounterPackageLevelFunctions(t *testing.T) {
    Reset()
    defer Reset()

    AddString("ab\ncd")
    if got := Lines(); got != 2 {
        t.Errorf("Lines() = %d, want 2", got)
    }
    if got := Letters(); got != 4 {
        t.Errorf("Letters() = %d, want 4", got)
    }
    if got := Characters(); got != 5 {
        t.Errorf("Characters() = %d, want 5", got)
    }

    AddString("ef")
    if got := Lines(); got != 3 {
        t.Errorf("Lines() after second AddString = %d, want 3", got)
    }
    if got := Letters(); got != 6 {
        t.Errorf("Letters() after second AddString = %d, want 6", got)
    }
    if got := Characters(); got != 7 {
        t.Errorf("Characters() after second AddString = %d, want 7", got)
    }
}

