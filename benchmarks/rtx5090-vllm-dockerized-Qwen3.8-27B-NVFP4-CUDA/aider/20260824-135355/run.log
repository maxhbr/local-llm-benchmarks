func rankHand(cards []card) (int, []int) {
    values := make([]int, len(cards))
    suits := make([]byte, len(cards))
    for i, c := range cards { values[i] = c.value; suits[i] = c.suit }
    sort.Ints(values)
    desc := make([]int, len(values))
    for i, v := range values { desc[len(values)-1-i] = v }

    counts := [15]int{}
