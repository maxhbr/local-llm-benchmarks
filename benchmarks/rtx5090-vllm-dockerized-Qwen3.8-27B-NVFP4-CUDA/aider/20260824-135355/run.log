func normalizeSuit(suit string) string {
    if suit == "" { return "" }
    r, _ := utf8.DecodeRuneInString(suit)
    r = unicode.ToUpper(r)
    switch r {
    case 'S': return "♠"
    case 'H': return "♥"
    case 'D': return "♦"
    case 'C': return "♣"
    default: return string(r)
    }
}
