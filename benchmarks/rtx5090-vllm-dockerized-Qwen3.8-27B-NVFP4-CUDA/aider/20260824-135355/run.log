package counter

import (
        "strings"
        "unicode"
        "unicode/utf8"
)

// Counter counts lines, letters, and characters for the strings added to it.
type Counter struct {
        lines      int
        letters    int
        characters int
}

// New returns a new Counter.
func New() *Counter {
        return &Counter{}
}

// NewCounter returns a new Counter.
func NewCounter() *Counter {
        return &Counter{}
}

// AddString adds s to the counter.
func (c *Counter) AddString(s string) {
        if c == nil {
                return
        }
        c.lines += countLines(s)
        c.letters += countLetters(s)
        c.characters += utf8.RuneCountInString(s)
}

// Lines returns the total number of lines added so far.
func (c *Counter) Lines() int {
        if c == nil {
                return 0
        }
        return c.lines
}

// Letters returns the total number of letters added so far.
func (c *Counter) Letters() int {
        if c == nil {
                return 0
        }
        return c.letters
}

// Characters returns the total number of characters added so far.
func (c *Counter) Characters() int {
        if c == nil {
                return 0
        }
        return c.characters
}

// Reset clears all totals.
func (c *Counter) Reset() {
        if c == nil {
                return
        }
        *c = Counter{}
}

// defaultCounter is used by the package-level convenience functions.
var defaultCounter Counter

// AddString adds s to the default counter.
func AddString(s string) {
        defaultCounter.AddString(s)
}

// Lines returns the total number of lines in the default counter.
func Lines() int {
        return defaultCounter.Lines()
}

// Letters returns the total number of letters in the default counter.
func Letters() int {
        return defaultCounter.Letters()
}

// Characters returns the total number of characters in the default counter.
func Characters() int {
        return defaultCounter.Characters()
}

// Reset clears the default counter.
func Reset() {
        defaultCounter.Reset()
}

// countLines returns the number of lines in s.
// An empty string has zero lines. A trailing newline does not create an extra empty line.
func countLines(s string) int {
        if s == "" {
                return 0
        }
        newlines := strings.Count(s, "\n")
        if strings.HasSuffix(s, "\n") {
                return newlines
        }
        return newlines + 1
}

// countLetters returns the number of Unicode letters in s.
func countLetters(s string) int {
        total := 0
        for _, r := range s {
                if unicode.IsLetter(r) {
                        total++
                }
        }
        return total
}

