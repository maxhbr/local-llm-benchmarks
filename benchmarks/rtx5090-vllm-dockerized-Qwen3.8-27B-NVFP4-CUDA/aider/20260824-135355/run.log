package poker

import (
        "fmt"
        "sort"
        "strings"
)

type card struct {
        value int
        suit  byte
}

type hand struct {
        raw  string
        rank int
        tie  []int
}

func BestHand(hands []string) ([]string, error) {
        if len(hands) == 0 {
                return nil, nil
        }

        parsed := make([]hand, 0, len(hands))
        for _, h := range hands {
                p, err := parseHand(h)
                if err != nil {
                        return nil, err
                }
                parsed = append(parsed, p)
        }

        best := parsed[0]
        for _, h := range parsed[1:] {
                if better(h, best) {
                        best = h
                }
        }

        var result []string
        for _, h := range parsed {
                if same(h, best) {
                        result = append(result, h.raw)
                }
        }
        return result, nil
}

func parseHand(raw string) (hand, error) {
        parts := strings.Fields(raw)
        if len(parts) != 5 {
                return hand{}, fmt.Errorf("invalid hand: %q", raw)
        }

        cards := make([]card, 0, 5)
        for _, part := range parts {
                c, err := parseCard(part)
                if err != nil {
                        return hand{}, err
                }
                cards = append(cards, c)
        }

        h := hand{raw: raw}
        h.rank, h.tie = rankHand(cards)
        return h, nil
}

func parseCard(s string) (card, error) {
        if len(s) < 2 {
                return card{}, fmt.Errorf("invalid card: %q", s)
        }

        suit := s[len(s)-1]
        if !isSuit(suit) {
                return card{}, fmt.Errorf("invalid card: %q", s)
        }

        rank := s[:len(s)-1]
        value, ok := rankValue(rank)
        if !ok {
                return card{}, fmt.Errorf("invalid card: %q", s)
        }

        return card{value: value, suit: suit}, nil
}

func isSuit(b byte) bool {
        switch b {
        case 'S', 'H', 'D', 'C', 's', 'h', 'd', 'c':
                return true
        }
        return false
}

func rankValue(rank string) (int, bool) {
        switch rank {
        case "2":
                return 2, true
        case "3":
                return 3, true
        case "4":
                return 4, true
        case "5":
                return 5, true
        case "6":
                return 6, true
        case "7":
                return 7, true
        case "8":
                return 8, true
        case "9":
                return 9, true
        case "10", "T", "t":
                return 10, true
        case "J", "j":
                return 11, true
        case "Q", "q":
                return 12, true
        case "K", "k":
                return 13, true
        case "A", "a", "1":
                return 14, true
        }
        return 0, false
}

func rankHand(cards []card) (int, []int) {
        values := make([]int, len(cards))
        suits := make([]byte, len(cards))
        for i, c := range cards {
                values[i] = c.value
                suits[i] = c.suit
        }

        sort.Ints(values)

        desc := make([]int, len(values))
        for i, v := range values {
                desc[len(values)-1-i] = v
        }

        counts := [15]int{}
        for _, v := range values {
                counts[v]++
        }

        var quads, trips, pairs, singles []int
        for v := 14; v >= 2; v-- {
                switch counts[v] {
                case 4:
                        quads = append(quads, v)
                case 3:
                        trips = append(trips, v)
                case 2:
                        pairs = append(pairs, v)
                case 1:
                        singles = append(singles, v)
                }
        }

        flush := true
        for i := 1; i < len(suits); i++ {
                if suits[i] != suits[0] {
                        flush = false
                        break
                }
        }

        straight, straightHigh := isStraight(values)

        switch {
        case flush && straight:
                return 9, []int{straightHigh}
        case len(quads) == 1:
                return 8, []int{quads[0], singles[0]}
        case len(trips) == 1 && len(pairs) == 1:
                return 7, []int{trips[0], pairs[0]}
        case flush:
                return 6, desc
        case straight:
                return 5, []int{straightHigh}
        case len(trips) == 1:
                return 4, append([]int{trips[0]}, singles...)
        case len(pairs) == 2:
                return 3, []int{pairs[0], pairs[1], singles[0]}
        case len(pairs) == 1:
                return 2, append([]int{pairs[0]}, singles...)
        default:
                return 1, desc
        }
}

func isStraight(values []int) (bool, int) {
        if len(values) != 5 {
                return false, 0
        }
        if values[0] == 2 && values[4] == 14 {
                return true, 5
        }
        for i := 1; i < len(values); i++ {
                if values[i] != values[i-1]+1 {
                        return false, 0
                }
        }
        return true, values[4]
}

func better(a, b hand) bool {
        if a.rank != b.rank {
                return a.rank > b.rank
        }
        for i := 0; i < len(a.tie); i++ {
                if i >= len(b.tie) {
                        return true
                }
                if a.tie[i] != b.tie[i] {
                        return a.tie[i] > b.tie[i]
                }
        }
        return false
}

func same(a, b hand) bool {
        return !better(a, b) && !better(b, a)
}

