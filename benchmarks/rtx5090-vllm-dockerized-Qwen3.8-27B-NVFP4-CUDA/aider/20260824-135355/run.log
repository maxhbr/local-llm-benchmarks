Let's draft final counter.go:
```
package counter

import (
    "strings"
    "unicode"
    "unicode/utf8"
)

type defaultCounterState struct {
    lines int
    letters int
    characters int
}

func (c *defaultCounterState) AddString(s string) {
    if c == nil { return }
    if s != "" {
       newlines := strings.Count(s, "\n")
       if strings.HasSuffix(s, "\n") { c.lines += newlines } else { c.lines += newlines + 1 }
    }
    for _, r := range s { if unicode.IsLetter(r) { c.letters++ } }
    c.characters += utf8.RuneCountInString(s)
}
...
```
