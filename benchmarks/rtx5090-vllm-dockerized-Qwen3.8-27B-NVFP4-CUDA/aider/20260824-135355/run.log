package poker

import (
    "fmt"
    "sort"
    "strings"
)

type card struct {
    value int
    suit  byte
}

type hand struct {
    raw   string
    rank  int
    tie   []int
}

func BestHand(hands []string) ([]string, error) {
    if len(hands) == 0 {
        return nil, nil
    }
    parsed := make([]hand, 0, len(hands))
    for _, h := range hands {
        hand, err := parseHand(h)
        if err != nil {
            return nil, err
        }
        parsed = append(parsed, hand)
    }

    best := parsed[0]
    for _, h := range parsed[1:] {
        if better(h, best) {
            best = h
        }
    }

    var result []string
    for _, h := range parsed {
        if same(h, best) {
            result = append(result, h.raw)
        }
    }
    return result, nil
}

func parseHand(raw string) (hand, error) {
    parts := strings.Fields(raw)
    if len(parts) != 5 {
        return hand{}, fmt.Errorf("invalid hand: %q", raw)
    }
    cards := make([]card, 0, 5)
    for _, p := range parts {
        c, err := parseCard(p)
        if err != nil {
            return hand{}, err
        }
        cards = append(cards, c)
    }
    h := hand{raw: raw}
    h.rank, h.tie = rankHand(cards)
    return h, nil
}

func parseCard(s string) (card, error) {
    if len(s) < 2 {
        return card{}, fmt.Errorf("invalid card: %q", s)
    }
    suit := s[len(s)-1]
    rank := s[:len(s)-1]
    value, ok := rankValue(rank)
    if !ok {
        return card{}, fmt.Errorf("invalid card: %q", s)
    }
    return card{value: value, suit: suit}, nil
}

func rankValue(rank string) (int, bool) {
    switch rank {
    case "2": return 2, true
    ...
    case "10", "T": return 10, true
    case "J": return 11, true
    case "Q": return 12, true
    case "K": return 13, true
    case "A": return 14, true
    }
    return 0, false
}

func rankHand(cards []card) (int, []int) {
    values := make([]int, 0, 5)
    suits := make([]byte, 0, 5)
    for _, c := range cards { values = append(values, c.value); suits = append(suits, c.suit) }
    sort.Ints(values) // ascending
    desc := make([]int, 5)
    for i, v := range values { desc[4-i] = v } // descending

    counts := [15]int{}
    for _, v := range values { counts[v]++ }
    var quads, trips, pairs, singles []int
    for v := 14; v >= 2; v-- {
        switch counts[v] {
        case 4: quads = append(quads, v)
        case 3: trips = append(trips, v)
        case 2: pairs = append(pairs, v)
        case 1: singles = append(singles, v)
        }
    }

    flush := true
    for i := 1; i < len(suits); i++ { if suits[i] != suits[0] { flush=false; break } }

    straight := false
    straightHigh := 0
    if len(values) == 5 {
       // values sorted asc
       if values[0] == 2 && values[4] == 14 {
          straight = true; straightHigh = 5
       } else {
          for i := 1; i < 5; i++ {
             if values[i] != values[i-1]+1 { break }
             if i == 4 { straight = true; straightHigh = values[4] }
          }
       }
    }

    switch {
    case flush && straight:
       return 9, []int{straightHigh}
    case len(quads) == 1:
       return 8, []int{quads[0], singles[0]}
    case len(trips) == 1 && len(pairs) == 1:
       return 7, []int{trips[0], pairs[0]}
    case flush:
       return 6, desc
    case straight:
       return 5, []int{straightHigh}
    case len(trips) == 1:
       return 4, append([]int{trips[0]}, singles...)
    case len(pairs) == 2:
       return 3, []int{pairs[0], pairs[1], singles[0]}
    case len(pairs) == 1:
       return 2, append([]int{pairs[0]}, singles...)
    default:
       return 1, desc
    }
}

func better(a, b hand) bool {
    if a.rank != b.rank { return a.rank > b.rank }
    for i := 0; i < len(a.tie); i++ {
       if i >= len(b.tie) { return true }
       if a.tie[i] != b.tie[i] { return a.tie[i] > b.tie[i] }
    }
    return false
}

func same(a,b hand) bool { return !better(a,b) && !better(b,a) }

