Code:
package poker

import (
    "fmt"
    "sort"
    "strings"
)

type score struct {
    category int
    ranks    []int
}

func (s score) compare(other score) int {
    if s.category != other.category {
        if s.category > other.category { return 1 }
        return -1
    }
    for i := 0; i < len(s.ranks) && i < len(other.ranks); i++ {
        if s.ranks[i] != other.ranks[i] {
            if s.ranks[i] > other.ranks[i] { return 1 }
            return -1
        }
    }
    if len(s.ranks) != len(other.ranks) {
        if len(s.ranks) > len(other.ranks) { return 1 }
        return -1
    }
    return 0
}

func BestHand(hands []string) ([]string, error) {
    if len(hands) == 0 {
        return nil, fmt.Errorf("no hands")
    }
    var best []string
    var bestScore score
    for _, hand := range hands {
        s, err := parseHand(hand)
        if err != nil {
            return nil, err
        }
        if len(best) == 0 {
            best = []string{hand}
            bestScore = s
        } else {
            cmp := s.compare(bestScore)
            if cmp > 0 {
                best = []string{hand}
                bestScore = s
            } else if cmp == 0 {
                best = append(best, hand)
            }
        }
    }
    return best, nil
}

func parseHand(hand string) (score, error) {
    cards := strings.Fields(hand)
    if len(cards) != 5 {
        return score{}, fmt.Errorf("hand must contain 5 cards")
    }
    seen := make(map[string]bool, 5)
    ranks := make([]int, 0, 5)
    suits := make([]string, 0, 5)
    for _, card := range cards {
        if seen[card] {
            return score{}, fmt.Errorf("duplicate card %q", card)
        }
        seen[card] = true
        rank, suit, err := parseCard(card)
        if err != nil {
            return score{}, err
        }
        ranks = append(ranks, rank)
        suits = append(suits, suit)
    }
    return evaluate(ranks, suits), nil
}

func parseCard(card string) (int, string, error) {
    if card == "" {
        return 0, "", fmt.Errorf("empty card")
    }
    var rank int
    var rankLen int
    first := card[0]
    switch {
    case first >= '2' && first <= '9':
        rank = int(first - '0')
        rankLen = 1
    case first == '1':
        if len(card) > 1 && card[1] == '0' {
            rank = 10
            rankLen = 2
        } else {
            return 0, "", fmt.Errorf("invalid rank in card %q", card)
        }
    default:
        r := first
        if r >= 'a' && r <= 'z' {
            r -= 32
        }
        switch r {
        case 'T':
            rank = 10
            rankLen = 1
        case 'J':
            rank = 11
            rankLen = 1
        case 'Q':
            rank = 12
            rankLen = 1
        case 'K':
            rank = 13
            rankLen = 1
        case 'A':
            rank = 14
            rankLen = 1
        default:
            return 0, "", fmt.Errorf("invalid card %q", card)
        }
    }
    if rankLen >= len(card) {
        return 0, "", fmt.Errorf("missing suit in card %q", card)
    }
    if card[rankLen] >= '0' && card[rankLen] <= '9' {
        return 0, "", fmt.Errorf("invalid suit in card %q", card)
    }
    return rank, card[rankLen:], nil
}

func evaluate(ranks []int, suits []string) score {
    sorted := append([]int{}, ranks...)
    sort.Sort(sort.Reverse(sort.IntSlice(sorted)))

    counts := make(map[int]int, 5)
    for _, r := range ranks {
        counts[r]++
    }

    type group struct {
        rank, count int
    }
    groups := make([]group, 0, len(counts))
    for r, c := range counts {
        groups = append(groups, group{r, c})
    }
    sort.Slice(groups, func(i, j int) bool {
        if groups[i].count != groups[j].count {
            return groups[i].count > groups[j].count
        }
        return groups[i].rank > groups[j].rank
    })

    maxCount := groups[0].count
    secondCount := 0
    if len(groups) > 1 {
        secondCount = groups[1].count
    }

    isFlush := true
    for i := 1; i < len(suits); i++ {
        if suits[i] != suits[0] {
            isFlush = false
            break
        }
    }

    isStraight := false
    straightHigh := 0
    if len(counts) == 5 {
        if sorted[0]-sorted[4] == 4 {
            isStraight = true
            straightHigh = sorted[0]
        } else if sorted[0] == 14 && sorted[1] == 5 && sorted[2] == 4 && sorted[3] == 3 && sorted[4] == 2 {
            isStraight = true
            straightHigh = 5
        }
    }

    kickers := func() []int {
        var k []int
        for _, g := range groups {
            if g.count == 1 {
                k = append(k, g.rank)
            }
        }
        sort.Sort(sort.Reverse(sort.IntSlice(k)))
        return k
    }

    switch {
    case isFlush && isStraight:
        return score{8, []int{straightHigh}}
    case maxCount == 4:
        return score{7, []int{groups[0].rank, groups[1].rank}}
    case maxCount == 3 && secondCount == 2:
        return score{6, []int{groups[0].rank, groups[1].rank}}
    case isFlush:
        return score{5, sorted}
    case isStraight:
        return score{4, []int{straightHigh}}
    case maxCount == 3:
        return score{3, append([]int{groups[0].rank}, kickers()...)}
    case maxCount == 2 && secondCount == 2:
        return score{2, []int{groups[0].rank, groups[1].rank, groups[2].rank}}
    case maxCount == 2:
        return score{1, append([]int{groups[0].rank}, kickers()...)}
    default:
        return score{0, sorted}
    }
}

