cpp:
```
#include "perfect_numbers.h"

#include <stdexcept>

namespace perfect_numbers {

classification classify(long long number)
{
    if (number <= 0) {
        throw std::domain_error("Classification is only defined for positive integers");
    }

    if (number == 1) {
        return classification::deficient;
    }

    long long aliquot_sum = 1;
    for (long long factor = 2; factor * factor <= number; ++factor) {
        if (number % factor == 0) {
            aliquot_sum += factor;
            long long paired_factor = number / factor;
            if (paired_factor != factor) {
                aliquot_sum += paired_factor;
            }
        }
    }

    if (aliquot_sum == number) {
        return classification::perfect;
    }
    if (aliquot_sum > number) {
        return classification::abundant;
    }
    return classification::deficient;
}

}  // namespace perfect_numbers
```

