Let's draft counter.go:
package counter

import (
    "strings"
    "unicode"
    "unicode/utf8"
)

// Counter counts lines, letters, and characters for strings added to it.
type Counter struct {
    lines      int
    letters    int
    characters int
}

// New returns a new Counter.
func New() *Counter { return &Counter{} }

// NewCounter returns a new Counter.
func NewCounter() *Counter { return &Counter{} }

// AddString adds s to the counter.
func (c *Counter) AddString(s string) {
    if c == nil { return } // maybe avoid nil pointer? If c nil, can't update. Could return.
    c.lines += countLines(s)
    c.letters += countLetters(s)
    c.characters += utf8.RuneCountInString(s)
}

// Lines returns total lines.
func (c *Counter) Lines() int { if c == nil { return 0 }; return c.lines }
...
// Reset clears.
func (c *Counter) Reset() { if c == nil { return }; *c = Counter{} }

// Package-level default counter and functions.
var defaultCounter Counter

// AddString adds s to the default counter.
func AddString(s string) { defaultCounter.AddString(s) }
func Lines() int { return defaultCounter.Lines() }
func Letters() int { return defaultCounter.Letters() }
func Characters() int { return defaultCounter.Characters() }
func Reset() { defaultCounter.Reset() }

// countLines returns number of lines in s. Empty string has 0 lines.
// A trailing newline does not create an extra empty line.
func countLines(s string) int {
    if s == "" { return 0 }
    n := strings.Count(s, "\n")
    if strings.HasSuffix(s, "\n") { return n }
    return n + 1
}

// countLetters returns number of Unicode letters in s.
func countLetters(s string) int {
    count := 0
    for _, r := range s {
        if unicode.IsLetter(r) { count++ }
    }
    return count
}

