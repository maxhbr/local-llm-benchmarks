work/
# benchmarks/
*.cmd
__pycache__/
.playwright-cli
# tool-eval-bench nests its Markdown reports under runs/YYYY/MM/ and keeps a
# SQLite history under data/.  The headline report is flattened to result.md in
# the run dir (tracked, like llama-benchy); these nested internals are kept on
# disk for --resume/--history but ignored by git.
benchmarks/*/tool-eval-bench/*/runs/
benchmarks/*/tool-eval-bench/*/data/

