import org.json.JSONArray;
import org.json.JSONObject;
import java.util.ArrayList;
import java.util.Arrays;
import java.util.Comparator;
import java.util.List;
import java.util.Locale;

class RestApi {
    private static final double EPSILON = 1e-9;
    private final List<User> users;

    RestApi(User... users) {
        this.users = new ArrayList<>(Arrays.asList(users));
    }

    String get(String url) { return get(url, null); }

    String get(String url, JSONObject payload) {
        if ("/users".equals(url)) {
            List<User> result;
            if (payload != null && payload.has("users")) {
                JSONArray names = payload.getJSONArray("users");
                result = new ArrayList<>();
                for (int i=0; i<names.length(); i++) {
                    String name = names.getString(i);
                    User user = findUser(name);
                    if (user != null) result.add(user);
                }
            } else {
                result = new ArrayList<>(users);
            }
            result.sort(Comparator.comparing(User::name));
            return "{\"users\":" + usersToJsonArray(result) + "}";
        }
        throw new IllegalArgumentException("Unsupported GET URL: " + url);
    }

    String post(String url, JSONObject payload) {
        if ("/add".equals(url)) {
            String name = payload.getString("user");
            User existing = findUser(name);
            if (existing != null) {
                return userToJson(existing);
            }
            User user = User.builder().setName(name).build();
            users.add(user);
            return userToJson(user);
        }
        if ("/iou".equals(url)) {
            String lenderName = payload.getString("lender");
            String borrowerName = payload.getString("borrower");
            double amount = payload.getDouble("amount");
            User lender = findUser(lenderName);
            User borrower = findUser(borrowerName);
            if (lender == null || borrower == null) throw new IllegalArgumentException("User not found");
            applyIou(lender, borrower, amount);
            List<User> result = new ArrayList<>(Arrays.asList(lender, borrower));
            result.sort(Comparator.comparing(User::name));
            // If same user? remove duplicate? If lender==borrower, result has two same. Could unique.
            if (lender == borrower) result = new ArrayList<>(List.of(lender)); // Java 9? Use Arrays.asList? To be safe Java 8: List.of not available? Gradle Java 22 but maybe source 17? Could use new ArrayList<>() add.
            return "{\"users\":" + usersToJsonArray(result) + "}";
        }
        throw new IllegalArgumentException("Unsupported POST URL: " + url);
    }

    private void applyIou(User lender, User borrower, double amount) {
        if (Math.abs(amount) < EPSILON) return;
        // Offset any debt from lender to borrower
        double existing = lender.owesTo(borrower.name());
        if (existing > EPSILON) {
            double offset = Math.min(existing, amount);
            lender.addOwes(borrower.name(), -offset);
            borrower.addOwedBy(lender.name(), -offset);
            amount -= offset;
        }
        if (amount > EPSILON) {
            borrower.addOwes(lender.name(), amount);
            lender.addOwedBy(borrower.name(), amount);
        }
    }

    private User findUser(String name) { for (User u: users) if (u.name().equals(name)) return u; return null; }

    private String usersToJsonArray(List<User> users) {
        StringBuilder sb = new StringBuilder("[");
        for (int i=0; i<users.size(); i++) { if (i>0) sb.append(','); sb.append(userToJson(users.get(i))); }
        sb.append(']');
        return sb.toString();
    }

    private String userToJson(User user) {
        StringBuilder sb = new StringBuilder();
        sb.append("{\"name\":").append(stringToJson(user.name()));
        sb.append(",\"owes\":").append(iouMapToJson(user.owes()));
        sb.append(",\"owed_by\":").append(iouMapToJson(user.owedBy()));
        sb.append(",\"balance\":").append(doubleToJson(user.balance()));
        sb.append('}');
        return sb.toString();
    }

    private String iouMapToJson(List<Iou> ious) {
        // sort by name
        List<Iou> sorted = new ArrayList<>(ious);
        sorted.sort(Comparator.comparing(Iou::name));
        StringBuilder sb = new StringBuilder("{");
        for (int i=0; i<sorted.size(); i++) {
            if (i>0) sb.append(',');
            sb.append(stringToJson(sorted.get(i).name())).append(':').append(doubleToJson(sorted.get(i).amount()));
        }
        sb.append('}');
        return sb.toString();
    }

    private String stringToJson(String s) {
        StringBuilder sb = new StringBuilder("\"");
        for (char c : s.toCharArray()) {
            switch (c) {
                case '"': sb.append("\\\""); break;
                case '\\': sb.append("\\\\"); break;
                case '\b': sb.append("\\b"); break;
                case '\f': sb.append("\\f"); break;
                case '\n': sb.append("\\n"); break;
                case '\r': sb.append("\\r"); break;
                case '\t': sb.append("\\t"); break;
                default:
                    if (c < 0x20) {
                        sb.append(String.format("\\u%04x", (int) c));
                    } else {
                        sb.append(c);
                    }
            }
        }
        sb.append('"');
        return sb.toString();
    }

    private String doubleToJson(double value) {
        if (Math.abs(value) < EPSILON) value = 0.0;
        // Avoid -0.0
        if (value == 0.0) value = 0.0;
        // If value is integral? Double.toString includes .0. Good.
        // But for NaN/Infinity not expected.
        return Double.toString(value);
    }
}

