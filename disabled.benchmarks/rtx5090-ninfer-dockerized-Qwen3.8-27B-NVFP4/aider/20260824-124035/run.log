class Record:
    def __init__(self, record_id, parent_id):
        self.record_id = record_id
        self.parent_id = parent_id

class Node:
    def __init__(self, node_id):
        self.node_id = node_id
        self.children = []

def BuildTree(records):
    if not records:
        return None

    # Check for duplicate ids
    ids = [record.record_id for record in records]
    if len(ids) != len(set(ids)):
        raise ValueError("Invalid tree: duplicate node id")

    # Check ids are 0..n-1
    if min(ids) != 0 or max(ids) != len(ids) - 1:
        raise ValueError("Invalid tree: node id out of range")

    # Check root
    root = next(record for record in records if record.record_id == 0)
    if root.parent_id != 0:
        raise ValueError("Invalid tree: root has parent")

    nodes = {record.record_id: Node(record.record_id) for record in records}
    root_node = nodes[0]

    for record in records:
        if record.record_id == 0:
            continue
        parent_id = record.parent_id
        if parent_id < 0 or parent_id >= len(records):
            raise ValueError("Invalid tree: parent id out of range")
        if parent_id >= record.record_id:
            raise ValueError("Invalid tree: parent id higher than child id")
        nodes[parent_id].children.append(nodes[record.record_id])

    return root_node

