def BuildTree(records):
    if not records:
        return None

    # Check for duplicate node ids
    if len(records) != len(set(record.record_id for record in records)):
        raise ValueError("Invalid tree: duplicate node id")

    # Check for node id out of range
    if any(record.record_id < 0 or record.record_id >= len(records) for record in records):
        raise ValueError("Invalid tree: node id out of range")

    # Check for root
    root = next((record for record in records if record.record_id == 0), None)
    if root is None:
        raise ValueError("Invalid tree: root id not zero")
    if root.parent_id != 0:
        raise ValueError("Invalid tree: root has parent")

    nodes = {record.record_id: Node(record.record_id) for record in records}
    for record in records:
        if record.record_id == 0:
            continue
        if record.parent_id < 0 or record.parent_id >= len(records):
            raise ValueError("Invalid tree: parent id out of range")
        if record.parent_id >= record.record_id:
            raise ValueError("Invalid tree: parent id higher than child id")
        nodes[record.parent_id].children.append(nodes[record.record_id])
    return nodes[0]

This checks node id range before root existence. For [1,0], raises node id out of range, not root id not zero. If test expects root id not zero, fail. But maybe test for non-zero root uses [Record(1,0)] and expects root id not
