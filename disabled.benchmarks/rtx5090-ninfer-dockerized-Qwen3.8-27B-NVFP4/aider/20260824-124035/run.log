Pseudo:
class RestApi {
    private final Map<String, User> users = new HashMap<>();

    RestApi(User... users) {
        for (User user : users) {
            if (this.users.containsKey(user.name())) throw new IllegalArgumentException("User already exists");
            this.users.put(user.name(), user);
        }
    }

    String get(String url) { return get(url, null); }

    String get(String url, JSONObject payload) {
        if (!"/users".equals(url)) throw new IllegalArgumentException("Unknown URL: " + url);
        List<User> result;
        if (payload != null && payload.has("users")) {
            JSONArray requested = payload.getJSONArray("users");
            result = new ArrayList<>();
            for (int i=0; i<requested.length(); i++) {
                String name = requested.getString(i);
                User user = users.get(name);
                if (user != null) result.add(user);
            }
        } else {
            result = new ArrayList<>(users.values());
        }
        result.sort(Comparator.comparing(User::name));
        return usersResponse(result);
    }

    String post(String url, JSONObject payload) {
        if ("/add".equals(url)) {
            String name = payload.getString("user");
            if (users.containsKey(name)) throw new IllegalArgumentException("User already exists");
            User user = User.builder().setName(name).build();
            users.put(name, user);
            return userJson(user);
        } else if ("/iou".equals(url)) {
            String lenderName = payload.getString("lender");
            String borrowerName = payload.getString("borrower");
            double amount = payload.getDouble("amount");
            User lender = users.get(lenderName);
            User borrower = users.get(borrowerName);
            if (lender == null || borrower == null) throw new IllegalArgumentException("User not found");
            User updatedLender = addOwedBy(lender, borrowerName, amount);
            User updatedBorrower = addOwes(borrower, lenderName, amount);
            users.put(lenderName, updatedLender);
            users.put(borrowerName, updatedBorrower);
            List<User> result = new ArrayList<>();
            result.add(updatedLender);
            if (!lenderName.equals(borrowerName)) result.add(updatedBorrower);
            result.sort(Comparator.comparing(User::name));
            return usersResponse(result);
        }
        throw new IllegalArgumentException("Unknown URL: " + url);
    }

    private String usersResponse(List<User> userList) {
        StringBuilder sb = new StringBuilder("{\"users\":[");
        for (int i=0; i<userList.size(); i++) { if (i>0) sb.append(','); sb.append(userJson(userList.get(i))); }
        sb.append("]}");
        return sb.toString();
    }

    private String userJson(User user) {
        Map<String, Double> owes = aggregate(user.owes());
        Map<String, Double> owedBy = aggregate(user.owedBy());
        double balance = 0;
        for (double v : owedBy.values()) balance += v;
        for (double v : owes.values()) balance -= v;
