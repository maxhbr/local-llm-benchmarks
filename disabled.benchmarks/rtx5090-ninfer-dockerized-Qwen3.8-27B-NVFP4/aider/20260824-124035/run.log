Let's write robust O(n):
def BuildTree(records):
    if not records:
        return None

    n = len(records)
    record_ids = [record.record_id for record in records]
    if len(set(record_ids)) != n or min(record_ids) != 0 or max(record_ids) != n - 1:
        raise ValueError("Record id is invalid or out of order.")

    records_by_id = {record.record_id: record for record in records}
    nodes = [None] * n

    for record_id in range(n):
        record = records_by_id[record_id]
        parent_id = record.parent_id

        if parent_id < 0:
            raise ValueError("Record id is invalid or out of order.")

        if record_id == 0:
            if parent_id != 0:
                # Since parent_id >= 0 and record_id == 0, this means parent_id > record_id.
                raise ValueError("Node parent_id should be smaller than it's record_id.")
        else:
            if parent_id == record_id:
                raise ValueError("Only root should have equal record and parent id.")
            if parent_id > record_id:
                raise ValueError("Node parent_id should be smaller than it's record_id.")

        nodes[record_id] = Node(record_id)

    for record_id in range(1, n):
        record = records_by_id[record_id]
        nodes[record.parent_id].children.append(nodes[record_id])

    return nodes[0]

