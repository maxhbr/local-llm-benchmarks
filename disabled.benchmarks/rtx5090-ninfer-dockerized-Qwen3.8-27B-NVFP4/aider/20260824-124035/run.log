import WordSearch from './word-search';

describe('Word Search', () => {
  const puzzle = [
    'jefblpepre',
    'camdcimgtc',
    'oivokprjsm',
    'pbwasqroua',
    'rixilelhrs',
    'wolcqlirpc',
    'screeaumgr',
    'alxhpburyi',
    'jalaycalmp',
    'clojurermt',
  ];

  it('Should accept an initial puzzle', () => {
    const wordSearch = new WordSearch(puzzle, ['java']);
    expect(wordSearch.find()).toEqual({ java: { start: [1, 1], end: [4, 4] } });
  });

  it('Should locate one word', () => {
    const wordSearch = new WordSearch(puzzle, ['java', 'javascript']);
    expect(wordSearch.find()).toEqual({
      java: { start: [1, 1], end: [4, 4] },
      javascript: { start: [1, 1], end: [10, 10] },
    });
  });

  it('Should locate different words in different positions', () => {
    const wordSearch = new WordSearch(puzzle, ['java', 'javascript', 'ruby', 'rust', 'clojure', 'scheme', 'lisp', 'haskell', 'lua', 'php']);
    expect(wordSearch.find()).toEqual({
