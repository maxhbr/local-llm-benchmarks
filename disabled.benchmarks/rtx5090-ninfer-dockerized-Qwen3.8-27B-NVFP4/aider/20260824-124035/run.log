```
class WordSearch {
  constructor(grid) {
    if (Array.isArray(grid)) {
      this.grid = grid.map((row) => String(row).trim());
    } else {
      this.grid = String(grid ?? '').trim().split('\n').map((row) => row.trim());
    }
    this.rows = this.grid.length;
    this.cols = this.grid.reduce((max, row) => Math.max(max, row.length), 0);
  }

  find(words = []) {
    const result = {};
    for (const word of words) {
      result[word] = this.findWord(word);
    }
    return result;
  }

  findWord(word) {
    if (typeof word !== 'string' || word.length === 0) return null;
    const directions = [
      [0, 1],
      [1, 0],
      [1, 1],
      [0, -1],
      [-1, 0],
      [-1, -1],
      [1, -1],
      [-1, 1],
    ];

    for (let row = 0; row < this.rows; row += 1) {
      for (let col = 0; col < this.cols; col += 1) {
        for (const [dr, dc] of directions) {
          const finishRow = row + dr * (word.length - 1);
          const finishCol = col + dc * (word.length - 1);
          if (finishRow < 0 || finishRow >= this.rows || finishCol < 0 || finishCol >= this.cols) continue;

          let found = true;
          for (let i = 0; i < word.length; i += 1) {
            const currentRow = row + dr * i;
            const currentCol = col + dc * i;
            const currentRowString = this.grid[currentRow];
            if (!currentRowString || currentRowString[currentCol] !== word[i]) {
              found = false;
              break;
            }
          }

          if (found) {
            return {
              start: { row: row + 1, column: col + 1 },
              finish: { row: finishRow + 1, column: finishCol + 1 },
            };
          }
        }
      }
    }

    return null;
  }
}

export default WordSearch;
```

